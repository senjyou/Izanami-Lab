"""_apply_heal_link 单元测试。

测试目标：
1. _apply_heal_link 本身（buff施加）
   - 入口检查: 无target_service返回None
   - 参数读取: transfer_pct / duration / duration_type
   - 索敌: ally_single / ally_all / 缓存目标 / lowest_hp_ratio / 无目标
   - buff施加: buff_id格式 / effect_type / source_unit_id / is_debuff
   - 返回值结构
2. _apply_heal 中的heal_link转送逻辑
   - 理论治疗量转送（非actual）
   - 满血目标actual=0时仍转送
   - 转送量受link_target缺失HP上限
   - transfer_pct按比例转送
   - link_target已死亡时不转送
   - 转送记录到heal_link_transfers
   - 多个heal_link buff全部转送
"""
import sys
import os
import pytest
from types import SimpleNamespace
from unittest.mock import MagicMock

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..', 'src'))

from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.enums import (Side, Position, SkillEffectType, AuraUpdateTiming)
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.trigger_service import TriggerService
from src.entities_v2.battlefield_state import BattlefieldState


# ─── 工厂函数 ──────────────────────────────────────────────

HEAL_LINK = SkillEffectType.HEAL_LINK.value


def make_unit(unit_id="u1", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT,
              hp=50000, max_hp=50000, atk=10000, defense=5000, speed=500,
              current_hp=None):
    """创建测试用单位。"""
    return UnitState(
        unit_id=unit_id, name=unit_id, side=side, position=position,
        character_id=999901, level=10, element=2, character_type=1,
        max_hp=max_hp, attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_hp=current_hp if current_hp is not None else hp,
        current_ap=10, current_pp=10, current_ep=10,
    )


def make_effect(value=100.0, target_type='ally_single', duration=-1,
                duration_type='attacker_action'):
    """创建heal_link效果对象。"""
    return SimpleNamespace(
        effect_type='heal_link',
        value=value,
        target_type=target_type,
        flags={},
        target_identifier=None,
        hit_count=None,
        condition=None,
        duration=duration,
        duration_type=duration_type,
    )


def make_data_loader():
    """创建最小化的DataLoader。"""
    dl = MagicMock()
    dl.get_skill_by_id.return_value = None
    return dl


def make_battlefield(*units):
    """创建含单位的BattlefieldState。"""
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


def make_skill_service(dl=None, bf=None, with_target=True):
    """创建测试用SkillService。"""
    if dl is None:
        dl = make_data_loader()
    rs = ResourceService()
    ts = TriggerService()
    ts.set_data_loader(dl)
    asvc = AuraService()
    dmgsvc = DamageService()
    tgtsvc = TargetService() if with_target else None
    stsvc = StatusService()
    ss = SkillService(dl, rs, target_service=tgtsvc,
                      damage_service=dmgsvc, aura_service=asvc,
                      status_service=stsvc, trigger_service=ts)
    ts.set_skill_service(ss)
    if bf is not None:
        ss.set_battlefield(bf)
    ss._current_skill_id = 120154
    return ss


def make_heal_link_buff(caster_uid, target_uid, transfer_pct=100.0, duration=1):
    """创建heal_link buff（用于转送测试）。"""
    return BuffState(
        buff_id=f"{caster_uid}_heal_link_{target_uid}",
        name="回復リンク",
        effect_type=HEAL_LINK,
        value=transfer_pct,
        duration=duration,
        timing_type=AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
        source_unit_id=caster_uid,
        source_skill_id=120154,
        is_debuff=False,
        original_duration_type="attacker_action",
    )


def make_heal_effect(value=50.0, heal_base='atk'):
    """创建heal效果（用于转送测试）。"""
    return SimpleNamespace(
        effect_type='heal',
        value=value,
        target_type='ally_single',
        flags={'heal_base': heal_base},
        target_identifier=None,
        hit_count=None,
        condition=None,
    )


# ─── 测试类 ──────────────────────────────────────────────

class TestApplyHealLinkEntry:
    """_apply_heal_link 入口检查。"""

    def test_no_target_service_returns_none(self):
        """无target_service时返回None。"""
        caster = make_unit("caster")
        bf = make_battlefield(caster)
        ss = make_skill_service(bf=bf, with_target=False)
        effect = make_effect()

        result = ss._apply_heal_link(caster, effect, bf)

        assert result is None


class TestApplyHealLinkParameters:
    """参数读取测试。"""

    def test_default_transfer_pct(self):
        """effect.value=None时transfer_pct默认100.0。"""
        caster = make_unit("caster")
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(value=None)

        result = ss._apply_heal_link(caster, effect, bf)

        assert result is not None
        assert result['transfer_pct'] == 100.0

    def test_explicit_transfer_pct(self):
        """显式指定transfer_pct=50.0。"""
        caster = make_unit("caster")
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(value=50.0)

        result = ss._apply_heal_link(caster, effect, bf)

        assert result['transfer_pct'] == 50.0

    def test_default_duration(self):
        """默认duration=-1。"""
        caster = make_unit("caster")
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(duration=-1)

        result = ss._apply_heal_link(caster, effect, bf)

        assert result['duration'] == -1

    def test_explicit_duration(self):
        """显式指定duration=2。"""
        caster = make_unit("caster")
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(duration=2)

        result = ss._apply_heal_link(caster, effect, bf)

        assert result['duration'] == 2

    def test_default_duration_type(self):
        """默认duration_type='attacker_action'。"""
        caster = make_unit("caster")
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect()

        result = ss._apply_heal_link(caster, effect, bf)

        assert result['duration_type'] == 'attacker_action'

    def test_explicit_duration_type(self):
        """显式指定duration_type='action'。"""
        caster = make_unit("caster")
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(duration_type='action')

        result = ss._apply_heal_link(caster, effect, bf)

        assert result['duration_type'] == 'action'


class TestApplyHealLinkTargeting:
    """索敌测试。"""

    def test_ally_single_target(self):
        """ally_single索敌选最近的友方。"""
        caster = make_unit("caster", position=Position.ALLY_LEFT_FRONT)
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(target_type='ally_single')

        result = ss._apply_heal_link(caster, effect, bf)

        assert result is not None
        assert len(result['targets']) == 1
        assert result['targets'][0] == target.name

    def test_ally_all_targets(self):
        """ally_all索敌选所有友方（含自身）。"""
        caster = make_unit("caster", position=Position.ALLY_LEFT_FRONT)
        t1 = make_unit("t1", position=Position.ALLY_CENTER_FRONT)
        t2 = make_unit("t2", position=Position.ALLY_RIGHT_FRONT)
        bf = make_battlefield(caster, t1, t2)
        ss = make_skill_service(bf=bf)
        effect = make_effect(target_type='ally_all')

        result = ss._apply_heal_link(caster, effect, bf)

        assert result is not None
        # ally_all应包含所有友方（含自身）
        assert len(result['targets']) == 3

    def test_no_targets_returns_none(self):
        """无目标返回None。"""
        caster = make_unit("caster", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        # 只有caster，没有其他友方
        bf = make_battlefield(caster)
        ss = make_skill_service(bf=bf)
        effect = make_effect(target_type='ally_single')

        # ally_single会选自身吗？需要确认
        # 实际上ally_single通常选自身，所以这里测试一个没有友方的场景
        # 改用enemy_single测试无目标场景
        effect = make_effect(target_type='enemy_single')

        result = ss._apply_heal_link(caster, effect, bf)

        assert result is None

    def test_dead_target_skipped(self):
        """死亡目标被跳过。"""
        caster = make_unit("caster", position=Position.ALLY_LEFT_FRONT)
        dead_target = make_unit("dead", position=Position.ALLY_CENTER_FRONT)
        dead_target.is_alive = False
        alive_target = make_unit("alive", position=Position.ALLY_RIGHT_FRONT)
        bf = make_battlefield(caster, dead_target, alive_target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(target_type='ally_all')

        result = ss._apply_heal_link(caster, effect, bf)

        # 死亡目标被跳过
        assert result is not None
        target_names = result['targets']
        assert 'dead' not in target_names
        assert 'alive' in target_names

    def test_cached_targets_used(self):
        """_block_damage_targets缓存被优先使用。"""
        caster = make_unit("caster", position=Position.ALLY_LEFT_FRONT)
        cached_target = make_unit("cached", position=Position.ALLY_CENTER_FRONT)
        other_target = make_unit("other", position=Position.ALLY_RIGHT_FRONT)
        bf = make_battlefield(caster, cached_target, other_target)
        ss = make_skill_service(bf=bf)
        # 预置缓存
        ss._block_damage_targets = {'ally_single': [cached_target]}
        effect = make_effect(target_type='ally_single')

        result = ss._apply_heal_link(caster, effect, bf)

        assert result is not None
        # 应使用缓存目标，而非select_targets
        assert result['targets'] == [cached_target.name]


class TestApplyHealLinkBuffCreation:
    """buff施加测试。"""

    def test_buff_correctly_applied(self):
        """heal_link buff应正确施加到目标。"""
        caster = make_unit("caster", position=Position.ALLY_LEFT_FRONT)
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(value=75.0, duration=2)

        ss._apply_heal_link(caster, effect, bf)

        # 验证buff被施加到target
        link_buffs = [b for b in target.buffs + target.debuffs
                      if b.effect_type == HEAL_LINK]
        assert len(link_buffs) == 1
        buff = link_buffs[0]
        assert buff.name == "回復リンク"
        assert buff.value == 75.0
        assert buff.duration == 2
        assert buff.source_unit_id == caster.unit_id
        assert buff.is_debuff is False
        assert buff.original_duration_type == "attacker_action"
        # buff_id格式
        assert buff.buff_id == f"{caster.unit_id}_heal_link_{target.unit_id}"

    def test_buff_timing_type_attacker_action(self):
        """duration_type='attacker_action'时timing=DURABLE_SOURCE_MANEUVER_END。"""
        caster = make_unit("caster", position=Position.ALLY_LEFT_FRONT)
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(duration_type='attacker_action')

        ss._apply_heal_link(caster, effect, bf)

        link_buffs = [b for b in target.buffs + target.debuffs
                      if b.effect_type == HEAL_LINK]
        assert link_buffs[0].timing_type == AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value

    def test_multiple_targets_each_get_buff(self):
        """多目标场景下每个目标都获得独立的heal_link buff。"""
        caster = make_unit("caster", position=Position.ALLY_LEFT_FRONT)
        t1 = make_unit("t1", position=Position.ALLY_CENTER_FRONT)
        t2 = make_unit("t2", position=Position.ALLY_RIGHT_FRONT)
        bf = make_battlefield(caster, t1, t2)
        ss = make_skill_service(bf=bf)
        effect = make_effect(target_type='ally_all')

        ss._apply_heal_link(caster, effect, bf)

        for u in [caster, t1, t2]:
            link_buffs = [b for b in u.buffs + u.debuffs
                          if b.effect_type == HEAL_LINK]
            assert len(link_buffs) == 1, f"{u.name} 应有1个heal_link buff"
            assert link_buffs[0].source_unit_id == caster.unit_id


class TestApplyHealLinkReturnStructure:
    """返回值结构测试。"""

    def test_return_dict_contains_all_fields(self):
        """返回值应包含所有必需字段。"""
        caster = make_unit("caster", position=Position.ALLY_LEFT_FRONT)
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(value=80.0, duration=3, duration_type='action')

        result = ss._apply_heal_link(caster, effect, bf)

        required_fields = {'effect_type', 'targets', 'auras', 'transfer_pct',
                           'duration', 'duration_type'}
        assert set(result.keys()) >= required_fields
        assert result['effect_type'] == 'heal_link'
        assert result['transfer_pct'] == 80.0
        assert result['duration'] == 3
        assert result['duration_type'] == 'action'
        assert isinstance(result['targets'], list)
        assert isinstance(result['auras'], list)

    def test_auras_have_correct_structure(self):
        """auras列表中每个元素应包含正确字段。"""
        caster = make_unit("caster", position=Position.ALLY_LEFT_FRONT)
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        effect = make_effect(value=60.0, duration=1)

        result = ss._apply_heal_link(caster, effect, bf)

        assert len(result['auras']) == 1
        aura = result['auras'][0]
        required_aura_fields = {'target_id', 'target', 'effect', 'source_id',
                                'source', 'duration', 'dur_type', 'transfer_pct'}
        assert set(aura.keys()) >= required_aura_fields
        assert aura['target_id'] == target.unit_id
        assert aura['source_id'] == caster.unit_id
        assert aura['effect'] == "回復リンク"
        assert aura['transfer_pct'] == 60.0
        assert aura['dur_type'] == 'attacker_action'


# ─── _apply_heal 转送逻辑测试 ──────────────────────────────

class TestHealLinkTransfer:
    """_apply_heal 中的heal_link转送逻辑测试。"""

    def _setup_transfer_test(self, caster_hp=10000, target_hp=50000,
                             transfer_pct=100.0, link_target_hp=None):
        """构建转送测试上下文。"""
        caster = make_unit("caster", position=Position.ALLY_LEFT_FRONT,
                           hp=50000, current_hp=caster_hp)
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT,
                           hp=50000, current_hp=target_hp)
        bf = make_battlefield(caster, target)
        ss = make_skill_service(bf=bf)
        # 在target上施加heal_link，链接到caster
        link_buff = make_heal_link_buff(caster.unit_id, target.unit_id,
                                        transfer_pct=transfer_pct)
        ss.aura_service.add_aura(target, link_buff)
        return caster, target, bf, ss

    def test_basic_transfer_theoretical(self):
        """基本转送: target受到5000理论治疗量，100%转送给caster。"""
        caster, target, bf, ss = self._setup_transfer_test(
            caster_hp=10000, target_hp=40000, transfer_pct=100.0)
        # heal: 50% of atk=10000 = 5000
        effect = make_heal_effect(value=50.0, heal_base='atk')

        caster_hp_before = caster.current_hp
        result = ss._apply_heal(caster, effect, bf)

        # caster应收到5000转送
        assert caster.current_hp == caster_hp_before + 5000
        transfers = result.get('heal_link_transfers', [])
        assert len(transfers) == 1
        assert transfers[0]['transfer_heal'] == 5000
        assert transfers[0]['source_theoretical_heal'] == 5000

    def test_transfer_when_target_full_hp(self):
        """满血目标actual=0时，仍按理论值转送给caster。"""
        caster, target, bf, ss = self._setup_transfer_test(
            caster_hp=10000, target_hp=50000,  # target满血
            transfer_pct=100.0)
        effect = make_heal_effect(value=50.0, heal_base='atk')

        caster_hp_before = caster.current_hp
        result = ss._apply_heal(caster, effect, bf)

        # target满血，actual=0
        assert target.current_hp == 50000
        # caster仍收到5000理论值转送
        assert caster.current_hp == caster_hp_before + 5000
        transfers = result.get('heal_link_transfers', [])
        assert len(transfers) == 1
        assert transfers[0]['source_theoretical_heal'] == 5000

    def test_transfer_capped_at_link_target_missing_hp(self):
        """转送量受link_target缺失HP上限。"""
        # caster缺失HP=49000-50000=1000 (近满血)
        caster, target, bf, ss = self._setup_transfer_test(
            caster_hp=49000, target_hp=40000, transfer_pct=100.0)
        effect = make_heal_effect(value=50.0, heal_base='atk')

        result = ss._apply_heal(caster, effect, bf)

        # 转送量理论=5000，但caster缺失HP=1000，actual=1000
        assert caster.current_hp == 50000  # 满血
        transfers = result.get('heal_link_transfers', [])
        assert transfers[0]['transfer_heal'] == 1000  # 受限于missing

    def test_transfer_pct_50(self):
        """transfer_pct=50%时按比例转送。"""
        caster, target, bf, ss = self._setup_transfer_test(
            caster_hp=10000, target_hp=40000, transfer_pct=50.0)
        effect = make_heal_effect(value=50.0, heal_base='atk')

        caster_hp_before = caster.current_hp
        result = ss._apply_heal(caster, effect, bf)

        # 理论5000 * 50% = 2500
        assert caster.current_hp == caster_hp_before + 2500
        transfers = result.get('heal_link_transfers', [])
        assert transfers[0]['transfer_heal'] == 2500

    def test_no_transfer_when_link_target_dead(self):
        """link_target已死亡时不转送。"""
        caster, target, bf, ss = self._setup_transfer_test(
            caster_hp=10000, target_hp=40000, transfer_pct=100.0)
        # 让caster死亡
        caster.is_alive = False
        effect = make_heal_effect(value=50.0, heal_base='atk')

        caster_hp_before = caster.current_hp
        result = ss._apply_heal(caster, effect, bf)

        # caster死亡，不转送
        assert caster.current_hp == caster_hp_before
        transfers = result.get('heal_link_transfers', [])
        assert len(transfers) == 0

    def test_multiple_heal_link_buffs_all_transfer(self):
        """多个heal_link buff时全部转送（target同时被多个caster链接）。"""
        # 两个caster都给target施加heal_link
        caster1 = make_unit("c1", position=Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        caster2 = make_unit("c2", position=Position.ALLY_RIGHT_FRONT,
                            hp=50000, current_hp=10000)
        target = make_unit("target", position=Position.ALLY_CENTER_FRONT,
                           hp=50000, current_hp=40000)
        bf = make_battlefield(caster1, caster2, target)
        ss = make_skill_service(bf=bf)
        # 两个buff都施加到target，分别链接到c1和c2
        ss.aura_service.add_aura(target,
            make_heal_link_buff(caster1.unit_id, target.unit_id, 100.0))
        ss.aura_service.add_aura(target,
            make_heal_link_buff(caster2.unit_id, target.unit_id, 50.0))

        effect = make_heal_effect(value=50.0, heal_base='atk')
        # heal的caster不重要，关键是target收到治疗后转送
        c1_hp_before = caster1.current_hp
        c2_hp_before = caster2.current_hp

        result = ss._apply_heal(caster1, effect, bf)

        # 两个buff都应转送
        transfers = result.get('heal_link_transfers', [])
        assert len(transfers) == 2
        # caster1收到100%转送=5000
        assert caster1.current_hp == c1_hp_before + 5000
        # caster2收到50%转送=2500
        assert caster2.current_hp == c2_hp_before + 2500


class TestHealLinkTransferCrossSide:
    """跨阵营转送测试。"""

    def test_cross_side_transfer_ally_to_enemy(self):
        """跨阵营转送: 己方A持有heal_link链接到敌方E，己方C治疗A时转送给E。

        场景：heal_link buff可跨阵营链接，转送逻辑使用battlefield.get_all_units()
        查找link_target，不限于同阵营。
        """
        # 己方A: heal_link持有者
        ally_a = make_unit("ally_a", side=Side.ALLY,
                           position=Position.ALLY_LEFT_FRONT,
                           hp=50000, current_hp=40000)
        # 己方C: 治疗施法者
        ally_c = make_unit("ally_c", side=Side.ALLY,
                           position=Position.ALLY_CENTER_FRONT,
                           hp=50000, current_hp=50000, atk=10000)
        # 敌方E: link_target
        enemy_e = make_unit("enemy_e", side=Side.ENEMY,
                            position=Position.ENEMY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        bf = make_battlefield(ally_a, ally_c, enemy_e)
        ss = make_skill_service(bf=bf)
        # 给ally_a施加heal_link，链接到敌方enemy_e
        ss.aura_service.add_aura(ally_a,
            make_heal_link_buff(enemy_e.unit_id, ally_a.unit_id, 100.0))

        effect = make_heal_effect(value=50.0, heal_base='atk')
        enemy_hp_before = enemy_e.current_hp

        # ally_c治疗ally_a
        result = ss._apply_heal(ally_c, effect, bf)

        # ally_a收到5000治疗（40000+5000=45000）
        # enemy_e应收到5000转送（10000+5000=15000）
        assert enemy_e.current_hp == enemy_hp_before + 5000
        transfers = result.get('heal_link_transfers', [])
        assert len(transfers) == 1
        assert transfers[0]['linker_id'] == enemy_e.unit_id
