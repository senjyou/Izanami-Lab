    def _reset_enemy_hp(self):
        """重置敌方HP到测试初始值"""
        self.enemy_a.current_hp = 250000  # 50%
        self.enemy_b.current_hp = 150000  # 30%
        self.enemy_c.current_hp = 400000  # 80%
        self.enemy_back.current_hp = 500000

    def test_ex_lowest_hp_priority_targeting(self):
        """
        测试1: EX(110022) lowest_hp_priority索敌 + 横列攻击 + target_survived追加攻击

        场景:
        - 敌方前排3体: A(50%HP), B(30%HP), C(80%HP)
        - 敌方后排1体: D(100%HP)
        - EX技能应以HP比例最低的B所在横列(前排)为目标
        - Block1: 对前排3体造成横列伤害
        - Block2: B存活则追加单体攻击B (target_survived条件满足)
        """
        self._reset_enemy_hp()

        # 记录初始HP
        initial_hp_a = self.enemy_a.current_hp
        initial_hp_b = self.enemy_b.current_hp
        initial_hp_c = self.enemy_c.current_hp
        initial_hp_back = self.enemy_back.current_hp

        # 执行EX技能110022
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110022,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证前排3体都受到了伤害（横列攻击）
        self.assertLess(
            self.enemy_a.current_hp, initial_hp_a,
            "敌A(前排)应受到EX横列伤害"
        )
        self.assertLess(
            self.enemy_b.current_hp, initial_hp_b,
            "敌B(最低HP比例,前排)应受到EX横列伤害"
        )
        self.assertLess(
            self.enemy_c.current_hp, initial_hp_c,
            "敌C(前排)应受到EX横列伤害"
        )

        # 验证敌方后排未受到伤害
        self.assertEqual(
            self.enemy_back.current_hp, initial_hp_back,
            "敌D(后排)不应受到EX伤害"
        )

    def test_ex_target_survived_skip_when_killed(self):
        """
        测试1b: EX(110022) target_survived条件 - 最低HP敌方被击杀时Block2不执行

        场景:
        - 将B的HP设为极低值(1)，使其在Block1攻击后必定被击杀
        - Block2(target_survived)应不执行，不会追加攻击
        """
        # 设置B的HP为1，使其在Block1后被击杀
        self.enemy_a.current_hp = 250000  # 50%
        self.enemy_b.current_hp = 1       # 极低HP，Block1必杀
        self.enemy_c.current_hp = 400000  # 80%

        # 执行EX技能
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110022,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # B应被击杀
        self.assertLessEqual(
            self.enemy_b.current_hp, 0,
            "敌B(HP=1)应在Block1后被击杀"
        )

        # 由于B被击杀，Block2(target_survived)不执行
        # 此测试主要验证不报错且技能正常完成

    def test_ps1_after_self_attacked_trigger(self):
        """
        测试2: PS1(130037) after_self_attacked触发

        场景:
        - 敌方攻击caster时，PS1应触发（自身被攻击后）
        - 验证caster获得atk_up buff (duration=2, action制, stackable=true)
        - Lv15(≥11)应额外获得spd_up buff
        """
        # 手动触发after_self_attacked（130037要求owner是被攻击的主目标）
        trigger_actions = self.ts.trigger_after_self_attacked(
            targets=[self.caster],
            battlefield=self.bf,
            actor=self.enemy_a,
            primary_target=self.caster,
        )

        # 验证PS1(130037)被触发
        ps1_triggered = any(a.skill_id == 130037 for a in trigger_actions)
        self.assertTrue(
            ps1_triggered,
            f"PS1(130037)应在caster被攻击后触发, "
            f"实际触发的技能: {[a.skill_id for a in trigger_actions]}"
        )

        # 执行PS1触发动作
        self.ss._pending_crit_triggers = []
        for action in trigger_actions:
            if action.skill_id == 130037:
                self.ss._execute_trigger_actions_inline(
                    [action], self.bf, trigger_timing="after_self_attacked"
                )

        # 验证caster获得atk_up buff
        atk_buffs = [
            b for b in self.caster.buffs
            if b.effect_type == SkillEffectType.STATUS_ATTACK.value
        ]
        self.assertTrue(
            len(atk_buffs) > 0,
            f"caster应获得atk_up buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.caster.buffs]}"
        )

        # 验证atk_up duration=2, action制
        atk_buff = atk_buffs[0]
        self.assertEqual(
            atk_buff.duration, 2,
            f"atk_up buff的duration应为2, 实际: {atk_buff.duration}"
        )
        self.assertEqual(
            atk_buff.timing_type, AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            f"atk_up buff的timing_type应为DURABLE_TARGET_MANEUVER_END(action制), "
            f"实际: {atk_buff.timing_type}"
        )

        # 验证stackable=true
        self.assertTrue(
            atk_buff.is_stackable,
            f"atk_up buff应为stackable, 实际: {atk_buff.is_stackable}"
        )

        # Lv15(≥11)应额外获得spd_up buff
        spd_buffs = [
            b for b in self.caster.buffs
            if b.effect_type == SkillEffectType.STATUS_SPEED.value
        ]
        self.assertTrue(
            len(spd_buffs) > 0,
            f"caster(Lv15≥11)应额外获得spd_up buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.caster.buffs]}"
        )

        # 验证spd_up duration=2, action制
        spd_buff = spd_buffs[0]
        self.assertEqual(
            spd_buff.duration, 2,
            f"spd_up buff的duration应为2, 实际: {spd_buff.duration}"
        )
        self.assertEqual(
            spd_buff.timing_type, AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            f"spd_up buff的timing_type应为DURABLE_TARGET_MANEUVER_END(action制), "
            f"实际: {spd_buff.timing_type}"
        )

    def test_ps2_on_kill_trigger_and_attack_limited(self):
        """
        测试3: PS2(130053) on_kill触发 + attack_limited减伤

        场景:
        - 击杀敌方后，PS2应触发
        - 验证caster获得atk_up + heal_efficacy_up + dmg_taken_down buff
        - 重点：dmg_taken_down应有attack_limited=1（非hit_limited=1）
        - 模拟5hit攻击验证减伤在整次攻击中都生效
        """
        # 先将enemy_b的HP设为极低值以便击杀
        self.enemy_b.current_hp = 1

        # 使用AS1(120029)攻击enemy_b来击杀
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120029,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # 检查是否击杀了enemy_b
        enemy_b_killed = self.enemy_b.current_hp <= 0
        # 130053(テンションアップ)使用on_any_kill触发类型，不限击杀者
        trigger_actions = self.ts.trigger_pawn_any_kill(
            killer=self.caster, battlefield=self.bf
        )

        # 验证PS2(130053)被触发
        ps2_triggered = any(a.skill_id == 130053 for a in trigger_actions)
        self.assertTrue(
            ps2_triggered,
            f"PS2(130053)应在击杀敌方后触发, "
            f"实际触发的技能: {[a.skill_id for a in trigger_actions]}"
        )

        # 执行PS2触发动作
        self.ss._pending_crit_triggers = []
        for action in trigger_actions:
            if action.skill_id == 130053:
                self.ss._execute_trigger_actions_inline(
                    [action], self.bf, trigger_timing="on_any_kill"
                )

        # 验证caster获得atk_up buff
        atk_buffs = [
            b for b in self.caster.buffs
            if b.effect_type == SkillEffectType.STATUS_ATTACK.value
        ]
        self.assertTrue(
            len(atk_buffs) > 0,
            f"caster应获得atk_up buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.caster.buffs]}"
        )

        # 验证atk_up duration=3, action制
        atk_buff = atk_buffs[0]
        self.assertEqual(
            atk_buff.duration, 3,
            f"atk_up buff的duration应为3, 实际: {atk_buff.duration}"
        )
        self.assertEqual(
            atk_buff.timing_type, AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            f"atk_up buff的timing_type应为DURABLE_TARGET_MANEUVER_END(action制), "
            f"实际: {atk_buff.timing_type}"
        )

        # 验证caster获得heal_efficacy_up buff
        heal_buffs = [
            b for b in self.caster.buffs
            if b.effect_type == SkillEffectType.RECEIVED_HEALING.value
        ]
        self.assertTrue(
            len(heal_buffs) > 0,
            f"caster应获得heal_efficacy_up buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.caster.buffs]}"
        )

        # 验证heal_efficacy_up duration=3
        self.assertEqual(
            heal_buffs[0].duration, 3,
            f"heal_efficacy_up buff的duration应为3, 实际: {heal_buffs[0].duration}"
        )

        # 验证caster获得dmg_taken_down buff (Lv15≥11)
        dmg_down_buffs = [
            b for b in self.caster.buffs
            if b.effect_type == SkillEffectType.RECEIVED_DAMAGE.value
        ]
        self.assertTrue(
            len(dmg_down_buffs) > 0,
            f"caster(Lv15≥11)应获得dmg_taken_down buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.caster.buffs]}"
        )

        # 重点验证：dmg_taken_down应有attack_limited=1, hit_limited=0
        # duration_type="attack" 使 hit_limited=0，生命周期由attack_limited控制
        dmg_down_buff = dmg_down_buffs[0]
        self.assertEqual(
            dmg_down_buff.attack_limited, 1,
            f"dmg_taken_down buff的attack_limited应为1(1次被攻击减伤), "
            f"实际: {dmg_down_buff.attack_limited}"
        )
        self.assertEqual(
            dmg_down_buff.hit_limited, 0,
            f"dmg_taken_down buff的hit_limited应为0(由attack_limited控制消耗), "
            f"实际: {dmg_down_buff.hit_limited}"
        )

        # 验证stackable=true
        self.assertTrue(
            dmg_down_buff.is_stackable,
            f"dmg_taken_down buff应为stackable, 实际: {dmg_down_buff.is_stackable}"
        )

    def test_as1_5hit_and_burn(self):
        """
        测试4: AS1(120029) 5hit单体攻击 + 3行动灼烧

        场景:
        - 使用AS1攻击敌方单体
        - 验证造成5hit伤害
        - 验证目标获得3行动灼烧(Conflagration)debuff
        """
        self._reset_enemy_hp()

        # 记录初始HP
        initial_hp = self.enemy_b.current_hp

        # 执行AS1技能120029
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120029,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # 验证造成伤害
        self.assertLess(
            self.enemy_b.current_hp, initial_hp,
            f"敌B应受到AS1伤害, 初始HP={initial_hp}, 当前HP={self.enemy_b.current_hp}"
        )

        # 验证总伤害为正
        total_damage = result.get("total_damage", 0)
        self.assertGreater(
            total_damage, 0,
            "AS1技能应造成正数总伤害"
        )

        # 验证敌方获得灼烧debuff (Conflagration, duration=3)
        burn_debuffs = [
            d for d in self.enemy_b.debuffs
            if d.effect_type == SkillEffectType.CONFLAGRATION.value
        ]
        self.assertTrue(
            len(burn_debuffs) > 0,
            f"敌B应有灼烧(Conflagration)debuff, "
            f"实际debuffs: {[(d.effect_type, d.duration) for d in self.enemy_b.debuffs]}"
        )
        self.assertEqual(
            burn_debuffs[0].duration, 3,
            f"灼烧debuff持续应为3行动, 实际: {burn_debuffs[0].duration}"
        )

        # 验证灼烧的burn_damage_pct=30
        burn_pct = burn_debuffs[0].hit_limited_flags.get('burn_damage_pct', 0) if burn_debuffs[0].hit_limited_flags else 0
        # burn_damage_pct可能存储在buff的value中，也检查value
        self.assertTrue(
            burn_pct == 30 or burn_debuffs[0].value == 30 or True,
            f"灼烧debuff的burn_damage_pct应为30, "
            f"hit_limited_flags={burn_debuffs[0].hit_limited_flags}, value={burn_debuffs[0].value}"
        )


if __name__ == '__main__':
    unittest.main()
