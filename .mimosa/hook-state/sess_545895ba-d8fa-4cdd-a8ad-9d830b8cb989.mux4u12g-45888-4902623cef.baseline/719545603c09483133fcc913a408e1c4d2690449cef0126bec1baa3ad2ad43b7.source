        """Burn DoT must update unit.cumulative_hp_damage."""
        bf = BattlefieldState()
        unit = _make_unit(
            "unit", "BurningUnit", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, current_hp=80000,
        )
        bf.add_unit(unit)

        burn_debuff = BuffState(
            buff_id="burn1",
            name="炎上",
            effect_type=SkillEffectType.CONFLAGRATION.value,
            value=5000,
            duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="unit",
            is_debuff=True,
        )
        unit.debuffs.append(burn_debuff)

        controller = BattleFlowController(bf, data_loader=self.dl)
        controller._build_display_names()
        controller.skill_service.set_battlefield(bf)
        controller._deferred_crit_triggers = []

        cumulative_before = unit.cumulative_hp_damage
        hp_before = unit.current_hp

        controller._check_and_apply_status_effects(unit)

        hp_loss = hp_before - unit.current_hp
        self.assertGreater(hp_loss, 0, "Burn should deal HP damage")
        self.assertEqual(
            unit.cumulative_hp_damage,
            cumulative_before + hp_loss,
            f"Burn must update cumulative_hp_damage: "
            f"expected {cumulative_before + hp_loss}, got {unit.cumulative_hp_damage}"
        )

    def test_action_damage_updates_cumulative(self):
        """Action damage DoT must update unit.cumulative_hp_damage."""
        bf = BattlefieldState()
        unit = _make_unit(
            "unit", "ActionDmgUnit", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, current_hp=80000,
        )
        bf.add_unit(unit)

        action_dmg_debuff = BuffState(
            buff_id="action_dmg1",
            name="行動時ダメージ",
            effect_type=SkillEffectType.ACTION_DAMAGE.value,
            value=100,
            duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="unit",
            is_debuff=True,
            caster_attack=10000,
        )
        unit.debuffs.append(action_dmg_debuff)

        controller = BattleFlowController(bf, data_loader=self.dl)
        controller._build_display_names()
        controller.skill_service.set_battlefield(bf)
        controller._deferred_crit_triggers = []

        cumulative_before = unit.cumulative_hp_damage
        hp_before = unit.current_hp

        controller._check_and_apply_status_effects(unit)

        hp_loss = hp_before - unit.current_hp
        self.assertGreater(hp_loss, 0, "Action damage should deal HP damage")
        self.assertEqual(
            unit.cumulative_hp_damage,
            cumulative_before + hp_loss,
            f"Action damage must update cumulative_hp_damage: "
            f"expected {cumulative_before + hp_loss}, got {unit.cumulative_hp_damage}"
        )


if __name__ == '__main__':
    unittest.main()
