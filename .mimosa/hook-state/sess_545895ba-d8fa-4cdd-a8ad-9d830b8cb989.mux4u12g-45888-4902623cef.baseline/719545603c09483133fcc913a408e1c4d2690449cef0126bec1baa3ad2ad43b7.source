"""Regression: All damage paths must update cumulative_hp_damage.

Bug: ENCHANT_DAMAGE, ADD_DAMAGE, sub_unit enchant, on_crit, and damage_special
     paths in skill_service.py did not update cumulative_hp_damage, causing
     それはやりすぎ！+ (on_cumulative_damage) to not trigger when these damage
     types pushed cumulative damage past the 75% threshold.

     DoT paths (poison/burn/action_damage) already update cumulative_hp_damage
     through status_service._apply_direct_damage (L273), so no fix was needed
     for DoT.

Fix: Added `hp_loss = hp_before - target.current_hp; if hp_loss > 0:
     target.cumulative_hp_damage += hp_loss` to 5 damage paths in
     skill_service.py (sub_unit enchant, ADD_DAMAGE, ENCHANT_DAMAGE,
     on_crit, damage_special).

Root cause evidence: Battle log showed 62317 enchant damage not counted.
  1433957 (actual) + 62317 (missing enchant) = 1496274 > 1459902 (threshold)
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.battle_flow_controller import BattleFlowController


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=5000, speed=500, element=2, character_type=1,
               current_hp=None):
    u = UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=15, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=10, current_ep=0,
        skills=[], skill_levels={},
        skill_cooldowns={},
    )
    return u


class TestRegAllDamagePathsCumulative(unittest.TestCase):
    """All damage paths must update cumulative_hp_damage."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.target = _make_unit(
            "target", "Target", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, current_hp=100000,
            atk=1000, defense=1000, speed=100,
        )
        self.caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, current_hp=100000,
            atk=20000, defense=1000, speed=500,
        )
        self.bf.add_unit(self.caster)
        self.bf.add_unit(self.target)

        self.ss = SkillService(
            self.dl, ResourceService(),
            target_service=TargetService(), damage_service=DamageService(),
            aura_service=AuraService(), trigger_service=TriggerService(),
            status_service=StatusService(),
        )
        self.ss.set_battlefield(self.bf)

    def test_enchant_damage_updates_cumulative(self):
        """ENCHANT_DAMAGE path must update target.cumulative_hp_damage.

        新API: _prepare_enchant_buffs_for_damage_effect + _process_enchant_damage_for_target
              + _finalize_enchant_buffs_after_damage_effect + _apply_block_enchant_damage
        （旧API _process_enchant_damage はper-targetリファクタリングで廃止）
        """
        enchant_buff = BuffState(
            buff_id="enchant_test",
            name="test_enchant",
            effect_type=SkillEffectType.ENCHANT_DAMAGE.value,
            value=50.0,
            duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            caster_attack=20000,
            source_unit_id="caster",
            hit_limited=0,
        )
        self.caster.buffs.append(enchant_buff)

        cumulative_before = self.target.cumulative_hp_damage
        hp_before = self.target.current_hp

        # 新API: per-targetリファクタリング後の呼び出しシーケンス
        # cumulative_hp_damageは _process_enchant_damage_for_target 内で更新される
        # _apply_block_enchant_damageは叙事ログ出力用で_most_recent_damage初期化が必要なため呼ばない
        sub_unit_buffs, add_damage_buffs, enchant_buffs, carried_debuff_buffs = \
            self.ss._prepare_enchant_buffs_for_damage_effect(self.caster)
        target_info = {
            "target_id": "target",
            "target": "target",
            "hit_evades": [False],
            "hit_crits": [False],
            "hp_before": self.target.current_hp,
        }
        self.ss._process_enchant_damage_for_target(
            self.caster, target_info, self.bf,
            sub_unit_buffs, add_damage_buffs, enchant_buffs, carried_debuff_buffs)
        self.ss._finalize_enchant_buffs_after_damage_effect(
            self.caster, add_damage_buffs, enchant_buffs, carried_debuff_buffs)

        hp_loss = hp_before - self.target.current_hp
        self.assertGreater(hp_loss, 0, "ENCHANT_DAMAGE should deal HP damage")
        self.assertEqual(
            self.target.cumulative_hp_damage,
            cumulative_before + hp_loss,
            f"ENCHANT_DAMAGE must update cumulative_hp_damage: "
            f"expected {cumulative_before + hp_loss}, got {self.target.cumulative_hp_damage}"
        )

    def test_add_damage_updates_cumulative(self):
        """ADD_DAMAGE path must update target.cumulative_hp_damage.

        新API: _prepare_enchant_buffs_for_damage_effect + _process_enchant_damage_for_target
              + _finalize_enchant_buffs_after_damage_effect + _apply_block_enchant_damage
        （旧API _process_enchant_damage はper-targetリファクタリングで廃止）
        """
        add_dmg_buff = BuffState(
            buff_id="add_dmg_test",
            name="test_add_dmg",
            effect_type=SkillEffectType.ADD_DAMAGE.value,
            value=50.0,
            duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            caster_attack=20000,
            source_unit_id="caster",
            hit_limited=0,
        )
        self.caster.buffs.append(add_dmg_buff)

        cumulative_before = self.target.cumulative_hp_damage
        hp_before = self.target.current_hp

        # 新API: per-targetリファクタリング後の呼び出しシーケンス
        # cumulative_hp_damageは _process_enchant_damage_for_target 内で更新される
        # _apply_block_enchant_damageは叙事ログ出力用で_most_recent_damage初期化が必要なため呼ばない
        sub_unit_buffs, add_damage_buffs, enchant_buffs, carried_debuff_buffs = \
            self.ss._prepare_enchant_buffs_for_damage_effect(self.caster)
        target_info = {
            "target_id": "target",
            "target": "target",
            "hit_evades": [False],
            "hit_crits": [False],
            "hp_before": self.target.current_hp,
        }
        self.ss._process_enchant_damage_for_target(
            self.caster, target_info, self.bf,
            sub_unit_buffs, add_damage_buffs, enchant_buffs, carried_debuff_buffs)
        self.ss._finalize_enchant_buffs_after_damage_effect(
            self.caster, add_damage_buffs, enchant_buffs, carried_debuff_buffs)

        hp_loss = hp_before - self.target.current_hp
        self.assertGreater(hp_loss, 0, "ADD_DAMAGE should deal HP damage")
        self.assertEqual(
            self.target.cumulative_hp_damage,
            cumulative_before + hp_loss,
            f"ADD_DAMAGE must update cumulative_hp_damage: "
            f"expected {cumulative_before + hp_loss}, got {self.target.cumulative_hp_damage}"
        )

    def test_poison_updates_cumulative(self):
        """Poison DoT must update unit.cumulative_hp_damage."""
        bf = BattlefieldState()
        unit = _make_unit(
            "unit", "PoisonedUnit", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, current_hp=80000,
        )
        bf.add_unit(unit)

        poison_debuff = BuffState(
            buff_id="poison1",
            name="毒",
            effect_type=SkillEffectType.POISON.value,
            value=0.10,
            duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="unit",
            is_debuff=True,
            caster_attack=99999,
        )
        unit.debuffs.append(poison_debuff)

        controller = BattleFlowController(bf, data_loader=self.dl)
        controller._build_display_names()
        controller.skill_service.set_battlefield(bf)
        controller._deferred_crit_triggers = []

        cumulative_before = unit.cumulative_hp_damage
        hp_before = unit.current_hp

        controller._check_and_apply_status_effects(unit)

        hp_loss = hp_before - unit.current_hp
        self.assertGreater(hp_loss, 0, "Poison should deal HP damage")
        self.assertEqual(
            unit.cumulative_hp_damage,
            cumulative_before + hp_loss,
            f"Poison must update cumulative_hp_damage: "
            f"expected {cumulative_before + hp_loss}, got {unit.cumulative_hp_damage}"
        )

