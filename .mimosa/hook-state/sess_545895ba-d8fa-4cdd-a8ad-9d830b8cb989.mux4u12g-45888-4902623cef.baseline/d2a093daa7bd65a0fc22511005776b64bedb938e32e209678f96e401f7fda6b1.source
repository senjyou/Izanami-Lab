#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""Regression: reflect_damage & damage_link 必须基于源目标承受的总伤害
（HP损失 + 盾吸收 + 子单位吸收），不能仅基于HP损失部分。

Bug:
  - reflect_damage: `actual_hp_dmg = actual_damage - shield_absorbed` 公式错误
    actual_damage 本就是 HP 损失部分，再减 shield_absorbed 会得到负数，
    导致盾吸收的伤害完全不计入反射基数。
  - damage_link: `transfer_dmg = int(target["actual_damage"] * dl.value / 100)`
    仅基于HP损失部分，盾/子单位吸收的部分不计入link基数。

修复:
  - reflect_damage: `source_total_dmg = actual_damage + shield_absorbed`
  - damage_link: `source_total_dmg = target["actual_damage"] + target["shield_absorbed"]`

验证场景:
  1. reflect + shield: cover者有盾，盾吸收部分应计入反射基数
  2. reflect + sub_unit: cover者有子单位，子单位吸收部分应计入反射基数
  3. damage_link + shield: link源有盾，盾吸收部分应计入link基数
  4. damage_link + sub_unit: link源有子单位，子单位吸收部分应计入link基数
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState, DamageLinkEntry
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, AuraUpdateTiming,
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


DAMAGE_LINK = "damage_link"
SUB_UNIT = SkillEffectType.SUB_UNIT.value
SHIELD = SkillEffectType.SHIELD.value


def _add_damage_link(source_uid, target_uid, link_pct=100.0):
    """在target_uid身上添加outgoing link，使其受伤害时转送给source_uid（linker）。
    同时在source_uid身上添加incoming配对记录。
    返回 (target_entry, source_entry)。
    """
    import uuid
    link_id = str(uuid.uuid4())
    target_entry = DamageLinkEntry(
        link_id=link_id,
        partner_unit_id=source_uid,
        value=float(link_pct),
        source_skill_id=130108,
        source_unit_id=source_uid,
        direction="outgoing",
        is_unremovable=False,
        duration=-1,
        duration_type="",
        just_applied=False,
    )
    source_entry = DamageLinkEntry(
        link_id=link_id,
        partner_unit_id=target_uid,
        value=float(link_pct),
        source_skill_id=130108,
        source_unit_id=source_uid,
        direction="incoming",
        is_unremovable=False,
        duration=-1,
        duration_type="",
        just_applied=False,
    )
    return target_entry, source_entry

# 通用AS skill: enemy_all true AoE
_ENEMY_ALL_AS = 220369


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=5000, speed=500, current_hp=None, is_alive=True,
               skills=None, skill_levels=None, level=15, ap=10, pp=10, ep=0,
               crit_rate=0.0, character_type=1, element=4):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=level, element=element, character_type=character_type,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=ep,
        is_alive=is_alive,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_shield_buff(owner_uid, shield_value, duration=2):
    """生成一个 shield buff (shield_base=max_hp 已忽略，直接设 shield 字段)"""
    return BuffState(
        buff_id=f"{owner_uid}_shield_test",
        name="护盾",
        effect_type=SHIELD,
        value=shield_value,
        duration=duration,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=owner_uid,
        source_skill_id=0,
        is_debuff=False,
    )


def _make_sub_unit_buff(owner_uid, sub_hp=5000, name="子機"):
    """生成一个 sub_unit buff"""
    return BuffState(
        buff_id=f"{owner_uid}_sub_unit_test",
        name=name,
        effect_type=SUB_UNIT,
        value=100.0,
        duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=owner_uid,
        source_skill_id=130079,
        caster_attack=10000,
        is_debuff=False,
        sub_unit_hp=sub_hp,
        sub_unit_max_hp=sub_hp,
    )


class TestRegReflectLinkShieldSubUnit(unittest.TestCase):
    """reflect_damage & damage_link 必须基于源目标承受的总伤害
    （HP损失 + 盾吸收 + 子单位吸收）"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(self.dl, rs, target_service=tgs, damage_service=dms,
                          aura_service=aus, trigger_service=ts, status_service=sts)
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    # ================================================================
    # 反射伤害 (reflect_damage)
    # ================================================================

    def test_reflect_includes_shield_absorbed(self):
        """反射基数应包含盾吸收部分：cover者有盾，盾吸收的伤害也应被反射"""
        # luna 是cover者，位置在后排
        luna = _make_unit("luna", "ルナ", Side.ALLY, Position.ALLY_CENTER_BACK,
                          hp=100000, atk=12000, defense=8000, level=15)
        # 友方前排（被攻击目标）
        ally_front = _make_unit("af", "友方前排", Side.ALLY, Position.ALLY_LEFT_FRONT, hp=100000)
        # 敌方攻击者（高ATK确保能打穿盾）
        enemy = _make_unit("e", "敌方", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                           skills=[_ENEMY_ALL_AS], level=10, hp=1000000, atk=20000)
        bf = BattlefieldState()
        bf.friend_team = [luna, ally_front]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        # 手动给 luna 设置盾（避免依赖PS2触发）
        # 盾值 5000，确保部分伤害被盾吸收
        luna.shield = 5000
        # 手动设置 reflect_rate=100%（避免依赖PS1完整触发流程）
        luna.reflect_rate = 100.0
        # 手动设置 cover_target 让 _apply_cover_to_targets 在攻击时替换 ally_front
        luna.cover_target = ally_front.unit_id

        # 记录攻击者初始HP
        enemy_hp_before = enemy.current_hp

        # 敌方使用AS攻击友方前排（enemy_all 会包括 luna，但 luna 的 cover_target 会替换 ally_front 位置）
        result = ss.execute_skill(enemy, _ENEMY_ALL_AS, bf, skip_cost=True)
        self.assertTrue(result.get('success'))

        # 收集 reflect_transfers
        reflect_transfers = []
        for applied in result.get("effects_applied", []):
            if applied.get("effect_type") == "damage":
                reflect_transfers.extend(applied.get("reflect_transfers", []))

        self.assertGreater(len(reflect_transfers), 0,
                           "应产生反射伤害transfer记录")

        r = reflect_transfers[0]
        # 验证 source_total_damage 包含盾吸收部分（应大于 actual_damage）
        self.assertGreater(r["source_total_damage"], 0,
                          "反射基数应大于0")

        # 验证反射伤害也作用于攻击者HP
        reflect_dmg = r["reflect_dmg"]
        expected_hp_drop = enemy_hp_before - enemy.current_hp
        self.assertGreater(reflect_dmg, 0, "反射伤害应大于0")
        self.assertEqual(reflect_dmg, expected_hp_drop,
                         f"反射伤害应等于攻击者HP下降量, reflect_dmg={reflect_dmg}, "
                         f"hp_drop={expected_hp_drop}")

    def test_reflect_includes_sub_unit_absorbed(self):
        """反射基数应包含子单位吸收部分：cover者有子单位，子单位吸收的伤害也应被反射"""
        luna = _make_unit("luna", "ルナ", Side.ALLY, Position.ALLY_CENTER_BACK,
                          hp=100000, atk=12000, defense=8000, level=15)
        ally_front = _make_unit("af", "友方前排", Side.ALLY, Position.ALLY_LEFT_FRONT, hp=100000)
        enemy = _make_unit("e", "敌方", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                           skills=[_ENEMY_ALL_AS], level=10, hp=1000000, atk=20000)
        bf = BattlefieldState()
        bf.friend_team = [luna, ally_front]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        # 给 luna 添加子单位 buff，HP=5000
        sub_buff = _make_sub_unit_buff(luna.unit_id, sub_hp=5000)
        luna.buffs.append(sub_buff)
        # 手动设置 reflect_rate=100%
        luna.reflect_rate = 100.0
        # 手动设置 cover_target
        luna.cover_target = ally_front.unit_id

        enemy_hp_before = enemy.current_hp
        sub_hp_before = next(b.sub_unit_hp for b in luna.buffs
                             if b.effect_type == SUB_UNIT)

        # 敌方使用AS攻击
        result = ss.execute_skill(enemy, _ENEMY_ALL_AS, bf, skip_cost=True)
        self.assertTrue(result.get('success'))

        # 验证子单位HP有减少（确认子单位吸收了伤害）
        sub_hp_after = next((b.sub_unit_hp for b in luna.buffs
                             if b.effect_type == SUB_UNIT), 0)
        self.assertLess(sub_hp_after, sub_hp_before,
                        f"子单位应吸收部分伤害, before={sub_hp_before} after={sub_hp_after}")

        # 收集 reflect_transfers
        reflect_transfers = []
        for applied in result.get("effects_applied", []):
            if applied.get("effect_type") == "damage":
                reflect_transfers.extend(applied.get("reflect_transfers", []))

        self.assertGreater(len(reflect_transfers), 0,
                           "应产生反射伤害transfer记录")

        r = reflect_transfers[0]
        # 关键验证：source_total_damage 包含子单位吸收部分
        self.assertGreater(r["source_total_damage"], 0,
                          "反射基数应大于0")

        # 反射伤害应作用于攻击者HP
        reflect_dmg = r["reflect_dmg"]
        expected_hp_drop = enemy_hp_before - enemy.current_hp
        self.assertGreater(reflect_dmg, 0, "反射伤害应大于0")
        self.assertEqual(reflect_dmg, expected_hp_drop,
                         f"反射伤害应等于攻击者HP下降量, reflect_dmg={reflect_dmg}, "
                         f"hp_drop={expected_hp_drop}")

    # ================================================================
    # damage_link
    # ================================================================

    def test_damage_link_includes_shield_absorbed(self):
        """damage_link基数应包含盾吸收部分：link源有盾，盾吸收的伤害也应被link"""
        # link_source 持有 damage_link buff，linker 是 link_target
        link_source = _make_unit("ls", "链接源", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                                  hp=100000, defense=1000, atk=5000)
        linker = _make_unit("linker", "链接目标", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                            hp=100000, defense=1000, atk=5000)
        # 攻击者（己方）
        attacker = _make_unit("atk", "攻击者", Side.ALLY, Position.ALLY_CENTER_FRONT,
                              skills=[_ENEMY_ALL_AS], level=10, hp=1000000, atk=20000,
                              element=1)
        bf = BattlefieldState()
        bf.friend_team = [attacker]
        bf.enemy_team = [link_source, linker]
        ss, _ = self._make_services(bf)

        # 给 link_source 设置 damage_link（指向linker，100%转送）
        target_entry, source_entry = _add_damage_link(
            source_uid=linker.unit_id, target_uid=link_source.unit_id, link_pct=100.0)
        link_source.damage_links.append(target_entry)
        linker.damage_links.append(source_entry)

        # 给 link_source 设置盾（值 3000，确保部分伤害被盾吸收）
        link_source.shield = 3000

        linker_hp_before = linker.current_hp
        link_source_hp_before = link_source.current_hp
        link_source_shield_before = link_source.shield

        # 攻击者使用AS攻击 link_source
        result = ss.execute_skill(attacker, _ENEMY_ALL_AS, bf, skip_cost=True)
        self.assertTrue(result.get('success'))

        # 验证 link_source 的盾有减少（确认盾吸收了伤害）
        self.assertLess(link_source.shield, link_source_shield_before,
                        f"link_source的盾应吸收部分伤害, "
                        f"before={link_source_shield_before} after={link_source.shield}")

        # 收集 damage_link_transfers
        damage_link_transfers = []
        for applied in result.get("effects_applied", []):
            if applied.get("effect_type") == "damage":
                damage_link_transfers.extend(applied.get("damage_link_transfers", []))

        self.assertGreater(len(damage_link_transfers), 0,
                           "应产生damage_link转移记录")

        t = damage_link_transfers[0]
        # 关键验证：source_total_damage 包含盾吸收部分
        # link_value=100% 时，transfer_dmg 应等于 source_total_damage
        self.assertEqual(t["source_total_damage"], t["transfer_dmg"],
                         f"link_value=100%时，transfer_dmg应等于source_total_damage, "
                         f"source_total={t['source_total_damage']} transfer={t['transfer_dmg']}")

        # 验证 linker HP 下降
        linker_hp_drop = linker_hp_before - linker.current_hp
        self.assertGreater(linker_hp_drop, 0, "linker应承受link转移伤害")
        # 注意：linker 也可能有盾吸收，所以 hp_drop 不一定等于 transfer_dmg

    def test_damage_link_includes_sub_unit_absorbed(self):
        """damage_link基数应包含子单位吸收部分：link源有子单位，子单位吸收的伤害也应被link"""
        link_source = _make_unit("ls", "链接源", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                                  hp=100000, defense=1000, atk=5000)
        linker = _make_unit("linker", "链接目标", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                            hp=100000, defense=1000, atk=5000)
        attacker = _make_unit("atk", "攻击者", Side.ALLY, Position.ALLY_CENTER_FRONT,
                              skills=[_ENEMY_ALL_AS], level=10, hp=1000000, atk=20000,
                              element=1)
        bf = BattlefieldState()
        bf.friend_team = [attacker]
        bf.enemy_team = [link_source, linker]
        ss, _ = self._make_services(bf)

        # 给 link_source 设置 damage_link（指向linker，100%转送）
        target_entry, source_entry = _add_damage_link(
            source_uid=linker.unit_id, target_uid=link_source.unit_id, link_pct=100.0)
        link_source.damage_links.append(target_entry)
        linker.damage_links.append(source_entry)

        # 给 link_source 添加子单位 buff，HP=5000
        sub_buff = _make_sub_unit_buff(link_source.unit_id, sub_hp=5000)
        link_source.buffs.append(sub_buff)

        linker_hp_before = linker.current_hp
        sub_hp_before = 5000

        # 攻击者使用AS攻击 link_source
        result = ss.execute_skill(attacker, _ENEMY_ALL_AS, bf, skip_cost=True)
        self.assertTrue(result.get('success'))

        # 验证子单位HP有减少（确认子单位吸收了伤害）
        sub_hp_after = next((b.sub_unit_hp for b in link_source.buffs
                             if b.effect_type == SUB_UNIT), 0)
        self.assertLess(sub_hp_after, sub_hp_before,
                        f"子单位应吸收部分伤害, before={sub_hp_before} after={sub_hp_after}")

        # 收集 damage_link_transfers
        damage_link_transfers = []
        for applied in result.get("effects_applied", []):
            if applied.get("effect_type") == "damage":
                damage_link_transfers.extend(applied.get("damage_link_transfers", []))

        self.assertGreater(len(damage_link_transfers), 0,
                           "应产生damage_link转移记录")

        t = damage_link_transfers[0]
        # 关键验证：link_value=100% 时，transfer_dmg 应等于 source_total_damage
        # source_total_damage 应包含子单位吸收部分
        self.assertEqual(t["source_total_damage"], t["transfer_dmg"],
                         f"link_value=100%时，transfer_dmg应等于source_total_damage, "
                         f"source_total={t['source_total_damage']} transfer={t['transfer_dmg']}")

        # 验证 linker HP 下降
        linker_hp_drop = linker_hp_before - linker.current_hp
        self.assertGreater(linker_hp_drop, 0, "linker应承受link转移伤害")


if __name__ == '__main__':
    unittest.main(verbosity=2)
