"""Regression: 外殻強化 (230029) must trigger when attacked by a turn-end
PS attack skill such as リストリクションエッジ (130055).

Bug: _execute_global_trigger_actions did not trigger post-attack reactions
(after_self_attacked / after_ally_attacked) after a global PS attack skill
dealt damage. As a result, when リストリクションエッジ (on_turn_end) attacked
a unit at turn end, the attacked unit's 外殻強化 (after_self_attacked) PS
never fired, even though it should react to any attack.

Fix: After a global PS attack skill executes successfully, trigger
hp_below, after_self_attacked and after_ally_attacked on the damaged
targets (before death processing), mirroring the AS skill path.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig


class TestRegGaikakuTurnEndTrigger(unittest.TestCase):
    """外殻強化 must fire when attacked by リストリクションエッジ at turn end."""

    def _build_controller(self, turn_number: int = 2):
        """Enemy has リストリクションエッジ (130055); ally (highest ATK) has 外殻強化 (230029)."""
        bb = BattleBuilder()
        # Ally target (highest ATK so リストリクションエッジ picks it): has 外殻強化
        bb.add_ally(unit_id="ally_gaikaku", position=Position.ALLY_CENTER_FRONT,
                    hp=99999, atk=20000, speed=500, skills=[230029], level=10, pp=10)
        # Enemy caster: has リストリクションエッジ (turn-end PS, fires on even turns)
        bb.add_enemy(unit_id="enemy_restriction", position=Position.ENEMY_CENTER_FRONT,
                     hp=99999, atk=1, speed=100, skills=[130055], level=10, pp=10)
        ctx = bb.build()
        bf = ctx['bf']
        # Set turn_number so round_number_modulo:2 condition can be evaluated
        bf.turn_number = turn_number
        # Build a real controller (no narrative) with real services
        controller = BattleFlowController(
            bf, BattleConfig(max_turns=1), data_loader=ctx['services']['dl'])
        # Populate _unit_id_map so _find_unit can resolve damage targets
        controller._build_display_names()
        # Initialize deferred crit collector (normally done in _execute_turn)
        controller._deferred_crit_triggers = []
        return controller, bf

    def test_gaikaku_triggers_after_restriction_edge(self):
        """リストリクションエッジ attacks ally at turn end → 外殻強化 def_up applied."""
        controller, bf = self._build_controller(turn_number=2)
        ally = next(u for u in bf.friend_team if u.unit_id == "ally_gaikaku")

        # Collect turn-end PS actions (リストリクションエッジ fires on even turns)
        turn_end_actions = controller.trigger_service.trigger_turn_end(bf)
        restriction_actions = [a for a in turn_end_actions if a.skill_id == 130055]
        self.assertEqual(len(restriction_actions), 1,
                         "リストリクションエッジ should be collected at turn end (turn=2)")

        # Execute the global trigger actions (this is where the bug was)
        controller._execute_global_trigger_actions(turn_end_actions)

        # Sanity check: ally was actually damaged by リストリクションエッジ
        self.assertLess(ally.current_hp, ally.max_hp,
                        "ally should have taken damage from リストリクションエッジ")

        # Verify 外殻強化 triggered: ally should have a def_up buff
        def_up_buffs = [b for b in ally.buffs
                        if b.effect_type == SkillEffectType.STATUS_DEFENSE.value]
        self.assertTrue(
            len(def_up_buffs) > 0,
            f"外殻強化 should have applied def_up after being attacked by "
            f"リストリクションエッジ, actual buffs: "
            f"{[(b.name, b.effect_type) for b in ally.buffs]}")

    def test_restriction_edge_skipped_on_odd_turn(self):
        """リストリクションエッジ only fires on even turns (round_number_modulo:2)."""
        controller, bf = self._build_controller(turn_number=1)

        turn_end_actions = controller.trigger_service.trigger_turn_end(bf)
        restriction_actions = [a for a in turn_end_actions if a.skill_id == 130055]
        self.assertEqual(len(restriction_actions), 0,
                         "リストリクションエッジ should NOT fire on odd turns")

    def test_gaikaku_cooldown_respected(self):
        """外殻強化 has cooldown=3: after triggering once it should not fire again
        on the very next turn-end attack (until cooldown recovers)."""
        controller, bf = self._build_controller(turn_number=2)
        ally = next(u for u in bf.friend_team if u.unit_id == "ally_gaikaku")

        turn_end_actions = controller.trigger_service.trigger_turn_end(bf)
        controller._execute_global_trigger_actions(turn_end_actions)

        def_up_count_after_first = len([
            b for b in ally.buffs
            if b.effect_type == SkillEffectType.STATUS_DEFENSE.value])
        self.assertGreater(def_up_count_after_first, 0,
                           "外殻強化 should fire on first attack")

        # Simulate a second attack on the same turn (外殻強化 now on cooldown=3)
        # Manually damage ally then trigger after_self_attacked
        ally.current_hp = max(1, ally.current_hp - 1000)
        enemy = next(u for u in bf.enemy_team if u.unit_id == "enemy_restriction")
        after_self = controller.trigger_service.trigger_after_self_attacked(
            [ally], bf, actor=enemy, primary_target=ally)
        gaikaku_actions = [a for a in after_self if a.skill_id == 230029]
        # 外殻強化 should be on cooldown and NOT collected again
        self.assertEqual(len(gaikaku_actions), 0,
                         "外殻強化 should be on cooldown and not re-triggered")


if __name__ == '__main__':
    unittest.main()
