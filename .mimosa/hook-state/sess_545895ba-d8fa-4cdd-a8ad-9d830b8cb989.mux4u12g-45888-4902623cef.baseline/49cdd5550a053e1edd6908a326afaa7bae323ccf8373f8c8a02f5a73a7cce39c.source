"""Regression: 温泉の効能(130094) shield duration_owner.

Bug: Shield decremented on holder's action AND caster's action (double consumption).
Fix: process_maneuver_end only decrements DURABLE_SOURCE_MANEUVER_END when source_unit_id==unit.
"""
import unittest, sys, os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType, AuraUpdateTiming
SHIELD = SkillEffectType.SHIELD.value


class TestRegOnsenShield(unittest.TestCase):

    def test_shield_decrements_on_caster_not_holder(self):
        """Shield with duration_owner=caster should decrement only on caster's action."""
        bb = BattleBuilder()
        bb.add_ally(unit_id="caster", hp=20000, atk=10000, skills=[130094], level=10)
        bb.add_ally(unit_id="ally_holder", hp=10000)
        bb.add_enemy(unit_id="enemy", hp=50000)
        ctx = bb.build()
        bf, ss, aus = ctx['bf'], ctx['ss'], ctx['aus']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")
        holder = next(u for u in bf.friend_team if u.unit_id == "ally_holder")

        result = ss.execute_skill(caster=caster, skill_id=130094, battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])

        holder_shields = [b for b in holder.buffs if b.effect_type == SHIELD]
        self.assertTrue(len(holder_shields) > 0, "shield should be on holder")
        orig_dur = holder_shields[0].duration

        # Decrement when holder acts (should NOT decrement: source=caster, not holder)
        aus.process_maneuver_end(holder)
        aus.check_expiration(holder)
        holder_shields2 = [b for b in holder.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(holder_shields2), len(holder_shields),
                         "shield should NOT decrement when holder acts (source=caster)")
        self.assertEqual(holder_shields2[0].duration, orig_dur,
                         "shield duration unchanged after holder acts")
