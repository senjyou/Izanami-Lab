#!/usr/bin/env python
# -*- coding: utf-8 -*-

import sys
from pathlib import Path

# 添加项目根目录到Python路径
sys.path.insert(0, str(Path(__file__).parent.parent))

from src.utils.encoding_utils import setup_console_encoding, safe_print
from src.combat_v2.data_loader_v2 import DataLoaderV2
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.battle_flow_controller import BattleFlowController

def main():
    setup_console_encoding()
    safe_print("=== 开始战斗模拟验证 V2 ===")
    
    # 1. 初始化 DataLoader
    data_dir = Path(__file__).parent.parent / "data"
    loader = DataLoaderV2(data_dir)
    safe_print("DataLoader 初始化完成")
    
    # 2. 加载角色配置
    # 己方: 132301 (唯一無二の幼なじみ) -> ID mismatch? Let's check cache file or handle potential missing.
    # Note: User request Checkpoint 13 says 132301. But my sample view of cache didn't show 132301 (only up to 108301 in sample).
    # I will try 132301, if fail, I will list available ID keys from loader.
    
    ally_id = 132301
    enemy_id = 110301
    
    # Check if IDs exist
    if str(ally_id) not in loader.char_cache:
        safe_print(f"Warning: Ally ID {ally_id} not in cache. Available keys sample: {list(loader.char_cache.keys())[:5]}")
        # Fallback to existing ID if needed for testing?
        # Let's hope it is there (I only viewed first 800 lines).
        
    ally_unit = loader.get_unit_state(ally_id, "ally_1")
    enemy_unit = loader.get_unit_state(enemy_id, "enemy_1")
    
    if not ally_unit or not enemy_unit:
        safe_print("错误: 无法加载单位数据")
        return

    # 3. 配置战场
    ally_unit.position = Position.ALLY_CENTER_FRONT
    ally_unit.side = Side.ALLY
    
    enemy_unit.position = Position.ENEMY_CENTER_FRONT
    enemy_unit.side = Side.ENEMY
    
    battlefield = BattlefieldState()
    battlefield.add_unit(ally_unit)
    battlefield.add_unit(enemy_unit)
    
    safe_print(f"战场初始化完成:")
    safe_print(f"  [Ally] {ally_unit.name} (HP: {ally_unit.current_hp}/{ally_unit.max_hp}, Spd: {ally_unit.speed})")
    safe_print(f"  [Enemy] {enemy_unit.name} (HP: {enemy_unit.current_hp}/{enemy_unit.max_hp}, Spd: {enemy_unit.speed})")
    
    # 4. 初始化控制器
    controller = BattleFlowController(battlefield, data_loader=loader)
    
    # Inject Data Loader into Services that need it (SkillService, TriggerService?)
    # BattleFlowController.__init__ creates SkillService(self.data_loader, ...)
    # But wait, BattleFlowController implementation needs data_loader passed to it?
    # Let's check BattleFlowController.__init__ signature.
    # It takes (battlefield). It instantiates DataLoader inside? 
    # NO, looking at previous view, it does:
    # self.data_loader = DataLoader("data")  <-- using V1 loader?
    # self.skill_service = SkillService(self.data_loader, ...)
    
    # We need to PATCH BattleFlowController to use our loader, OR use inheritance,
    # OR pass it in if signature allows.
    # Currently it seems hardcoded or default.
    # 
    # Let's check BattleFlowController again.
    
    # 5. 执行模拟
    safe_print("\n=== 开始回合循环 ===")
    
    # Simple Config for test
    controller.config.max_turns = 3
    
    result = controller.execute_battle()
    
    safe_print(f"\n模拟结束: {result['result']}")
    safe_print(f"总回合数: {result['total_turns']}")
    safe_print(f"胜利者: {result['winner']}")

    return controller, loader

if __name__ == "__main__":
    main()
