"""回忆卡20093「夜空に想いを馳せて」(SSR) 技能效果回归测试

20093 的两个技能均为已有卡共用技能（导入时已存在，结构化转写复用）：
- 400000 攻撃上昇【める】: battle_start, character_base_master_id=100
  （桃園める全变体: 100301/100302/100303）攻撃+1000（与 20001 ふたりきりの勉強会 共用）
- 400036 ENダメージ上昇【シャイ】: battle_start, character_attribute=3(シャイ)
  シャイ属性味方全員 EN攻撃で与えるダメージ+2.1%（与 20014 感情はどこにある？ 共用）

验证点：
1. highlight(character_base_master_id=100) 命中める全变体（含新导入的100303），ATK+1000（固定值）
2. highlight(character_attribute=3) 命中シャイ属性味方，DealtDamage +2.1% 且 damage_element=2（仅EN）
3. 两个highlight相互独立：非シャイ的める变体只吃ATK、非める的シャイ只吃EN增伤
4. damage_element=2 过滤在伤害乘区中生效（EN伤害享受、物理伤害不享受）
5. memory buff 字段规范：is_memory_buff=True / timing_type=3 / duration=-1
"""
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
os.chdir(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.entities.memory_card import MemoryCard
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.battle_flow_controller import BattleFlowController

import unittest


def _make_ally(cid, name, position, element=1):
    """创建友方单位（使用角色库数据，element 显式指定用于highlight匹配）"""
    char = dl.get_character_by_id(cid)
    if char:
        stats = char.max_level_stats
        base_atk, base_hp = stats.attack, stats.hp
        base_def, base_spd = stats.defense, stats.speed
    else:
        base_atk, base_hp, base_def, base_spd = 500, 10000, 300, 200
    return UnitState(
        unit_id=f"ally_{cid}", name=name, side=Side.ALLY,
        position=position, character_id=cid, level=60,
        element=element, character_type=2,
        max_hp=base_hp, current_hp=base_hp,
        attack=base_atk, defense=base_def, speed=base_spd,
        crit_rate=0.0, crit_damage=50.0, advantage_damage=0.0,
        initial_active_point=3, initial_passive_point=3, max_extra_point=5,
        current_ap=3, current_pp=3, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_enemy():
    return UnitState(
        unit_id="enemy_front", name="敌方木桩", side=Side.ENEMY,
        position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=1,
        element=1, character_type=1,
        max_hp=999999, current_hp=999999,
        attack=10, defense=0, speed=50,
        crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
        initial_active_point=0, initial_passive_point=0, max_extra_point=0,
        current_ap=0, current_pp=0, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_card(card_id):
    mem_info = dl.load_memories().get(card_id)
    return MemoryCard(
        card_id=card_id, name=mem_info.name,
        description=mem_info.description, rarity=mem_info.rarity,
        highlights=mem_info.highlights,
    )


dl = DataLoader()
dl.load_all()
dms = DamageService()


def _make_controller(bf):
    aus = AuraService()
    controller = BattleFlowController(bf, dl)
    controller.damage_service = dms
    controller.aura_service = aus
    return controller, aus


def _make_battle():
    """4友方阵容覆盖 highlight 交叉场景：
    - meru_shy: 100303（める变体，シャイ）→ 两highlight都命中
    - meru_water: 100302（める变体，非シャイ）→ 仅 base_id=100 命中
    - shy_other: 120301（ロージー，シャイ）→ 仅 attr=3 命中
    - other: 120302（ロージー，非シャイ）→ 都不命中
    """
    meru_shy = _make_ally(100303, "める(シャイ)", Position.ALLY_LEFT_FRONT, element=3)
    meru_water = _make_ally(100302, "める(非シャイ)", Position.ALLY_CENTER_FRONT, element=2)
    shy_other = _make_ally(120301, "ロージー(シャイ)", Position.ALLY_RIGHT_FRONT, element=3)
    other = _make_ally(120302, "ロージー(非シャイ)", Position.ALLY_CENTER_BACK, element=1)
    bf = BattlefieldState()
    bf.friend_team = [meru_shy, meru_water, shy_other, other]
    bf.enemy_team = [_make_enemy()]
    bf.memory_cards = [_make_card(20093)]
    return bf, meru_shy, meru_water, shy_other, other


class TestMemory20093Skill400000(unittest.TestCase):
    """400000 攻撃上昇【める】: base_id=100 → める全变体 ATK+1000"""

    def test_meru_variants_atk_up_1000(self):
        bf, meru_shy, meru_water, shy_other, other = _make_battle()
        atk = {u.unit_id: dms._calculate_final_stat(u, "attack") for u in bf.friend_team}
        controller, _ = _make_controller(bf)
        controller._apply_memory_card_effects()
        self.assertEqual(
            dms._calculate_final_stat(meru_shy, "attack"), atk["ally_100303"] + 1000,
            "める变体(100303)应获得ATK+1000")
        self.assertEqual(
            dms._calculate_final_stat(meru_water, "attack"), atk["ally_100302"] + 1000,
            "める变体(100302)应获得ATK+1000")
        self.assertEqual(
            dms._calculate_final_stat(shy_other, "attack"), atk["ally_120301"],
            "非める的シャイ味方不应获得ATK上昇")
        self.assertEqual(
            dms._calculate_final_stat(other, "attack"), atk["ally_120302"],
            "非める味方不应获得ATK上昇")

    def test_atk_buff_fields(self):
        bf, *_ = _make_battle()
        controller, _ = _make_controller(bf)
        controller._apply_memory_card_effects()
        for u in bf.friend_team:
            buffs = [b for b in u.buffs if getattr(b, 'is_memory_buff', False)
                     and b.effect_type == "StatusAttack"]
            if u.character_id in (100303, 100302):
                self.assertEqual(len(buffs), 1)
                self.assertEqual(buffs[0].value, 1000)      # 固定值
                self.assertEqual(buffs[0].duration, -1)     # 永续
                self.assertEqual(buffs[0].timing_type, 3)   # 回忆卡统一timing
                self.assertTrue(buffs[0].is_memory_buff)
            else:
                self.assertEqual(len(buffs), 0)


class TestMemory20093Skill400036(unittest.TestCase):
    """400036 ENダメージ上昇【シャイ】: attr=3 → シャイ味方 DealtDamage+2.1%(EN限定)"""

    def test_shy_allies_en_dealt_damage_buff(self):
        bf, meru_shy, meru_water, shy_other, other = _make_battle()
        controller, _ = _make_controller(bf)
        controller._apply_memory_card_effects()
        for u in bf.friend_team:
            buffs = [b for b in u.buffs if getattr(b, 'is_memory_buff', False)
                     and b.effect_type == "DealtDamage"]
            if u.element == 3:
                self.assertEqual(len(buffs), 1, f"{u.unit_id}(シャイ)应获得EN与ダメbuff")
                self.assertAlmostEqual(buffs[0].value, 2.1)
                self.assertEqual(buffs[0].damage_element, 2)  # EN限定
                self.assertEqual(buffs[0].duration, -1)
                self.assertEqual(buffs[0].timing_type, 3)
            else:
                self.assertEqual(len(buffs), 0, f"{u.unit_id}(非シャイ)不应获得EN与ダメbuff")

    def test_en_element_filter_in_damage_multiplier(self):
        """damage_element=2 过滤：EN伤害乘区享受+2.1%、物理伤害不享受"""
        bf, meru_shy, *_ = _make_battle()
        controller, _ = _make_controller(bf)
        controller._apply_memory_card_effects()
        mult_en = dms._get_damage_dealt_multiplier(meru_shy, damage_element=2)
        mult_phys = dms._get_damage_dealt_multiplier(meru_shy, damage_element=1)
        self.assertAlmostEqual(mult_en, 1.021, places=6,
                               msg="EN伤害乘区应+2.1%")
        self.assertAlmostEqual(mult_phys, 1.0, places=6,
                               msg="物理伤害乘区不应享受EN限定增伤")

    def test_card_metadata(self):
        """卡片数据完整性：SSR、description、2个highlight"""
        card = _make_card(20093)
        self.assertEqual(card.rarity, 2)
        self.assertEqual(card.name, "夜空に想いを馳せて")
        self.assertEqual(len(card.highlights), 2)
        by_skill = {h.skill_master_id: h for h in card.highlights}
        self.assertIn(400000, by_skill)
        self.assertIn(400036, by_skill)
        self.assertEqual(by_skill[400000].character_base_master_id, 100)
        self.assertEqual(by_skill[400036].character_attribute, 3)


if __name__ == "__main__":
    unittest.main()
