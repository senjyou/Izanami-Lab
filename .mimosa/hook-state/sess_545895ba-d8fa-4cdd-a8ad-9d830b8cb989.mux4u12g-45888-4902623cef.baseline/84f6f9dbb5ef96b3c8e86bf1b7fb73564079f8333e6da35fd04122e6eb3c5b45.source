        owner = make_unit("owner")
        target = make_unit("t1", is_alive=False)
        ctx = make_context(targets=[target], primary_target=target)
        condition = {'type': 'target_is_alive'}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_target_is_alive_no_target(self):
        """target_is_alive: 无目标时False。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context()
        condition = {'type': 'target_is_alive'}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_target_is_back_row_back(self):
        """target_is_back_row: 目标在后排。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        target = make_unit("t1", side=Side.ALLY, position=Position.ALLY_LEFT_BACK)
        ctx = make_context(targets=[target], primary_target=target)
        condition = {'type': 'target_is_back_row'}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_target_is_back_row_front(self):
        """target_is_back_row: 目标在前排则False。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        target = make_unit("t1", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        ctx = make_context(targets=[target], primary_target=target)
        condition = {'type': 'target_is_back_row'}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_target_is_front_ally_correct_position(self):
        """target_is_front_ally: 目标在owner正前方（HP_BELOW+triggered_by）。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY, position=Position.ALLY_LEFT_BACK)
        front_ally = make_unit("t1", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        ctx = make_context(timing=TriggerTiming.HP_BELOW, triggered_by=front_ally)
        condition = {'type': 'target_is_front_ally'}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_target_is_front_ally_wrong_position(self):
        """target_is_front_ally: 目标不在正前方则False。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY, position=Position.ALLY_LEFT_BACK)
        wrong_ally = make_unit("t1", side=Side.ALLY, position=Position.ALLY_CENTER_FRONT)
        ctx = make_context(timing=TriggerTiming.HP_BELOW, triggered_by=wrong_ally)
        condition = {'type': 'target_is_front_ally'}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_target_is_front_ally_owner_at_front(self):
        """target_is_front_ally: owner在前排（无正前方）则False。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        target = make_unit("t1", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        ctx = make_context(targets=[target])
        condition = {'type': 'target_is_front_ally'}
        # _get_front_position(owner.position)=None for front position
        assert call_condition(ts, condition, owner, ctx) is False

    def test_target_is_front_ally_uses_actor_when_no_targets(self):
        """target_is_front_ally: 无targets时使用actor。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY, position=Position.ALLY_LEFT_BACK)
        actor = make_unit("a1", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        ctx = make_context(actor=actor, targets=[])
        condition = {'type': 'target_is_front_ally'}
        assert call_condition(ts, condition, owner, ctx) is True


