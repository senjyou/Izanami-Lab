        owner = make_unit("owner")
        ctx = make_context()
        condition = {'type': 'is_debuff', 'value': False}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_debuff_type_found_in_applied(self):
        """debuff_type: 在applied_debuff_types中找到。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        target = make_unit("t1")
        ctx = make_context(targets=[target], applied_debuff_types={'knockout', 'atk_down'})
        condition = {'type': 'debuff_type', 'value': 'knockout'}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_debuff_type_not_found_in_applied(self):
        """debuff_type: 在applied_debuff_types中未找到。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        target = make_unit("t1")
        ctx = make_context(targets=[target], applied_debuff_types={'atk_down'})
        condition = {'type': 'debuff_type', 'value': 'knockout'}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_debuff_type_fallback_to_target_debuffs(self):
        """debuff_type: 无applied_debuff_types时检查目标当前debuffs。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        target = make_unit("t1")
        target.debuffs.append(make_buff(name="knockout", effect_type="knockout", is_debuff=True))
        ctx = make_context(targets=[target], applied_debuff_types=set())
        condition = {'type': 'debuff_type', 'value': 'knockout'}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_is_status_ailment_in_applied(self):
        """is_status_ailment: applied中含状态异常。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        target = make_unit("t1")
        ctx = make_context(targets=[target], applied_debuff_types={'conflagration', 'atk_down'})
        condition = {'type': 'is_status_ailment'}
        # conflagration(炎上)是状态异常
        assert call_condition(ts, condition, owner, ctx) is True

    def test_is_status_ailment_not_in_applied(self):
        """is_status_ailment: applied中无状态异常。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        target = make_unit("t1")
        ctx = make_context(targets=[target], applied_debuff_types={'atk_down', 'def_down'})
        condition = {'type': 'is_status_ailment'}
        # atk_down/def_down不是状态异常
        assert call_condition(ts, condition, owner, ctx) is False

    def test_is_status_ailment_fallback_to_target(self):
        """is_status_ailment: 无applied时检查目标当前debuffs。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        target = make_unit("t1")
        target.debuffs.append(make_buff(name="poison", effect_type="poison", is_debuff=True))
        ctx = make_context(targets=[target], applied_debuff_types=set())
        condition = {'type': 'is_status_ailment'}
        # poison(毒)是状态异常
        assert call_condition(ts, condition, owner, ctx) is True

    def test_exclude_timing_not_excluded(self):
        """exclude_timing: 当前时机不在排除列表。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        bf = BattlefieldState()
        bf.current_trigger_phase = None  # 无当前阶段标志
        ctx = make_context(battlefield=bf)
        condition = {'type': 'exclude_timing', 'value': ['on_turn_start']}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_exclude_timing_excluded(self):
        """exclude_timing: 当前时机在排除列表则False。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        bf = BattlefieldState()
        bf.current_trigger_phase = TriggerTiming.TURN_START
        ctx = make_context(battlefield=bf)
        condition = {'type': 'exclude_timing', 'value': ['on_turn_start']}
        assert call_condition(ts, condition, owner, ctx) is False


