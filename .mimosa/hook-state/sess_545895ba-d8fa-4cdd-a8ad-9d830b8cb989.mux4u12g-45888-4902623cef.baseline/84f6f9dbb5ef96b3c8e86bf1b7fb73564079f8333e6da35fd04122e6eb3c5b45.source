        owner = make_unit("owner", side=Side.ALLY)
        other_ally = make_unit("other", side=Side.ALLY)
        ctx = make_context(targets=[other_ally])
        condition = {'type': 'target_is_other_ally'}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_target_is_other_ally_only_self(self):
        """target_is_other_ally: targets只有owner自身则False。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        ctx = make_context(targets=[owner])
        condition = {'type': 'target_is_other_ally'}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_target_is_other_ally_no_targets(self):
        """target_is_other_ally: 无targets时False。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context(targets=[])
        condition = {'type': 'target_is_other_ally'}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_target_is_alive_alive(self):
        """target_is_alive: 目标存活。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        target = make_unit("t1", is_alive=True)
        ctx = make_context(targets=[target], primary_target=target)
        condition = {'type': 'target_is_alive'}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_target_is_alive_dead(self):
