# ─── 10. 辅助函数测试 ────────────────────────────────────

class TestHelpers:

    def test_eval_condition_ge(self):
        """_eval_condition: >= 操作符。"""
        assert _eval_condition(50, '>=', 50) is True
        assert _eval_condition(50, '>=', 51) is False

    def test_eval_condition_gt(self):
        """_eval_condition: > 操作符。"""
        assert _eval_condition(50, '>', 49) is True
        assert _eval_condition(50, '>', 50) is False

    def test_eval_condition_le(self):
        """_eval_condition: <= 操作符。"""
        assert _eval_condition(50, '<=', 50) is True
        assert _eval_condition(50, '<=', 49) is False

    def test_eval_condition_lt(self):
        """_eval_condition: < 操作符。"""
        assert _eval_condition(50, '<', 51) is True
        assert _eval_condition(50, '<', 50) is False

    def test_eval_condition_eq(self):
        """_eval_condition: == 操作符。"""
        assert _eval_condition(50, '==', 50) is True
        assert _eval_condition(50, '==', 51) is False

    def test_eval_condition_ne(self):
        """_eval_condition: != 操作符。"""
        assert _eval_condition(50, '!=', 51) is True
        assert _eval_condition(50, '!=', 50) is False

    def test_eval_condition_unknown_op(self):
        """_eval_condition: 未知操作符返回False。"""
        assert _eval_condition(50, '?', 50) is False

    def test_get_front_position_back_to_front(self):
        """_get_front_position: 后排映射到前排。"""
        assert _get_front_position(Position.ALLY_LEFT_BACK) == Position.ALLY_LEFT_FRONT
        assert _get_front_position(Position.ALLY_CENTER_BACK) == Position.ALLY_CENTER_FRONT
        assert _get_front_position(Position.ALLY_RIGHT_BACK) == Position.ALLY_RIGHT_FRONT
        assert _get_front_position(Position.ENEMY_LEFT_BACK) == Position.ENEMY_LEFT_FRONT
        assert _get_front_position(Position.ENEMY_CENTER_BACK) == Position.ENEMY_CENTER_FRONT
        assert _get_front_position(Position.ENEMY_RIGHT_BACK) == Position.ENEMY_RIGHT_FRONT

    def test_get_front_position_front_returns_none(self):
        """_get_front_position: 前排位置返回None（无映射）。"""
        assert _get_front_position(Position.ALLY_LEFT_FRONT) is None
        assert _get_front_position(Position.ALLY_CENTER_FRONT) is None
        assert _get_front_position(Position.ENEMY_RIGHT_FRONT) is None

    def test_is_back_row_back(self):
        """_is_back_row: 后排单位返回True。"""
        u = make_unit("u", position=Position.ALLY_LEFT_BACK)
        assert TriggerService._is_back_row(u) is True

    def test_is_back_row_front(self):
        """_is_back_row: 前排单位返回False。"""
        u = make_unit("u", position=Position.ALLY_LEFT_FRONT)
        assert TriggerService._is_back_row(u) is False


# ─── 11. 未知条件类型 ────────────────────────────────────

class TestUnknownCondition:

    def test_unknown_type_returns_true(self):
        """未知cond_type返回True（PASS allow）。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context()
        condition = {'type': 'totally_unknown_type', 'value': 100}
        # 未知类型默认PASS
        assert call_condition(ts, condition, owner, ctx) is True
