"""TriggerService._check_condition各类型单元测试。

覆盖_check_condition方法中的30种cond_type及其分支逻辑：
- 组合类型：and / condition_list (all/any)
- HP百分比类：self_hp_percent / cumulative_damage_percent / enemy_hp_percent / ally_hp_below / front_ally_hp_below / target_hp_not_cross_below
- 数量计数类：enemy_alive_count / ally_alive_count / round_number / round_number_modulo / skill_use_count_modulo / crit_count_mod / self_skill_use_count
- 标记类：self_has_mark / self_lacks_mark / target_has_mark
- 目标阵营类：target_is_ally / target_is_self / target_is_other_ally / target_is_alive / target_is_back_row / target_is_front_ally
- 攻击者类：actor_element / actor_character_type / attacker_is_back_row
- 状态类：is_debuff / is_status_ailment / debuff_type / exclude_timing
- 链接类：self_damage_link_active

测试通过直接调用_check_condition方法验证，使用最小化的TriggerContext。
"""
import sys
import os
import pytest
from dataclasses import dataclass
from types import SimpleNamespace
from typing import Optional, List, Set
from unittest.mock import MagicMock

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..', 'src'))

from src.entities_v2.unit_state import UnitState, BuffState, DamageLinkEntry
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, TriggerTiming
from src.combat_v2.services.trigger_service import (
    TriggerService, TriggerContext, _eval_condition, _get_front_position,
)


# ─── 工厂函数 ──────────────────────────────────────────────

def make_unit(unit_id="u1", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT,
              hp=50000, max_hp=50000, atk=10000, defense=5000, speed=500,
              element=2, character_type=1, crit_rate=0.0, crit_damage=0.5,
              is_alive=True):
    """创建测试用单位。"""
    u = UnitState(
        unit_id=unit_id, name=unit_id, side=side, position=position,
        character_id=999901, level=10, element=element, character_type=character_type,
        max_hp=max_hp, attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_hp=hp, current_ap=10, current_pp=10, current_ep=10,
    )
    u.is_alive = is_alive
    return u


def make_buff(name="b", effect_type="atk_up", value=10.0, duration=-1,
              value_tag=0, is_stackable=False, is_memory_buff=False,
              hit_limited=0, attack_limited=0, is_debuff=False, **extra):
    """创建测试用buff/debuff。"""
    kwargs = dict(
        buff_id=f"{name}_{id(object())}", name=name, effect_type=effect_type,
        value=value, duration=duration, timing_type=2, value_tag=value_tag,
        is_stackable=is_stackable, is_memory_buff=is_memory_buff,
        hit_limited=hit_limited, attack_limited=attack_limited,
        is_debuff=is_debuff,
    )
    kwargs.update(extra)
    return BuffState(**kwargs)


def make_mark_buff(name="kyou_chou", value=1.0):
    """创建一个mark debuff（effect_type=SkillEffectType.MARK.value='Mark'）。"""
    return make_buff(name=name, effect_type="Mark", value=value, is_debuff=True)


def make_context(timing=TriggerTiming.AFTER_AS_ATTACKED, battlefield=None,
                 actor=None, targets=None, triggered_by=None, primary_target=None,
                 applied_debuff_types=None):
    """创建测试用TriggerContext。"""
    if battlefield is None:
        battlefield = BattlefieldState()
    return TriggerContext(
        timing=timing,
        battlefield=battlefield,
        actor=actor,
        targets=targets or [],
        triggered_by=triggered_by,
        primary_target=primary_target,
        applied_debuff_types=applied_debuff_types or set(),
    )


def make_trigger_service():
    """创建TriggerService实例（无data_loader依赖）。"""
    ts = TriggerService()
    # 不设置data_loader，skill_use_count相关测试需手动设置
    return ts


def call_condition(ts, condition, owner, context):
    """便捷调用_check_condition的wrapper。"""
    parsed = {'global_condition': condition}
    return ts._check_condition(parsed, owner, context.timing, context)


# ─── 1. 无条件/默认 ────────────────────────────────────────

class TestNoCondition:

    def test_none_condition_returns_true(self):
        """condition=None时返回True。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context()
        assert call_condition(ts, None, owner, ctx) is True

    def test_no_type_returns_true(self):
        """condition无type字段时返回True。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context()
        # condition没有type字段
        assert call_condition(ts, {'value': 50}, owner, ctx) is True


# ─── 2. 组合条件 ───────────────────────────────────────────

class TestCompositeConditions:

    def test_and_all_pass(self):
        """and组合：所有子条件都满足。"""
        ts = make_trigger_service()
        owner = make_unit("owner", hp=30000)  # 60% HP
        ctx = make_context()
        condition = {
            'type': 'and',
            'conditions': [
                {'type': 'self_hp_percent', 'operator': '<=', 'value': 80},
                {'type': 'self_hp_percent', 'operator': '>=', 'value': 50},
            ]
        }
        assert call_condition(ts, condition, owner, ctx) is True

    def test_and_one_fails(self):
        """and组合：任一子条件不满足则整体不满足。"""
        ts = make_trigger_service()
        owner = make_unit("owner", hp=30000)  # 60% HP
        ctx = make_context()
        condition = {
            'type': 'and',
            'conditions': [
                {'type': 'self_hp_percent', 'operator': '<=', 'value': 50},  # 60>50, 失败
                {'type': 'self_hp_percent', 'operator': '>=', 'value': 50},  # 60>=50, 通过
            ]
        }
        assert call_condition(ts, condition, owner, ctx) is False

    def test_and_empty_returns_true(self):
        """and组合：空条件列表返回True。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context()
        condition = {'type': 'and', 'conditions': []}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_condition_list_all_mode(self):
        """condition_list mode=all：等价AND。"""
        ts = make_trigger_service()
        owner = make_unit("owner", hp=30000)
        ctx = make_context()
        condition = {
            'type': 'condition_list',
            'mode': 'all',
            'conditions': [
                {'type': 'self_hp_percent', 'operator': '<=', 'value': 80},
                {'type': 'self_hp_percent', 'operator': '>=', 'value': 50},
            ]
        }
        assert call_condition(ts, condition, owner, ctx) is True

    def test_condition_list_any_mode(self):
        """condition_list mode=any：等价OR。"""
        ts = make_trigger_service()
        owner = make_unit("owner", hp=30000)  # 60% HP
        ctx = make_context()
        condition = {
            'type': 'condition_list',
            'mode': 'any',
            'conditions': [
                {'type': 'self_hp_percent', 'operator': '<=', 'value': 50},  # 失败
                {'type': 'self_hp_percent', 'operator': '>=', 'value': 50},  # 通过
            ]
        }
        assert call_condition(ts, condition, owner, ctx) is True

    def test_condition_list_any_all_fail(self):
        """condition_list mode=any：全部失败则失败。"""
        ts = make_trigger_service()
        owner = make_unit("owner", hp=30000)
        ctx = make_context()
        condition = {
            'type': 'condition_list',
            'mode': 'any',
            'conditions': [
                {'type': 'self_hp_percent', 'operator': '<=', 'value': 50},  # 失败
                {'type': 'self_hp_percent', 'operator': '>=', 'value': 80},  # 失败
            ]
        }
        assert call_condition(ts, condition, owner, ctx) is False


# ─── 3. HP百分比类条件 ────────────────────────────────────

class TestHpPercentConditions:

    def test_self_hp_percent_le(self):
        """self_hp_percent: HP<=80% ✓。"""
        ts = make_trigger_service()
        owner = make_unit("owner", hp=40000, max_hp=50000)  # 80%
        ctx = make_context(timing=TriggerTiming.AFTER_AS_ATTACKED)
        condition = {'type': 'self_hp_percent', 'operator': '<=', 'value': 80}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_self_hp_percent_gt(self):
        """self_hp_percent: HP>80% ✗（80%不>80%）。"""
        ts = make_trigger_service()
        owner = make_unit("owner", hp=40000, max_hp=50000)  # 80%
        ctx = make_context(timing=TriggerTiming.AFTER_AS_ATTACKED)
        condition = {'type': 'self_hp_percent', 'operator': '>', 'value': 80}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_self_hp_percent_hp_below_crossing_check(self):
        """self_hp_percent: HP_BELOW timing + <=/< 时需要跨越阈值。"""
        ts = make_trigger_service()
        owner = make_unit("owner", hp=8000, max_hp=50000)  # 16%
        owner.prev_hp_percent = 30.0  # 之前30%，现在16%
        ctx = make_context(timing=TriggerTiming.HP_BELOW)
        condition = {'type': 'self_hp_percent', 'operator': '<=', 'value': 20}
        # prev=30 > 20, current=16 <= 20, 跨越成功
        assert call_condition(ts, condition, owner, ctx) is True

    def test_self_hp_percent_hp_below_no_crossing(self):
        """self_hp_percent: HP_BELOW timing 但未跨越阈值则失败。"""
        ts = make_trigger_service()
        owner = make_unit("owner", hp=8000, max_hp=50000)  # 16%
        owner.prev_hp_percent = 18.0  # 之前18%, 未跨越20
        ctx = make_context(timing=TriggerTiming.HP_BELOW)
        condition = {'type': 'self_hp_percent', 'operator': '<=', 'value': 20}
        # prev=18 <= 20, 未跨越
        assert call_condition(ts, condition, owner, ctx) is False

    def test_cumulative_damage_percent(self):
        """cumulative_damage_percent: 累计伤害达阈值。"""
        ts = make_trigger_service()
        owner = make_unit("owner", max_hp=50000)
        owner.cumulative_hp_damage = 15000  # 30%
        ctx = make_context()
        condition = {'type': 'cumulative_damage_percent', 'operator': '>=', 'value': 25}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_cumulative_damage_percent_below_threshold(self):
        """cumulative_damage_percent: 未达阈值。"""
        ts = make_trigger_service()
        owner = make_unit("owner", max_hp=50000)
        owner.cumulative_hp_damage = 10000  # 20%
        ctx = make_context()
        condition = {'type': 'cumulative_damage_percent', 'operator': '>=', 'value': 25}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_enemy_hp_percent_triggered_by(self):
        """enemy_hp_percent: 使用triggered_by单位的HP。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        enemy = make_unit("e1", side=Side.ENEMY, hp=10000, max_hp=50000)  # 20%
        ctx = make_context(triggered_by=enemy)
        condition = {'type': 'enemy_hp_percent', 'operator': '<=', 'value': 30}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_enemy_hp_percent_no_triggered_by_uses_max(self):
        """enemy_hp_percent: 无triggered_by时取敌方最大HP百分比。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        bf = BattlefieldState()
        bf.enemy_team = [
            make_unit("e1", side=Side.ENEMY, hp=40000, max_hp=50000),  # 80%
            make_unit("e2", side=Side.ENEMY, hp=10000, max_hp=50000),  # 20%
        ]
        ctx = make_context(battlefield=bf)
        condition = {'type': 'enemy_hp_percent', 'operator': '>=', 'value': 70}
        # max=80% >= 70%
        assert call_condition(ts, condition, owner, ctx) is True

    def test_enemy_hp_percent_with_mark_name(self):
        """enemy_hp_percent: 仅检查持指定mark的敌方。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        e1 = make_unit("e1", side=Side.ENEMY, hp=40000, max_hp=50000)  # 80%, 无mark
        e2 = make_unit("e2", side=Side.ENEMY, hp=5000, max_hp=50000)  # 10%, 有mark
        e2.debuffs.append(make_mark_buff(name="hoteri"))
        bf = BattlefieldState()
        bf.enemy_team = [e1, e2]
        ctx = make_context(battlefield=bf)
        condition = {
            'type': 'enemy_hp_percent', 'operator': '<=', 'value': 30,
            'mark_name': 'hoteri'
        }
        # 只有e2有mark, 10% <= 30%
        assert call_condition(ts, condition, owner, ctx) is True

    def test_ally_hp_below_player_ally_triggers(self):
        """ally_hp_below: 玩家友方HP低于阈值时触发。"""
        ts = make_trigger_service()
        # PS持有者也在友方
        owner = make_unit("owner", side=Side.ALLY)
        ally = make_unit("ally1", side=Side.ALLY, hp=8000, max_hp=50000)  # 16%
        ctx = make_context(timing=TriggerTiming.HP_BELOW, triggered_by=ally)
        condition = {'type': 'ally_hp_below', 'operator': '<=', 'value': 20}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_ally_hp_below_enemy_hp_blocked(self):
        """ally_hp_below: 敌方HP下降不触发（即使PS持有者在敌方）。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ENEMY)  # PS持有者在敌方
        enemy = make_unit("e1", side=Side.ENEMY, hp=8000, max_hp=50000)
        ctx = make_context(timing=TriggerTiming.HP_BELOW, triggered_by=enemy)
        condition = {'type': 'ally_hp_below', 'operator': '<=', 'value': 20}
        # triggered_by.side != Side.ALLY, 应被阻止
        assert call_condition(ts, condition, owner, ctx) is False

    def test_front_ally_hp_below_correct_position(self):
        """front_ally_hp_below: 正前方友方HP低于阈值。"""
        ts = make_trigger_service()
        # owner在后排中央，正前方为前排中央
        owner = make_unit("owner", side=Side.ALLY, position=Position.ALLY_CENTER_BACK)
        front_ally = make_unit("a1", side=Side.ALLY, position=Position.ALLY_CENTER_FRONT,
                               hp=8000, max_hp=50000)
        ctx = make_context(timing=TriggerTiming.HP_BELOW, triggered_by=front_ally)
        condition = {'type': 'front_ally_hp_below', 'operator': '<=', 'value': 20}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_front_ally_hp_below_wrong_position(self):
        """front_ally_hp_below: 非正前方位置不触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY, position=Position.ALLY_CENTER_BACK)
        # 触发者在左侧前排（非正前方）
        wrong_ally = make_unit("a1", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT,
                               hp=8000, max_hp=50000)
        ctx = make_context(timing=TriggerTiming.HP_BELOW, triggered_by=wrong_ally)
        condition = {'type': 'front_ally_hp_below', 'operator': '<=', 'value': 20}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_target_hp_not_cross_below_no_cross(self):
        """target_hp_not_cross_below: 未跨越阈值则通过（not crossed=True）。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        target = make_unit("t1", side=Side.ALLY, hp=25000, max_hp=50000)  # 50%
        target.prev_hp_percent = 60.0
        ctx = make_context(targets=[target], primary_target=target)
        condition = {'type': 'target_hp_not_cross_below', 'value': 30}
        # prev=60 > 30, current=50, 未跨越30
        assert call_condition(ts, condition, owner, ctx) is True

    def test_target_hp_not_cross_below_crossed(self):
        """target_hp_not_cross_below: 跨越阈值则失败。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        target = make_unit("t1", side=Side.ALLY, hp=10000, max_hp=50000)  # 20%
        target.prev_hp_percent = 50.0
        ctx = make_context(targets=[target], primary_target=target)
        condition = {'type': 'target_hp_not_cross_below', 'value': 30}
        # prev=50 > 30, current=20 <= 30, 跨越了30
        assert call_condition(ts, condition, owner, ctx) is False


# ─── 4. 数量/计数类条件 ───────────────────────────────────

class TestCountConditions:

    def test_enemy_alive_count_ge(self):
        """enemy_alive_count: 敌方存活数>=阈值。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        bf = BattlefieldState()
        bf.enemy_team = [
            make_unit("e1", side=Side.ENEMY),
            make_unit("e2", side=Side.ENEMY),
            make_unit("e3", side=Side.ENEMY, is_alive=False),
        ]
        ctx = make_context(battlefield=bf)
        condition = {'type': 'enemy_alive_count', 'operator': '>=', 'value': 2}
        # 2存活 >= 2
        assert call_condition(ts, condition, owner, ctx) is True

    def test_enemy_alive_count_lt(self):
        """enemy_alive_count: 敌方存活数<阈值。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        bf = BattlefieldState()
        bf.enemy_team = [
            make_unit("e1", side=Side.ENEMY),
            make_unit("e2", side=Side.ENEMY, is_alive=False),
        ]
        ctx = make_context(battlefield=bf)
        condition = {'type': 'enemy_alive_count', 'operator': '>=', 'value': 2}
        # 1存活 < 2
        assert call_condition(ts, condition, owner, ctx) is False

    def test_ally_alive_count(self):
        """ally_alive_count: 友方存活数检查。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        bf = BattlefieldState()
        bf.friend_team = [
            owner,
            make_unit("a1", side=Side.ALLY),
            make_unit("a2", side=Side.ALLY, is_alive=False),
        ]
        ctx = make_context(battlefield=bf)
        condition = {'type': 'ally_alive_count', 'operator': '>=', 'value': 2}
        # owner+a1存活=2
        assert call_condition(ts, condition, owner, ctx) is True

    def test_round_number_eq(self):
        """round_number: 当前回合数检查。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        bf = BattlefieldState()
        bf.turn_number = 3
        ctx = make_context(battlefield=bf)
        condition = {'type': 'round_number', 'operator': '==', 'value': 3}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_round_number_modulo(self):
        """round_number_modulo: 回合数取模。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        bf = BattlefieldState()
        bf.turn_number = 6
        ctx = make_context(battlefield=bf)
        condition = {'type': 'round_number_modulo', 'value': 3}
        # 6 % 3 == 0
        assert call_condition(ts, condition, owner, ctx) is True

    def test_round_number_modulo_not_zero(self):
        """round_number_modulo: 回合数取模不为0。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        bf = BattlefieldState()
        bf.turn_number = 5
        ctx = make_context(battlefield=bf)
        condition = {'type': 'round_number_modulo', 'value': 3}
        # 5 % 3 != 0
        assert call_condition(ts, condition, owner, ctx) is False

    def test_round_number_modulo_turn_zero(self):
        """round_number_modulo: turn=0时返回False。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        bf = BattlefieldState()
        bf.turn_number = 0
        ctx = make_context(battlefield=bf)
        condition = {'type': 'round_number_modulo', 'value': 3}
        # cur > 0 and ... → False
        assert call_condition(ts, condition, owner, ctx) is False

    def test_skill_use_count_modulo_threshold_met(self):
        """skill_use_count_modulo: count >= val时触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        owner.skill_use_count = {1001: 3, 1002: 1}
        # 模拟skill_data返回skill_type=1
        ts.data_loader = MagicMock()
        ts.data_loader.get_skill_by_id = lambda sid: SimpleNamespace(skill_type=1)
        ctx = make_context()
        condition = {'type': 'skill_use_count_modulo', 'value': 3}
        # 总count=4 >= 3
        assert call_condition(ts, condition, owner, ctx) is True

    def test_skill_use_count_modulo_threshold_not_met(self):
        """skill_use_count_modulo: count < val时不触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        owner.skill_use_count = {1001: 1, 1002: 1}
        ts.data_loader = MagicMock()
        ts.data_loader.get_skill_by_id = lambda sid: SimpleNamespace(skill_type=1)
        ctx = make_context()
        condition = {'type': 'skill_use_count_modulo', 'value': 3}
        # 总count=2 < 3
        assert call_condition(ts, condition, owner, ctx) is False

    def test_skill_use_count_modulo_exclude_skill_ids(self):
        """skill_use_count_modulo: 排除指定技能ID。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        owner.skill_use_count = {1001: 3, 1002: 1}
        ts.data_loader = MagicMock()
        ts.data_loader.get_skill_by_id = lambda sid: SimpleNamespace(skill_type=1)
        ctx = make_context()
        condition = {
            'type': 'skill_use_count_modulo', 'value': 3,
            'exclude_skill_ids': [1001]
        }
        # 排除1001后 count=1 < 3
        assert call_condition(ts, condition, owner, ctx) is False

    def test_skill_use_count_modulo_filter_skill_type(self):
        """skill_use_count_modulo: 按count_skill_types过滤。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        owner.skill_use_count = {1001: 3, 1002: 2}  # 1001=AS, 1002=PS
        ts.data_loader = MagicMock()
        # 1001是AS(skill_type=1), 1002是PS(skill_type=2)
        def get_skill(sid):
            return SimpleNamespace(skill_type=1 if sid == 1001 else 2)
        ts.data_loader.get_skill_by_id = get_skill
        ctx = make_context()
        # 只统计AS（默认count_skill_types=[1]）
        condition = {'type': 'skill_use_count_modulo', 'value': 3}
        # AS count=3 >= 3
        assert call_condition(ts, condition, owner, ctx) is True

    def test_crit_count_mod(self):
        """crit_count_mod: 暴击次数>=阈值。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        owner.crit_counter = 3
        ctx = make_context()
        condition = {'type': 'crit_count_mod', 'value': 3}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_crit_count_mod_below(self):
        """crit_count_mod: 暴击次数<阈值。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        owner.crit_counter = 2
        ctx = make_context()
        condition = {'type': 'crit_count_mod', 'value': 3}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_self_skill_use_count(self):
        """self_skill_use_count: 自身技能使用次数。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        owner.skill_use_count = {1001: 2, 1002: 1}
        ts.data_loader = MagicMock()
        ts.data_loader.get_skill_by_id = lambda sid: SimpleNamespace(skill_type=1)
        ctx = make_context()
        condition = {'type': 'self_skill_use_count', 'operator': '>=', 'value': 3}
        # 总=3 >= 3
        assert call_condition(ts, condition, owner, ctx) is True

    def test_self_skill_use_count_fallback_action_count(self):
        """self_skill_use_count: skill_use_count为空时回退到action_count_total。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        owner.action_count_total = 5
        ts.data_loader = MagicMock()
        ts.data_loader.get_skill_by_id = lambda sid: SimpleNamespace(skill_type=1)
        ctx = make_context()
        condition = {'type': 'self_skill_use_count', 'operator': '>=', 'value': 5}
        # count=0回退到action_count_total=5
        assert call_condition(ts, condition, owner, ctx) is True


