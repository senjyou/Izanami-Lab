# ─── 6. 目标阵营/位置类条件 ──────────────────────────────

class TestTargetSideConditions:

    def test_target_is_ally_same_side(self):
        """target_is_ally: 目标同阵营。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        target = make_unit("t1", side=Side.ALLY)
        ctx = make_context(targets=[target])
        condition = {'type': 'target_is_ally'}
        # 默认value=1=True
        assert call_condition(ts, condition, owner, ctx) is True

    def test_target_is_ally_different_side(self):
        """target_is_ally: 目标敌方阵营。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        target = make_unit("t1", side=Side.ENEMY)
        ctx = make_context(targets=[target])
        condition = {'type': 'target_is_ally'}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_target_is_ally_exclude_self(self):
        """target_is_ally: exclude_self=True时排除owner自身。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        # targets只有owner自己
        ctx = make_context(targets=[owner])
        condition = {'type': 'target_is_ally', 'exclude_self': 1}
        assert call_condition(ts, condition, owner, ctx) is False

    def test_target_is_ally_no_targets(self):
        """target_is_ally: 无targets时返回True。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        ctx = make_context(targets=[])
        condition = {'type': 'target_is_ally'}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_target_is_self_in_targets(self):
        """target_is_self: owner在targets中。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context(targets=[owner])
        condition = {'type': 'target_is_self'}
        assert call_condition(ts, condition, owner, ctx) is True

    def test_target_is_self_not_in_targets(self):
