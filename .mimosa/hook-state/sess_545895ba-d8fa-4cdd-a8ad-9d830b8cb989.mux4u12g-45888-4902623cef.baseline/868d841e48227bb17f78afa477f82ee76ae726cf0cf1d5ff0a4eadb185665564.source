#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
验证数据库分离结果
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.utils.encoding_utils import setup_console_encoding, safe_print
from src.database.db_manager import db_manager

setup_console_encoding()


def check_database(db_conn, db_name):
    """检查数据库表"""
    cursor = db_conn.cursor()
    
    safe_print(f"\n{'='*80}")
    safe_print(f"Database: {db_name}")
    safe_print('='*80)
    
    # 获取所有表
    cursor.execute("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name")
    tables = [row[0] for row in cursor.fetchall()]
    
    safe_print(f"\nTotal Tables: {len(tables)}")
    safe_print("-"*80)
    
    for table in tables:
        cursor.execute(f"SELECT COUNT(*) FROM {table}")
        count = cursor.fetchone()[0]
        safe_print(f"  {table:30s} {count:8d} rows")
    
    # 获取视图
    cursor.execute("SELECT name FROM sqlite_master WHERE type='view' ORDER BY name")
    views = [row[0] for row in cursor.fetchall()]
    
    if views:
        safe_print(f"\nViews: {len(views)}")
        safe_print("-"*80)
        for view in views:
            safe_print(f"  {view}")


def main():
    """主函数"""
    safe_print("="*80)
    safe_print("Database Separation Verification")
    safe_print("="*80)
    
    # 检查角色数据库
    check_database(db_manager.char_db, "character_stats.db")
    
    # 检查技能数据库
    check_database(db_manager.skill_db, "skill_data.db")
    
    # 测试示例查询
    safe_print("\n" + "="*80)
    safe_print("Sample Queries")
    safe_print("="*80)
    
    # 角色查询
    safe_print("\n1. Characters in database:")
    cursor = db_manager.char_db.cursor()
    cursor.execute("SELECT COUNT(*) FROM characters")
    char_count = cursor.fetchone()[0]
    safe_print(f"   Total: {char_count} characters")
    
    # 技能查询
    safe_print("\n2. Skills in database:")
    cursor = db_manager.skill_db.cursor()
    cursor.execute("SELECT COUNT(*) FROM skills")
    skill_count = cursor.fetchone()[0]
    safe_print(f"   Total: {skill_count} skills")
    
    # 跨库查询示例
    safe_print("\n3. Character 110301's skills:")
    cursor.execute("""
        SELECT s.skill_id, s.name, est.code
        FROM character_skills cs
        JOIN skills s ON cs.skill_id = s.skill_id
        JOIN enum_skill_types est ON s.skill_type_id = est.skill_type_id
        WHERE cs.character_id = 110301
        ORDER BY cs.id
    """)
    
    for i, row in enumerate(cursor.fetchall(), 1):
        safe_print(f"   {i}. [{row[2]}] {row[0]} - {row[1]}")
    
    safe_print("\n" + "="*80)
    safe_print("Verification Complete!")
    safe_print("="*80)
    
    db_manager.close()


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        safe_print(f"\nERROR: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)
