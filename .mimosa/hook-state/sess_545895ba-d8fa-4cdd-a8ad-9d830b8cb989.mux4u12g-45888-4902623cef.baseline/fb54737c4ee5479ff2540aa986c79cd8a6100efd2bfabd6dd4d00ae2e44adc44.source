"""Regression: 私に任せて！ (120154/220378) heal_link effect not working.

Bug: heal_link buff with duration=-1 + attacker_action was immediately removed
     by _cleanup_guard_buffs at the end of the caster's action. Also, HOT path
     (apply_regen) and split_heal_by_damage path lacked heal_link transfer.

Fix: 1. Change duration from -1 to 1 in skill_effects_hybrid.json
     2. Add just_applied protection to _cleanup_guard_buffs
     3. Add heal_link transfer to apply_regen (HOT path)
     4. Add heal_link transfer to _apply_split_heal_by_damage

Game mechanics:
- 通常回復・継続回復とも対象（リンクによる回復値は再度リンクされない）
- 食いしばり発生時の回復値はリンク対象外
- リンクされた回復値は回復値軽減/増加パフデパフに影響されない
- 幻惑によるHP回復は回復リンク対象外
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig


HEAL_LINK = SkillEffectType.HEAL_LINK.value
HOT = SkillEffectType.HEAL_OVER_TIME.value
RECEIVED_HEALING = SkillEffectType.RECEIVED_HEALING.value


def _make_unit(unit_id, name, side, position, *, hp=50000, atk=10000,
               defense=4000, speed=500, current_hp=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=2, character_type=1,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


def _make_heal_link_buff(caster_uid, target_uid, transfer_pct=100.0, duration=1):
    """Create a heal_link buff on target, linked to caster."""
    return BuffState(
        buff_id=f"{caster_uid}_heal_link_{target_uid}",
        name="回復リンク",
        effect_type=HEAL_LINK,
        value=transfer_pct,
        duration=duration,
        timing_type=AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
        source_unit_id=caster_uid,
        source_skill_id=120154,
        is_debuff=False,
        original_duration_type="attacker_action",
    )


def _make_hot_buff(caster_uid, value=50.0, caster_attack=10000):
    """Create a HOT (HEAL_OVER_TIME) buff."""
    return BuffState(
        buff_id=f"{caster_uid}_hot_{id(caster_uid)}",
        name="継続回復",
        effect_type=HOT,
        value=value,
        duration=3,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=caster_uid,
        caster_attack=caster_attack,
        heal_base="atk",
        is_debuff=False,
    )


def _make_received_healing_debuff(value=-50.0):
    """Create a ReceivedHealing debuff (heal efficacy reduction)."""
    return BuffState(
        buff_id=f"recv_heal_{id(value)}",
        name="被回復力ダウン",
        effect_type=RECEIVED_HEALING,
        value=value,
        duration=3,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        is_debuff=True,
    )


class TestRegHealLink(unittest.TestCase):
    """heal_link (回復リンク) must transfer healing from target to caster."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts, aus, dms, sts

    def _apply_heal_link(self, target, caster, aura_service, transfer_pct=100.0):
        """Apply heal_link buff to target, linked to caster."""
        buff = _make_heal_link_buff(caster.unit_id, target.unit_id, transfer_pct)
        aura_service.add_aura(target, buff)
        return buff

    # ── Test 1: buff duration (just_applied protection) ──

    def test_heal_link_survives_caster_action_end_with_just_applied(self):
        """heal_link (just_applied=True, duration=1) must survive _cleanup_guard_buffs
        at the end of the caster's action, and be removed on the next action end."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT, hp=50000)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT, hp=50000)
        enemy = _make_unit("enemy", "敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999, atk=1)
        bf = _make_bf(caster, target, enemy)

        ss, ts, aus, dms, sts = self._make_services(bf)
        ctrl = BattleFlowController(bf, BattleConfig(max_turns=5), data_loader=self.dl)
        ctrl._build_display_names()

        # Apply heal_link to target (just_applied=True, duration=1)
        self._apply_heal_link(target, caster, aus)

        hl_buffs = [b for b in target.buffs if b.effect_type == HEAL_LINK]
        self.assertEqual(len(hl_buffs), 1)
        self.assertTrue(hl_buffs[0].just_applied)
        self.assertEqual(hl_buffs[0].duration, 1)

        # Simulate caster action end: _cleanup_guard_buffs should skip (just_applied)
        ctrl._cleanup_guard_buffs(caster)
        hl_buffs = [b for b in target.buffs if b.effect_type == HEAL_LINK]
        self.assertEqual(len(hl_buffs), 1,
                         "heal_link must survive cleanup with just_applied=True, duration>0")

        # Clear just_applied (simulates end of action processing)
        for b in target.buffs + target.debuffs:
            b.just_applied = False

        # Simulate next caster action end: _cleanup_guard_buffs should remove
        ctrl._cleanup_guard_buffs(caster)
        hl_buffs = [b for b in target.buffs if b.effect_type == HEAL_LINK]
        self.assertEqual(len(hl_buffs), 0,
                         "heal_link must be removed on next action end (just_applied=False)")

    def test_duration_neg1_attacker_action_buff_still_cleaned_up(self):
        """Existing duration=-1 attacker_action buffs must still be cleaned up
        (just_applied protection must NOT affect them)."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT, hp=50000)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT, hp=50000)
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)
        ctrl = BattleFlowController(bf, BattleConfig(max_turns=5), data_loader=self.dl)

        # Apply a buff with duration=-1 + attacker_action (like the OLD heal_link config)
        old_buff = BuffState(
            buff_id="old_attacker_action_buff",
            name="旧buff",
            effect_type="SomeEffect",
            value=100.0,
            duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
            source_unit_id=caster.unit_id,
            is_debuff=False,
            original_duration_type="attacker_action",
        )
        aus.add_aura(target, old_buff)
        # just_applied is True after add_aura, but duration=-1 → duration>0 is False
        # → not (True and False) = not False = True → cleanup removes it

        ctrl._cleanup_guard_buffs(caster)
        old_buffs = [b for b in target.buffs if b.buff_id == "old_attacker_action_buff"]
        self.assertEqual(len(old_buffs), 0,
                         "duration=-1 attacker_action buff must still be cleaned up")

    # ── Test 2: direct heal transfer ──

    def test_direct_heal_triggers_heal_link_transfer(self):
        """When target with heal_link receives direct heal, transfer to caster."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, atk=10000, current_hp=10000)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=50000, atk=10000, current_hp=10000)
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)

        # Apply heal_link to target (linked to caster, 100% transfer)
        self._apply_heal_link(target, caster, aus)

        # Create heal effect: 50% of ATK = 5000 heal, target_type=ally_all
        heal_effect = type('obj', (object,), {
            'effect_type': 'heal',
            'value': 50.0,
            'target_type': 'ally_all',
            'flags': {'heal_base': 'atk'},
            'target_identifier': None,
            'hit_count': None,
            'condition': None,
        })()
        ss._current_skill_id = 120013

        caster_hp_before = caster.current_hp  # 10000
        target_hp_before = target.current_hp  # 10000

        result = ss._apply_heal(caster, heal_effect, bf)

        # Both caster and target are healed (ally_all)
        # heal = atk * 50% = 10000 * 0.5 = 5000
        expected_heal = 5000

        # Target: healed by 5000
        self.assertEqual(target.current_hp, target_hp_before + expected_heal,
                         "target should receive direct heal")

        # Caster: healed by 5000 (direct) + 5000 (transfer from target) = 10000
        self.assertEqual(caster.current_hp, caster_hp_before + expected_heal * 2,
                         "caster should receive direct heal + heal_link transfer")

    # ── Test 3: HOT (継続回復) transfer ──

    def test_hot_triggers_heal_link_transfer(self):
        """When target with heal_link receives HOT, transfer to caster."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)

        # Apply heal_link to target (linked to caster, 100% transfer)
        self._apply_heal_link(target, caster, aus)

        # Apply HOT buff to target: 50% of caster_attack=10000 → heal=5000
        hot_buff = _make_hot_buff(caster_uid="healer_id", value=50.0, caster_attack=10000)
        target.buffs.append(hot_buff)

        caster_hp_before = caster.current_hp  # 10000
        target_hp_before = target.current_hp  # 10000

        total_heal, details = sts.apply_regen(target, dms, bf)

        expected_heal = 5000  # 10000 * 50 / 100
        self.assertEqual(total_heal, expected_heal,
                         "target should receive 5000 HOT heal")

        # Target HP increased by 5000
        self.assertEqual(target.current_hp, target_hp_before + expected_heal,
                         "target HP should increase by HOT amount")

        # Caster HP increased by 5000 (transfer)
        self.assertEqual(caster.current_hp, caster_hp_before + expected_heal,
                         "caster should receive heal_link transfer from HOT")

    # ── Test 4: split_heal_by_damage transfer ──

    def test_split_heal_triggers_heal_link_transfer(self):
        """When target with heal_link receives split_heal_by_damage, transfer to caster."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, atk=10000, current_hp=10000)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=50000, atk=10000, current_hp=10000)
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)

        # Apply heal_link to target (linked to caster, 100% transfer)
        self._apply_heal_link(target, caster, aus)

        # Set up block damage total for split_heal_by_damage
        ss._block_damage_total = {1: 10000}
        ss._current_block_id = 1

        # Create split_heal_by_damage effect: 50% of block damage = 5000 heal per target
        split_effect = type('obj', (object,), {
            'effect_type': 'split_heal_by_damage',
            'value': 50.0,
            'target_type': 'ally_all',
            'flags': {'source_block_id': 1, 'split_among_targets': False},
            'target_identifier': None,
            'hit_count': None,
            'condition': None,
        })()
        ss._current_skill_id = 220360

        caster_hp_before = caster.current_hp  # 10000
        target_hp_before = target.current_hp  # 10000

        result = ss._apply_split_heal_by_damage(caster, split_effect, bf)

        expected_heal = 5000  # 10000 * 50 / 100, split=False so full amount per target

        # Target: healed by 5000
        self.assertEqual(target.current_hp, target_hp_before + expected_heal,
                         "target should receive split_heal")

        # Caster: healed by 5000 (direct) + 5000 (transfer from target) = 10000
        self.assertEqual(caster.current_hp, caster_hp_before + expected_heal * 2,
                         "caster should receive direct split_heal + heal_link transfer")

    # ── Test 5: transfer not affected by heal efficacy ──

    def test_heal_link_transfer_not_affected_by_caster_heal_efficacy(self):
        """リンクされた回復値は回復値軽減/増加パフデパフに影響されない.
        Caster has ReceivedHealing debuff (-50%), but transfer is NOT reduced."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)

        # Apply heal_link to target (linked to caster, 100% transfer)
        self._apply_heal_link(target, caster, aus)

        # Apply ReceivedHealing debuff to caster (-50% heal efficacy)
        recv_debuff = _make_received_healing_debuff(value=-50.0)
        caster.debuffs.append(recv_debuff)

        # Apply HOT buff to target: 50% of caster_attack=10000 → heal=5000
        hot_buff = _make_hot_buff(caster_uid="healer_id", value=50.0, caster_attack=10000)
        target.buffs.append(hot_buff)

        caster_hp_before = caster.current_hp  # 10000
        target_hp_before = target.current_hp  # 10000

        total_heal, details = sts.apply_regen(target, dms, bf)

        expected_heal = 5000  # HOT heal, not affected by caster's debuff

        # Target gets full 5000 HOT heal (target has no heal efficacy modifiers)
        self.assertEqual(target.current_hp, target_hp_before + expected_heal,
                         "target HOT heal should be 5000")

        # Caster gets full 5000 transfer (NOT halved by caster's -50% ReceivedHealing)
        # If efficacy DID affect transfer, caster would get 5000 * 0.5 = 2500
        self.assertEqual(caster.current_hp, caster_hp_before + expected_heal,
                         "heal_link transfer must NOT be affected by caster's heal efficacy")

    # ── Test 6: cheat_death recovery does not trigger heal_link ──

    def test_cheat_death_recovery_does_not_trigger_heal_link(self):
        """食いしばり発生時の回復値はリンク対象外.
        Direct HP modification (cheat_death recovery) must not trigger heal_link."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=50000, current_hp=5000)
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)

        # Apply heal_link to target (linked to caster, 100% transfer)
        self._apply_heal_link(target, caster, aus)

        caster_hp_before = caster.current_hp  # 10000

        # Simulate cheat_death recovery: directly modify HP (not through _apply_heal)
        # This is what cheat_death does — it bypasses _apply_heal
        target.current_hp = min(target.max_hp, target.current_hp + 20000)

        # Caster's HP should NOT change (cheat_death recovery is not heal_link target)
        self.assertEqual(caster.current_hp, caster_hp_before,
                         "cheat_death recovery must not trigger heal_link transfer")

    # ── Test 7: self-heal does not trigger self-transfer ──

    def test_self_heal_does_not_trigger_self_transfer(self):
        """施法者自身的回复不触发自転送 (source==target check).
        Caster has heal_link on self (source=caster). Self-heal must not transfer."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, atk=10000, current_hp=10000)
        bf = _make_bf(caster)

        ss, ts, aus, dms, sts = self._make_services(bf)

        # Apply heal_link to caster (source=caster, self-link)
        self._apply_heal_link(caster, caster, aus)

        # Create heal effect: 50% of ATK = 5000 heal, target_type=ally_all (includes self)
        heal_effect = type('obj', (object,), {
            'effect_type': 'heal',
            'value': 50.0,
            'target_type': 'ally_all',
            'flags': {'heal_base': 'atk'},
            'target_identifier': None,
            'hit_count': None,
            'condition': None,
        })()
        ss._current_skill_id = 120013

        caster_hp_before = caster.current_hp  # 10000

        result = ss._apply_heal(caster, heal_effect, bf)

        expected_heal = 5000  # 10000 * 50 / 100

        # Caster gets heal only (no self-transfer, since source==target)
        self.assertEqual(caster.current_hp, caster_hp_before + expected_heal,
                         "caster should receive direct heal only, no self-transfer")

    # ── Test 8: heal_link cleared when source (caster) dies ──

    def test_heal_link_removed_when_caster_dies(self):
        """死亡单位相关的heal_link buff必须清除.
        Caster places heal_link on target. When caster dies, heal_link on target
        must be removed (no one to transfer heals to)."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT, hp=50000)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT, hp=50000)
        other = _make_unit("other", "其他", Side.ALLY, Position.ALLY_RIGHT_FRONT, hp=50000)
        bf = _make_bf(caster, target, other)

        ss, ts, aus, dms, sts = self._make_services(bf)
        ctrl = BattleFlowController(bf, BattleConfig(max_turns=5), data_loader=self.dl)
        ctrl._build_display_names()

        # Apply heal_link to target (linked to caster) and other (linked to caster)
        self._apply_heal_link(target, caster, aus)
        self._apply_heal_link(other, caster, aus)

        # Verify buffs exist
        self.assertEqual(len([b for b in target.buffs if b.effect_type == HEAL_LINK]), 1)
        self.assertEqual(len([b for b in other.buffs if b.effect_type == HEAL_LINK]), 1)

        # Simulate caster death
        caster.is_alive = False
        ctrl._remove_heal_link_from_dead([caster])

        # heal_link buffs on target and other must be removed
        self.assertEqual(len([b for b in target.buffs if b.effect_type == HEAL_LINK]), 0,
                         "heal_link on target must be removed when caster dies")
        self.assertEqual(len([b for b in other.buffs if b.effect_type == HEAL_LINK]), 0,
                         "heal_link on other must be removed when caster dies")

    def test_heal_link_removed_when_holder_dies(self):
        """死亡者自身のheal_link buffも削除される.
        Target holds heal_link buff. When target dies, heal_link on target
        must be removed."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT, hp=50000)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT, hp=50000)
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)
        ctrl = BattleFlowController(bf, BattleConfig(max_turns=5), data_loader=self.dl)
        ctrl._build_display_names()

        # Apply heal_link to target (linked to caster)
        self._apply_heal_link(target, caster, aus)
        self.assertEqual(len([b for b in target.buffs if b.effect_type == HEAL_LINK]), 1)

        # Simulate target death
        target.is_alive = False
        ctrl._remove_heal_link_from_dead([target])

        # heal_link on target must be removed
        self.assertEqual(len([b for b in target.buffs if b.effect_type == HEAL_LINK]), 0,
                         "heal_link on dead target must be removed")

    def test_heal_link_not_removed_when_unrelated_unit_dies(self):
        """無関係な单位の死亡ではheal_linkは削除されない."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT, hp=50000)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT, hp=50000)
        unrelated = _make_unit("unrelated", "無関係", Side.ALLY, Position.ALLY_RIGHT_FRONT, hp=50000)
        bf = _make_bf(caster, target, unrelated)

        ss, ts, aus, dms, sts = self._make_services(bf)
        ctrl = BattleFlowController(bf, BattleConfig(max_turns=5), data_loader=self.dl)
        ctrl._build_display_names()

        # Apply heal_link to target (linked to caster)
        self._apply_heal_link(target, caster, aus)
        self.assertEqual(len([b for b in target.buffs if b.effect_type == HEAL_LINK]), 1)

        # Simulate unrelated unit death
        unrelated.is_alive = False
        ctrl._remove_heal_link_from_dead([unrelated])

        # heal_link on target must still exist
        self.assertEqual(len([b for b in target.buffs if b.effect_type == HEAL_LINK]), 1,
                         "heal_link must NOT be removed when unrelated unit dies")


if __name__ == '__main__':
    unittest.main()
