"""Regression tests for two bugs reported together:

Bug 1: 見切り構え・素 (230393) triggered even when the PS holder was NOT the
       attack target. The skill uses trigger_type=before_any_attacked but was
       missing global_condition=target_is_self, so any ally being attacked
       would fire it. Reference implementation: アイギスランパード (130009) which
       has global_condition=target_is_self.
       Fix: Added global_condition={"type": "target_is_self"} to 230393 in
            data/skill_effects_hybrid.json.

Bug 2: 若ノ減衰 (230384) skill_power_down effect was applied to the wrong
       target (nearest enemy via select_targets) instead of the actual
       attacker. _apply_skill_power_down did not handle
       target_identifier="trigger_attacker", so the debuff never landed on
       the attacker and damage was not reduced by 50%.
       Fix: Added trigger_attacker override in _apply_skill_power_down,
            mirroring the pattern in _apply_aura (L3976-3994).
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.skill_data_resolver import SkillDataResolver


_EN_AS = 120001  # generic EN damage AS for testing
SKILL_POWER_DOWN = SkillEffectType.SKILL_POWER_DOWN.value
GUARD = SkillEffectType.GUARD.value


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.WATER.value,
               character_type=2, skills=None, skill_levels=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class TestRegMikiriGakaeBug1(unittest.TestCase):
    """Bug 1: 見切り構え・素 (230393) must only trigger when SELF is attacked."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    def test_230393_has_target_is_self_condition(self):
        """230393 must have global_condition target_is_self (like 130009)."""
        parsed = self.dl.get_parsed_skill_data(230393)
        self.assertIsNotNone(parsed, "230393 parsed data missing")
        gc = parsed.get('global_condition')
        self.assertIsNotNone(gc, "230393 should have global_condition")
        self.assertEqual(gc.get('type'), 'target_is_self',
                         "230393 global_condition should be target_is_self")

    def test_does_not_trigger_when_ally_is_attacked(self):
        """230393 should NOT trigger when an ally (not self) is the attack target.

        Reproduces the original bug: 霞光's PS fired when 鳴雷/若雷 were attacked.
        """
        # 霞光 owns 230393 (see test_reg_naru_kouchoku_self_attacked.py SKILL_SPECS)
        kasumi = _make_unit(
            "kasumi", "霞光", Side.ENEMY, Position.ENEMY_RIGHT_FRONT,
            hp=200000, atk=10000, defense=4000, speed=500,
            skills=[220369, 220370, 230391, 230393],
            skill_levels={sid: 10 for sid in [220369, 220370, 230391, 230393]},
        )
        teammate = _make_unit(
            "tm", "队友", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=999999, atk=5000, defense=3000, speed=400,
        )
        attacker = _make_unit(
            "atk", "友方攻撃者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.FIRE.value, character_type=1,
        )
        bf = _make_bf(kasumi, teammate, attacker)
        _, ts = self._make_services(bf)

        # Attacker targets teammate (not kasumi) - 霞光 should NOT fire
        actions = ts.trigger_before_any_attacked(
            targets=[teammate], battlefield=bf, attacker=attacker
        )
        ps_triggered = any(a.skill_id == 230393 for a in actions)
        self.assertFalse(
            ps_triggered,
            "230393 見切り構え・素 should NOT trigger when ally (not self) is attacked"
        )

    def test_triggers_when_self_is_attacked(self):
        """230393 should still trigger when SELF is the attack target."""
        kasumi = _make_unit(
            "kasumi", "霞光", Side.ENEMY, Position.ENEMY_RIGHT_FRONT,
            hp=200000, atk=10000, defense=4000, speed=500,
            skills=[220369, 220370, 230391, 230393],
            skill_levels={sid: 10 for sid in [220369, 220370, 230391, 230393]},
        )
        attacker = _make_unit(
            "atk", "友方攻撃者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.FIRE.value, character_type=1,
        )
        bf = _make_bf(kasumi, attacker)
        ss, ts = self._make_services(bf)

        # Attacker targets kasumi - 霞光 SHOULD fire
        actions = ts.trigger_before_any_attacked(
            targets=[kasumi], battlefield=bf, attacker=attacker
        )
        ps_actions = [a for a in actions if a.skill_id == 230393]
        self.assertGreater(
            len(ps_actions), 0,
            "230393 見切り構え・素 should trigger when self is attacked"
        )

        # Execute and verify guard buff applied to kasumi
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_any_attacked"
        )
        guard_buffs = [b for b in kasumi.buffs if b.effect_type == GUARD]
        self.assertGreater(
            len(guard_buffs), 0,
            "guard buff should be applied to 霞光 when self is attacked"
        )


class TestRegWakanoGensuiBug2(unittest.TestCase):
    """Bug 2: 若ノ減衰 (230384) skill_power_down must apply to the attacker."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()
        cls.resolver = SkillDataResolver(cls.dl)

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts, dms

    def test_230384_triggers_when_back_row_attacker_attacks_other_ally(self):
        """230384 should trigger when a back-row attacker attacks another ally
        (not the PS owner). 描述: 他の味方が後列の敵から攻撃される直前に発動。
        """
        wakana = _make_unit(
            "wakana", "若雷", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=200000, atk=10000, defense=4000, speed=500,
            skills=[220369, 220370, 230383, 230384],
            skill_levels={sid: 10 for sid in [220369, 220370, 230383, 230384]},
        )
        teammate = _make_unit(
            "tm", "队友", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
            hp=999999, atk=5000, defense=3000, speed=400,
        )
        # Attacker in BACK row (required by global_condition attacker_is_back_row)
        attacker = _make_unit(
            "atk", "后排攻击者", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.FIRE.value, character_type=1,
            skills=[_EN_AS],
            skill_levels={_EN_AS: 10},
        )
        bf = _make_bf(wakana, teammate, attacker)
        _, ts, _ = self._make_services(bf)

        actions = ts.trigger_before_as_attacked(
            targets=[teammate], battlefield=bf, attacker=attacker
        )
        ps_actions = [a for a in actions if a.skill_id == 230384]
        self.assertGreater(
            len(ps_actions), 0,
            "230384 若ノ減衰 should trigger when back-row attacker attacks another ally"
        )

    def test_skill_power_down_applied_to_attacker_not_nearest_enemy(self):
        """skill_power_down debuff must be applied to the attacker (trigger_attacker),
        not to the nearest enemy via default select_targets.

        This is the core of bug 2: _apply_skill_power_down ignored
        target_identifier="trigger_attacker" and used select_targets, which
        picked the wrong target.
        """
        wakana = _make_unit(
            "wakana", "若雷", Side.ENEMY, Position.ENEMY_RIGHT_FRONT,
            hp=200000, atk=10000, defense=4000, speed=500,
            skills=[220369, 220370, 230383, 230384],
            skill_levels={sid: 10 for sid in [220369, 220370, 230383, 230384]},
        )
        # 队友（被攻击目标，满足 target_is_other_ally 条件）
        teammate = _make_unit(
            "tm", "队友", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
            hp=999999, atk=5000, defense=3000, speed=400,
        )
        # Decoy enemy closer to wakana than the real attacker - if the bug
        # exists, select_targets would pick this decoy instead of the attacker.
        decoy = _make_unit(
            "decoy", "诱饵敌方", Side.ALLY, Position.ALLY_RIGHT_FRONT,
            hp=50000, atk=1000, defense=4000, speed=400,
        )
        # Real attacker in BACK row
        attacker = _make_unit(
            "atk", "后排攻击者", Side.ALLY, Position.ALLY_LEFT_BACK,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.FIRE.value, character_type=1,
            skills=[_EN_AS],
            skill_levels={_EN_AS: 10},
        )
        bf = _make_bf(wakana, teammate, decoy, attacker)
        ss, ts, _ = self._make_services(bf)

        actions = ts.trigger_before_as_attacked(
            targets=[teammate], battlefield=bf, attacker=attacker
        )
        ps_actions = [a for a in actions if a.skill_id == 230384]
        self.assertGreater(len(ps_actions), 0, "230384 should trigger")

        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_as_attacked"
        )

        # The debuff must be on the attacker, NOT on the decoy
        attacker_debuffs = [d for d in attacker.debuffs
                            if d.effect_type == SKILL_POWER_DOWN]
        decoy_debuffs = [d for d in decoy.debuffs
                         if d.effect_type == SKILL_POWER_DOWN]
        self.assertGreater(
            len(attacker_debuffs), 0,
            "skill_power_down should be applied to the attacker (trigger_attacker)"
        )
        self.assertEqual(
            len(decoy_debuffs), 0,
            "skill_power_down should NOT be applied to the decoy (nearest enemy)"
        )
        # Value should be 50.0 percent
        self.assertAlmostEqual(
            float(attacker_debuffs[0].value), 50.0, places=1,
            msg="skill_power_down value should be 50.0%"
        )

    def test_damage_reduced_by_50_percent_after_ps_trigger(self):
        """After 若ノ減衰 triggers, the attacker's damage to 若雷's ally should be
        reduced by ~50% (skill_power_down 50%)."""
        wakana = _make_unit(
            "wakana", "若雷", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=200000, atk=10000, defense=4000, speed=500,
            skills=[220369, 220370, 230383, 230384],
            skill_levels={sid: 10 for sid in [220369, 220370, 230383, 230384]},
        )
        teammate = _make_unit(
            "tm", "队友", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
            hp=999999, atk=5000, defense=3000, speed=400,
        )
        attacker = _make_unit(
            "atk", "后排攻击者", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.FIRE.value, character_type=1,
            skills=[_EN_AS],
            skill_levels={_EN_AS: 10},
        )
        bf = _make_bf(wakana, teammate, attacker)
        ss, ts, dms = self._make_services(bf)
        as_data = self.resolver.resolve(_EN_AS, skill_level=10)

        # Baseline damage without skill_power_down
        attacker.debuffs.clear()
        base_result = dms.calculate_damage(attacker, teammate, as_data)
        base_dmg = base_result.total_damage
        self.assertGreater(base_dmg, 0, "baseline damage should be > 0")

        # Trigger 若ノ減衰 PS (攻击队友时触发)
        attacker.debuffs.clear()
        actions = ts.trigger_before_as_attacked(
            targets=[teammate], battlefield=bf, attacker=attacker
        )
        ps_actions = [a for a in actions if a.skill_id == 230384]
        self.assertGreater(len(ps_actions), 0, "230384 should trigger")
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_as_attacked"
        )

        # Verify debuff on attacker
        sp_debuffs = [d for d in attacker.debuffs
                      if d.effect_type == SKILL_POWER_DOWN]
        self.assertGreater(len(sp_debuffs), 0,
                           "skill_power_down should be on attacker")

        # Damage WITH skill_power_down should be ~50% of baseline
        reduced_result = dms.calculate_damage(attacker, teammate, as_data)
        reduced_dmg = reduced_result.total_damage
        expected = base_dmg * 0.5
        self.assertAlmostEqual(
            reduced_dmg, expected, delta=expected * 0.1,
            msg=f"damage should be reduced by 50%: base={base_dmg}, "
                f"expected~{expected:.0f}, got={reduced_dmg}"
        )


if __name__ == '__main__':
    unittest.main(verbosity=2)
