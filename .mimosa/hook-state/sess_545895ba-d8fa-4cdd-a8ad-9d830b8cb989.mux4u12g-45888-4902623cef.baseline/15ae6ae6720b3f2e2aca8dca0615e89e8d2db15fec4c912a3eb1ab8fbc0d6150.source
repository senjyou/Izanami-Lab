#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
混合数据驱动技能解析器 (Hybrid Skill Parser)
结合元数据 (Metadata) 和文本解析 (Text Parsing) 提取技能效果。
"""

import sys
import json
import re
from pathlib import Path
from dataclasses import asdict

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.utils.encoding_utils import setup_console_encoding, safe_print
from src.data.enums import DisplayTargetTypes, DisplayTargetRanges, AdditionalSkillKindFlags
from dataclasses import dataclass, field
from typing import Optional, Dict, List, Any, Union

@dataclass
class EffectData:
    """效果数据"""
    effect_type: str
    target_type: Optional[str] = None
    target_identifier: Optional[str] = None
    value: Optional[Union[str, int, float]] = None
    value_tag: Optional[str] = None
    value_source: Optional[str] = None
    duration: Optional[int] = None
    duration_type: Optional[int] = None
    duration_tag: Optional[str] = None
    hit_count: Optional[int] = None
    hit_count_tag: Optional[str] = None
    condition: Optional[Dict] = None
    flags: Dict[str, Any] = field(default_factory=dict)
    ignore_defense: int = 0
    ignore_shield: int = 0

@dataclass
class EffectBlock:
    """效果块"""
    block_id: int
    condition: Optional[Dict] = None
    effects: List[EffectData] = field(default_factory=list)

@dataclass
class ParsedSkill:
    """解析后的技能"""
    skill_id: int
    name: str
    skill_type: int
    resource_cost: Optional[int] = None
    cooldown: Optional[int] = None
    cooldown_update_timing: Optional[int] = None
    ignore_defense: int = 0
    ignore_shield: int = 0
    trigger_type: Optional[str] = None
    global_condition: Optional[Dict] = None
    effect_blocks: List[EffectBlock] = field(default_factory=list)
    
    # Display Target Fields (Client/Server Shared Logic)
    display_target_priority: Optional[int] = None
    display_target_range: Optional[int] = None
    display_target_type: Optional[int] = None
    
    parse_status: str = "success"
    parse_notes: List[str] = field(default_factory=list)

setup_console_encoding()

class HybridSkillParser:
    def __init__(self):
        self.stats = {'total': 0, 'success': 0, 'partial': 0, 'failed': 0, 'skipped': 0}
        
        # --- 正则模式定义 ---
        self.TRIGGER_PATTERNS = {
            r'バトル開始[時|时]|WAVE開始[時|时]': 'on_battle_start', # Treating Wave start as Battle start for now
            r'ターン開始時': 'on_turn_start',
            r'ターン終了時': 'on_turn_end',
            r'行動開始時': 'on_action_start',
            
            # Attack Triggers
            r'アクティブスキルで攻撃した後': 'after_as_attack',
            r'攻撃した後': 'after_any_attack', # Fallback if specific not matched
            r'他の味方がアクティブスキルで攻撃する前': 'before_ally_as_attack',
            
            # Attacked Triggers
            r'アクティブスキルで攻撃される直前': 'before_as_attacked',
            r'攻撃される直前': 'before_any_attacked', # Fallback
            r'自身がアクティブスキルで攻撃された(後|際|直後)': 'after_as_attacked',
            r'味方が攻撃される直前': 'before_ally_attacked',
            r'自身がアクティブスキルで攻撃する前': 'before_skill_use',
            r'アクティブスキルを(\d+)回使用するたびに': 'on_skill_use_count',
            
            
            # Damage Triggers
            r'被ダメージ時|攻撃を受けた時': 'on_damage_taken',
            r'ダメージを与えた時': 'on_damage_dealt',
            
            # Status Triggers
            r'戦闘不能時|死亡時': 'on_death',
            r'HPが(\d+)%以下になった際': 'on_hp_below',
            r'クリティカル発生時': 'on_crit',
            r'回避時': 'on_evade',
            r'敵を倒した際': 'on_kill',
            r'他の味方が倒された際': 'on_ally_killed',
            r'デバフが付与された際': 'on_debuff_applied',

            # New Triggers (User Request)
            r'味方が攻撃を受けた(直後|際|時)': 'after_ally_attacked',
            r'生存中の(敵|味方)の数が(\d+)体未満となった(直後|際|時)': 'on_unit_count_below',
            r'敵のHPが(\d+)%以下になった際': 'on_enemy_hp_below',
            r'敵が戦闘不能になった(際|直後|時)': 'on_enemy_killed',
            r'常時発動': 'on_battle_start'
        }
        
        self.STAT_CHANGE_PATTERNS = [
            # Pattern, EffectType, ValueType
            (r'攻撃力を.*?(\d+|\{.*?\})%', 'atk_up', 'percent'),
            (r'攻撃力が.*?(\d+|\{.*?\})%', 'atk_up', 'percent'),
            (r'防御力を.*?(\d+|\{.*?\})%', 'def_up', 'percent'),
            (r'防御力が.*?(\d+|\{.*?\})%', 'def_up', 'percent'),
            (r'(?:素早さ|行動速度)を.*?(\d+|\{.*?\})(?:%|上昇|低下|減少|増加|\s|$)', 'spd_up', 'fixed_or_percent'), # Relaxed suffix
            (r'(?:クリティカル率|会心率)を.*?(\d+|\{.*?\})%', 'crit_rate_up', 'percent'),
            (r'(?:クリティカルダメージ|会心ダメージ)を.*?(\d+|\{.*?\})%', 'crit_dmg_up', 'percent'),
            (r'命中率を.*?(\d+|\{.*?\})%', 'hit_rate_up', 'percent'),
            (r'回避率を.*?(\d+|\{.*?\})%', 'evade_rate_up', 'percent'),
            (r'与えるダメージを.*?(\d+|\{.*?\})%', 'dmg_dealt_up', 'percent'),
            (r'与ダメージを.*?(\d+|\{.*?\})%', 'dmg_dealt_up', 'percent'),
            (r'受ける.*?ダメージを.*?(\d+|\{.*?\})%', 'dmg_taken_up', 'percent'), # Relaxed prefix
            (r'HP回復量[をが].*?(\d+|\{.*?\})%', 'heal_efficacy_up', 'percent'),
        ]
        
        # 下降 Patterns
        self.STAT_DOWN_PATTERNS = [
             (r'攻撃力を.*?(\d+|\{.*?\})%', 'atk_down', 'percent'),
             (r'防御力を.*?(\d+|\{.*?\})%', 'def_down', 'percent'),
             (r'(?:素早さ|行動速度)を.*?(\d+|\{.*?\})(?:%|上昇|低下|減少|増加|\s|$)', 'spd_down', 'fixed_or_percent'),
             (r'(?:クリティカル率|会心率)を.*?(\d+|\{.*?\})%', 'crit_rate_down', 'percent'),
             (r'(?:クリティカルダメージ|会心ダメージ)を.*?(\d+|\{.*?\})%', 'crit_dmg_down', 'percent'),
             (r'命中率を.*?(\d+|\{.*?\})%', 'hit_rate_down', 'percent'),
             (r'回避率を.*?(\d+|\{.*?\})%', 'evade_rate_down', 'percent'),
             (r'与えるダメージを.*?(\d+|\{.*?\})%', 'dmg_dealt_down', 'percent'),
             (r'与ダメージを.*?(\d+|\{.*?\})%', 'dmg_dealt_down', 'percent'),
             (r'受ける.*?ダメージを.*?(\d+|\{.*?\})%', 'dmg_taken_down', 'percent'),
             (r'HP回復量を.*?(\d+|\{.*?\})%', 'heal_efficacy_down', 'percent'),
        ]

    def parse_file(self, input_path: str, output_path: str):
        with open(input_path, 'r', encoding='utf-8') as f:
            data = json.load(f)

        parsed_skills = {}
        for skill in data:
            skill_id = skill.get('Id')
            str_id = str(skill_id)
            
            # ID 过滤规则
            # 3xxxxx: Maze (Ignore)
            # 4xxxxx: Memory (Skip for now)
            if str_id.startswith('3') or str_id.startswith('4'):
                self.stats['skipped'] += 1
                continue
                
            # 只保留 1xxxxx 和 2xxxxx
            if not (str_id.startswith('1') or str_id.startswith('2')):
                self.stats['skipped'] += 1
                continue

            self.stats['total'] += 1
            parsed = self.parse_skill(skill)
            parsed_skills[parsed.skill_id] = asdict(parsed)
            
            if parsed.parse_status == 'success':
                self.stats['success'] += 1
            elif parsed.parse_status == 'partial':
                self.stats['partial'] += 1
            else:
                self.stats['failed'] += 1

        with open(output_path, 'w', encoding='utf-8') as f:
            json.dump(parsed_skills, f, ensure_ascii=False, indent=2)
            
        safe_print(f"解析完成: Total={self.stats['total']}, Success={self.stats['success']}, Failed={self.stats['failed']}, Skipped={self.stats['skipped']}")

    def parse_skill(self, skill_data: dict) -> ParsedSkill:
        # 1. 基础信息
        skill_id = skill_data.get('Id')
        str_id = str(skill_id)
        name = skill_data.get('Name')
        skill_type = skill_data.get('Type')
        
        parsed = ParsedSkill(
            skill_id=skill_id,
            name=name,
            skill_type=skill_type,
            resource_cost=skill_data.get('ResourceCost'),
            cooldown=skill_data.get('CoolTime'),
            cooldown_update_timing=skill_data.get('CoolTimeUpdateTiming'),
            display_target_priority=skill_data.get('DisplayTargetPriority'),
            display_target_range=skill_data.get('DisplayTargetRange'),
            display_target_type=skill_data.get('DisplayTargetType')
        )

        # 2. 提取描述文本
        description = ""
        templates = skill_data.get('DescriptionTemplates', [])
        if templates:
            description = templates[0].get('Template', "")

        # 3. 确定目标 (Metadata)
        # 即使是被动技能，元数据里的 DisplayTargetType 也可能有用 (如 'Self')
        target_type = self._resolve_target(skill_data)
        
        # 4. 判断是否为被动技能 (ID规则)
        # 13xxxx or 23xxxx
        is_passive = str_id.startswith('13') or str_id.startswith('23')
        
        if is_passive:
            # --- 被动技能解析策略 ---
            parsed.trigger_type = self._parse_trigger_from_text(description)
            
            # Reset temp global condition
            self._temp_global_condition = None
            
            effect_blocks = self._resolve_passive_effects(description, target_type, skill_data)
            
            # Retrieve global condition if found
            if self._temp_global_condition:
                 parsed.global_condition = self._temp_global_condition
                 
            # If no trigger found, but effects found, default to 'on_battle_start' (passive)
            if not parsed.trigger_type:
                 parsed.trigger_type = 'on_battle_start'

        else:
            # --- 主动技能解析策略 (Metadata Guided) ---
            effect_blocks = self._resolve_active_effects(skill_data, target_type, description)
            
        parsed.effect_blocks = effect_blocks
        
        # 6. 状态判定
        if not parsed.effect_blocks:
            parsed.parse_status = 'failed'
            parsed.parse_notes.append("No effects resolved")
        
        return parsed

    def _resolve_target(self, skill_data: dict) -> str:
        """从 DisplayTargetType/Range 解析目标"""
        dtype = skill_data.get('DisplayTargetType', 0)
        drange = skill_data.get('DisplayTargetRange', 0)
        
        if dtype == DisplayTargetTypes.Enemies:
            if drange == DisplayTargetRanges.AllPawns: return 'enemy_all'
            elif drange == DisplayTargetRanges.Line: return 'enemy_row'
            return 'enemy_single'
            
        elif dtype == DisplayTargetTypes.Friends:
            if drange == DisplayTargetRanges.AllPawns: return 'ally_all'
            return 'ally_single'

        elif dtype == DisplayTargetTypes.Self:
            return 'self'
            
        elif dtype == DisplayTargetTypes.SelfAndFriends:
            return 'ally_all'

        return 'unknown'

    def _extract_template_tags(self, skill_data: dict) -> dict:
        """Extract template tags from skill data."""
        tags = skill_data.get('TemplateTags', [])
        # Map TagName to the tag object (or just use name if values are complex)
        # For simple parsing, we just need to know if a tag exists.
        # But for value extraction, we might need value at Level 1.
        return {t.get('TagName'): t for t in tags}

    def _resolve_active_effects(self, skill_data: dict, default_target: str, description: str) -> list[EffectBlock]:
        """主动技能解析 (Metadata Guided + Text Scan)"""
        kinds = skill_data.get('AdditionalKinds', [])
        kind_mask = 0
        for k in kinds:
            kind_mask |= k.get('Value', 0)
            
        basic_kind = skill_data.get('Kind', 0)
        
        main_effects = []
        blocks = []
        tag_map = self._extract_template_tags(skill_data)
        
        # 1. 伤害 (Attack)
        if (basic_kind == 1) or (kind_mask & AdditionalSkillKindFlags.Attack):
            # Try parse damage
            eff = EffectData(effect_type='damage', target_type=default_target)
            if '威力' in tag_map: eff.value_tag = '威力'
            elif 'dmg' in tag_map and '威力' not in tag_map: eff.value_tag = 'dmg'
            
            if '攻撃回数' in tag_map: eff.hit_count_tag = '攻撃回数'
            
            if 'EN攻撃' in description: eff.flags['is_en_attack'] = True
            main_effects.append(eff)
            
            # Parse conditional damage boosts (e.g., "ターゲットのHPが40%以下の場合、この攻撃の与ダメージが{dmg}%増加する")
            cond_dmg_match = re.search(r'(ターゲット|対象)のHPが(\d+)%以下の場合.*?与ダメージが(\d+|\{.*?\})%増加', description)
            if cond_dmg_match:
                hp_threshold = int(cond_dmg_match.group(2))
                dmg_boost_str = cond_dmg_match.group(3)
                dmg_boost_val = 0
                dmg_boost_tag = None
                try:
                    dmg_boost_val = float(dmg_boost_str)
                except ValueError:
                    if dmg_boost_str.startswith('{') and dmg_boost_str.endswith('}'):
                        dmg_boost_tag = dmg_boost_str[1:-1]
                    else:
                        dmg_boost_tag = dmg_boost_str
                
                # Create conditional damage boost effect
                cond_eff = EffectData(
                    effect_type='dmg_dealt_up',
                    target_type='self',
                    value=dmg_boost_val,
                    value_tag=dmg_boost_tag,
                    condition={'type': 'target_hp_below', 'value': hp_threshold}
                )
                cond_eff.flags['value_type'] = 'percent'
                main_effects.append(cond_eff)
            
            # Check for status ailments (burn, poison, etc.) in active skills
            status_effects = self._scan_passive_damage(description, default_target)
            main_effects.extend(status_effects)

        # 2. 回复 (Heal)
        if (basic_kind == 3) or (kind_mask & AdditionalSkillKindFlags.Recovery):
             is_lifesteal = (kind_mask & AdditionalSkillKindFlags.Attack)
             if is_lifesteal:
                for e in main_effects:
                    if e.effect_type == 'damage':
                        if 'cure' in tag_map: e.flags['lifesteal_tag'] = 'cure'
                        else:
                             m = re.search(r'与えたダメージの(\d+)%', description)
                             if m: e.flags['lifesteal'] = int(m.group(1))
             
             # If not lifesteal, or strictly recovery skill
             if not is_lifesteal or ('回復' in description and '与えたダメージ' not in description):
                 # Check if it has heal components
                 if '回復' in description or 'cure' in str(tag_map):
                     eff = EffectData(effect_type='heal', target_type=default_target)
                     if '回復' in tag_map: eff.value_tag = '回復'
                     elif 'cure' in tag_map: eff.value_tag = 'cure'
                     eff.value_source = 'max_hp' 
                     if '攻撃力' in description and '回復' in description: eff.value_source = 'attack'
                     main_effects.append(eff)

        # 3. 妨害/支援 (Interference / Support)
        if (kind_mask & AdditionalSkillKindFlags.Interference) or (kind_mask & AdditionalSkillKindFlags.Support) or (basic_kind == 2):
            # Static Effects (Stun, etc.)
            static_effects = self._scan_text_for_static_effects(description, default_target, tag_map)
            main_effects.extend(static_effects)
            
            # Stat Changes (Atk Up, etc.)
            stat_effects = self._scan_text_for_stat_changes(description, default_target)
            main_effects.extend(stat_effects)

            # Resource Changes (AP/EP/PP)
            res_effects = self._parse_resource(description, default_target)
            main_effects.extend(res_effects)
            
        if main_effects:
            blocks.append(EffectBlock(block_id=1, effects=main_effects))

        return blocks

    def _resolve_passive_effects(self, text: str, default_target: str, skill_data: dict) -> list[EffectBlock]:
        """被动技能解析 (Text Driven)"""
        effect_blocks = []
        tag_map = self._extract_template_tags(skill_data)
        if skill_data.get('Id') == 130081:
             safe_print(f"DEBUG_130081_TAGS: {list(tag_map.keys())}")

        """被动技能解析 (Text Driven)"""
        effect_blocks = []
        
        # 1. 检测全局否定条件
        global_condition = None
        neg_match = re.search(r'([^\s。]+(?:未満|以下)の(?:とき|場合)).*?は発動しない', text)
        if neg_match:
            cond_text = neg_match.group(1)
            if '味方の数が' in cond_text:
                m = re.search(r'(\d+)体未満', cond_text)
                if m:
                     val = int(m.group(1))
                     global_condition = {'type': 'ally_alive_count', 'operator': '>=', 'value': val}
            elif '自身のHPが' in cond_text:
                 m = re.search(r'(\d+)%未満', cond_text)
                 if m:
                     val = int(m.group(1))
                     global_condition = {'type': 'self_hp_percent', 'operator': '>=', 'value': val}

        # 1.25 Skill Use Count Trigger Condition
        m = re.search(r'アクティブスキルを(\d+)回使用するたびに', text)
        if m:
             # Use a special condition or just rely on Trigger if it carries the count
             # Since 'on_skill_use_count' is mapped, we might want to store the count.
             val = int(m.group(1))
             # If trigger is generic, we need condition. 
             # Let's add it to global condition or implicit.
             # For now, let's treat it as a condition for the checker?
             # Actually, if we map 'on_skill_use_count' to 'after_skill_use', we need a condition 'skill_use_count % 3 == 0'.
             global_condition = {'type': 'skill_use_count_modulo', 'value': val}

        # 1.5 Positive Trigger Condition Extraction (New)
        # Extract values embedded in the trigger text itself (e.g. "When count < 3")
        if not global_condition:
             # Unit Count Below
             m = re.search(r'生存中の(敵|味方)の数が(\d+)体未満となった', text)
             if m:
                 target_side = 'ally' if m.group(1) == '味方' else 'enemy'
                 val = int(m.group(2))
                 global_condition = {'type': f'{target_side}_alive_count', 'operator': '<', 'value': val}
             
             # Enemy HP Below
             m = re.search(r'敵のHPが(\d+)%以下になった際', text)
             if m:
                 val = int(m.group(1))
                 global_condition = {'type': 'enemy_hp_percent', 'operator': '<=', 'value': val}

             # Ally Attacked -> Target Check
             if '味方が攻撃を受けた' in text:
                 global_condition = {'type': 'target_is_ally'}

        # 2. 分块处理
        raw_blocks = re.split(r'。|さらに', text)
        block_id = 1
        
        for raw_block in raw_blocks:
            block_text = raw_block.strip()
            if not block_text: continue
            if '発動しない' in block_text: continue
            
            # 3. 块级特定目标解析
            current_target = default_target
            if '味方後列' in block_text: current_target = 'ally_back'
            elif '味方前列' in block_text: current_target = 'ally_front'
            elif '味方全体' in block_text: current_target = 'ally_all'
            elif '自身' in block_text and '味方' not in block_text: current_target = 'self'
            elif '敵全体' in block_text: current_target = 'enemy_all'
            elif '敵単体' in block_text: current_target = 'enemy_single'
            
            # 4. 块级特定条件解析
            block_condition = None
            elem_map = {
                'アグレッシブ': 1, '火': 1, 'シャイ': 2, '風': 2,
                'キュート': 3, '土': 3, 'スマート': 4, '水': 4,
                'コミカル': 5, '光': 5, 'クレバー': 6, '闇': 6
            }
            for k, v in elem_map.items():
                if k in block_text:
                    block_condition = {'type': 'target_element', 'value': v}
                    break
            
            # 5. 解析效果
            effects = []
            
            # Static
            effects.extend(self._scan_text_for_static_effects(block_text, current_target, {}))
            
            # Stat Changes
            effects.extend(self._scan_text_for_stat_changes(block_text, current_target))
            
            # Resource Changes
            effects.extend(self._parse_resource(block_text, current_target))
            
            # Passive Damage
            effects.extend(self._scan_passive_damage(block_text, current_target))
            
            if effects:
                blocks_cond = block_condition
                effect_blocks.append(EffectBlock(block_id=block_id, condition=blocks_cond, effects=effects))
                block_id += 1
                
        self._temp_global_condition = global_condition
        return effect_blocks

    def _scan_text_for_stat_changes(self, text: str, default_target: str) -> list[EffectData]:
        """扫描属性变化效果 (Atk/Def Up/Down)"""
        effects = []
        
        # Determine direction
        is_down = '減少' in text or '低下' in text or 'ダウン' in text
        patterns = self.STAT_DOWN_PATTERNS if is_down else self.STAT_CHANGE_PATTERNS
        
        for pattern, eff_type, val_type_str in patterns:
            m = re.search(pattern, text)
            if m:
                val_str = m.group(1)
                val = 0.0
                val_tag = None
                
                try:
                    val = float(val_str)
                except ValueError:
                    if val_str.startswith('{') and val_str.endswith('}'):
                        val_tag = val_str[1:-1]
                    else:
                        val_tag = val_str
                        
                eff = EffectData(effect_type=eff_type, target_type=default_target, value=val)
                eff.flags['value_type'] = val_type_str
                if val_tag:
                    eff.value_tag = val_tag
                
                # Duration Scan
                m_dur = re.search(r'(\d+)行動の間', text)
                if m_dur:
                    eff.duration = int(m_dur.group(1))
                
                # Stackable check
                if '重複可' in text: eff.flags['stackable'] = True
                
                effects.append(eff)
        
        # 6. Guard
        # 攻撃を{guard}%ガードする
        match = re.search(r'攻撃を(\d+|\{.*?\})%ガードする', text)
        if match:
            effects.append(EffectData(effect_type='guard', target_type='self', value_tag=match.group(1).lstrip('{').rstrip('}')))

        return effects

    def _parse_resource(self, text: str, default_target: str) -> list[EffectData]:
        """解析资源操作 (AP/EP/PP)"""
        effects = []
        
        # AP增加
        match = re.search(r'(?:最大)?APを(\d+)(?:加算|増やし|回復)', text)
        if match:
            eff_type = 'add_max_ap' if '最大AP' in text else 'add_ap'
            tgt = 'self' if '自身' in text else default_target
            effects.append(EffectData(effect_type=eff_type, target_type=tgt, value=int(match.group(1))))
        
        # EP增加
        match = re.search(r'(?:EXゲージ|SP)を(\d+)(?:加算|回復|チャージ)', text)
        if match:
            # "SP Charge" is usually for Self unless specified, but here we trust default_target 
            # or could refinement logic like if '味方' in text override default.
            # Convert SP Charge to add_ep for now as per system design (SP=EP in battle logic)
            # Or use 'sp_charge' if it's distinct. Using sp_charge to be consistent with previous.
            # Wait, previous logic mapped SP to sp_charge.
            # I will map to add_ep if it says "Add EX", and sp_charge if "SP Charge".
            # Actually, let's normalize to add_ep for consistency if they are same resource.
            # Only if "SP" is distinct.
            # 130022: "EXゲージを1加算"
            effects.append(EffectData(effect_type='add_ep', target_type=default_target, value=int(match.group(1))))
        
        # AP减少
        match = re.search(r'APを(\d+)削る', text)
        if match:
             # Usually target enemy
             tgt = 'enemy_single' if '敵' in text else default_target
             effects.append(EffectData(effect_type='remove_ap', target_type=tgt, value=int(match.group(1))))

        # Buff Remove / Cleanse
        if re.search(r'デバフを.*?解除', text):
             effects.append(EffectData(effect_type='remove_debuff', target_type=default_target))
        if re.search(r'バフを.*?解除', text):
             tgt = 'enemy_all' if '敵全体' in text else ('enemy_single' if '敵' in text else default_target)
             effects.append(EffectData(effect_type='remove_buff', target_type=tgt))

        return effects

    def _scan_passive_damage(self, text: str, default_target: str) -> list[EffectData]:
        """扫描被动伤害 (Counter/Follow-up/Preemptive)"""
        effects = []
        # Pattern: "Power {x} Attack"
        # 威力{威力}で先制攻撃
        # 威力{威力}で攻撃
        # 威力{威力}で追撃
        # More specific pattern to avoid matching active skill descriptions
        # Only match if it has context keywords like 反撃/追撃/先制
        m = re.search(r'威力(\d+|\{.*?\})で(反撃|追撃|先制攻撃)', text)
        if m:
            val_str = m.group(1)
            atk_type_str = m.group(2)
            
            effect_type = 'damage'
            if '追撃' in atk_type_str:
                effect_type = 'follow_up_attack' # Or just damage with flag?
                # System design calls for specific effect types or flags?
                # Use 'damage' and flag it.
                pass
            
            eff = EffectData(effect_type='damage', target_type=default_target)
            
            val = 0
            val_tag = None
            try:
                val = float(val_str)
            except ValueError:
                if val_str.startswith('{') and val_str.endswith('}'):
                    val_tag = val_str[1:-1]
                else:
                    val_tag = val_str
            
            eff.value = val
            if val_tag: eff.value_tag = val_tag
            
            if '先制' in atk_type_str: eff.flags['is_preemptive'] = True
            if '追撃' in atk_type_str: eff.flags['is_follow_up'] = True
            if 'ENダメージ' in text: eff.flags['is_en_attack'] = True
            
            effects.append(eff)
            
        # Add Damage to Attack (Composite)
        # 威力{威力}の(EN)?ダメージを追加
        # Relaxed to allow text in between damage and 'add' (e.g. "and poison")
        m = re.search(r'威力(\d+|\{.*?\})の(EN)?ダメージ.*?を追加', text)
        if m:
             val_str = m.group(1)
             is_en = bool(m.group(2))
             eff = EffectData(effect_type='add_damage_to_attack', target_type='last_target')
             
             val = 0
             val_tag = None
             try:
                val = float(val_str)
             except ValueError:
                if val_str.startswith('{') and val_str.endswith('}'):
                    val_tag = val_str[1:-1]
                else:
                    val_tag = val_str
             
             eff.value = val
             if val_tag: eff.value_tag = val_tag
             if is_en: eff.flags['is_en_attack'] = True
             
             # Check for added status in the same text
             if '毒' in text: eff.flags['add_status'] = 'poison'
             if '炎上' in text: eff.flags['add_status'] = 'burn'
             
             effects.append(eff)

        # Status Ailments (Burn, Poison, etc) - Standalone
        # Pattern: 3行動分の炎上を付与する
        m = re.search(r'(\d+)行動分の(炎上|毒|気絶|氷結|挑発)', text)
        if m:
            dur = int(m.group(1))
            status_name = m.group(2)
            status_map = {'炎上': 'burn', '毒': 'poison', '気絶': 'stun', '氷結': 'freeze', '挑発': 'taunt'}
            effects.append(EffectData(effect_type='add_status', target_type=default_target, duration=dur, value_tag=status_map.get(status_name)))
            
        # Ignore Defense / Shield
        if '防御力' in text and '無視' in text:
            effects.append(EffectData(effect_type='ignore_defense', target_type='self', value=100))
        if 'シールド' in text and '無視' in text:
            effects.append(EffectData(effect_type='ignore_shield', target_type='self', value=100))

        return effects

    def _scan_text_for_static_effects(self, text: str, default_target: str, tag_map: dict) -> list[EffectData]:
        """通用文本扫描 (主动/被动共用)"""
        effects = []
        
        # 1. Stun
        if '気絶' in text:
            condition = None
            if '状態異常にある場合' in text: condition = {'type': 'target_has_status_ailment'}
            duration = 1
            m = re.search(r'(\d+)行動.*?気絶', text)
            if m: duration = int(m.group(1))
            
            target = default_target
            # 尝试推测目标上下文
            if default_target == 'self': target = 'enemy_random'
            if '敵単体' in text: target = 'enemy_single'
            if '敵全体' in text: target = 'enemy_all'
            if '最も攻撃力の高い敵' in text: target = 'enemy_highest_atk'
            if '対象' in text and default_target != 'self': target = 'last_target'

            eff = EffectData(effect_type='stun', target_type=target, duration=duration, condition=condition)
            effects.append(eff)
            
        # 2. Counter
        if '反撃' in text:
            val = 100
            m = re.search(r'威力(\d+)%', text)
            if m: val = int(m.group(1))
            eff = EffectData(effect_type='counter_stance', target_type=default_target, value=val)
            effects.append(eff)

        # 3. Status Immunity
        if '無効化' in text:
            if '状態異常' in text:
                effects.append(EffectData(effect_type='status_immunity', target_type=default_target))
        
        # 4. Buff Removal / Cleanse
        if '解除' in text:
            if '強化' in text or 'バフ' in text:
                eff_type = 'remove_buff'
                if '全て' in text: eff_type = 'remove_all_buffs'
                effects.append(EffectData(effect_type=eff_type, target_type=default_target))
            elif '弱体' in text or 'デバフ' in text:
                eff_type = 'remove_debuff'
                if '全て' in text: eff_type = 'remove_all_debuffs'
                effects.append(EffectData(effect_type=eff_type, target_type=default_target))

        # 5. Shield / Barrier (but not if ignoring shield)
        if ('障壁' in text or 'シールド' in text) and '無視' not in text:
             if 'ダメージ無効' in text:
                  cnt = 1
                  m = re.search(r'(\d+)回分', text)
                  if m: cnt = int(m.group(1))
                  effects.append(EffectData(effect_type='nullify_damage', target_type=default_target, hit_count=cnt))
             else:
                  val = 0
                  m = re.search(r'(\d+)ダメージ分', text)
                  if m: val = int(m.group(1))
                  if m: val = int(m.group(1))
                  effects.append(EffectData(effect_type='shield', target_type=default_target, value=val))

        # 6. Cover
        if ('身代わり' in text and 'なる' in text) or '肩代わり' in text:
             effects.append(EffectData(effect_type='cover', target_type='self'))

        # 7. Guts
        if '戦闘不能' in text and ('回避' in text or '耐える' in text):
             cnt = 1
             m = re.search(r'(\d+)回', text)
             if m: cnt = int(m.group(1))
             effects.append(EffectData(effect_type='guts', target_type='self', hit_count=cnt))

        # 8. Evasion / Nullify Physical
        if '回避' in text:
             if '物理ダメージ' in text and '無効' in text:
                 effects.append(EffectData(effect_type='nullify_physical', target_type=default_target))
             else:
                 if '率' not in text:
                      effects.append(EffectData(effect_type='perfect_evasion', target_type=default_target, hit_count=1))

        # 9. SP Charge / Regen
        if 'SP' in text:
            m = re.search(r'SPを.*?(\d+).*?回復', text)
            if not m: m = re.search(r'SP.*?(\d+).*?チャージ', text)
            if m:
                val = int(m.group(1))
                effects.append(EffectData(effect_type='sp_charge', target_type='self', value=val))

        # 10. Defense Penetration (Passive)
        if '防御無視' in text:
             effects.append(EffectData(effect_type='ignore_defense_rate', target_type='self', value=100))

        # 11. Passive Heal (Recovery)
        if '回復する' in text and ('HP' in text or '味方' in text):
             # Try to find value tag '威力' or 'cure'
             tag = 'cure' if 'cure' in tag_map else ('威力' if '威力' in tag_map else None)
             target = default_target
             if '味方全体' in text: target = 'ally_all'
             elif '味方単体' in text: target = 'ally_single'
             elif '自身' in text and '味方' not in text: target = 'self'
             
             effects.append(EffectData(effect_type='heal', target_type=target, value_tag=tag))
             
             # Try to extract value/tag from text directly (Fallback/Override)
             m = re.search(r'威力(\d+|\{.*?\})', text)
             if m:
                 val_str = m.group(1)
                 if val_str.startswith('{') and val_str.endswith('}'):
                      effects[-1].value_tag = val_str[1:-1]
                 else:
                      effects[-1].value = float(val_str)

        # 12. Passive Damage (Pursuit/Counter/Extra Attack)
        if '攻撃する' in text and '威力' in text:
             # Likely a triggered attack
             tag = '威力' if '威力' in tag_map else None
             target = default_target
             if '敵全体' in text: target = 'enemy_all'
             elif '敵単体' in text: target = 'enemy_single'
             elif 'ランダム' in text: target = 'enemy_random'
             
             effects.append(EffectData(effect_type='damage', target_type=target, value_tag=tag))

        # 13. Dmg Taken/Dealt (Refined)

        # 13/14 Handled by STAT_CHANGE_PATTERNS
        if '被ダメージ' in text or '与ダメージ' in text:
             pass

        return effects

    def _parse_trigger_from_text(self, text: str) -> str:
        for pattern, trigger in self.TRIGGER_PATTERNS.items():
            if re.search(pattern, text):
                return trigger
        return None

def main():
    parser = HybridSkillParser()
    # 模拟路径，实际需替换为真实路径
    input_file = "f:/MGG/Logic_Analyze/MGGBattleSimulation/split_data/SkillMaster.json"
    output_file = "f:/MGG/Logic_Analyze/MGGBattleSimulation/data/skill_effects_hybrid.json"
    
    safe_print(f"Start parsing {input_file}...")
    parser.parse_file(input_file, output_file)

if __name__ == "__main__":
    main()
