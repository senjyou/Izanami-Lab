                           actor=ally, skill=1001)
        parsed = make_parsed("before_enemy_as_attack")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_ENEMY_AS_ATTACK, ctx, owner) is False

    def test_no_actor_blocked(self):
        """无攻击者不触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.BEFORE_ENEMY_AS_ATTACK, skill=1001)
        parsed = make_parsed("before_enemy_as_attack")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_ENEMY_AS_ATTACK, ctx, owner) is False

    def test_skill_without_damage_blocked(self):
        """技能不含damage效果时不触发。"""
        dl = make_data_loader(
            skill_type_map={1001: SkillType.AS.value},
            parsed_skill_map={1001: {'effect_blocks': [{'effects': [{'effect_type': 'heal'}]}]}}
        )
        ts = make_trigger_service(dl)
        owner = make_unit("owner", side=Side.ALLY)
        enemy = make_unit("e1", side=Side.ENEMY)
        ctx = make_context(timing=TriggerTiming.BEFORE_ENEMY_AS_ATTACK,
                           actor=enemy, skill=1001)
        parsed = make_parsed("before_enemy_as_attack")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_ENEMY_AS_ATTACK, ctx, owner) is False


# ─── 6. BEFORE_ALLY_AS_ATTACK ───────────────────────────

class TestBeforeAllyAsAttack:

    def test_other_ally_as_with_damage_triggers(self):
        """其他友方AS+含damage时触发。"""
        dl = make_data_loader(
            skill_type_map={1001: SkillType.AS.value},
            parsed_skill_map={1001: {'effect_blocks': [{'effects': [{'effect_type': 'damage'}]}]}}
        )
        ts = make_trigger_service(dl)
        owner = make_unit("owner", side=Side.ALLY, position=Position.ALLY_LEFT_BACK)
        other_ally = make_unit("a1", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        ctx = make_context(timing=TriggerTiming.BEFORE_ALLY_AS_ATTACK,
                           actor=other_ally, skill=1001)
        parsed = make_parsed("before_ally_as_attack")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_ALLY_AS_ATTACK, ctx, owner) is True

    def test_self_actor_blocked(self):
        """owner==actor时不触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.AS.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner", side=Side.ALLY)
        ctx = make_context(timing=TriggerTiming.BEFORE_ALLY_AS_ATTACK,
                           actor=owner, skill=1001)
        parsed = make_parsed("before_ally_as_attack")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_ALLY_AS_ATTACK, ctx, owner) is False

    def test_enemy_actor_blocked(self):
        """敌方攻击者不触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.AS.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner", side=Side.ALLY)
        enemy = make_unit("e1", side=Side.ENEMY)
        ctx = make_context(timing=TriggerTiming.BEFORE_ALLY_AS_ATTACK,
                           actor=enemy, skill=1001)
        parsed = make_parsed("before_ally_as_attack")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_ALLY_AS_ATTACK, ctx, owner) is False

    def test_non_as_skill_blocked(self):
        """非AS技能不触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.PS.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner", side=Side.ALLY)
        other_ally = make_unit("a1", side=Side.ALLY)
        ctx = make_context(timing=TriggerTiming.BEFORE_ALLY_AS_ATTACK,
                           actor=other_ally, skill=1001)
        parsed = make_parsed("before_ally_as_attack")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_ALLY_AS_ATTACK, ctx, owner) is False

    def test_ally_front_target_restriction(self):
        """PS target_type=ally_front时，actor必须在owner正前方。"""
        dl = make_data_loader(
            skill_type_map={1001: SkillType.AS.value},
            parsed_skill_map={1001: {'effect_blocks': [{'effects': [{'effect_type': 'damage'}]}]}}
        )
        ts = make_trigger_service(dl)
        owner = make_unit("owner", side=Side.ALLY, position=Position.ALLY_LEFT_BACK)
        # actor在中央前排（非owner正前方）
        wrong_actor = make_unit("a1", side=Side.ALLY, position=Position.ALLY_CENTER_FRONT)
        ctx = make_context(timing=TriggerTiming.BEFORE_ALLY_AS_ATTACK,
                           actor=wrong_actor, skill=1001)
        parsed = make_parsed("before_ally_as_attack", effect_blocks=[
            {'effects': [{'effect_type': 'damage', 'target_type': 'ally_front'}]}
        ])
        assert call_match(ts, parsed, TriggerTiming.BEFORE_ALLY_AS_ATTACK, ctx, owner) is False


