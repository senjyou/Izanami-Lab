        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        ctx = make_context(timing=TriggerTiming.PAWN_RECEIVED_AURA, targets=[owner])
        parsed = make_parsed("on_debuff_applied",
            global_condition={'type': 'target_is_ally', 'exclude_self': 1})
        # owner在targets但exclude_self=True，应不触发
        assert call_match(ts, parsed, TriggerTiming.PAWN_RECEIVED_AURA, ctx, owner) is False


