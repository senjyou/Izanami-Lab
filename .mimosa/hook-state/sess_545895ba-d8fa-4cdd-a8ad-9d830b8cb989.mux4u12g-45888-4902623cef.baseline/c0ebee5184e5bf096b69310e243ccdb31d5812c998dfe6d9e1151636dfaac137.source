    def test_turn_end_with_debuff_type_condition_blocked(self):
        """TURN_END + debuff_type condition 不触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.TURN_END)
        parsed = make_parsed("on_turn_end",
            global_condition={'type': 'debuff_type', 'value': 'poison'})
        assert call_match(ts, parsed, TriggerTiming.TURN_END, ctx, owner) is False

    def test_hp_below_ally_filter_ally_triggered_by(self):
        """HP_BELOW + ally_filter=ally + triggered_by同阵营时触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        ally = make_unit("a1", side=Side.ALLY)
        ctx = make_context(timing=TriggerTiming.HP_BELOW, triggered_by=ally)
        parsed = make_parsed("on_hp_below",
            global_condition={'type': 'self_hp_percent', 'operator': '<=', 'value': 30,
                              'ally_filter': 'ally'})
        assert call_match(ts, parsed, TriggerTiming.HP_BELOW, ctx, owner) is True

    def test_hp_below_ally_filter_enemy_triggered_by(self):
        """HP_BELOW + ally_filter=ally + triggered_by敌方时不触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        enemy = make_unit("e1", side=Side.ENEMY)
        ctx = make_context(timing=TriggerTiming.HP_BELOW, triggered_by=enemy)
        parsed = make_parsed("on_hp_below",
            global_condition={'type': 'self_hp_percent', 'operator': '<=', 'value': 30,
                              'ally_filter': 'ally'})
        assert call_match(ts, parsed, TriggerTiming.HP_BELOW, ctx, owner) is False

    def test_hp_below_enemy_filter_enemy_triggered_by(self):
        """HP_BELOW + ally_filter=enemy + triggered_by敌方时触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        enemy = make_unit("e1", side=Side.ENEMY)
        ctx = make_context(timing=TriggerTiming.HP_BELOW, triggered_by=enemy)
        parsed = make_parsed("on_hp_below",
            global_condition={'type': 'self_hp_percent', 'operator': '<=', 'value': 30,
                              'ally_filter': 'enemy'})
        assert call_match(ts, parsed, TriggerTiming.HP_BELOW, ctx, owner) is True


# ─── 17. _is_cover_ps辅助函数 ───────────────────────────

class TestIsCoverPs:

    def test_no_guard_cover_effects_returns_false(self):
        """无cover/guard effect时返回False。"""
        ts = make_trigger_service()
        parsed = make_parsed("before_as_attacked", effect_blocks=[
            {'effects': [{'effect_type': 'damage'}]}
        ])
        assert ts._is_cover_ps(parsed) is False

    def test_cover_effect_returns_true(self):
        """含cover effect时返回True。"""
        ts = make_trigger_service()
        parsed = make_parsed("before_as_attacked", effect_blocks=[
            {'effects': [{'effect_type': 'cover', 'target_type': 'ally_single'}]}
        ])
        assert ts._is_cover_ps(parsed) is True

    def test_guard_effect_returns_true(self):
        """含guard effect时返回True。"""
        ts = make_trigger_service()
        parsed = make_parsed("before_as_attacked", effect_blocks=[
            {'effects': [{'effect_type': 'guard', 'target_type': 'ally_single'}]}
        ])
        assert ts._is_cover_ps(parsed) is True

    def test_self_guard_all_self_target_returns_false(self):
        """所有guard/cover effect都target_type=self时返回False（self-guard）。"""
        ts = make_trigger_service()
        parsed = make_parsed("before_as_attacked", effect_blocks=[
            {'effects': [{'effect_type': 'guard', 'target_type': 'self'}]}
        ])
        assert ts._is_cover_ps(parsed) is False

    def test_self_guard_global_condition_target_is_self(self):
        """global_condition=target_is_self时返回False（self-guard）。"""
        ts = make_trigger_service()
        parsed = make_parsed("before_as_attacked",
            global_condition={'type': 'target_is_self'},
            effect_blocks=[{'effects': [{'effect_type': 'guard', 'target_type': 'ally_single'}]}])
        assert ts._is_cover_ps(parsed) is False

    def test_self_guard_and_condition_with_target_is_self(self):
        """and组合条件中包含target_is_self时返回False（self-guard）。"""
        ts = make_trigger_service()
        parsed = make_parsed("before_as_attacked",
            global_condition={
                'type': 'and',
                'conditions': [
                    {'type': 'target_is_self'},
                    {'type': 'self_hp_percent', 'operator': '<=', 'value': 50}
                ]
            },
            effect_blocks=[{'effects': [{'effect_type': 'guard', 'target_type': 'ally_single'}]}])
        assert ts._is_cover_ps(parsed) is False
