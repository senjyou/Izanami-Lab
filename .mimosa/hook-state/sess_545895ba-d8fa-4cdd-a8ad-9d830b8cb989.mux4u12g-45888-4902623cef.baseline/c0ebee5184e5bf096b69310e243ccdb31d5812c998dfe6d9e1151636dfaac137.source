"""TriggerService._match_trigger_timing单元测试。

覆盖_match_trigger_timing方法中20+种时机匹配逻辑：
- 基础匹配：trigger_type映射/未知类型/timing不匹配
- BEFORE_SKILL_USE: 自身AS技能使用前（仅owner==actor，仅AS）
- AFTER_SKILL_USE: 自身AS技能使用后（仅owner==actor，仅AS，allow_ex_trigger标志）
- BEFORE_AS_ATTACKED: 被AS攻击前（攻击者异阵营，cover PS需其他友方）
- BEFORE_ANY_ATTACKED: 任意攻击前（同上）
- BEFORE_ENEMY_AS_ATTACK: 敌方AS攻击前（攻击者异阵营，技能含damage）
- BEFORE_ALLY_AS_ATTACK: 友方AS攻击前（同阵营非自身，AS含damage，ally_front限制）
- AFTER_AS_ATTACKED: 被AS攻击后（owner是primary_target）
- AFTER_ALLY_ATTACKED: 友方被攻击后（攻击者敌方，主目标友方）
- AFTER_SELF_ATTACKED: 自身被攻击后（攻击者敌方，owner在targets中）
- AFTER_AS_ATTACKED_ALLY: 友方被AS攻击后（攻击者敌方，主目标友方）
- AFTER_ALLY_AS_ATTACK: 其他友方AS攻击后（同阵营非自身，主目标存活且敌方）
- AFTER_PS_RECEIVED: 接受他人PS后（同阵营非自身，owner在targets中）
- PAWN_DIED: 单位死亡（on_ally_killed/on_pawn_died/on_linked_enemy_killed分支）
- PAWN_KILLED: 击杀者触发
- PAWN_ANY_KILL: 任意击杀
- PAWN_CAUSED_CRITICAL: 暴击者触发
- PAWN_RECEIVED_AURA: 获得aura（按global_condition分支）
- SKILL_USE_COUNT: 仅owner自身
- ALLY_CHARGE_USE: 友方（非自身）
- 通用时机：BATTLE_START/TURN_START等 + HP_BELOW ally_filter
- _is_cover_ps辅助函数
"""
import sys
import os
import pytest
from types import SimpleNamespace
from unittest.mock import MagicMock

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..', 'src'))

from src.entities_v2.unit_state import UnitState, BuffState, DamageLinkEntry
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillType, TriggerTiming
from src.combat_v2.services.trigger_service import (
    TriggerService, TriggerContext, TRIGGER_TYPE_MAP,
)


# ─── 工厂函数 ──────────────────────────────────────────────

def make_unit(unit_id="u1", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT,
              hp=50000, max_hp=50000, atk=10000, defense=5000, speed=500,
              element=2, character_type=1, is_alive=True):
    """创建测试用单位。"""
    u = UnitState(
        unit_id=unit_id, name=unit_id, side=side, position=position,
        character_id=999901, level=10, element=element, character_type=character_type,
        max_hp=max_hp, attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_hp=hp, current_ap=10, current_pp=10, current_ep=10,
    )
    u.is_alive = is_alive
    return u


def make_context(timing=TriggerTiming.AFTER_AS_ATTACKED, battlefield=None,
                 actor=None, targets=None, triggered_by=None, primary_target=None,
                 skill=None, new_knockout_target_ids=None):
    """创建测试用TriggerContext。"""
    if battlefield is None:
        battlefield = BattlefieldState()
    ctx = TriggerContext(
        timing=timing,
        battlefield=battlefield,
        actor=actor,
        targets=targets or [],
        triggered_by=triggered_by,
        primary_target=primary_target,
        skill=skill,
    )
    if new_knockout_target_ids:
        ctx.new_knockout_target_ids = new_knockout_target_ids
    return ctx


def make_trigger_service(data_loader=None):
    """创建TriggerService实例。"""
    ts = TriggerService()
    if data_loader:
        ts.data_loader = data_loader
    return ts


def make_data_loader(skill_type_map=None, parsed_skill_map=None):
    """创建mock data_loader。

    Args:
        skill_type_map: {skill_id: skill_type} 用于get_skill_by_id
        parsed_skill_map: {skill_id: parsed_dict} 用于get_parsed_skill_data
    """
    skill_type_map = skill_type_map or {}
    parsed_skill_map = parsed_skill_map or {}

    dl = MagicMock()
    def get_skill_by_id(sid):
        if sid in skill_type_map:
            return SimpleNamespace(skill_type=skill_type_map[sid])
        return None
    dl.get_skill_by_id = get_skill_by_id
    dl.get_parsed_skill_data = lambda sid: parsed_skill_map.get(sid)
    return dl


def make_parsed(trigger_type, effect_blocks=None, global_condition=None,
                allow_ex_trigger=False):
    """创建parsed PS配置。"""
    return {
        'trigger_type': trigger_type,
        'effect_blocks': effect_blocks or [],
        'global_condition': global_condition,
        'allow_ex_trigger': allow_ex_trigger,
    }


def call_match(ts, parsed, timing, context, owner):
    """便捷调用_match_trigger_timing的wrapper。"""
    return ts._match_trigger_timing(parsed, timing, context, owner)


# ─── 1. 基础匹配 ─────────────────────────────────────────

class TestBasicMatching:

    def test_no_trigger_type_returns_false(self):
        """无trigger_type字段返回False。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context()
        assert call_match(ts, {}, TriggerTiming.AFTER_AS_ATTACKED, ctx, owner) is False

    def test_unknown_trigger_type_returns_false(self):
        """未知trigger_type返回False。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context()
        parsed = make_parsed("totally_unknown_trigger_type")
        assert call_match(ts, parsed, TriggerTiming.AFTER_AS_ATTACKED, ctx, owner) is False

    def test_timing_mismatch_returns_false(self):
        """timing不匹配返回False。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.TURN_START)
        parsed = make_parsed("after_as_attacked")  # 期望AFTER_AS_ATTACKED
        assert call_match(ts, parsed, TriggerTiming.TURN_START, ctx, owner) is False

    def test_timing_match_returns_true_for_simple_timing(self):
        """简单时机匹配返回True（如TURN_END）。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.TURN_END)
        parsed = make_parsed("on_turn_end")
        assert call_match(ts, parsed, TriggerTiming.TURN_END, ctx, owner) is True


# ─── 2. BEFORE_SKILL_USE ─────────────────────────────────

class TestBeforeSkillUse:

    def test_owner_is_actor_returns_true(self):
        """owner==actor且为AS技能时触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.AS.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.BEFORE_SKILL_USE,
                           actor=owner, skill=1001)
        parsed = make_parsed("before_skill_use")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_SKILL_USE, ctx, owner) is True

    def test_owner_not_actor_returns_false(self):
        """owner!=actor时不触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.AS.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner")
        other = make_unit("other")
        ctx = make_context(timing=TriggerTiming.BEFORE_SKILL_USE,
                           actor=other, skill=1001)
        parsed = make_parsed("before_skill_use")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_SKILL_USE, ctx, owner) is False

    def test_no_actor_returns_false(self):
        """无actor时False。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.BEFORE_SKILL_USE)
        parsed = make_parsed("before_skill_use")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_SKILL_USE, ctx, owner) is False

    def test_non_as_skill_blocked(self):
        """非AS技能（PS/EX）不触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.PS.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.BEFORE_SKILL_USE,
                           actor=owner, skill=1001)
        parsed = make_parsed("before_skill_use")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_SKILL_USE, ctx, owner) is False


# ─── 3. AFTER_SKILL_USE ──────────────────────────────────

class TestAfterSkillUse:

    def test_owner_is_actor_as_skill_returns_true(self):
        """owner==actor且为AS技能时触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.AS.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.AFTER_SKILL_USE,
                           actor=owner, skill=1001)
        parsed = make_parsed("after_as_attack")
        assert call_match(ts, parsed, TriggerTiming.AFTER_SKILL_USE, ctx, owner) is True

    def test_ex_skill_blocked_without_flag(self):
        """EX技能无allow_ex_trigger标志时不触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.EX.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.AFTER_SKILL_USE,
                           actor=owner, skill=1001)
        parsed = make_parsed("after_as_attack", allow_ex_trigger=False)
        assert call_match(ts, parsed, TriggerTiming.AFTER_SKILL_USE, ctx, owner) is False

    def test_ex_skill_allowed_with_flag(self):
        """EX技能+allow_ex_trigger=True时触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.EX.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.AFTER_SKILL_USE,
                           actor=owner, skill=1001)
        parsed = make_parsed("after_as_attack", allow_ex_trigger=True)
        assert call_match(ts, parsed, TriggerTiming.AFTER_SKILL_USE, ctx, owner) is True

    def test_ps_skill_blocked_even_with_flag(self):
        """PS技能即使有allow_ex_trigger也不触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.PS.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner")
        ctx = make_context(timing=TriggerTiming.AFTER_SKILL_USE,
                           actor=owner, skill=1001)
        parsed = make_parsed("after_as_attack", allow_ex_trigger=True)
        assert call_match(ts, parsed, TriggerTiming.AFTER_SKILL_USE, ctx, owner) is False

    def test_debuff_applied_target_dead_primary_blocked(self):
        """debuff_applied_target PS在主目标阵亡时不触发。"""
        dl = make_data_loader(skill_type_map={1001: SkillType.AS.value})
        ts = make_trigger_service(dl)
        owner = make_unit("owner")
        dead_target = make_unit("t1", is_alive=False)
        ctx = make_context(timing=TriggerTiming.AFTER_SKILL_USE,
                           actor=owner, skill=1001, primary_target=dead_target)
        parsed = make_parsed("after_as_attack", effect_blocks=[
            {'effects': [{'target_type': 'debuff_applied_target'}]}
        ])
        assert call_match(ts, parsed, TriggerTiming.AFTER_SKILL_USE, ctx, owner) is False


# ─── 4. BEFORE_AS_ATTACKED / BEFORE_ANY_ATTACKED ────────

class TestBeforeAsAttacked:

    def test_enemy_attacker_returns_true(self):
        """敌方攻击者+有targets时触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        enemy = make_unit("e1", side=Side.ENEMY)
        target = make_unit("t1", side=Side.ALLY)
        ctx = make_context(timing=TriggerTiming.BEFORE_AS_ATTACKED,
                           actor=enemy, targets=[target])
        parsed = make_parsed("before_as_attacked")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_AS_ATTACKED, ctx, owner) is True

    def test_same_side_attacker_blocked(self):
        """同阵营攻击者不触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        ally_attacker = make_unit("a1", side=Side.ALLY)
        target = make_unit("t1", side=Side.ALLY)
        ctx = make_context(timing=TriggerTiming.BEFORE_AS_ATTACKED,
                           actor=ally_attacker, targets=[target])
        parsed = make_parsed("before_as_attacked")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_AS_ATTACKED, ctx, owner) is False

    def test_no_targets_returns_false(self):
        """无targets时False。"""
        ts = make_trigger_service()
        owner = make_unit("owner")
        enemy = make_unit("e1", side=Side.ENEMY)
        ctx = make_context(timing=TriggerTiming.BEFORE_AS_ATTACKED,
                           actor=enemy, targets=[])
        parsed = make_parsed("before_as_attacked")
        assert call_match(ts, parsed, TriggerTiming.BEFORE_AS_ATTACKED, ctx, owner) is False

    def test_cover_ps_no_other_ally_blocked(self):
        """援护PS但无其他友方可保护时不触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        enemy = make_unit("e1", side=Side.ENEMY)
        # targets只有owner自己
        ctx = make_context(timing=TriggerTiming.BEFORE_AS_ATTACKED,
                           actor=enemy, targets=[owner])
        parsed = make_parsed("before_as_attacked", effect_blocks=[
            {'effects': [{'effect_type': 'cover', 'target_type': 'ally_single'}]}
        ])
        assert call_match(ts, parsed, TriggerTiming.BEFORE_AS_ATTACKED, ctx, owner) is False

    def test_cover_ps_with_other_ally_triggers(self):
        """援护PS且有其他友方时触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        enemy = make_unit("e1", side=Side.ENEMY)
        other_ally = make_unit("a1", side=Side.ALLY)
        ctx = make_context(timing=TriggerTiming.BEFORE_AS_ATTACKED,
                           actor=enemy, targets=[other_ally])
        parsed = make_parsed("before_as_attacked", effect_blocks=[
            {'effects': [{'effect_type': 'cover', 'target_type': 'ally_single'}]}
        ])
        assert call_match(ts, parsed, TriggerTiming.BEFORE_AS_ATTACKED, ctx, owner) is True

    def test_self_guard_not_blocked_by_cover_check(self):
        """self-guard（target_type=self）不受援护检查限制。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
        enemy = make_unit("e1", side=Side.ENEMY)
        ctx = make_context(timing=TriggerTiming.BEFORE_AS_ATTACKED,
                           actor=enemy, targets=[owner])
        parsed = make_parsed("before_as_attacked",
            global_condition={'type': 'target_is_self'},
            effect_blocks=[{'effects': [{'effect_type': 'guard', 'target_type': 'self'}]}])
        assert call_match(ts, parsed, TriggerTiming.BEFORE_AS_ATTACKED, ctx, owner) is True


# ─── 5. BEFORE_ENEMY_AS_ATTACK ──────────────────────────

class TestBeforeEnemyAsAttack:

    def test_enemy_actor_with_damage_skill_triggers(self):
