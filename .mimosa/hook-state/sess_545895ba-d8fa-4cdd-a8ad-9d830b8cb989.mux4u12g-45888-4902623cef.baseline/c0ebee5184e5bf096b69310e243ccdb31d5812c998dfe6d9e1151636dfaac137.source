# ─── 8. AFTER_ALLY_ATTACKED / AFTER_AS_ATTACKED_ALLY ────

class TestAfterAllyAttacked:

    def test_enemy_attacks_ally_triggers(self):
        """敌方攻击友方时触发。"""
        ts = make_trigger_service()
        owner = make_unit("owner", side=Side.ALLY)
