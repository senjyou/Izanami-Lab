"""Regression: 一日一不憫 (110002) 易伤区间bug修复

Bug: dmg_taken_up (易伤) was applied with apply_timing="immediate", causing it
     to take effect DURING the 5-hit loop. Later hits (2-5) benefited from the
     100% 易伤, which is incorrect.

Fix: Removed apply_timing="immediate" so the 易伤 is applied AFTER the 5-hit
     loop completes (deferred on_crit). Only the追加 6th hit enjoys the 易伤.
     Also deduplicated _deferred_on_crit_targets so the same target isn't
     processed multiple times even if multiple hits crit.

Bug2: attack_limited debuff (如ふわとろのきもち的1次性50%易伤) 在主5hit结算后立即被消耗，
      导致追加的第6hit时该debuff已消失，无法享受加成。
      正确行为：110002的5hit+1hit追加伤害应算同一次攻击，attack_limited只消耗1次。
Fix2: 把 deferred_on_crit_targets 处理移到 attack_limited cleanup 之前，
      使追加的第6hit在 cleanup 之前结算，与主5hit共享同一技能内的debuff。

Expected behavior:
- 前5hit有任意1段暴击 → 追加第6hit
- 只有第6hit享受110002自身的100%易伤加成
- 第6hit同时享受技能开始前已存在的attack_limited易伤debuff（如ふわとろのきもち）
- 即使5hit全部暴击，每个目标只追加1次伤害（不会追加5次）
- attack_limited debuff在整个技能（含追加hit）结算后才消耗1次
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.resource_service import ResourceService


def _make_caster():
    """火属性 EN型caster, crit_damage=0.5 (暴击1.5x)"""
    return UnitState(
        unit_id="ally_back", name="caster", side=Side.ALLY,
        position=Position.ALLY_CENTER_BACK, character_id=106301, level=10,
        element=1, character_type=2,
        max_hp=15000, current_hp=15000,
        attack=10000, defense=4000, speed=400,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=2, initial_passive_point=2, max_extra_point=8,
        current_ap=10, current_pp=10, current_ep=0,
        skills=[110002], skill_levels={110002: 10}, skill_cooldowns={},
    )


def _make_enemy():
    """高HP敌方单位 (同属性, 避免克制差异)"""
    return UnitState(
        unit_id="enemy_front", name="enemy", side=Side.ENEMY,
        position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
        element=1, character_type=1,
        max_hp=999999, current_hp=999999,
        attack=1000, defense=3000, speed=400,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=5,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


class TestRegVulnInterval110002(unittest.TestCase):
    """一日一不憫 (110002) 易伤区间bug修复回归测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.caster = _make_caster()
        self.enemy = _make_enemy()
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy]

        rs = ResourceService()
        trg = TriggerService()
        tgs = TargetService()
        dms = DamageService()
        aus = AuraService()
        sts = StatusService()
        self.ss = SkillService(
            self.dl, rs, target_service=tgs, damage_service=dms,
            aura_service=aus, status_service=sts, trigger_service=trg,
        )
        trg.set_data_loader(self.dl)
        trg.set_skill_service(self.ss)
        trg.set_damage_service(dms)
        self.ss.set_battlefield(self.bf)

    def _get_damage_effects(self, result):
        """从effects_applied中提取所有damage类型的effect"""
        return [e for e in result.get("effects_applied", [])
                if e.get("effect_type") == "damage"]

    def test_5hit_does_not_benefit_from_vuln(self):
        """前5hit不应享受易伤加成。
        验证方法：5hit全暴击的伤害应约为无暴击时的 crit_factor 倍（仅暴击乘区）。
        crit_factor = 1.5 + crit_damage(0.5) = 2.0
        若易伤在5hit期间生效，5hit全暴击伤害会远大于 crit_factor 倍。
        """
        # 场景1: 无暴击
        self.caster.crit_rate = 0.0
        hp_before_1 = self.enemy.current_hp
        result1 = self.ss.execute_skill(
            caster=self.caster, skill_id=110002, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result1["success"])
        dmg_no_crit = hp_before_1 - self.enemy.current_hp
        self.assertGreater(dmg_no_crit, 0)

        # 无暴击时应有1个damage效果（无追撃）
        dmg_effects_1 = self._get_damage_effects(result1)
        self.assertEqual(len(dmg_effects_1), 1, "无暴击时应有1个damage效果（主5hit）")

        # 重置敌方状态
        self.enemy.current_hp = self.enemy.max_hp
        self.enemy.debuffs = []
        self.enemy.buffs = []

        # 场景2: 100%暴击
        self.caster.crit_rate = 1.0
        hp_before_2 = self.enemy.current_hp
        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=110002, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result2["success"])

        dmg_effects_2 = self._get_damage_effects(result2)
        # 暴击时应有2个damage效果：主5hit + 追撃1hit
        self.assertEqual(len(dmg_effects_2), 2,
                        f"暴击时应有主5hit和追撃1hit两个damage效果，实际={len(dmg_effects_2)}")

        # 主5hit伤害（第一个damage效果）
        main_dmg = sum(t["actual_damage"] for t in dmg_effects_2[0].get("targets", []))
        # 追撃1hit伤害（第二个damage效果）
        pursuit_dmg = sum(t["actual_damage"] for t in dmg_effects_2[1].get("targets", []))

        # 验证: 主5hit伤害应约为无暴击的 crit_factor 倍（仅暴击加成，易伤未在5hit期间生效）
        # crit_factor = 1.5 + crit_damage(0.5) = 2.0
        crit_factor = 1.5 + self.caster.crit_damage
        expected_main = dmg_no_crit * crit_factor
        self.assertAlmostEqual(
            main_dmg, expected_main, delta=expected_main * 0.15,
            msg=f"主5hit伤害应约为无暴击的{crit_factor}倍（{expected_main:.0f}），实际={main_dmg}。"
                f"若远大于{crit_factor}倍，说明易伤在5hit期间错误生效。"
        )

        # 验证: 追撃1hit应享受100%易伤加成
        # 单hit无暴击伤害 = dmg_no_crit / 5
        # 单hit暴击+易伤 = (dmg_no_crit / 5) × crit_factor × 2.0(易伤)
        expected_pursuit = (dmg_no_crit / 5) * crit_factor * 2.0
        self.assertGreater(
            pursuit_dmg, expected_pursuit * 0.8,
            msg=f"追撃1hit应享受100%易伤加成（约{expected_pursuit:.0f}），实际={pursuit_dmg}"
        )
        # 追撃伤害不应超过预期的1.3倍（防止异常高额）
        self.assertLess(
            pursuit_dmg, expected_pursuit * 1.3,
            msg=f"追撃1hit伤害异常高（预期约{expected_pursuit:.0f}），实际={pursuit_dmg}"
        )

    def test_only_one_pursuit_hit_even_all_crit(self):
        """5hit全部暴击时，只追加1次伤害（不会因每次暴击都追加）。
        验证去重逻辑：同一目标多次暴击只处理一次。
        """
        self.caster.crit_rate = 1.0
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110002, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = self._get_damage_effects(result)
        # 应有且仅有2个damage效果：主5hit + 追撃1hit
        # 如果去重失败，5hit全暴击会产生5个追撃效果，共6个damage效果
        self.assertEqual(len(dmg_effects), 2,
                        f"5hit全暴击应只追加1次伤害（共2个damage效果），实际={len(dmg_effects)}。"
                        f"若多于2个，说明同一目标的多次暴击未被去重。")

    def test_no_vuln_no_6th_hit_without_crit(self):
        """无暴击时不应追加第6hit，也不应有易伤"""
        self.caster.crit_rate = 0.0
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110002, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = self._get_damage_effects(result)
        self.assertEqual(len(dmg_effects), 1, "无暴击时应有且仅有主5hit一个damage效果")

        # 不应有aura效果（易伤）
        aura_effects = [e for e in result.get("effects_applied", [])
                        if e.get("effect_type") == "aura" and e.get("is_debuff")]
        self.assertEqual(len(aura_effects), 0, "无暴击时不应有易伤aura效果")

    def test_6hit_shares_attack_limited_debuff_with_5hit(self):
        """追加的第6hit应与主5hit共享技能开始前已存在的attack_limited易伤debuff。

        场景：敌方身上有一个attack_limited=1, value=50的dmg_taken_up debuff
        （模拟「ふわとろのきもち」提供的1次性50%易伤）。
        110002暴击追加第6hit时，该debuff应同时作用于主5hit和第6hit，
        然后在整个技能结束后才被消耗（attack_limited从1->0）。

        修复前bug：attack_limited cleanup在deferred_on_crit_targets之前执行，
        导致主5hit结束后立即消耗该debuff，第6hit时debuff已消失。
        """
        self.caster.crit_rate = 1.0

        # 给敌方添加一个 attack_limited=1, value=50 的易伤debuff
        # 模拟「ふわとろのきもち」提供的1次性50%易伤
        vuln_debuff = BuffState(
            buff_id="external_vuln_50",
            name="外部1次性易伤",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=50.0,
            duration=-1,  # 永续，由attack_limited控制生命周期
            timing_type=2,
            is_debuff=True,
            attack_limited=1,
        )
        self.enemy.debuffs.append(vuln_debuff)

        hp_before = self.enemy.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110002, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = self._get_damage_effects(result)
        # 应有2个damage效果：主5hit + 追撃1hit
        self.assertEqual(len(dmg_effects), 2,
                        f"暴击时应有主5hit和追撃1hit两个damage效果，实际={len(dmg_effects)}")

        # 提取主5hit和追撃1hit的 received_mult
        main_targets = dmg_effects[0].get("targets", [])
        pursuit_targets = dmg_effects[1].get("targets", [])
        self.assertGreater(len(main_targets), 0, "主5hit应有目标")
        self.assertGreater(len(pursuit_targets), 0, "追撃1hit应有目标")

        main_rcvd = main_targets[0].get("calc_detail", {}).get("received_mult", 0)
        pursuit_rcvd = pursuit_targets[0].get("calc_detail", {}).get("received_mult", 0)

        # 主5hit: 基础1.0 + 外部0.5易伤 = 1.5
        self.assertAlmostEqual(
            main_rcvd, 1.5, delta=0.01,
            msg=f"主5hit的received_mult应为1.5（基础1.0+外部0.5易伤），实际={main_rcvd}"
        )

        # 追撃1hit: 基础1.0 + 外部0.5易伤 + 110002自易伤1.0 = 2.5
        # 修复前bug：外部0.5易伤被提前消耗，received_mult只有2.0
        self.assertAlmostEqual(
            pursuit_rcvd, 2.5, delta=0.01,
            msg=f"追撃1hit的received_mult应为2.5（基础1.0+外部0.5易伤+110002自易伤1.0），实际={pursuit_rcvd}。"
                f"若为2.0，说明外部易伤debuff被提前消耗（attack_limited cleanup执行过早）。"
        )

        # 验证：外部易伤debuff在整个技能结束后被消耗（attack_limited从1->0，debuff被移除）
        remaining_vuln = [d for d in self.enemy.debuffs
                         if d.buff_id == "external_vuln_50"]
        self.assertEqual(len(remaining_vuln), 0,
                        "外部易伤debuff应在技能结束后被消耗（attack_limited从1->0）")


if __name__ == '__main__':
    unittest.main(verbosity=2)
