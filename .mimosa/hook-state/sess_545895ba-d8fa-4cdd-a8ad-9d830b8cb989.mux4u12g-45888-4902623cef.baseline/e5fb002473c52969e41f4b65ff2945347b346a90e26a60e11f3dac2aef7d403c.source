"""角色103303 穹を駆ける不屈の翼 专项E2E测试（「失勢」mark锚定 + 暗闇失手 + 回避/减伤 + skill_power_down）

技能列表（5个）:
- EX: 110081 ほんと、ざ～こ♡（敌全体暗闇100%失手 + 失勢最多敌优先攻击+atk_down）
- AS1: 120173 よわよわすぎ～♪（失勢最多敌所在横列暗闇{kurayami}% + L11+减速；失勢单体atk25%/def20% down自身1行动/死亡解除）
- AS2: 120174 助けてあげよっか？（自身+HP比例最低味方 回避Nヒット+被ダメ減{dmg}%，4段level组合）
- AS3: 120175 クロス・クラッシュ（最近敌+邻接2体攻击+EX削1；L11+ ep_gain_down）
- PS: 130181 何してんのよ！（正前方味方被攻击前→攻击者skill_power_down+失勢mark，同時発動制限）

覆盖维度:
1. EX 敌全体暗闇(100%失手→必MISS) + 失勢最多敌优先
2. AS1 横列暗闇锚定（失勢最多敌所在行）+ 失勢单体双降 + L11+减速 + 死亡解除
3. AS2 回避hit数按等级（1/2/3）+ 减伤attack_limited（1/2）+ 目标为自身+最低HP味方
4. AS3 三连目标（最近+邻接2）+ EX削1 + L11+ ep_gain_down
5. PS 正前方味方触发 + skill_power_down + 失勢mark + 非正前方不触发
6. 暗闇失手率独立掷骰（value=miss%）
7. 配置校验
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

MARK = SkillEffectType.MARK.value
DARKNESS = SkillEffectType.DARKNESS.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value
STATUS_SPEED = SkillEffectType.STATUS_SPEED.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
SKILL_POWER_DOWN = SkillEffectType.SKILL_POWER_DOWN.value

SHISEI = "失勢"


def _mk_mark(name, source_id="src", stack=1, is_debuff=True):
    return BuffState(
        buff_id=f"{source_id}_mark_{name}_{id(name)}", name=name,
        effect_type=MARK, value=0, duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=source_id, source_skill_id=0, is_debuff=is_debuff,
        stack_count=stack,
    )


class TestActor103303(unittest.TestCase):

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()
        cls.dms = DamageService()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        self.caster = UnitState(
            unit_id="caster", name="不屈の翼", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=103303, level=10,
            element=2, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=5,
            skills=[110081, 120173, 120174, 120175, 130181],
            skill_levels={110081: 10, 120173: 10, 120174: 10,
                          120175: 10, 130181: 10},
            skill_cooldowns={},
        )
        # 正前方友方（130181 的守护对象）：caster 在中前 → 正前=中前
        self.ally_cf = UnitState(
            unit_id="ally_cf", name="味方中前", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999001, level=10,
            element=1, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=5000, speed=450,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.ally_lf = UnitState(
            unit_id="ally_lf", name="味方左前", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999002, level=10,
            element=2, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=5000, speed=420,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        # 敌方：中前(最近,正前方味方对位)、左前、右前、中後
        self.enemy_cf = self._mk_enemy("enemy_cf", "敵中前", Position.ENEMY_CENTER_FRONT)
        self.enemy_lf = self._mk_enemy("enemy_lf", "敵左前", Position.ENEMY_LEFT_FRONT)
        self.enemy_rf = self._mk_enemy("enemy_rf", "敵右前", Position.ENEMY_RIGHT_FRONT)
        self.enemy_cb = self._mk_enemy("enemy_cb", "敵中後", Position.ENEMY_CENTER_BACK)

        self.bf.friend_team = [self.ally_cf, self.caster, self.ally_lf]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf, self.enemy_cb]

        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs, damage_service=self.dms,
            aura_service=self.aus, status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _mk_enemy(self, unit_id, name, position):
        return UnitState(
            unit_id=unit_id, name=name, side=Side.ENEMY,
            position=position, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    def _reset(self, level=10):
        self.caster.current_hp = self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = 10
        self.caster.current_pp = 10
        self.caster.current_ep = 5
        self.caster.level = level
        self.caster.guard_active = False
        self.caster.guard_rate = 0.0
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = level
        for u in [self.ally_cf, self.ally_lf]:
            u.current_hp = u.max_hp
            u.buffs = []
            u.debuffs = []
            u.is_alive = True
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf, self.enemy_cb]:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ep = 3
            e._damage_taken_in_action = 0

    def _marks(self, unit, name=SHISEI):
        return [b for b in unit.buffs + unit.debuffs
                if b.effect_type == MARK and b.name == name]

    def _darkness(self, unit):
        return [d for d in unit.debuffs if d.effect_type == DARKNESS]

    # ─────────────── EX 110081 ───────────────

    def test_ex_110081_darkness_all_and_shisei_priority(self):
        """EX: 敌全体暗闇(100%) + 失勢最多敌优先攻击。"""
        self._reset()
        # 失勢: lf 2个 > cf 1个 > 其他0
        self.enemy_lf.debuffs.append(_mk_mark(SHISEI, "ps", 2))
        self.enemy_cf.debuffs.append(_mk_mark(SHISEI, "ps", 1))
        hp_before = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf, self.enemy_cb]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=110081,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 暗闇全体
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf, self.enemy_cb]:
            dk = self._darkness(e)
            self.assertEqual(len(dk), 1, f"{e.unit_id}应有暗闇")
            self.assertEqual(dk[0].value, 100, "EX暗闇失手率100%")
            self.assertEqual(dk[0].duration, 1, "暗闇持续1行动")
        # 失勢最多(lf)被攻击
        self.assertLess(self.enemy_lf.current_hp, hp_before['enemy_lf'], "失勢最多敌lf应被攻击")
        self.assertEqual(self.enemy_cf.current_hp, hp_before['enemy_cf'], "非优先敌不应被攻击")
        # atk_down on lf
        atk_after = self.dms._calculate_final_stat(self.enemy_lf, "attack")
        self.assertLess(atk_after, self.enemy_lf.attack, "atk_down应生效")

    def test_ex_110081_darkness_causes_miss(self):
        """EX: 暗闇100%使攻击者技能MISS。"""
        self._reset()
        self.enemy_cf.debuffs.append(_mk_mark(SHISEI, "ps", 1))
        self.ss.execute_skill(caster=self.caster, skill_id=110081,
                              battlefield=self.bf, skip_cost=True)
        # 敌方攻击我方 → darknes 100% → MISS
        dmg_obj = type('obj', (object,), {
            'power': 100.0, 'hit_count': 1, 'element': 1,
            'ignore_defense': 0, 'ignore_shield': 0, 'hp_scaling_bonus': 0.0,
            'cannot_crit': True, 'force_crit': False, 'bonus_crit_rate': 0.0,
            'skill_id': 999999, 'name': 'test', 'base_value_source': None,
        })
        result = self.dms.calculate_damage(self.enemy_cf, self.caster, dmg_obj)
        self.assertEqual(result.total_damage, 0, "暗闇100%应MISS")
        self.assertTrue(all(result.hit_evades), "所有hit应标记为闪避/MISS")
        self.assertTrue(result.calc_detail.get('darkness_miss'), "应标记darkness_miss")

    def test_ex_110081_no_shisei_fallback_nearest(self):
        """EX: 无失勢持有者时回退最近敌。"""
        self._reset()
        hp_before = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf]}
        self.ss.execute_skill(caster=self.caster, skill_id=110081,
                              battlefield=self.bf, skip_cost=True)
        self.assertLess(self.enemy_cf.current_hp, hp_before['enemy_cf'],
                        "无失勢时应攻击最近敌cf")

    # ─────────────── AS1 120173 ───────────────

    def test_as1_120173_row_darkness_anchored_by_shisei(self):
        """AS1: 失勢最多敌所在横列暗闇（mark_priority锚定ROW）。"""
        self._reset()
        # 后排cb持有失勢最多 → 横列=后排3人
        self.enemy_cb.debuffs.append(_mk_mark(SHISEI, "ps", 3))
        result = self.ss.execute_skill(caster=self.caster, skill_id=120173,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 后排3人全部暗闇，前排无
        for e in [self.enemy_lb if hasattr(self, 'enemy_lb') else self.enemy_cb,
                  self.enemy_lf]:
            pass
        dk_cb = self._darkness(self.enemy_cb)
        self.assertEqual(len(dk_cb), 1, "失勢锚点cb应有暗闇")
        self.assertAlmostEqual(dk_cb[0].value, 55.0, places=1, msg="Lv10 kurayami=55")
        # 前排不受暗闇（锚点在后排）
        self.assertEqual(len(self._darkness(self.enemy_cf)), 0,
                         "锚点在后排时前排不应被暗闇")

    def test_as1_120173_single_target_debuffs(self):
        """AS1: 失勢最多敌单体 atk25%/def20% down（caster 1行动/死亡解除）。"""
        self._reset()
        self.enemy_lf.debuffs.append(_mk_mark(SHISEI, "ps", 2))
        result = self.ss.execute_skill(caster=self.caster, skill_id=120173,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        atk_downs = [d for d in self.enemy_lf.debuffs
                     if d.effect_type == STATUS_ATTACK and d.value == 25]
        def_downs = [d for d in self.enemy_lf.debuffs
                     if d.effect_type == STATUS_DEFENSE and d.value == 20]
        self.assertGreaterEqual(len(atk_downs), 1, "应有atk25% down")
        self.assertGreaterEqual(len(def_downs), 1, "应有def20% down")
        self.assertTrue(atk_downs[0].is_stackable, "重複可")
        self.assertTrue(getattr(atk_downs[0], 'source_death_remove', False),
                        "付与者死亡应解除")
        # 非失勢敌不应有
        atk_downs_cf = [d for d in self.enemy_cf.debuffs
                        if d.effect_type == STATUS_ATTACK and d.value == 25]
        self.assertEqual(len(atk_downs_cf), 0, "非失勢优先敌不应被双降")

    def test_as1_120173_lv11_spd_down(self):
        """AS1 Lv11+: 横列减速（fixed 75）。"""
        self._reset(level=11)
        self.enemy_lf.debuffs.append(_mk_mark(SHISEI, "ps", 1))
        self.ss.execute_skill(caster=self.caster, skill_id=120173,
                              battlefield=self.bf, skip_cost=True)
        spd_downs = [d for d in self.enemy_lf.debuffs if d.effect_type == STATUS_SPEED]
        self.assertGreaterEqual(len(spd_downs), 1, "L11+应减速")
        self.assertEqual(spd_downs[0].value, 75, "Lv11 spd tag=75固定值")
        # Lv10 无减速
        self._reset(level=10)
        self.enemy_lf.debuffs.append(_mk_mark(SHISEI, "ps", 1))
        self.ss.execute_skill(caster=self.caster, skill_id=120173,
                              battlefield=self.bf, skip_cost=True)
        self.assertEqual(len([d for d in self.enemy_lf.debuffs
                              if d.effect_type == STATUS_SPEED]), 0, "Lv10不应减速")

    # ─────────────── AS2 120174 ───────────────

    def _evade_hits(self, unit):
        return [b for b in unit.buffs if b.effect_type in ("Evade", "evade", "PerfectEvade")]

    def test_as2_120174_lv10_self_and_lowest_hp_ally(self):
        """AS2 Lv10: 自身+最低HP味方回避1ヒット+被ダメ減（attack_limited=1）。"""
        self._reset()
        self.ally_lf.current_hp = int(self.ally_lf.max_hp * 0.3)  # 最低HP
        result = self.ss.execute_skill(caster=self.caster, skill_id=120174,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for u in [self.caster, self.ally_lf]:
            evades = self._evade_hits(u)
            self.assertGreaterEqual(len(evades), 1, f"{u.unit_id}应获得回避buff")
            if evades:
                self.assertEqual(getattr(evades[0], 'hit_limited', 0), 1, "Lv10回避1ヒット")
            downs = [d for d in u.buffs if d.effect_type == RECEIVED_DAMAGE]
            self.assertGreaterEqual(len(downs), 1, f"{u.unit_id}应获得被ダメ減")
            if downs:
                self.assertAlmostEqual(downs[0].value, 20.0, places=1, msg="Lv10 dmg=20")
                self.assertEqual(downs[0].attack_limited, 1, "Lv10减伤1次攻击")
        # 非最低HP的ally_cf不应获得
        self.assertEqual(len(self._evade_hits(self.ally_cf)), 0,
                         "非最低HP味方不应获得回避")

    def test_as2_120174_lv15_three_hit_evasion(self):
        """AS2 Lv15: 回避3ヒット + 减伤attack_limited=2。"""
        self._reset(level=15)
        self.ally_lf.current_hp = int(self.ally_lf.max_hp * 0.3)
        self.ss.execute_skill(caster=self.caster, skill_id=120174,
                              battlefield=self.bf, skip_cost=True)
        for u in [self.caster, self.ally_lf]:
            evades = self._evade_hits(u)
            self.assertGreaterEqual(len(evades), 1)
            if evades:
                self.assertEqual(getattr(evades[0], 'hit_limited', 0), 3, "Lv15回避3ヒット")
            downs = [d for d in u.buffs if d.effect_type == RECEIVED_DAMAGE]
            if downs:
                self.assertEqual(downs[0].attack_limited, 2, "Lv15减伤2次攻击")

    # ─────────────── AS3 120175 ───────────────

    def test_as3_120175_cross_targets_and_ep_drain(self):
        """AS3: 最近敌+邻接2体受击，EX各削1；L10无ep_gain_down。"""
        self._reset()
        hp_before = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf, self.enemy_cb]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=120175,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_cf.current_hp, hp_before['enemy_cf'], "最近敌cf应受击")
        self.assertLess(self.enemy_lf.current_hp, hp_before['enemy_lf'], "邻接lf应受击")
        self.assertLess(self.enemy_rf.current_hp, hp_before['enemy_rf'], "邻接rf应受击")
        self.assertEqual(self.enemy_cb.current_hp, hp_before['enemy_cb'], "后排cb不应受击")
        # EX削1
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            self.assertEqual(e.current_ep, 2, f"{e.unit_id} EX应-1")
        self.assertEqual(self.enemy_cb.current_ep, 3, "未受击cb EX不变")

    def test_as3_120175_lv11_ep_gain_down(self):
        """AS3 Lv11+: 被攻击目标获得ep_gain_down 50%（自身1行动/死亡解除）。"""
        self._reset(level=11)
        self.ss.execute_skill(caster=self.caster, skill_id=120175,
                              battlefield=self.bf, skip_cost=True)
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            downs = [d for d in e.debuffs if d.effect_type == "EpGainDown"]
            self.assertGreaterEqual(len(downs), 1, f"{e.unit_id}应有ep_gain_down")
            if downs:
                self.assertEqual(downs[0].value, 50, "Lv11 ex tag=50")
                self.assertTrue(getattr(downs[0], 'source_death_remove', False),
                                "付与者死亡应解除")

    # ─────────────── PS 130181 ───────────────

    def _trigger_ps(self, attacked_ally):
        actions = self.ts.trigger_before_any_attacked(
            targets=[attacked_ally], battlefield=self.bf,
            attacker=self.enemy_cf,
        )
        return [a for a in actions if a.skill_id == 130181]

    def test_ps_130181_front_ally_triggers(self):
        """PS: 正前方味方(中前cf)被攻击前触发→攻击者skill_power_down+失勢。"""
        self._reset()
        sp_before = self.dms._calculate_final_stat(self.enemy_cf, "attack")  # placeholder
        ps = self._trigger_ps(self.ally_cf)
        self.assertGreater(len(ps), 0, "正前方味方被攻击应触发PS")
        self.ss._execute_trigger_actions_inline(ps, self.bf)
        # skill_power_down on attacker
        spds = [d for d in self.enemy_cf.debuffs if d.effect_type == SKILL_POWER_DOWN]
        self.assertGreaterEqual(len(spds), 1, "攻击者应获得skill_power_down")
        if spds:
            self.assertAlmostEqual(spds[0].value, 50.0, places=1, msg="Lv10 debuff tag=50")
            self.assertEqual(getattr(spds[0], 'original_duration_type', ''), 'attacker_action',
                             "持续时间应为attacker_action（当次行动内）")
        # 失勢mark
        self.assertEqual(len(self._marks(self.enemy_cf)), 1, "攻击者应获得失勢")

    def test_ps_130181_non_front_ally_no_trigger(self):
        """PS: 非正前方味方被攻击不触发。"""
        self._reset()
        ps = self._trigger_ps(self.ally_lf)
        self.assertEqual(len(ps), 0, "非正前方（左前）被攻击不应触发")
        self.assertEqual(len(self._marks(self.enemy_cf)), 0)

    # ─────────────── 配置校验 ───────────────

    def test_config_validation(self):
        """配置校验: trigger注册/同時発動制限/mark锚定。"""
        p181 = self.dl.get_parsed_skill_data(130181)
        self.assertEqual(p181['trigger_type'], 'before_any_attacked')
        self.assertTrue(p181.get('simultaneous_limit'), "130181应配置同時発動制限")
        self.assertEqual(p181.get('global_condition', {}).get('type'), 'target_is_front_ally')
        p173 = self.dl.get_parsed_skill_data(120173)
        row_effects = [e for b in p173['effect_blocks'] for e in b['effects']
                       if e['target_type'] == 'enemy_row']
        self.assertTrue(any(e['flags'].get('mark_priority') == SHISEI for e in row_effects),
                        "AS1横列应锚定失勢mark")
        p081 = self.dl.get_parsed_skill_data(110081)
        dmg = [e for b in p081['effect_blocks'] for e in b['effects'] if e['effect_type'] == 'damage'][0]
        self.assertEqual(dmg['target_type'], 'enemy_single_highest_mark_count')
        self.assertEqual(dmg['flags'].get('mark_name'), SHISEI)
        me_dark = [e for b in p081['effect_blocks'] for e in b['effects']
                   if e['effect_type'] == 'add_status'][0]
        self.assertEqual(me_dark['value'], 100, "EX暗闇=100%失手")


if __name__ == '__main__':
    unittest.main()
