"""
数据转储器

从解包的Master文件中读取数据并转换为稳定的JSON格式
"""

import json
import os
from pathlib import Path
from typing import Dict, List, Any


class DataDumper:
    """数据转储器"""
    
    def __init__(self, source_dir: str = None, target_dir: str = None):
        """
        初始化数据转储器
        
        Args:
            source_dir: 解包数据源目录，默认为 split_data/
            target_dir: 转储目标目录，默认为 data/
        """
        if source_dir is None:
            source_dir = Path(__file__).parent.parent.parent / "split_data"
        if target_dir is None:
            target_dir = Path(__file__).parent.parent.parent / "data"
        
        self.source_dir = Path(source_dir)
        self.target_dir = Path(target_dir)
        
        # 确保目标目录存在
        self.target_dir.mkdir(parents=True, exist_ok=True)
    
    def _load_json(self, filename: str) -> List[Dict[str, Any]]:
        """加载JSON文件"""
        filepath = self.source_dir / filename
        with open(filepath, 'r', encoding='utf-8') as f:
            return json.load(f)
    
    def _save_json(self, data: Any, filename: str):
        """保存JSON文件"""
        filepath = self.target_dir / filename
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        print(f"✓ 已保存: {filepath}")
    
    def dump_character_data(self) -> Dict[int, Dict]:
        """
        转储角色数据
        
        Returns:
            字典，key为角色ID，value为转储后的角色数据
        """
        print("正在转储角色数据...")
        raw_data = self._load_json("CharacterMaster.json")
        
        characters = {}
        for char in raw_data:
            character_id = char["Id"]
            
            # 构建转储格式
            dumped_char = {
                "character_id": character_id,
                "name": char["Name"],
                "character_base_id": char["CharacterBaseMasterId"],
                "default_rarity": char["DefaultRarity"],
                "character_type": char["Type"],
                "attribute": char["Attribute"],
                "position_type": char["PositionType"],
                "role_type": char["RoleType"],
                "action_point": char["ActionPoint"],
                "passive_point": char["PassivePoint"],
                "min_level_stats": {
                    "level": 1,
                    "hp": char["MinHp"],
                    "attack": char["MinAttack"],
                    "defense": char["MinDefense"],
                    "speed": char["MinSpeed"],
                    "crit_rate": char["MinCriticalRate"]
                },
                "max_level_stats": {
                    "level": 200,
                    "hp": char["MaxHp"],
                    "attack": char["MaxAttack"],
                    "defense": char["MaxDefense"],
                    "speed": char["MaxSpeed"],
                    "crit_rate": char["MaxCriticalRate"]
                },
                "bonus_per_level": {
                    "hp": char["BonusHpPerLevel"],
                    "attack": char["BonusAttackPerLevel"],
                    "defense": char["BonusDefensePerLevel"],
                    "speed": char["BonusSpeedPerLevel"],
                    "crit_rate": char["BonusCriticalRatePerLevel"]
                },
                "grades": {
                    "hp_grade": char["HpGrade"],
                    "attack_grade": char["AttackGrade"],
                    "defense_grade": char["DefenseGrade"],
                    "speed_grade": char["SpeedGrade"],
                    "crit_rate_grade": char["CriticalRateGrade"]
                },
                # 保留原始数据
                "raw_data": char
            }
            
            characters[character_id] = dumped_char
        
        # 保存为JSON文件
        self._save_json(characters, "characters.json")
        print(f"  共转储 {len(characters)} 个角色")
        
        return characters
    
    def dump_character_skill_mapping(self) -> Dict[int, List[int]]:
        """
        转储角色技能映射
        
        Returns:
            字典，key为角色ID，value为技能ID列表
        """
        print("正在转储角色技能映射...")
        raw_data = self._load_json("CharacterSkillMaster.json")
        
        # 按角色ID分组
        mappings = {}
        for item in raw_data:
            char_id = item["CharacterMasterId"]
            skill_id = item["SkillMasterId"]
            
            if char_id not in mappings:
                mappings[char_id] = []
            
            mappings[char_id].append(skill_id)
        
        # 转换为列表格式
        result = {
            char_id: {"character_id": char_id, "skill_ids": skills}
            for char_id, skills in mappings.items()
        }
        
        # 保存为JSON文件
        self._save_json(result, "character_skills.json")
        print(f"  共转储 {len(result)} 个角色的技能映射")
        
        return mappings
    
    def dump_skill_data(self) -> Dict[int, Dict]:
        """
        转储技能数据
        
        Returns:
            字典，key为技能ID，value为转储后的技能数据
        """
        print("正在转储技能数据...")
        raw_data = self._load_json("SkillMaster.json")
        
        skills = {}
        for skill in raw_data:
            skill_id = skill["Id"]
            
            # 处理AdditionalKinds
            additional_kinds = []
            for ak in skill.get("AdditionalKinds", []):
                additional_kinds.append({
                    "level": ak["Level"],
                    "value": ak["Value"]
                })
            
            # 处理DescriptionTemplates
            descriptions = []
            for desc in skill.get("DescriptionTemplates", []):
                descriptions.append({
                    "min_level": desc["Level"],
                    "template": desc["Template"]
                })
            
            # 处理TemplateTags
            template_tags = {}
            for tag in skill.get("TemplateTags", []):
                tag_name = tag["TagName"]
                values = []
                for val in tag.get("Values", []):
                    values.append({
                        "level": val["Level"],
                        "value": val["Value"]
                    })
                
                template_tags[tag_name] = {
                    "interpolation_mode": tag["InterpolationMode"],
                    "values": values
                }
            
            # 构建转储格式
            dumped_skill = {
                "skill_id": skill_id,
                "name": skill["Name"],
                "skill_type": skill["Type"],
                "skill_kind": skill.get("Kind", 0),
                "resource_cost": skill["ResourceCost"],
                "cooldown": skill["CoolTime"],
                "cooldown_update_timing": skill.get("CoolTimeUpdateTiming"),
                "default_max_level": skill["DefaultMaxLevel"],
                "descriptions": descriptions,
                "template_tags": template_tags,
            }
            
            skills[skill_id] = dumped_skill
        
        # 保存为JSON文件
        self._save_json(skills, "skills.json")
        print(f"  共转储 {len(skills)} 个技能")
        
        return skills
    
    def dump_level_lerp_data(self) -> Dict[int, float]:
        """
        转储等级插值数据
        
        Returns:
            字典，key为等级，value为插值系数
        """
        print("正在转储等级插值数据...")
        raw_data = self._load_json("CharacterStatusLerpAmountMaster.json")
        
        lerp_data = {}
        for item in raw_data:
            level = item["Level"]
            amount = item["Amount"]
            lerp_data[level] = amount
        
        # 保存为JSON文件
        self._save_json(lerp_data, "level_lerp.json")
        print(f"  共转储 {len(lerp_data)} 个等级的插值数据")
        
        return lerp_data
    
    def dump_affection_bonuses(self) -> Dict:
        """
        转储好感度加成数据
        
        Returns:
            字典，按character_type和affection_level组织
        """
        print("正在转储好感度加成数据...")
        raw_data = self._load_json("CharacterAffectionStatusMaster.json")
        
        # 按Type分组
        affection_data = {}
        for item in raw_data:
            char_type = item["Type"]
            affection_level = item["AffectionLevel"]
            
            if char_type not in affection_data:
                affection_data[char_type] = {}
            
            affection_data[char_type][affection_level] = {
                "affection_level": affection_level,
                "character_type": char_type,
                "additional_hp": item["AdditionalHp"],
                "additional_attack": item["AdditionalAttack"],
                "additional_defense": item["AdditionalDefence"],
                "additional_speed": item["AdditionalSpeed"],
                "additional_action_point": item["AdditionalActionPoint"],
                "additional_passive_point": item["AdditionalPassivePoint"]
            }
        
        # 保存为JSON文件
        self._save_json(affection_data, "affection_bonuses.json")
        print(f"  共转储 {len(affection_data)} 种角色类型的好感度数据")
        
        return affection_data
    
    def dump_rarity_bonuses(self) -> Dict:
        """
        转储稀有度加成数据
        
        Returns:
            字典，按character_id和rarity组织
        """
        print("正在转储稀有度加成数据...")
        raw_data = self._load_json("CharacterRarityStatusMaster.json")
        
        # 按角色ID分组
        rarity_data = {}
        for item in raw_data:
            char_id = item["CharacterMasterId"]
            rarity = item["Rarity"]
            
            if char_id not in rarity_data:
                rarity_data[char_id] = {}
            
            rarity_data[char_id][rarity] = {
                "character_id": char_id,
                "rarity": rarity,
                "additional_hp": item["AdditionalHp"],
                "additional_attack": item["AdditionalAttack"],
                "additional_defense": item["AdditionalDefence"],
                "additional_speed": item["AdditionalSpeed"],
                "additional_crit_rate": item["AdditionalCriticalRate"],
                "additional_action_point": item["AdditionalActionPoint"],
                "additional_passive_point": item["AdditionalPassivePoint"]
            }
        
        # 保存为JSON文件
        self._save_json(rarity_data, "rarity_bonuses.json")
        print(f"  共转储 {len(rarity_data)} 个角色的稀有度加成数据")
        
        return rarity_data
    
    def dump_school_systems(self) -> Dict:
        """
        转储学园系统数据
        
        Returns:
            包含school_definitions和school_bonuses的字典
        """
        print("正在转储学园系统数据...")
        
        # 加载学园系统定义
        actuator_data = self._load_json("ActuatorMaster.json")
        school_definitions = {}
        
        for item in actuator_data:
            actuator_id = item["Id"]
            school_definitions[actuator_id] = {
                "actuator_id": actuator_id,
                "name": item["FullName"],
                "character_type": item.get("CharacterType"),
                "character_attribute": item.get("CharacterAttribute"),
                "description": item["Description"]
            }
        
        # 加载学园等级加成
        status_data = self._load_json("ActuatorStatusMaster.json")
        school_bonuses = {}
        
        for item in status_data:
            group_id = item["ActuatorStatusGroupMasterId"]
            level = item["Level"]
            
            if group_id not in school_bonuses:
                school_bonuses[group_id] = {}
            
            school_bonuses[group_id][level] = {
                "group_id": group_id,
                "level": level,
                "hp_bonus": item["Hp"],
                "attack_bonus": item["Attack"],
                "defense_bonus": item["Defense"]
            }
        
        result = {
            "definitions": school_definitions,
            "bonuses": school_bonuses
        }
        
        # 保存为JSON文件
        self._save_json(result, "school_systems.json")
        print(f"  共转储 {len(school_definitions)} 个学园系统定义")
        print(f"  共转储 {len(school_bonuses)} 组学园等级加成")
        
        return result
    
    def dump_equipment_data(self) -> Dict:
        """
        转储装备数据（含人为定义的满级数值）
        
        Returns:
            字典，按character_type和equipment_type组织
        """
        print("正在转储装备数据...")
        raw_data = self._load_json("TypeEquipmentMaster.json")
        
        # 装备满级数值定义 (160级)
        equipment_stats = {
            1: {'hp': 2420, 'attack': 4810, 'defense': 0},  # 传感器
            2: {'hp': 3330, 'attack': 3770, 'defense': 0},  # 执行器
            3: {'hp': 3330, 'attack': 0, 'defense': 1930},  # 电池
            4: {'hp': 2420, 'attack': 0, 'defense': 2840}   # 发动机
        }
        
        equipment_data = {}
        for item in raw_data:
            equip_id = item["Id"]
            equip_type = item["Type"]
            char_type = item["CharacterType"]
            
            stats = equipment_stats[equip_type]
            
            equipment_data[equip_id] = {
                "equipment_id": equip_id,
                "name": item["Name"],
                "character_type": char_type,
                "equipment_type": equip_type,
                "hp_bonus": stats['hp'],
                "attack_bonus": stats['attack'],
                "defense_bonus": stats['defense'],
                "description": item["Description"]
            }
        
        # 保存为JSON文件
        self._save_json(equipment_data, "equipment.json")
        print(f"  共转储 {len(equipment_data)} 个装备")
        
        return equipment_data
    
    def dump_module_data(self) -> Dict:
        """
        转储模块定义数据
        
        Returns:
            字典，按module_id组织
        """
        print("正在转储模块定义数据...")
        raw_data = self._load_json("ModuleMaster.json")
        
        modules = {}
        for item in raw_data:
            module_id = item["Id"]
            modules[module_id] = {
                "module_id": module_id,
                "name": item["Name"],
                "character_type": item["CharacterType"],
                "module_type": item["ModuleType"]
            }
        
        # 保存为JSON文件
        self._save_json(modules, "modules.json")
        print(f"  共转储 {len(modules)} 个模块定义")
        
        return modules
    
    def dump_module_status_data(self) -> Dict:
        """
        转储模块状态数据（所有Tier）
        
        Returns:
            字典，按module_id和tier组织
        """
        print("正在转储模块状态数据...")
        raw_data = self._load_json("ModuleStatusMaster.json")
        
        module_status = {}
        for item in raw_data:
            module_id = item["ModuleMasterId"]
            tier = item["Tier"]
            
            if module_id not in module_status:
                module_status[module_id] = {}
            
            module_status[module_id][tier] = {
                "module_id": module_id,
                "tier": tier,
                "hp_base": item["HpBase"],
                "hp_per_level": item["HpPerLevel"],
                "hp_rate": item["HpRate"],
                "attack_base": item["AttackBase"],
                "attack_per_level": item["AttackPerLevel"],
                "attack_rate": item["AttackRate"],
                "defense_base": item["DefenseBase"],
                "defense_per_level": item["DefensePerLevel"],
                "defense_rate": item["DefenseRate"]
            }
        
        # 保存为JSON文件
        self._save_json(module_status, "module_status.json")
        print(f"  共转储 {len(module_status)} 个模块的状态数据")
        
        return module_status
    
    def dump_gear_effects_data(self) -> Dict:
        """
        转储模块开孔词条数据
        
        Returns:
            包含gear_definitions和gear_effects的字典
        """
        print("正在转储模块开孔词条数据...")
        
        # 加载词条定义
        gear_master = self._load_json("ModuleGearMaster.json")
        gear_definitions = {}
        
        for item in gear_master:
            gear_id = item["Id"]
            gear_definitions[gear_id] = {
                "gear_id": gear_id,
                "title": item["Title"],
                "effect_type": item["EffectType"]
            }
        
        # 加载词条效果数值
        gear_effects = self._load_json("ModuleGearEffectMaster.json")
        effects_by_gear = {}
        
        for item in gear_effects:
            gear_id = item["ModuleGearMasterId"]
            rank = item["Rank"]
            
            if gear_id not in effects_by_gear:
                effects_by_gear[gear_id] = {}
            
            effects_by_gear[gear_id][rank] = {
                "rank": rank,
                "effect_value": item["EffectValue"]
            }
        
        result = {
            "definitions": gear_definitions,
            "effects": effects_by_gear
        }
        
        # 保存为JSON文件
        self._save_json(result, "gear_effects.json")
        print(f"  共转储 {len(gear_definitions)} 种词条类型")
        
        return result
    
    def dump_enemy_data(self) -> Dict:
        """
        转储敌方单位数据
        包含 EnemyMaster 和 EnemySkillMaster
        """
        print("正在转储敌方单位数据...")
        
        # 1. 加载 EnemyMaster
        enemy_master = self._load_json("EnemyMaster.json")
        enemies = {}
        
        for item in enemy_master:
            enemy_id = item["Id"]
            enemies[enemy_id] = {
                "enemy_id": enemy_id,
                "name": item["Name"],
                "asset_id": item["AssetId"],
                # 基础属性
                "hp": item["Hp"],
                "attack": item["Attack"],
                "defense": item["Defense"],
                "speed": item["Speed"],
                # 属性等级
                "hp_grade": item["HpGrade"],
                "attack_grade": item["AttackGrade"],
                "defense_grade": item["DefenseGrade"],
                "speed_grade": item["SpeedGrade"],
                # 战斗属性
                "critical_rate": item["CriticalRate"],
                "critical_rate_grade": item["CriticalRateGrade"],
                # 类型信息
                "attribute": item["Attribute"],
                "type": item["Type"],
                "role_type": item["RoleType"],
                "rarity": item["Rarity"],
                # 技能列表初始化
                "skill_ids": []
            }
            
        # 2. 加载 EnemySkillMaster 并关联技能
        enemy_skill_master = self._load_json("EnemySkillMaster.json")
        
        # 建立 skill_id -> level 的映射 (虽然目前只需ID列表，但保留等级信息备用)
        # 注意：同一个敌人可能有多个技能
        for item in enemy_skill_master:
            enemy_id = item["EnemyMasterId"]
            skill_id = item["SkillMasterId"]
            
            if enemy_id in enemies:
                enemies[enemy_id]["skill_ids"].append(skill_id)
        
        # 保存为JSON文件
        self._save_json(enemies, "enemies.json")
        print(f"  共转储 {len(enemies)} 个敌方单位")
        
        return enemies

    def dump_memory_data(self) -> Dict:
        """
        转储回忆卡数据
        包含 MemoryMaster 和 MemorySkillMaster
        """
        print("正在转储回忆卡数据...")
        
        # 1. 加载 MemoryMaster
        memory_master = self._load_json("MemoryMaster.json")
        memories = {}
        
        for item in memory_master:
            memory_id = item["Id"]
            
            highlights = []
            for hl in item.get("Highlights", []):
                highlights.append({
                    "character_attribute": hl.get("CharacterAttribute"),
                    "character_base_master_id": hl.get("CharacterBaseMasterId"),
                    "character_master_id": hl.get("CharacterMasterId"),
                    "character_role": hl.get("CharacterRole"),
                    "character_team_master_id": hl.get("CharacterTeamMasterId"),
                    "character_type": hl.get("CharacterType"),
                    "is_targeting_friendly_party": hl.get("IsTargetingFriendlyParty", True),
                    "party_position": hl.get("PartyPosition"),
                    "skill_master_id": hl.get("SkillMasterId"),
                })
            
            memories[memory_id] = {
                "memory_id": memory_id,
                "name": item["Name"],
                "description": item["Description"],
                "rarity": item["Rarity"],
                "highlights": highlights,
            }
        
        # 2. 读取 MemorySkillMaster，补充缺失的技能高亮
        memory_skill_master = self._load_json("MemorySkillMaster.json")
        for item in memory_skill_master:
            memory_id = item["MemoryMasterId"]
            skill_id = item["SkillMasterId"]
            
            if memory_id not in memories:
                continue
            
            existing_skill_ids = {hl["skill_master_id"] for hl in memories[memory_id]["highlights"]}
            if skill_id in existing_skill_ids:
                continue
            
            # 为缺失的技能创建默认高亮（无额外过滤条件）
            memories[memory_id]["highlights"].append({
                "character_attribute": None,
                "character_base_master_id": None,
                "character_master_id": None,
                "character_role": None,
                "character_team_master_id": None,
                "character_type": None,
                "is_targeting_friendly_party": True,
                "party_position": None,
                "skill_master_id": skill_id,
            })
            print(f"  [补充] 记忆卡 {memory_id} 添加缺失技能 {skill_id}")
        
        # 保存为JSON文件
        self._save_json(memories, "memories.json")
        print(f"  共转储 {len(memories)} 张回忆卡")
        
        return memories
    
    def dump_all(self):
        """转储所有数据"""
        print("=" * 60)
        print("开始数据转储")
        print("=" * 60)
        print(f"源目录: {self.source_dir}")
        print(f"目标目录: {self.target_dir}")
        print()
        
        # 转储角色数据
        characters = self.dump_character_data()
        print()
        
        # 转储角色技能映射
        char_skills = self.dump_character_skill_mapping()
        print()
        
        # 转储技能数据
        skills = self.dump_skill_data()
        print()
        
        # 转储等级插值数据
        level_lerp = self.dump_level_lerp_data()
        print()
        
        # 转储好感度加成
        affection = self.dump_affection_bonuses()
        print()
        
        # 转储稀有度加成
        rarity = self.dump_rarity_bonuses()
        print()
        
        # 转储学园系统
        school = self.dump_school_systems()
        print()
        
        # 转储装备数据
        equipment = self.dump_equipment_data()
        print()
        
        # 转储模块定义
        modules = self.dump_module_data()
        print()
        
        # 转储模块状态
        module_status = self.dump_module_status_data()
        print()
        
        # 转储开孔词条
        gear_effects = self.dump_gear_effects_data()
        print()
        
        # 转储敌方数据
        enemies = self.dump_enemy_data()
        print()
        
        # 转储回忆卡数据
        memories = self.dump_memory_data()
        print()
        
        print("=" * 60)
        print("数据转储完成！")
        print("=" * 60)
        print(f"角色数: {len(characters)}")
        print(f"技能数: {len(skills)}")
        print(f"角色-技能映射数: {len(char_skills)}")
        print(f"等级插值数据: {len(level_lerp)} 个等级")
        print(f"好感度加成: {len(affection)} 种类型")
        print(f"稀有度加成: {len(rarity)} 个角色")
        print(f"学园系统: {len(school['definitions'])} 个系统")
        print(f"装备: {len(equipment)} 个")
        print(f"模块定义: {len(modules)} 个")
        print(f"模块状态: {len(module_status)} 个模块")
        print(f"开孔词条: {len(gear_effects['definitions'])} 种")
        print(f"敌方单位: {len(enemies)} 个")
        print(f"回忆卡: {len(memories)} 张")
        print()
        
        return {
            "characters": characters,
            "skills": skills,
            "character_skills": char_skills,
            "level_lerp": level_lerp,
            "affection": affection,
            "rarity": rarity,
            "school": school,
            "equipment": equipment,
            "modules": modules,
            "module_status": module_status,
            "gear_effects": gear_effects,
            "enemies": enemies,
            "memories": memories
        }


if __name__ == "__main__":
    # 运行数据转储
    dumper = DataDumper()
    dumper.dump_all()
