            heal_eff_buffs = [b for b in ally.buffs if b.effect_type == RECEIVED_HEALING]
            self.assertEqual(len(heal_eff_buffs), 0,
                             f"{ally.unit_id} Lv10 不应有 heal_efficacy_up")

