        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    # ───────────────────────── 重置辅助 ─────────────────────────

    def _reset_allies(self, full=True):
        """重置友方状态。full=True 时回满 HP。"""
        for u in (self.caster, self.ally_fl, self.ally_fc, self.ally_fr):
            u.current_hp = u.max_hp if full else u.current_hp
            u.buffs = []
            u.debuffs = []
            u.is_alive = True
            u.skill_cooldowns = {}
        if full:
            for u in (self.caster, self.ally_fl, self.ally_fc, self.ally_fr):
                u.current_hp = u.max_hp

    def _reset_enemies(self):
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.level = 15
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 15

    # ════════════════════════════════════════════════════════════════
    # EX 110045 メイドの本能
    # ════════════════════════════════════════════════════════════════

    def test_ex_targets_lowest_hp_ratio_ally(self):
        """EX(110045) 对 HP 比例最低的友方付与 perfect_evasion/atk_up/poison。"""
        self._reset_allies()
        # 让 ally_fr (max_hp=20000) HP 比例最低
        self.ally_fr.current_hp = 5000  # 25%
        self.ally_fc.current_hp = self.ally_fc.max_hp  # 100%
        self.ally_fl.current_hp = self.ally_fl.max_hp  # 100%
        self.caster.current_hp = self.caster.max_hp  # 100%

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=EX_MAID_INSTINCT, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result.get("success"))

        # ally_fr 应获得 perfect_evasion + atk_up + poison
        evade_buffs = [b for b in self.ally_fr.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evade_buffs), 1, "lowest HP ally 应获得 perfect_evasion")
        atk_buffs = [b for b in self.ally_fr.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 1, "lowest HP ally 应获得 atk_up")
        poison_debuffs = [d for d in self.ally_fr.debuffs if d.effect_type == POISON]
        self.assertEqual(len(poison_debuffs), 1, "lowest HP ally 应获得 poison")

        # 其他友方不应有这些 buff
        self.assertEqual(
            len([b for b in self.ally_fc.buffs if b.effect_type == EVADE]), 0,
            "非最低 HP 友方不应获得 perfect_evasion"
        )

    def test_ex_perfect_evasion_hit_limited_999(self):
        """EX(110045) perfect_evasion hit_limited=999（1 行動全段回避）。"""
        self._reset_allies()
        self.ally_fr.current_hp = 5000  # lowest

        self.ss.execute_skill(
            caster=self.caster, skill_id=EX_MAID_INSTINCT, battlefield=self.bf, skip_cost=True
        )

        evade_buffs = [b for b in self.ally_fr.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evade_buffs), 1)
        self.assertEqual(getattr(evade_buffs[0], 'hit_limited', 0), 999,
                         "perfect_evasion hit_limited 应为 999")

    def test_ex_perfect_evasion_duration_1_action(self):
        """EX(110045) perfect_evasion duration=1 (action)。"""
        self._reset_allies()
        self.ally_fr.current_hp = 5000

        self.ss.execute_skill(
            caster=self.caster, skill_id=EX_MAID_INSTINCT, battlefield=self.bf, skip_cost=True
        )

        evade_buffs = [b for b in self.ally_fr.buffs if b.effect_type == EVADE]
        self.assertEqual(evade_buffs[0].duration, 1,
                         "perfect_evasion duration 应为 1")
        self.assertEqual(
            getattr(evade_buffs[0], 'timing_type', None),
            AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            "perfect_evasion timing_type 应为 DURABLE_TARGET_MANEUVER_END (action)"
        )

    def test_ex_atk_up_applied_with_value_tag(self):
        """EX(110045) atk_up 使用 value_tag=atk (Lv15: 35%)。"""
        self._reset_allies()
        self.ally_fr.current_hp = 5000

        self.ss.execute_skill(
            caster=self.caster, skill_id=EX_MAID_INSTINCT, battlefield=self.bf, skip_cost=True
        )

        atk_buffs = [b for b in self.ally_fr.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 1)
        # Lv15 atk value_tag = 35.0 (percent 类型，存为整数百分比 35 而非小数 0.35)
        self.assertAlmostEqual(atk_buffs[0].value, 35.0, places=1,
                               msg="Lv15 atk_up value 应为 35 (35%)")

    def test_ex_poison_lv15_value_20pct(self):
        """EX(110045) Lv15 poison=20% (来自 value_tag=poison)。"""
        self._reset_allies()
        self.ally_fr.current_hp = 5000

        self.ss.execute_skill(
            caster=self.caster, skill_id=EX_MAID_INSTINCT, battlefield=self.bf, skip_cost=True
        )

        poison_debuffs = [d for d in self.ally_fr.debuffs if d.effect_type == POISON]
        self.assertEqual(len(poison_debuffs), 1)
        # Lv15 poison value_tag = 20.0 → value=0.20
        self.assertAlmostEqual(poison_debuffs[0].value, 0.20, places=2,
                               msg="Lv15 poison value 应为 0.20 (20%)")

    def test_ex_poison_lv10_value_30pct(self):
        """EX(110045) Lv10 poison=30% (验证 value_tag 跨等级取值)。"""
        # 用独立战场避免污染主 setUp
        bf10 = BattlefieldState()
        bf10.turn_number = 1
        caster10 = UnitState(
            unit_id="c10", name="c10", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=129302, level=10,
            element=2, character_type=2,
            max_hp=50000, current_hp=50000,
            attack=10000, defense=4000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[EX_MAID_INSTINCT], skill_levels={EX_MAID_INSTINCT: 10},
            skill_cooldowns={},
        )
        ally10 = UnitState(
            unit_id="a10", name="a10", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999101, level=10,
            element=1, character_type=1,
            max_hp=20000, current_hp=5000,  # lowest
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        enemy10 = UnitState(
            unit_id="e10", name="e10", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=3, character_type=1,
            max_hp=999999, current_hp=999999,
            attack=1000, defense=0, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        bf10.friend_team = [caster10, ally10]
        bf10.enemy_team = [enemy10]
        ss10 = SkillService(
            self.dl, ResourceService(),
            target_service=TargetService(),
            damage_service=DamageService(),
            aura_service=AuraService(),
            status_service=StatusService(),
            trigger_service=TriggerService(),
        )
        ss10.set_battlefield(bf10)

        result = ss10.execute_skill(caster10, EX_MAID_INSTINCT, bf10, skip_cost=True)
        self.assertTrue(result.get("success"))

        poison_debuffs = [d for d in ally10.debuffs if d.effect_type == POISON]
        self.assertEqual(len(poison_debuffs), 1)
        # Lv10 poison value_tag = 30.0 → value=0.30
        self.assertAlmostEqual(poison_debuffs[0].value, 0.30, places=2,
                               msg="Lv10 poison value 应为 0.30 (30%)")

    def test_ex_lowest_hp_ratio_not_absolute(self):
        """EX(110045) lowest_hp_priority 按 HP 比例（非绝对值）。

        ally_fl: max_hp=40000, current=15000 → 37.5%
        ally_fr: max_hp=20000, current=8000  → 40%
        应选 ally_fl（比例更低）而非 ally_fr（绝对值更低）。
        """
        self._reset_allies()
        self.ally_fl.current_hp = 15000  # 37.5%
        self.ally_fc.current_hp = self.ally_fc.max_hp
        self.ally_fr.current_hp = 8000  # 40%
        self.caster.current_hp = self.caster.max_hp

        self.ss.execute_skill(
            caster=self.caster, skill_id=EX_MAID_INSTINCT, battlefield=self.bf, skip_cost=True
        )

        # 应选 ally_fl（37.5% < 40%）
        evade_fl = [b for b in self.ally_fl.buffs if b.effect_type == EVADE]
        evade_fr = [b for b in self.ally_fr.buffs if b.effect_type == EVADE]
        self.assertGreater(len(evade_fl), 0, "ally_fl(37.5%) 应被选为目标")
        self.assertEqual(len(evade_fr), 0, "ally_fr(40%) 不应被选为目标")

    # ════════════════════════════════════════════════════════════════
    # AS1 120100 キックアウト
    # ════════════════════════════════════════════════════════════════

    def test_as1_lv10_damage_only_no_lifesteal(self):
        """AS1(120100) Lv10: 仅 EN 伤害，无 lifesteal/heal（Block2 L11+ 未满足）。"""
        self._reset_allies()
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[AS_KICK_OUT] = 10
        # 让 caster 满血（避免被选为 lowest_hp 目标）
        self.ally_fr.current_hp = self.ally_fr.max_hp
        self.caster.current_hp = self.caster.max_hp

        caster_hp_before = self.caster.current_hp
        ally_fr_hp_before = self.ally_fr.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=AS_KICK_OUT, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result.get("success"))

        # 最近敌方应受到 EN 伤害
        self.assertLess(self.enemy_fc.current_hp, self.enemy_fc.max_hp,
                        "enemy_fc 应受到 AS1 EN 伤害")

        # Lv10 时无 lifesteal/heal → caster/ally_fr HP 不变
        self.assertEqual(self.caster.current_hp, caster_hp_before,
                         "Lv10 无 lifesteal，caster HP 不变")
        self.assertEqual(self.ally_fr.current_hp, ally_fr_hp_before,
                         "Lv10 无 heal，ally_fr HP 不变")

    def test_as1_lv15_lifesteal_heals_lowest_hp_ally(self):
        """AS1(120100) Lv15: lifesteal 治疗 HP 比例最低的友方（非 caster）。"""
        self._reset_allies()
        self._reset_enemies()
        # caster 满血，ally_fr 比例最低
        self.caster.current_hp = self.caster.max_hp  # 100%
        self.ally_fr.current_hp = 5000  # 25% - lowest
        self.ally_fc.current_hp = self.ally_fc.max_hp
        self.ally_fl.current_hp = self.ally_fl.max_hp

        caster_hp_before = self.caster.current_hp
        ally_fr_hp_before = self.ally_fr.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=AS_KICK_OUT, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result.get("success"))

        # caster 不应被 lifesteal 治疗
        self.assertEqual(self.caster.current_hp, caster_hp_before,
                         "caster 不应被 lifesteal 治疗（目标是 lowest HP ally）")

        # ally_fr 应被治疗
        self.assertGreater(self.ally_fr.current_hp, ally_fr_hp_before,
                           "lowest HP ally 应被 lifesteal 治疗")

    def test_as1_lv15_max_hp_10pct_heal(self):
        """AS1(120100) Lv15: 附带 max_hp×10% 治疗（heal_base=max_hp）。"""
        self._reset_allies()
        self._reset_enemies()
        self.caster.current_hp = self.caster.max_hp
        self.ally_fr.current_hp = 5000  # lowest
        self.ally_fc.current_hp = self.ally_fc.max_hp
        self.ally_fl.current_hp = self.ally_fl.max_hp

        ally_fr_hp_before = self.ally_fr.current_hp

        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_KICK_OUT, battlefield=self.bf, skip_cost=True
        )

        # ally_fr 应获得 lifesteal + max_hp×10% 治疗
        # max_hp×10% = 20000×10% = 2000
        total_heal = self.ally_fr.current_hp - ally_fr_hp_before
        self.assertGreater(total_heal, 2000,
                           "ally_fr 应获得至少 max_hp*10%=2000 治疗 (+ lifesteal)")

    def test_as1_is_en_attack(self):
        """AS1(120100) Block1 damage is_en_attack=true（EN 伤害）。"""
        cfg = self.dl.get_parsed_skill_data(AS_KICK_OUT)
        dmg_eff = cfg['effect_blocks'][0]['effects'][0]
        self.assertEqual(dmg_eff['effect_type'], "damage")
        flags = dmg_eff.get('flags', {}) or {}
        self.assertTrue(flags.get('is_en_attack'),
                        "AS1 damage flags.is_en_attack 应为 true")

