            self.assertGreaterEqual(len(heal_eff_debuffs), 1,
                                    f"{enemy.unit_id} 应有 heal_efficacy_down")
            self.assertEqual(heal_eff_debuffs[0].duration, -1,
                             "heal_efficacy_down 应为永続 (duration=-1)")

    def test_as3_split_among_targets_excludes_dead(self):
        """AS3(120102) split_among_targets: 死亡友方不参与均摊。"""
        self._reset_allies()
        self._reset_enemies()
        # 让 ally_fl 和 ally_fr 死亡
        self.ally_fl.is_alive = False
        self.ally_fl.current_hp = 0
        self.ally_fr.is_alive = False
        self.ally_fr.current_hp = 0
        # caster 和 ally_fc 受伤
        self.caster.current_hp = self.caster.max_hp - 5000
        self.ally_fc.current_hp = self.ally_fc.max_hp - 5000

        hp_caster_before = self.caster.current_hp
        hp_ally_fc_before = self.ally_fc.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=AS_MERCY, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result.get("success"))

        # 仅存活友方应被治疗
        self.assertGreater(self.caster.current_hp, hp_caster_before,
                           "存活 caster 应被治疗")
        self.assertGreater(self.ally_fc.current_hp, hp_ally_fc_before,
                           "存活 ally_fc 应被治疗")
        # 死亡友方保持死亡状态
        self.assertFalse(self.ally_fl.is_alive, "ally_fl 应保持死亡")
        self.assertFalse(self.ally_fr.is_alive, "ally_fr 应保持死亡")

