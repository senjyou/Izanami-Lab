    # ════════════════════════════════════════════════════════════════
    # AS3 120102 マーシーズ・エンブレイス
    # ════════════════════════════════════════════════════════════════

    def test_as3_split_among_targets_equal_heal(self):
        """AS3(120102) split_among_targets: 均摊治疗（每个友方治疗量相近）。"""
        self._reset_allies()
        self._reset_enemies()
        # 让所有友方有相同的 HP 缺口
        deficit = 10000
        for u in (self.caster, self.ally_fl, self.ally_fc, self.ally_fr):
            u.current_hp = u.max_hp - deficit

        hp_before = {u.unit_id: u.current_hp
                     for u in (self.caster, self.ally_fl, self.ally_fc, self.ally_fr)}

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=AS_MERCY, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result.get("success"))

        heals = {u.unit_id: u.current_hp - hp_before[u.unit_id]
                 for u in (self.caster, self.ally_fl, self.ally_fc, self.ally_fr)}

        # 所有治疗量应 > 0
        for uid, heal in heals.items():
            self.assertGreater(heal, 0, f"{uid} 应获得治疗 > 0")

        # 均摊：最大最小差异 ≤ 1（整数除法容差）
        max_heal = max(heals.values())
        min_heal = min(heals.values())
        self.assertLessEqual(max_heal - min_heal, 1,
                             f"均摊治疗应相近，got {heals}")

    def test_as3_lv10_no_heal_efficacy_up(self):
        """AS3(120102) Lv10: 无 heal_efficacy_up（Block2 L11+ 未满足）。"""
