                             "heal_efficacy_up 应为永続 (duration=-1)")

    def test_as3_lv15_heal_efficacy_down_on_enemy_all(self):
        """AS3(120102) Lv15: enemy_all heal_efficacy_down (永続, debuff)。"""
        self._reset_allies()
