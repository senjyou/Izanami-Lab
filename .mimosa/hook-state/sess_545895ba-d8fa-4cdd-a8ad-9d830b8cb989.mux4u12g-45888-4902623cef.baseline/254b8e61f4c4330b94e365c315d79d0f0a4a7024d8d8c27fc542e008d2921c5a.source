        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 129302 連れ添い歩む傍らの友
        # attribute=2 (火?), character_type=2 (EN型), position_type=2 (后排), role_type=4 (辅助)
        # AP=2, PP=2. 默认 Lv15 以触发 L11+ 分支
        # caster 放 ALLY_CENTER_BACK，正前方为 ALLY_CENTER_FRONT（ally_fc）
        self.caster = UnitState(
            unit_id="caster", name="連れ添い歩む傍らの友", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=129302, level=15,
            element=2, character_type=2,
            max_hp=50000, current_hp=50000,
            attack=10000, defense=4000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[EX_MAID_INSTINCT, AS_KICK_OUT, AS_AID_FROM, AS_MERCY, PS_LUMINOUS],
            skill_levels={EX_MAID_INSTINCT: 15, AS_KICK_OUT: 15, AS_AID_FROM: 15,
                          AS_MERCY: 15, PS_LUMINOUS: 15},
            skill_cooldowns={},
        )

        # 3 个友方前排（caster 正前方为 ally_fc；ally_fl/ally_fr 为非邻接）
        # max_hp 不同以测试 lowest_hp_priority 比例排序
        self.ally_fl = UnitState(
            unit_id="ally_fl", name="前方左友", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999101, level=15,
            element=1, character_type=1,
            max_hp=40000, current_hp=40000,
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.ally_fc = UnitState(
            unit_id="ally_fc", name="前方中友", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999102, level=15,
            element=1, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.ally_fr = UnitState(
            unit_id="ally_fr", name="前方右友", side=Side.ALLY,
            position=Position.ALLY_RIGHT_FRONT, character_id=999103, level=15,
            element=1, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方 3 前排 + 1 后排（enemy_front_row 测试用）
        self.enemy_fl = UnitState(
            unit_id="enemy_fl", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999001, level=15,
            element=3, character_type=1,
            max_hp=999999, current_hp=999999,
            attack=1000, defense=0, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.enemy_fc = UnitState(
            unit_id="enemy_fc", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999002, level=15,
            element=3, character_type=1,
            max_hp=999999, current_hp=999999,
            attack=1000, defense=0, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.enemy_fr = UnitState(
            unit_id="enemy_fr", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999003, level=15,
            element=3, character_type=1,
            max_hp=999999, current_hp=999999,
            attack=1000, defense=0, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
