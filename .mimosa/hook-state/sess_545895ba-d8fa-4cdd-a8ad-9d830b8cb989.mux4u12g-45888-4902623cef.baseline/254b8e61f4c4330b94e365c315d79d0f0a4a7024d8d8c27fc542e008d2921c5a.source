    def test_ps_trigger_type_after_own_action(self):
        """PS(130110) trigger_type=after_own_action。"""
        cfg = self.dl.get_parsed_skill_data(PS_LUMINOUS)
        self.assertEqual(cfg['trigger_type'], "after_own_action",
                         "PS(130110) trigger_type 应为 after_own_action")

    def test_ps_triggers_after_own_action(self):
        """PS(130110) 在 caster 使用主动技能后触发。"""
        self._reset_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # caster 先用 AS1 (主动技能)
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=AS_KICK_OUT, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result.get("success"))

        # 调用 trigger_after_own_action
        actions = self.ts.trigger_after_own_action(
            self.caster, AS_KICK_OUT, result, self.bf, primary_target=None
        )
        ps_actions = [a for a in actions if a.skill_id == PS_LUMINOUS]
        self.assertGreater(len(ps_actions), 0,
                           "AS 使用后应触发 PS(130110) after_own_action")

    def test_ps_hot_on_ally_adjacent(self):
        """PS(130110) HOT 付与 ally_adjacent（caster 在 ALLY_CENTER_BACK，邻接=ally_fc）。"""
        self._reset_allies()
        self._reset_enemies()
        for u in self.bf.friend_team:
            u.buffs = []

        # 直接 execute_skill 测试 PS（PS 也作为主动技能执行）
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=PS_LUMINOUS, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result.get("success"))

        # caster 在 ALLY_CENTER_BACK，邻接：ALLY_CENTER_FRONT(ally_fc), ALLY_LEFT_BACK, ALLY_RIGHT_BACK
        # 我方只有 ally_fc 在邻接位置
        hot_fc = [b for b in self.ally_fc.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertGreaterEqual(len(hot_fc), 1,
                                "ally_fc (邻接) 应获得 HOT")
        # ally_fl/ally_fr 不在邻接位置
        hot_fl = [b for b in self.ally_fl.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hot_fl), 0,
                         "ally_fl (非邻接) 不应获得 HOT")
        hot_fr = [b for b in self.ally_fr.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hot_fr), 0,
                         "ally_fr (非邻接) 不应获得 HOT")

