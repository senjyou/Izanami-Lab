# -*- coding: utf-8 -*-
"""角色129302 連れ添い歩む傍らの友 专项E2E测试.

技能列表：
- EX:  110045 メイドの本能
    Block1: lowest_hp_priority ally_single に perfect_evasion(hit_limited=999, 1行動) +
            atk_up(atk tag%, 1行動) + add_status:poison(poison tag%, 1行動)
- AS1: 120100 キックアウト
    Block1: 敵単体EN攻撃[威力]
    Block2 L11+: lifesteal(lowest_hp_priority ally_single, cure%) + heal(max_hp×10%, lowest_hp ally)
- AS2: 120101 エイド・フロム
    Block1: lowest_hp_priority ally_single heal[威力]
- AS3: 120102 マーシーズ・エンブレイス
    Block1: ally_all heal[威力] (split_among_targets: 均等配分)
    Block2 L11+: ally_all heal_efficacy_up(cure%, 永続, stackable) + enemy_all heal_efficacy_down(debuff%, 永続, stackable)
- PS:  130110 ルミナス・ガード (after_own_action)
    Block1: ally_adjacent heal_over_time[max_hp×威力%, 2行動]
    Block2 L11+: enemy_front_row add_status:action_damage[ATK×dmg%, 1行動, EN]

覆盖维度：
1. EX perfect_evasion + atk_up + poison (lowest_hp_priority 3 effect 共用索敌)
2. AS1 EN damage + L11+ lifesteal(lowest_hp ally) + heal(max_hp×10%)
3. AS2 lowest_hp ally heal
4. AS3 split_among_targets 均摊 + L11+ heal_efficacy_up/down (永続, stackable)
5. PS after_own_action + ally_adjacent HOT + L11+ enemy_front_row action_damage
6. perfect_evasion 专项: hit_limited=999 全段回避、行動内多 hit 全回避、1行動後失效
7. split_heal 专项: 均摊计算、max_hp 上限、死亡目标不参与
8. lowest_hp_priority 专项: HP 比例排序、tiebreaker、3 处使用一致性
9. heal_efficacy_up/down 专项: 永続 stackable、多次施放叠加、影响实际治疗量
"""
import os
import sys
import unittest

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写：buff/debuff effect_type 枚举值
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value  # atk_up / atk_down
RECEIVED_HEALING = SkillEffectType.RECEIVED_HEALING.value  # heal_efficacy_up / heal_efficacy_down
EVADE = SkillEffectType.EVADE.value  # perfect_evasion
POISON = SkillEffectType.POISON.value  # poison (add_status)
HEAL_OVER_TIME = SkillEffectType.HEAL_OVER_TIME.value  # heal_over_time
ACTION_DAMAGE = SkillEffectType.ACTION_DAMAGE.value  # action_damage

# 技能 ID
EX_MAID_INSTINCT = 110045
AS_KICK_OUT = 120100
AS_AID_FROM = 120101
AS_MERCY = 120102
PS_LUMINOUS = 130110


class TestActor129302(unittest.TestCase):
    """角色129302 連れ添い歩む傍らの友 专项E2E测试。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

