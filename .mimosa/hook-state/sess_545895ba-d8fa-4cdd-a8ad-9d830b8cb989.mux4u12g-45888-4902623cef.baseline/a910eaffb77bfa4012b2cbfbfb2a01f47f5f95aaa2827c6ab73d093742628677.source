"""角色149301 天真爛漫トラブルメーカー 专项E2E测试

（負けん気mark全链 + block_auras + critical_forbidden + lifesteal + linked_mark + total_damage_le）

技能列表（5个）:
- EX: 110064 あたしをナメんなよー！（敵単体10hit攻撃[威力] + atk_down[35%, 1action]
  + 自身atk_up[10%, 1action, stackable] + 自身block_auras[1action]）
- AS1: 120142 躱せるもんならやってみろ！（敵単体7hit攻撃[威力] + 敵単体critical_forbidden[1action]）
- AS2: 120143 根性見せるぞおりゃー！！（敵単体3hit攻撃[威力] + 敵単体atk_down[atk%, 1action, stackable]）
- AS3: 120144 まだまだ終わんねぇぞッ！（敵単体1hit攻撃[威力] + 自身lifesteal[35%]）
- PS: 130144 徹底的にやってやろうじゃん！（after_as_attack + allow_ex_trigger
  ; Block1 無条件: 自身mark[負けん気, is_buff_mark, stackable, max_stacks_tag=makento_max]
    + 自身atk_up[2.5%, stackable, unremovable, linked_mark=負けん気]
  ; Block2 total_damage_le<=10: 自身remove_mark[負けん気, value=3, remove_linked=true]）

覆盖维度:
1. EX 10hit多段伤害 + atk_down + atk_up(stackable) + block_auras自身免疫
2. AS1 7hit多段伤害 + critical_forbidden敌方1action禁止暴击
3. AS2 3hit多段伤害 + atk_down(stackable)
4. AS3 1hit伤害 + lifesteal 35%按总伤害计算
5. PS after_as_attack + allow_ex_trigger（AS/EX技能后均触发）
6. mark全链专项（負けん気buff mark + linked atk_up + remove_mark联动移除）
7. block_auras专项（1action阻止所有buff/debuff、行動结束后允许）
8. critical_forbidden专项（敌方1action禁止暴击、行動结束后恢复）
9. lifesteal专项（35%总伤害转化为自身回复）
10. total_damage_le专项（总伤害<=10移除3个mark+linked atk_up / >10不移除）
11. 多hit专项（EX 10hit/AS1 7hit/AS2 3hit验证）
12. 配置校验（hit_count/target_type/stackable/linked_mark/unremovable）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# atk_up/atk_down 共用 STATUS_ATTACK 枚举
# block_auras -> BLOCK_AURAS
# critical_forbidden -> CRITICAL_FORBIDDEN
# mark -> MARK
# lifesteal -> LIFESTEAL (无单独枚举，作为独立effect_type)
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
MARK = SkillEffectType.MARK.value
BLOCK_AURAS = SkillEffectType.BLOCK_AURAS.value
CRITICAL_FORBIDDEN = SkillEffectType.CRITICAL_FORBIDDEN.value

# AuraUpdateTiming 数值
DURABLE_TARGET_MANEUVER_END = AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value   # 4: duration_type="action" 映射

MAKENTI = "負けん気"  # mark name 常量


def _make_makenti_mark(source_id="pre", idx=0):
    """生成1个「負けん気」mark BuffState (buff, stackable, 永续)。

    is_buff_mark=true → is_debuff=False → 进 buffs 列表。
    """
    return BuffState(
        buff_id=f"{source_id}_makenti_{idx}_{id(source_id)}",
        name=MAKENTI,
        effect_type=MARK,
        value=0,
        duration=-1,
        timing_type=DURABLE_TARGET_MANEUVER_END,
        source_unit_id=source_id,
        source_skill_id=0,
        is_debuff=False,
        is_stackable=True,
    )


def _make_makenti_marks(source_id="pre", count=1):
    """生成 count 个「負けん気」mark BuffState。"""
    return [_make_makenti_mark(source_id, i) for i in range(count)]


class TestActor149301(unittest.TestCase):
    """角色149301 天真天真爛漫トラブルメーカー 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 149301 天真爛漫トラブルメーカー
        # (水属性attr=2, AGI型character_type=3, 前排position_type=1, 物理攻击role_type=1)
        # AP=2, PP=2。默认 Lv10，部分测试用 Lv15 验证 Lv11+ 分支
        self.caster = UnitState(
            unit_id="caster", name="天真爛漫トラブルメーカー", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=149301, level=10,
            element=2, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110064, 120142, 120143, 120144, 130144],
            skill_levels={110064: 10, 120142: 10, 120143: 10,
                          120144: 10, 130144: 10},
            skill_cooldowns={},
        )

        # 敌方前排中央（最近敌，主目标候选）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（多目标测试用）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=7000, defense=4000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（多目标测试用）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=6500, defense=4000, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
