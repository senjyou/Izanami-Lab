    # ════════════════════════════════════════════════════════════════
    # 多hit专项
    # ════════════════════════════════════════════════════════════════

    def test_ex_multi_hit_10_hits(self):
        """EX(110064): 验证10hit配置。"""
        parsed = self.dl.get_parsed_skill_data(110064)
        effects = parsed['effect_blocks'][0]['effects']
        dmg = [e for e in effects if e['effect_type'] == 'damage'][0]
        self.assertEqual(dmg['hit_count'], 10)

    def test_as1_multi_hit_7_hits(self):
        """AS1(120142): 验证7hit配置。"""
        parsed = self.dl.get_parsed_skill_data(120142)
        effects = parsed['effect_blocks'][0]['effects']
        dmg = [e for e in effects if e['effect_type'] == 'damage'][0]
        self.assertEqual(dmg['hit_count'], 7)

    def test_as2_multi_hit_3_hits(self):
        """AS2(120143): 验证3hit配置。"""
        parsed = self.dl.get_parsed_skill_data(120143)
        effects = parsed['effect_blocks'][0]['effects']
        dmg = [e for e in effects if e['effect_type'] == 'damage'][0]
        self.assertEqual(dmg['hit_count'], 3)

    def test_as3_single_hit(self):
        """AS3(120144): 验证1hit配置。"""
        parsed = self.dl.get_parsed_skill_data(120144)
        effects = parsed['effect_blocks'][0]['effects']
        dmg = [e for e in effects if e['effect_type'] == 'damage'][0]
        self.assertEqual(dmg['hit_count'], 1)

    def test_multi_hit_ex_deals_more_damage_than_single_hit_as3(self):
        """多hit对比: EX(10hit) 总伤害 > AS3(1hit) 总伤害。"""
        self._reset_caster()
        self._reset_enemies()
        self.bf.enemy_team = [self.enemy_cf]

        # EX
        self._reset_enemy(self.enemy_cf)
        result_ex = self.ss.execute_skill(
            caster=self.caster, skill_id=110064, battlefield=self.bf, skip_cost=True
        )
        ex_dmg = result_ex.get("total_damage", 0)

        # AS3 (重置敌方)
        self._reset_enemy(self.enemy_cf)
        self.caster.skill_cooldowns = {}
        result_as3 = self.ss.execute_skill(
            caster=self.caster, skill_id=120144, battlefield=self.bf, skip_cost=True
        )
        as3_dmg = result_as3.get("total_damage", 0)

        self.assertGreater(ex_dmg, 0)
        self.assertGreater(as3_dmg, 0)
        # EX(10hit) 应明显高于 AS3(1hit) (因 hit_count 多，威力倍率相同但累加10次)
        self.assertGreater(ex_dmg, as3_dmg,
                           f"EX(10hit, dmg={ex_dmg}) 应 > AS3(1hit, dmg={as3_dmg})")

    # ════════════════════════════════════════════════════════════════
    # 集成场景
    # ════════════════════════════════════════════════════════════════

    def test_integration_as3_then_ps_mark_chain(self):
        """集成: AS3 攻击 → PS 触发 → 付与負けん気mark + linked atk_up。"""
        self._reset_caster(pp=10)
        self._reset_enemies()
        self.bf.enemy_team = [self.enemy_cf]

        # 1. 施放 AS3
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120144, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        total_dmg = result.get("total_damage", 0)
        self.assertGreater(total_dmg, 0)

        # 2. 触发 PS (after_as_attack)
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120144,
            result={"total_damage": total_dmg}, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps_actions = [a for a in actions if a.skill_id == 130144]
        self.assertGreater(len(ps_actions), 0, "AS3 后应收集到 PS")

        # 3. 内联执行 PS
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="after_as_attack"
        )

        # 4. 验证負けん気mark + linked atk_up 同时存在
        self.assertEqual(self._count_makenti(self.caster), 1, "应有1个負けん気mark")
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_ups), 1, "应有1个linked atk_up")

    def test_integration_low_damage_ps_removes_marks(self):
        """集成: 低伤害AS3 → PS Block2 移除負けん気mark + linked atk_up。"""
        self._reset_caster(pp=10)
        self._reset_enemies()
        self.bf.enemy_team = [self.enemy_cf]

        # 预先施加3个mark和3个linked atk_up
        for i in range(3):
            self.caster.buffs.append(BuffState(
                buff_id=f"pre_makenti_{i}",
                name=MAKENTI, effect_type=MARK, value=0,
                duration=-1, timing_type=DURABLE_TARGET_MANEUVER_END,
                is_debuff=False, is_stackable=True,
            ))
            self.caster.buffs.append(BuffState(
                buff_id=f"pre_atk_up_{i}",
                name="AtkUp", effect_type=STATUS_ATTACK, value=2.5,
                duration=-1, timing_type=DURABLE_TARGET_MANEUVER_END,
                is_debuff=False, is_stackable=True,
                linked_buff_id=MAKENTI,
            ))

        # 触发 PS with total_damage=5 (<=10)
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120144,
            result={"total_damage": 5}, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps_actions = [a for a in actions if a.skill_id == 130144]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="after_as_attack"
        )

        # 3 (pre) + 1 (Block1) - 3 (Block2) = 1 mark
        self.assertEqual(self._count_makenti(self.caster), 1,
                         "原有3 + Block1新加1 = 4, Block2移除3 → 剩1 mark")
        # 3 (pre) + 1 (Block1新加linked atk_up) - 3 (Block2联动移除) = 1 atk_up
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_ups), 1,
                         "原有3 + Block1新加1 = 4, Block2联动移除3 → 剩1 atk_up")

    def test_integration_ps_triggers_multiple_times_stacks_marks(self):
        """集成: 多次AS3 → 多次PS触发 → 負けん気mark 累积叠加。"""
        self._reset_caster(pp=10)
        self._reset_enemies()
        self.bf.enemy_team = [self.enemy_cf]

        for i in range(3):
            # 每次用高伤害触发 Block1 (跳过 Block2)
            actions = self.ts.trigger_after_as_attack(
                actor=self.caster, skill_id=120144,
                result={"total_damage": 50000}, battlefield=self.bf,
                primary_target=self.enemy_cf
            )
            ps_actions = [a for a in actions if a.skill_id == 130144]
            self.ss._pending_crit_triggers = []
            self.ss._execute_trigger_actions_inline(
                ps_actions, self.bf, trigger_timing="after_as_attack"
            )

        # 应累积3个負けん気mark 和3个linked atk_up
        self.assertEqual(self._count_makenti(self.caster), 3,
                         "3次PS触发应累积3个負けん気mark (stackable)")
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_ups), 3,
                         "3次PS触发应累积3个linked atk_up (stackable)")


if __name__ == '__main__':
    unittest.main(verbosity=2)
