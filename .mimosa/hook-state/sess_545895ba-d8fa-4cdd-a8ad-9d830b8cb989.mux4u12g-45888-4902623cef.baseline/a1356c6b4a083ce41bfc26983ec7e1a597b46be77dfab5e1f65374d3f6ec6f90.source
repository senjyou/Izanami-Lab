#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
技能效果导出脚本
根据技能ID导出技能的完整效果信息，以清晰的层级结构展示
"""

import sys
import sqlite3
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))
from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()

DB_PATH = "db/skill_data.db"
ARTIFACT_DIR = Path("C:/Users/ARIS/.gemini/antigravity/brain/fde5457d-f9cd-4bf2-8b09-fac6be85f68a")


def export_passive_triggers(skill_id, cursor, output):
    """导出被动技能的触发器数据"""
    # 查询被动触发器
    cursor.execute("""
        SELECT 
            pt.trigger_id,
            pt.trigger_order,
            ett.code AS timing_code,
            ett.name AS timing_name,
            pt.priority_override
        FROM passive_triggers pt
        JOIN enum_trigger_timings ett ON pt.timing_id = ett.timing_id
        WHERE pt.skill_id = ?
        ORDER BY pt.trigger_order
    """, (skill_id,))
    
    triggers = cursor.fetchall()
    
    if not triggers:
        output(f"\n⚠️ 该被动技能尚未录入触发器数据")
        return
    
    output(f"\n## 被动触发器")
    output(f"共 **{len(triggers)}** 个触发器\n")
    
    for idx, trigger in enumerate(triggers, 1):
        output(f"\n{'─' * 80}")
        output(f"### 触发器 {idx}")
        output(f"{'─' * 80}")
        
        output(f"\n#### 触发信息")
        output(f"- 触发时机: `{trigger['timing_code']}` ({trigger['timing_name']})")
        output(f"- 执行顺序: `{trigger['trigger_order']}`")
        if trigger['priority_override']:
            output(f"- 优先级覆盖: `{trigger['priority_override']}`")
        
        # 触发条件
        cursor.execute("""
            SELECT 
                tc.condition_order,
                ect.code AS condition_type,
                ect.name AS condition_name,
                eo.code AS operator,
                tc.value_numeric,
                tc.value_text
            FROM trigger_conditions tc
            JOIN enum_condition_types ect ON tc.condition_type_id = ect.condition_type_id
            LEFT JOIN enum_operators eo ON tc.operator_id = eo.operator_id
            WHERE tc.trigger_id = ?
            ORDER BY tc.condition_order
        """, (trigger['trigger_id'],))
        
        conditions = cursor.fetchall()
        
        if conditions:
            output(f"\n#### 触发条件")
            for cond in conditions:
                cond_str = f"- {cond['condition_name']} ({cond['condition_type']})"
                if cond['operator']:
                    cond_str += f" {cond['operator']}"
                if cond['value_numeric'] is not None:
                    cond_str += f" {cond['value_numeric']}"
                if cond['value_text']:
                    cond_str += f" {cond['value_text']}"
                output(cond_str)
        
        # 动作组
        cursor.execute("""
            SELECT 
                tag.action_group_id,
                tag.execution_order,
                ett.code AS target_type,
                etr.code AS target_range,
                etp.code AS target_priority,
                esp.code AS special_priority
            FROM trigger_action_groups tag
            LEFT JOIN enum_target_types ett ON tag.target_type = ett.target_type_id
            LEFT JOIN enum_target_ranges etr ON tag.target_range = etr.target_range_id
            LEFT JOIN enum_target_priorities etp ON tag.target_priority = etp.priority_id
            LEFT JOIN enum_special_priorities esp ON tag.special_priority = esp.special_priority_id
            WHERE tag.trigger_id = ?
            ORDER BY tag.execution_order
        """, (trigger['trigger_id'],))
        
        action_groups = cursor.fetchall()
        
        output(f"\n#### 动作组 ({len(action_groups)}个)")
        
        for ag_idx, action_group in enumerate(action_groups, 1):
            output(f"\n##### 动作组 {idx}.{ag_idx}")
            output(f"- 执行顺序: `{action_group['execution_order']}`")
            output(f"- 目标类型: `{action_group['target_type'] or 'N/A'}`")
            output(f"- 目标范围: `{action_group['target_range'] or 'N/A'}`")
            if action_group['target_priority']:
                output(f"- 目标优先级: `{action_group['target_priority']}`")
            if action_group['special_priority']:
                output(f"- 特殊优先级: `{action_group['special_priority']}`")
            
            # 效果列表
            cursor.execute("""
                SELECT 
                    te.effect_id,
                    te.effect_order,
                    eet.code AS effect_type,
                    eet.name AS effect_name
                FROM trigger_effects te
                JOIN enum_effect_types eet ON te.effect_type_id = eet.effect_type_id
                WHERE te.action_group_id = ?
                ORDER BY te.effect_order
            """, (action_group['action_group_id'],))
            
            effects = cursor.fetchall()
            
            output(f"\n**效果列表** ({len(effects)}个):")
            
            for e_idx, effect in enumerate(effects, 1):
                output(f"\n###### 效果 {idx}.{ag_idx}.{e_idx}: {effect['effect_type']}")
                output(f"- 类型名称: {effect['effect_name']}")
                output(f"- 执行顺序: {effect['effect_order']}")
                
                # 数值参数
                cursor.execute("""
                    SELECT param_key, param_value, param_tag
                    FROM trigger_effect_numeric_params
                    WHERE effect_id = ?
                    ORDER BY param_key
                """, (effect['effect_id'],))
                numeric_params = cursor.fetchall()
                
                if numeric_params:
                    output(f"\n*数值参数*:")
                    for param in numeric_params:
                        if param['param_tag']:
                            output(f"- `{param['param_key']}`: Tag[{param['param_tag']}]")
                        else:
                            output(f"- `{param['param_key']}`: {param['param_value']}")
                
                # 文本参数
                cursor.execute("""
                    SELECT param_key, param_value
                    FROM trigger_effect_text_params
                    WHERE effect_id = ?
                    ORDER BY param_key
                """, (effect['effect_id'],))
                text_params = cursor.fetchall()
                
                if text_params:
                    output(f"\n*文本参数*:")
                    for param in text_params:
                        output(f"- `{param['param_key']}`: {param['param_value']}")
                
                # 标志参数
                cursor.execute("""
                    SELECT flag_key, flag_value
                    FROM trigger_effect_flag_params
                    WHERE effect_id = ?
                    ORDER BY flag_key
                """, (effect['effect_id'],))
                flag_params = cursor.fetchall()
                
                if flag_params:
                    output(f"\n*标志参数*:")
                    for param in flag_params:
                        output(f"- `{param['flag_key']}`: {bool(param['flag_value'])}")
                
                # 持续时间参数
                cursor.execute("""
                    SELECT 
                        tedp.duration,
                        tedp.duration_tag,
                        edu.code AS duration_unit,
                        tedp.trigger_count,
                        tedp.trigger_count_tag
                    FROM trigger_effect_duration_params tedp
                    LEFT JOIN enum_duration_units edu ON tedp.duration_unit_id = edu.unit_id
                    WHERE tedp.effect_id = ?
                """, (effect['effect_id'],))
                duration_param = cursor.fetchone()
                
                if duration_param:
                    output(f"\n*持续时间*:")
                    if duration_param['duration'] is not None or duration_param['duration_tag']:
                        dur_str = duration_param['duration_tag'] if duration_param['duration_tag'] else str(duration_param['duration'])
                        unit_str = duration_param['duration_unit'] or 'TURN'
                        output(f"- 持续: {dur_str} ({unit_str})")
                    if duration_param['trigger_count'] is not None or duration_param['trigger_count_tag']:
                        trig_str = duration_param['trigger_count_tag'] if duration_param['trigger_count_tag'] else str(duration_param['trigger_count'])
                        output(f"- 触发次数: {trig_str}")



def export_skill_effects(skill_id, output_file=None):
    """导出指定技能的完整效果信息"""
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    cursor = conn.cursor()
    
    # 收集所有输出内容
    output_lines = []
    
    def output(text):
        """统一输出函数"""
        output_lines.append(text)
        if not output_file:
            safe_print(text)
    
    # ========================================================================
    # 1. 基础信息
    # ========================================================================
    output("=" * 80)
    output(f"# 技能 {skill_id}")
    output("=" * 80)
    
    cursor.execute("""
        SELECT 
            s.skill_id,
            s.name,
            est.code AS skill_type,
            s.cost_ap,
            s.cost_pp,
            s.cost_ep
        FROM skills s
        LEFT JOIN enum_skill_types est ON s.skill_type_id = est.skill_type_id
        WHERE s.skill_id = ?
    """, (skill_id,))
    
    skill = cursor.fetchone()
    if not skill:
        output(f"❌ 技能{skill_id}不存在")
        conn.close()
        return
    
    output(f"\n## 基础信息")
    output(f"- **名称**: {skill['name']}")
    output(f"- **类型**: {skill['skill_type']}")
    if skill['skill_type'] == 'AS':
        output(f"- **消耗**: AP={skill['cost_ap'] or 0}")
    elif skill['skill_type'] == 'PS':
        output(f"- **消耗**: PP={skill['cost_pp'] or 0}")
    elif skill['skill_type'] == 'EX':
        output(f"- **消耗**: EP={skill['cost_ep'] or 0}")
    
    # ========================================================================
    # 2. 效果组列表
    # ========================================================================
    cursor.execute("""
        SELECT 
            seg.group_id,
            seg.group_identifier,
            seg.execution_order,
            seg.active_level_min,
            seg.active_level_max,
            ett.code AS target_type,
            etr.code AS target_range,
            etp.code AS target_priority,
            esp.code AS special_priority
        FROM skill_effect_groups seg
        LEFT JOIN enum_target_types ett ON seg.target_type = ett.target_type_id
        LEFT JOIN enum_target_ranges etr ON seg.target_range = etr.target_range_id
        LEFT JOIN enum_target_priorities etp ON seg.target_priority = etp.priority_id
        LEFT JOIN enum_special_priorities esp ON seg.special_priority = esp.special_priority_id
        WHERE seg.skill_id = ?
        ORDER BY seg.execution_order
    """, (skill_id,))
    
    effect_groups = cursor.fetchall()
    
    # 如果是被动技能（PS），检查被动触发器
    if skill['skill_type'] == 'PS':
        if not effect_groups:
            # 导出被动技能触发器
            export_passive_triggers(skill_id, cursor, output)
        conn.close()
        if output_file:
            output_file.write_text('\n'.join(output_lines), encoding='utf-8')
            safe_print(f"✅ 已导出到: {output_file}")
        return
    
    # 主动技能（AS/EX）如果没有效果组则报错
    if not effect_groups:
        output(f"\n⚠️ 该技能尚未录入效果数据")
        conn.close()
        if output_file:
            output_file.write_text('\n'.join(output_lines), encoding='utf-8')
        return
    
    output(f"\n## 效果组总览")
    output(f"共 **{len(effect_groups)}** 个效果组\n")
    
    # ========================================================================
    # 3. 遍历每个效果组
    # ========================================================================
    for idx, group in enumerate(effect_groups, 1):
        output(f"\n{'─' * 80}")
        output(f"### 效果组 {idx}: {group['group_identifier']}")
        output(f"{'─' * 80}")
        
        # 效果组基本信息
        output(f"\n#### 效果组信息")
        output(f"- 执行顺序: `{group['execution_order']}`")
        output(f"- 生效等级: `Lv{group['active_level_min']}-{group['active_level_max']}`")
        
        # 目标选择
        output(f"\n#### 目标选择")
        output(f"- 目标类型: `{group['target_type'] or 'N/A'}`")
        output(f"- 目标范围: `{group['target_range'] or 'N/A'}`")
        output(f"- 目标优先级: `{group['target_priority'] or 'N/A'}`")
        if group['special_priority']:
            output(f"- 特殊优先级: `{group['special_priority']}`")
        
        # 效果列表
        cursor.execute("""
            SELECT 
                se.effect_id,
                se.effect_order,
                eet.code AS effect_type,
                eet.name AS effect_name,
                se.is_temporary
            FROM skill_effects se
            JOIN enum_effect_types eet ON se.effect_type_id = eet.effect_type_id
            WHERE se.group_id = ?
            ORDER BY se.effect_order
        """, (group['group_id'],))
        
        effects = cursor.fetchall()
        
        output(f"\n#### 效果列表 ({len(effects)}个)\n")
        
        for e_idx, effect in enumerate(effects, 1):
            output(f"\n##### 效果 {idx}.{e_idx}: {effect['effect_type']}")
            output(f"- **类型名称**: {effect['effect_name']}")
            output(f"- **执行顺序**: {effect['effect_order']}")
            output(f"- **临时效果**: {'是' if effect['is_temporary'] else '否'}")
            
            # 参数
            output(f"\n**参数**:")
            
            # 数值参数
            cursor.execute("""
                SELECT param_key, param_value, param_tag
                FROM effect_numeric_params
                WHERE effect_id = ?
                ORDER BY param_key
            """, (effect['effect_id'],))
            numeric_params = cursor.fetchall()
            
            if numeric_params:
                output(f"\n*数值参数*:")
                for param in numeric_params:
                    if param['param_tag']:
                        output(f"- `{param['param_key']}`: Tag[{param['param_tag']}]")
                    else:
                        output(f"- `{param['param_key']}`: {param['param_value']}")
            
            # 持续时间参数
            cursor.execute("""
                SELECT 
                    edp.duration, 
                    edp.duration_tag,
                    edp.trigger_count,
                    edp.trigger_count_tag
                FROM effect_duration_params edp
                WHERE edp.effect_id = ?
            """, (effect['effect_id'],))
            duration_param = cursor.fetchone()
            
            if duration_param:
                output(f"\n*持续时间*:")
                if duration_param['duration'] is not None:
                    output(f"- 持续: {duration_param['duration']}")
                elif duration_param['duration_tag']:
                    output(f"- 持续: Tag[{duration_param['duration_tag']}]")
                if duration_param['trigger_count'] is not None:
                    output(f"- 触发次数: {duration_param['trigger_count']}")
                elif duration_param['trigger_count_tag']:
                    output(f"- 触发次数: Tag[{duration_param['trigger_count_tag']}]")
            
            # 标志参数
            cursor.execute("""
                SELECT flag_key, flag_value
                FROM effect_flag_params
                WHERE effect_id = ?
                ORDER BY flag_key
            """, (effect['effect_id'],))
            flag_params = cursor.fetchall()
            
            if flag_params:
                output(f"\n*标志参数*:")
                for param in flag_params:
                    output(f"- `{param['flag_key']}`: {bool(param['flag_value'])}")
            
            # 文本参数
            cursor.execute("""
                SELECT param_key, param_value
                FROM effect_text_params
                WHERE effect_id = ?
                ORDER BY param_key
            """, (effect['effect_id'],))
            text_params = cursor.fetchall()
            
            if text_params:
                output(f"\n*文本参数*:")
                for param in text_params:
                    output(f"- `{param['param_key']}`: {param['param_value']}")
    
    output(f"\n{'=' * 80}")
    output(f"导出完成")
    output(f"{'=' * 80}\n")
    
    conn.close()
    
    # 写入文件
    if output_file:
        output_file.write_text('\n'.join(output_lines), encoding='utf-8')
        safe_print(f"✅ 已导出到: {output_file}")


def main():
    if len(sys.argv) < 2:
        safe_print("使用方法: python export_skill_effects.py <skill_id> [output_file]")
        safe_print("示例: python export_skill_effects.py 110030")
        safe_print("    python export_skill_effects.py 110030 output.md")
        sys.exit(1)
    
    try:
        skill_id = int(sys.argv[1])
        output_file = None
        if len(sys.argv) > 2:
            output_file = Path(sys.argv[2])
        else:
            # 默认输出到artifact目录
            output_file = ARTIFACT_DIR / f"skill_{skill_id}_export.md"
        
        export_skill_effects(skill_id, output_file)
    except ValueError:
        safe_print("❌ 错误: 技能ID必须是数字")
        sys.exit(1)
    except Exception as e:
        safe_print(f"❌ 错误: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()
