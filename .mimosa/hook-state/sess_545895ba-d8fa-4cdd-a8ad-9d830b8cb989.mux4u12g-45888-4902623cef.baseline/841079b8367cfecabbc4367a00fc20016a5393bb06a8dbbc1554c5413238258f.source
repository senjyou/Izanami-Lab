# -*- coding: utf-8 -*-
"""角色100303【隣歩む想い】桃園める 技能E2E测试

技能配置见 docs/100303_skill_implementation.md
核心机制：可叠加mark「真心」（前列=受療+10%/被ダメ-2.5%每层；後列=会心ダメ+6.25%/与ダメ+10%每层）
"""
import pytest
from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position
from src.entities_v2.unit_state import BuffState

SHINJIN_MARK_BONUS = [
    {"mark_name": "真心", "stat": "heal_efficacy", "per_mark_pct": 10, "row": "front"},
    {"mark_name": "真心", "stat": "taken_damage", "per_mark_pct": 2.5, "row": "front"},
    {"mark_name": "真心", "stat": "crit_damage", "per_mark_pct": 6.25, "row": "back"},
    {"mark_name": "真心", "stat": "dealt_damage", "per_mark_pct": 10, "row": "back"},
]


def _add_shinjin_mark(unit, stack=1):
    """直接给单位添加带mark_stat_bonus的「真心」mark（模拟技能付与后的状态）。

    引擎真实流转中mark的effect_type为枚举值"Mark"（_JSON_EFFECT_TO_ENUM['mark']为None
    但_apply_aura路径写入SkillEffectType.MARK.value），这里与真实行为保持一致。
    """
    for _ in range(stack):
        unit.buffs.append(BuffState(
            buff_id=f"shinjin_test_{id(unit)}_{len(unit.buffs)}",
            name="真心",
            effect_type="Mark",
            value=1,
            duration=-1,
            timing_type=2,
            is_stackable=True,
            mark_stat_bonus=SHINJIN_MARK_BONUS,
        ))


def _setup(level=10, skill_list=None):
    bb = BattleBuilder()
    bb.add_ally(unit_id=100303, level=level,
                skills=skill_list or [110084, 120180, 120181, 130186, 130187],
                position=Position.ALLY_CENTER_BACK, element=3, character_type=2)
    bb.add_ally(unit_id="allyA", level=level, position=Position.ALLY_LEFT_FRONT)
    bb.add_ally(unit_id="allyB", level=level, position=Position.ALLY_RIGHT_BACK)
    bb.add_enemy(unit_id="enemyA", level=level, hp=60000, position=Position.ENEMY_LEFT_FRONT)
    bb.add_enemy(unit_id="enemyB", level=level, hp=60000, position=Position.ENEMY_CENTER_FRONT)
    ctx = bb.build()
    bf, ss, ts = ctx['bf'], ctx['ss'], ctx['ts']
    c303 = next(u for u in bf.friend_team if u.unit_id == 100303)
    ally_a = next(u for u in bf.friend_team if u.unit_id == "allyA")
    ally_b = next(u for u in bf.friend_team if u.unit_id == "allyB")
    e1 = next(u for u in bf.enemy_team if u.unit_id == "enemyA")
    return bf, ss, ts, c303, ally_a, ally_b, e1


# ================================================================
# EX 110084 大好きをこめて
# ================================================================

class Test110084EX:
    def test_ex_hits_lowest_hp_enemy(self):
        """EX: 伤害命中残りHP最少的敌方（EN攻击）"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        c303.current_ep = c303.max_extra_point
        e_low = next(u for u in bf.enemy_team if u.unit_id == "enemyB")
        e_low.current_hp = 10000  # 残りHP最少
        hp_before = e_low.current_hp
        r = ss.execute_skill(c303, 110084, bf)
        assert r['success']
        dmg_effects = [t for t in r['effects_applied'] if t.get('effect_type') == 'damage']
        assert dmg_effects, "EX应造成伤害"
        hit_targets = []
        for d in dmg_effects:
            hit_targets += [t['target'] for t in d.get('targets', [])]
        assert hit_targets and all(t == "enemyB" for t in hit_targets), \
            f"应只打残HP最少的enemyB: {hit_targets}"

    def test_ex_shield_from_damage_to_lowest_hp_ally(self):
        """EX: 最低HP味方获得 与えたダメージの125% シールド"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        c303.current_ep = c303.max_extra_point
        ally_a.current_hp = int(ally_a.max_hp * 0.3)  # 最低HP味方
        dmg_record = {}
        orig_calc = ss.damage_service.calculate_damage
        r = ss.execute_skill(c303, 110084, bf)
        assert r['success']
        assert ally_a.shield > 0, "最低HP味方应获得shield_from_damage"
        # 验证盾值 = 实际伤害 × 1.25（允许取整误差）
        total_dealt = sum(t.get('actual_damage', t.get('damage', 0))
                          for t in r['effects_applied'] if t.get('effect_type') == 'damage'
                          for t in t.get('targets', []))
        expected = int(total_dealt * 1.25)
        assert abs(ally_a.shield - expected) <= max(2, expected * 0.01), \
            f"shield={ally_a.shield}, expected≈{expected} (dealt={total_dealt})"

    def test_ex_sub_unit_wishing_star_to_allies_except_self(self):
        """EX: 自身を除く味方全体に「願い星」(HP=与えたダメージの125%)"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        c303.current_ep = c303.max_extra_point
        r = ss.execute_skill(c303, 110084, bf)
        assert r['success']
        total_dealt = sum(t.get('actual_damage', t.get('damage', 0))
                          for t in r['effects_applied'] if t.get('effect_type') == 'damage'
                          for t in t.get('targets', []))
        expected_hp = max(1, int(total_dealt * 1.25))
        for ally in (ally_a, ally_b):
            subs = [b for b in ally.buffs if b.effect_type == 'SubUnit' and b.name == '願い星']
            assert subs, f"{ally.unit_id} 应获得願い星"
            assert subs[0].sub_unit_max_hp == expected_hp, \
                f"願い星HP={subs[0].sub_unit_max_hp}, expected={expected_hp}"
        self_subs = [b for b in c303.buffs if b.effect_type == 'SubUnit' and b.name == '願い星']
        assert not self_subs, "自身不应获得願い星"

    def test_ex_grants_shinjin_mark_to_self(self):
        """EX: 自身に「真心」を1つ付与（永续、可叠加）"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        c303.current_ep = c303.max_extra_point
        ss.execute_skill(c303, 110084, bf)
        marks = [b for b in c303.buffs + c303.debuffs
                 if b.effect_type == 'Mark' and b.name == '真心']
        assert len(marks) == 1, f"首次EX后自身应有1枚真心, got {len(marks)}"
        # 二次释放叠加
        c303.current_ep = c303.max_extra_point
        ss.execute_skill(c303, 110084, bf)
        marks = [b for b in c303.buffs + c303.debuffs
                 if b.effect_type == 'Mark' and b.name == '真心']
        assert len(marks) == 2, f"二次EX后真心应叠加到2, got {len(marks)}"


# ================================================================
# AS1 120180 大切な仲間のために
# ================================================================

class Test120180AS:
    def test_global_condition_blocks_when_no_ally_below_50(self):
        """HP50%未満の味方がいない場合、発動しない"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        for u in bf.friend_team:
            u.current_hp = u.max_hp
        r = ss.execute_skill(c303, 120180, bf)
        assert not r.get('success'), "全员HP>=50%时应不发动"

    def test_shield_to_lowest_hp_ally_scales_caster_atk(self):
        """最低HP味方に ATK×shield%(Lv10=100%) の盾、自身1回行動終了まで(caster timing)"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        ally_a.current_hp = int(ally_a.max_hp * 0.3)  # 最低HP
        atk = ss.damage_service._calculate_final_stat(c303, "attack")
        r = ss.execute_skill(c303, 120180, bf)
        assert r['success']
        assert ally_a.shield >= int(atk * 1.0) - 1, \
            f"盾值={ally_a.shield}, expected≈ATK×100%={int(atk * 1.0)}"
        shield_buffs = [b for b in ally_a.buffs if b.effect_type == 'shield' or b.shield_amount]
        assert shield_buffs
        from src.entities_v2.enums import AuraUpdateTiming
        assert shield_buffs[0].timing_type == AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value, \
            "盾应随施法者行动结束递减(duration_owner=caster)"

    def test_lv11_ep_plus1_when_target_has_shinjin(self):
        """Lv11+: 対象が「真心」状態の場合、EXゲージを1加算"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup(level=11)
        ally_a.current_hp = int(ally_a.max_hp * 0.3)
        _add_shinjin_mark(ally_a)
        ally_a.current_ep = 2  # 避免满EP上限截断
        ep_before = ally_a.current_ep
        r = ss.execute_skill(c303, 120180, bf)
        assert r['success']
        assert ally_a.current_ep == ep_before + 1, \
            f"真心状态目标应+1 EP: {ep_before} -> {ally_a.current_ep}"

    def test_lv11_no_ep_when_target_lacks_shinjin(self):
        """Lv11+: 対象が「真心」非保持なら EP不增加"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup(level=11)
        ally_a.current_hp = int(ally_a.max_hp * 0.3)
        ep_before = ally_a.current_ep
        r = ss.execute_skill(c303, 120180, bf)
        assert r['success']
        assert ally_a.current_ep == ep_before, "无真心时不应加EP"


# ================================================================
# AS2 120181 献身的な愛
# ================================================================

class Test120181AS:
    def test_self_atk_down_and_shinjin_to_highest_damage_dealt(self):
        """自身ATK低下 + 自身以外優先で累計与ダメージ最大味方に真心"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        ally_a.damage_dealt_total = 10000
        ally_b.damage_dealt_total = 30000
        c303.damage_dealt_total = 999999  # 自身最高でも優先対象外
        r = ss.execute_skill(c303, 120181, bf)
        assert r['success']
        # 自身 atk_down
        downs = [d for d in c303.debuffs if d.effect_type == 'StatusAttack']
        assert downs, "自身应有ATK低下debuff"
        # 真心给allyB（累计与ダメージ最高）
        marks_b = [b for b in ally_b.buffs + ally_b.debuffs
                   if b.effect_type == 'Mark' and b.name == '真心']
        marks_a = [b for b in ally_a.buffs + ally_a.debuffs
                   if b.effect_type == 'Mark' and b.name == '真心']
        assert len(marks_b) == 1 and not marks_a, \
            f"真心应给累计与ダメージ最高的allyB (A={len(marks_a)}, B={len(marks_b)})"

    def test_real_battle_flow_target_follows_actual_damage(self):
        """真实战斗流程：めるEX后自身为全场最高输出→
        AS2的真心/回避/必中应全部落在『其他』友方中累计与ダメージ最高者身上
        （める的damage_dealt_total由execute_skill真实伤害路径更新，非手工赋值）"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup(level=15)
        ally_a.damage_dealt_total = 2000
        ally_b.damage_dealt_total = 1500
        c303.current_ep = c303.max_extra_point
        ss.execute_skill(c303, 110084, bf)  # めるEX→damage_dealt_total经主伤害路径真实累加
        assert c303.damage_dealt_total > ally_a.damage_dealt_total > 0, "前置：める应为全场最高输出"
        # 前置EX已给める自身1枚真心（EX效果），记录AS2前各友方真心数
        def _mark_count(u):
            return len([b for b in u.buffs + u.debuffs
                        if b.effect_type == 'Mark' and b.name == '真心'])
        c303_marks_before = _mark_count(c303)
        r = ss.execute_skill(c303, 120181, bf)
        assert r['success']
        # 真心应新增在allyA（其他友方中最高）身上；める自身mark数不变（自身以外を優先）
        assert _mark_count(ally_a) == 1, f"真心应落在allyA: got {_mark_count(ally_a)}"
        assert _mark_count(ally_b) == 0, "allyB不应获得真心"
        assert _mark_count(c303) == c303_marks_before, \
            "める为全场最高输出时也不应给自身付与真心（自身以外を優先）"
        # Lv15: A为前排→回避buff与真心同目标；める不应获得回避/必中
        assert any(b.effect_type == 'Evade' for b in ally_a.buffs), \
            "回避buff应与真心同目标(allyA)"
        assert not any(b.effect_type == 'Evade' for b in c303.buffs), "める自身不应获得回避"
        assert not any(b.effect_type == 'SureHit' for b in c303.buffs), "める自身不应获得必中"

    def test_lv15_front_row_target_gets_evade_2hits(self):
        """Lv15: 対象前列 → 2ヒットまで50%回避バフ(1行動)"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup(level=15)
        ally_a.damage_dealt_total = 30000  # 前排
        ally_b.damage_dealt_total = 0
        r = ss.execute_skill(c303, 120181, bf)
        assert r['success']
        evades = [b for b in ally_a.buffs if b.effect_type == 'Evade']
        assert evades, "前排目标应获得回避buff"
        assert evades[0].hit_limited == 2, f"Lv15回避应2ヒット: {evades[0].hit_limited}"
        assert evades[0].value == 50.0, f"回避率应为50%: {evades[0].value}"

    def test_lv15_back_row_target_gets_sure_hit_2hits(self):
        """Lv15: 対象後列 → 2ヒット必中バフ(1行動)"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup(level=15)
        ally_b.damage_dealt_total = 30000  # 后排
        r = ss.execute_skill(c303, 120181, bf)
        assert r['success']
        sure_hits = [b for b in ally_b.buffs if b.effect_type == 'SureHit']
        assert sure_hits, "后排目标应获得必中buff"
        assert sure_hits[0].hit_limited == 2, f"Lv15必中应2ヒット: {sure_hits[0].hit_limited}"
        evades = [b for b in ally_b.buffs if b.effect_type == 'Evade']
        assert not evades, "后排目标不应获得回避buff"

    def test_lv10_no_evade_no_sure_hit(self):
        """Lv1-10: 无回避/必中buff"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup(level=10)
        ally_a.damage_dealt_total = 30000
        r = ss.execute_skill(c303, 120181, bf)
        assert r['success']
        assert not [b for b in ally_a.buffs if b.effect_type == 'Evade']
        assert not [b for b in ally_a.buffs if b.effect_type == 'SureHit']


# ================================================================
# 「真心」mark_stat_bonus（row条件 + heal_efficacy/taken_damage新stat）
# ================================================================

class TestShinjinMarkBonus:
    def _mk_unit(self, front=True):
        bb = BattleBuilder()
        pos = Position.ALLY_LEFT_FRONT if front else Position.ALLY_LEFT_BACK
        bb.add_ally(unit_id="holder", position=pos)
        return bb.build(), pos

    def test_front_row_heal_efficacy_and_taken_damage(self):
        """前列: 每枚真心 受療+10% / 被ダメ-2.5%"""
        ctx, _ = self._mk_unit(front=True)
        dms = ctx['dms']
        holder = ctx['allies'][0]
        _add_shinjin_mark(holder, stack=2)
        # 受療乘区: 1 + 0.10×2
        heal_mult = dms._get_heal_received_multiplier(holder)
        assert abs(heal_mult - 1.20) < 1e-6, f"前排2枚真心受療={heal_mult}, expected 1.20"
        # 被ダメ乘区: net += 0.025×2 → result = 1 - 0.05 = 0.95（正=减伤）
        rcvd_mult = dms._get_damage_received_multiplier(holder)
        assert abs(rcvd_mult - 0.95) < 1e-6, f"前排2枚真心被ダメ={rcvd_mult}, expected 0.95"

    def test_back_row_crit_damage_and_dealt_damage(self):
        """後列: 每枚真心 会心ダメ+6.25% / 与ダメ+10%"""
        ctx, _ = self._mk_unit(front=False)
        dms = ctx['dms']
        holder = ctx['allies'][0]
        _add_shinjin_mark(holder, stack=2)
        crit_bonus = dms._get_crit_damage_bonus(holder)
        assert abs(crit_bonus - 0.625) < 1e-6, f"後列2枚真心会心={crit_bonus}, expected 0.5+0.125=0.625"
        dealt_mult = dms._get_damage_dealt_multiplier(holder)
        assert abs(dealt_mult - 1.20) < 1e-6, f"後列2枚真心与ダメ={dealt_mult}, expected 1.20"

    def test_front_row_gets_no_back_row_bonus(self):
        """row条件互斥：前排不获得後列加成，反之亦然"""
        ctx, _ = self._mk_unit(front=True)
        dms = ctx['dms']
        holder = ctx['allies'][0]
        _add_shinjin_mark(holder, stack=2)
        crit_bonus = dms._get_crit_damage_bonus(holder)
        assert abs(crit_bonus - 0.5) < 1e-9, f"前排不应获得会心加成(仅基础0.5): {crit_bonus}"


# ================================================================
# PS1 130186 心から尽くして
# ================================================================

class Test130186PS:
    def _trigger(self, bf, ss, ts, c303, attacker, e1):
        c303.current_pp = 4
        actions = ts.trigger_after_ally_as_attack(attacker, 120024, [e1], bf, primary_target=e1)
        for act in actions:
            act.parameters.setdefault('trigger_attacker', attacker)
            act.parameters.setdefault('primary_target', e1)
            act.parameters.setdefault('targets', [e1])
            ss._execute_trigger_actions_inline([act], bf, trigger_timing='AFTER_ALLY_AS_ATTACK')
        return actions

    def test_ps1_grants_shinjin_2actions_and_atk_up(self):
        """攻撃した味方に2行動の真心 + ATK+{atk}%(1行動)"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        c303.current_pp = 4
        pp_before = c303.current_pp
        actions = self._trigger(bf, ss, ts, c303, ally_a, e1)
        assert actions, "PS1应触发"
        marks = [b for b in ally_a.buffs + ally_a.debuffs
                 if b.effect_type == 'Mark' and b.name == '真心']
        assert len(marks) == 1, f"攻击者应获得1枚真心: {len(marks)}"
        assert marks[0].duration == 2, f"PS1真心应2行動: {marks[0].duration}"
        ups = [b for b in ally_a.buffs if b.effect_type == 'atk_up' or b.effect_type == 'StatusAttack']
        assert ups, "攻击者应获得ATK上昇buff"
        assert c303.current_pp == pp_before - 1, f"PS消耗1PP: {pp_before}->{c303.current_pp}"

    def test_ps1_ep_plus1_when_actor_shy(self):
        """攻撃者がシャイ(風3)属性 → EX+1"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        ally_a.element = 3
        ally_a.current_ep = 2  # 避免满EP上限截断
        ep_before = ally_a.current_ep
        self._trigger(bf, ss, ts, c303, ally_a, e1)
        assert ally_a.current_ep == ep_before + 1, \
            f"シャイ属性攻击者应+1 EP: {ep_before}->{ally_a.current_ep}"

    def test_ps1_no_ep_when_actor_not_shy(self):
        """攻撃者が非シャイ属性 → EP不增加"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        ally_a.element = 2  # 水/スマート
        ally_a.current_ep = 2
        ep_before = ally_a.current_ep
        self._trigger(bf, ss, ts, c303, ally_a, e1)
        assert ally_a.current_ep == ep_before, "非シャイ攻击者不应+EP"


# ================================================================
# PS2 130187 募る想い
# ================================================================

class Test130187PS:
    def _trigger(self, bf, ss, ts, c303):
        c303.current_pp = 4
        actions = ts.trigger_turn_start(bf)
        mine = [a for a in actions if a.owner_id == c303.unit_id]
        for act in mine:
            ss._execute_trigger_actions_inline([act], bf, trigger_timing='TURN_START')
        return mine

    def test_ps2_ep_to_highest_atk_ally(self):
        """ターン開始時: 最も攻撃力の高い味方のEX+1"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        ally_a.attack = 50000  # 最高ATK
        ally_b.attack = 8000
        c303.attack = 9000
        ally_a.current_ep = 2  # 避免满EP上限截断
        ep_before = ally_a.current_ep
        mine = self._trigger(bf, ss, ts, c303)
        assert mine, "PS2应触发"
        assert ally_a.current_ep == ep_before + 1, \
            f"最高ATK味方应+1 EP: {ep_before}->{ally_a.current_ep}"

    def test_ps2_grants_shinjin_when_target_lacks_it(self):
        """対象が真心なし → 真心1付与（无盾）"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        ally_a.attack = 50000
        shield_before = ally_a.shield
        self._trigger(bf, ss, ts, c303)
        marks = [b for b in ally_a.buffs + ally_a.debuffs
                 if b.effect_type == 'Mark' and b.name == '真心']
        assert len(marks) == 1, f"无真心时应付与1枚真心: {len(marks)}"
        assert ally_a.shield == shield_before, "无真心时不应付与盾"

    def test_ps2_grants_shield_when_target_has_shinjin(self):
        """対象が真心あり → ATK×shield%(Lv10=75%)の盾（不再付与真心）"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        ally_a.attack = 50000
        _add_shinjin_mark(ally_a)
        marks_before = len([b for b in ally_a.buffs + ally_a.debuffs
                            if b.effect_type == 'Mark' and b.name == '真心'])
        shield_before = ally_a.shield
        atk = ss.damage_service._calculate_final_stat(c303, "attack")  # 盾基数=施法者ATK
        self._trigger(bf, ss, ts, c303)
        marks_after = len([b for b in ally_a.buffs + ally_a.debuffs
                           if b.effect_type == 'Mark' and b.name == '真心'])
        assert marks_after == marks_before, "已有真心时不应重复付与mark"
        expected = int(atk * 0.75)
        assert ally_a.shield - shield_before == expected, \
            f"盾值增量={ally_a.shield - shield_before}, expected=ATK×75%={expected}"

    def test_ps2_mutually_exclusive(self):
        """互斥性：当次无真心→只付与真心；付与的mark不会泄漏到同次盾判定"""
        bf, ss, ts, c303, ally_a, ally_b, e1 = _setup()
        ally_a.attack = 50000
        shield_before = ally_a.shield
        self._trigger(bf, ss, ts, c303)
        marks = [b for b in ally_a.buffs + ally_a.debuffs
                 if b.effect_type == 'Mark' and b.name == '真心']
        assert len(marks) == 1
        assert ally_a.shield == shield_before, "同次触发不应既付与真心又付与盾"
