        self.assertEqual(len(dmg_buffs), 0, "Lv10 should NOT apply dmg_dealt_up")

    def test_ps_buff_consumed_after_as_skill(self):
        """PS buff: AS実行後に消費される(attack_limited=1, PS無傷害→消費スキップ→AS終了時消費)."""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_SHO, PS_OMIKUJI],
                            skill_levels={AS_SHO: 10, PS_OMIKUJI: 10},
                            hp=100000, pp=4)
        enemy = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        bf = _make_bf(caster, enemy)
        ss, ts = self._make_services(bf)

        # Step 1: PS実行(大吉選択) → penetrate_defense buff付与
        ss.set_branch_override(lambda ctx: 1)
        ss.execute_skill(caster=caster, skill_id=PS_OMIKUJI, battlefield=bf, skip_cost=True)

        pen_buffs = [b for b in caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 1, "PS should apply penetrate_defense buff")

        # Step 2: PS実行後もbuff残存(PS無傷害のためattack_limited消費スキップ)
        pen_buffs = [b for b in caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 1, "Buff should persist after PS (no damage → no cleanup)")

        # Step 3: AS実行 → buff消費
        ss.clear_branch_override()
        ss.execute_skill(caster=caster, skill_id=AS_SHO, battlefield=bf, skip_cost=True)

        pen_buffs = [b for b in caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 0,
                         "Buff should be consumed after AS skill (attack_limited=1)")

    def test_ps_daikiku_penetrate_defense_reduces_def(self):
        """PS 大吉: penetrate_defense 50%が防御力を半減させる(統合テスト)."""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_SHO, PS_OMIKUJI],
                            skill_levels={AS_SHO: 10, PS_OMIKUJI: 10},
                            hp=100000, atk=10000, pp=4)
        # 高防御の敵
        enemy = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                           hp=999999, defense=4000)
        bf = _make_bf(caster, enemy)
        ss, ts = self._make_services(bf)

        # Step 1: PS大吉実行 → 50%穿防buff付与
        ss.set_branch_override(lambda ctx: 1)
        ss.execute_skill(caster=caster, skill_id=PS_OMIKUJI, battlefield=bf, skip_cost=True)

        # Step 2: AS実行(穿防適用) → ダメージ確認
        ss.clear_branch_override()
        hp_before = enemy.current_hp
        ss.execute_skill(caster=caster, skill_id=AS_SHO, battlefield=bf, skip_cost=True)
        dmg_with_penetrate = hp_before - enemy.current_hp

        # Step 3: 穿防なしでAS実行 → ダメージ確認
        enemy.current_hp = 999999
        hp_before = enemy.current_hp
        ss.execute_skill(caster=caster, skill_id=AS_SHO, battlefield=bf, skip_cost=True)
        dmg_without_penetrate = hp_before - enemy.current_hp

        # 穿防50%時の方がダメージが大きい(防御4000→2000)
        self.assertGreater(dmg_with_penetrate, dmg_without_penetrate,
                           "大吉(50%穿防) should deal more damage than no penetrate")


if __name__ == '__main__':
    unittest.main()
