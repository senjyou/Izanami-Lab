    def test_ps_shokiku_atk_up_by_atk1(self):
        """PS 小吉: atk_up buff付与 (value_tag=atk1)."""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_SHO, PS_OMIKUJI],
                            skill_levels={AS_SHO: 10, PS_OMIKUJI: 10},
                            hp=100000, pp=4)
        enemy = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        bf = _make_bf(caster, enemy)
        ss, ts = self._make_services(bf)

        ss.set_branch_override(lambda ctx: 3)  # Block 3 = 小吉
        ss.execute_skill(caster=caster, skill_id=PS_OMIKUJI, battlefield=bf, skip_cost=True)

        atk_buffs = [b for b in caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_buffs), 0, "小吉 should apply atk_up buff")
        # Lv10 atk1 = 10.0
        self.assertAlmostEqual(atk_buffs[0].value, 10.0, places=1,
                               msg="小吉 atk_up value should be atk1 tag value at Lv10 (10.0)")

