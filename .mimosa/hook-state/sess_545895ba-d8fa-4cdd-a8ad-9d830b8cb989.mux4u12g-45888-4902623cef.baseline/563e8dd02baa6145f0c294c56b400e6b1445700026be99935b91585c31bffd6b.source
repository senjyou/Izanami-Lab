    def test_ps_lv11_additional_dmg_dealt_up(self):
        """PS Lv11+: 追加でdmg_dealt_up buff付与(抽選結果に依存しない)。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_SHO, PS_OMIKUJI],
                            skill_levels={AS_SHO: 15, PS_OMIKUJI: 15},
                            hp=100000, pp=4)
        enemy = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        bf = _make_bf(caster, enemy)
        ss, ts = self._make_services(bf)

        # 大吉(Block1)を選択しても、Block5(Lv11+)は別条件で常に実行
        ss.set_branch_override(lambda ctx: 1)
        ss.execute_skill(caster=caster, skill_id=PS_OMIKUJI, battlefield=bf, skip_cost=True)

        # 大吉の penetrate_defense + Lv11+の dmg_dealt_up 両方
        pen_buffs = [b for b in caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 1, "大吉 penetrate_defense should be applied")

        dmg_buffs = [b for b in caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_buffs), 0, "Lv11+ dmg_dealt_up should also be applied")
        # Lv15 dmg = 20.0
        self.assertAlmostEqual(dmg_buffs[0].value, 20.0, places=1,
                               msg="dmg_dealt_up value should be dmg tag at Lv15 (20.0)")

