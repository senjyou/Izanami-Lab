"""Regression: 大吉ハッピーニューイヤー (103302) 技能效果実装の回帰テスト。

本テストは以下の5技能の実装を検証する:
  - 110040 (EX) ど～こ見てんのよ♪: 最近敵+隣接2体EN攻撃 + Lv11+全攻撃対象に凍結付与
  - 120090 (AS1) 破魔砲: 敵前後列(縦列2人)に攻撃
  - 120091 (AS2) 厄除け祈願: 敵横一列(3人)に攻撃 + Lv11+与ダメージ減少デバフ
  - 120092 (AS3) 必勝祈願: 敵単体に攻撃
  - 130100 (PS) おみくじ運試し: AS攻撃前発動、おみくじ抽選でbuff付与(HP>=50%才発動)

新規実装要素:
  - random_choice group=0 によるおみくじ抽選 (大吉10%/中吉20%/小吉30%/末吉40%)
  - ignore_defense buff (PENETRATE_DEFENSE) による穿防効果
  - before_skill_use + self_hp_percent>=50 global_condition
  - attack_limited=1 + duration_type=attack によるAS終了時buff消費
  - enemy_column (敵前後列) / enemy_row (敵横一列) / adjacent_enemies ターゲット
  - attacked_targets target_type による攻撃対象全体への効果付与
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, Attribute, SkillEffectType, AuraUpdateTiming,
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


# Skill IDs
EX_DOKO = 110040       # ど～こ見てんのよ♪
AS_HAMA = 120090       # 破魔砲
AS_YAKU = 120091       # 厄除け祈願
AS_SHO = 120092        # 必勝祈願
PS_OMIKUJI = 130100    # おみくじ運試し

CHAR_ID = 103302

# Effect type constants
PENETRATE_DEFENSE = SkillEffectType.PENETRATE_DEFENSE.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
FREEZE = SkillEffectType.FREEZE.value


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.EARTH.value,
               character_type=3, skills=None, skill_levels=None, pp=4, ap=10,
               crit_rate=0.0, crit_damage=0.0):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=CHAR_ID, level=15, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=0,
        is_alive=hp > 0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class TestReg103302Daikichi(unittest.TestCase):
    """大吉ハッピーニューイヤー (103302) 全技能回帰テスト。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    # ── 設定検証 ──────────────────────────────────────────────────

    def test_config_all_5_skills_exist(self):
        """5技能すべてがskill_effects_hybrid.jsonに存在する。"""
        for sid in [EX_DOKO, AS_HAMA, AS_YAKU, AS_SHO, PS_OMIKUJI]:
            parsed = self.dl.get_parsed_skill_data(sid)
            self.assertIsNotNone(parsed, f"skill {sid} must exist in hybrid config")

    def test_config_ex_110040_target_types(self):
        """EX 110040: enemy_single + adjacent_enemies + attacked_targets(freeze)."""
        parsed = self.dl.get_parsed_skill_data(EX_DOKO)
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(len(blocks), 2, "EX should have 2 blocks (damage + freeze)")

        # Block 1: damage
        b1_effects = blocks[0].get('effects', [])
        dmg_effs = [e for e in b1_effects if e.get('effect_type') == 'damage']
        self.assertEqual(len(dmg_effs), 2, "Block1 should have 2 damage effects")
        self.assertEqual(dmg_effs[0].get('target_type'), 'enemy_single')
        self.assertEqual(dmg_effs[1].get('target_type'), 'adjacent_enemies')
        self.assertEqual(dmg_effs[1].get('flags', {}).get('target_count'), 2)

        # Block 2: freeze (Lv11+)
        self.assertEqual(blocks[1].get('condition', {}).get('type'), 'active_level_min')
        self.assertEqual(blocks[1].get('condition', {}).get('value'), 11)
        b2_effects = blocks[1].get('effects', [])
        freeze_effs = [e for e in b2_effects if e.get('effect_type') == 'add_status']
        self.assertEqual(len(freeze_effs), 1)
        self.assertEqual(freeze_effs[0].get('target_type'), 'attacked_targets')
        self.assertEqual(freeze_effs[0].get('flags', {}).get('status_type'), 'freeze')
        self.assertEqual(freeze_effs[0].get('value_tag'), 'dmg')

    def test_config_as1_120090_enemy_column(self):
        """AS1 120090: enemy_column (敵前後列=縦列2人)."""
        parsed = self.dl.get_parsed_skill_data(AS_HAMA)
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(len(blocks), 1)
        effs = blocks[0].get('effects', [])
        self.assertEqual(len(effs), 1)
        self.assertEqual(effs[0].get('target_type'), 'enemy_column',
                         "AS1 must use enemy_column (縦列2人), NOT enemy_row")
        self.assertEqual(effs[0].get('value_tag'), '威力')

    def test_config_as2_120091_enemy_row_and_debuff(self):
        """AS2 120091: enemy_row + Lv11+ dmg_dealt_down on attacked_targets."""
        parsed = self.dl.get_parsed_skill_data(AS_YAKU)
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(len(blocks), 2, "AS2 should have 2 blocks (damage + debuff)")

        # Block 1: damage to enemy_row
        b1_effs = blocks[0].get('effects', [])
        self.assertEqual(b1_effs[0].get('target_type'), 'enemy_row',
                         "AS2 must use enemy_row (横一列3人)")
        self.assertEqual(b1_effs[0].get('value_tag'), '威力')

        # Block 2: dmg_dealt_down (Lv11+)
        self.assertEqual(blocks[1].get('condition', {}).get('type'), 'active_level_min')
        self.assertEqual(blocks[1].get('condition', {}).get('value'), 11)
        b2_effs = blocks[1].get('effects', [])
        debuff_effs = [e for e in b2_effs if e.get('effect_type') == 'dmg_dealt_down']
        self.assertEqual(len(debuff_effs), 1)
        self.assertEqual(debuff_effs[0].get('target_type'), 'attacked_targets')
        self.assertEqual(debuff_effs[0].get('flags', {}).get('attack_limited'), 1)
        self.assertTrue(debuff_effs[0].get('flags', {}).get('stackable'))

    def test_config_as3_120092_enemy_single(self):
        """AS3 120092: enemy_single, 無冷却."""
        parsed = self.dl.get_parsed_skill_data(AS_SHO)
        self.assertIsNone(parsed.get('cooldown'), "AS3 should have no cooldown")
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(len(blocks), 1)
        effs = blocks[0].get('effects', [])
        self.assertEqual(effs[0].get('target_type'), 'enemy_single')
        self.assertEqual(effs[0].get('value_tag'), '威力')

    def test_config_ps_130100_trigger_and_condition(self):
        """PS 130100: before_skill_use + self_hp_percent>=50."""
        parsed = self.dl.get_parsed_skill_data(PS_OMIKUJI)
        self.assertEqual(parsed.get('trigger_type'), 'before_skill_use')
        gc = parsed.get('global_condition')
        self.assertIsNotNone(gc, "PS must have global_condition")
        self.assertEqual(gc.get('type'), 'self_hp_percent')
        self.assertEqual(gc.get('operator'), '>=',
                         "HP>=50% triggers (not >, boundary HP=50% should trigger)")
        self.assertEqual(gc.get('value'), 50)

    def test_config_ps_130100_random_choice_weights(self):
        """PS 130100: random_choice weights 大吉10/中吉20/小吉30/末吉40."""
        parsed = self.dl.get_parsed_skill_data(PS_OMIKUJI)
        blocks = parsed.get('effect_blocks', [])
        # Blocks 1-4 are random_choice, Block 5 is active_level_min
        rc_blocks = [b for b in blocks if b.get('condition', {}).get('type') == 'random_choice']
        self.assertEqual(len(rc_blocks), 4, "Should have 4 random_choice blocks")
        weights = [b['condition']['weight'] for b in rc_blocks]
        self.assertEqual(weights, [10, 20, 30, 40],
                         "Weights: 大吉10/中吉20/小吉30/末吉40")
        # All in same group
        groups = [b['condition'].get('group_id', 0) for b in rc_blocks]
        self.assertTrue(all(g == 0 for g in groups), "All blocks in group 0")

    def test_config_ps_130100_block5_lv11_bonus(self):
        """PS 130100 Block5: active_level_min=11, dmg_dealt_up stackable."""
        parsed = self.dl.get_parsed_skill_data(PS_OMIKUJI)
        blocks = parsed.get('effect_blocks', [])
        b5 = blocks[4]
        self.assertEqual(b5.get('condition', {}).get('type'), 'active_level_min')
        self.assertEqual(b5.get('condition', {}).get('value'), 11)
        effs = b5.get('effects', [])
        self.assertEqual(effs[0].get('effect_type'), 'dmg_dealt_up')
        self.assertEqual(effs[0].get('value_tag'), 'dmg')
        self.assertTrue(effs[0].get('flags', {}).get('stackable'))
        self.assertEqual(effs[0].get('flags', {}).get('attack_limited'), 1)

    # ── EX 110040 挙動 ────────────────────────────────────────────

    def test_ex_targets_nearest_and_adjacent(self):
        """EX: 最近敵 + 隣接2体にダメージ。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[EX_DOKO], skill_levels={EX_DOKO: 10})
        # 敵配置: 前列3体 + 後列3体
        e_center = _make_unit("e_c", "敵C", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        e_left = _make_unit("e_l", "敵L", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999)
        e_right = _make_unit("e_r", "敵R", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=999999)
        bf = _make_bf(caster, e_center, e_left, e_right)
        ss, _ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in [e_center, e_left, e_right]}
        result = ss.execute_skill(caster=caster, skill_id=EX_DOKO, battlefield=bf, skip_cost=True)
        self.assertTrue(result.get('success'))

        # 最近敵(center) + 隣接2体(left, right) が被弾
        self.assertLess(e_center.current_hp, hp_before['e_c'], "Center enemy should be damaged")
        self.assertLess(e_left.current_hp, hp_before['e_l'], "Left enemy should be damaged (adjacent)")
        self.assertLess(e_right.current_hp, hp_before['e_r'], "Right enemy should be damaged (adjacent)")

    def test_ex_lv11_freeze_on_attacked_targets(self):
        """EX Lv11+: 全攻撃対象(主+隣接)に凍結付与。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[EX_DOKO], skill_levels={EX_DOKO: 15})
        e_center = _make_unit("e_c", "敵C", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        e_left = _make_unit("e_l", "敵L", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999)
        e_right = _make_unit("e_r", "敵R", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=999999)
        bf = _make_bf(caster, e_center, e_left, e_right)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster=caster, skill_id=EX_DOKO, battlefield=bf, skip_cost=True)

        for enemy, label in [(e_center, "center"), (e_left, "left"), (e_right, "right")]:
            freeze_debuffs = [d for d in enemy.debuffs if d.effect_type == FREEZE]
            self.assertGreater(len(freeze_debuffs), 0,
                               f"{label} enemy should have freeze debuff at Lv15")
            self.assertTrue(enemy.is_frozen, f"{label} enemy should be frozen")

    def test_ex_lv10_no_freeze(self):
        """EX Lv10: 凍結付与なし."""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[EX_DOKO], skill_levels={EX_DOKO: 10})
        e_center = _make_unit("e_c", "敵C", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        bf = _make_bf(caster, e_center)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster=caster, skill_id=EX_DOKO, battlefield=bf, skip_cost=True)

        freeze_debuffs = [d for d in e_center.debuffs if d.effect_type == FREEZE]
        self.assertEqual(len(freeze_debuffs), 0, "Lv10 should NOT apply freeze")

    # ── AS1 120090 挙動 ───────────────────────────────────────────

    def test_as1_targets_enemy_column(self):
        """AS1: 敵前後列(縦列2人=前排+後排同列)にダメージ。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_HAMA], skill_levels={AS_HAMA: 10})
        e_front = _make_unit("e_f", "敵前", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        e_back = _make_unit("e_b", "敵後", Side.ENEMY, Position.ENEMY_CENTER_BACK, hp=999999)
        e_other = _make_unit("e_o", "敵他", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999)
        bf = _make_bf(caster, e_front, e_back, e_other)
        ss, _ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in [e_front, e_back, e_other]}
        ss.execute_skill(caster=caster, skill_id=AS_HAMA, battlefield=bf, skip_cost=True)

        # 縦列(center front + center back) が被弾
        self.assertLess(e_front.current_hp, hp_before['e_f'], "Center front should be damaged")
        self.assertLess(e_back.current_hp, hp_before['e_b'], "Center back should be damaged (column)")
        self.assertEqual(e_other.current_hp, hp_before['e_o'], "Left front should NOT be damaged")

    # ── AS2 120091 挙動 ───────────────────────────────────────────

    def test_as2_targets_enemy_row(self):
        """AS2: 敵横一列(前排3人)にダメージ。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_YAKU], skill_levels={AS_YAKU: 10})
        e_left = _make_unit("e_l", "敵L", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999)
        e_center = _make_unit("e_c", "敵C", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        e_right = _make_unit("e_r", "敵R", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=999999)
        e_back = _make_unit("e_b", "敵B", Side.ENEMY, Position.ENEMY_CENTER_BACK, hp=999999)
        bf = _make_bf(caster, e_left, e_center, e_right, e_back)
        ss, _ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in [e_left, e_center, e_right, e_back]}
        ss.execute_skill(caster=caster, skill_id=AS_YAKU, battlefield=bf, skip_cost=True)

        # 前排3人が被弾
        self.assertLess(e_left.current_hp, hp_before['e_l'], "Left front should be damaged")
        self.assertLess(e_center.current_hp, hp_before['e_c'], "Center front should be damaged")
        self.assertLess(e_right.current_hp, hp_before['e_r'], "Right front should be damaged")
        self.assertEqual(e_back.current_hp, hp_before['e_b'], "Back row should NOT be damaged")

    def test_as2_lv11_dmg_dealt_down_on_attacked_targets(self):
        """AS2 Lv11+: 全攻撃対象にdmg_dealt_downデバフ付与。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_YAKU], skill_levels={AS_YAKU: 15})
        e_left = _make_unit("e_l", "敵L", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999)
        e_center = _make_unit("e_c", "敵C", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        e_right = _make_unit("e_r", "敵R", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=999999)
        bf = _make_bf(caster, e_left, e_center, e_right)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster=caster, skill_id=AS_YAKU, battlefield=bf, skip_cost=True)

        for enemy, label in [(e_left, "left"), (e_center, "center"), (e_right, "right")]:
            debuffs = [d for d in enemy.debuffs if d.effect_type == DEALT_DAMAGE]
            self.assertGreater(len(debuffs), 0,
                               f"{label} enemy should have dmg_dealt_down debuff at Lv15")

    def test_as2_lv10_no_debuff(self):
        """AS2 Lv10: dmg_dealt_downデバフ付与なし。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_YAKU], skill_levels={AS_YAKU: 10})
        e_center = _make_unit("e_c", "敵C", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        bf = _make_bf(caster, e_center)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster=caster, skill_id=AS_YAKU, battlefield=bf, skip_cost=True)

        debuffs = [d for d in e_center.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(debuffs), 0, "Lv10 should NOT apply dmg_dealt_down")

    # ── AS3 120092 挙動 ───────────────────────────────────────────

    def test_as3_targets_enemy_single(self):
        """AS3: 敵単体にダメージ。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_SHO], skill_levels={AS_SHO: 10})
        e1 = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        e2 = _make_unit("e2", "敵2", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999)
        bf = _make_bf(caster, e1, e2)
        ss, _ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in [e1, e2]}
        ss.execute_skill(caster=caster, skill_id=AS_SHO, battlefield=bf, skip_cost=True)

        # 最近敵(e1=center front) のみ被弾
        self.assertLess(e1.current_hp, hp_before['e1'], "Nearest enemy should be damaged")
        self.assertEqual(e2.current_hp, hp_before['e2'], "Other enemy should NOT be damaged")

    # ── PS 130100 挙動 ────────────────────────────────────────────

    def test_ps_triggers_when_hp_above_50(self):
        """PS: HP>50%の時、before_skill_useでトリガー収集される。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_SHO, PS_OMIKUJI],
                            skill_levels={AS_SHO: 10, PS_OMIKUJI: 10},
                            hp=100000, pp=4)
        enemy = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        bf = _make_bf(caster, enemy)
        ss, ts = self._make_services(bf)

        actions = ts.trigger_before_skill_use(caster, AS_SHO, bf)
        omikuji_actions = [a for a in actions if a.skill_id == PS_OMIKUJI]
        self.assertGreater(len(omikuji_actions), 0,
                           "PS should trigger when HP=100% (>50%)")

    def test_ps_triggers_when_hp_exactly_50(self):
        """PS: HP=50%の時、トリガーされる (>= 50%)."""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_SHO, PS_OMIKUJI],
                            skill_levels={AS_SHO: 10, PS_OMIKUJI: 10},
                            hp=100000, pp=4)
        caster.current_hp = 50000  # 正確に50%
        enemy = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        bf = _make_bf(caster, enemy)
        ss, ts = self._make_services(bf)

        actions = ts.trigger_before_skill_use(caster, AS_SHO, bf)
        omikuji_actions = [a for a in actions if a.skill_id == PS_OMIKUJI]
        self.assertGreater(len(omikuji_actions), 0,
                           "PS should trigger when HP=50% (>=50% boundary)")

    def test_ps_not_triggers_when_hp_below_50(self):
        """PS: HP<50%の時、トリガーされない。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_SHO, PS_OMIKUJI],
                            skill_levels={AS_SHO: 10, PS_OMIKUJI: 10},
                            hp=100000, pp=4)
        caster.current_hp = 49999  # 50%未満
        enemy = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        bf = _make_bf(caster, enemy)
        ss, ts = self._make_services(bf)

        actions = ts.trigger_before_skill_use(caster, AS_SHO, bf)
        omikuji_actions = [a for a in actions if a.skill_id == PS_OMIKUJI]
        self.assertEqual(len(omikuji_actions), 0,
                         "PS should NOT trigger when HP<50%")

    def test_ps_daikiku_penetrate_defense_50(self):
        """PS 大吉: ignore_defense 50% buff付与。"""
        caster = _make_unit("caster", "大吉", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[AS_SHO, PS_OMIKUJI],
                            skill_levels={AS_SHO: 10, PS_OMIKUJI: 10},
                            hp=100000, pp=4)
        enemy = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999,
                           defense=4000)
        bf = _make_bf(caster, enemy)
        ss, ts = self._make_services(bf)

        # Block 1 (大吉) を強制選択
        ss.set_branch_override(lambda ctx: 1)
        ss.execute_skill(caster=caster, skill_id=PS_OMIKUJI, battlefield=bf, skip_cost=True)

        pen_buffs = [b for b in caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 1, "大吉 should apply ignore_defense buff")
        self.assertEqual(pen_buffs[0].value, 50, "大吉 penetrate value=50")

