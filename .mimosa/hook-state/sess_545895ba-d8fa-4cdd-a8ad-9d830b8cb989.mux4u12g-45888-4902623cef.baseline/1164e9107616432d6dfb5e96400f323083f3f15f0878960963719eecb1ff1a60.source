        actions = self.ts.trigger_pawn_died([self.enemy_front], self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130109]
        self.assertEqual(len(ps2_actions), 0,
                         "无链接时击杀敌人不应触发PS2")

