"""
角色121302 新たなる時代の導き手 专项测试
- EX: 110044 ノーブル・プライド（敵3体に3hit+1hit EN攻撃 + EXゲージ3削減）
- AS1: 120098 リビューク・ジ・イグノーブル（敵単体EN攻撃 + 被ダメUP + 「気品」mark付与 + 最少mark優先索敵）
- AS2: 120099 エッジ・オブ・グレイス（敵単体EN攻撃 + 防御力5%低下2行動 重複可）
- PS1: 130108 融和の象徴（ターン開始時 + 最近敵+最遠敵に双方向ダメージリンク1ターン + 1回限定）
- PS2: 130109 新時代の先駆け（リンク付与敵が倒された時 + 自身速度UP + Lv11+前列味方2体にシールド + 1回限定）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
