    def test_ps1_farthest_target_left_priority(self):
        """
        PS1(130108) 最遠目標索敵：同距離の場合は左列を優先
        验证: caster在后排中央时，最远目标应为左后位（非右后位）
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130108, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 找到被链接的敌方
        link_units = [e for e in self.bf.enemy_team if e.damage_links]
        self.assertGreaterEqual(len(link_units), 2, "应建立链接")

        # caster在后排中央(1,1)，参考点(0,1)
        # 最近: 中前位(0,1) dist=0
        # 最远候选: 左后位(1,0) dist=2, 右后位(1,2) dist=2
        # 同距離の場合は左列を優先 → 左后位
        link_unit_ids = {u.unit_id for u in link_units}
        self.assertIn(self.enemy_front.unit_id, link_unit_ids,
                      "最近目标应为中前位")
        self.assertIn(self.enemy_left_back.unit_id, link_unit_ids,
                      "最远目标应为左后位（同距离优先左列）")
        self.assertNotIn(self.enemy_right_back.unit_id, link_unit_ids,
                         "最远目标不应为右后位（同距离左列优先）")

