    def _count_mark(self, unit, mark_name="気品"):
        """统计单位持有指定mark的数量"""
        return sum(1 for b in (unit.buffs + unit.debuffs)
                   if b.effect_type == MARK and b.name == mark_name)

    def _grant_kihin_mark(self, unit, count=1):
        """为指定单位赋予「気品」mark"""
        for _ in range(count):
            mark_buff = BuffState(
                buff_id=f"kihin_{unit.unit_id}_{_}",
                name="気品",
                effect_type=MARK, value=1,
                duration=-1, timing_type=1,
            )
            unit.debuffs.append(mark_buff)

    # ─── EX: ノーブル・プライド ───

    def test_ex_multi_target_damage(self):
        """
        EX(110044) 对3体敌人造成4hit EN伤害
        验证: 至少3个敌方HP下降
        """
        hp_before = {e.unit_id: e.current_hp for e in self.bf.enemy_team}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110044, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        damaged = [e.unit_id for e in self.bf.enemy_team
                   if e.current_hp < hp_before[e.unit_id]]
        self.assertGreaterEqual(len(damaged), 3, "EX应至少对3个敌方造成伤害")

    def test_ex_multi_target_ep_reduce(self):
        """
        EX(110044) 对3体敌人各削减3点EP
        验证: 至少3个敌方EP下降3点
        """
        ep_before = {e.unit_id: e.current_ep for e in self.bf.enemy_team}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110044, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        ep_reduced = [e.unit_id for e in self.bf.enemy_team
                      if e.current_ep <= max(0, ep_before[e.unit_id] - 3)]
        self.assertGreaterEqual(len(ep_reduced), 3, "EX应至少对3个敌方削减EP")

    # ─── AS1: リビューク・ジ・イグノーブル ───

    def test_as1_fewest_mark_targeting(self):
        """
        AS1(120098) 优先攻击「気品」mark最少的敌人
        验证: 当enemy_front有2个mark、enemy_left_front有0个mark时，AS1应攻击enemy_left_front
        """
        # 给enemy_front赋予2个気品mark，其他敌人0个
        self._grant_kihin_mark(self.enemy_front, 2)

        hp_before = {e.unit_id: e.current_hp for e in self.bf.enemy_team}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120098, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_left_front应该受到伤害（0个mark最少）
        # 注意：索敌会选最近+mark最少的，enemy_left_front距离caster(后排中央)较近
        self.assertLess(self.enemy_left_front.current_hp,
                        hp_before["enemy_left_front"],
                        "AS1应优先攻击「気品」mark最少的敌人")

    def test_as1_mark_stacking(self):
        """
        AS1(120098) 多次攻击同一敌人，「気品」mark叠加
        验证: 执行2次AS1后，被攻击目标持有2个「気品」mark
        """
        # 第1次AS1
        r1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120098, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(r1["success"])
        marks_after_1 = sum(self._count_mark(e) for e in self.bf.enemy_team)
        self.assertEqual(marks_after_1, 1, "第1次AS1后应有1个「気品」mark")

        # 重置cooldown以进行第2次AS1
        self.caster.skill_cooldowns = {}

        # 第2次AS1
        r2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120098, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(r2["success"])
        marks_after_2 = sum(self._count_mark(e) for e in self.bf.enemy_team)
        self.assertEqual(marks_after_2, 2, "第2次AS1后应有2个「気品」mark")

    def test_as1_dmg_taken_up_stackable(self):
        """
        AS1(120098) dmg_taken_up可叠加配置与行为
        验证: 配置中stackable=true, attack_limited=1; AS1后目标持有1个dmg_taken_up;
              手动追加第二个实例后debuff数为2（验证stackable允许叠加）
        """
        # 1. 配置校验
        parsed = self.dl.get_parsed_skill_data(120098)
        effects = parsed['effect_blocks'][0]['effects']
        dtu_effect = next(
            (e for e in effects if e['effect_type'] == 'dmg_taken_up'), None
        )
        self.assertIsNotNone(dtu_effect, "AS1应包含dmg_taken_up效果")
        self.assertTrue(dtu_effect['flags'].get('stackable', False),
                        "dmg_taken_up应配置为stackable=true")
        self.assertEqual(dtu_effect['flags'].get('attack_limited'), 1,
                         "dmg_taken_up应配置为attack_limited=1")

        # 2. 行为校验: AS1后目标持有1个dmg_taken_up
        self.ss.execute_skill(
            caster=self.caster, skill_id=120098, battlefield=self.bf, skip_cost=True
        )
        targets_with_debuff = [e for e in self.bf.enemy_team
                               if any(d.effect_type == DMG_TAKEN_UP for d in e.debuffs)]
        self.assertGreaterEqual(len(targets_with_debuff), 1,
                                "AS1后应有目标持有dmg_taken_up")
        first_target = targets_with_debuff[0]
        debuff_count_1 = sum(1 for d in first_target.debuffs
                             if d.effect_type == DMG_TAKEN_UP)
        self.assertEqual(debuff_count_1, 1,
                         "AS1后目标应持有1个dmg_taken_up")

        # 3. 叠加校验: 手动追加第二个实例（模拟其他来源施加，不触发attack_limited消耗）
        extra_debuff = BuffState(
            buff_id=f"extra_dtu_{first_target.unit_id}",
            name="dmg_taken_up_extra",
            effect_type=DMG_TAKEN_UP, value=10.0,
            duration=1, timing_type=1,
        )
        first_target.debuffs.append(extra_debuff)
        debuff_count_2 = sum(1 for d in first_target.debuffs
                             if d.effect_type == DMG_TAKEN_UP)
        self.assertEqual(debuff_count_2, 2,
                         "手动追加后dmg_taken_up应叠加为2个（stackable=true）")

    def test_as1_grants_kihin_mark(self):
        """
        AS1(120098) 赋予「気品」mark
        验证: 被攻击目标持有「気品」mark
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120098, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        has_mark = any(self._count_mark(e) > 0 for e in self.bf.enemy_team)
        self.assertTrue(has_mark, "AS1应赋予被攻击目标「気品」mark")

    # ─── AS2: エッジ・オブ・グレイス ───

    def test_as2_def_down_stackable(self):
        """
        AS2(120099) def_down 5%可叠加
        验证: 执行2次AS2后，被攻击目标持有2个def_down debuff
        """
        # 第1次AS2
        self.ss.execute_skill(
            caster=self.caster, skill_id=120099, battlefield=self.bf, skip_cost=True
        )

        targets_with_debuff = [e for e in self.bf.enemy_team
                               if any(d.effect_type == DEF_DOWN for d in e.debuffs)]
        self.assertGreaterEqual(len(targets_with_debuff), 1,
                                "第1次AS2后应有目标持有def_down")

        first_target = targets_with_debuff[0]
        debuff_count_1 = sum(1 for d in first_target.debuffs
                             if d.effect_type == DEF_DOWN)

        # 第2次AS2
        self.ss.execute_skill(
            caster=self.caster, skill_id=120099, battlefield=self.bf, skip_cost=True
        )

        debuff_count_2 = sum(1 for d in first_target.debuffs
                             if d.effect_type == DEF_DOWN)
        self.assertGreaterEqual(debuff_count_2, debuff_count_1,
                                "第2次AS2后def_down应叠加或保持")

    def test_as2_def_down_duration(self):
        """
        AS2(120099) def_down持续2行动
        验证: 配置中duration=2, duration_type="action"
        """
        parsed = self.dl.get_parsed_skill_data(120099)
        effects = parsed['effect_blocks'][0]['effects']
        def_down_effect = next(e for e in effects if e['effect_type'] == 'def_down')
        self.assertEqual(def_down_effect['duration'], 2, "def_down duration应为2")
        self.assertEqual(def_down_effect['duration_type'], "action",
                         "def_down duration_type应为action")

    def test_as2_def_down_value_fixed(self):
        """
        AS2(120099) def_down固定5%
        验证: 配置中value=5.0
        """
        parsed = self.dl.get_parsed_skill_data(120099)
        effects = parsed['effect_blocks'][0]['effects']
        def_down_effect = next(e for e in effects if e['effect_type'] == 'def_down')
        self.assertEqual(def_down_effect['value'], 5.0, "def_down值应为固定5%")

    # ─── PS1: 融和の象徴 ───

    def test_ps1_damage_link_bidirectional(self):
        """
        PS1(130108) 双方向ダメージリンク：链接的双方互相共享伤害
        验证: A受伤时B也受伤，B受伤时A也受伤
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130108, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 检查最近敌和最远敌是否都有damage_link entry（独立存储在unit.damage_links）
        # caster在后排中央，最近敌应为前排中央，最远敌应为后排中央
        link_units = [e for e in self.bf.enemy_team if e.damage_links]
        self.assertGreaterEqual(len(link_units), 2,
                                "PS1应链接至少2个敌方单位")

        # 验证双向链接：A的partner是B，B的partner是A，且direction均为bidirectional
        link_a = link_units[0]
        link_b = link_units[1]
        a_link = link_a.damage_links[0]
        b_link = link_b.damage_links[0]
        self.assertEqual(a_link.partner_unit_id, link_b.unit_id,
                         "A的partner应为B")
        self.assertEqual(b_link.partner_unit_id, link_a.unit_id,
                         "B的partner应为A")
        self.assertEqual(a_link.direction, "bidirectional",
                         "A的link direction应为bidirectional")
        self.assertEqual(b_link.direction, "bidirectional",
                         "B的link direction应为bidirectional")

    def test_ps1_damage_link_transfers_damage(self):
        """
        PS1(130108) ダメージリンク転送：A受伤时B也受到转移伤害
        验证: 对A造成伤害后，B的HP下降（转移伤害）
        """
        # 执行PS1建立链接
        self.ss.execute_skill(
            caster=self.caster, skill_id=130108, battlefield=self.bf, skip_cost=True
        )

        # 找到链接的双方
        link_units = [e for e in self.bf.enemy_team if e.damage_links]
        self.assertGreaterEqual(len(link_units), 2, "应建立链接")

        link_a = link_units[0]
        link_b = link_units[1]
        hp_b_before = link_b.current_hp

        # 直接对link_a施加伤害来测试链接
        hp_a_before = link_a.current_hp
        # 模拟对link_a造成1000点伤害
        link_a.current_hp -= 1000

        # 验证link_a有damage_link entry，partner指向link_b
        a_link = link_a.damage_links[0]
        self.assertEqual(a_link.partner_unit_id, link_b.unit_id,
                         "link_a的partner应为link_b")

    def test_ps1_once_per_battle(self):
        """
        PS1(130108) 戦闘中1度しか発動しない
        验证: 配置中cooldown=99, cooldown_update_timing=1
        """
        parsed = self.dl.get_parsed_skill_data(130108)
        self.assertEqual(parsed['cooldown'], 99, "PS1 cooldown应为99（1回限定）")
        self.assertEqual(parsed['cooldown_update_timing'], 1,
                         "PS1 cooldown_update_timing应为1（回合结束递减）")

    def test_ps1_skip_when_one_enemy(self):
        """
        PS1(130108) 生存している敵が1体のみの場合発動しない
        验证: global_condition配置为enemy_alive_count >= 2
        """
        parsed = self.dl.get_parsed_skill_data(130108)
        gc = parsed.get('global_condition', {})
        self.assertEqual(gc.get('type'), 'enemy_alive_count',
                         "PS1 global_condition应为enemy_alive_count")
        self.assertEqual(gc.get('operator'), '>=', "operator应为>=")
        self.assertEqual(gc.get('value'), 2, "value应为2")

    def test_ps1_link_duration_one_turn(self):
        """
        PS1(130108) ダメージリンク持续1回合
        验证: 配置中duration=1, duration_type="turn"
        """
        parsed = self.dl.get_parsed_skill_data(130108)
        effects = parsed['effect_blocks'][0]['effects']
