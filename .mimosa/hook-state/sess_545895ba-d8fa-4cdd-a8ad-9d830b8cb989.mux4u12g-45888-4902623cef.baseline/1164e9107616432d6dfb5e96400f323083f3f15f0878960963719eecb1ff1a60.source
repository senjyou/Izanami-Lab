    def test_ps2_lv11_shield_config(self):
        """
        PS2(130109) Lv11+追加护盾配置
        验证: Block2 condition type=active_level_min value=11, shield效果配置正确
        """
        parsed = self.dl.get_parsed_skill_data(130109)
        self.assertGreaterEqual(len(parsed['effect_blocks']), 2,
                                "PS2应有至少2个block")
        block2 = parsed['effect_blocks'][1]
        cond = block2['condition']
        self.assertEqual(cond.get('type'), 'active_level_min',
                         "Block2 condition type应为active_level_min")
        self.assertEqual(cond.get('value'), 11,
                         "Block2 condition value应为11")

        shield_effect = next(e for e in block2['effects']
                             if e['effect_type'] == 'shield')
        self.assertEqual(shield_effect['target_type'], 'ally_all',
                         "shield target_type应为ally_all")
        self.assertEqual(shield_effect['duration'], 2,
                         "shield duration应为2")
        self.assertEqual(shield_effect['duration_type'], 'action',
                         "shield duration_type应为action")
        flags = shield_effect.get('flags', {})
        self.assertEqual(flags.get('target_count'), 2, "target_count应为2")
        self.assertEqual(flags.get('shield_base'), 'atk',
                         "shield_base应为atk")
        self.assertTrue(flags.get('include_self'),
                        "include_self应为true")
        self.assertTrue(flags.get('front_priority'),
                        "front_priority应为true")

    def test_ps2_trigger_on_linked_kill(self):
        """
        PS2(130109) 击杀被链接敌人时触发
        验证: 先建立链接，再击杀被链接敌人，PS2应触发spd_up
        """
        # 先执行PS1建立链接
        self.ss.execute_skill(
            caster=self.caster, skill_id=130108, battlefield=self.bf, skip_cost=True
        )

        # 找到被链接的敌人
        link_units = [e for e in self.bf.enemy_team if e.damage_links]
        self.assertGreaterEqual(len(link_units), 2, "应建立链接")

        link_a = link_units[0]
        # 模拟link_a被击杀（HP归零）
        link_a.current_hp = 0

        # 触发PAWN_DIED
        actions = self.ts.trigger_pawn_died([link_a], self.bf)
        # 过滤出PS2(130109)的触发动作
        ps2_actions = [a for a in actions if a.skill_id == 130109]
        self.assertGreater(len(ps2_actions), 0,
                           "击杀被链接敌人时应触发PS2")

    def test_ps2_no_trigger_without_link(self):
        """
        PS2(130109) 无链接时击杀敌人不触发
        验证: 未建立链接时，击杀敌人不触发PS2
        """
        # 不建立链接，直接击杀enemy_front
