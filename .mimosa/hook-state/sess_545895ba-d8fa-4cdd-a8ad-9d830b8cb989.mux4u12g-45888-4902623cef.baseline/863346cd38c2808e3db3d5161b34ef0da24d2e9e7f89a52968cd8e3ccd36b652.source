# -*- coding: utf-8 -*-
"""GUI 双属性适配测试：属性显示格式化 + 属性筛选匹配（含副属性）"""
from gui.constants import format_attributes, attribute_matches


class TestGuiAttributeFormat:
    def test_single_attribute_display(self):
        """单属性显示不变"""
        assert format_attributes(4) == "土"
        assert format_attributes(4, 0) == "土"
        assert format_attributes(1) == "火"

    def test_dual_attribute_display(self):
        """双属性显示为「主/副」"""
        assert format_attributes(4, 1) == "土/火"

    def test_same_sub_not_duplicated(self):
        """主副相同不重复显示"""
        assert format_attributes(4, 4) == "土"

    def test_invalid_attribute(self):
        assert format_attributes(0) == "?"


class TestGuiAttributeFilter:
    def test_filter_all(self):
        """筛选=全部(0)时任意角色命中"""
        assert attribute_matches(4, 1, 0) is True

    def test_filter_main_attribute(self):
        """主属性筛选命中"""
        assert attribute_matches(4, 1, 4) is True

    def test_filter_sub_attribute(self):
        """副属性筛选命中（双属性角色可在火属性筛选中找到）"""
        assert attribute_matches(4, 1, 1) is True

    def test_filter_no_match(self):
        """主副均不匹配时不命中"""
        assert attribute_matches(4, 1, 3) is False

    def test_single_attribute_unaffected(self):
        """单属性角色筛选行为不变"""
        assert attribute_matches(4, 0, 4) is True
        assert attribute_matches(4, 0, 1) is False


class TestGui500301DualAttribute:
    def test_500301_found_in_fire_and_earth_filter(self):
        """500301(主土/副火) 在土、火筛选中均可找到，且显示为 土/火"""
        from src.data.data_loader import DataLoader
        dl = DataLoader()
        dl.load_all()
        c = dl.get_character_by_id(500301)
        assert c is not None
        assert attribute_matches(c.attribute, c.sub_attribute, 4) is True   # 土
        assert attribute_matches(c.attribute, c.sub_attribute, 1) is True   # 火（副属性）
        assert attribute_matches(c.attribute, c.sub_attribute, 2) is False  # 水
        assert attribute_matches(c.attribute, c.sub_attribute, 0) is True   # 全部
        assert format_attributes(c.attribute, c.sub_attribute) == "土/火"

