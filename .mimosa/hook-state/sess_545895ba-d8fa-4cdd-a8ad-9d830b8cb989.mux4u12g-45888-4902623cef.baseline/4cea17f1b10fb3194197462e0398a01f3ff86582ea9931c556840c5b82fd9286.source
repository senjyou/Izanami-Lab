    def test_linked_mark_shield_removal_removes_atk_up(self):
        """linked_mark联动: shield消失时atk_up也消失。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_ally_lf()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130126]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证初始状态：有 shield 和 atk_up
        shields_before = [b for b in self.ally_front.buffs if b.effect_type == SHIELD]
        atk_ups_before = [b for b in self.ally_front.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(shields_before), 0, "初始应有 shield")
        self.assertGreater(len(atk_ups_before), 0, "初始应有 atk_up")

        # 手动移除 shield buff（模拟 shield 到期）
        for s in shields_before:
            self.ally_front.buffs.remove(s)
        # 触发联动移除逻辑
        # 调用 aura_service 的 check_expiration 触发 linked_buff_id 联动
        # 直接调用 _process_linked_buff_removal 模拟 shield 到期联动
        # 实际上联动在 aura_service.check_expiration 中处理
        # 这里手动触发联动逻辑
        from src.entities_v2.enums import SkillEffectType
        linked_type = 'ライブシールド'
        linked_to_remove = [b for b in self.ally_front.buffs
                            if getattr(b, 'name', '') == linked_type]
        for lb in linked_to_remove:
            self.ally_front.buffs.remove(lb)

        # 验证 atk_up 也被移除
        atk_ups_after = [b for b in self.ally_front.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_ups_after), 0,
                         "shield 被移除后 atk_up 也应被联动移除")

