    def test_hp_ratio_damage_value_source_caster_current_hp(self):
        """hp_ratio_damage value_source=caster_current_hp: 基于施法者当前HP。"""
        parsed = self.dl.get_parsed_skill_data(110053)
        for block in parsed.get('effect_blocks', []):
            for eff in block.get('effects', []):
                if eff.get('effect_type') == 'hp_ratio_damage':
                    self.assertEqual(eff.get('value_source'), 'caster_current_hp',
                                     "value_source 应为 caster_current_hp")

    def test_hp_ratio_damage_cap_atk_75pct(self):
        """hp_ratio_damage damage_cap_atk_pct=75: 伤害上限为ATK×75%。"""
        parsed = self.dl.get_parsed_skill_data(110053)
        for block in parsed.get('effect_blocks', []):
            for eff in block.get('effects', []):
                if eff.get('effect_type') == 'hp_ratio_damage':
                    flags = eff.get('flags', {})
                    self.assertEqual(flags.get('damage_cap_atk_pct'), 75,
                                     "damage_cap_atk_pct 应为 75")

    def test_hp_ratio_damage_higher_hp_more_damage(self):
        """hp_ratio_damage: HP高时伤害更高（caster_current_hp基数）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 高HP场景
        self.ss.execute_skill(
            caster=self.caster, skill_id=110053, battlefield=self.bf, skip_cost=True
        )
        hp_high_damage = self.enemy_cf.max_hp - self.enemy_cf.current_hp

        # 低HP场景
        self._reset_caster(hp=2000)  # HP很低
        self._reset_enemies()
        self.ss.execute_skill(
            caster=self.caster, skill_id=110053, battlefield=self.bf, skip_cost=True
        )
        hp_low_damage = self.enemy_cf.max_hp - self.enemy_cf.current_hp

        # 高HP时伤害应更高（caster_current_hp=20000 vs 2000）
        # 注意：低HP时 raw_power=2000×75%=1500，未触达ATK×75%=7500上限
        # 高HP时 raw_power=20000×75%=15000，被cap到ATK×75%=10000×75%=7500
        # 所以高HP伤害=7500，低HP伤害=1500（减去防御后）
        self.assertGreater(hp_high_damage, hp_low_damage,
                           f"高HP时伤害({hp_high_damage})应大于低HP时伤害({hp_low_damage})")

