        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.ally_front.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={'poison'},
        )
        ps1_actions = [a for a in actions if a.skill_id == 130125]
        self.assertGreater(len(ps1_actions), 0,
                           "poison debuff 应触发 PS1")

    def test_on_debuff_applied_triggers_for_atk_down(self):
        """on_debuff_applied: atk_down 类型 debuff 也触发 PS1。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.ally_front.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={'atk_down'},
        )
        ps1_actions = [a for a in actions if a.skill_id == 130125]
        self.assertGreater(len(ps1_actions), 0,
                           "atk_down debuff 应触发 PS1")

    def test_on_debuff_applied_primary_target_is_debuffed_ally(self):
        """on_debuff_applied: primary_target 设置为被施加 debuff 的友方。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.ally_front.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={'poison'},
        )
        ps1_actions = [a for a in actions if a.skill_id == 130125]
        self.assertGreater(len(ps1_actions), 0, "PS1应触发")

        params = getattr(ps1_actions[0], 'parameters', {})
        self.assertIn('primary_target', params,
                      "primary_target 应被设置")
        self.assertEqual(params['primary_target'].unit_id, self.ally_front.unit_id,
                         "primary_target 应为被施加debuff的友方")

    def test_on_debuff_applied_exclude_self_verification(self):
        """on_debuff_applied exclude_self: 自身+友方同时被施加时仍触发（友方触发）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # caster 和 ally_front 同时被施加 debuff
        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.caster.unit_id, self.ally_front.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={'poison'},
        )
        ps1_actions = [a for a in actions if a.skill_id == 130125]
        # 应触发（因为 ally_front 也在 targets 中）
        self.assertGreater(len(ps1_actions), 0,
                           "自身+友方同时被施加debuff时PS1应触发（友方触发）")

    # ════════════════════════════════════════════════════════════════
    # 综合配置校验
    # ════════════════════════════════════════════════════════════════

    def test_all_skills_exist_in_data(self):
        """配置校验: 5个技能ID都在 skill_effects_hybrid.json 中存在。"""
        skill_ids = [110053, 120117, 120118, 130125, 130126]
        for sid in skill_ids:
            parsed = self.dl.get_parsed_skill_data(sid)
            self.assertIsNotNone(parsed, f"技能 {sid} 应在 skill_effects_hybrid.json 中")
            self.assertEqual(parsed.get('parse_status'), 'success',
                             f"技能 {sid} parse_status 应为 success")

    def test_ex_has_3_level_blocks(self):
        """配置校验: EX(110053) 有3个 level 段 block。"""
        parsed = self.dl.get_parsed_skill_data(110053)
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(len(blocks), 3, "EX 应有3个 block")
        # Block1: level_max=10
        self.assertEqual(blocks[0].get('level_max'), 10)
        # Block2: level_min=11, level_max=14
        self.assertEqual(blocks[1].get('level_min'), 11)
        self.assertEqual(blocks[1].get('level_max'), 14)
        # Block3: level_min=15
        self.assertEqual(blocks[2].get('level_min'), 15)

    def test_as1_has_self_debuffs(self):
        """配置校验: AS1(120117) 有 self spd_down 和 atk_down。"""
        parsed = self.dl.get_parsed_skill_data(120117)
        effects = parsed['effect_blocks'][0]['effects']
        effect_types = [e['effect_type'] for e in effects]
        self.assertIn('dmg_invulnerable', effect_types, "应有 dmg_invulnerable")
        self.assertIn('spd_down', effect_types, "应有 spd_down")
        self.assertIn('atk_down', effect_types, "应有 atk_down")

    def test_ps2_has_3_effects(self):
        """配置校验: PS2(130126) 有 shield + atk_up + dmg_taken_up 3个效果。"""
        parsed = self.dl.get_parsed_skill_data(130126)
        effects = parsed['effect_blocks'][0]['effects']
        effect_types = [e['effect_type'] for e in effects]
        self.assertIn('shield', effect_types, "应有 shield")
        self.assertIn('atk_up', effect_types, "应有 atk_up")
        self.assertIn('dmg_taken_up', effect_types, "应有 dmg_taken_up")
        self.assertEqual(len(effects), 3, "应有3个效果")

    def test_ps1_has_2_level_blocks(self):
        """配置校验: PS1(130125) 有2个 level 段 block（L1-10, L11+）。"""
        parsed = self.dl.get_parsed_skill_data(130125)
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(len(blocks), 2, "PS1 应有2个 block")
        # Block1: level_max=10
        self.assertEqual(blocks[0].get('level_max'), 10)
        # Block2: level_min=11
        self.assertEqual(blocks[1].get('level_min'), 11)


if __name__ == '__main__':
    unittest.main()
