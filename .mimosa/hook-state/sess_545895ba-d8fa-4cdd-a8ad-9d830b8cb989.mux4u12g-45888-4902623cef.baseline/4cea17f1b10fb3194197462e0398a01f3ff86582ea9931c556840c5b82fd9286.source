"""角色130302 想い響かせるヒーローシンガー 专项E2E测试

技能列表：
- EX: 110053 RAY OF HERO（敵全体 hp_ratio_damage[caster_current_hp×dmg%, cap=ATK×75%]；
  Lv11-14 self dmg_taken_down[buff%]; Lv15 self dmg_invulnerable[1行動, hit_limited=99]）
- AS1: 120117 カバーは任せて！（ally_front dmg_invulnerable[hit_limited=2]；
  self spd_down[100flat, stackable]; self atk_down[atk%, 1行動]）
- AS2: 120118 みんな、ノッってる！？（敵全体 damage[威力tag, EN攻撃]）
- PS1: 130125 気合い入れていこー！（on_debuff_applied + target_is_ally + exclude_self；
  Block1 L1-10 remove_debuff[cure tag]; Block2 L11+ dmg_taken_down[dmg%, attack_limited=1, stackable]）
- PS2: 130126 ライブ開始だよ！（on_turn_start；
  ally_front_row shield[max_hp×25%, 2行動, linked_mark=ライブシールド];
  ally_front_row atk_up[atk%, stackable, unremovable, buff_name=ライブシールド];
  self dmg_taken_up[dmg%, attack_limited=1, stackable]）

覆盖维度：
1. EX hp_ratio_damage (value_source=caster_current_hp, damage_cap_atk_pct=75) + 3段level分支
2. AS1 dmg_invulnerable (ally_front, hit_limited=2) + self spd_down/atk_down
3. AS2 基础EN全体伤害
4. PS1 on_debuff_applied + target_is_ally + exclude_self + remove_debuff
5. PS2 on_turn_start + shield(max_hp base) + linked_mark联动 + unremovable
6. hp_ratio_damage专项：caster_current_hp基数、ATK×75%上限、HP高/低差异
7. dmg_invulnerable专项：hit_limited=99/2递减、伤害无效化为1点、失效后正常受伤
8. linked_mark专项：shield+atk_up联动、shield消失时atk_up也消失
9. on_debuff_applied专项：友方被施加触发、自身被施加不触发、remove_debuff清除数量
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# atk_up/atk_down 共用 STATUS_ATTACK 枚举
# spd_down 共用 STATUS_SPEED 枚举
# dmg_taken_up/dmg_taken_down 共用 RECEIVED_DAMAGE 枚举
# shield 用 SHIELD 枚举
# dmg_invulnerable 用 DMG_INVULNERABLE 枚举
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_SPEED = SkillEffectType.STATUS_SPEED.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
SHIELD = SkillEffectType.SHIELD.value
DMG_INVULNERABLE = SkillEffectType.DMG_INVULNERABLE.value


class TestActor130302(unittest.TestCase):
    """角色130302 想い響かせるヒーローシンガー 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 130302 想い響かせるヒーローシンガー
        # 火属性attr=1, EN型character_type=2, 后排position_type=2, 辅助role_type=4
        # AP=2, PP=2。默认Lv10，部分测试用Lv11/Lv15验证level分支
        # caster 放后排中央（与正前方 ALLY_CENTER_FRONT 形成映射）
        self.caster = UnitState(
            unit_id="caster", name="ヒーローシンガー", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=130302, level=10,
            element=1, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110053, 120117, 120118, 130125, 130126],
            skill_levels={110053: 10, 120117: 10, 120118: 10,
                          130125: 10, 130126: 10},
            skill_cooldowns={},
        )

        # 友方前排中央（caster 正前方友方，AS1 dmg_invulnerable / PS2 shield 目标）
        self.ally_front = UnitState(
            unit_id="ally_front", name="前方友方", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999101, level=10,
            element=1, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方左前（PS2 ally_front_row 多目标 + PS1 触发目标）
        self.ally_lf = UnitState(
            unit_id="ally_lf", name="左前友方", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999102, level=10,
            element=2, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=4000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央（最近敌，EN攻击主目标）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（多目标测试用）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（多目标测试用）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=25000, current_hp=25000,
            attack=6500, defense=4500, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally_front, self.ally_lf]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    # ─── reset helpers ───────────────────────────────────────

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.level = 10
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10

    def _reset_ally_front(self, hp=None, ap=10, pp=10, ep=0):
        """重置前方友方状态。"""
        self.ally_front.current_hp = hp if hp is not None else self.ally_front.max_hp
        self.ally_front.buffs = []
        self.ally_front.debuffs = []
        self.ally_front.is_alive = True
        self.ally_front.skill_cooldowns = {}
        self.ally_front.current_ap = ap
        self.ally_front.current_pp = pp
        self.ally_front.current_ep = ep

    def _reset_ally_lf(self, hp=None, ap=10, pp=10, ep=0):
        """重置左前友方状态。"""
        self.ally_lf.current_hp = hp if hp is not None else self.ally_lf.max_hp
        self.ally_lf.buffs = []
        self.ally_lf.debuffs = []
        self.ally_lf.is_alive = True
        self.ally_lf.skill_cooldowns = {}
        self.ally_lf.current_ap = ap
        self.ally_lf.current_pp = pp
        self.ally_lf.current_ep = ep

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ap = 4
            e.shield = 0
            e.physical_shield = 0
            e.en_shield = 0

    def _make_debuff(self, unit_id, effect_type='poison'):
        """Helper: create a simple debuff BuffState."""
        return BuffState(
            buff_id=f"test_{effect_type}_{unit_id}",
            name=effect_type,
            effect_type=effect_type,
            value=100.0,
            duration=3,
            timing_type=2,
            source_unit_id="enemy",
            is_debuff=True,
        )

    # ════════════════════════════════════════════════════════════════
    # EX: 110053 RAY OF HERO
    # ════════════════════════════════════════════════════════════════

    def test_ex_lv10_damage_all_enemies(self):
        """EX(110053) Block1 Lv10: 敵全体 hp_ratio_damage（caster_current_hp基数）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110053, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证全体敌方受到伤害
        for e in self.bf.enemy_team:
            self.assertLess(e.current_hp, e.max_hp,
                            f"{e.name}应受到EX hp_ratio_damage伤害")

    def test_ex_lv11_grants_self_dmg_taken_down(self):
        """EX(110053) Block2 Lv11-14: self dmg_taken_down（buff%, 1行動）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[110053] = 11

        self.ss.execute_skill(
            caster=self.caster, skill_id=110053, battlefield=self.bf, skip_cost=True
        )

        # 验证 caster 自身有 dmg_taken_down buff
        dmg_downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(dmg_downs), 0,
                           "Lv11+ caster自身应有 dmg_taken_down buff")
        self.assertEqual(dmg_downs[0].duration, 1,
                         "dmg_taken_down duration应为1")

    def test_ex_lv15_grants_self_dmg_invulnerable(self):
        """EX(110053) Block3 Lv15: self dmg_invulnerable（1行動, hit_limited=99）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[110053] = 15

        self.ss.execute_skill(
            caster=self.caster, skill_id=110053, battlefield=self.bf, skip_cost=True
        )

        # 验证 caster 自身有 dmg_invulnerable buff
        invulns = [b for b in self.caster.buffs if b.effect_type == DMG_INVULNERABLE]
        self.assertGreater(len(invulns), 0,
                           "Lv15 caster自身应有 dmg_invulnerable buff")
        self.assertEqual(invulns[0].duration, 1,
                         "dmg_invulnerable duration应为1")
        self.assertEqual(getattr(invulns[0], 'hit_limited', 0), 99,
                         "dmg_invulnerable hit_limited应为99")

    def test_ex_lv15_no_dmg_taken_down(self):
        """EX(110053) Lv15: Block2（level_max=14）跳过，无 dmg_taken_down。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[110053] = 15

        self.ss.execute_skill(
            caster=self.caster, skill_id=110053, battlefield=self.bf, skip_cost=True
        )

        # Lv15 时 Block2 跳过 → caster 无 dmg_taken_down
        dmg_downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_downs), 0,
                         "Lv15时不应有 dmg_taken_down（Block2 level_max=14跳过）")

    def test_ex_lv10_no_self_buff(self):
        """EX(110053) Lv10: 无自身 buff（Block2/3 level_min未满足）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[110053] = 10

        self.ss.execute_skill(
            caster=self.caster, skill_id=110053, battlefield=self.bf, skip_cost=True
        )

        # Lv10 时 Block2/3 跳过 → caster 无 dmg_taken_down 也无 dmg_invulnerable
        dmg_downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        invulns = [b for b in self.caster.buffs if b.effect_type == DMG_INVULNERABLE]
        self.assertEqual(len(dmg_downs), 0, "Lv10时不应有 dmg_taken_down")
        self.assertEqual(len(invulns), 0, "Lv10时不应有 dmg_invulnerable")

    def test_ex_is_en_attack(self):
        """EX(110053): EN攻撃（is_en_attack=true, damage_element=en）。"""
        parsed = self.dl.get_parsed_skill_data(110053)
        self.assertIsNotNone(parsed, "110053 应在 skill_effects_hybrid.json 中")
        for block in parsed.get('effect_blocks', []):
            for eff in block.get('effects', []):
                if eff.get('effect_type') == 'hp_ratio_damage':
                    flags = eff.get('flags', {})
                    self.assertTrue(flags.get('is_en_attack'),
                                    "hp_ratio_damage 应有 is_en_attack=true")
                    self.assertEqual(flags.get('damage_element'), 'en',
                                     "damage_element 应为 'en'")

    # ════════════════════════════════════════════════════════════════
    # AS1: 120117 カバーは任せて！
    # ════════════════════════════════════════════════════════════════

    def test_as1_grants_dmg_invulnerable_to_ally_front(self):
        """AS1(120117) Block1: ally_front dmg_invulnerable（hit_limited=2）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_ally_front()
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120117, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 ally_front 获得 dmg_invulnerable
        invulns = [b for b in self.ally_front.buffs if b.effect_type == DMG_INVULNERABLE]
        self.assertGreater(len(invulns), 0,
                           "ally_front 应获得 dmg_invulnerable")
        self.assertEqual(getattr(invulns[0], 'hit_limited', 0), 2,
                         "dmg_invulnerable hit_limited应为2")

    def test_as1_self_spd_down_100_flat(self):
        """AS1(120117) Block1: self spd_down（100固定值, stackable）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        original_spd = self.caster.speed

        self.ss.execute_skill(
            caster=self.caster, skill_id=120117, battlefield=self.bf, skip_cost=True
        )

        # 验证 caster 自身有 spd_down debuff
        spd_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_SPEED]
        self.assertGreater(len(spd_downs), 0,
                           "caster 应有 spd_down debuff")
        # value_type=flat → value_tag=1 (固定值)
        # spd_down value=100 (固定值下降100)
        self.assertTrue(spd_downs[0].is_stackable,
                        "spd_down 应可叠加")

    def test_as1_self_atk_down_percent(self):
        """AS1(120117) Block1: self atk_down（atk%, 1行動）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=120117, battlefield=self.bf, skip_cost=True
        )

        # 验证 caster 自身有 atk_down debuff
        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_downs), 0,
                           "caster 应有 atk_down debuff")
        self.assertEqual(atk_downs[0].duration, 1,
                         "atk_down duration应为1")

    def test_as1_dmg_invulnerable_nullifies_damage(self):
        """AS1(120117) dmg_invulnerable: ally_front 被攻击时伤害无效化为1点。

        通过让敌方使用 120118（enemy_all damage）攻击友方全体，验证持有
        dmg_invulnerable 的 ally_front 仅受1点伤害而非正常伤害。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_ally_front()
        self._reset_enemies()

        # Step 1: caster 施放 AS1 给 ally_front 付与 dmg_invulnerable
        self.ss.execute_skill(
            caster=self.caster, skill_id=120117, battlefield=self.bf, skip_cost=True
        )
        invulns = [b for b in self.ally_front.buffs if b.effect_type == DMG_INVULNERABLE]
        self.assertGreater(len(invulns), 0, "应有 dmg_invulnerable")
        self.assertEqual(invulns[0].hit_limited, 2,
                         "dmg_invulnerable hit_limited应为2（可无效化2次攻击）")

        # Step 2: 让 enemy_cf 使用 120118（enemy_all damage）攻击友方全体
        # 给 enemy_cf 临时添加 120118 技能
        self.enemy_cf.skills = [120118]
        self.enemy_cf.skill_levels = {120118: 10}
        self.enemy_cf.skill_cooldowns = {}
        hp_before = self.ally_front.current_hp

        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120118, battlefield=self.bf, skip_cost=True
        )

        # Step 3: 验证 ally_front 仅受1点伤害（dmg_invulnerable 无效化）
        # dmg_invulnerable threshold_pct=0 → 所有伤害无效化为1点
        hp_loss = hp_before - self.ally_front.current_hp
        self.assertLessEqual(hp_loss, 1,
                             f"ally_front 应被 dmg_invulnerable 无效化（最多受1点伤害），"
                             f"实际HP损失: {hp_loss}")

        # Step 4: 验证 hit_limited 递减（被1次攻击后从2减到1）
        invulns_after = [b for b in self.ally_front.buffs if b.effect_type == DMG_INVULNERABLE]
        if invulns_after:
            self.assertEqual(invulns_after[0].hit_limited, 1,
                             "被1次攻击后 hit_limited 应从2递减到1")

    def test_as1_dmg_invulnerable_hit_limited_2(self):
        """AS1(120117) dmg_invulnerable hit_limited=2: 2次后被消耗。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_ally_front()
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=120117, battlefield=self.bf, skip_cost=True
        )
        invulns = [b for b in self.ally_front.buffs if b.effect_type == DMG_INVULNERABLE]
        self.assertGreater(len(invulns), 0, "应有 dmg_invulnerable")
        self.assertEqual(invulns[0].hit_limited, 2,
                         "初始 hit_limited应为2")

    # ════════════════════════════════════════════════════════════════
    # AS2: 120118 みんな、ノッってる！？
    # ════════════════════════════════════════════════════════════════

    def test_as2_damage_all_enemies(self):
        """AS2(120118) Block1: 敵全体 damage（威力tag, EN攻撃）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120118, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证全体敌方受到伤害
        for e in self.bf.enemy_team:
            self.assertLess(e.current_hp, e.max_hp,
