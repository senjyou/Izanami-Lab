    # ============================================================
    # Test 5: 130122 起死回生 - 不死buff + 回血
    # ============================================================
    print("\n" + "=" * 70)
    print("  TEST 5: 130122 起死回生 - 不死")
    print("=" * 70)
    log_paths.append(run_test(
        "Test5_130122_起死回生",
