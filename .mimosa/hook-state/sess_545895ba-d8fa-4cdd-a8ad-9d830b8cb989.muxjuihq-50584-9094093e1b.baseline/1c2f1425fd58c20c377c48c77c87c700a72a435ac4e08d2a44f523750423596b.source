"""Tests for enemy character 713405 - 惨禍：エレーナ・パステルコワ.

Skills: 210102(EX), 220378(AS1), 220379(AS2), 230399(PS1), 230400(PS2)

敌方版技能与己方145301(110069/120154/120155/130152/130153)同名同机制，
差异：
- EX(210102): 対象が自身（己方は最高攻友方）；Lv10で追加伤害buff 2つ（己方Lv11+で最低攻友方にも）
- AS1(220378): 治療対象が自身（己方は最低HP友方）；発動条件 40%<=HP<80%（己方は3条件）
- AS2(220379): 機制同一、tag値簡素化
- PS1(230399): AS2回使用ごと発動（己方は4回）
- PS2(230400): on_cumulative_damage 75%発動（己方はon_ally_killed）
"""
import unittest
import sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import SkillEffectType, Position, Side

STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
ADD_DAMAGE = SkillEffectType.ADD_DAMAGE.value
HEAL_LINK = SkillEffectType.HEAL_LINK.value


def _find_aura(unit, effect_type, name=None):
    """在unit.buffs和unit.debuffs中查找指定effect_type的aura"""
    pools = list(unit.buffs) + list(unit.debuffs)
    for b in pools:
        if b.effect_type != effect_type:
            continue
        if name is not None and getattr(b, 'name', '') != name:
            continue
        return b
    return None


def _count_auras(unit, effect_type):
    """计数指定effect_type的aura数量"""
    pools = list(unit.buffs) + list(unit.debuffs)
    return sum(1 for b in pools if b.effect_type == effect_type)


# ═══════════════════════════════════════════════════════════════
# 210102 あったかいの、どうぞ♪+ (EX)
# ═══════════════════════════════════════════════════════════════

class TestEX210102(unittest.TestCase):
    """EX：自身にatk_up35%+dmg_dealt_up10%+add_damage(dmg%)付与
    Lv10+: add_damagebuff 2つ目付与"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=505594, atk=10101, defense=7841, speed=528,
                     skills=[210102, 220378, 220379, 230399, 230400], level=10, ep=10,
                     character_id=713405)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000, atk=8000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")

    def test_ex_targets_self_not_ally(self):
        """EX(210102) 应对自身施加buff，不对友方(ally)施加"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210102,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        atk_up_self = _find_aura(self.caster, STATUS_ATTACK)
        self.assertIsNotNone(atk_up_self, "caster自身应有atk_up")
        atk_up_ally = _find_aura(self.a1, STATUS_ATTACK)
        self.assertIsNone(atk_up_ally, "友方不应有atk_up")

    def test_ex_atk_up_35_pct(self):
        """EX(210102) 应对自身施加atk_up 35%"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210102,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        atk_up = _find_aura(self.caster, STATUS_ATTACK)
        self.assertIsNotNone(atk_up)
        self.assertAlmostEqual(atk_up.value, 35.0)

    def test_ex_dmg_dealt_up_10_pct(self):
        """EX(210102) 应对自身施加dmg_dealt_up 10%"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210102,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        dealt_up = _find_aura(self.caster, DEALT_DAMAGE)
        self.assertIsNotNone(dealt_up)
        self.assertAlmostEqual(dealt_up.value, 10.0)

    def test_ex_add_damage_persistent(self):
        """EX(210102) add_damage应为永続buff(duration=-1, hit_limited=0)"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210102,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        add_dmg = _find_aura(self.caster, ADD_DAMAGE)
        self.assertIsNotNone(add_dmg, "应施加add_damage buff")
        self.assertEqual(add_dmg.duration, -1)
        self.assertEqual(add_dmg.hit_limited, 0)

    def test_ex_lv10_two_add_damage_buffs(self):
        """EX(210102) Lv10应施加2个add_damage buff"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210102,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        count = _count_auras(self.caster, ADD_DAMAGE)
        self.assertEqual(count, 2, "Lv10应施加2个add_damage buff")

    def test_ex_lv1_one_add_damage_buff(self):
        """EX(210102) Lv1应仅施加1个add_damage buff"""
        self.caster.skill_levels[210102] = 1
        result = self.ss.execute_skill(caster=self.caster, skill_id=210102,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        count = _count_auras(self.caster, ADD_DAMAGE)
        self.assertEqual(count, 1, "Lv1应仅施加1个add_damage buff")


# ═══════════════════════════════════════════════════════════════
# 220378 私に任せて！+ (AS1)
# ═══════════════════════════════════════════════════════════════

class TestAS1220378(unittest.TestCase):
    """AS1：自身HP10%消費 + 自身HP回復(consume_hp×cure%) + 自身と最低HP敵に回復リンク
    発動条件: 40%<=HP<80%"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=100000, atk=10101, defense=7841, speed=528,
                     skills=[210102, 220378, 220379, 230399, 230400], level=10, ep=10,
                     character_id=713405)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000, atk=8000)
        bb.add_ally(unit_id="a2", position=Position.ALLY_LEFT_FRONT, hp=20000, atk=5000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")
        self.a2 = next(u for u in self.bf.friend_team if u.unit_id == "a2")
        self.caster.current_hp = 50000  # 50% HP

    def test_as1_heals_self(self):
        """AS1(220378) 应治疗自身"""
        hp_before = self.caster.current_hp
        result = self.ss.execute_skill(caster=self.caster, skill_id=220378,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertGreater(self.caster.current_hp, hp_before, "自身HP应增加")

    def test_as1_consume_hp_10_pct(self):
        """AS1(220378) 应消费自身当前HP的10%"""
        hp_before = self.caster.current_hp
        expected_consume = int(hp_before * 0.10)
        result = self.ss.execute_skill(caster=self.caster, skill_id=220378,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        consume_amount = hp_before - self.caster.current_hp + (self.caster.current_hp - hp_before + expected_consume)
        # HP会先消费再治疗，净变化=治疗量-消费量。检查消费是否发生
        # 实际: consume_hp先执行(HP减少), 然后heal(HP增加)
        # 净效果: heal_amount - consume_amount

    def test_as1_heal_link_self(self):
        """AS1(220378) 应对自身施加heal_link"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=220378,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        link_self = _find_aura(self.caster, HEAL_LINK)
        self.assertIsNotNone(link_self, "自身应有heal_link")

    def test_as1_heal_link_enemy_lowest_hp(self):
        """AS1(220378) 应对最低HP比例敌方(ally)施加heal_link"""
        # a2 HP=20000/20000=100%, a1 HP=50000/50000=100%
        # Need different HP ratios: set a1 to lower ratio
        self.a1.current_hp = 10000  # 20% HP ratio
        result = self.ss.execute_skill(caster=self.caster, skill_id=220378,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        link_a1 = _find_aura(self.a1, HEAL_LINK)
        self.assertIsNotNone(link_a1, "最低HP比例的a1应有heal_link")

    def test_as1_blocked_hp_above_80(self):
        """AS1(220378) HP>=80%时不发动"""
        self.caster.current_hp = 85000  # 85%
        result = self.ss.execute_skill(caster=self.caster, skill_id=220378,
                                        battlefield=self.bf, skip_cost=True)
        self.assertFalse(result.get("success", False), "HP>=80%应不发动")

    def test_as1_blocked_hp_below_40(self):
        """AS1(220378) HP<40%时不发动"""
        self.caster.current_hp = 35000  # 35%
        result = self.ss.execute_skill(caster=self.caster, skill_id=220378,
                                        battlefield=self.bf, skip_cost=True)
        self.assertFalse(result.get("success", False), "HP<40%应不发动")

    def test_as1_fires_hp_between_40_and_80(self):
        """AS1(220378) 40%<=HP<80%时发动"""
        self.caster.current_hp = 40000  # 40% exactly
        result = self.ss.execute_skill(caster=self.caster, skill_id=220378,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"], "HP=40%应发动")


# ═══════════════════════════════════════════════════════════════
# 220379 苦手なのはそこだね！ (AS2)
# ═══════════════════════════════════════════════════════════════

class TestAS2220379(unittest.TestCase):
    """AS2：敵単体に現在HP×dmg%ダメージ、上限自身ATK×max%"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=505594, atk=10101, defense=7841, speed=528,
                     skills=[210102, 220378, 220379, 230399, 230400], level=10, ep=10,
                     character_id=713405)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=100000, atk=8000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")

    def test_as2_deals_damage(self):
        """AS2(220379) 应对目标造成伤害"""
        hp_before = self.a1.current_hp
        result = self.ss.execute_skill(caster=self.caster, skill_id=220379,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertLess(self.a1.current_hp, hp_before, "目标HP应减少")

    def test_as2_damage_capped_by_atk(self):
        """AS2(220379) 伤害应受自身ATK×max%上限约束"""
        # Lv10: dmg=12.5%, max=50%
        # 目标HP=100000, dmg%=12.5% → raw=12500
        # 上限: atk=10101 × 50% = 5050.5
        # 实际伤害应 <= 5050.5 (考虑防御减算后可能更低)
        hp_before = self.a1.current_hp
        result = self.ss.execute_skill(caster=self.caster, skill_id=220379,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        damage = hp_before - self.a1.current_hp
        cap = self.caster.attack * 0.50
        self.assertLessEqual(damage, cap + 1, f"伤害{damage}应<=ATK上限{cap:.1f}")


# ═══════════════════════════════════════════════════════════════
# 230399 リラックスだよ～♪+ (PS1)
# ═══════════════════════════════════════════════════════════════

class TestPS1230399(unittest.TestCase):
    """PS1：AS2回使用ごとに自身HP回復"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=100000, atk=10101, defense=7841, speed=528,
                     skills=[210102, 220378, 220379, 230399, 230400], level=10, ep=10,
                     character_id=713405)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000, atk=8000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")
        self.caster.current_hp = 30000  # 非满血

    def test_ps1_heals_self(self):
        """PS1(230399) 应回復自身HP（直接执行PS1验证heal效果）"""
        # skill_use_count_modulo条件由trigger_service控制，
        # execute_skill不检查该条件（与ally 130152测试一致）。
        # 这里直接执行PS1验证heal效果。
        self.caster.current_hp = 30000  # 非满血
        hp_before = self.caster.current_hp
        result = self.ss.execute_skill(caster=self.caster, skill_id=230399,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertGreater(self.caster.current_hp, hp_before, "PS1应回復自身HP")

    def test_ps1_global_condition_config(self):
        """PS1(230399) global_condition应为skill_use_count_modulo=2"""
        resolved = self.ss._resolver.resolve(230399, 10)
        gc = getattr(resolved, 'global_condition', None)
        self.assertIsNotNone(gc)
        self.assertEqual(gc.get('type'), 'skill_use_count_modulo')
        self.assertEqual(gc.get('value'), 2)


# ═══════════════════════════════════════════════════════════════
# 230400 それはやりすぎ！+ (PS2)
# ═══════════════════════════════════════════════════════════════

class TestPS2230400(unittest.TestCase):
    """PS2：累計最大HP×75%ダメージ接受時発動
    自身atk_up(atk%, stackable, skill duration) + 敵全体威力攻撃"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=100000, atk=10101, defense=7841, speed=528,
                     skills=[210102, 220378, 220379, 230399, 230400], level=10, ep=10,
                     character_id=713405)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000, atk=8000)
        bb.add_ally(unit_id="a2", position=Position.ALLY_LEFT_FRONT, hp=30000, atk=5000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")
        self.a2 = next(u for u in self.bf.friend_team if u.unit_id == "a2")

    def test_ps2_triggers_at_75_pct_cumulative(self):
        """PS2(230400) 累計ダメージ>=75%最大HP時に発動"""
        # 设置累计伤害=75000 (75% of 100000)
        self.caster.cumulative_hp_damage = 75000
        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps_acts = [a for a in actions if a.skill_id == 230400]
        self.assertGreater(len(ps_acts), 0, "累计伤害75%应触发PS2")

    def test_ps2_no_trigger_below_75_pct(self):
        """PS2(230400) 累計ダメージ<75%最大HP時は発動しない"""
        self.caster.cumulative_hp_damage = 74000  # 74%
        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps_acts = [a for a in actions if a.skill_id == 230400]
        self.assertEqual(len(ps_acts), 0, "累计伤害<75%不应触发PS2")

    def test_ps2_atk_up_stackable(self):
        """PS2(230400) atk_up应为stackable + duration_type=skill
        - 配置: stackable=true, duration_type=skill
        - 技能执行期间: atk_up生效 (伤害加成)
        - 技能结束后: atk_up被清除 (duration_type=skill)
        """
        # 1. 验证配置: stackable + duration_type=skill
        resolved = self.ss._resolver.resolve(230400, 10)
        atk_up_eff = None
        for block in resolved.effect_blocks:
            for eff in block.effects:
                if eff.effect_type == 'atk_up':
                    atk_up_eff = eff
                    break
        self.assertIsNotNone(atk_up_eff, "230400应有atk_up效果")
        self.assertTrue(atk_up_eff.flags.get('stackable', False),
                        "atk_up应配置为stackable=true")

        # 2. 验证伤害加成: atk_up(value=60%)后final_atk = 10101 × 1.6 = 16161
        self.caster.crit_rate = 0.0
        hp_a1_before = self.a1.current_hp
        self.caster.cumulative_hp_damage = 75000
        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps_acts = [a for a in actions if a.skill_id == 230400]
        self.assertGreater(len(ps_acts), 0)
        self.ss._execute_trigger_actions_inline(ps_acts[:1], self.bf)
        damage_a1 = hp_a1_before - self.a1.current_hp
        self.assertGreater(damage_a1, 0, "应造成伤害")

        # 3. 验证duration_type=skill: 技能结束后atk_up应被清除
        atk_up = _find_aura(self.caster, STATUS_ATTACK)
        self.assertIsNone(atk_up, "duration_type=skill的atk_up应在技能结束后被清除")

    def test_ps2_damage_all_allies(self):
        """PS2(230400) 应对敌方全体(ally_team)造成伤害"""
        self.caster.cumulative_hp_damage = 75000
        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps_acts = [a for a in actions if a.skill_id == 230400]
        self.assertGreater(len(ps_acts), 0)
        hp_a1_before = self.a1.current_hp
        hp_a2_before = self.a2.current_hp
        self.ss._execute_trigger_actions_inline(ps_acts[:1], self.bf)
        self.assertLess(self.a1.current_hp, hp_a1_before, "a1应受到伤害")
        self.assertLess(self.a2.current_hp, hp_a2_before, "a2应受到伤害")


if __name__ == '__main__':
    unittest.main()
