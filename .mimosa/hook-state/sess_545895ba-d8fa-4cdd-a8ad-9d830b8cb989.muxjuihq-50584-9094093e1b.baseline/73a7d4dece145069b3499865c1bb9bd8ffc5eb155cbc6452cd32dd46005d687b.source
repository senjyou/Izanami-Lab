#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""角色123301 憎まれ口の大賢者 / ハリエット・ミルズ 技能效果集成测试

测试场景：
- 角色: 憎まれ口の大賢者 (character_id=123301, 水属性=2, EN型=2, 辅助=4, 后排)
- EX:  110060 治癒魔法『グレーターヒール』 (全体回血 + HOT 30% missing HP 2行动)
- AS1: 120132 攻撃魔法『ホーリーレイ』 (最近敌方+邻接2体EN攻击 + カース标记 + atk/dmg_dealt down联动)
- AS2: 120133 防御魔法『セイントバリア』 (HP最低友方dmg_invulnerable + 联动HOT)
- PS1: 130138 治癒魔法『ヒール』 (on_turn_start + 后排HOT + Lv11+前列HOT + caster_alive)
- PS2: 130139 強化魔法『スピードブースト』 (on_ally_charge_use + 充能者+1AP + spd_up)

核心机制：
- HOT基于missing_hp的30%计算 (heal_base=lost_hp)
- カース系统 (mark + linked_mark联动 + 4层削PP全解除)
- dmg_invulnerable (threshold_pct + hit_limited + linked_effect)
- caster_alive条件 (施法者死亡时HOT消失)
- on_ally_charge_use触发器 (trigger_attacker指向充能者)
"""

import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService

SET = SkillEffectType
HEAL = SET.HEAL.value
HEAL_OVER_TIME = SET.HEAL_OVER_TIME.value
MARK = SET.MARK.value
STATUS_ATTACK = SET.STATUS_ATTACK.value  # atk_up/atk_down
STATUS_SPEED = SET.STATUS_SPEED.value  # spd_up/spd_down
DEALT_DAMAGE = SET.DEALT_DAMAGE.value  # dmg_dealt_up/down
DMG_INVULNERABLE = SET.DMG_INVULNERABLE.value


