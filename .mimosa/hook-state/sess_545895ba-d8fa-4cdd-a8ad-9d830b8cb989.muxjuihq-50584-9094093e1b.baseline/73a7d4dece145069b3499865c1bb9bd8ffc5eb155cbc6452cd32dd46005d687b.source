    # ============================================================
    # EX - 治癒魔法『グレーターヒール』 (110060)
    # ============================================================

    def test_ex_heals_all_allies(self):
        """
        EX: 全体友方回血
        验证: 所有友方HP均回复
        """
        # 让所有友方HP不满
        for ally in self.all_allies:
            ally.current_hp = ally.max_hp // 2

        hp_before = {a.unit_id: a.current_hp for a in self.all_allies}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110060,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX执行失败: {result.get('error', '')}")

        # 验证所有友方HP增加
        for ally in self.all_allies:
            self.assertGreater(ally.current_hp, hp_before[ally.unit_id],
                               f"{ally.name}应被回血")

    def test_ex_applies_hot_to_all_allies(self):
        """
        EX: 赋予全体友方HOT (2行动)
        验证: 所有友方获得heal_over_time buff, duration=2, duration_type=action
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110060,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"])

        for ally in self.all_allies:
            hot_buffs = [b for b in ally.buffs if b.effect_type == HEAL_OVER_TIME]
            self.assertGreater(len(hot_buffs), 0,
                               f"{ally.name}应有HOT buff, buffs: {[b.effect_type for b in ally.buffs]}")
            self.assertEqual(hot_buffs[0].duration, 2,
                             f"HOT duration应为2, 实际={hot_buffs[0].duration}")

    def test_ex_hot_heal_based_on_missing_hp(self):
        """
        EX: HOT治疗量基于「回復後（＝付与時）の不足HP」的**快照**×30%
        验证: HOT含 heal_base=lost_hp + hot_base_snapshot(付与瞬間の不足HP)；
              结算时按快照固定值计算，不受实时HP变化影响
        """
        # 付与前HP（低于 max_hp-即时heal，确保即时heal后不满血）
        self.ally_back_left.current_hp = 3000

        self.ss.execute_skill(
            caster=self.caster, skill_id=110060,
            battlefield=self.bf, skip_cost=True,
        )

        hot_buffs = [b for b in self.ally_back_left.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertGreater(len(hot_buffs), 0, "应有HOT buff")
        hot = hot_buffs[0]
        self.assertEqual(hot.heal_base, "lost_hp",
                         f"HOT heal_base应为lost_hp, 实际={hot.heal_base}")

        # 付与瞬间（即时heal后）的不足HP
        hp_after_instant = self.ally_back_left.current_hp
        self.assertLess(hp_after_instant, self.ally_back_left.max_hp,
                        "即时heal后应仍不满血（否则快照为0无法验证）")
        missing_after_heal = self.ally_back_left.max_hp - hp_after_instant
        self.assertEqual(hot.hot_base_snapshot, missing_after_heal,
                         f"HOT快照应为「回復後」の不足HP={missing_after_heal}, 实际={hot.hot_base_snapshot}")

        expected_heal = int(hot.hot_base_snapshot * 30 / 100)

        # 改变实时HP（快照值已固定）→ HOT仍按快照计算
        self.ally_back_left.current_hp = 10000  # 实时不足HP=5000（实时会得1500）
        total_heal, _ = self.stsvc.apply_regen(self.ally_back_left, None, self.bf)
        self.assertAlmostEqual(total_heal, expected_heal, delta=1,
                               msg=f"HOT应按快照{hot.hot_base_snapshot}×30%={expected_heal}，实际={total_heal}"
                                   f"（若为1500说明走了实时不足HP）")

    # ============================================================
    # AS1 - 攻撃魔法『ホーリーレイ』 (120132)
    # ============================================================

    def test_as1_targets_nearest_enemy_and_adjacent(self):
        """
        AS1: 索敌最近敌方+邻接2体
        验证: enemy_center(最近), enemy_left, enemy_right(邻接)受到伤害
        """
        hp_before = {e.unit_id: e.current_hp for e in self.all_enemies}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120132,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1执行失败: {result.get('error', '')}")

        # 验证3个敌方都受到伤害
        for enemy in self.all_enemies:
            self.assertLess(enemy.current_hp, hp_before[enemy.unit_id],
                            f"{enemy.name}应受到伤害")

    def test_as1_applies_curse_mark(self):
        """
        AS1: 赋予カース标记
        验证: 目标获得カース mark (stackable, duration=-1)
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120132,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"])

        curse_marks = [d for d in self.enemy_center.debuffs
                       if d.effect_type == MARK and getattr(d, 'name', '') == "カース"]
        self.assertGreater(len(curse_marks), 0,
                           f"enemy_center应有カースmark, debuffs: {[(d.effect_type, getattr(d, 'name', '')) for d in self.enemy_center.debuffs]}")
        self.assertEqual(curse_marks[0].duration, -1,
                         f"カース应为永续(duration=-1), 实际={curse_marks[0].duration}")

    def test_as1_applies_linked_atk_dmg_debuff(self):
        """
        AS1: 赋予atk_down和dmg_dealt_down (linked_mark=カース)
        验证: 目标同时获得atk_down, dmg_dealt_down, linked_buff_id="カース"
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120132,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"])

        atk_downs = [d for d in self.enemy_center.debuffs if d.effect_type == STATUS_ATTACK and d.is_debuff]
        dmg_downs = [d for d in self.enemy_center.debuffs if d.effect_type == DEALT_DAMAGE and d.is_debuff]

        self.assertGreater(len(atk_downs), 0, "应有atk_down debuff")
        self.assertGreater(len(dmg_downs), 0, "应有dmg_dealt_down debuff")
        self.assertEqual(atk_downs[0].linked_buff_id, "カース",
                         f"atk_down linked_buff_id应为カース, 实际={atk_downs[0].linked_buff_id}")
        self.assertEqual(dmg_downs[0].linked_buff_id, "カース",
                         f"dmg_dealt_down linked_buff_id应为カース, 实际={dmg_downs[0].linked_buff_id}")

    def test_as1_curse_stack_to_4_removes_pp_and_marks(self):
        """
        AS1: カース叠加到4时削除PP+全解除
        验证: 第4次施加カース后, 目标PP=0, 所有カースmark消失
        """
        # 预先施加3个カースmark + 联动debuff (模拟3次AS1攻击)
        for i in range(3):
            class FakeMarkEffect:
                effect_type = "mark"
                target_type = "self"
                value = None
                value_tag = None
                value_source = None
                duration = None
                duration_type = None
                duration_tag = None
                hit_count = None
                hit_count_tag = None
                condition = None
                flags = {"mark_name": "カース", "is_buff_mark": False, "stackable": True}
                ignore_defense = 0
                ignore_shield = 0
                target_identifier = None

            self.ss._apply_aura(self.enemy_center, FakeMarkEffect(), self.bf, is_debuff=True)

        curse_count = len([d for d in self.enemy_center.debuffs
                           if d.effect_type == MARK and getattr(d, 'name', '') == "カース"])
        self.assertEqual(curse_count, 3, f"预设3个カース, 实际={curse_count}")

        # 确认目标有PP
        self.assertGreater(self.enemy_center.current_pp, 0, "目标应有PP")

        # 第4次AS1攻击 (触发削PP+全解除)
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120132,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"])

        # 验证PP被削除
        self.assertEqual(self.enemy_center.current_pp, 0,
                         f"第4个カース后PP应为0, 实际={self.enemy_center.current_pp}")

        # 验证所有カースmark消失
        curse_after = [d for d in self.enemy_center.debuffs
                       if d.effect_type == MARK and getattr(d, 'name', '') == "カース"]
        self.assertEqual(len(curse_after), 0,
                         f"カース应被全解除, 实际剩余={len(curse_after)}")

    # ============================================================
    # AS2 - 防御魔法『セイントバリア』 (120133)
    # ============================================================

    def test_as2_targets_lowest_hp_ally(self):
        """
        AS2: 索敌HP比例最低友方
        验证: ally_back_left(33% HP)获得dmg_invulnerable, 其他友方没有
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120133,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS2执行失败: {result.get('error', '')}")

        invuln_left = [b for b in self.ally_back_left.buffs if b.effect_type == DMG_INVULNERABLE]
        invuln_center = [b for b in self.ally_front_center.buffs if b.effect_type == DMG_INVULNERABLE]
        invuln_right = [b for b in self.ally_back_right.buffs if b.effect_type == DMG_INVULNERABLE]
        invuln_caster = [b for b in self.caster.buffs if b.effect_type == DMG_INVULNERABLE]

        self.assertGreater(len(invuln_left), 0,
                           "HP比例最低的ally_back_left应获得dmg_invulnerable")
        self.assertEqual(len(invuln_center), 0, "ally_front_center不应获得dmg_invulnerable")
        self.assertEqual(len(invuln_right), 0, "ally_back_right不应获得dmg_invulnerable")
        self.assertEqual(len(invuln_caster), 0, "caster不应获得dmg_invulnerable")

    def test_as2_dmg_invulnerable_threshold_and_hit_limited(self):
        """
        AS2: dmg_invulnerable阈值(35%当前HP) + hit_limited(2)
        验证: buff.threshold_pct=0.35, hit_limited=2
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120133,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"])

        invuln_buffs = [b for b in self.ally_back_left.buffs if b.effect_type == DMG_INVULNERABLE]
        self.assertGreater(len(invuln_buffs), 0, "应有dmg_invulnerable buff")
        invuln = invuln_buffs[0]

        # threshold_pct: 35% = 0.35
        self.assertAlmostEqual(invuln.threshold_pct, 0.35, delta=0.001,
                               msg=f"threshold_pct应为0.35, 实际={invuln.threshold_pct}")
        # hit_limited: 2
        self.assertEqual(invuln.hit_limited, 2,
                         f"hit_limited应为2, 实际={invuln.hit_limited}")

    def test_as2_applies_linked_hot(self):
        """
        AS2: 赋予联动HOT
        验证: 同一目标获得HOT, source_skill_id与dmg_invulnerable相同
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120133,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"])

        invuln_buffs = [b for b in self.ally_back_left.buffs if b.effect_type == DMG_INVULNERABLE]
        hot_buffs = [b for b in self.ally_back_left.buffs if b.effect_type == HEAL_OVER_TIME]

        self.assertGreater(len(invuln_buffs), 0, "应有dmg_invulnerable")
        self.assertGreater(len(hot_buffs), 0, "应有HOT")

        # 验证source_skill_id相同
        self.assertEqual(invuln_buffs[0].source_skill_id, hot_buffs[0].source_skill_id,
                         "dmg_invulnerable和HOT应来自同一技能")

    # ============================================================
    # PS1 - 治癒魔法『ヒール』 (130138)
    # ============================================================

    def test_ps1_triggers_on_turn_start(self):
        """
        PS1: on_turn_start触发
        验证: 调用trigger_turn_start后, PS(130138)被触发
        """
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}

        trigger_actions = self.ts.trigger_turn_start(self.bf)
        ps_triggered = any(a.skill_id == 130138 for a in trigger_actions)
        self.assertTrue(ps_triggered,
                        f"PS(130138)应在回合开始时触发, actions: {[a.skill_id for a in trigger_actions]}")

    def test_ps1_applies_hot_to_ally_back(self):
        """
        PS1: HOT施加给后排友方 (含自身, 因caster在后排)
        验证: caster(后排), ally_back_left(后排), ally_back_right(后排)获得HOT; ally_front_center(前排)无HOT (Lv10)
        """
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}

        trigger_actions = self.ts.trigger_turn_start(self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130138]
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 后排3人应有HOT
        for ally in [self.caster, self.ally_back_left, self.ally_back_right]:
            hot = [b for b in ally.buffs if b.effect_type == HEAL_OVER_TIME]
            self.assertGreater(len(hot), 0, f"{ally.name}(后排)应有HOT")

        # 前排不应有HOT (Lv10 < 11)
        front_hot = [b for b in self.ally_front_center.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(front_hot), 0, "ally_front_center(前排)不应有HOT (Lv10)")

    def test_ps1_lv11_applies_hot_to_ally_front(self):
        """
        PS1 Lv11+: HOT同时施加给前列友方
        验证: Lv11时, 前排友方也获得HOT (Block2条件: active_level_min=11)
        """
        # 设置PS技能等级为11
        self.caster.skill_levels[130138] = 11
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}

        trigger_actions = self.ts.trigger_turn_start(self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130138]
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 后排3人应有HOT
        for ally in [self.caster, self.ally_back_left, self.ally_back_right]:
            hot = [b for b in ally.buffs if b.effect_type == HEAL_OVER_TIME]
            self.assertGreater(len(hot), 0, f"{ally.name}(后排)应有HOT")

        # 前排也应有HOT (Lv11+)
        front_hot = [b for b in self.ally_front_center.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertGreater(len(front_hot), 0, "ally_front_center(前排)应有HOT (Lv11+)")

    def test_ps1_caster_alive_condition(self):
        """
        PS1: caster_alive条件
        验证: 施法者死亡时, HOT buff自动消失 (apply_hot_regenerate中检查)
        """
        # 施加PS1的HOT
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}
        trigger_actions = self.ts.trigger_turn_start(self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130138]
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证后排有HOT
        hot_before = [b for b in self.ally_back_left.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertGreater(len(hot_before), 0, "应先有HOT")
        self.assertTrue(hot_before[0].caster_alive, "HOT应有caster_alive标记")

        # 施法者死亡
        self.caster.is_alive = False

        # 手动结算HOT - 应触发caster_alive移除
        self.stsvc.apply_regen(self.ally_back_left, None, self.bf)

        # 验证HOT被移除
        hot_after = [b for b in self.ally_back_left.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hot_after), 0, "施法者死亡后HOT应被移除")

    # ============================================================
    # PS2 - 強化魔法『スピードブースト』 (130139)
    # ============================================================

    def test_ps2_triggers_on_ally_charge_use(self):
        """
        PS2: on_ally_charge_use触发
        验证: 调用trigger_ally_charge_use后, PS(130139)被触发
        """
        self.caster.current_pp = 1
        self.caster.skill_cooldowns = {}

        # 模拟友方使用充能技能 (ally_front_center作为charger)
        trigger_actions = self.ts.trigger_ally_charge_use(self.ally_front_center, self.bf)
        ps_triggered = any(a.skill_id == 130139 for a in trigger_actions)
        self.assertTrue(ps_triggered,
                        f"PS(130139)应在友方充能时触发, actions: {[a.skill_id for a in trigger_actions]}")

    def test_ps2_add_ap_to_charger(self):
        """
        PS2: add_ap施加给充能者 (target_identifier=trigger_attacker)
        验证: 充能者(ally_front_center)的AP+1, 其他友方AP不变
        """
        self.caster.current_pp = 1
        self.caster.skill_cooldowns = {}

        # 记录AP before
        ap_charger_before = self.ally_front_center.current_ap
        ap_caster_before = self.caster.current_ap
        ap_left_before = self.ally_back_left.current_ap
        ap_right_before = self.ally_back_right.current_ap

        # 触发PS2
        trigger_actions = self.ts.trigger_ally_charge_use(self.ally_front_center, self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130139]

        # 手动执行PS2 (设置_trigger_attacker为充能者)
        for action in ps_actions:
            charger = action.parameters.get('trigger_attacker')
            self.assertEqual(charger.unit_id, self.ally_front_center.unit_id,
                             "trigger_attacker应为充能者")
            self.ss._trigger_attacker = charger
            self.ss.execute_skill(
                caster=self.caster, skill_id=130139,
                battlefield=self.bf, skip_cost=True,
            )
            self.ss._trigger_attacker = None

        # 验证充能者AP+1
        self.assertEqual(self.ally_front_center.current_ap, ap_charger_before + 1,
                         f"充能者AP应+1: {ap_charger_before} -> {self.ally_front_center.current_ap}")
        # 验证其他友方AP不变
        self.assertEqual(self.caster.current_ap, ap_caster_before, "caster AP不应变化")
        self.assertEqual(self.ally_back_left.current_ap, ap_left_before, "ally_back_left AP不应变化")
        self.assertEqual(self.ally_back_right.current_ap, ap_right_before, "ally_back_right AP不应变化")

    def test_ps2_spd_up_to_charger(self):
        """
        PS2: spd_up施加给充能者 (target_identifier=trigger_attacker)
        验证: 充能者(ally_front_center)获得spd_up buff, 其他友方无
        """
        self.caster.current_pp = 1
        self.caster.skill_cooldowns = {}

        # 触发PS2
        trigger_actions = self.ts.trigger_ally_charge_use(self.ally_front_center, self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130139]

        for action in ps_actions:
            charger = action.parameters.get('trigger_attacker')
            self.ss._trigger_attacker = charger
            self.ss.execute_skill(
                caster=self.caster, skill_id=130139,
                battlefield=self.bf, skip_cost=True,
            )
            self.ss._trigger_attacker = None

        # 验证充能者有spd_up buff
        charger_spd_ups = [b for b in self.ally_front_center.buffs if b.effect_type == STATUS_SPEED and not b.is_debuff]
        self.assertGreater(len(charger_spd_ups), 0,
                           f"充能者应有spd_up buff, buffs: {[b.effect_type for b in self.ally_front_center.buffs]}")
        self.assertEqual(charger_spd_ups[0].duration, 1,
                         f"spd_up duration应为1, 实际={charger_spd_ups[0].duration}")

        # 验证其他友方无spd_up
        caster_spd_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_SPEED and not b.is_debuff]
        left_spd_ups = [b for b in self.ally_back_left.buffs if b.effect_type == STATUS_SPEED and not b.is_debuff]
        right_spd_ups = [b for b in self.ally_back_right.buffs if b.effect_type == STATUS_SPEED and not b.is_debuff]

        self.assertEqual(len(caster_spd_ups), 0, "caster不应有spd_up")
        self.assertEqual(len(left_spd_ups), 0, "ally_back_left不应有spd_up")
        self.assertEqual(len(right_spd_ups), 0, "ally_back_right不应有spd_up")

    def test_ps2_does_not_trigger_when_charger_is_caster_self(self):
        """
        PS2: 自身充能不触发 (描述: 他の味方がチャージスキルを使用した際)
        验证: caster自身作为charger时, PS(130139)不被触发
        """
        self.caster.current_pp = 1
        self.caster.skill_cooldowns = {}

        # caster自身作为charger
        trigger_actions = self.ts.trigger_ally_charge_use(self.caster, self.bf)
        ps_triggered = any(a.skill_id == 130139 for a in trigger_actions)
        self.assertFalse(ps_triggered,
                         f"自身充能不应触发PS(130139), actions: {[a.skill_id for a in trigger_actions]}")


if __name__ == '__main__':
    unittest.main()
