#!/usr/bin/env python
# -*- coding: utf-8 -*-

import unittest
import sys
from pathlib import Path
from unittest.mock import MagicMock

# 添加项目根目录到路径
sys.path.insert(0, str(Path(__file__).parent.parent))

from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.enums import Side, Position, Attribute, CharacterType, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService

class TestResourceService(unittest.TestCase):
    
    def setUp(self):
        self.service = ResourceService()
        self.unit = UnitState(
            unit_id="test_unit",
            name="Test Unit",
            side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT,
            character_id=1001,
            level=50,
            element=Attribute.FIRE,
            character_type=CharacterType.PHYSICAL,
            max_hp=1000,
            attack=100,
            defense=50,
            speed=100,
            crit_rate=0.1,
            crit_damage=1.5,
            advantage_damage=1.5,
            initial_active_point=4,
            initial_passive_point=4,
            max_extra_point=100,
            current_hp=1000,
            current_ap=4,
            current_pp=4,
            current_ep=0
        )
        
    def test_consume_ap(self):
        # 正常消耗
        self.assertTrue(self.service.consume_ap(self.unit, 2))
        self.assertEqual(self.unit.current_ap, 2)
        
        # 消耗过多
        self.assertFalse(self.service.consume_ap(self.unit, 3))
        self.assertEqual(self.unit.current_ap, 2) # 保持不变
        
        # 消耗全部
        self.assertTrue(self.service.consume_ap(self.unit, 2))
        self.assertEqual(self.unit.current_ap, 0)
        
    def test_consume_pp(self):
        # 正常消耗
        self.assertTrue(self.service.consume_pp(self.unit, 1))
        self.assertEqual(self.unit.current_pp, 3)
        
        # 消耗超过
        self.assertFalse(self.service.consume_pp(self.unit, 4))
        self.assertEqual(self.unit.current_pp, 3)
        
    def test_consume_ep(self):
        self.unit.current_ep = 50
        
        # 正常消耗
        self.assertTrue(self.service.consume_ep(self.unit, 30))
        self.assertEqual(self.unit.current_ep, 20)
        
        # 消耗过多
        self.assertFalse(self.service.consume_ep(self.unit, 21))
        
    def test_consume_ep_for_ex(self):
        # EP未满
        self.unit.current_ep = 99
        self.assertFalse(self.service.consume_ep_for_ex(self.unit))
        self.assertEqual(self.unit.current_ep, 99)
        
        # EP满
        self.unit.current_ep = 100
        self.assertTrue(self.service.consume_ep_for_ex(self.unit))
        self.assertEqual(self.unit.current_ep, 0)
        
    def test_restore_ap_pp(self):
        # 模拟消耗了一部分，并且有buff可能增加了上限逻辑(虽然这里只测恢复到initial)
        self.unit.current_ap = 1
        self.unit.current_pp = 0
        
        self.service.restore_ap_pp(self.unit)
        
        self.assertEqual(self.unit.current_ap, 4)
        self.assertEqual(self.unit.current_pp, 4)
        
        # 测试突破上限的情况重置
        self.unit.current_ap = 10 # 假设通过技能突破了上限
        self.service.restore_ap_pp(self.unit)
        self.assertEqual(self.unit.current_ap, 4) # 应该重置回初始值
        
    def test_generate_ep(self):
        self.unit.current_ep = 0
        
        # 正常增加
        self.service.generate_ep(self.unit, 50)
        self.assertEqual(self.unit.current_ep, 50)
        
        # 溢出检查
        self.service.generate_ep(self.unit, 60)
        self.assertEqual(self.unit.current_ep, 100) # Max is 100

    def test_generate_ep_with_ep_gain_down(self):
        """EpGainDown debuff应按百分比削减自然回EP（apply_ep_gain_down=True）"""
        self.unit.current_ep = 0
        # 施加50% EpGainDown
        self.unit.debuffs.append(BuffState(
            buff_id="test_epgd", name="EpGainDown",
            effect_type=SkillEffectType.EP_GAIN_DOWN.value, value=50.0,
            duration=1, timing_type=4,
        ))
        # 自然回EP：base=10, 削减50% -> +5
        self.service.generate_ep(self.unit, 10, apply_ep_gain_down=True)
        self.assertAlmostEqual(self.unit.current_ep, 5.0)
        # 再+10 base -> +5 -> 10
        self.service.generate_ep(self.unit, 10, apply_ep_gain_down=True)
        self.assertAlmostEqual(self.unit.current_ep, 10.0)

    def test_generate_ep_skill_effect_not_affected_by_ep_gain_down(self):
        """技能直接EP增减（add_ep效果，apply_ep_gain_down=False）不受EpGainDown影响"""
        self.unit.current_ep = 0
        self.unit.debuffs.append(BuffState(
            buff_id="test_epgd", name="EpGainDown",
            effect_type=SkillEffectType.EP_GAIN_DOWN.value, value=50.0,
            duration=1, timing_type=4,
        ))
        # 技能直接EP增减：base=10, 不受debuff影响 -> +10
        self.service.generate_ep(self.unit, 10)
        self.assertEqual(self.unit.current_ep, 10)

    def test_generate_ep_multiple_ep_gain_down_take_max(self):
        """多个EpGainDown COEXIST时取MAX"""
        self.unit.current_ep = 0
        self.unit.debuffs.append(BuffState(
            buff_id="test_epgd1", name="EpGainDown",
            effect_type=SkillEffectType.EP_GAIN_DOWN.value, value=30.0,
            duration=1, timing_type=4,
        ))
        self.unit.debuffs.append(BuffState(
            buff_id="test_epgd2", name="EpGainDown",
            effect_type=SkillEffectType.EP_GAIN_DOWN.value, value=50.0,
            duration=1, timing_type=4,
        ))
        # 自然回EP：base=10, 取MAX(50%)削减 -> +5
        self.service.generate_ep(self.unit, 10, apply_ep_gain_down=True)
        self.assertAlmostEqual(self.unit.current_ep, 5.0)

    def test_generate_ep_no_debuff_normal(self):
        """无EpGainDown debuff时EP正常获取"""
        self.unit.current_ep = 0
        self.assertEqual(len(self.unit.debuffs), 0)
        self.service.generate_ep(self.unit, 10, apply_ep_gain_down=True)
        self.assertEqual(self.unit.current_ep, 10)

if __name__ == '__main__':
    unittest.main()
