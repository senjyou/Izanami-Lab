"""Generate skill_effects_hybrid.json entries for S6 若雷 (161730551) - 4 skills.
Merges into existing skill_effects_hybrid.json, preserving existing entries.

Skills:
    220360 若ノ掃射 (AS) - enemy_row_of_lowest_def damage + split_heal_by_damage ally_all 100%
    220361 若ノ双弾 (AS) - 2 targets (low def) damage + split_heal_by_damage HP低2体 100% + self dmg_dealt_up 25%
    230383 若ノ再生 (PS) - after_ally_attacked heal trigger_attacker 35
    230384 若ノ減衰 (PS) - before_ally_attacked skill_power_down 50% (同時発動制限, target_is_back_row_attacker)

Requires new effect_type: split_heal_by_damage, skill_power_down
Requires new target_type: enemy_row_of_lowest_def, enemy_single_lowest_def_x2, ally_single_lowest_hp_x2
Requires new trigger_type: before_ally_attacked
Requires new global_condition: target_is_back_row_attacker

Usage:
    python scripts/_import_s6_skill_effects_ruolei.py
"""
from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HYBRID_JSON = ROOT / "data" / "skill_effects_hybrid.json"
SKILLS_JSON = ROOT / "data" / "skills.json"

EFFECT_TEMPLATE = {
    "effect_type": None,
    "target_type": None,
    "target_identifier": None,
    "value": None,
    "value_tag": None,
    "value_source": None,
    "duration": None,
    "duration_type": None,
    "duration_tag": None,
    "hit_count": None,
    "hit_count_tag": None,
    "condition": None,
    "flags": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
}

SKILL_TEMPLATE = {
    "skill_id": None,
    "name": None,
    "skill_type": None,
    "resource_cost": None,
    "cooldown": None,
    "cooldown_update_timing": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
    "trigger_type": None,
    "global_condition": None,
    "effect_blocks": [],
    "display_target_priority": None,
    "display_target_range": None,
    "display_target_type": None,
    "parse_status": "manual",
    "parse_notes": [],
    "simultaneous_limit": None,
}


def make_effect(**kwargs) -> dict:
    eff = {k: v for k, v in EFFECT_TEMPLATE.items()}
    for k, v in kwargs.items():
        eff[k] = v
    return eff


def make_block(block_id: int, effects: list, condition=None) -> dict:
    return {"block_id": block_id, "condition": condition, "effects": effects}


def make_skill(**kwargs) -> dict:
    skill = {k: v for k, v in SKILL_TEMPLATE.items()}
    for k, v in kwargs.items():
        if k in skill:
            skill[k] = v
        else:
            skill[k] = v
    return skill


def load_skills_meta() -> dict[int, dict]:
    with SKILLS_JSON.open("r", encoding="utf-8") as fh:
        data = json.load(fh)
    out: dict[int, dict] = {}
    for k, v in data.items():
        try:
            sid = int(k)
        except (TypeError, ValueError):
            continue
        out[sid] = v
    return out


def build_ruolei(skills_meta: dict[int, dict]) -> dict[str, dict]:
    out: dict[str, dict] = {}

    # 220360 若ノ掃射 (AS) - enemy_row_of_lowest_def damage + split_heal_by_damage ally_all
    meta = skills_meta[220360]
    out["220360"] = make_skill(
        skill_id=220360,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_row_of_lowest_def",
                    value_tag="威力",
                    hit_count=1,
                    flags={"is_en_attack": True},
                ),
                make_effect(
                    effect_type="split_heal_by_damage",
                    target_type="ally_all",
                    value=100,
                    value_type="percent",
                    flags={
                        "source_block_id": 1,
                        "split_among_targets": True,
                    },
                ),
            ]),
        ],
        display_target_range=6,
        display_target_type=3,
        parse_notes=["AS: 防御最低敵所在横列EN + 与ダメ100%味方全体均等分配回復"],
    )

    # 220361 若ノ双弾 (AS) - 2 targets (low def) + split_heal (HP低2体) + self dmg_dealt_up 25%
    meta = skills_meta[220361]
    out["220361"] = make_skill(
        skill_id=220361,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_single_lowest_def_x2",
                    value_tag="威力",
                    hit_count=1,
                    flags={"target_count": 2, "is_en_attack": True},
                ),
                make_effect(
                    effect_type="split_heal_by_damage",
                    target_type="ally_single_lowest_hp_x2",
                    value=100,
                    value_type="percent",
                    flags={
                        "source_block_id": 1,
                        "split_among_targets": True,
                        "target_count": 2,
                    },
                ),
            ]),
            make_block(2, [
                make_effect(
                    effect_type="dmg_dealt_up",
                    target_type="self",
                    value=25.0,
                    duration=1,
                    duration_type="action",
                    flags={"value_type": "percent", "stackable": True},
                ),
            ]),
        ],
        display_target_range=2,
        display_target_type=3,
        parse_notes=["AS: 防御低2体EN + 与ダメ100%HP低2体分配回復 + 自身与ダメ+25% (1行動, 重複可)"],
    )

    # 230383 若ノ再生 (PS) - after_ally_attacked heal trigger_attacker 35
    meta = skills_meta[230383]
    out["230383"] = make_skill(
        skill_id=230383,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type="after_ally_attacked",
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="heal",
                    target_type="ally_single",
                    target_identifier="trigger_attacker",
                    value=35.0,
                    hit_count=1,
                    flags={},
                ),
            ]),
        ],
        display_target_range=1,
        display_target_type=2,
        parse_notes=["PS: 味方被攻撃後 受击者威力35回復"],
    )

    # 230384 若ノ減衰 (PS) - before_ally_attacked + skill_power_down 50% (同時発動制限, target_is_back_row_attacker)
    meta = skills_meta[230384]
    out["230384"] = make_skill(
        skill_id=230384,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type="before_as_attacked",
        global_condition={"type": "attacker_is_back_row"},
        simultaneous_limit=True,
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="skill_power_down",
                    target_type="enemy_single",
                    target_identifier="trigger_attacker",
                    value=50.0,
                    value_type="percent",
                    duration=1,
                    duration_type="attacker_action",
                    flags={},
                ),
            ]),
        ],
        display_target_range=1,
        display_target_type=3,
        parse_notes=["PS: 後列敵からの攻撃直前 当該敵威力-50% (attacker_action, 同時発動制限)"],
    )

    return out


def main() -> None:
    skills_meta = load_skills_meta()
    new_entries = build_ruolei(skills_meta)
    print(f"[INFO] Built {len(new_entries)} 若雷 skill entries")

    with HYBRID_JSON.open("r", encoding="utf-8") as fh:
        hybrid = json.load(fh)
    print(f"[INFO] Loaded {len(hybrid)} existing skill_effects_hybrid.json entries")

    added: list[int] = []
    skipped: list[int] = []
    for sid_str, entry in new_entries.items():
        if sid_str in hybrid:
            skipped.append(int(sid_str))
            continue
        hybrid[sid_str] = entry
        added.append(int(sid_str))

    print(f"[INFO] Added: {added}")
    if skipped:
        print(f"[INFO] Skipped (already present): {skipped}")

    with HYBRID_JSON.open("w", encoding="utf-8") as fh:
        json.dump(hybrid, fh, ensure_ascii=False, indent=2)
    print(f"[OK] Wrote {HYBRID_JSON}")


if __name__ == "__main__":
    main()
