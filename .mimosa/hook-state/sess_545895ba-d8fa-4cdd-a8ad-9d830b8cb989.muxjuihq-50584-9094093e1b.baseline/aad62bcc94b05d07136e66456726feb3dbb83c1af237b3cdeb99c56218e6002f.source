"""Regression: ぜ～～ったい負けないから！ (130081) must trigger after genwaku expires.

Bug: skill_use_count_modulo used `count % val == 0` (division). When genwaku
     blocked the PS on the AS use that reached the threshold (count=3), the
     counter was preserved but the next AS use made count=4, and 4 % 3 != 0,
     so the PS never triggered. A complex pending mechanism was added to work
     around this, but it was unnecessary.

Fix: Use `count >= val` instead of `count % val == 0`. PS execution clears the
     counter; when PS is blocked (genwaku/PP insufficient), the counter is
     preserved, so the next AS use still satisfies count >= val and triggers.

Scenario:
  1. Unit has genwaku (duration=1) + AS count=2
  2. AS skill used (genwaku active) → count=3, PS blocked by genwaku
  3. Action ends, genwaku expires (duration decremented to 0)
  4. Next AS skill used → count=4, 4 >= 3 → PS triggers
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'src'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.battle_flow_controller import BattleFlowController

ZETTAI_MAKENAI = 130081      # ぜ～～ったい負けないから！ (on_skill_use_count, >= 3)
AS_SKILL = 120068            # ゴーストハザード (AS, 敵3体に2ヒットEN攻撃)
GENWAKU = SkillEffectType.GENWAKU.value


def _make_unit(unit_id, name, side, position, *, hp=1000000, atk=10000,
               defense=5000, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ap=10, crit_rate=0.0):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=15, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=20, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_genwaku_buff(caster_id, duration=1):
    return BuffState(
        buff_id=f"{caster_id}_genwaku_test",
        name=GENWAKU,
        effect_type=GENWAKU,
        value=50.0,
        duration=duration,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=caster_id,
        is_debuff=True,
    )


class TestRegGenwakuSkillCountGte(unittest.TestCase):
    """ぜ～～ったい負けないから！ must trigger after genwaku expires.

    Uses >= instead of % == 0 so that a blocked PS preserves the counter,
    and the next AS use still satisfies the threshold.
    """

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup_battle(self):
        bf = BattlefieldState()

        unit_a = _make_unit(
            "ally_a", "UnitA", Side.ALLY,
            Position.ALLY_CENTER_FRONT,
            hp=1000000, atk=50000, speed=900, pp=10, ap=20,
            skills=[AS_SKILL, ZETTAI_MAKENAI],
            skill_levels={AS_SKILL: 15, ZETTAI_MAKENAI: 15},
        )
        unit_a.skill_use_count = {AS_SKILL: 2}

        unit_b = _make_unit(
            "enemy_b", "UnitB", Side.ENEMY,
            Position.ENEMY_CENTER_FRONT,
            hp=1000000, atk=1000, speed=500, pp=10, ap=10,
            skills=[], skill_levels={},
        )

        bf.friend_team = [unit_a]
        bf.enemy_team = [unit_b]

        controller = BattleFlowController(bf, data_loader=self.dl)
        controller._build_display_names()
        controller.skill_service.set_battlefield(bf)
        controller._deferred_crit_triggers = []

        return bf, unit_a, unit_b, controller

    def _record_executions(self, controller):
        execution_log = []
        original_execute = controller.skill_service.execute_skill

        def recording_execute(*args, **kwargs):
            result = original_execute(*args, **kwargs)
            skill_id = kwargs.get('skill_id')
            caster = kwargs.get('caster')
            if skill_id and caster:
                execution_log.append(skill_id)
            return result

        controller.skill_service.execute_skill = recording_execute
        return execution_log

    def test_ps_triggers_after_genwaku_expires(self):
        """Genwaku blocks PS on the AS use that reaches count=3.
        After genwaku expires, the next AS use (count=4, 4>=3) triggers PS.
        """
        bf, unit_a, unit_b, controller = self._setup_battle()
        execution_log = self._record_executions(controller)

        # Apply genwaku (duration=1, expires at action end)
        genwaku = _make_genwaku_buff("external_caster", duration=1)
        unit_a.debuffs.append(genwaku)
        unit_a.is_genwaku = True

        # 1st action: AS skill used with genwaku active
        controller._execute_unit_action(unit_a, turn=1)

        # PS should NOT have triggered (genwaku blocked check_triggers)
        self.assertNotIn(ZETTAI_MAKENAI, execution_log,
                         f"PS should not trigger during genwaku. Log: {execution_log}")

        # AS count should be 3 (2 pre-set + 1)
        as_count = unit_a.skill_use_count.get(AS_SKILL, 0)
        self.assertEqual(as_count, 3,
                         f"AS count should be 3 after 1st AS use. skill_use_count={dict(unit_a.skill_use_count)}")

        # Expire genwaku (simulates _process_aura_expiry in execute_turn)
        controller._process_aura_expiry(unit_a)
        self.assertFalse(unit_a.is_genwaku,
                         "Genwaku should have expired after _process_aura_expiry")

        # Reset cooldown so AS skill is selectable on 2nd action
        unit_a.skill_cooldowns = {}

        # 2nd action: AS skill used, genwaku expired
        controller._execute_unit_action(unit_a, turn=2)

        # PS SHOULD have triggered (count=4 >= 3)
        self.assertIn(ZETTAI_MAKENAI, execution_log,
                      f"PS should trigger after genwaku expires (count=4>=3). Log: {execution_log}")

    def test_ps_triggers_normally_without_genwaku(self):
        """Without genwaku, PS triggers when count reaches 3 (3 >= 3)."""
        bf, unit_a, unit_b, controller = self._setup_battle()
        execution_log = self._record_executions(controller)

        # No genwaku - normal scenario
        controller._execute_unit_action(unit_a, turn=1)

        # PS should trigger (count=3, 3 >= 3)
        self.assertIn(ZETTAI_MAKENAI, execution_log,
                      f"PS should trigger normally at count=3. Log: {execution_log}")

    def test_ps_does_not_trigger_below_threshold(self):
        """PS should not trigger when count < 3."""
        bf, unit_a, unit_b, controller = self._setup_battle()
        execution_log = self._record_executions(controller)

        # Set count=1, so after AS use count=2, 2 < 3, no trigger
        unit_a.skill_use_count = {AS_SKILL: 1}

        controller._execute_unit_action(unit_a, turn=1)

        self.assertNotIn(ZETTAI_MAKENAI, execution_log,
                         f"PS should not trigger at count=2 (<3). Log: {execution_log}")

    def test_counter_cleared_after_ps_execution(self):
        """After PS executes successfully, AS skill_use_count is cleared.
        Next trigger requires 3 more AS uses.
        """
        bf, unit_a, unit_b, controller = self._setup_battle()
        execution_log = self._record_executions(controller)

        # 1st action: count=3, PS triggers, counter cleared
        controller._execute_unit_action(unit_a, turn=1)
        self.assertIn(ZETTAI_MAKENAI, execution_log,
                      "PS should trigger at count=3")

        # After PS execution, AS count should be cleared
        as_count_after = unit_a.skill_use_count.get(AS_SKILL, 0)
        self.assertEqual(as_count_after, 0,
                         f"AS count should be cleared after PS execution. skill_use_count={dict(unit_a.skill_use_count)}")


if __name__ == '__main__':
    unittest.main()
