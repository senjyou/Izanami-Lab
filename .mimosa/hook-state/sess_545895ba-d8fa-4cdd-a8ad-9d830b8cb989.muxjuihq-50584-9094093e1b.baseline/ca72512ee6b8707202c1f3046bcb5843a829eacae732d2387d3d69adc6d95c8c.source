"""检查 MemorySkillMaster 和 EnemySkillMaster 的字段结构。"""
import json

with open('split_data/MemorySkillMaster.json', encoding='utf-8') as f:
    memory_skills = json.load(f)

with open('split_data/EnemySkillMaster.json', encoding='utf-8') as f:
    enemy_skills = json.load(f)

print(f'=== MemorySkillMaster: {len(memory_skills)} 条 ===')
if memory_skills:
    print('First record keys:', list(memory_skills[0].keys()))
    print('First record:', json.dumps(memory_skills[0], ensure_ascii=False, indent=2)[:1500])
    print()
    # 显示所有 skillId 字段值
    print('All memory skill IDs (first 20):')
    for skill in memory_skills[:20]:
        print(f'  id={skill.get("id")} memorySkillId={skill.get("memorySkillId")} skillId={skill.get("skillId")} name={skill.get("name", "")}')

print()
print(f'=== EnemySkillMaster: {len(enemy_skills)} 条 ===')
if enemy_skills:
    print('First record keys:', list(enemy_skills[0].keys()))
    print('First record:', json.dumps(enemy_skills[0], ensure_ascii=False, indent=2)[:1500])
    print()
    print('All enemy skill IDs (first 20):')
    for skill in enemy_skills[:20]:
        print(f'  id={skill.get("id")} enemySkillId={skill.get("enemySkillId")} skillId={skill.get("skillId")} name={skill.get("name", "")}')
