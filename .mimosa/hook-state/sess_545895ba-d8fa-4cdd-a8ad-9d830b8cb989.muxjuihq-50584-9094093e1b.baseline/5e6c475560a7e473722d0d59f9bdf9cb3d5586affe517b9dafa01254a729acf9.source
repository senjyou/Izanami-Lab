#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
角色112301「渇望秘めし淑女」技能验证测试

技能列表:
  - 110011 乙女の高ぶり (EX): 敌全体EN攻击 + lifesteal(25%) + Lv11+ 3行动炎上(ATK×30%)
  - 120020 禅刃再生 (AS): 敌单体EN攻击 + lifesteal(cure%) + 目标为EN类型时PP-1
  - 120038 桜華の舞 (AS): 敌单体EN攻击 + HP比例伤害加成(+{up}% max)
  - 130029 鬼神活性 (PS): on_turn_end 自身dmg_dealt_up(可叠加), round>1才触发
  - 130045 茶鬼舞踏 (PS): before_skill_use 自身atk_up + crit_rate_up(HP比例)
"""

import sys
import os
import time
import logging
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities.memory_card import MemoryCard, MemoryHighlight
from src.entities_v2.enums import Side, Position
from src.entities_v2.custom_dummy import (
    CustomDummyConfig, build_synthetic_character_data, build_custom_skill_data,
    build_custom_parsed_skill, collect_custom_skill_ids,
)
from src.combat_v2.battle_flow_controller import BattleFlowController
from src.combat_v2.battle_narrative import BattleNarrativeWriter
from src.data.data_loader import DataLoader
from src.data.stat_calculator import StatCalculator
from src.config.panel_config import PanelConfig, ModuleConfig
from src.config.player_config import SchoolLevels


class LogCaptureHandler(logging.Handler):
    def __init__(self):
        super().__init__()
        self.records = []

    def emit(self, record):
        self.records.append(record.getMessage())


def create_dummy_unit(data_loader, name, side, pos, char_id, hp, atk, defense, speed,
                      ap, pp, ep_max=8, role_type=0, position_type=3, element=1, char_type=1):
    cfg = CustomDummyConfig(
        name=name,
        element=element,
        character_type=char_type,
        position_type=position_type,
        role_type=role_type if role_type > 0 else 1,
        hp=hp,
        attack=atk,
        defense=defense,
        speed=speed,
        ap=ap,
        pp=pp,
    )
    char_data = build_synthetic_character_data(abs(char_id) - 1, cfg)
    char_data.character_id = char_id
    data_loader._custom_characters[char_id] = char_data

    base_idx = abs(char_id) - 1
    as_skill = build_custom_skill_data(
        base_idx, False, 1, "通常攻撃", 100, 1, 0, 1, 3, 1, 1, 1
    )
    data_loader._custom_skills[as_skill.skill_id] = as_skill
    as_parsed = build_custom_parsed_skill(
        base_idx, False, 1, 3, 1, 1
    )
    data_loader._custom_parsed_skills[str(as_skill.skill_id)] = as_parsed
    data_loader._custom_character_skills[char_id] = [as_skill.skill_id]
    data_loader._custom_dummy_configs[char_id] = cfg

    side_prefix = "F" if side == Side.ALLY else "E"
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}",
        name=name,
        side=side,
        position=pos,
        character_id=char_id,
        level=200,
        element=cfg.element,
        character_type=cfg.character_type,
        max_hp=hp,
        current_hp=hp,
        attack=atk,
        defense=defense,
        speed=speed,
        crit_rate=0.15,
        crit_damage=0.5,
        advantage_damage=0.25,
        initial_active_point=ap,
        initial_passive_point=pp,
        max_extra_point=ep_max,
        current_ap=ap,
        current_pp=pp,
        current_ep=0,
        skills=[as_skill.skill_id],
        skill_levels={as_skill.skill_id: 1},
        skill_cooldowns={},
        role_type=role_type,
        position_type=position_type,
    )


def create_character_unit(data_loader, stat_calculator, char_id, side, pos,
                          panel_config, player_config, fury_count=0):
    char = data_loader.get_character_by_id(char_id)
    if not char:
        raise ValueError(f"Character {char_id} not found!")
    char_config = panel_config.get_character_config(char_id, char.default_rarity)
    stats = stat_calculator.calculate_stats(char_config, player_config)
    char_skills = data_loader.load_character_skills()
    skills = char_skills.get(char_id, [])
    side_prefix = "F" if side == Side.ALLY else "E"
    max_ep = 7
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}",
        name=char.name,
        side=side,
        position=pos,
        character_id=char_id,
        level=char_config.level,
        element=char.attribute,
        character_type=char.character_type,
        max_hp=stats.hp,
        current_hp=stats.hp,
        attack=stats.attack,
        defense=stats.defense,
        speed=stats.speed,
        crit_rate=stats.critical_rate,
        crit_damage=stats.critical_damage - 1.5,
        advantage_damage=stats.advantage_damage - 1.25,
        initial_active_point=stats.initial_ap,
        initial_passive_point=stats.initial_pp,
        max_extra_point=max_ep,
        current_ap=stats.initial_ap,
        current_pp=stats.initial_pp,
        current_ep=0,
        skills=skills,
        skill_levels=panel_config.skill_levels.get(char_id, {}),
        skill_cooldowns={},
        role_type=char.role_type,
        position_type=char.position_type,
        fury_count=fury_count,
    )


def _verify_and_print(bf, test_name, checks):
    print(f"\n{'─'*50}")
    print(f"[验证] {test_name}")
    print(f"{'─'*50}")
    passed = 0
    failed = 0
    for desc, condition, expected, actual in checks:
        status = "✅" if condition else "❌"
        if condition:
            passed += 1
        else:
            failed += 1
        print(f"  {status} {desc}")
        if not condition:
            print(f"     期望: {expected}, 实际: {actual}")
    print(f"  结果: {passed}通过 / {failed}失败")
    return failed == 0


def run_test(name, friends_config, enemies_config, data_loader, panel_config,
             player_config, stat_calculator, memory_card_ids=None, test_index=0):
    print(f"\n{'='*60}")
    print(f"Test {test_index}: {name}")
    print(f"{'='*60}")

    bf = BattlefieldState()
    friends = []
    enemies = []

    for cfg in friends_config:
        if cfg.get("is_dummy"):
            u = create_dummy_unit(
                data_loader, cfg["name"], Side.ALLY, cfg["pos"], cfg["char_id"],
                cfg["hp"], cfg["atk"], cfg["defense"], cfg["speed"],
                cfg["ap"], cfg["pp"], cfg.get("ep", 8),
                cfg.get("role_type", 0),
                cfg.get("position_type", 3),
                cfg.get("element", 1),
                cfg.get("char_type", 1),
            )
        else:
            u = create_character_unit(
                data_loader, stat_calculator, cfg["char_id"],
                Side.ALLY, cfg["pos"], panel_config, player_config,
                fury_count=cfg.get("fury_count", 0),
            )
            cooldown_override = cfg.get("skill_cooldown_override", None)
            if cooldown_override:
                for sk_id, cd_val in cooldown_override.items():
                    u.skill_cooldowns[sk_id] = cd_val
            ep_override = cfg.get("ep_override", None)
            if ep_override is not None:
                u.current_ep = ep_override
            speed_override = cfg.get("speed_override", None)
            if speed_override is not None:
                u.speed = speed_override
            hp_override = cfg.get("hp_override", None)
            if hp_override is not None:
                u.current_hp = hp_override
        bf.add_unit(u)
        friends.append(u)

    for cfg in enemies_config:
        if cfg.get("is_dummy"):
            u = create_dummy_unit(
                data_loader, cfg["name"], Side.ENEMY, cfg["pos"], cfg["char_id"],
                cfg["hp"], cfg["atk"], cfg["defense"], cfg["speed"],
                cfg["ap"], cfg["pp"], cfg.get("ep", 8),
                cfg.get("role_type", 0),
                cfg.get("position_type", 3),
                cfg.get("element", 1),
                cfg.get("char_type", 1),
            )
        else:
            u = create_character_unit(
                data_loader, stat_calculator, cfg["char_id"],
                Side.ENEMY, cfg["pos"], panel_config, player_config,
            )
        bf.add_unit(u)
        enemies.append(u)

    if memory_card_ids:
        bf.memory_cards = []
        for card_id in memory_card_ids:
            memory_data = data_loader.get_memory(card_id)
            if memory_data:
                highlights = [
                    MemoryHighlight(
                        character_attribute=hl.character_attribute,
                        character_base_master_id=hl.character_base_master_id,
                        character_master_id=hl.character_master_id,
                        character_role=hl.character_role,
                        character_team_master_id=hl.character_team_master_id,
                        character_type=hl.character_type,
                        is_targeting_friendly_party=hl.is_targeting_friendly_party,
                        party_position=hl.party_position,
                        skill_master_id=hl.skill_master_id,
                    )
                    for hl in memory_data.highlights
                ]
                bf.memory_cards.append(MemoryCard(
                    card_id=card_id,
                    name=memory_data.name,
                    description=memory_data.description,
                    rarity=memory_data.rarity,
                    highlights=highlights,
                ))

    print(f"  己方: {[f'{u.name}({u.position.name})' for u in friends]}")
    print(f"  敌方: {[f'{u.name}({u.position.name})' for u in enemies]}")
    for u in friends:
        print(f"    [{u.name}] HP={u.current_hp}/{u.max_hp} ATK={u.attack} DEF={u.defense} SPD={u.speed} EP={u.current_ep}/{u.max_extra_point}")
    for u in enemies:
        print(f"    [{u.name}] HP={u.current_hp}/{u.max_hp} ATK={u.attack} DEF={u.defense} SPD={u.speed}")

    controller = BattleFlowController(
        bf, data_loader=data_loader,
        narrative=BattleNarrativeWriter(data_loader=data_loader)
    )
    result = controller.execute_battle()

    print(f"\n  战斗结果: {result['result']} | 回合: {result['total_turns']} | 胜者: {result['winner']}")
    for u in bf.get_all_units():
        s = f"HP={u.current_hp}/{u.max_hp}" if u.is_alive else "阵亡"
        shield_s = f" shield={u.shield}" if u.shield > 0 else ""
        card_buffs = [b for b in u.buffs if b.effect_type == "card_buff"]
        card_info = f" card={card_buffs[0].value}" if card_buffs else ""
        statuses = [b for b in u.buffs if b.effect_type in ("burn", "Conflagration")]
        status_info = f" burn(dur={statuses[0].duration})" if statuses else ""
        dmg_up_buffs = [b for b in u.buffs if b.effect_type in ("dmg_dealt_up", "DealtDamage")]
        dmg_up_info = f" dmg_up={dmg_up_buffs[0].value}" if dmg_up_buffs else ""
        atk_up_buffs = [b for b in u.buffs if b.effect_type in ("atk_up", "StatusAttack")]
        atk_up_info = f" atk_up={atk_up_buffs[0].value}" if atk_up_buffs else ""
        crit_up_buffs = [b for b in u.buffs if b.effect_type in ("crit_rate_up", "StatusCriticalChance")]
        crit_up_info = f" crit_up={crit_up_buffs[0].value}" if crit_up_buffs else ""
        print(f"    [{u.unit_id}] {u.name}({u.position.name}): {s}{shield_s} fury={getattr(u, 'fury_count', 0)}{card_info}{status_info}{dmg_up_info}{atk_up_info}{crit_up_info}")

    if controller.narrative:
        log_dir = os.path.join(os.path.dirname(__file__), "data", "battle_logs")
        os.makedirs(log_dir, exist_ok=True)
        safe_name = name.replace(" ", "_").replace("/", "_").replace(":", "")[:40]
        timestamp = time.strftime("%Y%m%d_%H%M%S")
        log_path = os.path.join(log_dir, f"test{test_index:02d}_{safe_name}_{timestamp}.txt")
        controller.narrative.write(log_path)
        print(f"\n  日志: {log_path}")
        return log_path, bf, result
    return None, bf, result


def main():
    panel_config = PanelConfig(
        character_level=200,
        school_levels=SchoolLevels(
            physical_level=25, en_level=25, agility_level=25,
            fire_level=25, water_level=25, earth_level=25, wind_level=25,
            light_level=25, dark_level=25,
        ),
        equipment_ids=[11, 12, 13, 14, 21, 22, 23, 24, 31, 32, 33, 34],
        equipment_enabled=False,
    )

    data_loader = DataLoader()
    data_loader.load_all()

    lerp_data = data_loader.load_level_lerp_data()
    stat_calculator = StatCalculator(lerp_data)

    char_id = 112301

    char = data_loader.get_character_by_id(char_id)
    panel_config.rarities[char_id] = 14
    panel_config.affection_levels[char_id] = 40
    skill_ids = data_loader.load_character_skills().get(char_id, [])
    panel_config.skill_levels[char_id] = {sid: 10 for sid in skill_ids}
    module_ids = [int(f"{char.character_type}1"), int(f"{char.character_type}2"),
                  int(f"{char.character_type}3")]
    panel_config.modules[char_id] = [
        ModuleConfig(module_id=mid, tier=9, level=50)
        for mid in module_ids
    ]

    player_config = panel_config.get_player_config()

    all_passed = True
    test_idx = 0

    # ============================================================
    # Test 1: 110011 乙女の高ぶり (EX) Lv10
    # 验证: 敌全体EN攻击 + lifesteal(25%)
    # 112301需要EP=6才能使用EX, 设置ep_override=7确保可发动
    # 敌人速度更快(600)确保先攻, 伤害角色后由lifesteal回复
    # ============================================================
    test_idx += 1
    _, bf1, _ = run_test("EX_110011_Lv10_全体攻击+lifesteal",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT, "ep_override": 7},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌A", "char_id": -101,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 100000, "atk": 25000, "defense": 3000, "speed": 900,
             "ap": 1, "pp": 1},
            {"is_dummy": True, "name": "敌B", "char_id": -102,
             "pos": Position.ENEMY_RIGHT_FRONT,
             "hp": 100000, "atk": 25000, "defense": 3000, "speed": 900,
             "ap": 1, "pp": 1},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit = next((u for u in bf1.get_all_units() if u.character_id == char_id), None)
    enemy_a = next((u for u in bf1.get_all_units() if u.name == "敌A"), None)
    enemy_b = next((u for u in bf1.get_all_units() if u.name == "敌B"), None)
    a_hurt = enemy_a and enemy_a.current_hp < enemy_a.max_hp
    b_hurt = enemy_b and enemy_b.current_hp < enemy_b.max_hp
    char_hp_full = char_unit and char_unit.current_hp >= char_unit.max_hp
    _verify_and_print(bf1, "EX 110011 乙女の高ぶり (Lv10)", [
        ("敌A受到伤害", a_hurt, "HP<max", f"敌A HP={enemy_a.current_hp}/{enemy_a.max_hp}" if enemy_a else "N/A"),
        ("敌B受到伤害(全体攻击)", b_hurt, "HP<max", f"敌B HP={enemy_b.current_hp}/{enemy_b.max_hp}" if enemy_b else "N/A"),
        ("lifesteal回血(HP回复至满)", char_hp_full, "HP==max", f"HP={char_unit.current_hp}/{char_unit.max_hp}" if char_unit else "N/A"),
    ])

    # ============================================================
    # Test 2: 110011 乙女の高ぶり (EX) Lv11
    # 验证: 敌全体EN攻击 + lifesteal(25%) + 3行动炎上(ATK×30%)
    # 敌人速度更快(900)确保先攻, 伤害角色后由lifesteal回复
    # 炎上状态通过战斗日志验证(3行动后自然到期, 战后buff已消失)
    # ============================================================
    test_idx += 1
    panel_config_l11 = PanelConfig(
        character_level=200,
        school_levels=SchoolLevels(
            physical_level=25, en_level=25, agility_level=25,
            fire_level=25, water_level=25, earth_level=25, wind_level=25,
            light_level=25, dark_level=25,
        ),
        equipment_ids=[11, 12, 13, 14, 21, 22, 23, 24, 31, 32, 33, 34],
        equipment_enabled=False,
    )
    panel_config_l11.rarities[char_id] = 14
    panel_config_l11.affection_levels[char_id] = 40
    panel_config_l11.skill_levels[char_id] = {sid: 11 for sid in skill_ids}
    panel_config_l11.modules[char_id] = [
        ModuleConfig(module_id=mid, tier=9, level=50)
        for mid in module_ids
    ]
    player_config_l11 = panel_config_l11.get_player_config()

    log_path2, bf2, _ = run_test("EX_110011_Lv11_全体攻击+lifesteal+炎上",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT, "ep_override": 7},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌A_Lv11", "char_id": -201,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 500000, "atk": 25000, "defense": 3000, "speed": 900,
             "ap": 1, "pp": 1},
            {"is_dummy": True, "name": "敌B_Lv11", "char_id": -202,
             "pos": Position.ENEMY_RIGHT_FRONT,
             "hp": 500000, "atk": 25000, "defense": 3000, "speed": 900,
             "ap": 1, "pp": 1},
        ],
        data_loader=data_loader, panel_config=panel_config_l11,
        player_config=player_config_l11, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit2 = next((u for u in bf2.get_all_units() if u.character_id == char_id), None)
    enemy_a2 = next((u for u in bf2.get_all_units() if u.name == "敌A_Lv11"), None)
    enemy_b2 = next((u for u in bf2.get_all_units() if u.name == "敌B_Lv11"), None)
    a_hurt2 = enemy_a2 and enemy_a2.current_hp < enemy_a2.max_hp
    char_hp_full2 = char_unit2 and char_unit2.current_hp >= char_unit2.max_hp
    burn_applied = False
    burn_damage_dealt = False
    if log_path2:
        try:
            with open(log_path2, 'r', encoding='utf-8') as f:
                log_content2 = f.read()
            burn_applied = 'Conflagration' in log_content2 and '获得减益' in log_content2
            burn_damage_dealt = '炎上伤害' in log_content2
        except Exception:
            pass
    _verify_and_print(bf2, "EX 110011 乙女の高ぶり (Lv11)", [
        ("敌A受到伤害", a_hurt2, "HP<max", f"敌A HP={enemy_a2.current_hp}/{enemy_a2.max_hp}" if enemy_a2 else "N/A"),
        ("炎上状态施加(日志验证)", burn_applied, "log contains Conflagration + 获得减益", "日志中未找到" if not burn_applied else ""),
        ("炎上伤害生效(日志验证)", burn_damage_dealt, "log contains 炎上伤害", "日志中未找到" if not burn_damage_dealt else ""),
        ("lifesteal回血(HP回复至满)", char_hp_full2, "HP==max", f"HP={char_unit2.current_hp}/{char_unit2.max_hp}" if char_unit2 else "N/A"),
    ])

    # ============================================================
    # Test 3: 120020 禅刃再生 vs EN类型目标
    # 验证: 敌单体EN攻击 + lifesteal(cure%) + 目标为EN类型时PP-1
    # 敌人速度更快(900)确保先攻, 伤害角色后由lifesteal回复
    # PP-1通过python logging handler捕获日志验证
    # ============================================================
    test_idx += 1
    capture_handler = LogCaptureHandler()
    capture_handler.setLevel(logging.INFO)
    logging.getLogger("MGGBattleSim").addHandler(capture_handler)
    _, bf3, _ = run_test("AS_120020_EN类型_lifesteal+PP削减",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT,
             "skill_cooldown_override": {120038: 5}},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "EN敌", "char_id": -301,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 500000, "atk": 25000, "defense": 2000, "speed": 900,
             "ap": 1, "pp": 3, "char_type": 2},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    logging.getLogger("MGGBattleSim").removeHandler(capture_handler)
    char_unit3 = next((u for u in bf3.get_all_units() if u.character_id == char_id), None)
    en_enemy = next((u for u in bf3.get_all_units() if u.name == "EN敌"), None)
    en_hurt = en_enemy and en_enemy.current_hp < en_enemy.max_hp
    char_hp_full3 = char_unit3 and char_unit3.current_hp >= char_unit3.max_hp
    log_messages = ' '.join(capture_handler.records)
    pp_applied = 'remove_pp from EN敌' in log_messages
    caster_pp_safe = 'remove_pp from 渇望秘めし淑女' not in log_messages
    _verify_and_print(bf3, "AS 120020 禅刃再生 (EN类型目标)", [
        ("EN敌受到伤害", en_hurt, "HP<max", f"EN敌 HP={en_enemy.current_hp}/{en_enemy.max_hp}" if en_enemy else "N/A"),
        ("lifesteal回血(cure%)", char_hp_full3, "HP==max", f"HP={char_unit3.current_hp}/{char_unit3.max_hp}" if char_unit3 else "N/A"),
        ("EN类型目标PP-1(日志验证)", pp_applied, "log contains remove_pp from EN敌", "日志中未找到" if not pp_applied else ""),
        ("caster PP未被错误削减(日志验证)", caster_pp_safe,
         "log does NOT contain 'remove_pp from 渇望秘めし淑女'", "日志中发现错误削减caster PP" if not caster_pp_safe else ""),
    ])

    # ============================================================
    # Test 4: 120020 禅刃再生 vs 非EN类型目标
    # 验证: 敌单体EN攻击 + lifesteal(cure%) + PP不削减
    # ============================================================
    test_idx += 1
    _, bf4, _ = run_test("AS_120020_非EN类型_lifesteal_only",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT,
             "skill_cooldown_override": {120038: 5}},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "物理敌", "char_id": -401,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 200000, "atk": 3000, "defense": 2000, "speed": 100,
             "ap": 1, "pp": 3, "char_type": 1},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit4 = next((u for u in bf4.get_all_units() if u.character_id == char_id), None)
    phys_enemy = next((u for u in bf4.get_all_units() if u.name == "物理敌"), None)
    phys_hurt = phys_enemy and phys_enemy.current_hp < phys_enemy.max_hp
    pp_not_reduced = phys_enemy and phys_enemy.current_pp == phys_enemy.initial_passive_point
    _verify_and_print(bf4, "AS 120020 禅刃再生 (非EN类型目标)", [
        ("物理敌受到伤害", phys_hurt, "HP<max", f"物理敌 HP={phys_enemy.current_hp}/{phys_enemy.max_hp}" if phys_enemy else "N/A"),
        ("非EN类型目标PP不削减", pp_not_reduced,
         f"PP={phys_enemy.initial_passive_point}" if phys_enemy else "",
         f"PP={phys_enemy.current_pp}/{phys_enemy.initial_passive_point}" if phys_enemy else "N/A"),
    ])

    # ============================================================
    # Test 5: 120038 桜華の舞 (HP比例伤害)
    # 验证: 敌单体EN攻击, HP越多伤害越高(+{up}% max, Lv10=200%)
    # 使用cooldown override强制120038
    # ============================================================
    test_idx += 1
    _, bf5, _ = run_test("AS_120038_HP比例伤害",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT,
             "skill_cooldown_override": {120020: 5}},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌HP", "char_id": -501,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 200000, "atk": 3000, "defense": 3000, "speed": 100,
             "ap": 1, "pp": 2},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit5 = next((u for u in bf5.get_all_units() if u.character_id == char_id), None)
    enemy5 = next((u for u in bf5.get_all_units() if u.name == "敌HP"), None)
    enemy_hurt5 = enemy5 and enemy5.current_hp < enemy5.max_hp
    hp_pct_str = f"{char_unit5.current_hp}/{char_unit5.max_hp}" if char_unit5 else "N/A"
    _verify_and_print(bf5, "AS 120038 桜華の舞 (HP比例伤害)", [
        ("敌方受到伤害(HP比例加成)", enemy_hurt5, "HP<max", f"敌方HP={enemy5.current_hp}/{enemy5.max_hp}" if enemy5 else "N/A"),
        ("自身HP高, 伤害加成接近最大值", enemy_hurt5 and enemy5 and enemy5.max_hp - enemy5.current_hp > 0,
         "伤害>1000", f"伤害={enemy5.max_hp - enemy5.current_hp if enemy5 else 0}"),
    ])

    # ============================================================
    # Test 6: 130029 鬼神活性 (PS) + 130045 茶鬼舞踏 (PS)
    # 验证: 
    #   130029 - on_turn_end 自身dmg_dealt_up(可叠加), round>1
    #   130045 - before_skill_use 自身atk_up + crit_rate_up(HP比例)
    # 使用慢速敌人确保角色能多回合行动
    # ============================================================
    test_idx += 1
    _, bf6, _ = run_test("PS_130029+130045_dmg_stack+atk_crit_buff",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT, "speed_override": 500},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "慢敌", "char_id": -601,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 2000000, "atk": 3000, "defense": 2000, "speed": 50,
             "ap": 1, "pp": 2},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit6 = next((u for u in bf6.get_all_units() if u.character_id == char_id), None)
    dmg_up_buffs = [b for b in char_unit6.buffs if b.effect_type in ("dmg_dealt_up", "DealtDamage")] if char_unit6 else []
    atk_up_buffs = [b for b in char_unit6.buffs if b.effect_type in ("atk_up", "StatusAttack")] if char_unit6 else []
    crit_up_buffs = [b for b in char_unit6.buffs if b.effect_type in ("crit_rate_up", "StatusCriticalChance")] if char_unit6 else []
    dmg_up_count = len(dmg_up_buffs)
    dmg_up_value = dmg_up_buffs[0].value if dmg_up_buffs else 0
    has_atk_up = len(atk_up_buffs) > 0
    has_crit_up = len(crit_up_buffs) > 0
    atk_val = atk_up_buffs[0].value if atk_up_buffs else 0
    crit_val = crit_up_buffs[0].value if crit_up_buffs else 0
    _verify_and_print(bf6, "PS 130029 鬼神活性 (dmg_dealt_up叠加)", [
        (f"dmg_dealt_up叠加({dmg_up_count}层)", dmg_up_count >= 1, ">=1层", f"层数={dmg_up_count}"),
        (f"dmg_dealt_up值≈40%", dmg_up_value > 35 and dmg_up_value < 45,
         "≈40%", f"value={dmg_up_value}"),
    ])
    _verify_and_print(bf6, "PS 130045 茶鬼舞踏 (atk_up + crit_rate_up)", [
        (f"atk_up生效(HP比例)", has_atk_up, "有", f"atk_up={'有' if has_atk_up else '无'}, value={atk_val}"),
        (f"crit_rate_up生效(HP比例)", has_crit_up, "有", f"crit_rate_up={'有' if has_crit_up else '无'}, value={crit_val}"),
    ])

    print(f"\n{'='*60}")
    print("ALL TESTS COMPLETE")
    print(f"{'='*60}")


if __name__ == "__main__":
    main()