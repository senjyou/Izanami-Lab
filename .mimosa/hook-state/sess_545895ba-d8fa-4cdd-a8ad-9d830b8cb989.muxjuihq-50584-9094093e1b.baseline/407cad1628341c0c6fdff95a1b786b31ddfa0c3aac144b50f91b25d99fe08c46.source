
import json
from collections import Counter

def analyze_tags():
    with open('f:/MGG/Logic_Analyze/MGGBattleSimulation/split_data/SkillMaster.json', 'r', encoding='utf-8') as f:
        data = json.load(f)

    tag_counts = Counter()
    
    for skill in data:
        if 'TemplateTags' in skill:
            for tag in skill['TemplateTags']:
                tag_name = tag.get('TagName')
                if tag_name:
                    tag_counts[tag_name] += 1
                    
    print("Unique Tag Names and Counts:")
    for tag, count in tag_counts.most_common():
        print(f"{tag}: {count}")

if __name__ == "__main__":
    analyze_tags()
