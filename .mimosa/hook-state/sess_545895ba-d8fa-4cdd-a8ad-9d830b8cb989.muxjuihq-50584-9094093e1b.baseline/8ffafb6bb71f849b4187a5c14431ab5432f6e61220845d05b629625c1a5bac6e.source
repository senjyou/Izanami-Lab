"""角色141301 ダウナーギャルな副委員長 专项E2E测试

技能列表：
- EX: 110054 フェイスストライク（最近敵単体 + 隣接2体攻撃 + action_damage[2行動, 7.5%]；
  Lv11+ atk_down[2行動, atk%] on primary + adjacent）
- AS1: 120119 とりしまり～（敵全体攻撃[威力] + remove_ep[1]；
  conditional_power_bonus multiplier_per_count: 警棒mark 1つにつき+15%（最大3つ, dealt_damage乘区））
- AS2: 120120 弱点はそこかな？（自身から最も遠い敵単体攻撃[威力] + atk_down[2行動, atk%, stackable]）
- PS1: 130127 風紀委員会の管轄だよ～（同時発動制限 + before_as_attacked
  + attacker_is_back_row + target_is_other_ally + self_hp_percent>=40；
  Block1: mark 警棒[trigger_attacker, stackable] + atk_down[trigger_attacker, attacker_action, stackable]
  + cover[self, attacker_action]；
  Block2 Lv11+: block_buff_by_type[self, block_debuffs, attacker_action]；
  Block3 Lv12+: atk_down[enemy_back_row, 3行動, atk2%, stackable]）
- PS2: 130128 包囲かんりょ～（on_turn_end；
  dmg_dealt_down[enemy_all, dmg%, attack_limited=1, scale_by_target_hp_ratio, stackable]
  + ep_gain_up[ally_all, 50%, 1行動]）

覆盖维度：
1. EX adjacent_enemies 索敵（主目標+隣接2体）+ primary_target identifier + action_damage + Lv11+ atk_down
2. AS1 multiplier_per_count 線性縮放（0/1/2/3/4層警棒mark增傷，max=3封頂）+ remove_ep + 敵全体攻撃
3. AS2 enemy_single_furthest 索敵 + atk_down stackable
4. PS1 三重global_condition（attacker_is_back_row + target_is_other_ally + self_hp_percent>=40）
   + mark警棒付与 + atk_down + cover + Lv11+ block_debuffs + Lv12+ enemy_back_row atk_down
5. PS2 on_turn_end + scale_by_target_hp_ratio + ep_gain_up
6. mark 全链专项（PS1付与警棒mark → AS1 multiplier_per_count 增傷）
7. simultaneous_limit 专项（同時発動制限：速度最快者触发）
8. block_buff_by_type 专项（Lv11+ block_debuffs 阻止新debuff）
9. scale_by_target_hp_ratio 专项（HP比例缩放减伤）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction, TriggerTiming
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# atk_up/atk_down 共用 STATUS_ATTACK 枚举
# dmg_dealt_up/dmg_dealt_down 共用 DEALT_DAMAGE 枚举（up 在 buffs，down 在 debuffs）
# mark 用 MARK 枚举（警棒 mark is_buff_mark=false → debuffs 列表）
# action_damage 用 ACTION_DAMAGE 枚举（行动时受到攻击力x%伤害）
# cover 用 INTERCEPT 枚举（援护/拦截）
# block_buff_by_type 用 BLOCK_BUFF_BY_TYPE 枚举
# ep_gain_up 用 EP_GAIN_UP 枚举
MARK = SkillEffectType.MARK.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
ACTION_DAMAGE = SkillEffectType.ACTION_DAMAGE.value
INTERCEPT = SkillEffectType.INTERCEPT.value
BLOCK_BUFF_BY_TYPE = SkillEffectType.BLOCK_BUFF_BY_TYPE.value
EP_GAIN_UP = SkillEffectType.EP_GAIN_UP.value

# AuraUpdateTiming 数值
DURABLE_TARGET_MANEUVER_END = AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value   # 4: duration_type="action" 映射
DURABLE_SOURCE_MANEUVER_END = AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value   # 3: duration_type="turn" 映射


class TestActor141301(unittest.TestCase):
    """角色141301 ダウナーギャルな副委員長 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 141301 ダウナーギャルな副委員長
        # (水属性attr=2, 物理型character_type=1, 灵活position_type=3, 辅助role_type=4)
        # 默认Lv10，部分测试用Lv11/Lv12/Lv15验证Lv分支
        # caster 放后排中央（PS1 self_hp_percent 检查自身HP）
        self.caster = UnitState(
            unit_id="caster", name="ダウナーギャルな副委員長", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=141301, level=10,
            element=2, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110054, 120119, 120120, 130127, 130128],
            skill_levels={110054: 10, 120119: 10, 120120: 10,
                          130127: 10, 130128: 10},
            skill_cooldowns={},
        )

        # 友方前排中央（PS1 target_is_other_ally 测试用 - 被保护友方）
        self.ally_front = UnitState(
            unit_id="ally_front", name="友方前排", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999100, level=10,
            element=1, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央（最近敌，EX主目标候选）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（邻接中前，EX adjacent_enemies 测试用）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（邻接中前，EX adjacent_enemies 测试用）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=4500, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方中后（后排敌，PS1 attacker_is_back_row 测试用 + AS2 furthest 测试用）
        self.enemy_cb = UnitState(
            unit_id="enemy_cb", name="敵中後", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=999002, level=10,
            element=3, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=6000, defense=4000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=4,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally_front]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf, self.enemy_cb]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0, level=10):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.is_stunned = False
        self.caster.is_frozen = False
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.skill_use_count = {}
        self.caster.level = level
        self.caster.cover_target = None
        self.caster.cover_skill_id = 0
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = level

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.is_stunned = False
            e.is_frozen = False
            e.current_ap = 4
            e.current_ep = 3

    def _reset_ally_front(self):
        """重置友方前排状态。"""
        self.ally_front.current_hp = self.ally_front.max_hp
        self.ally_front.buffs = []
        self.ally_front.debuffs = []
        self.ally_front.is_alive = True

    def _apply_keibou_mark(self, target, count=1):
        """为指定敌方附加「警棒」mark debuff（is_buff_mark=false → debuffs 列表）。

        141301 的核心 mark：警棒 驱动 AS1 multiplier_per_count 增伤。
        通常由 PS1 付与攻击者。
        """
        for i in range(count):
            target.debuffs.append(BuffState(
                buff_id=f"test_keibou_{id(target)}_{i}",
                name="警棒", effect_type=MARK, value=0,
                duration=-1, timing_type=2, is_debuff=True,
                unremovable=False,
            ))

    # ════════════════════════════════════════════════════════════════
    # EX: 110054 フェイスストライク
    # ════════════════════════════════════════════════════════════════

    def test_ex_targets_nearest_enemy(self):
        """EX(110054) Block1: 主目标=最近敌方(enemy_cf 中前，距离caster中后最近)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf = self.enemy_cf.current_hp
        hp_lf = self.enemy_lf.current_hp
        hp_rf = self.enemy_rf.current_hp
        hp_cb = self.enemy_cb.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110054, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 主目标(enemy_cf)应受到伤害
        self.assertLess(self.enemy_cf.current_hp, hp_cf,
                        "enemy_cf(最近敌方)应受到EX主攻击伤害")

    def test_ex_adjacent_enemies_damaged(self):
        """EX(110054) Block1: 邻接主目标的2个敌方受到追加伤害。

        主目标=enemy_cf(中前)，邻接=enemy_lf(左前) + enemy_rf(右前)。
        enemy_cb(中后)不邻接中前，不应受伤。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf = self.enemy_cf.current_hp
        hp_lf = self.enemy_lf.current_hp
        hp_rf = self.enemy_rf.current_hp
        hp_cb = self.enemy_cb.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110054, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 邻接目标(左前+右前)受伤
        self.assertLess(self.enemy_lf.current_hp, hp_lf,
                        "enemy_lf(邻接中前)应受到追加伤害")
        self.assertLess(self.enemy_rf.current_hp, hp_rf,
                        "enemy_rf(邻接中前)应受到追加伤害")
        # 非邻接目标(中后)不受伤
        self.assertEqual(self.enemy_cb.current_hp, hp_cb,
                         "enemy_cb(非邻接)不应受到EX伤害")

    def test_ex_applies_action_damage_to_primary(self):
        """EX(110054) Block1: 对主目标施加 action_damage(7.5%, 2行動) debuff。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110054, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_cf(主目标)应被赋予 action_damage debuff
        action_damages = [d for d in self.enemy_cf.debuffs if d.effect_type == ACTION_DAMAGE]
        self.assertGreater(len(action_damages), 0,
                           "enemy_cf(主目标)应被赋予action_damage debuff")
        self.assertEqual(action_damages[0].duration, 2,
                         "action_damage duration应为2(2行動)")
        self.assertAlmostEqual(action_damages[0].value, 7.5,
                               msg="action_damage value应为7.5(攻击力×7.5%)")

    def test_ex_applies_action_damage_to_adjacent(self):
        """EX(110054) Block1: 对邻接敌方也施加 action_damage debuff。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110054, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_lf + enemy_rf 应被赋予 action_damage
        for e in (self.enemy_lf, self.enemy_rf):
            ads = [d for d in e.debuffs if d.effect_type == ACTION_DAMAGE]
            self.assertGreater(len(ads), 0,
                               f"{e.name}(邻接)应被赋予action_damage debuff")

    def test_ex_lv10_no_atk_down(self):
        """EX(110054) Lv10: Block2 跳过（active_level_min=11 未满足）→ 无 atk_down。"""
        self._reset_caster(hp=self.caster.max_hp, level=10)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110054, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Lv10 时不应有 atk_down debuff
        for e in (self.enemy_cf, self.enemy_lf, self.enemy_rf):
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            self.assertEqual(len(atk_downs), 0,
                             f"{e.name}: Lv10时不应有atk_down")

    def test_ex_lv11_applies_atk_down_to_primary_and_adjacent(self):
        """EX(110054) Lv11+: Block2 执行 atk_down 到主目标 + 邻接敌方。"""
        self._reset_caster(hp=self.caster.max_hp, level=11)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110054, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 主目标 + 邻接敌方应被赋予 atk_down
        for e in (self.enemy_cf, self.enemy_lf, self.enemy_rf):
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            self.assertGreater(len(atk_downs), 0,
                               f"{e.name}: Lv11+应有atk_down")
            self.assertEqual(atk_downs[0].duration, 2,
                             "atk_down duration应为2(2行動)")

    # ════════════════════════════════════════════════════════════════
    # AS1: 120119 とりしまり～
    # ════════════════════════════════════════════════════════════════

    def test_as1_damages_all_enemies(self):
        """AS1(120119) Block1: damage(enemy_all) 命中敌方全体。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_before = {e.unit_id: e.current_hp for e in self.bf.enemy_team}

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120119, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 所有敌方都应受到伤害
        for e in self.bf.enemy_team:
            self.assertLess(e.current_hp, hp_before[e.unit_id],
                            f"{e.name}应受到AS1全体伤害")

    def test_as1_removes_ep_from_all_enemies(self):
        """AS1(120119) Block1: remove_ep(1) 从敌方全体削EP。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 设置所有敌方EP=3
        for e in self.bf.enemy_team:
            e.current_ep = 3

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120119, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 所有敌方EP应-1
        for e in self.bf.enemy_team:
            self.assertEqual(e.current_ep, 2,
                             f"{e.name}: EP应从3减到2")

    def test_as1_no_mark_no_bonus(self):
        """AS1(120119) 无警棒mark时: cond_met=False → 不创建 DealtDamage buff。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 不施加警棒mark

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120119, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 无 DealtDamage buff（cond_met=False，不进入增伤分支）
        dealt_buffs = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dealt_buffs), 0,
                         "无警棒mark时不应创建DealtDamage buff")

    def test_as1_one_mark_15pct_bonus(self):
        """AS1(120119) 1个警棒mark: bonus_pct = 15% × 1 = 15% → DealtDamage buff。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 给第一个敌方（enemy_cf，enemy_all的第一个目标）施加1个警棒mark
        self._apply_keibou_mark(self.enemy_cf, count=1)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120119, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dealt_buffs = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dealt_buffs), 0,
                           "1警棒mark应创建DealtDamage buff")
        self.assertAlmostEqual(dealt_buffs[0].value, 15.0, delta=0.01,
                               msg="1警棒mark bonus = 15% × 1 = 15%")
        self.assertEqual(getattr(dealt_buffs[0], 'attack_limited', 0), 1,
                         "DealtDamage buff应有attack_limited=1")

    def test_as1_two_marks_30pct_bonus(self):
        """AS1(120119) 2个警棒mark: bonus_pct = 15% × 2 = 30%。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_keibou_mark(self.enemy_cf, count=2)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120119, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dealt_buffs = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dealt_buffs), 0,
                           "2警棒mark应创建DealtDamage buff")
        self.assertAlmostEqual(dealt_buffs[0].value, 30.0, delta=0.01,
                               msg="2警棒mark bonus = 15% × 2 = 30%")

    def test_as1_three_marks_45pct_bonus(self):
        """AS1(120119) 3个警棒mark: bonus_pct = 15% × 3 = 45%（达到max_multiplier_count）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_keibou_mark(self.enemy_cf, count=3)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120119, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dealt_buffs = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dealt_buffs), 0,
                           "3警棒mark应创建DealtDamage buff")
        self.assertAlmostEqual(dealt_buffs[0].value, 45.0, delta=0.01,
                               msg="3警棒mark bonus = 15% × 3 = 45%（max=3）")

    def test_as1_four_marks_capped_at_3(self):
        """AS1(120119) 4个警棒mark: 仍只×3 = 45%（max_multiplier_count=3 封顶）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_keibou_mark(self.enemy_cf, count=4)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120119, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dealt_buffs = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dealt_buffs), 0,
                           "4警棒mark应创建DealtDamage buff")
        # bonus = 15% × min(4, 3) = 15% × 3 = 45%（封顶）
        self.assertAlmostEqual(dealt_buffs[0].value, 45.0, delta=0.01,
                               msg="4警棒mark bonus应封顶在45%（max_multiplier_count=3）")

    def test_as1_mark_increases_damage(self):
        """AS1(120119) 警棒mark增伤验证: 有mark时伤害应高于无mark时。"""
        # 场景1: 无mark → base damage
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_no_mark = self.ss.execute_skill(
            caster=self.caster, skill_id=120119, battlefield=self.bf, skip_cost=True
        )
        dmg_no_mark = result_no_mark.get("total_damage", 0)

        # 场景2: 3个警棒mark → +45%增伤
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_keibou_mark(self.enemy_cf, count=3)
        result_with_mark = self.ss.execute_skill(
            caster=self.caster, skill_id=120119, battlefield=self.bf, skip_cost=True
        )
        dmg_with_mark = result_with_mark.get("total_damage", 0)

        self.assertGreater(dmg_no_mark, 0, "base damage应>0")
        self.assertGreater(dmg_with_mark, 0, "增伤后damage应>0")
        # 3警棒 → +45% DealtDamage → 伤害应约为无mark时的1.45倍
        ratio = dmg_with_mark / dmg_no_mark
        self.assertAlmostEqual(ratio, 1.45, delta=0.05,
                               msg=f"3警棒mark→+45%增伤→伤害应×1.45，实际: {ratio:.3f}")

    # ════════════════════════════════════════════════════════════════
    # AS2: 120120 弱点はそこかな？
    # ════════════════════════════════════════════════════════════════

    def test_as2_targets_furthest_enemy(self):
        """AS2(120120) Block1: enemy_single_furthest 索敵选择最远敌方。

        caster在ALLY_CENTER_BACK，最远敌方=enemy_cb(ENEMY_CENTER_BACK)？
        不，"最远"指距离caster最远。caster在中后，enemy_cb也在中后(对面)，
        距离最近；enemy_cf/lf/rf在前排，距离更远。
        实际游戏: "自身から最も遠い位置" → 距离caster最远。
        caster在后排中央，最远的是前排3个敌人中距离最远的。
        中后→中前 距离=1, 中后→左前/右前 距离=2。
        但enemy_all中enemy_cf/lf/rf/cb都可能被选。
        实际上enemy_single_furthest会选择距离caster最远的单个敌人。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf = self.enemy_cf.current_hp
        hp_lf = self.enemy_lf.current_hp
        hp_rf = self.enemy_rf.current_hp
        hp_cb = self.enemy_cb.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120120, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 应有1个敌方受伤（最远者），其他不受伤
        damaged = []
        if self.enemy_cf.current_hp < hp_cf:
            damaged.append("enemy_cf")
        if self.enemy_lf.current_hp < hp_lf:
            damaged.append("enemy_lf")
        if self.enemy_rf.current_hp < hp_rf:
            damaged.append("enemy_rf")
        if self.enemy_cb.current_hp < hp_cb:
            damaged.append("enemy_cb")

        self.assertEqual(len(damaged), 1,
                         f"AS2应只命中1个最远敌方，实际命中: {damaged}")

    def test_as2_applies_atk_down_stackable(self):
        """AS2(120120) Block1: 对最远敌方施加 atk_down(2行動, stackable)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120120, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 受伤的敌方应有 atk_down debuff
        for e in self.bf.enemy_team:
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            if atk_downs:
                self.assertEqual(atk_downs[0].duration, 2,
                                 "atk_down duration应为2(2行動)")
                self.assertTrue(atk_downs[0].is_stackable,
                                "atk_down应可叠加(stackable=true)")

    def test_as2_atk_down_stacks_multiple_casts(self):
        """AS2(120120) 多次施放: atk_down(stackable) 叠加多次。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 第1次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=120120, battlefield=self.bf, skip_cost=True
        )
        # 找到被攻击的目标
        target = None
        for e in self.bf.enemy_team:
            if any(d.effect_type == STATUS_ATTACK for d in e.debuffs):
                target = e
                break
        self.assertIsNotNone(target, "应找到被AS2攻击的目标")
        atk_count_1 = sum(1 for d in target.debuffs if d.effect_type == STATUS_ATTACK)
        self.assertEqual(atk_count_1, 1, "第1次后应有1个atk_down")

        # 第2次施放（同一目标应再+1）
        self.ss.execute_skill(
            caster=self.caster, skill_id=120120, battlefield=self.bf, skip_cost=True
        )
        # 至少有1个目标有2个atk_down
        target2 = None
        for e in self.bf.enemy_team:
            cnt = sum(1 for d in e.debuffs if d.effect_type == STATUS_ATTACK)
            if cnt >= 2:
                target2 = e
                break
        # 注: 第2次可能打到不同目标，所以检查总atk_down数
        total_atk_downs = sum(
            sum(1 for d in e.debuffs if d.effect_type == STATUS_ATTACK)
            for e in self.bf.enemy_team
        )
        self.assertGreaterEqual(total_atk_downs, 2,
                                "2次AS2后应至少有2个atk_down实例(stackable)")

