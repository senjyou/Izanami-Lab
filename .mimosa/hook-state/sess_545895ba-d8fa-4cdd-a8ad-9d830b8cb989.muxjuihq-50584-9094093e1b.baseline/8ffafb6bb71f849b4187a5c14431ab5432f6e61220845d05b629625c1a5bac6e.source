    def test_ps1_triggers_when_other_ally_attacked_by_back_row(self):
        """PS1(130127) before_as_attacked: 其他友方被后排攻击者攻击→触发。

        global_condition: attacker_is_back_row + target_is_other_ally + self_hp_percent>=40。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()

        # enemy_cb(中后)是后排攻击者，攻击 ally_front(其他友方)
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cb
        )

        ps1_actions = [a for a in actions if a.skill_id == 130127]
        self.assertGreater(len(ps1_actions), 0,
                           "其他友方被后排攻击者攻击时PS1应触发")

