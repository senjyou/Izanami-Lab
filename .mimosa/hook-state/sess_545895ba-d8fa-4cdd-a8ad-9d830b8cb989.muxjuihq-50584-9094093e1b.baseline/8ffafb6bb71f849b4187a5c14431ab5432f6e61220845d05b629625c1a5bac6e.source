    def test_ps1_lv11_block_debuffs_blocks_new_debuff(self):
        """PS1(130127) Lv11+ block_debuffs: 阻止新debuff付与。

        场景: PS1触发后caster有block_debuffs → 尝试对新caster施加debuff应被阻止。
        """
        self._reset_caster(hp=self.caster.max_hp, level=11)
        self._reset_enemies()
        self._reset_ally_front()

        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cb
        )
        ps1_actions = [a for a in actions if a.skill_id == 130127]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 验证block_debuffs已存在
        block_buffs = [d for d in self.caster.debuffs if d.effect_type == BLOCK_BUFF_BY_TYPE]
        self.assertGreater(len(block_buffs), 0, "前置: 应有block_buff_by_type")

        # 尝试通过 aura_service.add_aura 施加新debuff（atk_down）
        new_debuff = BuffState(
            buff_id="test_new_debuff", name="atk_down",
            effect_type=STATUS_ATTACK, value=30.0, duration=2,
            timing_type=DURABLE_TARGET_MANEUVER_END,
            is_debuff=True,
        )
        result = self.aus.add_aura(self.caster, new_debuff)
        self.assertFalse(result,
                         "block_debuffs=True时应阻止新debuff付与")

        # 验证caster无新atk_down（仅PS1原有的block_buff_by_type）
        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_downs), 0,
                         "block_debuffs应阻止atk_down新付与")

    def test_ps1_lv12_applies_atk_down_to_back_row(self):
        """PS1(130127) Lv12+ Block3: 对敌后排 atk_down(3行動, stackable)。"""
        self._reset_caster(hp=self.caster.max_hp, level=12)
        self._reset_enemies()
        self._reset_ally_front()

        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cb
        )
        ps1_actions = [a for a in actions if a.skill_id == 130127]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # enemy_cb(后排)应有额外 atk_down from Block3（duration=3）
        # 注意: enemy_cb 同时也是攻击者，Block1也会对其付与atk_down(attacker_action)
        # Block3的atk_down duration=3，与Block1的duration=-1区分
        atk_downs = [d for d in self.enemy_cb.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertGreaterEqual(len(atk_downs), 2,
                                "Lv12+时enemy_cb应有2个atk_down(Block1 + Block3)")
        # 找到duration=3的那个（Block3）
        block3_atk_down = next((d for d in atk_downs if d.duration == 3), None)
        self.assertIsNotNone(block3_atk_down,
                            "Lv12+ Block3应有duration=3的atk_down")

    def test_ps1_lv12_atk_down_to_all_back_row_enemies(self):
        """PS1(130127) Lv12+ Block3: atk_down 命中所有后排敌方。"""
        self._reset_caster(hp=self.caster.max_hp, level=12)
        self._reset_enemies()
        self._reset_ally_front()
        # 添加另一个后排敌方
        enemy_lb = UnitState(
            unit_id="enemy_lb", name="敵左後", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_BACK, character_id=999005, level=10,
            element=1, character_type=1,
            max_hp=18000, current_hp=18000,
            attack=7000, defense=4000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.bf.enemy_team.append(enemy_lb)

        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cb
        )
        ps1_actions = [a for a in actions if a.skill_id == 130127]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 所有后排敌方都应有 Block3 的 atk_down(duration=3)
        back_row_enemies = [e for e in self.bf.enemy_team if "BACK" in e.position.name]
        self.assertGreaterEqual(len(back_row_enemies), 2,
                                "前置: 应有至少2个后排敌方")
        for e in back_row_enemies:
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            block3_atk_down = next((d for d in atk_downs if d.duration == 3), None)
            self.assertIsNotNone(block3_atk_down,
                                f"{e.name}: Lv12+ Block3应有duration=3的atk_down")

        # 前排敌方不应有 Block3 的 atk_down
        front_row_enemies = [e for e in self.bf.enemy_team if "FRONT" in e.position.name]
        for e in front_row_enemies:
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            block3_atk_down = next((d for d in atk_downs if d.duration == 3), None)
            self.assertIsNone(block3_atk_down,
                              f"{e.name}: 前排不应有Block3的atk_down(duration=3)")

    # ════════════════════════════════════════════════════════════════
    # PS2: 130128 包囲かんりょ～
    # ════════════════════════════════════════════════════════════════

    def test_ps2_triggers_on_turn_end(self):
        """PS2(130128) on_turn_end: 回合结束时触发。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()

        actions = self.ts.trigger_turn_end(self.bf)

        ps2_actions = [a for a in actions if a.skill_id == 130128]
        self.assertGreater(len(ps2_actions), 0,
                           "回合结束时PS2应触发")

    def test_ps2_applies_dmg_dealt_down_to_all_enemies(self):
        """PS2(130128) Block1: 对敌全体付与 dmg_dealt_down。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()

        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130128]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 所有敌方都应有 dmg_dealt_down debuff
        for e in self.bf.enemy_team:
            dmg_downs = [d for d in e.debuffs if d.effect_type == DEALT_DAMAGE]
            self.assertGreater(len(dmg_downs), 0,
                               f"{e.name}应有dmg_dealt_down debuff")
            self.assertTrue(dmg_downs[0].is_stackable,
                            "dmg_dealt_down应可叠加(stackable=true)")
            self.assertEqual(getattr(dmg_downs[0], 'attack_limited', 0), 1,
                             "dmg_dealt_down应有attack_limited=1")

    def test_ps2_applies_ep_gain_up_to_all_allies(self):
        """PS2(130128) Block1: 对友方全体付与 ep_gain_up(50%, 1行動)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()

        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130128]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 友方全体(caster + ally_front)应有 ep_gain_up buff
        for ally in self.bf.friend_team:
            ep_ups = [b for b in ally.buffs if b.effect_type == EP_GAIN_UP]
            self.assertGreater(len(ep_ups), 0,
                               f"{ally.name}应有ep_gain_up buff")
            self.assertAlmostEqual(ep_ups[0].value, 50.0, delta=0.01,
                                   msg="ep_gain_up value应为50(%)")
            self.assertEqual(ep_ups[0].duration, 1,
                             "ep_gain_up duration应为1(1行動)")

    def test_ps2_ep_gain_up_increases_ep_gain(self):
        """PS2(130128) ep_gain_up(50%) 实际效果: EP获取量×1.5。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()
        # 提高 max_extra_point 上限以避免 cap 限制（默认5会截断15→5）
        self.caster.max_extra_point = 30

        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130128]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 验证ep_gain_up效果
        self.caster.current_ep = 0
        self.rs.generate_ep(self.caster, 10, apply_ep_gain_down=True)
        # 10 × (1 + 50%) = 15
        self.assertEqual(self.caster.current_ep, 15,
                         "ep_gain_up(50%)应使10EP变为15EP")

    def test_ps2_dmg_dealt_down_scales_with_hp_full(self):
        """PS2(130128) scale_by_target_hp_ratio: 满血时dmg_dealt_down value=满值。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()
        # enemy_cf 满血(30000/30000=100%)

        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130128]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # enemy_cf 满血 → dmg_dealt_down value = 基础值 × 1.0
        dmg_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_downs), 0, "应有dmg_dealt_down")
        full_hp_value = dmg_downs[0].value
        self.assertGreater(full_hp_value, 0,
                           "满血时dmg_dealt_down value应>0")

    def test_ps2_dmg_dealt_down_scales_with_hp_half(self):
        """PS2(130128) scale_by_target_hp_ratio: 半血时dmg_dealt_down value=半值。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()
        # enemy_cf 半血(15000/30000=50%)
        self.enemy_cf.current_hp = 15000

        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130128]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # enemy_cf 半血 → dmg_dealt_down value = 基础值 × 0.5
        dmg_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_downs), 0, "应有dmg_dealt_down")
        half_hp_value = dmg_downs[0].value
        self.assertGreater(half_hp_value, 0,
                           "半血时dmg_dealt_down value应>0")

    def test_ps2_dmg_dealt_down_hp_scaling_ratio(self):
        """PS2(130128) scale_by_target_hp_ratio: 满血value应为半血value的2倍。"""
        # 场景1: 满血
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()
        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130128]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )
        full_hp_dmg = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE][0]
        full_hp_value = full_hp_dmg.value

        # 场景2: 半血
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()
        self.enemy_cf.current_hp = int(self.enemy_cf.max_hp * 0.5)
        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130128]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )
        half_hp_dmg = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE][0]
        half_hp_value = half_hp_dmg.value

        # 满血value 应约为 半血value 的 2倍
        self.assertGreater(full_hp_value, 0, "满血value应>0")
        self.assertGreater(half_hp_value, 0, "半血value应>0")
        ratio = full_hp_value / half_hp_value
        self.assertAlmostEqual(ratio, 2.0, delta=0.1,
                               msg=f"满血value/半血value应≈2.0，实际: {ratio:.3f}")

    # ════════════════════════════════════════════════════════════════
    # Mark 全链专项（PS1 mark付与 → AS1 multiplier_per_count 增伤）
    # ════════════════════════════════════════════════════════════════

    def test_mark_chain_ps1_mark_then_as1_bonus(self):
        """mark全链: PS1付与警棒mark → AS1 multiplier_per_count增伤。

        场景:
        1. PS1触发，给攻击者(enemy_cb)付与1个警棒mark
        2. AS1攻击敌全体，警棒mark驱动+15%增伤
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()

        # 1. PS1触发，付与警棒mark
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cb
        )
        ps1_actions = [a for a in actions if a.skill_id == 130127]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 验证警棒mark已付与
        keibou_count = sum(1 for d in self.enemy_cb.debuffs
                           if d.effect_type == MARK and d.name == "警棒")
        self.assertEqual(keibou_count, 1, "前置: PS1应付与1个警棒mark")

        # 2. AS1攻击，验证增伤
        # 重置caster的DealtDamage状态（PS1可能有残留）
        self.caster.buffs = [b for b in self.caster.buffs
                             if b.effect_type != DEALT_DAMAGE]
        # 重置敌方HP以对比
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120119, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 应创建 DealtDamage buff（1警棒 × 15% = 15%）
        dealt_buffs = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dealt_buffs), 0,
                           "PS1警棒mark+AS1应创建DealtDamage buff")
        self.assertAlmostEqual(dealt_buffs[0].value, 15.0, delta=0.01,
                               msg="1警棒mark → +15%增伤")

    def test_mark_chain_multiple_ps1_marks_higher_bonus(self):
        """mark全链: 多次PS1触发叠加警棒mark → AS1更高增伤。

        场景:
        1. PS1触发3次，给攻击者(enemy_cb)付与3个警棒mark
        2. AS1攻击，3警棒 × 15% = 45%增伤
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()

        # 1. PS1触发3次（每次付与1个警棒mark，stackable）
        for i in range(3):
            # 重置trigger service的simultaneous_limit标记
            self.ts._simultaneous_limit_triggered_in_phase = False
            actions = self.ts.trigger_before_as_attacked(
                targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cb
            )
            ps1_actions = [a for a in actions if a.skill_id == 130127]
            self.ss._pending_crit_triggers = []
            self.ss._execute_trigger_actions_inline(
                ps1_actions, self.bf, trigger_timing="before_as_attacked"
            )

        # 验证3个警棒mark
        keibou_count = sum(1 for d in self.enemy_cb.debuffs
                           if d.effect_type == MARK and d.name == "警棒")
        self.assertEqual(keibou_count, 3,
                         f"3次PS1应付与3个警棒mark(stackable)，实际: {keibou_count}")

    def test_mark_is_debuff_not_buff(self):
        """警棒mark is_buff_mark=false → 进 debuffs 列表(is_debuff=True)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()

        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cb
        )
        ps1_actions = [a for a in actions if a.skill_id == 130127]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 警棒mark应在 enemy_cb 的 debuffs 列表
        marks_in_buffs = [b for b in self.enemy_cb.buffs
                          if b.effect_type == MARK and b.name == "警棒"]
        marks_in_debuffs = [d for d in self.enemy_cb.debuffs
                            if d.effect_type == MARK and d.name == "警棒"]
        self.assertEqual(len(marks_in_buffs), 0,
                         "警棒mark不应在buffs列表")
        self.assertEqual(len(marks_in_debuffs), 1,
                         "警棒mark应在debuffs列表")
        self.assertTrue(marks_in_debuffs[0].is_debuff,
                        "警棒mark is_debuff应为True")

    # ════════════════════════════════════════════════════════════════
    # simultaneous_limit 专项
    # ════════════════════════════════════════════════════════════════

    def test_simultaneous_limit_two_holders_only_fastest(self):
        """simultaneous_limit: 两个PS1持有者同时匹配，速度最快者触发。

        场景: caster(speed=500) + ally_front_ps2(speed=600) 都持有130127，
        两者都满足触发条件 → 只有 ally_front_ps2(更快) 触发。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()

        # 让 ally_front 也持有130127（模拟两个PS1持有者）
        # 通过 character_id fallback 到 skills 列表
        # 使用不同的unit_id避免冲突
        ally_ps2 = UnitState(
            unit_id="ally_ps2", name="PS2持有者", side=Side.ALLY,
            position=Position.ALLY_LEFT_BACK, character_id=141301, level=10,
            element=2, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=4000, speed=600,  # 速度更快
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=4, current_pp=10, current_ep=0,
            skills=[110054, 120119, 120120, 130127, 130128],
            skill_levels={110054: 10, 120119: 10, 120120: 10,
                          130127: 10, 130128: 10},
            skill_cooldowns={},
        )
        self.bf.friend_team.append(ally_ps2)

        # 重置 simultaneous_limit phase flag
        self.ts._simultaneous_limit_triggered_in_phase = False

        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cb
        )

        ps1_actions = [a for a in actions if a.skill_id == 130127]
        # 只有1个PS1触发（速度最快者 = ally_ps2 speed=600）
        self.assertEqual(len(ps1_actions), 1,
                         "simultaneous_limit: 2个PS1持有者只应有1个触发(最快者)")
        # 应是 ally_ps2（speed=600 > caster speed=500）
        self.assertEqual(ps1_actions[0].owner_id, "ally_ps2",
                         "应触发速度更快的ally_ps2(speed=600)")

    def test_ps1_has_simultaneous_limit_flag(self):
        """PS1(130127) 配置: simultaneous_limit=True。"""
        parsed = self.dl.get_parsed_skill_data(130127)
        self.assertIsNotNone(parsed)
        self.assertTrue(parsed.get('simultaneous_limit', False),
                        "PS1 130127 应有 simultaneous_limit=True")

    # ════════════════════════════════════════════════════════════════
    # 配置校验专项
    # ════════════════════════════════════════════════════════════════

    def test_config_all_5_skills_present(self):
        """配置校验: 5个技能都在skill_effects_hybrid.json中。"""
        for skill_id in (110054, 120119, 120120, 130127, 130128):
            data = self.dl.get_parsed_skill_data(skill_id)
            self.assertIsNotNone(data,
                                 f"Skill {skill_id} 应在skill_effects_hybrid.json中")

    def test_config_ps1_trigger_type(self):
        """配置校验: PS1 trigger_type=before_as_attacked。"""
        ps1 = self.dl.get_parsed_skill_data(130127)
        self.assertEqual(ps1['trigger_type'], 'before_as_attacked')

    def test_config_ps1_global_condition_triple(self):
        """配置校验: PS1 三重global_condition。"""
        ps1 = self.dl.get_parsed_skill_data(130127)
        gc = ps1['global_condition']
        self.assertEqual(gc['type'], 'and')
        cond_types = [c['type'] for c in gc['conditions']]
        self.assertIn('attacker_is_back_row', cond_types)
        self.assertIn('target_is_other_ally', cond_types)
        self.assertIn('self_hp_percent', cond_types)
        # 验证 self_hp_percent >= 40
        shp = next(c for c in gc['conditions'] if c['type'] == 'self_hp_percent')
        self.assertEqual(shp['operator'], '>=')
        self.assertEqual(shp['value'], 40)

    def test_config_as1_multiplier_per_count(self):
        """配置校验: AS1 conditional_power_bonus multiplier_per_count。

        multiplier_per_count / max_multiplier_count 嵌套在 condition 对象内
        （详见 project_rules.md 11.22）。
        """
        as1 = self.dl.get_parsed_skill_data(120119)
        dmg_effect = as1['effect_blocks'][0]['effects'][0]
        bonus = dmg_effect['flags']['conditional_power_bonus']
        cond = bonus['condition']
        self.assertTrue(cond.get('multiplier_per_count'),
                        "condition.multiplier_per_count 应为 true")
        self.assertEqual(cond.get('max_multiplier_count'), 3,
                         "condition.max_multiplier_count 应为 3")
        self.assertEqual(bonus.get('value'), 15.0)
        self.assertEqual(bonus.get('bonus_type'), 'dealt_damage')

    def test_config_ps2_scale_by_target_hp_ratio(self):
        """配置校验: PS2 dmg_dealt_down scale_by_target_hp_ratio=true。"""
        ps2 = self.dl.get_parsed_skill_data(130128)
        effects = ps2['effect_blocks'][0]['effects']
        dmg_down = next(e for e in effects if e['effect_type'] == 'dmg_dealt_down')
        self.assertTrue(dmg_down['flags'].get('scale_by_target_hp_ratio'))
        self.assertEqual(dmg_down['flags'].get('attack_limited'), 1)

    def test_config_ps1_block_debuffs_at_lv11(self):
        """配置校验: PS1 Block2(Lv11+) block_buff_by_type block_debuffs=true。"""
        ps1 = self.dl.get_parsed_skill_data(130127)
        block2 = next(b for b in ps1['effect_blocks'] if b.get('level_min') == 11)
        eff = block2['effects'][0]
        self.assertEqual(eff['effect_type'], 'block_buff_by_type')
        self.assertTrue(eff['flags'].get('block_debuffs'))
        self.assertEqual(eff['duration_type'], 'attacker_action')

    def test_config_ps1_three_level_blocks(self):
        """配置校验: PS1 有3个 level 分支 block（Lv1/Lv11/Lv12）。"""
        ps1 = self.dl.get_parsed_skill_data(130127)
        blocks = ps1['effect_blocks']
        self.assertEqual(len(blocks), 3, "PS1应有3个block")
        # Block1: 无 level_min（默认Lv1）
        self.assertIsNone(blocks[0].get('level_min'))
        # Block2: level_min=11
        self.assertEqual(blocks[1].get('level_min'), 11)
        # Block3: level_min=12
        self.assertEqual(blocks[2].get('level_min'), 12)


if __name__ == "__main__":
