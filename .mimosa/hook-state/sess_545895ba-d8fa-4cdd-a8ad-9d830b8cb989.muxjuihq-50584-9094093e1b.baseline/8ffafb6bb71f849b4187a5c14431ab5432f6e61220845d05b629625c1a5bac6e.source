    def test_ps1_grants_keibou_mark_to_attacker(self):
        """PS1(130127) Block1: 给攻击者付与警棒mark(stackable, 永続, debuff)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_front()

        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cb
        )
        ps1_actions = [a for a in actions if a.skill_id == 130127]
        self.assertGreater(len(ps1_actions), 0, "PS1应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # enemy_cb(攻击者)应被赋予警棒mark
        keibou_marks = [d for d in self.enemy_cb.debuffs
                        if d.effect_type == MARK and d.name == "警棒"]
        self.assertEqual(len(keibou_marks), 1,
                         "攻击者应被赋予1个警棒mark")
        self.assertTrue(keibou_marks[0].is_debuff,
                        "警棒mark应为debuff(is_buff_mark=false)")
        self.assertTrue(keibou_marks[0].is_stackable,
                        "警棒mark应可叠加(stackable=true)")
        self.assertEqual(keibou_marks[0].duration, -1,
                         "警棒mark duration应为-1(永続)")

