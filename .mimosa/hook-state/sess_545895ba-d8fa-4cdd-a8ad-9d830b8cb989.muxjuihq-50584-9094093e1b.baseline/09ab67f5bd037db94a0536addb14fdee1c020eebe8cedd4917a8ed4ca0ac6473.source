class TestReflectDamageReturnStructure(_BaseReflectDamageTest):
    """_apply_reflect_damage: 返回值结构。"""

    def test_return_value_fields_complete(self):
        """返回值包含所有必要字段。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        caster.skill_levels = {130088: 10}
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130088
        effect = _make_reflect_effect()

        result = ss._apply_reflect_damage(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertIn("effect_type", result)
        self.assertIn("reflect_rate", result)
        self.assertIn("caster_id", result)
        self.assertEqual(result["effect_type"], "reflect_damage")
        self.assertEqual(result["caster_id"], "c")
        self.assertAlmostEqual(result["reflect_rate"], 50.0, places=2)


# ═══════════════════════════════════════════════════════════════════════
# Part 5: _apply_damage 中的反射结算
# ═══════════════════════════════════════════════════════════════════════

class TestReflectDamageInApplyDamage(_BaseReflectDamageTest):
    """_apply_damage 中的反射伤害结算。"""

    def _setup_cover_scenario(self, *, reflect_rate=50.0, attacker_hp=100000,
                              coverer_hp=100000, target_hp=100000,
                              attacker_atk=20000, attacker_defense=0):
        """构造 cover 反射场景。

        场景：attacker(ENEMY) 攻击 target(ALLY)，
        coverer(ALLY) cover target，且 reflect_rate > 0。
        attacker → target 被 cover 替换为 attacker → coverer。
        coverer 承受伤害后反射给 attacker。
        """
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                              hp=attacker_hp, atk=attacker_atk, defense=attacker_defense)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=target_hp, atk=100, defense=0)
        coverer = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK,
                             hp=coverer_hp, atk=100, defense=0)
        # 设置 cover 状态
        coverer.cover_target = target.unit_id
        coverer.reflect_rate = reflect_rate
        bf = _make_bf(attacker, target, coverer)
        ss, *_ = self._make_services(bf)
        ss.set_battlefield(bf)
        self._init_damage_state(ss)
        # 强制不暴击
        ss.damage_service.clear_crit_override()
        return ss, attacker, target, coverer, bf

    def test_no_cover_no_reflect(self):
        """无 cover 时不反射。"""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                              atk=20000, defense=0)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=100000, atk=100, defense=0)
        # target 有 reflect_rate 但没有 cover
        target.reflect_rate = 50.0
        bf = _make_bf(attacker, target)
        ss, *_ = self._make_services(bf)
        ss.set_battlefield(bf)
        self._init_damage_state(ss)
        ss.damage_service.clear_crit_override()

        attacker_hp_before = attacker.current_hp
        effect = _make_damage_effect(value=100.0)

        ss._apply_damage(attacker, effect, bf)

        # 无 cover，attacker HP 不变（反射不触发）
        self.assertEqual(attacker.current_hp, attacker_hp_before)

    def test_cover_triggers_reflect(self):
        """cover 替换位置时触发反射，attacker HP 减少。"""
        ss, attacker, target, coverer, bf = self._setup_cover_scenario(
            reflect_rate=50.0, attacker_atk=20000)

        attacker_hp_before = attacker.current_hp
        effect = _make_damage_effect(value=100.0)

        ss._apply_damage(attacker, effect, bf)

        # attacker 应受到反射伤害
        reflect_loss = attacker_hp_before - attacker.current_hp
        self.assertGreater(reflect_loss, 0, "attacker should take reflect damage")

    def test_zero_reflect_rate_no_reflect(self):
        """reflect_rate=0 时不反射。"""
        ss, attacker, target, coverer, bf = self._setup_cover_scenario(
            reflect_rate=0.0)

        attacker_hp_before = attacker.current_hp
        effect = _make_damage_effect(value=100.0)

        ss._apply_damage(attacker, effect, bf)

        # reflect_rate=0，无反射
        self.assertEqual(attacker.current_hp, attacker_hp_before)

    def test_reflect_damage_calculation(self):
        """反射伤害 = int(source_total_dmg * rate / 100)。"""
        # attacker_atk=10000, power=100% → base_dmg ≈ 10000（def=0）
        # reflect_rate=50 → reflect_dmg ≈ 5000
        ss, attacker, target, coverer, bf = self._setup_cover_scenario(
            reflect_rate=50.0, attacker_atk=10000)

        attacker_hp_before = attacker.current_hp
        effect = _make_damage_effect(value=100.0)

        ss._apply_damage(attacker, effect, bf)

        reflect_loss = attacker_hp_before - attacker.current_hp
        # 基础伤害约 10000，反射 50% ≈ 5000
        # 允许一定范围浮动（属性因子等）
        self.assertGreater(reflect_loss, 3000, f"reflect should be ~5000, got {reflect_loss}")
        self.assertLess(reflect_loss, 7000, f"reflect should be ~5000, got {reflect_loss}")

    def test_reflect_not_absorbed_by_shield(self):
        """反射伤害不被盾吸收（直接扣HP）。"""
        ss, attacker, target, coverer, bf = self._setup_cover_scenario(
            reflect_rate=50.0, attacker_atk=10000)
        # 给 attacker 加盾
        attacker.shield = 100000
        attacker.physical_shield = 100000
        attacker.en_shield = 100000

        attacker_hp_before = attacker.current_hp
        effect = _make_damage_effect(value=100.0)

        ss._apply_damage(attacker, effect, bf)

        reflect_loss = attacker_hp_before - attacker.current_hp
        # 反射伤害不被盾吸收，直接扣HP
        self.assertGreater(reflect_loss, 3000, "reflect should bypass shields")
        # 盾未被反射伤害消耗（原本的盾可能被其他伤害消耗，这里只验证HP确实减少）
        # 注意：attacker 的盾可能被 coverer 的反击或其他逻辑消耗，主要验证 HP 减少

    def test_reflect_updates_damage_totals(self):
        """反射伤害计入 damage_taken_total / damage_dealt_total。"""
        ss, attacker, target, coverer, bf = self._setup_cover_scenario(
            reflect_rate=50.0, attacker_atk=10000)

        attacker_taken_before = attacker.damage_taken_total
        coverer_dealt_before = coverer.damage_dealt_total
        effect = _make_damage_effect(value=100.0)

        ss._apply_damage(attacker, effect, bf)

        # attacker 承受反射伤害
        self.assertGreater(attacker.damage_taken_total, attacker_taken_before)
        # coverer 造成反射伤害
        self.assertGreater(coverer.damage_dealt_total, coverer_dealt_before)
        # 两者增量应相等
        attacker_gain = attacker.damage_taken_total - attacker_taken_before
        coverer_gain = coverer.damage_dealt_total - coverer_dealt_before
        self.assertEqual(attacker_gain, coverer_gain,
                         "reflect damage should be equal on both sides")

    def test_reflect_scoring_tracker_called(self):
        """反射伤害调用 scoring_tracker.record_damage。"""
        ss, attacker, target, coverer, bf = self._setup_cover_scenario(
            reflect_rate=50.0, attacker_atk=10000)
        # 注入 mock scoring_tracker
        bf.scoring_tracker = MagicMock()

        effect = _make_damage_effect(value=100.0)
        ss._apply_damage(attacker, effect, bf)

        # 应该至少有一次 record_damage 调用（反射）
        # 注意：正常伤害也会调用 record_damage，所以至少验证有调用
        self.assertGreater(bf.scoring_tracker.record_damage.call_count, 0)
        # 检查是否有 source_id=coverer 的调用（反射）
        reflect_calls = [
            call for call in bf.scoring_tracker.record_damage.call_args_list
            if call.kwargs.get('source_id') == 'coverer'
        ]
        self.assertGreater(len(reflect_calls), 0,
                           "should have reflect call with source_id=coverer")

    def test_no_scoring_tracker_no_error(self):
        """无 scoring_tracker 时不报错。"""
        ss, attacker, target, coverer, bf = self._setup_cover_scenario(
            reflect_rate=50.0, attacker_atk=10000)
        # 不设置 scoring_tracker

        effect = _make_damage_effect(value=100.0)
        # 不应抛出异常
        ss._apply_damage(attacker, effect, bf)

    def test_caster_dead_no_reflect(self):
        """caster（attacker）死亡时不反射。"""
        ss, attacker, target, coverer, bf = self._setup_cover_scenario(
            reflect_rate=50.0, attacker_atk=10000)
        # 让 attacker 死亡
        attacker.is_alive = False
        attacker.current_hp = 0

        attacker_hp_before = attacker.current_hp
        coverer_hp_before = coverer.current_hp
        effect = _make_damage_effect(value=100.0)

        # 不应抛出异常，且不反射
        ss._apply_damage(attacker, effect, bf)

        # attacker 已死，HP 不变
        self.assertEqual(attacker.current_hp, attacker_hp_before)

    def test_coverer_dead_no_reflect(self):
        """coverer 死亡时不反射。"""
        ss, attacker, target, coverer, bf = self._setup_cover_scenario(
            reflect_rate=50.0, attacker_atk=10000)
        # 让 coverer 死亡
        coverer.is_alive = False
        coverer.current_hp = 0

        attacker_hp_before = attacker.current_hp
        effect = _make_damage_effect(value=100.0)

        ss._apply_damage(attacker, effect, bf)

        # coverer 已死，不反射
        self.assertEqual(attacker.current_hp, attacker_hp_before)

    def test_reflect_kills_caster(self):
        """反射伤害可以击杀 attacker。"""
        ss, attacker, target, coverer, bf = self._setup_cover_scenario(
            reflect_rate=100.0,  # 100% 反射
            attacker_atk=10000,
            attacker_hp=1000)  # 低 HP

        effect = _make_damage_effect(value=100.0)
        ss._apply_damage(attacker, effect, bf)

        # attacker 应被反射击杀
        self.assertLessEqual(attacker.current_hp, 0,
                             "attacker should be killed by reflect")

    def test_multiple_cover_replacements_each_reflect(self):
        """多 cover 替换各自反射（需 2 个 coverer 各 cover 1 个 target）。

        场景：attacker 用 enemy_all 攻击 2 个 target，
        每个 target 都被不同的 coverer cover，两个 coverer 都有 reflect_rate。
        """
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                              hp=100000, atk=10000, defense=0)
        t1 = _make_unit("t1", "目標1", Side.ALLY, Position.ALLY_LEFT_FRONT,
                        hp=100000, atk=100, defense=0)
        t2 = _make_unit("t2", "目標2", Side.ALLY, Position.ALLY_RIGHT_FRONT,
                        hp=100000, atk=100, defense=0)
        c1 = _make_unit("c1", "援護者1", Side.ALLY, Position.ALLY_LEFT_BACK,
                        hp=100000, atk=100, defense=0)
        c2 = _make_unit("c2", "援護者2", Side.ALLY, Position.ALLY_CENTER_BACK,
                        hp=100000, atk=100, defense=0)
        c1.cover_target = t1.unit_id
        c1.reflect_rate = 50.0
        c2.cover_target = t2.unit_id
        c2.reflect_rate = 30.0
        bf = _make_bf(attacker, t1, t2, c1, c2)
        ss, *_ = self._make_services(bf)
        ss.set_battlefield(bf)
        self._init_damage_state(ss)
        ss.damage_service.clear_crit_override()

        attacker_hp_before = attacker.current_hp
        # 使用 enemy_all 攻击所有敌方（ALLY 视角下 t1/t2 是敌方？不对）
        # attacker 是 ENEMY，target 应该是 ALLY
        # enemy_all 对 attacker 来说是所有 ALLY 单位
        effect = _make_damage_effect(value=100.0, target_type='enemy_all')

        ss._apply_damage(attacker, effect, bf)

        reflect_loss = attacker_hp_before - attacker.current_hp
        # 两个 coverer 都反射，总反射量应大于单个
        self.assertGreater(reflect_loss, 5000,
                           f"two reflectors should deal more damage, got {reflect_loss}")


if __name__ == '__main__':
    unittest.main()
