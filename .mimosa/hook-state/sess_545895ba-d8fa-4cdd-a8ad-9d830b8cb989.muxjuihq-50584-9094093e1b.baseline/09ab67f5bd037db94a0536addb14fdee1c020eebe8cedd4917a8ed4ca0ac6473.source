"""_apply_reflect_damage 与反射伤害结算单元测试。

测试目标：
1. _apply_reflect_damage 入口检查
   - 无 value_tag 返回 None
   - value_tag != "reflect" 返回 None
   - reflect_value <= 0 返回 None
   - 技能不存在时 reflect_value=0 返回 None

2. value_tag 解析
   - value_tag="reflect" 使用真实技能 130088 解析
   - 不同 skill_level 解析不同值（Lv1=25, Lv10=50, Lv15=75）
   - skill_levels 中无对应技能时使用默认 level=1

3. reflect_rate 设置
   - caster.reflect_rate 被正确设置
   - 多次调用覆写
   - 原始 reflect_rate=0 被覆写为非零

4. 返回值结构
   - effect_type / reflect_rate / caster_id 字段完整性

5. _apply_damage 中反射结算（需触发 cover 场景）
   - 无 cover 时不反射
   - cover 替换位置触发反射
   - reflect_rate=0 不反射
   - source_total_dmg=0 不反射（闪避/全盾吸收且无最低1点）
   - reflect_dmg = int(source_total_dmg * rate / 100)
   - 反射伤害不被盾吸收（直接扣HP）
   - 反射伤害计入 damage_taken_total / damage_dealt_total
   - scoring_tracker 调用
   - caster 死亡时不反射
   - coverer 死亡时不反射
   - 多 cover 替换各自反射
"""
import sys
import os
import unittest
from unittest.mock import MagicMock

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


# ─── 工厂函数 ──────────────────────────────────────────────

def _make_unit(unit_id, name, side, position, *, hp=50000, atk=10000,
               defense=0, speed=500, current_hp=None, character_type=1):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=2, character_type=character_type,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


def _make_reflect_effect(**kwargs):
    """Create a mock reflect_damage effect object."""
    defaults = {
        'effect_type': 'reflect_damage',
        'value': None,
        'value_tag': 'reflect',
        'target_type': 'self',
        'value_source': None,
        'flags': {},
        'target_identifier': None,
        'hit_count': None,
        'condition': None,
        'duration': -1,
        'duration_type': 'attacker_action',
        'ignore_defense': 0,
        'ignore_shield': 0,
    }
    defaults.update(kwargs)
    obj = type('obj', (object,), defaults)()
    return obj


def _make_damage_effect(**kwargs):
    """Create a mock damage effect object."""
    defaults = {
        'effect_type': 'damage',
        'value': 100.0,
        'value_tag': None,
        'target_type': 'enemy_single',
        'flags': {},
        'target_identifier': None,
        'hit_count': 1,
        'condition': None,
        'duration': 1,
        'duration_type': None,
        'ignore_defense': 0,
        'ignore_shield': 0,
    }
    defaults.update(kwargs)
    obj = type('obj', (object,), defaults)()
    return obj


class _BaseReflectDamageTest(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts, aus, dms, sts

    def _init_damage_state(self, ss):
        """初始化 _apply_damage 所需的内部状态。"""
        ss._most_recent_damage = 0
        ss._hp_consumed = 0
        ss._per_hit_hp_losses = {}
        ss._block_damage_targets = {}
        ss._block_evaded_targets = set()
        ss._current_attack_targets = []
        ss._original_primary_target = None
        ss._cover_replaced_indices = set()
        ss._cover_info = {}
        ss._pending_deaths = set()
        ss._pending_crit_triggers = []
        ss._recursion_guard = False
        ss._current_skill_id = 110001
        ss._current_block_id = 1
        ss._block_damage_total = {}


# ═══════════════════════════════════════════════════════════════════════
# Part 1: _apply_reflect_damage 入口检查
# ═══════════════════════════════════════════════════════════════════════

class TestApplyReflectDamageEntry(_BaseReflectDamageTest):
    """_apply_reflect_damage: 入口检查。"""

    def test_no_value_tag_returns_none(self):
        """无 value_tag 时返回 None。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130088
        effect = _make_reflect_effect(value_tag=None)

        result = ss._apply_reflect_damage(caster, effect, bf)

        self.assertIsNone(result)
        self.assertEqual(caster.reflect_rate, 0.0)

    def test_wrong_value_tag_returns_none(self):
        """value_tag != 'reflect' 时返回 None。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130088
        effect = _make_reflect_effect(value_tag="shield")

        result = ss._apply_reflect_damage(caster, effect, bf)

        self.assertIsNone(result)
        self.assertEqual(caster.reflect_rate, 0.0)

    def test_skill_not_found_returns_none(self):
        """技能不存在时 reflect_value=0 返回 None。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 999999  # 不存在的技能
        effect = _make_reflect_effect()

        result = ss._apply_reflect_damage(caster, effect, bf)

        self.assertIsNone(result)
        self.assertEqual(caster.reflect_rate, 0.0)

    def test_no_template_tags_returns_none(self):
        """技能无 template_tags 时 reflect_value=0 返回 None。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        # 110001 是一个普通攻击技能，通常没有 reflect template_tag
        ss._current_skill_id = 110001
        effect = _make_reflect_effect()

        result = ss._apply_reflect_damage(caster, effect, bf)

        self.assertIsNone(result)
        self.assertEqual(caster.reflect_rate, 0.0)


# ═══════════════════════════════════════════════════════════════════════
# Part 2: value_tag 解析
# ═══════════════════════════════════════════════════════════════════════

class TestReflectDamageValueTagResolution(_BaseReflectDamageTest):
    """_apply_reflect_damage: value_tag 解析。"""

    def test_reflect_value_lv1(self):
        """130088 Lv1 的 reflect 值为 25.0。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        caster.skill_levels = {130088: 1}
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130088
        effect = _make_reflect_effect()

        result = ss._apply_reflect_damage(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertAlmostEqual(result["reflect_rate"], 25.0, places=2)
        self.assertAlmostEqual(caster.reflect_rate, 25.0, places=2)

    def test_reflect_value_lv10(self):
        """130088 Lv10 的 reflect 值为 50.0。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        caster.skill_levels = {130088: 10}
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130088
        effect = _make_reflect_effect()

        result = ss._apply_reflect_damage(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertAlmostEqual(result["reflect_rate"], 50.0, places=2)
        self.assertAlmostEqual(caster.reflect_rate, 50.0, places=2)

    def test_reflect_value_lv15(self):
        """130088 Lv15 的 reflect 值为 75.0。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        caster.skill_levels = {130088: 15}
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130088
        effect = _make_reflect_effect()

        result = ss._apply_reflect_damage(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertAlmostEqual(result["reflect_rate"], 75.0, places=2)
        self.assertAlmostEqual(caster.reflect_rate, 75.0, places=2)

    def test_no_skill_level_uses_default_lv1(self):
        """skill_levels 中无对应技能时使用默认 level=1。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        caster.skill_levels = {}  # 无任何技能等级
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130088
        effect = _make_reflect_effect()

        result = ss._apply_reflect_damage(caster, effect, bf)

        # 默认 level=1, reflect=25.0
        self.assertIsNotNone(result)
        self.assertAlmostEqual(result["reflect_rate"], 25.0, places=2)


# ═══════════════════════════════════════════════════════════════════════
# Part 3: reflect_rate 设置
# ═══════════════════════════════════════════════════════════════════════

class TestReflectRateSetting(_BaseReflectDamageTest):
    """_apply_reflect_damage: reflect_rate 设置。"""

    def test_reflect_rate_set_on_caster(self):
        """caster.reflect_rate 被正确设置。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        caster.skill_levels = {130088: 10}
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130088
        effect = _make_reflect_effect()

        # 初始为 0
        self.assertEqual(caster.reflect_rate, 0.0)

        ss._apply_reflect_damage(caster, effect, bf)

        self.assertAlmostEqual(caster.reflect_rate, 50.0, places=2)

    def test_multiple_calls_overwrite(self):
        """多次调用覆写 reflect_rate。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130088
        effect = _make_reflect_effect()

        # 第一次 Lv1 → 25
        caster.skill_levels = {130088: 1}
        ss._apply_reflect_damage(caster, effect, bf)
        self.assertAlmostEqual(caster.reflect_rate, 25.0, places=2)

        # 第二次 Lv10 → 50（覆写）
        caster.skill_levels = {130088: 10}
        ss._apply_reflect_damage(caster, effect, bf)
        self.assertAlmostEqual(caster.reflect_rate, 50.0, places=2)

        # 第三次 Lv15 → 75（覆写）
        caster.skill_levels = {130088: 15}
        ss._apply_reflect_damage(caster, effect, bf)
        self.assertAlmostEqual(caster.reflect_rate, 75.0, places=2)

    def test_zero_reflect_rate_overwritten(self):
        """原始 reflect_rate=0 被覆写为非零。"""
        caster = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        caster.skill_levels = {130088: 10}
        # 预设为 0
        caster.reflect_rate = 0.0
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130088
        effect = _make_reflect_effect()

        ss._apply_reflect_damage(caster, effect, bf)

        self.assertAlmostEqual(caster.reflect_rate, 50.0, places=2)


