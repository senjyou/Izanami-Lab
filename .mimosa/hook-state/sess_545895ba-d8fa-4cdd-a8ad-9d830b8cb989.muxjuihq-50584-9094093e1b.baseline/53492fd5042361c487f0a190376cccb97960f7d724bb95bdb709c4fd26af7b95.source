"""角色102301 博識なメイズの探求者 专项E2E测试（补充）

技能列表：
- EX: 110005 Q.E.D.（敵全体攻撃[威力] + 状態異常者にstun(1行動)；Lv11+ dmg_taken_up[attack_limited=1, stackable]）
- AS1: 120050 Pスラスト（前後列攻撃 + 毒目標にdef_down(20%, stackable, attacker_action-1)；Lv11+ HP>=80%目標にpoison(3行動)）
- AS2: 120051 多重連突（敵単体多hit攻撃；Lv1-10 hit=8, Lv15 hit=13）
- PS1: 130056 ポイズンチェイス（after_ally_as_attack + actor_element=3(風)；追撃+poison(2行動)；cooldown=1）
- PS2: 130057 ポイズンライド（before_ally_as_attack + actor_character_type=3(敏捷型)；附魔伤害buff+carried_debuff poison；simultaneous_limit；cooldown=1）

补充覆盖维度（与 test_maze_seeker_102301.py 互补）：
1. 角色数据 + 技能hybrid + PS trigger_type 配置校验
2. EX cooldown=0 / Lv1-10 仅stun（无dmg_taken_up）
3. AS1 cooldown=2 / 前後列範囲 / Lv11+ HP>=80% poison付与 / Block2 Lv10 跳过
4. AS2 cooldown=0 / hit数（Lv10=8, Lv15=13）
5. PS1 cooldown=1 + 冷却中不触发 + PP消耗
6. PS2 cooldown=1 + 冷却中不触发 + PP消耗 + add_damage_to_attack stackable + carried_debuff 传递
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value  # def_up/def_down
STUN = SkillEffectType.KNOCKOUT.value                   # 気絶
POISON = SkillEffectType.POISON.value                   # 毒
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value  # dmg_taken_up/down
ENCHANT_DAMAGE = SkillEffectType.ENCHANT_DAMAGE.value   # 附魔伤害


class TestActor102301(unittest.TestCase):
    """角色102301 博識なメイズの探求者 专项E2E测试（补充）"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 102301 (風属性=3, 敏捷型=3, 灵活站位→放后排)
        self.caster = UnitState(
            unit_id="caster", name="博識なメイズの探求者", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=102301, level=15,
            element=3, character_type=3,
            max_hp=120000, current_hp=120000,
            attack=150000, defense=50000, speed=1000,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110005, 120050, 120051, 130056, 130057],
            skill_levels={110005: 15, 120050: 15, 120051: 15,
                          130056: 15, 130057: 15},
            skill_cooldowns={},
        )

        # 友方前排（風属性+敏捷型，PS1+PS2 触发者）
        self.ally_front = UnitState(
            unit_id="ally_front", name="味方前排(風・敏捷)", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999101, level=15,
            element=3, character_type=3,
            max_hp=100000, current_hp=100000,
            attack=100000, defense=40000, speed=800,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[120051], skill_levels={120051: 15}, skill_cooldowns={},
        )

        # 友方前排B（火属性+敏捷型，PS1属性不匹配但PS2类型匹配）
        self.ally_front_fire = UnitState(
            unit_id="ally_front_fire", name="味方前排(火・敏捷)", side=Side.ALLY,
            position=Position.ALLY_RIGHT_FRONT, character_id=999102, level=15,
            element=1, character_type=3,
            max_hp=100000, current_hp=100000,
            attack=100000, defense=40000, speed=800,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[120051], skill_levels={120051: 15}, skill_cooldowns={},
        )

        # 敌方前排中央（最近敌）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=15,
            element=1, character_type=1,
            max_hp=500000, current_hp=500000,
            attack=50000, defense=30000, speed=500,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=15,
            element=1, character_type=1,
            max_hp=500000, current_hp=500000,
            attack=50000, defense=30000, speed=400,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方后排中央
        self.enemy_cb = UnitState(
            unit_id="enemy_cb", name="敵中後", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=999004, level=15,
            element=1, character_type=1,
            max_hp=500000, current_hp=500000,
            attack=50000, defense=30000, speed=600,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
