"""Regression: 130020 ディクライン・カヴァー (103201 お金大好きな生意気娘).

Validates:
1. PS triggers on before_any_attacked when OTHER ally is attacked (not self)
2. PS does NOT trigger when self is attacked (target_is_other_ally condition)
3. dmg_taken_down buff applied to the ATTACKED ALLY (not the enemy attacker)
4. Buff reduces physical damage taken by 50% (Lv10)
5. Buff consumed after 1 hit (attack_limited=1, duration_type="hit")
6. stackable=true (multiple casts can coexist)

Bug: Original config used target_identifier="trigger_attacker" which for
     before_any_attacked resolves to the ENEMY attacker, not the attacked ally.
     The buff was incorrectly applied to the enemy instead of the ally.
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'src'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

SKILL_ID = 130020  # ディクライン・カヴァー


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=0, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ap=10,
               crit_rate=0.0, crit_damage=0.5, current_hp=None):
    u = UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )
    return u


class TestReg103201DeclineCover(unittest.TestCase):
    """130020: before_any_attacked (target_is_other_ally) -> ally dmg_taken_down."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _build_battlefield(self):
        """Build a battlefield with cover_owner + protected_ally + attacker.

        cover_owner: has 130020 PS
        protected_ally: the ally who will be attacked
        attacker: the enemy attacker
        """
        bf = BattlefieldState()
        cover_owner = _make_unit(
            "cover_owner", "CoverOwner", Side.ALLY, Position.ALLY_LEFT_FRONT,
            hp=100000, atk=10000, defense=5000, speed=500,
            skills=[SKILL_ID], skill_levels={SKILL_ID: 10},
        )
        protected_ally = _make_unit(
            "protected_ally", "ProtectedAlly", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=5000, defense=0, speed=400,
        )
        attacker = _make_unit(
            "attacker", "Attacker", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=1000, defense=0, speed=800,
        )
        bf.friend_team = [cover_owner, protected_ally]
        bf.enemy_team = [attacker]

        ss = SkillService(
            self.dl, ResourceService(),
            target_service=TargetService(), damage_service=DamageService(),
            aura_service=AuraService(), trigger_service=TriggerService(),
            status_service=StatusService(),
        )
        ss.set_battlefield(bf)

        ts = ss.trigger_service
        ts.set_data_loader(self.dl)
        ts.set_skill_service(ss)

        return bf, ss, ts, cover_owner, protected_ally, attacker

    def test_ps_triggers_when_other_ally_attacked(self):
        """PS should trigger when another ally (not self) is about to be attacked."""
        bf, ss, ts, cover_owner, protected_ally, attacker = self._build_battlefield()
        actions = ts.trigger_before_any_attacked(
            targets=[protected_ally], battlefield=bf, attacker=attacker
        )
        ps_actions = [a for a in actions if a.skill_id == SKILL_ID]
        self.assertGreater(len(ps_actions), 0,
                           "130020 should trigger when other ally is attacked")

    def test_ps_does_not_trigger_when_self_attacked(self):
        """PS should NOT trigger when self is attacked (target_is_other_ally)."""
        bf, ss, ts, cover_owner, protected_ally, attacker = self._build_battlefield()
        actions = ts.trigger_before_any_attacked(
            targets=[cover_owner], battlefield=bf, attacker=attacker
        )
        ps_actions = [a for a in actions if a.skill_id == SKILL_ID]
        self.assertEqual(len(ps_actions), 0,
                         "130020 should NOT trigger when self is attacked")

    def test_buff_applied_to_attacked_ally_not_enemy(self):
        """dmg_taken_down buff should be applied to the ATTACKED ALLY, not the enemy.

        This is the key test for the bug: target_identifier="trigger_attacker"
        incorrectly targeted the enemy attacker instead of the attacked ally.
        """
        bf, ss, ts, cover_owner, protected_ally, attacker = self._build_battlefield()
        actions = ts.trigger_before_any_attacked(
            targets=[protected_ally], battlefield=bf, attacker=attacker
        )
        ps_actions = [a for a in actions if a.skill_id == SKILL_ID]
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_any_attacked"
        )

        # dmg_taken_down is mapped to ReceivedDamage (RECEIVED_DAMAGE enum)
        DMG_TAKEN_DOWN = SkillEffectType.RECEIVED_DAMAGE.value

        # The buff should be on the protected_ally (attacked ally)
        ally_buffs = [b for b in protected_ally.buffs if b.effect_type == DMG_TAKEN_DOWN]
        self.assertGreater(len(ally_buffs), 0,
                           "dmg_taken_down buff should be on the attacked ally")

        # The buff should NOT be on the enemy attacker
        enemy_buffs = [b for b in attacker.buffs if b.effect_type == DMG_TAKEN_DOWN]
        self.assertEqual(len(enemy_buffs), 0,
                         "dmg_taken_down buff should NOT be on the enemy attacker")

    def test_buff_value_is_50_percent_at_lv10(self):
        """Buff value should be 50% at Lv10 (reduces physical damage taken by 50%)."""
        bf, ss, ts, cover_owner, protected_ally, attacker = self._build_battlefield()
        actions = ts.trigger_before_any_attacked(
            targets=[protected_ally], battlefield=bf, attacker=attacker
        )
        ps_actions = [a for a in actions if a.skill_id == SKILL_ID]
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_any_attacked"
        )

        DMG_TAKEN_DOWN = SkillEffectType.RECEIVED_DAMAGE.value
        ally_buffs = [b for b in protected_ally.buffs if b.effect_type == DMG_TAKEN_DOWN]
        self.assertGreater(len(ally_buffs), 0)
        # Lv10 value = 50.0%
        self.assertAlmostEqual(ally_buffs[0].value, 50.0, delta=0.1)

    def test_attack_limited_is_one(self):
        """attack_limited should be 1 (consumed after 1 hit)."""
        bf, ss, ts, cover_owner, protected_ally, attacker = self._build_battlefield()
        actions = ts.trigger_before_any_attacked(
            targets=[protected_ally], battlefield=bf, attacker=attacker
        )
        ps_actions = [a for a in actions if a.skill_id == SKILL_ID]
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_any_attacked"
        )

        DMG_TAKEN_DOWN = SkillEffectType.RECEIVED_DAMAGE.value
        ally_buffs = [b for b in protected_ally.buffs if b.effect_type == DMG_TAKEN_DOWN]
        self.assertGreater(len(ally_buffs), 0)
        self.assertEqual(ally_buffs[0].attack_limited, 1,
                         "attack_limited should be 1")

    def test_simultaneous_limit_is_set(self):
        """simultaneous_limit should be True (同時発動制限)."""
        parsed = self.dl.get_parsed_skill_data(SKILL_ID)
        self.assertTrue(parsed.get('simultaneous_limit', False),
                        "130020 should have simultaneous_limit=true")


if __name__ == '__main__':
    unittest.main()
