"""Regression: 外殻強化 (230029) must trigger before チェイスブレイダー (130054)
and ファイティングブースト (130070), regardless of speed.

Bug: All post-AS triggers were merged into a single pool and sorted by speed.
If 外殻強化's owner (the attacked enemy) was slower than the follow-up PS owners,
外殻強化 fired AFTER the follow-up attacks.

Fix: Split post-AS trigger execution into two phases:
  Phase 1 (被攻撃反応): after_ally_attacked, after_self_attacked,
    after_as_attacked, after_as_attacked_ally
  Phase 2 (AS攻撃後追撃): after_ally_as_attack, after_self_as,
    on_critical, skill_use_count
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position


class TestRegGaikakuEarlyTrigger(unittest.TestCase):
    """外殻強化 must fire before チェイスブレイダー and ファイティングブースト."""

    @classmethod
    def setUpClass(cls):
        cls.dl = None  # loaded by BattleBuilder

    def _build(self):
        """2 allies + 1 enemy. Enemy (slow) has 外殻強化, allies (fast) have
        チェイスブレイダー and ファイティングブースト."""
        bb = BattleBuilder()
        # Ally attacker (fast): AS + ファイティングブースト
        bb.add_ally(unit_id="atk", position=Position.ALLY_CENTER_FRONT,
                    hp=99999, atk=1, speed=1000, skills=[120049, 130070], level=10, pp=10)
        # Ally support (fast): チェイスブレイダー
        bb.add_ally(unit_id="sup", position=Position.ALLY_LEFT_FRONT,
                    hp=99999, atk=1, speed=1000, skills=[130054], level=10, pp=10)
        # Enemy (slow): 外殻強化
        bb.add_enemy(unit_id="enemy", position=Position.ENEMY_CENTER_FRONT,
                     hp=99999, atk=1, speed=100, skills=[230029], level=10, pp=10)
        return bb.build()

    def test_after_self_attacked_fires_before_as_followups(self):
        """after_self_attacked (外殻強化) collected in Phase1, while
        after_ally_as_attack (チェイスブレイダー) and after_self_as
        (ファイティングブースト) collected in Phase2."""
        ctx = self._build()
        bf, ts, ss = ctx['bf'], ctx['ts'], ctx['ss']
        atk = next(u for u in bf.friend_team if u.unit_id == "atk")
        enemy = next(u for u in bf.enemy_team if u.unit_id == "enemy")

        # Execute AS skill (deals damage to enemy, triggers after_self_attacked)
        ss.execute_skill(caster=atk, skill_id=120049, battlefield=bf, skip_cost=True)

        damaged_targets = [enemy]
        primary_target = enemy

        # Collect Phase 1 triggers (被攻撃反応)
        after_self = ts.trigger_after_self_attacked(
            damaged_targets, bf, actor=atk, primary_target=primary_target
        )
        # 外殻強化 (230029) should be in after_self_attacked
        gaikaku_owners = {a.instance.owner.unit_id for a in after_self}
        self.assertIn("enemy", gaikaku_owners,
                      "外殻強化 should be collected via after_self_attacked")

        # Collect Phase 2 triggers (AS攻撃後追撃)
        after_ally_as = ts.trigger_after_ally_as_attack(
            atk, 120049, damaged_targets, bf, primary_target=primary_target
        )
        after_self_as = ts.trigger_after_skill_use(
            atk, 120049, {"success": True}, bf,
            primary_target=getattr(ss, '_last_primary_target', None)
        )

        # チェイスブレイダー (130054) should be in after_ally_as_attack
        chase_owners = {a.instance.owner.unit_id for a in after_ally_as}
        self.assertIn("sup", chase_owners,
                      "チェイスブレイダー should be collected via after_ally_as_attack")

        # ファイティングブースト (130070) should be in after_self_as
        fighting_owners = {a.instance.owner.unit_id for a in after_self_as}
        self.assertIn("atk", fighting_owners,
                      "ファイティングブースト should be collected via after_self_as")

        # Phase separation: 外殻強化 is NOT in Phase2 pools
        phase2_all_owners = chase_owners | fighting_owners
        self.assertNotIn("enemy", phase2_all_owners,
                         "外殻強化 should NOT appear in Phase2 (AS追撃) pools")

        # Phase separation: チェイスブレイダー and ファイティングブースト
        # are NOT in Phase1 pool
        phase1_owners = gaikaku_owners
        self.assertNotIn("sup", phase1_owners,
                         "チェイスブレイダー should NOT appear in Phase1 (被攻撃反応) pool")
        self.assertNotIn("atk", phase1_owners,
                         "ファイティングブースト should NOT appear in Phase1 (被攻撃反応) pool")

    def test_phase_split_in_battle_flow(self):
        """Verify that the battle_flow_controller code splits triggers into
        two phases by confirming 外殻強化's owner is NOT among the Phase2
        trigger owners (after_ally_as_attack + after_self_as).

        This is a structural test: the trigger_type mapping guarantees that
        after_self_attacked and after_ally_as_attack/after_self_as are
        different TriggerTiming values, so they can never appear in the same
        collection call. The phase split in battle_flow_controller relies on
        this separation.
        """
        from src.combat_v2.services.trigger_service import TriggerTiming
        # after_self_attacked (外殻強化) is a different timing from
        # after_ally_as_attack (チェイスブレイダー) and after_self_as (ファイティングブースト)
        self.assertNotEqual(TriggerTiming.AFTER_SELF_ATTACKED, TriggerTiming.AFTER_ALLY_AS_ATTACK)
        self.assertNotEqual(TriggerTiming.AFTER_SELF_ATTACKED, TriggerTiming.AFTER_SKILL_USE)


if __name__ == '__main__':
    unittest.main()
