"""Tests for enemy character 652105 - 惨禍：大賀真桜.

Skills: 210113(EX), 220409(AS1), 220410(AS2), 230424(PS1), 230425(PS2)

敌方版技能与己方142302(110070/120156/120157/130154/130155)同名同机制，
差异：
- active_level_min阈值：敌方DefaultMaxLevel=10
  - EX cheat_death: Lv3=1hit, Lv5=3hits, Lv10=5hits（己方Lv11-15线性1-5hits）
  - PS1 crit_dmg_up: Lv10+（己方Lv11+）
  - PS2 dmg_dealt_up: Lv5+（己方Lv11+）
- EX atk: 固定15%（己方Lv1=10→Lv15=15线性）
- AS1 HP阈值: 1.5%（己方30%），HP消耗: 0.75%（己方15%）
- PS2 dmg_taken_down: 固定40%（己方hp_ratio_dynamic 30-50%）
"""
import unittest
import sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import SkillEffectType, Position, Side

# 效果类型简写
MARK = SkillEffectType.MARK.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_CRITICAL_CHANCE = SkillEffectType.STATUS_CRITICAL_CHANCE.value
CRITICAL_BONUS_MODIFICATION = SkillEffectType.CRITICAL_BONUS_MODIFICATION.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
EP_GAIN_DOWN = SkillEffectType.EP_GAIN_DOWN.value
KNOCKOUT = SkillEffectType.KNOCKOUT.value  # stun 被映射为 KNOCKOUT
CHEAT_DEATH = "cheat_death"


# ═══════════════════════════════════════════════════════════════
# 210113 真夏のトラブル発生！ (EX)
# ═══════════════════════════════════════════════════════════════

class TestEX210113(unittest.TestCase):
    """EX：自身付与2行动「解放感」mark + atk_up(linked,15%) + dmg_dealt_up(linked,10%)
    + ep_gain_down(linked,100%)。
    Lv3-4: cheat_death(1hit). Lv5-9: cheat_death(3hits). Lv10: cheat_death(5hits)."""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=390844, atk=12184, defense=5659, speed=607,
                     skills=[210113], level=10, ep=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")

    def test_grants_kaihoukan_mark(self):
        """Block1: 自身付与「解放感」mark(is_buff_mark, duration=2)。"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210113,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        marks = [b for b in self.caster.buffs
                 if b.effect_type == MARK and b.name == "解放感"]
        self.assertEqual(len(marks), 1, "应施加1个解放感mark")
        self.assertFalse(marks[0].is_debuff, "解放感mark应为buff")
        self.assertEqual(marks[0].duration, 2, "duration应为2")

    def test_grants_atk_up_linked_15pct(self):
        """Block1: atk_up(linked=解放感, stackable, value=15%)。敌方atk固定15%。"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210113,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "应有 atk_up buff")
        self.assertEqual(atk_ups[0].duration, 2, "duration应为2")
        self.assertTrue(atk_ups[0].is_stackable, "应可叠加")
        self.assertEqual(getattr(atk_ups[0], 'linked_buff_id', ""),
                         "解放感", "应 linked=解放感")
        # 敌方atk固定15%（不随等级变化）
        self.assertAlmostEqual(atk_ups[0].value, 15.0, places=1,
                               msg="敌方atk应固定15%")

    def test_grants_dmg_dealt_up_linked_10pct(self):
        """Block1: dmg_dealt_up(linked=解放感, stackable, value=10%)。"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210113,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        dmg_ups = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_ups), 0, "应有 dmg_dealt_up buff")
        self.assertEqual(dmg_ups[0].duration, 2, "duration应为2")
        self.assertTrue(dmg_ups[0].is_stackable, "应可叠加")
        self.assertEqual(getattr(dmg_ups[0], 'linked_buff_id', ""),
                         "解放感", "应 linked=解放感")
        self.assertAlmostEqual(dmg_ups[0].value, 10.0, places=1,
                               msg="dmg应固定10%")

    def test_grants_ep_gain_down_linked_100pct(self):
        """Block1: ep_gain_down(linked=解放感, value=100%)。"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210113,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        ep_downs = [d for d in self.caster.debuffs if d.effect_type == EP_GAIN_DOWN]
        self.assertGreater(len(ep_downs), 0, "应有 ep_gain_down debuff")
        self.assertEqual(ep_downs[0].value, 100.0, "value应为100%")
        self.assertEqual(ep_downs[0].duration, 2, "duration应为2")
        self.assertEqual(getattr(ep_downs[0], 'linked_buff_id', ""),
                         "解放感", "应 linked=解放感")

    def test_lv2_no_cheat_death(self):
        """Lv2: 无 cheat_death（Block2 active_level_min=3 未满足）。"""
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=390844, atk=12184, defense=5659, speed=607,
                     skills=[210113], level=2, ep=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.enemy_team if u.unit_id == "c")
        result = ss.execute_skill(caster=caster, skill_id=210113,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        cheat_deaths = [b for b in caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_deaths), 0, "Lv2不应有 cheat_death")

    def test_lv3_grants_cheat_death_1hit(self):
        """Lv3-4 Block2: cheat_death(stack_count=1, linked=解放感)。"""
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=390844, atk=12184, defense=5659, speed=607,
                     skills=[210113], level=3, ep=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.enemy_team if u.unit_id == "c")
        result = ss.execute_skill(caster=caster, skill_id=210113,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        cheat_deaths = [b for b in caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_deaths), 1, "Lv3应有1个 cheat_death buff")
        self.assertEqual(getattr(cheat_deaths[0], 'stack_count', 1), 1,
                         "Lv3 stack_count应为1")
        self.assertEqual(getattr(cheat_deaths[0], 'linked_buff_id', ""),
                         "解放感", "应 linked=解放感")

    def test_lv5_grants_cheat_death_3hits(self):
        """Lv5-9 Block3: cheat_death(stack_count=3, linked=解放感)。"""
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=390844, atk=12184, defense=5659, speed=607,
                     skills=[210113], level=5, ep=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.enemy_team if u.unit_id == "c")
        result = ss.execute_skill(caster=caster, skill_id=210113,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        cheat_deaths = [b for b in caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_deaths), 1, "Lv5应有1个 cheat_death buff")
        self.assertEqual(getattr(cheat_deaths[0], 'stack_count', 1), 3,
                         "Lv5 stack_count应为3")

    def test_lv10_grants_cheat_death_5hits(self):
        """Lv10 Block4: cheat_death(stack_count=5, linked=解放感)。"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210113,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        cheat_deaths = [b for b in self.caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_deaths), 1, "Lv10应有1个 cheat_death buff")
        self.assertEqual(getattr(cheat_deaths[0], 'stack_count', 1), 5,
                         "Lv10 stack_count应为5")
        self.assertEqual(getattr(cheat_deaths[0], 'linked_buff_id', ""),
                         "解放感", "应 linked=解放感")


# ═══════════════════════════════════════════════════════════════
# 220409 海辺の取り締まり！ (AS1)
# ═══════════════════════════════════════════════════════════════

class TestAS1220409(unittest.TestCase):
    """AS1：敵横一列EN攻撃(威力)。HP>=1.5%时消耗0.75%HP追加150%消耗HP基底EN伤害。
    有解放感时威力→威力2。"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=390844, atk=12184, defense=5659, speed=607,
                     skills=[220409], level=10)
        # 己方前排3体（enemy_row索敌从敌方视角指向己方前排）
        bb.add_ally(unit_id="a1", position=Position.ALLY_LEFT_FRONT, hp=50000)
        bb.add_ally(unit_id="a2", position=Position.ALLY_CENTER_FRONT, hp=50000)
        bb.add_ally(unit_id="a3", position=Position.ALLY_RIGHT_FRONT, hp=50000)
        bb.add_ally(unit_id="a_back", position=Position.ALLY_LEFT_BACK, hp=50000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")
        self.a2 = next(u for u in self.bf.friend_team if u.unit_id == "a2")
        self.a3 = next(u for u in self.bf.friend_team if u.unit_id == "a3")
        self.a_back = next(u for u in self.bf.friend_team if u.unit_id == "a_back")

    def _apply_kaihoukan(self, target=None):
        """附加「解放感」mark buff。"""
        from src.entities_v2.unit_state import BuffState
        if target is None:
            target = self.caster
        target.buffs.append(BuffState(
            buff_id=f"test_kaihoukan_{id(target)}",
            name="解放感", effect_type=MARK, value=0,
            duration=-1, timing_type=2, is_debuff=False,
        ))

    def test_block1_damage_without_kaihoukan(self):
        """Block1: 无解放感时执行，enemy_row EN 伤害（威力）。"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=220409,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 前排3体应受到伤害
        for ally, name in [(self.a1, "a1"), (self.a2, "a2"), (self.a3, "a3")]:
            self.assertLess(ally.current_hp, ally.max_hp,
                            f"{name}应受到Block1伤害")
        # 后排不应受到伤害（enemy_row只打前排）
        self.assertEqual(self.a_back.current_hp, self.a_back.max_hp,
                         "后排不应受到enemy_row伤害")

    def test_block2_damage_with_kaihoukan(self):
        """Block2: 有解放感时执行（威力2），Block1跳过。"""
        self._apply_kaihoukan(self.caster)
        result = self.ss.execute_skill(caster=self.caster, skill_id=220409,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for ally, name in [(self.a1, "a1"), (self.a2, "a2"), (self.a3, "a3")]:
            self.assertLess(ally.current_hp, ally.max_hp,
                            f"{name}应受到Block2伤害")

    def test_block3_skipped_when_hp_below_1_5(self):
        """Block3: HP<1.5%时跳过（不消耗HP，无追加伤害）。"""
        # 设置HP=1%（<1.5%）
        self.caster.current_hp = int(self.caster.max_hp * 0.01)
        hp_before = self.caster.current_hp

        result = self.ss.execute_skill(caster=self.caster, skill_id=220409,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # Block3跳过：caster HP不应被消耗
        self.assertEqual(self.caster.current_hp, hp_before,
                         "HP<1.5%时Block3跳过，caster HP不应被消耗")
        # 只有1个damage effect（仅Block1，无Block3追加）
        dmg_effects = [e for e in result["effects_applied"]
                       if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 1,
                         "HP<1.5%时应只有1个damage（Block1）")

    def test_block3_consumes_hp_when_hp_above_1_5(self):
        """Block3: HP>=1.5%时执行，消耗0.75% current HP。"""
        # HP=100%（>=1.5%）
        self.caster.current_hp = self.caster.max_hp
        hp_before = self.caster.current_hp

        result = self.ss.execute_skill(caster=self.caster, skill_id=220409,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 验证HP被消耗（0.75% of current_hp）
        expected_consume = int(self.caster.max_hp * 0.0075)
        actual_consume = hp_before - self.caster.current_hp
        self.assertEqual(actual_consume, expected_consume,
                         f"Block3应消耗0.75% HP={expected_consume}，实际={actual_consume}")
        # 验证 consume_hp effect 存在
        consume_effects = [e for e in result["effects_applied"]
                           if e.get("effect_type") == "consume_hp"]
        self.assertGreater(len(consume_effects), 0, "应有 consume_hp effect")

    def test_block3_additional_damage_150pct_consume_base(self):
        """Block3: 追加伤害(150% consume_hp base, EN)。

        Block1(威力) + Block3(150% consume_hp base) = 2个damage effect。
        """
        self.caster.current_hp = self.caster.max_hp
        result = self.ss.execute_skill(caster=self.caster, skill_id=220409,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        dmg_effects = [e for e in result["effects_applied"]
                       if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 2,
                         f"应执行Block1+Block3共2个damage effect，实际: {len(dmg_effects)}")


# ═══════════════════════════════════════════════════════════════
# 220410 うっかり大惨事 (AS2)
# ═══════════════════════════════════════════════════════════════

class TestAS2220410(unittest.TestCase):
    """AS2：敵3体EN攻撃(威力)。有解放感时对attacked_targets付1行动気絶。"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=390844, atk=12184, defense=5659, speed=607,
                     skills=[220410], level=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_LEFT_FRONT, hp=50000)
        bb.add_ally(unit_id="a2", position=Position.ALLY_CENTER_FRONT, hp=50000)
        bb.add_ally(unit_id="a3", position=Position.ALLY_RIGHT_FRONT, hp=50000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")
        self.a2 = next(u for u in self.bf.friend_team if u.unit_id == "a2")
        self.a3 = next(u for u in self.bf.friend_team if u.unit_id == "a3")

    def _apply_kaihoukan(self):
        from src.entities_v2.unit_state import BuffState
        self.caster.buffs.append(BuffState(
            buff_id=f"test_kaihoukan_{id(self.caster)}",
            name="解放感", effect_type=MARK, value=0,
            duration=-1, timing_type=2, is_debuff=False,
        ))

    def test_block1_damage_3_targets(self):
        """Block1: 敵3体 EN 伤害（target_count=3）。"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=220410,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 3个己方都受到伤害
        for ally, name in [(self.a1, "a1"), (self.a2, "a2"), (self.a3, "a3")]:
            self.assertLess(ally.current_hp, ally.max_hp,
                            f"{name}应受到伤害")
        # 无解放感时只有1个damage effect（Block1, target_count=3）
        dmg_effects = [e for e in result["effects_applied"]
                       if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 1,
                         f"无解放感时只执行Block1，应有1个damage effect")

    def test_block2_skipped_without_kaihoukan(self):
        """Block2: 无解放感时跳过（无stun debuff）。"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=220410,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for ally, name in [(self.a1, "a1"), (self.a2, "a2"), (self.a3, "a3")]:
            stuns = [d for d in ally.debuffs if d.effect_type == KNOCKOUT]
            self.assertEqual(len(stuns), 0, f"{name}无解放感时不应有stun")

    def test_block2_stun_with_kaihoukan(self):
        """Block2: 有解放感时执行，对 attacked_targets 付1行动気絶。"""
        self._apply_kaihoukan()
        result = self.ss.execute_skill(caster=self.caster, skill_id=220410,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for ally, name in [(self.a1, "a1"), (self.a2, "a2"), (self.a3, "a3")]:
            stuns = [d for d in ally.debuffs if d.effect_type == KNOCKOUT]
            self.assertGreater(len(stuns), 0, f"{name}有解放感时应有stun")
            self.assertEqual(stuns[0].duration, 1, f"{name} stun duration应为1")


# ═══════════════════════════════════════════════════════════════
# 230424 リフレッシュ完了！ (PS1)
# ═══════════════════════════════════════════════════════════════

class TestPS1230424(unittest.TestCase):
    """PS1：on_critical 每2次暴击触发。
    无解放感→add_ep 1。有解放感→crit_rate_up(stackable)。
    Lv10+有解放感→crit_dmg_up(stackable)。"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=390844, atk=12184, defense=5659, speed=607,
                     skills=[230424], level=10, pp=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")

    def _reset_caster(self, ep=0):
        self.caster.current_hp = self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ep = ep
        self.caster.crit_counter = 0

    def _apply_kaihoukan(self):
        from src.entities_v2.unit_state import BuffState
        self.caster.buffs.append(BuffState(
            buff_id=f"test_kaihoukan_{id(self.caster)}",
            name="解放感", effect_type=MARK, value=0,
            duration=-1, timing_type=2, is_debuff=False,
        ))

    def _trigger_ps1(self):
        """模拟2次暴击触发PS1（crit_count_mod=2）。"""
        actions = self.ts.trigger_pawn_caused_critical(
            caster=self.caster, battlefield=self.bf, count=2,
            crit_target=self.a1
        )
        ps_actions = [a for a in actions if a.skill_id == 230424]
        self.assertGreater(len(ps_actions), 0, "PS1应在2次暴击时被收集")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="pawn_caused_critical"
        )

    def test_block1_add_ep_without_kaihoukan(self):
        """Block1: 无解放感时执行，自身 add_ep 1。"""
        self._reset_caster(ep=0)
        self._trigger_ps1()
        # EP增加：generate_ep(1) + add_ep(1) = 2
        self.assertEqual(self.caster.current_ep, 2,
                         "Block1无解放感 → generate_ep(1) + add_ep(1) = EP=2")

    def test_block2_crit_rate_up_with_kaihoukan(self):
        """Block2: 有解放感时执行，自身 crit_rate_up(stackable)。"""
        self._reset_caster(ep=0)
        self._apply_kaihoukan()
        self._trigger_ps1()
        crit_ups = [b for b in self.caster.buffs
                    if b.effect_type == STATUS_CRITICAL_CHANCE]
        self.assertGreater(len(crit_ups), 0, "Block2有解放感 → 应有 crit_rate_up buff")
        self.assertTrue(crit_ups[0].is_stackable, "crit_rate_up应可叠加")
        # 有解放感时Block1跳过，仅 generate_ep(1) → EP=1
        self.assertEqual(self.caster.current_ep, 1,
                         "有解放感时Block1跳过，仅 generate_ep(1) → EP=1")

    def test_block3_lv10_grants_crit_dmg_up(self):
        """Block3: Lv10+ 有解放感时执行，自身 crit_dmg_up(stackable)。

        敌方Lv10+即触发（己方需Lv11+）。
        """
        self._reset_caster(ep=0)
        self._apply_kaihoukan()
        # Lv10（敌方DefaultMaxLevel=10）
        self.caster.level = 10
        self.caster.skill_levels[230424] = 10
        self._trigger_ps1()
        crit_dmg_ups = [b for b in self.caster.buffs
                        if b.effect_type == CRITICAL_BONUS_MODIFICATION]
        self.assertGreater(len(crit_dmg_ups), 0,
                           "Lv10+有解放感 → 应有 crit_dmg_up buff")
        self.assertTrue(crit_dmg_ups[0].is_stackable, "crit_dmg_up应可叠加")

    def test_block3_skipped_lv9(self):
        """Block3: Lv9 时跳过（active_level_min=10 未满足）。"""
        self._reset_caster(ep=0)
        self._apply_kaihoukan()
        self.caster.level = 9
        self.caster.skill_levels[230424] = 9
        self._trigger_ps1()
        crit_dmg_ups = [b for b in self.caster.buffs
                        if b.effect_type == CRITICAL_BONUS_MODIFICATION]
        self.assertEqual(len(crit_dmg_ups), 0,
                         "Lv9时Block3跳过，不应有 crit_dmg_up buff")

    def test_multiple_stacks(self):
        """多次触发 → crit_rate_up 叠加（stackable）。"""
        self._reset_caster(ep=0)
        self._apply_kaihoukan()

        # 第一次触发
        self._trigger_ps1()
        buffs_after_first = [b for b in self.caster.buffs
                             if b.effect_type == STATUS_CRITICAL_CHANCE]
        self.assertEqual(len(buffs_after_first), 1, "第一次应有1个crit_rate_up")

        # 第二次触发
        self._trigger_ps1()
        buffs_after_second = [b for b in self.caster.buffs
                              if b.effect_type == STATUS_CRITICAL_CHANCE]
        self.assertEqual(len(buffs_after_second), 2,
                         "第二次应叠加第2个crit_rate_up（stackable）")


# ═══════════════════════════════════════════════════════════════
# 230425 たまには羽を伸ばして+ (PS2)
# ═══════════════════════════════════════════════════════════════

class TestPS2230425(unittest.TestCase):
    """PS2：on_turn_start 戦闘中1回(cooldown=99)。
    Block1: consume_hp 30% + dmg_taken_down(固定40%, stackable, permanent)。
    Lv5+: dmg_dealt_up(target_hp_ratio_higher_than_self, stackable, permanent)。

    敌方差异：
    - dmg_taken_down为固定40%（己方hp_ratio_dynamic 30-50%）
    - dmg_dealt_up在Lv5+解锁（己方Lv11+）
    """

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=390844, atk=12184, defense=5659, speed=607,
                     skills=[230425], level=10, pp=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")

    def _reset_caster(self):
        self.caster.current_hp = self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}

    def _trigger_ps2(self):
        self.bf.turn_number = 2
        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 230425]
        self.assertGreater(len(ps2_actions), 0, "PS2应在回合开始时被收集")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

    def test_on_turn_start_triggers(self):
        """on_turn_start: 回合开始时触发（cooldown=99 戦闘中1回）。"""
        self._reset_caster()
        self._trigger_ps2()
        # 验证PS2执行后设置了冷却（cooldown=99）
        self.assertEqual(self.caster.skill_cooldowns.get(230425), 99,
                         "PS2执行后应设置 cooldown=99")

    def test_block1_consume_hp_30pct(self):
        """Block1: consume_hp 30% current HP。"""
        self._reset_caster()
        hp_before = self.caster.current_hp
        self._trigger_ps2()
        expected_consume = int(self.caster.max_hp * 0.30)
        actual_consume = hp_before - self.caster.current_hp
        self.assertEqual(actual_consume, expected_consume,
                         f"Block1应消耗30% HP={expected_consume}，实际={actual_consume}")

    def test_block1_dmg_taken_down_fixed_40pct(self):
        """Block1: dmg_taken_down(固定40%, stackable, permanent)。

        敌方为固定40%（己方hp_ratio_dynamic 30-50%）。
        """
        self._reset_caster()
        self._trigger_ps2()
        dmg_taken_downs = [b for b in self.caster.buffs
                           if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(dmg_taken_downs), 0, "应有 dmg_taken_down buff")
        self.assertTrue(dmg_taken_downs[0].is_stackable, "应可叠加")
        self.assertEqual(dmg_taken_downs[0].duration, -1, "应永続（duration=-1）")
        # 固定40%
        self.assertAlmostEqual(dmg_taken_downs[0].value, 40.0, places=1,
                               msg="敌方dmg_taken_down应固定40%")
        # 敌方无 hp_ratio_dynamic（己方有）
        self.assertFalse(getattr(dmg_taken_downs[0], 'hp_ratio_dynamic', False),
                         "敌方dmg_taken_down不应有 hp_ratio_dynamic")

    def test_block2_lv5_grants_dmg_dealt_up(self):
        """Block2: Lv5+ 时执行，dmg_dealt_up(target_hp_ratio_higher_than_self, permanent)。

        敌方Lv5+解锁（己方Lv11+）。
        """
        self._reset_caster()
        self.caster.level = 5
        self.caster.skill_levels[230425] = 5
        self._trigger_ps2()
        dmg_dealt_ups = [b for b in self.caster.buffs
                         if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_dealt_ups), 0, "Lv5+应有 dmg_dealt_up buff")
        self.assertTrue(dmg_dealt_ups[0].is_stackable, "应可叠加")
        self.assertEqual(dmg_dealt_ups[0].duration, -1, "应永続（duration=-1）")
        self.assertTrue(getattr(dmg_dealt_ups[0], 'target_hp_ratio_higher_than_self', False),
                        "应 target_hp_ratio_higher_than_self=True")

    def test_block2_skipped_lv4(self):
        """Block2: Lv4 时跳过（active_level_min=5 未满足）。"""
        self._reset_caster()
        self.caster.level = 4
        self.caster.skill_levels[230425] = 4
        self._trigger_ps2()
        dmg_dealt_ups = [b for b in self.caster.buffs
                         if b.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_dealt_ups), 0,
                         "Lv4时Block2跳过，不应有 dmg_dealt_up buff")

    def test_cooldown_99_blocks_retrigger(self):
        """cooldown=99 阻止再次触发（戦闘中1回）。"""
        self._reset_caster()
        # 第一次触发
        self._trigger_ps2()
        self.assertEqual(self.caster.skill_cooldowns.get(230425), 99,
                         "第一次执行后应设置 cooldown=99")
        # 第二次触发（PS2在冷却中）
        self.bf.turn_number = 3
        actions2 = self.ts.trigger_turn_start(self.bf)
        ps2_2 = [a for a in actions2 if a.skill_id == 230425]
        self.assertEqual(len(ps2_2), 0,
                         "PS2在冷却中 → 不应再次被收集")


if __name__ == "__main__":
    unittest.main(verbosity=2)
