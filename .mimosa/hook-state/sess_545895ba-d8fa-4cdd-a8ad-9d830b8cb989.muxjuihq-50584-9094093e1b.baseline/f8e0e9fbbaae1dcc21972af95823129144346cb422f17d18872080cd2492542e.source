# -*- coding: utf-8 -*-
"""回忆卡属性highlight匹配测试：双属性角色副属性也应触发属性highlight"""
import os
import sys

os.chdir(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, os.getcwd())

from src.data.data_loader import DataLoader
from src.data.models import MemoryHighlight
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.battle_flow_controller import BattleFlowController


def _mk_unit(unit_id, element, sub_element=0, position=Position.ALLY_CENTER_FRONT):
    return UnitState(
        unit_id=unit_id, name=unit_id, side=Side.ALLY, position=position,
        character_id=500301, level=1, element=element, sub_element=sub_element,
        character_type=2,
        max_hp=10000, current_hp=10000, attack=1000, defense=500, speed=100,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=3, initial_passive_point=3, max_extra_point=0,
        current_ap=3, current_pp=3, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _mk_enemy():
    return UnitState(
        unit_id="enemy", name="enemy", side=Side.ENEMY,
        position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=1,
        element=1, character_type=1,
        max_hp=999999, current_hp=999999, attack=10, defense=0, speed=50,
        crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
        initial_active_point=0, initial_passive_point=0, max_extra_point=0,
        current_ap=0, current_pp=0, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_controller(allies):
    dl = DataLoader()
    dl.load_all()
    bf = BattlefieldState()
    bf.friend_team = list(allies)
    bf.enemy_team = [_mk_enemy()]
    return BattleFlowController(bf, dl)


class TestUnitMatchesAttribute:
    def test_dual_matches_main_and_sub(self):
        """双属性(主土4/副火1): 主/副属性均命中"""
        ctrl = _make_controller([_mk_unit("dual", 4, 1)])
        u = ctrl.battlefield.friend_team[0]
        assert ctrl._unit_matches_attribute(u, 4) is True  # 主属性土
        assert ctrl._unit_matches_attribute(u, 1) is True  # 副属性火
        assert ctrl._unit_matches_attribute(u, 2) is False  # 水

    def test_single_attribute_unchanged(self):
        """单属性角色行为不变"""
        ctrl = _make_controller([_mk_unit("single", 4, 0)])
        u = ctrl.battlefield.friend_team[0]
        assert ctrl._unit_matches_attribute(u, 4) is True
        assert ctrl._unit_matches_attribute(u, 1) is False


class TestMemoryHighlightDualAttribute:
    def test_match_memory_card_unit_sub_attribute(self):
        """_match_memory_card_unit: 副属性火命中 attr=1 的highlight"""
        ctrl = _make_controller([_mk_unit("dual", 4, 1)])
        u = ctrl.battlefield.friend_team[0]
        assert ctrl._match_memory_card_unit(u, MemoryHighlight(character_attribute=1)) is True
        assert ctrl._match_memory_card_unit(u, MemoryHighlight(character_attribute=4)) is True
        assert ctrl._match_memory_card_unit(u, MemoryHighlight(character_attribute=2)) is False

    def test_match_with_position_sub_attribute(self):
        """_match_memory_card_unit_with_position: 副属性火命中 + 位置位掩码"""
        ctrl = _make_controller([_mk_unit("dual", 4, 1)])
        u = ctrl.battlefield.friend_team[0]
        center_front_bit = 2
        assert ctrl._match_memory_card_unit_with_position(
            u, MemoryHighlight(character_attribute=1), center_front_bit) is True
        assert ctrl._match_memory_card_unit_with_position(
            u, MemoryHighlight(character_attribute=2), center_front_bit) is False

    def test_resolve_targets_includes_sub_attribute_unit(self):
        """_resolve_memory_card_targets: 火属性highlight的回忆卡可选中副属性火的角色"""
        dual = _mk_unit("dual", 4, 1)
        other = _mk_unit("other", 3, 0)  # 风属性，不命中火
        ctrl = _make_controller([dual, other])
        targets = ctrl._resolve_memory_card_targets(
            MemoryHighlight(character_attribute=1, is_targeting_friendly_party=True))
        ids = [u.unit_id for u in targets]
        assert "dual" in ids
        assert "other" not in ids

    def test_main_attribute_still_works(self):
        """主属性highlight仍正常（回归）"""
        dual = _mk_unit("dual", 4, 1)
        ctrl = _make_controller([dual])
        targets = ctrl._resolve_memory_card_targets(
            MemoryHighlight(character_attribute=4, is_targeting_friendly_party=True))
        assert [u.unit_id for u in targets] == ["dual"]
