"""抽查 manual 技能配置详细字段，辅助 P0-4-D 审查。

输出每个 manual 技能的：
- skill_id / name / skill_type / trigger_type
- 每个 effect 的 effect_type / target_type / value / value_tag / duration / duration_type / flags
- 每个 block 的 condition
"""
import json
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))

from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()


def main():
    with open('data/skill_effects_hybrid.json', 'r', encoding='utf-8') as f:
        hybrid = json.load(f)
    with open('data/skills.json', 'r', encoding='utf-8') as f:
        raw = json.load(f)
    skills = raw if isinstance(raw, dict) else {str(s.get('Id')): s for s in raw}

    manual_ids = [sid for sid, v in hybrid.items() if v.get('parse_status') == 'manual']
    safe_print(f"=== Manual 技能详细配置（共 {len(manual_ids)} 个）===")
    safe_print("")

    for sid in manual_ids:
        data = hybrid[sid]
        name = data.get('name', '?')
        skill_type = data.get('skill_type', '?')
        trigger_type = data.get('trigger_type')
        global_cond = data.get('global_condition')
        blocks = data.get('effect_blocks', [])

        # 从 skills.json 获取描述
        skill_meta = skills.get(sid, {})
        desc = ''
        descriptions = skill_meta.get('descriptions', [])
        if descriptions:
            desc = descriptions[0].get('template', '')

        safe_print(f"━━━ [{sid}] {name} (type={skill_type}) ━━━")
        safe_print(f"  desc: {desc[:280]}")
        safe_print(f"  trigger_type: {trigger_type}")
        if global_cond:
            safe_print(f"  global_condition: {json.dumps(global_cond, ensure_ascii=False)}")
        for i, block in enumerate(blocks):
            cond = block.get('condition')
            lvl_min = block.get('level_min')
            lvl_max = block.get('level_max')
            safe_print(f"  Block{i+1} (id={block.get('block_id')}) lvl=[{lvl_min},{lvl_max}] cond={json.dumps(cond, ensure_ascii=False) if cond else 'None'}")
            for j, eff in enumerate(block.get('effects', [])):
                et = eff.get('effect_type')
                tt = eff.get('target_type')
                ti = eff.get('target_identifier')
                v = eff.get('value')
                vt = eff.get('value_tag')
                dur = eff.get('duration')
                dt = eff.get('duration_type')
                flags = eff.get('flags') or {}
                cond_eff = eff.get('condition')
                safe_print(f"    Eff{j+1}: {et} target={tt} ident={ti} val={v} tag={vt} dur={dur}/{dt}")
                if flags:
                    safe_print(f"      flags: {json.dumps(flags, ensure_ascii=False)}")
                if cond_eff:
                    safe_print(f"      cond: {json.dumps(cond_eff, ensure_ascii=False)}")
        safe_print("")


if __name__ == '__main__':
    main()
