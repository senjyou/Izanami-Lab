"""Regression: 鳴ノ掃射 (220365) 易伤buff显示与持续时间bug

Bug1: dmg_taken_up (易伤) debuff的叙事detail显示为"被ダメージ-3%"（减伤），
      实际应为"被ダメージ+3%"（易伤）。
      根因: skill_service.py的_apply_aura中RECEIVED_DAMAGE显示逻辑
      buffs用+=、debuffs用-=，与battle_flow_controller.py的正确逻辑相反。
      修复: 对齐为 buffs(-=) / debuffs(+=)。

Bug2: 鳴ノ掃射描述无持续时间，应为永续debuff，但配置为duration=1(1行动)。
      修复: 改为duration=-1（永续）。

Expected behavior:
- 鳴ノ掃射施加的dmg_taken_up debuff detail显示为"被ダメージ+3%"（正号）
- debuff的duration=-1（永续，不会被行动结束递减）
- debuff实际生效：后续攻击的received_mult > 1.0
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.resource_service import ResourceService


def _make_caster():
    """EN型caster for 鳴ノ掃射 (220365)"""
    return UnitState(
        unit_id="ally_back", name="鳴雷", side=Side.ALLY,
        position=Position.ALLY_CENTER_BACK, character_id=220365, level=10,
        element=1, character_type=2,
        max_hp=15000, current_hp=15000,
        attack=10000, defense=4000, speed=400,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=2, initial_passive_point=2, max_extra_point=8,
        current_ap=10, current_pp=10, current_ep=0,
        skills=[220365], skill_levels={220365: 10}, skill_cooldowns={},
    )


def _make_enemy(unit_id="enemy_front", position=Position.ENEMY_CENTER_FRONT):
    """高HP敌方单位 (同属性, 避免克制差异)"""
    return UnitState(
        unit_id=unit_id, name=unit_id, side=Side.ENEMY,
        position=position, character_id=999001, level=10,
        element=1, character_type=1,
        max_hp=999999, current_hp=999999,
        attack=1000, defense=3000, speed=400,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=5,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


class TestRegNaruSoushaVulnDisplay(unittest.TestCase):
    """鳴ノ掃射 (220365) 易伤显示与永続化回归测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.caster = _make_caster()
        self.enemy = _make_enemy()
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy]

        rs = ResourceService()
        trg = TriggerService()
        tgs = TargetService()
        dms = DamageService()
        aus = AuraService()
        sts = StatusService()
        self.ss = SkillService(
            self.dl, rs, target_service=tgs, damage_service=dms,
            aura_service=aus, status_service=sts, trigger_service=trg,
        )
        trg.set_data_loader(self.dl)
        trg.set_skill_service(self.ss)
        trg.set_damage_service(dms)
        self.ss.set_battlefield(self.bf)

    def _get_aura_effects(self, result):
        """从effects_applied中提取所有aura类型的effect（含is_debuff标记）"""
        return [e for e in result.get("effects_applied", [])
                if e.get("effect_type") == "aura"]

    def test_vuln_debuff_displays_positive(self):
        """易伤debuff的detail应显示为正号（被ダメージ+3%），不是负号。

        Bug: 修复前显示"被ダメージ-3%"（减伤语义），实际应为"被ダメージ+3%"（易伤语义）。
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220365, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        aura_effects = self._get_aura_effects(result)
        self.assertGreater(len(aura_effects), 0, "应有aura效果")

        # 找到dmg_taken_up的aura detail
        vuln_auras = []
        for ae in aura_effects:
            for a in ae.get("auras", []):
                if a.get("effect") == "ReceivedDamage":
                    vuln_auras.append(a)
        self.assertGreater(len(vuln_auras), 0, "应有ReceivedDamage aura")

        for a in vuln_auras:
            detail = a.get("detail", "")
            self.assertIn("+", detail,
                          f"易伤detail应含'+'号（被ダメージ+3%），实际={detail}")
            self.assertFalse(detail.startswith("被ダメージ-"),
                            f"易伤detail不应为负号（减伤语义），实际={detail}")

    def test_vuln_debuff_is_permanent(self):
        """易伤debuff应为永続（duration=-1），不是1行动。

        Bug: 修复前duration=1（1行动后消失），实际应为永続。
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220365, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        aura_effects = self._get_aura_effects(result)
        vuln_auras = []
        for ae in aura_effects:
            for a in ae.get("auras", []):
                if a.get("effect") == "ReceivedDamage":
                    vuln_auras.append(a)
        self.assertGreater(len(vuln_auras), 0, "应有ReceivedDamage aura")

        for a in vuln_auras:
            duration = a.get("duration")
            self.assertEqual(duration, -1,
                            f"易伤debuff应为永続(duration=-1)，实际duration={duration}")

    def test_vuln_debuff_not_decremented_after_maneuver(self):
        """永続易伤debuff在目标行动结束后不应被递减/移除。"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220365, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 确认debuff已施加
        received_debuffs = [d for d in self.enemy.debuffs
                           if d.effect_type == "ReceivedDamage"]
        self.assertGreater(len(received_debuffs), 0, "应有ReceivedDamage debuff")
        self.assertEqual(received_debuffs[0].duration, -1,
                        "debuff duration应为-1（永続）")

        # 清除just_applied标记（battle_flow_controller在process_maneuver_end后会清除）
        # 这样才能真正测试duration<0的永続保护逻辑
        for d in self.enemy.debuffs:
            d.just_applied = False

        # 模拟目标行动结束递减
        self.ss.aura_service.process_maneuver_end(self.enemy)

        # 永続debuff应仍存在且duration仍为-1
        received_debuffs_after = [d for d in self.enemy.debuffs
                                 if d.effect_type == "ReceivedDamage"]
        self.assertGreater(len(received_debuffs_after), 0,
                          "永続易伤debuff不应在行动结束后被移除")
        self.assertEqual(received_debuffs_after[0].duration, -1,
                        "永続debuff的duration应仍为-1")

    def test_vuln_actually_increases_damage_taken(self):
        """易伤debuff应实际增加目标受到的伤害（received_mult > 1.0）。

        验证：施加易伤后，后续攻击的received_mult应 > 1.0。
        """
        # Step1: 施加易伤
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220365, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 确认debuff已施加
        received_debuffs = [d for d in self.enemy.debuffs
                           if d.effect_type == "ReceivedDamage"]
        self.assertGreater(len(received_debuffs), 0, "应有ReceivedDamage debuff")

        # Step2: 用另一个攻击触发，检查received_mult
        # 直接用damage_service计算received_mult
        dms = self.ss.damage_service
        # 获取ReceivedDamage类型的总易伤值
        total_vuln = 0.0
        for d in self.enemy.debuffs:
            if d.effect_type == "ReceivedDamage":
                total_vuln += dms._normalize_buff_value(d)
        self.assertGreater(total_vuln, 0.0,
                          f"易伤总值应>0（实际生效增加伤害），实际={total_vuln}")


if __name__ == '__main__':
    unittest.main(verbosity=2)
