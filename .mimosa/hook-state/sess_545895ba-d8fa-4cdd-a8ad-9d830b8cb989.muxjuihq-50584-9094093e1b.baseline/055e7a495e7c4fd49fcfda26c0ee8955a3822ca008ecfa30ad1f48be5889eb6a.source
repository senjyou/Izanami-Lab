"""Regression: 120010 スケープゴート・スラッシュ (104201 ミステリアスガール).

Validates:
1. consume_hp reduces caster's HP by 20% of current HP
2. Damage dealt = consumed_hp * 威力% (Lv10: consumed * 187.2%)
3. Skill does NOT execute when caster HP < 20% (self_hp_above:20 condition)
4. Skill executes when caster HP = 20% (boundary)
5. Skill executes when caster HP > 20%

Bug: global_condition self_hp_above used "value" field but code only read "pct".
     Fixed code to accept both "value" and "pct" (consistent with block condition).
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'src'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

SKILL_ID = 120010  # スケープゴート・スラッシュ


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=0, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ap=10,
               crit_rate=0.0, crit_damage=0.5, current_hp=None):
    u = UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )
    return u


class TestReg104201ScapegoatSlash(unittest.TestCase):
    """120010: consume_hp 20% current + damage (consumed * 威力%, self_hp_above:20)."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _build_battlefield(self, caster_current_hp=None):
        """Build a battlefield with caster + enemy."""
        bf = BattlefieldState()
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=5000, speed=500,
            skills=[SKILL_ID], skill_levels={SKILL_ID: 10},
            current_hp=caster_current_hp,
        )
        enemy = _make_unit(
            "enemy", "Enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=1000000, atk=1000, defense=0, speed=800,
        )
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]

        ss = SkillService(
            self.dl, ResourceService(),
            target_service=TargetService(), damage_service=DamageService(),
            aura_service=AuraService(), trigger_service=TriggerService(),
            status_service=StatusService(),
        )
        ss.set_battlefield(bf)
        return bf, ss, caster, enemy

    def test_consume_hp_reduces_caster_hp_by_20_percent(self):
        """consume_hp should reduce caster's HP by 20% of current HP."""
        bf, ss, caster, enemy = self._build_battlefield(caster_current_hp=100000)
        caster.current_ap = 5
        hp_before = caster.current_hp
        ss.execute_skill(caster, SKILL_ID, bf)
        expected_consumed = int(100000 * 0.20)  # 20000
        self.assertEqual(caster.current_hp, hp_before - expected_consumed,
                         f"caster HP should be reduced by 20% (={expected_consumed}), "
                         f"got {hp_before - caster.current_hp}")

    def test_damage_based_on_consumed_hp(self):
        """Damage should be consumed_hp * 威力% (Lv10: 20000 * 187.2% = 37440)."""
        bf, ss, caster, enemy = self._build_battlefield(caster_current_hp=100000)
        caster.current_ap = 5
        enemy_hp_before = enemy.current_hp
        ss.execute_skill(caster, SKILL_ID, bf)
        damage_dealt = enemy_hp_before - enemy.current_hp
        # consumed = 20000, 威力=187.2%, damage = 20000 * 1.872 = 37440
        # Note: exact value depends on attribute factor and other multipliers
        # With element=2 vs element=2, attr_factor=1.0, no buffs/debuffs
        expected_damage = int(20000 * 1.872)  # 37440
        self.assertGreater(damage_dealt, 0, "Damage should be dealt to enemy")
        self.assertAlmostEqual(damage_dealt, expected_damage, delta=expected_damage * 0.05,
                               msg=f"Damage should be ~{expected_damage} (consumed_hp * 威力%), "
                                   f"got {damage_dealt}")

    def test_skill_blocked_when_hp_below_20_percent(self):
        """Skill should NOT execute when caster HP < 20% (self_hp_above:20)."""
        bf, ss, caster, enemy = self._build_battlefield(caster_current_hp=19000)
        caster.current_ap = 5
        hp_before = caster.current_hp
        enemy_hp_before = enemy.current_hp
        ss.execute_skill(caster, SKILL_ID, bf)
        # HP should NOT change (skill blocked)
        self.assertEqual(caster.current_hp, hp_before,
                         "Caster HP should NOT change when HP < 20% (skill blocked)")
        self.assertEqual(enemy.current_hp, enemy_hp_before,
                         "Enemy HP should NOT change when caster HP < 20% (skill blocked)")

    def test_skill_executes_when_hp_at_20_percent_boundary(self):
        """Skill should execute when caster HP = 20% (boundary, >= condition)."""
        bf, ss, caster, enemy = self._build_battlefield(caster_current_hp=20000)
        caster.current_ap = 5
        hp_before = caster.current_hp
        ss.execute_skill(caster, SKILL_ID, bf)
        # HP should be reduced (skill executed)
        self.assertLess(caster.current_hp, hp_before,
                        "Caster HP should be reduced when HP = 20% (boundary, >= condition)")

    def test_skill_executes_when_hp_above_20_percent(self):
        """Skill should execute when caster HP > 20%."""
        bf, ss, caster, enemy = self._build_battlefield(caster_current_hp=50000)
        caster.current_ap = 5
        hp_before = caster.current_hp
        ss.execute_skill(caster, SKILL_ID, bf)
        # HP should be reduced (skill executed)
        self.assertLess(caster.current_hp, hp_before,
                        "Caster HP should be reduced when HP > 20%")

    def test_consume_hp_effect_exists(self):
        """Skill should have a consume_hp effect."""
        parsed = self.dl.get_parsed_skill_data(SKILL_ID)
        consume_hp_effects = []
        for block in parsed.get('effect_blocks', []):
            for eff in block.get('effects', []):
                if eff.get('effect_type') == 'consume_hp':
                    consume_hp_effects.append(eff)
        self.assertEqual(len(consume_hp_effects), 1,
                         "Should have exactly 1 consume_hp effect")
        self.assertEqual(consume_hp_effects[0].get('value'), 20,
                         "consume_hp value should be 20 (20%)")
        self.assertEqual(consume_hp_effects[0].get('flags', {}).get('hp_base'),
                         'current_hp', "hp_base should be 'current_hp'")

    def test_damage_has_value_source_consume_hp(self):
        """damage effect should have value_source='consume_hp'."""
        parsed = self.dl.get_parsed_skill_data(SKILL_ID)
        damage_effects = []
        for block in parsed.get('effect_blocks', []):
            for eff in block.get('effects', []):
                if eff.get('effect_type') == 'damage':
                    damage_effects.append(eff)
        self.assertEqual(len(damage_effects), 1,
                         "Should have exactly 1 damage effect")
        self.assertEqual(damage_effects[0].get('value_source'), 'consume_hp',
                         "damage value_source should be 'consume_hp'")


if __name__ == '__main__':
    unittest.main()
