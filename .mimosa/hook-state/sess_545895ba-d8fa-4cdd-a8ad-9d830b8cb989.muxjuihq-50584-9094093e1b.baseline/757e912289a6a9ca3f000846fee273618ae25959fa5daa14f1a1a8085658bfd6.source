"""回归测试: 115302疾走する自由の孤狼「闘志」生命周期 + 回忆卡20089联动

覆盖3个bug（AS授予的闘志为永续，是正确设计，不做衰减处理）:
1. 回忆卡400246的闘志(AcquireMark attack_limited=1)在施法者首次攻击时被
   attack_limited清理整组清除（4层闘志全部消失，违背「1行動ごとに1つずつ消滅」）
   → 修复: MARK类buff不参与通用attack_limited消耗；记忆卡闘志仅按行动衰减
2. 回忆卡400247解除130180冷却但未清除once_per_battle标志 → 130180无法再次触发
   → 修复: RecoverSkillCooldown同时清除once_per_battle_triggered
3. mark_stat_bonus的crit_damage返回值单位错误（返回12.0而非0.12）→ 暴击倍率
   1.5+12=13.5（1350%），暴击伤害异常偏高约8倍
   → 修复: `_calc_mark_stat_bonus` crit_damage 分支 return total_pct / 100.0

正确设计约束（验证不变更）:
- AS 120171 ブレイブバレット授予的「闘志」为永续（不衰减）——5回合标准流程下，
  AP(2)/冷却(2行动)限制120171约每回合1次，闘志峰值约5，不会叠到8
- 回忆卡400246 的「闘志」每行动衰减1个（decay_per_action=1）
"""
import sys
import os
import unittest

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.entities.memory_card import MemoryCard
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.battle_flow_controller import BattleFlowController

MARK = SkillEffectType.MARK.value
TOUSHI = "闘志"
RAKUIN = "烙印"


def _mk_mark(name, source_id="src", stack=1, decay_per_action=0):
    return BuffState(
        buff_id=f"{source_id}_mark_{name}_{stack}_{decay_per_action}", name=name,
        effect_type=MARK, value=0, duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=source_id, source_skill_id=0, is_debuff=False,
        stack_count=stack, decay_per_action=decay_per_action,
    )


class TestReg115302ToushiLifecycle(unittest.TestCase):

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1
        self.caster = UnitState(
            unit_id="c", name="孤狼", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=115302, level=15,
            element=1, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=0,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110080, 120171, 120172, 130179, 130180],
            skill_levels={110080: 15, 120171: 15, 120172: 15, 130179: 15, 130180: 15},
            skill_cooldowns={},
        )
        enemy = UnitState(
            unit_id="e", name="木桩", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=999999, current_hp=999999,
            attack=100, defense=5000, speed=60,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=0,
            current_ap=2, current_pp=2, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [enemy]

        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.tgs = TargetService()
        self.dms = DamageService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs, damage_service=self.dms,
            aura_service=self.aus, status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _toushi_count(self, unit):
        return sum(getattr(m, 'stack_count', 1) or 1
                   for m in unit.buffs + unit.debuffs
                   if m.effect_type == MARK and m.name == TOUSHI)

    def _make_card(self, card_id):
        info = self.dl.load_memories().get(card_id)
        return MemoryCard(card_id=card_id, name=info.name, description=info.description,
                          rarity=info.rarity, highlights=info.highlights)

    # ───────── 正确设计: AS授予的闘志为永续（不衰减） ─────────

    def test_as_granted_toushi_is_permanent(self):
        """120171授予的闘志mark为永续：不携带decay_per_action（与回忆卡400246的行动衰减不同）"""
        self.ss.execute_skill(caster=self.caster, skill_id=120171,
                              battlefield=self.bf, skip_cost=True)
        marks = [b for b in self.caster.buffs if b.effect_type == MARK and b.name == TOUSHI]
        self.assertEqual(len(marks), 1)
        self.assertEqual(getattr(marks[0], 'decay_per_action', 0), 0,
                         "120171授予的闘志应为永续（decay_per_action=0）")
        # 永续mark即使行动结束也不消失（AS闘志挂满战局，靠AP/冷却限制叠放速度）
        self.aus.process_maneuver_end(self.caster)
        self.assertEqual(self._toushi_count(self.caster), 1,
                         "AS授予的闘志行动结束后仍保留（永续）")

    # ───────── Bug1: 回忆卡400246的闘志不被首攻整组清除 ─────────

    def test_memory_toushi_not_wiped_on_first_attack(self):
        """记忆卡闘志(4层)在施法者首次攻击后应保留，且每行动衰减1个"""
        bf = BattlefieldState()
        bf.friend_team = [self.caster]
        bf.enemy_team = [self.bf.enemy_team[0]]
        bf.memory_cards = [self._make_card(20089)]
        ctl = BattleFlowController(bf, data_loader=self.dl)
        ctl.skill_service = self.ss
        ctl.aura_service = self.aus
        ctl.damage_service = self.dms
        ctl.battlefield = bf
        ctl._apply_memory_card_effects()
        self.assertEqual(self._toushi_count(self.caster), 4)
        # 首次攻击（AS）
        self.ss.execute_skill(caster=self.caster, skill_id=120171,
                              battlefield=bf, skip_cost=True)
        self.assertGreaterEqual(self._toushi_count(self.caster), 4,
                                "首攻不应整组清除记忆卡闘志4层")
        # 行动结束：记忆卡闘志衰减1个(4→3)，加上本次120171授予的1个 → 总4
        self.aus.process_maneuver_end(self.caster)
        self.assertEqual(self._toushi_count(self.caster), 4,
                         "行动结束闘志总数+1后应减1（记忆卡4→3 + 本次+1 = 4）")

    # ───────── Bug3: 闘志crit_damage加成单位错误（暴击倍率翻10倍） ─────────

    def test_toushi_crit_damage_bonus_unit_is_0_01_per_point(self):
        """闘志会心damage加成返回「1.0=100%」单位：4枚×3%=0.12，暴击倍率=1.5+0.12=1.62
        （曾返回原始12.0 → 暴击倍率1.5+12=13.5=1350%，伤害异常偏高约8倍）"""
        for i in range(4):
            self.caster.buffs.append(_mk_mark(TOUSHI, f"src{i}", 1))
        for stat, per in (("attack", 4), ("crit_damage", 3)):
            self.caster.buffs.append(BuffState(
                buff_id=f"carrier_{stat}", name=f"carrier_{stat}",
                effect_type=(SkillEffectType.STATUS_ATTACK if stat == "attack"
                             else SkillEffectType.CRITICAL_BONUS_MODIFICATION).value,
                value=0, duration=-1,
                timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
                source_unit_id="c", source_skill_id=0, is_debuff=False,
                mark_stat_bonus={"mark_name": TOUSHI, "stat": stat,
                                 "per_mark_pct": per, "max_marks": 8},
            ))
        bonus = self.dms._calc_mark_stat_bonus(self.caster, "crit_damage")
        self.assertAlmostEqual(bonus, 0.12, msg="4枚闘志 crit加成应为0.12（12ポイント=12%）")
        # 暴击倍率 = 1.5 + 基础crit_damage(0.5) + mark加成0.12 = 2.12
        crit_mult = 1.5 + self.dms._get_crit_damage_bonus(self.caster)
        self.assertAlmostEqual(crit_mult, 1.5 + self.caster.crit_damage + 0.12,
                               msg="闘志全层加成=4×3%=0.12（而非1.5+12=13.5=1350%）")
        # ATK加成路径不受影响（返回绝对值加数）
        atk_bonus = self.dms._calc_mark_stat_bonus(self.caster, "attack")
        self.assertAlmostEqual(atk_bonus, self.caster.attack * 0.16)

    # ───────── Bug2: 400247解除130180冷却时清除once_per_battle标志 ─────────

    def test_memory_400247_clears_once_per_battle_flag(self):
        """烙印敌被击杀后，400247应同时清除130180的冷却和once标记，允许再次触发"""
        self.caster.skill_cooldowns[130180] = 99
        self.caster.once_per_battle_triggered.add(130180)
        enemy = self.bf.enemy_team[0]
        enemy.debuffs.append(_mk_mark(RAKUIN, "c", 1))
        enemy.is_alive = False
        bf = BattlefieldState()
        bf.friend_team = [self.caster]
        bf.enemy_team = [enemy]
        bf.memory_cards = [self._make_card(20089)]
        ctl = BattleFlowController(bf, data_loader=self.dl)
        ctl.skill_service = self.ss
        ctl.damage_service = self.dms
        ctl.aura_service = self.aus
        ctl.battlefield = bf
        ctl._apply_memory_card_effects_by_trigger("on_any_kill",
                                                  actor=self.caster, target=enemy)
        self.assertNotIn(130180, self.caster.skill_cooldowns, "冷却应被解除")
        self.assertNotIn(130180, self.caster.once_per_battle_triggered,
                         "once_per_battle标志应被清除，允许再次发动")

    def test_memory_400247_no_flag_clear_without_rakuin(self):
        """无烙印敌被击杀时，不解除冷却也不清除once标记"""
        self.caster.skill_cooldowns[130180] = 99
        self.caster.once_per_battle_triggered.add(130180)
        enemy = self.bf.enemy_team[0]
        enemy.is_alive = False  # 无烙印
        bf = BattlefieldState()
        bf.friend_team = [self.caster]
        bf.enemy_team = [enemy]
        bf.memory_cards = [self._make_card(20089)]
        ctl = BattleFlowController(bf, data_loader=self.dl)
        ctl.skill_service = self.ss
        ctl.damage_service = self.dms
        ctl.aura_service = self.aus
        ctl.battlefield = bf
        ctl._apply_memory_card_effects_by_trigger("on_any_kill",
                                                  actor=self.caster, target=enemy)
        self.assertIn(130180, self.caster.skill_cooldowns, "无烙印不应解冷却")
        self.assertIn(130180, self.caster.once_per_battle_triggered,
                      "无烙印不应清除once标志")


if __name__ == '__main__':
    unittest.main()