    # ─── EX: 聖剣『ディバインキャリバー』 ───

    def test_ex_random_branch_selects_one_of_three(self):
        """
        EX(110062) 3选1随机抽选
        验证: 多次执行后，3个分支都被选中过
        """
        random.seed(42)
        branch_counts = {1: 0, 2: 0, 3: 0}
        for i in range(30):
            # 重置状态
            self.caster.current_ep = 10
            self.enemy_front.current_hp = 15000
            self.enemy_front.debuffs = []
            self.ally_front.current_hp = 6000

            result = self.ss.execute_skill(self.caster, 110062, self.bf)
            self.assertTrue(result.get("success"), f"iter {i}: EX should succeed")

            # 检查哪个分支被执行
            # Block1: 伤害 -> 敌方HP减少
            # Block2: 凍結 -> 敌方有freeze debuff
            # Block3: 回復 -> 友方HP增加
            if self.enemy_front.current_hp < 15000:
                branch_counts[1] += 1
            elif any(d.effect_type == FREEZE for d in self.enemy_front.debuffs):
                branch_counts[2] += 1
            elif self.ally_front.current_hp > 6000:
                branch_counts[3] += 1

        # 至少有一个分支被选中
        self.assertGreater(sum(branch_counts.values()), 0,
                           f"EX should execute at least one branch: {branch_counts}")

    def test_ex_branch2_freeze_applied_to_all_enemies(self):
        """
        EX(110062) Block2: 全体凍結
        验证: 强制选中Block2时，所有敌方都被赋予凍結
        """
        # 通过mock强制选中Block2
        import src.combat_v2.services.skill_service as ss_mod
        original_random = ss_mod.random
        try:
            ss_mod.random = type('MockRandom', (), {
                'choices': staticmethod(lambda ids, weights, k: [2]),
                'seed': staticmethod(lambda x: None),
            })()
            self.caster.current_ep = 10
            result = self.ss.execute_skill(self.caster, 110062, self.bf)
            self.assertTrue(result.get("success"))

            # 所有敌方都应有凍結
            for enemy in self.bf.enemy_team:
                self.assertTrue(any(d.effect_type == FREEZE for d in enemy.debuffs),
                                f"{enemy.name} should have freeze debuff")
        finally:
            ss_mod.random = original_random

    def test_ex_branch3_heal_ally_all(self):
        """
        EX(110062) Block3: 全体回復+追加回復
        验证: 强制选中Block3时，友方HP增加
        """
        import src.combat_v2.services.skill_service as ss_mod
        original_random = ss_mod.random
        try:
            ss_mod.random = type('MockRandom', (), {
                'choices': staticmethod(lambda ids, weights, k: [3]),
                'seed': staticmethod(lambda x: None),
            })()
            self.caster.current_ep = 10
            self.caster.current_hp = 10000  # caster不满血
            self.ally_front.current_hp = 3000  # HP 25% (最低)

            hp_before_caster = self.caster.current_hp
            hp_before_ally = self.ally_front.current_hp

            result = self.ss.execute_skill(self.caster, 110062, self.bf)
            self.assertTrue(result.get("success"))

            # caster和ally_front都应被回復
            self.assertGreater(self.caster.current_hp, hp_before_caster,
                               "caster should be healed by ally_all heal")
            self.assertGreater(self.ally_front.current_hp, hp_before_ally,
                               "ally_front should be healed (both ally_all and lowest_hp_priority)")
        finally:
            ss_mod.random = original_random

    # ─── AS1: 祝福の斬撃 ───

    def test_as1_branch1_remove_ep(self):
        """
        AS1(120137) Block1: 伤害+EXゲージ-1
        验证: 强制选中Block1时，敌方EP减少
        """
        import src.combat_v2.services.skill_service as ss_mod
        original_random = ss_mod.random
        try:
            ss_mod.random = type('MockRandom', (), {
                'choices': staticmethod(lambda ids, weights, k: [1]),
                'seed': staticmethod(lambda x: None),
            })()
            self.caster.current_ap = 10
            ep_before = self.enemy_front.current_ep

            result = self.ss.execute_skill(self.caster, 120137, self.bf)
            self.assertTrue(result.get("success"))

            self.assertLess(self.enemy_front.current_ep, ep_before,
                            "enemy EP should be reduced by 1")
        finally:
            ss_mod.random = original_random

