    def test_as1_lv11_second_segment(self):
        """
        AS1(120137) Lv11+: 第二段4选1
        验证: Lv11时执行两段攻击（group=0 + group=1各选1）
        """
        # 设置技能等级为11
        self.caster.skill_levels[120137] = 11

        import src.combat_v2.services.skill_service as ss_mod
        original_random = ss_mod.random
        try:
            # group=0选Block4(无追加), group=1选Block8(无追加)
            call_count = [0]
            def mock_choices(ids, weights, k):
                call_count[0] += 1
                # 第一次调用选group=0的Block4, 第二次选group=1的Block8
                if call_count[0] == 1:
                    return [4]  # group=0 Block4
                else:
                    return [8]  # group=1 Block8
            ss_mod.random = type('MockRandom', (), {
                'choices': staticmethod(mock_choices),
                'seed': staticmethod(lambda x: None),
            })()
            self.caster.current_ap = 10
            hp_before = self.enemy_front.current_hp

            result = self.ss.execute_skill(self.caster, 120137, self.bf)
            self.assertTrue(result.get("success"))

            # 两段伤害都应造成伤害
            self.assertLess(self.enemy_front.current_hp, hp_before,
                            "enemy should take damage from both segments")
            self.assertGreaterEqual(call_count[0], 2,
                                   "should call random.choices twice for two groups")
        finally:
            ss_mod.random = original_random
            self.caster.skill_levels[120137] = 10

    # ─── AS2: 聖剣の峰打ち ───

    def test_as2_branch1_attack_and_knockout(self):
        """
        AS2(120138) Block1(75%): 攻撃+気絶
        验证: 强制选中Block1时，敌方被攻击并被赋予気絶
        """
        import src.combat_v2.services.skill_service as ss_mod
        original_random = ss_mod.random
        try:
            ss_mod.random = type('MockRandom', (), {
                'choices': staticmethod(lambda ids, weights, k: [1]),
                'seed': staticmethod(lambda x: None),
            })()
            self.caster.current_ap = 10
            hp_before = self.enemy_front.current_hp

            result = self.ss.execute_skill(self.caster, 120138, self.bf)
            self.assertTrue(result.get("success"))

            # enemy_front是攻击力最高的(8000)
            self.assertLess(self.enemy_front.current_hp, hp_before,
                            "highest_atk enemy should take damage")
            self.assertTrue(any(d.effect_type == KNOCKOUT for d in self.enemy_front.debuffs),
                            "enemy should have knockout debuff")
        finally:
            ss_mod.random = original_random

    def test_as2_branch2_self_knockout(self):
        """
        AS2(120138) Block2(25%): 自身减伤+気絶
        验证: 强制选中Block2时，caster有减伤buff和気絶debuff
        """
        import src.combat_v2.services.skill_service as ss_mod
        original_random = ss_mod.random
        try:
            ss_mod.random = type('MockRandom', (), {
                'choices': staticmethod(lambda ids, weights, k: [2]),
                'seed': staticmethod(lambda x: None),
            })()
            self.caster.current_ap = 10

            result = self.ss.execute_skill(self.caster, 120138, self.bf)
            self.assertTrue(result.get("success"))

            # caster应有dmg_taken_down buff和knockout debuff
            taken_down = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
            self.assertGreater(len(taken_down), 0, "caster should have dmg_taken_down buff")
            self.assertTrue(any(d.effect_type == KNOCKOUT for d in self.caster.debuffs),
                            "caster should have knockout debuff")
        finally:
            ss_mod.random = original_random

    def test_as2_lv14_branch3_evasion_1hit(self):
        """
        AS2(120138) Lv14 Block3(25%): 减伤+1hit回避+気絶
        验证: Lv14时强制选中Block3，caster有1hit回避
        """
        self.caster.skill_levels[120138] = 14
        import src.combat_v2.services.skill_service as ss_mod
        original_random = ss_mod.random
        try:
            ss_mod.random = type('MockRandom', (), {
                'choices': staticmethod(lambda ids, weights, k: [3]),
                'seed': staticmethod(lambda x: None),
            })()
            self.caster.current_ap = 10

            result = self.ss.execute_skill(self.caster, 120138, self.bf)
            self.assertTrue(result.get("success"))

            evade_buffs = [b for b in self.caster.buffs if b.effect_type == EVADE]
