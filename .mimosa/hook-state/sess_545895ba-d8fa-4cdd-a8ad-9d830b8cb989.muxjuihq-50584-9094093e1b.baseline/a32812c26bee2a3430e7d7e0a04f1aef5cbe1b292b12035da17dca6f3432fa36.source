    # ─── AS3: 聖騎士の威光 ───

    def test_as3_attack_main_and_adjacent(self):
        """
        AS3(120139) 主目标+邻接敌人攻击
        验证: 主目标和邻接敌人都受到伤害
        """
        self.caster.current_ap = 10
        hp_before_front = self.enemy_front.current_hp
        hp_before_left = self.enemy_left_front.current_hp
        hp_before_right = self.enemy_right_front.current_hp

        result = self.ss.execute_skill(self.caster, 120139, self.bf)
        self.assertTrue(result.get("success"))

        # 主目标(enemy_front)应受伤
        self.assertLess(self.enemy_front.current_hp, hp_before_front,
                        "main target should take damage")
        # 邻接敌人(enemy_left_front或enemy_right_front)应受伤
        adjacent_damaged = (self.enemy_left_front.current_hp < hp_before_left or
                            self.enemy_right_front.current_hp < hp_before_right)
        self.assertTrue(adjacent_damaged, "at least one adjacent enemy should take damage")

    # ─── PS1: 聖なる剣筋 ───

    def test_ps1_triggers_on_freeze_applied(self):
        """
        PS1(130141) 凍結付与時触发
        验证: 敌方被赋予凍結时，PS1触发并对该敌方造成伤害
        """
        self.caster.current_pp = 10
        hp_before = self.enemy_front.current_hp

        # 模拟凍結付与触发
        actions = self.ts.trigger_pawn_received_aura(
            battlefield=self.bf,
            actor=self.caster,
            affected_unit_ids=[self.enemy_front.unit_id],
            applied_debuff_types={"freeze"},
        )

        # 应该有PS1触发动作
        ps1_actions = [a for a in actions if a.skill_id == 130141]
        self.assertGreater(len(ps1_actions), 0, "PS1 should trigger on freeze applied")

        # 执行触发动作（参考test_actor_137301.py的PS2执行方式）
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_debuff_applied"
        )

        self.assertLess(self.enemy_front.current_hp, hp_before,
                        "PS1 should damage the frozen enemy")

    def test_ps1_does_not_trigger_on_non_freeze(self):
        """
        PS1(130141) 非凍結debuff不触发
        验证: 赋予非凍結debuff（如毒）时，PS1不触发
        """
        actions = self.ts.trigger_pawn_received_aura(
            battlefield=self.bf,
            actor=self.caster,
            affected_unit_ids=[self.enemy_front.unit_id],
            applied_debuff_types={"poison"},
        )

        # 不应有PS1触发
        ps1_actions = [a for a in actions if a.skill_id == 130141]
        self.assertEqual(len(ps1_actions), 0, "PS1 should NOT trigger on non-freeze debuff")


if __name__ == '__main__':
    unittest.main(verbosity=2)
