# -*- coding: utf-8 -*-
"""回归测试: 逐步暴击模式分支决策序列（含random_draw抽取选择）的保存与复现

Bug:
  GUI _save_sequence 仅保存 generate_sequence_string()（C/N暴击序列），
  未保存 generate_branch_sequence_string()（分支决策序列）。
  技能「ミッドサマー・ラブ」(210116) 的 random_draw 抽取目标选择记录在
  _branch_decision_points 中，保存序列后重新加载运行时该部分回退随机，
  无法复现概率型技能的指定情况。

Fix (gui/tabs/step_crit.py):
  _save_sequence 增加 branch_sequence 字段保存分支决策序列；
  _load_sequence 加载 branch_sequence 并填充到分支预填输入框
  （branch_prefill_var），战斗启动时经 set_interactive_branch_prefill 应用。

本测试验证模拟器层的序列往返链路:
  1. random_draw 决策被记录到 _branch_decision_points 并可导出为逗号分隔序列
  2. 导出的序列设置为新模拟器的分支预填后，相同候选场景下返回相同选择
  3. GUI保存的JSON结构包含 branch_sequence 字段（存/取键名一致性）
"""
import json
import sys
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))

from src.combat_v2.step_crit_simulator import StepCritSimulator


def _draw_context(caster_name="珠瀬壬姫", skill_name="ミッドサマー・ラブ",
                  skill_id=210116, draw_index=0, draw_count=2,
                  candidate_names=None):
    """构造 random_draw 覆盖函数的 context dict（与 _apply_random_draw 调用方一致）"""
    candidate_names = candidate_names or ["アリス", "ボブ", "キャロル"]
    return {
        'caster_name': caster_name,
        'caster_id': 'c1',
        'skill_name': skill_name,
        'skill_id': skill_id,
        'draw_index': draw_index,
        'draw_count': draw_count,
        'candidates': [
            {'index': i, 'description': n}
            for i, n in enumerate(candidate_names)
        ],
    }


class TestBranchSequenceRoundTrip(unittest.TestCase):
    """分支决策序列（含random_draw选择）保存→导出→预填→复现"""

    def test_random_draw_recorded_and_exported(self):
        """random_draw 决策被记录且 generate_branch_sequence_string 导出选中索引"""
        sim = StepCritSimulator()
        ctx = _draw_context()
        selected = sim._sequence_random_draw_override(ctx)

        # 决策点已记录
        points = sim.get_branch_decision_points()
        self.assertEqual(len(points), 1)
        self.assertEqual(points[0].decision_type, "random_draw")
        self.assertEqual(points[0].skill_id, 210116)
        self.assertEqual(points[0].selected_block_id, selected)

        # 导出为逗号分隔序列
        seq_str = sim.generate_branch_sequence_string()
        self.assertEqual(seq_str, str(selected))

    def test_random_draw_roundtrip_replay(self):
        """导出序列设置为新模拟器预填后，相同候选场景复现相同选择"""
        # Pass 1: 记录两次 random_draw 选择
        sim1 = StepCritSimulator()
        ctx1 = _draw_context(draw_index=0)
        ctx2 = _draw_context(draw_index=1)
        sel1 = sim1._sequence_random_draw_override(ctx1)
        sel2 = sim1._sequence_random_draw_override(ctx2)

        # 导出分支序列（保存进序列文件的字段）
        branch_seq_str = sim1.generate_branch_sequence_string()
        self.assertEqual(branch_seq_str, f"{sel1},{sel2}")

        # Pass 2: 新模拟器加载该序列作为分支预填（GUI _load_sequence →
        # branch_prefill_var → set_interactive_branch_prefill 链路）
        sim2 = StepCritSimulator()
        prefill_ids = [int(x) for x in branch_seq_str.split(",") if x]
        sim2.set_interactive_branch_prefill(prefill_ids)

        # 相同候选场景下复现相同选择
        replay1 = sim2._sequence_random_draw_override(ctx1)
        replay2 = sim2._sequence_random_draw_override(ctx2)
        self.assertEqual(replay1, sel1,
                         "预填序列应复现第1次random_draw选择")
        self.assertEqual(replay2, sel2,
                         "预填序列应复现第2次random_draw选择")

    def test_save_json_contains_branch_sequence_field(self):
        """GUI保存的JSON结构包含 branch_sequence 字段且可无损往返"""
        # 模拟 _save_sequence 写入的JSON结构
        sim = StepCritSimulator()
        ctx = _draw_context()
        sim._sequence_random_draw_override(ctx)

        save_data = {
            "sequence": sim.generate_sequence_string(),
            "branch_sequence": sim.generate_branch_sequence_string(),
        }
        # JSON序列化/反序列化往返（文件保存加载）
        dumped = json.dumps(save_data)
        loaded = json.loads(dumped)

        # _load_sequence 读取的键存在且值一致
        self.assertIn("branch_sequence", loaded)
        self.assertEqual(loaded["branch_sequence"],
                         save_data["branch_sequence"])
        # 解析为预填id列表有效
        ids = [int(x) for x in loaded["branch_sequence"].split(",") if x]
        self.assertEqual(len(ids), 1)


if __name__ == "__main__":
    unittest.main()
