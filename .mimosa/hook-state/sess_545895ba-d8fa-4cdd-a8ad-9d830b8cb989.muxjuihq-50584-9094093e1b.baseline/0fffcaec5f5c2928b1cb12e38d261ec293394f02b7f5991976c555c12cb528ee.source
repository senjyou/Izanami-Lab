#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
初始化角色属性缓存到数据库

功能:
1. 为所有角色计算默认配置的面板属性
2. 保存到数据库主缓存表
3. 同时保存到默认备份表
"""

import sys
import sqlite3
from pathlib import Path
from datetime import datetime

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.data.stat_calculator import StatCalculator
from src.config.character_config import ModuleConfig
from src.data.data_loader import DataLoader


def safe_print(text):
    """安全打印"""
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode('utf-8', errors='replace').decode('utf-8'))


def get_max_rarity(conn, char_id):
    """获取角色最高稀有度"""
    cursor = conn.cursor()
    cursor.execute("SELECT MAX(rarity) FROM rarity_bonuses WHERE character_id = ?", (char_id,))
    result = cursor.fetchone()
    return result[0] if result and result[0] else 5  # 默认5


def get_character_skill_ids(data_loader, char_id):
    """获取角色技能ID列表"""
    character_skills = data_loader.load_character_skills()
    return character_skills.get(char_id, [])


def save_character_cache(conn, char_id, char_data, stats, config, skill_ids, is_default=False):
    """
    保存角色缓存到数据库
    
    Args:
        conn: 数据库连接
        char_id: 角色ID
        char_data: 角色数据
        stats: 计算的属性
        config: 角色配置
        skill_ids: 技能ID列表
        is_default: 是否保存到默认备份表
    """
    cursor = conn.cursor()
    table_suffix = '_default' if is_default else ''
    timestamp = datetime.now().isoformat()
    timestamp_field = 'created_at' if is_default else 'last_modified'
    
    # 1. 保存主记录
    cursor.execute(f"""
        INSERT OR REPLACE INTO character_cache{table_suffix}
        (character_id, name, character_type, attribute,
         level, rarity, affection_level,
         hp, attack, defense, speed,
         critical_rate, critical_damage, advantage_damage,
         action_point, passive_point,
         {timestamp_field})
        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
    """, (
        char_id, char_data.name, char_data.character_type, char_data.attribute,
        config['level'], config['rarity'], config['affection_level'],
        stats.hp, stats.attack, stats.defense, stats.speed,
        stats.critical_rate, stats.critical_damage, stats.advantage_damage,
        stats.action_point, stats.passive_point,
        timestamp
    ))
    
    # 2. 保存模块配置
    cursor.execute(f"DELETE FROM character_modules{table_suffix} WHERE character_id = ?", (char_id,))
    for slot, module in enumerate(config['modules'], 1):
        cursor.execute(f"""
            INSERT INTO character_modules{table_suffix}
            (character_id, slot, module_id, tier, level)
            VALUES (?, ?, ?, ?, ?)
        """, (char_id, slot, module['module_id'], module['tier'], module['level']))
    
    # 3. 保存装备配置
    cursor.execute(f"DELETE FROM character_equipment{table_suffix} WHERE character_id = ?", (char_id,))
    for slot, eq_id in enumerate(config['equipment_ids'], 1):
        cursor.execute(f"""
            INSERT INTO character_equipment{table_suffix}
            (character_id, slot, equipment_id)
            VALUES (?, ?, ?)
        """, (char_id, slot, eq_id))
    
    # 4. 保存技能等级
    if not is_default:  # 默认表不保存技能（可选）
        cursor.execute(f"DELETE FROM character_skills{table_suffix} WHERE character_id = ?", (char_id,))
        for skill_id in skill_ids:
            skill_level = config.get('skill_level', 15)
            cursor.execute(f"""
                INSERT INTO character_skills{table_suffix}
                (character_id, skill_id, skill_level)
                VALUES (?, ?, ?)
            """, (char_id, skill_id, skill_level))


def main():
    """主函数"""
    safe_print("="*80)
    safe_print("Initializing Character Cache to Database")
    safe_print("="*80)
    
    # 初始化
    db_path = "db/character_stats.db"
    calculator = StatCalculator(db_path)
    data_loader = DataLoader()
    
    conn = sqlite3.connect(db_path)
    
    # 默认配置
    DEFAULT_LEVEL = 200
    DEFAULT_AFFECTION = 40
    DEFAULT_SCHOOL_LEVEL = 50
    DEFAULT_MODULE_TIER = 10
    DEFAULT_MODULE_LEVEL = 55
    
    safe_print(f"\nDefault Configuration:")
    safe_print(f"  Level: {DEFAULT_LEVEL}")
    safe_print(f"  Affection: {DEFAULT_AFFECTION}")
    safe_print(f"  School Level: {DEFAULT_SCHOOL_LEVEL}")
    safe_print(f"  Module: T{DEFAULT_MODULE_TIER} Lv{DEFAULT_MODULE_LEVEL}")
    safe_print(f"  Equipment: All Enabled")
    
    # 加载所有角色
    characters = data_loader.load_characters()
    total = len(characters)
    
    safe_print(f"\nProcessing {total} characters...")
    
    for i, (char_id, char_data) in enumerate(characters.items(), 1):
        safe_print(f"  [{i}/{total}] {char_data.name} (ID: {char_id})")
        
        # 获取最高稀有度
        max_rarity = get_max_rarity(conn, char_id)
        
        # 构建模块配置（无词条）
        base_module_id = char_data.character_type * 10
        modules = [
            ModuleConfig(module_id=base_module_id + 1, tier=DEFAULT_MODULE_TIER, level=DEFAULT_MODULE_LEVEL),
            ModuleConfig(module_id=base_module_id + 2, tier=DEFAULT_MODULE_TIER, level=DEFAULT_MODULE_LEVEL),
            ModuleConfig(module_id=base_module_id + 3, tier=DEFAULT_MODULE_TIER, level=DEFAULT_MODULE_LEVEL),
        ]
        
        # 装备IDs
        equipment_ids = [base_module_id + i for i in range(1, 5)]
        
        # 计算属性
        stats = calculator.calculate_stats(
            character_id=char_id,
            level=DEFAULT_LEVEL,
            rarity=max_rarity,
            affection_level=DEFAULT_AFFECTION,
            equipment_ids=equipment_ids,
            school_type_level=DEFAULT_SCHOOL_LEVEL,
            school_attribute_level=DEFAULT_SCHOOL_LEVEL,
            modules=modules
        )
        
        # 配置字典
        config = {
            'level': DEFAULT_LEVEL,
            'rarity': max_rarity,
            'affection_level': DEFAULT_AFFECTION,
            'modules': [
                {'module_id': m.module_id, 'tier': m.tier, 'level': m.level}
                for m in modules
            ],
            'equipment_ids': equipment_ids,
            'skill_level': 10 if max_rarity < 14 else 15
        }
        
        # 获取技能
        skill_ids = get_character_skill_ids(data_loader, char_id)
        
        # 保存到主缓存
        save_character_cache(conn, char_id, char_data, stats, config, skill_ids, is_default=False)
        
        # 保存到默认备份
        save_character_cache(conn, char_id, char_data, stats, config, skill_ids, is_default=True)
    
    # 更新元数据
    conn.execute("""
        UPDATE cache_metadata 
        SET value = ?, updated_at = ? 
        WHERE key = 'last_updated'
    """, (datetime.now().isoformat(), datetime.now().isoformat()))
    
    # 提交
    conn.commit()
    conn.close()
    
    safe_print(f"\n{'='*80}")
    safe_print(f"Cache initialization complete!")
    safe_print(f"  Total characters: {total}")
    safe_print(f"  Saved to: {db_path}")
    safe_print(f"  Tables: character_cache, character_cache_default")
    safe_print("="*80)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        safe_print(f"\nERROR: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)
