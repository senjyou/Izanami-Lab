def main():
    with open(HYBRID_PATH, 'r', encoding='utf-8') as f:
        data = json.load(f)

    added = []
    for skill_id, skill_data in NEW_SKILLS.items():
        if skill_id in data:
            print(f"  WARNING: skill {skill_id} already exists, overwriting")
        data[skill_id] = skill_data
        added.append(skill_id)

    with open(HYBRID_PATH, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

    print(f"Added {len(added)} skills: {added}")


if __name__ == '__main__':
    main()
