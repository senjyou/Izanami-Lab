# -*- coding: utf-8 -*-
"""ブレイジングハート (130026) PS反撃攻撃時触発テスト

修正するバグ:
  反撃系PS（如 大ノ反撃 230389）のdamage効果に target_identifier=trigger_attacker が設定されている場合、
  prescanがtarget_type=enemy_single (NEAREST) を使って索敌するため、
  多单位场景で NEAREST ≠ trigger_attacker の時、trigger链が错误目标をチェックし、
  ブレイジングハートの target_is_self 条件が False となり触发しない。

修正後:
  prescanが target_identifier=trigger_attacker を認識し、_trigger_attacker を直接使用する。
  trigger链が正確な目標をチェックし、ブレイジングハートが正常に触发する。

テストシナリオ:
  1. 多单位场景 (NEAREST ≠ trigger_attacker): ブレイジングハートが触发して0伤害
  2. 単位场景 (NEAREST == trigger_attacker): ブレイジングハートが触发して0伤害 (回帰)
  3. 非自身被攻撃: ブレイジングハートが触发しない (回帰, 既存テストと同等)
"""

import sys
import os
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute,
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig
from src.combat_v2.battle_narrative import BattleNarrativeWriter


def _make_unit(unit_id, name, side, position, *,
               hp=100000, atk=10000, defense=4000, speed=500,
               crit_rate=0.0, crit_damage=0.5,
               element=Attribute.LIGHT.value, character_type=1,
               level=15, ap=10, pp=10, ep=0,
               skills=None, skill_levels=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=level, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=ep,
        is_alive=True,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class TestBlazingHeartCounterAttack(unittest.TestCase):
    """ブレイジングハート PS反撃攻撃時触発テスト"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_trouble(self, position=Position.ALLY_LEFT_FRONT, *, level=15):
        """愛を求めるトラブルメーカー (114301): AS=120017, PS=130026(ブレイジングハート)"""
        return _make_unit(
            "trouble", "愛を求めるトラブルメーカー",
            Side.ALLY, position,
            hp=100000, atk=8000, defense=3000, speed=600,
            crit_rate=0.0,
            element=Attribute.LIGHT.value, character_type=1,
            level=level,
            skills=[120017, 130026],
            skill_levels={120017: level, 130026: level},
        )

    def _make_dalei(self, position=Position.ENEMY_CENTER_FRONT, *, level=15):
        """大雷: AS=220368, PS=230389(大ノ反撃)"""
        return _make_unit(
            "dalei", "大雷",
            Side.ENEMY, position,
            hp=200000, atk=12000, defense=4000, speed=750,
            crit_rate=0.0,
            element=Attribute.DARK.value, character_type=2,
            level=level,
            skills=[220368, 230389],
            skill_levels={220368: level, 230389: level},
        )

    def _make_other_ally(self, position=Position.ALLY_CENTER_FRONT, *, hp=200000):
        """其他友方: 无PS的大肉盾"""
        return _make_unit(
            "other", "其他友方",
            Side.ALLY, position,
            hp=hp, atk=5000, defense=5000, speed=400,
            crit_rate=0.0,
            element=Attribute.DARK.value, character_type=1,
            level=15,
            skills=[],
            skill_levels={},
        )

    def _build_controller(self, bf, dl=None):
        dl = dl or self.dl
        narrative = BattleNarrativeWriter(data_loader=dl)
        controller = BattleFlowController(
            bf, BattleConfig(max_turns=1),
            data_loader=dl, narrative=narrative,
        )
        controller._build_display_names()
        return controller, narrative

    def test_blazing_heart_triggers_when_counter_attacked_multi_ally(self):
        """多单位场景: NEAREST ≠ trigger_attacker 时ブレイジングハート应触发

        场景:
          - 愛を求めるトラブルメーカー (ALLY_LEFT_FRONT) - 有ブレイジングハート
          - 其他友方 (ALLY_CENTER_FRONT) - 大雷的NEAREST
          - 大雷 (ENEMY_CENTER_FRONT) - 有大ノ反撃

        愛を求めるトラブルメーカー 攻击 大雷 → 大ノ反撃 反撃 → ブレイジングハート 应触发
        修复前: prescan用NEAREST=其他友方 → target_is_self=False → ブレイジングハート不触发
        修复後: prescan用trigger_attacker=愛を求めるトラブルメーカー → target_is_self=True → 触发
        """
        trouble = self._make_trouble(Position.ALLY_LEFT_FRONT)
        other_ally = self._make_other_ally(Position.ALLY_CENTER_FRONT)
        dalei = self._make_dalei(Position.ENEMY_CENTER_FRONT)
        bf = _make_bf(trouble, other_ally, dalei)

        controller, narrative = self._build_controller(bf)
        ss = controller.skill_service
        ts = controller.trigger_service

        # Step 1: 愛を求めるトラブルメーカー 攻击 大雷
        trouble_hp_before = trouble.current_hp
        ss.execute_skill(
            caster=trouble, skill_id=120017, battlefield=bf, skip_cost=True
        )

        # Step 2: 触发 大ノ反撃
        trigger_actions = ts.trigger_after_as_attacked(
            targets=[dalei], battlefield=bf,
            actor=trouble, primary_target=dalei,
        )
        ps_actions = [a for a in trigger_actions if a.skill_id == 230389]
        self.assertGreater(len(ps_actions), 0, "大雷应触发大ノ反撃")

        # Step 3: 执行 大ノ反撃
        other_hp_before = other_ally.current_hp
        controller._execute_trigger_actions(ps_actions, trouble)

        counter_dmg_to_trouble = trouble_hp_before - trouble.current_hp
        counter_dmg_to_other = other_hp_before - other_ally.current_hp

        # 验证 ブレイジングハート 触发
        lines = narrative._lines
        blazing_in_log = any("ブレイジングハート" in l for l in lines)
        self.assertTrue(blazing_in_log,
                        "ブレイジングハート 应触发 (叙事日志应包含)。日志:\n" + "\n".join(lines))

        # 验证 愛を求めるトラブルメーカー 受到 0 伤害 (perfect_evasion)
        self.assertEqual(counter_dmg_to_trouble, 0,
                         f"ブレイジングハート perfect_evasion 应使伤害归零，实际伤害={counter_dmg_to_trouble}")

        # 验证 其他友方 未受伤 (大ノ反撃只攻击trigger_attacker)
        self.assertEqual(counter_dmg_to_other, 0,
                         f"大ノ反撃 应只攻击trigger_attacker，其他友方不应受伤，实际伤害={counter_dmg_to_other}")

    def test_blazing_heart_triggers_when_counter_attacked_single_ally(self):
        """単位场景: NEAREST == trigger_attacker 时ブレイジングハート应触发 (回帰)

        场景:
          - 愛を求めるトラブルメーカー (ALLY_CENTER_FRONT) - 有ブレイジングハート, 是NEAREST
          - 大雷 (ENEMY_CENTER_FRONT) - 有大ノ反撃
        """
        trouble = self._make_trouble(Position.ALLY_CENTER_FRONT)
        dalei = self._make_dalei(Position.ENEMY_CENTER_FRONT)
        bf = _make_bf(trouble, dalei)

        controller, narrative = self._build_controller(bf)
        ss = controller.skill_service
        ts = controller.trigger_service

        trouble_hp_before = trouble.current_hp
        ss.execute_skill(
            caster=trouble, skill_id=120017, battlefield=bf, skip_cost=True
        )

        trigger_actions = ts.trigger_after_as_attacked(
            targets=[dalei], battlefield=bf,
            actor=trouble, primary_target=dalei,
        )
        ps_actions = [a for a in trigger_actions if a.skill_id == 230389]
        self.assertGreater(len(ps_actions), 0, "大雷应触发大ノ反撃")

        controller._execute_trigger_actions(ps_actions, trouble)

        counter_dmg_to_trouble = trouble_hp_before - trouble.current_hp

        lines = narrative._lines
        blazing_in_log = any("ブレイジングハート" in l for l in lines)
        self.assertTrue(blazing_in_log,
                        "ブレイジングハート 应触发 (単位场景回帰测试)")
        self.assertEqual(counter_dmg_to_trouble, 0,
                         f"ブレイジングハート perfect_evasion 应使伤害归零，实际伤害={counter_dmg_to_trouble}")

    def test_blazing_heart_not_trigger_when_other_ally_attacked(self):
        """他友方被攻撃時ブレイジングハート不応触发 (回帰)

        场景:
          - 愛を求めるトラブルメーカー (ALLY_LEFT_FRONT) - 有ブレイジングハート
          - 其他友方 (ALLY_CENTER_FRONT) - 被攻撃目标, 无ブレイジングハート, 是NEAREST
          - 大雷 (ENEMY_CENTER_FRONT) - 攻撃者, 使用单目标AS技能 120017

        大雷 用单目标AS攻撃 NEAREST (其他友方) → ブレイジングハート 不応触发 (target_is_self=False)
        注意: 必须使用单目标技能 (target_count=1), 否则会波及愛を求めるトラブルメーカー
        """
        trouble = self._make_trouble(Position.ALLY_LEFT_FRONT)
        other_ally = self._make_other_ally(Position.ALLY_CENTER_FRONT, hp=999999)
        # 大雷使用120017 (单目标AS) 而非220368 (target_count=2)
        dalei = _make_unit(
            "dalei", "大雷",
            Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=200000, atk=12000, defense=4000, speed=750,
            crit_rate=0.0,
            element=Attribute.DARK.value, character_type=2,
            level=15,
            skills=[120017, 230389],
            skill_levels={120017: 15, 230389: 15},
        )
        bf = _make_bf(trouble, other_ally, dalei)

        controller, narrative = self._build_controller(bf)
        ss = controller.skill_service

        trouble_hp_before = trouble.current_hp
        other_hp_before = other_ally.current_hp

        # 大雷 用单目标AS 120017 攻击 NEAREST (其他友方)
        ss.execute_skill(
            caster=dalei, skill_id=120017, battlefield=bf, skip_cost=True
        )

        # ブレイジングハート 不応触发 (target_is_self=False, 因为target=其他友方 ≠ 愛を求めるトラブルメーカー)
        lines = narrative._lines
        blazing_in_log = any("ブレイジングハート" in l for l in lines)
        self.assertFalse(blazing_in_log,
                         "ブレイジングハート 不应在其他友方被攻撃时触发。日志:\n" + "\n".join(lines))

        # 其他友方 应受到伤害 (无perfect_evasion)
        other_dmg = other_hp_before - other_ally.current_hp
        self.assertGreater(other_dmg, 0,
                           "其他友方 应受到伤害 (无ブレイジングハート保护)")

        # 愛を求めるトラブルメーカー 不应受到伤害 (未被攻撃, 单目标技能)
        trouble_dmg = trouble_hp_before - trouble.current_hp
        self.assertEqual(trouble_dmg, 0,
                         "愛を求めるトラブルメーカー 未被攻撃，不应受伤")

    def test_blazing_heart_triggers_when_adjacent_to_furthest_target(self):
        """回帰テスト: enemy_single_furthest + adjacent_enemies 场景でブレイジングハート応触发

        バグ: prescanがenemy_single_furthestを主目標として記録せず、adjacent_enemiesの
        隣接目標選択に失敗。before_any_attacked触发器に不完全な目標リストが渡され、
        target_is_self条件がFalseとなりブレイジングハートが不触发。

        修正: prescanがenemy_single_furthestを含む全enemy_single_*タイプを主目標として記録。

        场景:
          - 敵法師 (ENEMY_CENTER_FRONT) - 清廉なる一撃(220372) 使用
            220372 Block1: damage(enemy_single_furthest) + damage(adjacent_enemies, count=2) + mark(浮足)
          - 友方A (ALLY_LEFT_BACK) - 最遠目標 (enemy_single_furthest選出)
          - 愛を求めるトラブルメーカー (ALLY_LEFT_FRONT) - A的隣接目標, 有ブレイジングハート(130026)
          - 友方B (ALLY_CENTER_BACK) - A的隣接目標

        修复前: prescan未記録enemy_single_furthest为主目標 → adjacent_enemies fallback
          → _pre_scanned_cover_candidates=[友方A] → target_is_self=False → ブレイジングハート不触发
        修复後: prescan記録enemy_single_furthest为主目標 → adjacent_enemies正確選出
          → _pre_scanned_cover_candidates=[友方A, 愛を求めるトラブルメーカー, 友方B]
          → target_is_self=True → ブレイジングハート触发 → perfect_evasion回避伤害
        """
        trouble = self._make_trouble(Position.ALLY_LEFT_FRONT)
        ally_a = _make_unit(
            "ally_a", "友方A",
            Side.ALLY, Position.ALLY_LEFT_BACK,
            hp=200000, atk=5000, defense=5000, speed=400,
            crit_rate=0.0,
            element=Attribute.DARK.value, character_type=1,
            level=15,
            skills=[],
            skill_levels={},
        )
        ally_b = _make_unit(
            "ally_b", "友方B",
            Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=200000, atk=5000, defense=5000, speed=400,
            crit_rate=0.0,
            element=Attribute.DARK.value, character_type=1,
            level=15,
            skills=[],
            skill_levels={},
        )
        enemy = _make_unit(
            "enemy", "敵法師",
            Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=200000, atk=12000, defense=4000, speed=750,
            crit_rate=0.0,
            element=Attribute.DARK.value, character_type=2,
            level=15,
            skills=[220372],
            skill_levels={220372: 15},
        )
        bf = _make_bf(trouble, ally_a, ally_b, enemy)

        controller, narrative = self._build_controller(bf)
        ss = controller.skill_service

        trouble_hp_before = trouble.current_hp
        trouble_pp_before = trouble.current_pp
        ally_a_hp_before = ally_a.current_hp
        ally_b_hp_before = ally_b.current_hp

        # 敵法師 使用 清廉なる一撃 (220372)
        ss.execute_skill(
            caster=enemy, skill_id=220372, battlefield=bf, skip_cost=True
        )

        # 验证 ブレイジングハート 触发：PS消耗了PP（skill_type=2, cost=1）
        # 注意：before_any_attacked型PS通过_execute_trigger_actions_inline内联执行，
        # 不经过controller._execute_trigger_actions，故叙事日志不记录PS名。
        # 改为通过副作用验证：PP消耗 + cooldown设置 + perfect_evasion回避
        trouble_pp_after = trouble.current_pp
        self.assertEqual(trouble_pp_after, trouble_pp_before - 1,
                         f"ブレイジングハート 应消耗1 PP (PP: {trouble_pp_before}->{trouble_pp_after})")

        # 验证 cooldown 已设置 (PS触发后cooldown=2)
        blazing_cd = trouble.skill_cooldowns.get(130026, 0)
        self.assertGreater(blazing_cd, 0,
                           f"ブレイジングハート 触发后应设置cooldown，实际={blazing_cd}")

        # 验证 愛を求めるトラブルメーカー 受到 0 伤害 (perfect_evasion)
        trouble_dmg = trouble_hp_before - trouble.current_hp
        self.assertEqual(trouble_dmg, 0,
                         f"ブレイジングハート perfect_evasion 应使伤害归零，实际伤害={trouble_dmg}")

        # 验证 友方A 和 友方B 受到伤害 (技能正常执行, 无perfect_evasion保护)
        ally_a_dmg = ally_a_hp_before - ally_a.current_hp
        self.assertGreater(ally_a_dmg, 0,
                           "友方A (最遠目標) 应受到伤害 (无ブレイジングハート保护)")
        ally_b_dmg = ally_b_hp_before - ally_b.current_hp
        self.assertGreater(ally_b_dmg, 0,
                           "友方B (隣接目標) 应受到伤害 (无ブレイジングハート保护)")


if __name__ == '__main__':
    unittest.main(verbosity=2)
