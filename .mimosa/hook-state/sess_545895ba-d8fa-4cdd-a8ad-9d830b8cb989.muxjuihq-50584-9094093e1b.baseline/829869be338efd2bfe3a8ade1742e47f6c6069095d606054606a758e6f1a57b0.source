#!/usr/bin/env python
# -*- coding: utf-8 -*-

import unittest
from unittest.mock import MagicMock
import sys
from pathlib import Path

# 添加项目根目录到路径
sys.path.insert(0, str(Path(__file__).parent.parent))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import TriggerTiming, Position
from src.combat_v2.services.trigger_service import TriggerService, TriggerContext, TriggerInstance

class TestTriggerService(unittest.TestCase):
    
    def setUp(self):
        self.service = TriggerService()
        self.battlefield = MagicMock(spec=BattlefieldState)
        self.context = TriggerContext(TriggerTiming.TURN_START, self.battlefield)

    def test_priority_calculation_speed(self):
        """测试优先级: 速度越高，优先级数值越小(排前面)"""
        u1 = MagicMock(spec=UnitState)
        u1.speed = 100
        u1.position = Position.ALLY_LEFT_FRONT
        
        u2 = MagicMock(spec=UnitState)
        u2.speed = 200
        u2.position = Position.ALLY_LEFT_FRONT
        
        p1 = self.service.calculate_priority(u1)
        p2 = self.service.calculate_priority(u2)
        
        # p2 should be smaller (come first)
        self.assertLess(p2, p1)

    def test_priority_calculation_position(self):
        """测试优先级: 同速度，己方前排 > 己方后排 > 敌方"""
        u1 = MagicMock(spec=UnitState)
        u1.speed = 100
        u1.position = Position.ALLY_CENTER_FRONT # Priority 2
        
        u2 = MagicMock(spec=UnitState)
        u2.speed = 100
        u2.position = Position.ALLY_CENTER_BACK # Priority 5
        
        p1 = self.service.calculate_priority(u1)
        p2 = self.service.calculate_priority(u2)
        
        self.assertLess(p1, p2)

    def test_sorting_logic(self):
        """测试排序逻辑"""
        # Create instances with pre-calculated priorities
        # U1: Speed 100
        # U2: Speed 200 (First)
        # U3: Speed 100, But better position (Second)
        
        u1 = MagicMock(spec=UnitState); u1.unit_id="u1"; u1.speed=100; u1.position=Position.ALLY_CENTER_BACK
        u2 = MagicMock(spec=UnitState); u2.unit_id="u2"; u2.speed=200; u2.position=Position.ALLY_CENTER_FRONT
        u3 = MagicMock(spec=UnitState); u3.unit_id="u3"; u3.speed=100; u3.position=Position.ALLY_CENTER_FRONT
        
        # Calc priorities
        p1 = self.service.calculate_priority(u1) # 100, poor pos
        p2 = self.service.calculate_priority(u2) # 200, good pos -> BEST
        p3 = self.service.calculate_priority(u3) # 100, good pos -> BETTER than u1
        
        c1 = TriggerInstance(1, u1, p1)
        c2 = TriggerInstance(2, u2, p2)
        c3 = TriggerInstance(3, u3, p3)
        
        candidates = [c1, c2, c3]
        
        # Access private method for testing or use check_triggers with mocks?
        # Python allows access to _private
        actions = self.service._process_candidates(candidates, self.context)
        
        self.assertEqual(len(actions), 3)
        self.assertEqual(actions[0].owner_id, "u2") # Speed 200
        self.assertEqual(actions[1].owner_id, "u3") # Speed 100, Front
        self.assertEqual(actions[2].owner_id, "u1") # Speed 100, Back

if __name__ == '__main__':
    unittest.main()
