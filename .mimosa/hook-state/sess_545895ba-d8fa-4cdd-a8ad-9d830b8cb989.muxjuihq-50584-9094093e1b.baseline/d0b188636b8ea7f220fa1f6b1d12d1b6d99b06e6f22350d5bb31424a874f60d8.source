            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    # ─── EX: 飽和爆撃 ───

    def test_ex_lowest_hp_priority_target(self):
        """
        EX(110047) 最低HP优先目标选择
        验证: 攻击HP比例最低的敌方
        """
        # 设置敌方后排HP比例最低
        self.enemy_back.current_hp = 3000  # 25%
        self.enemy_front.current_hp = 12000  # 80%

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110047, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "EX应造成伤害")

        # 验证目标是HP比例最低的敌方后排
        target_ids = set()
        for e in dmg_effects:
            for t in e.get("targets", []):
                target_ids.add(t.get("target_id"))
        self.assertIn(self.enemy_back.unit_id, target_ids, "应攻击HP比例最低的敌方后排")

    def test_ex_crit_rate_up_buff(self):
        """
        EX(110047) 必暴buff
        验证: 使用后自身获得100%暴击率buff，持续2行动
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110047, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        crit_buffs = [b for b in self.caster.buffs if b.effect_type == CRIT_RATE_UP]
        self.assertTrue(len(crit_buffs) > 0, "应获得暴击率UP buff")
        self.assertEqual(crit_buffs[0].value, 100, "暴击率UP应为100%")
        self.assertEqual(crit_buffs[0].duration, 2, "暴击率UP应持续2行动")

    def test_ex_lv11_shield(self):
        """
        EX(110047) Lv11+护盾
        验证: Lv11+时自身获得护盾（ATK×shield%），持续2行动
        """
        self.caster.skill_levels[110047] = 15
        self.caster.level = 15

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110047, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertTrue(len(shield_buffs) > 0, "Lv11+应获得护盾")
        self.assertEqual(shield_buffs[0].duration, 2, "护盾应持续2行动")

    # ─── AS1: 制圧支援 ───

    def test_as1_nearest_enemy_target(self):
        """
        AS1(120104) 最近敌人目标选择
        验证: 攻击距自身最近的敌方（display_target_priority=0）
        caster在中前，最近敌方应为敌方前排(距离0)
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120104, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "AS1应造成伤害")

    def test_as1_def_down_percent(self):
        """
        AS1(120104) 降防效果（百分比）
        验证: 对主目标和邻接目标施加百分比降防debuff，持续1行动
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120104, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 检查敌方前排是否获得降防debuff（通过aura系统添加）
        enemy_def_debuffs = [b for b in self.enemy_front.debuffs
                             if b.effect_type == STATUS_DEFENSE]
        self.assertTrue(len(enemy_def_debuffs) > 0, "敌方前排应获得降防debuff")
        self.assertEqual(enemy_def_debuffs[0].duration, 1, "降防应持续1行动")

        # 检查邻接目标也获得降防debuff
        adj_def_debuffs = [b for b in self.enemy_left_front.debuffs
                           if b.effect_type == STATUS_DEFENSE]
        self.assertTrue(len(adj_def_debuffs) > 0, "邻接目标也应获得降防debuff")

    def test_as1_adjacent_targets_attacked(self):
        """
        AS1(120104) 邻接目标攻击
        验证: 主目标+邻接2体都受到伤害
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120104, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        # 应有主目标伤害和邻接伤害
        self.assertTrue(len(dmg_effects) >= 2, "应有主目标和邻接目标的伤害")

    # ─── AS2: 点射 ───

    def test_as2_basic_damage(self):
        """
        AS2(120105) 基础伤害
        验证: 对敌方单体造成伤害
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120105, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "AS2应造成伤害")

    def test_as2_crit_rate_up_on_kill(self):
        """
        AS2(120105) 击杀时暴击率UP
        验证: 击杀敌方后，自身及友方获得5%暴击率UP（永久，可叠加）
        """
        # 设置敌方前排低血量以便击杀
        self.enemy_front.current_hp = 100

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120105, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证击杀
        self.assertFalse(self.enemy_front.is_alive, "应击杀敌方前排")

        # 验证自身获得暴击率UP buff（self_and_friends包含自身）
        caster_crit_buffs = [b for b in self.caster.buffs if b.effect_type == CRIT_RATE_UP]
        self.assertTrue(len(caster_crit_buffs) > 0, "自身应获得暴击率UP buff")
        self.assertEqual(caster_crit_buffs[0].value, 5, "暴击率UP应为5%")

        # 验证友方也获得暴击率UP
        ally_crit_buffs = [b for b in self.ally_back.buffs if b.effect_type == CRIT_RATE_UP]
        self.assertTrue(len(ally_crit_buffs) > 0, "友方也应获得暴击率UP buff")

    def test_as2_no_crit_up_without_kill(self):
        """
        AS2(120105) 未击杀不触发暴击率UP
        验证: 未击杀敌方时，不触发暴击率UP
        """
        # 敌方满血，不会被击杀
        self.enemy_front.current_hp = self.enemy_front.max_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120105, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证敌方存活
        self.assertTrue(self.enemy_front.is_alive, "敌方应存活")

        # 验证没有暴击率UP buff（target_killed条件未满足）
        caster_crit_buffs = [b for b in self.caster.buffs if b.effect_type == CRIT_RATE_UP]
        self.assertEqual(len(caster_crit_buffs), 0, "未击杀不应获得暴击率UP buff")

    # ─── PS1: フェイルセーフ ───

    def test_ps1_cumulative_damage_trigger(self):
        """
        PS1(130114) 累计伤害触发
        验证: 累计受到>=10%最大HP伤害时触发PS1
        """
        # 设置累计伤害为10%最大HP
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.1)

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        # 应有触发动作
        self.assertTrue(len(actions) > 0, "累计伤害达到阈值应触发PS1")

    def test_ps1_no_trigger_below_threshold(self):
        """
        PS1(130114) 未达阈值不触发
        验证: 累计伤害<10%最大HP时不触发
        """
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.05)

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        self.assertEqual(len(actions), 0, "累计伤害未达阈值不应触发PS1")

    def test_ps1_ep_fill_with_ap(self):
        """
        PS1(130114) 有AP时：EP填满 + ATK UP + 友方加EP
        验证: 有AP时消耗1AP，EP填满，获得ATK UP，友方EP+1
        """
        self.caster.current_ap = 2
        self.caster.current_ep = 0
        self.ally_back.current_ep = 2

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130114, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证EP填满（value_source=max_ep）
        self.assertEqual(self.caster.current_ep, self.caster.max_extra_point,
                         "有AP时EP应填满")

        # 验证ATK UP buff
        atk_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertTrue(len(atk_buffs) > 0, "有AP时应获得ATK UP buff")

        # 验证友方EP+1
        add_ep_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "add_ep"]
        self.assertTrue(len(add_ep_effects) > 0, "应有add_ep效果")

    def test_ps1_ep_fill_without_ap(self):
        """
        PS1(130114) 无AP时：仅EP填满
        验证: 无AP时仅EP填满，不消耗AP，不获得ATK UP，不加友方EP
        """
        self.caster.current_ap = 0
        self.caster.current_ep = 0

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130114, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证EP填满
        self.assertEqual(self.caster.current_ep, self.caster.max_extra_point,
                         "无AP时EP也应填满")

        # 验证没有ATK UP buff
        atk_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 0, "无AP时不应获得ATK UP buff")

    def test_ps1_counter_reset_on_trigger(self):
        """
        PS1(130114) 触发后计数器清除
        验证: PS1成功执行后，cumulative_hp_damage重置为0
        """
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.15)
        self.caster.current_ap = 2
        self.caster.current_pp = 10

        # 通过trigger_cumulative_damage触发
        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        self.assertTrue(len(actions) > 0, "应触发PS1")

        # 执行触发动作（模拟PS执行后清除计数器）
        for action in actions:
            parsed = self.dl.get_parsed_skill_data(action.skill_id)
            trigger_type = parsed.get('trigger_type') if parsed else None
            if trigger_type == 'on_cumulative_damage':
                self.caster.cumulative_hp_damage = 0

        self.assertEqual(self.caster.cumulative_hp_damage, 0, "PS1执行后计数器应清零")

    # ─── PS2: 諸元修正 ───

    def test_ps2_dmg_dealt_up_after_as_attack(self):
        """
        PS2(130115) AS攻击后触发dmg_dealt_up
        验证: AS攻击后自身获得dmg_dealt_up buff，持续1行动
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130115, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_up_buffs = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertTrue(len(dmg_up_buffs) > 0, "应获得dmg_dealt_up buff")
        self.assertEqual(dmg_up_buffs[0].duration, 1, "dmg_dealt_up应持续1行动")

    def test_ps2_stackable(self):
        """
        PS2(130115) 可叠加
        验证: 多次触发时dmg_dealt_up可叠加
        """
        # 第一次触发
        result1 = self.ss.execute_skill(
            caster=self.caster, skill_id=130115, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result1["success"])

        first_count = len([b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE])

        # 第二次触发
        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=130115, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result2["success"])

        second_count = len([b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE])
        self.assertGreater(second_count, first_count, "dmg_dealt_up应可叠加")

    # ─── 累计伤害机制 ───

    def test_cumulative_hp_damage_tracking(self):
        """
        累计伤害追踪
        验证: 受到HP伤害时cumulative_hp_damage正确累加
        """
        initial_cumulative = self.caster.cumulative_hp_damage

        # 模拟受到伤害（通过skill_service的damage结算）
        result = self.ss.execute_skill(
            caster=self.enemy_front, skill_id=120105, battlefield=self.bf, skip_cost=True
        )

        # 如果造成了HP伤害，累计值应增加
        if self.caster.current_hp < self.caster.max_hp:
            hp_loss = self.caster.max_hp - self.caster.current_hp
            self.assertEqual(self.caster.cumulative_hp_damage, initial_cumulative + hp_loss,
                             "HP伤害应正确累加到cumulative_hp_damage")

    def test_cumulative_damage_threshold_calculation(self):
        """
        累计伤害阈值计算
        验证: 10%最大HP的阈值计算正确
        """
        threshold = self.ts._get_cumulative_damage_threshold(self.caster)
        self.assertIsNotNone(threshold, "角色136301应有cumulative_damage阈值")
        self.assertEqual(threshold, 10, "阈值应为10%")

    def test_cumulative_damage_no_threshold_for_other_units(self):
        """
        其他单位无累计伤害阈值
        验证: 非PS1持有者不应有cumulative_damage阈值
        """
        threshold = self.ts._get_cumulative_damage_threshold(self.enemy_front)
        self.assertIsNone(threshold, "非PS1持有者不应有阈值")


if __name__ == "__main__":
    unittest.main()
