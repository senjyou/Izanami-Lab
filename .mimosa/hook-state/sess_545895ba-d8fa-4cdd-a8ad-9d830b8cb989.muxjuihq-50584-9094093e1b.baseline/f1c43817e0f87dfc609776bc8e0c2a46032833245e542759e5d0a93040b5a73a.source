                           "en_back应被治疗(Lv15 2体)")

    def test_as2_120112_lv11_remove_1_debuff(self):
        """AS2(120112) Lv11 解除1个debuff (LIFO)"""
        self.ally_phys_front.current_hp = 3000
        self.ally_phys_front.debuffs.append(BuffState(
            buff_id="d1", name="毒", effect_type="poison",
            value=10.0, duration=3, timing_type=2, is_debuff=True,
        ))
        self.ally_phys_front.debuffs.append(BuffState(
            buff_id="d2", name="炎上", effect_type="burn",
            value=10.0, duration=3, timing_type=2, is_debuff=True,
        ))
        self.ally_phys_front.debuffs.append(BuffState(
            buff_id="d3", name="眩晕", effect_type="stun",
            value=10.0, duration=3, timing_type=2, is_debuff=True,
        ))

        self.caster.skill_levels[120112] = 11
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120112, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Lv11解除1个（LIFO: 最后施加的d3）
        self.assertEqual(len(self.ally_phys_front.debuffs), 2,
                         f"Lv11应解除1个debuff, 剩余: {len(self.ally_phys_front.debuffs)}")
        remaining_names = [d.name for d in self.ally_phys_front.debuffs]
        self.assertNotIn("眩晕", remaining_names, "LIFO应移除最后施加的眩晕")

    # ─── AS2: 120112 索敌逻辑专项（两层优先：自身以外 > HP比例最低） ───

    def _exec_heal_and_get_healed_set(self, skill_level=10):
        """执行120112治疗技能，返回被治疗(HP增加)的单位unit_id集合。
        前提：targets的current_hp < max_hp，确保治疗能体现为HP增加。"""
        self.caster.skill_levels[120112] = skill_level
        hp_before = {u.unit_id: u.current_hp for u in self.bf.friend_team if u.is_alive}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120112, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"], f"AS2执行应成功: {result.get('error', '')}")
        healed = set()
        for u in self.bf.friend_team:
            if u.is_alive and u.current_hp > hp_before.get(u.unit_id, u.current_hp):
                healed.add(u.unit_id)
        return healed

    def test_as2_120112_lv10_prefers_non_self_when_self_has_lowest_hp(self):
        """
        Lv10(1体): 自身HP比例最低但有非自身友方 → 不选自身
        场景: caster(5%) + en_front(33%) + phys_front(25%)
        期望: 治疗phys_front(25%)，不治疗caster(5%)
        """
        self.caster.current_hp = 1000      # 1000/20000 = 5% (最低)
        self.ally_en_front.current_hp = 5000   # 5000/15000 = 33%
        self.ally_phys_front.current_hp = 3000  # 3000/12000 = 25% (非自身中最低)
        self.ally_en_back.is_alive = False
        self.bf.friend_team = [self.caster, self.ally_en_front, self.ally_phys_front]

        healed = self._exec_heal_and_get_healed_set(skill_level=10)

        self.assertIn("ally_phys_front", healed, "应治疗phys_front(非自身中HP最低)")
        self.assertNotIn("ally_back_caster", healed,
                         "caster虽HP最低但不应被治疗(自身以外优先)")

    def test_as2_120112_lv15_prefers_non_self_when_self_has_lowest_hp(self):
        """
        Lv15(2体): 自身HP比例最低但有2+非自身友方 → 不选自身，选2个非自身最低HP
        场景: caster(5%) + en_front(33%) + phys_front(25%) + en_back(20%)
        期望: 治疗en_back(20%) + phys_front(25%)，不治疗caster(5%)
        """
        self.caster.current_hp = 1000      # 5% (最低)
        self.ally_en_front.current_hp = 5000   # 33%
        self.ally_phys_front.current_hp = 3000  # 25%
        self.ally_en_back.current_hp = 2000     # 20%
        self.bf.friend_team = [self.caster, self.ally_en_front,
                               self.ally_phys_front, self.ally_en_back]

        healed = self._exec_heal_and_get_healed_set(skill_level=15)

        self.assertIn("ally_en_back", healed, "应治疗en_back(非自身最低HP)")
        self.assertIn("ally_phys_front", healed, "应治疗phys_front(非自身次低HP)")
        self.assertNotIn("ally_back_caster", healed,
                         "caster虽HP最低但不应被治疗(自身以外优先)")
        self.assertNotIn("ally_en_front", healed,
                         "en_front HP比例最高(33%)不应被治疗")

    def test_as2_120112_lv15_picks_2_lowest_hp_from_3_non_self_allies(self):
        """
        Lv15(2体): 3个非自身友方，选HP比例最低的2个
        场景: caster(100%) + en_front(33%) + phys_front(25%) + en_back(20%)
        期望: 治疗en_back(20%) + phys_front(25%)，不治疗en_front(33%)和caster(100%)
        """
        self.caster.current_hp = 20000     # 100%
        self.ally_en_front.current_hp = 5000   # 33%
        self.ally_phys_front.current_hp = 3000  # 25%
        self.ally_en_back.current_hp = 2000     # 20%
        self.bf.friend_team = [self.caster, self.ally_en_front,
                               self.ally_phys_front, self.ally_en_back]

        healed = self._exec_heal_and_get_healed_set(skill_level=15)

        self.assertIn("ally_en_back", healed, "应治疗en_back(20%)")
        self.assertIn("ally_phys_front", healed, "应治疗phys_front(25%)")
        self.assertNotIn("ally_en_front", healed, "不应治疗en_front(33%)")
        self.assertNotIn("ally_back_caster", healed, "不应治疗caster(100%)")

    def test_as2_120112_lv15_fills_with_self_when_only_1_non_self_ally(self):
        """
        Lv15(2体): 仅1个非自身友方 → 该友方 + 自身补位
