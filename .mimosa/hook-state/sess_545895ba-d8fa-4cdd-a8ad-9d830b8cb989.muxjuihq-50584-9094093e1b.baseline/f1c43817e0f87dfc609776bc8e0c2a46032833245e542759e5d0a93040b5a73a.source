    def test_as2_120112_remove_debuff_targets_heal_target_not_self(self):
        """
        Lv14+(全解除): remove_debuff跟随heal目标，不治疗自身
        场景: caster(5%,有debuff) + phys_front(25%,有debuff) + en_front(33%,有debuff)
        期望: phys_front被heal+解除debuff，caster的debuff不被解除(自身以外优先)
        """
        self.caster.current_hp = 1000      # 5% (最低, 有debuff)
        self.ally_phys_front.current_hp = 3000  # 25% (非自身最低, 有debuff)
        self.ally_en_front.current_hp = 5000    # 33% (有debuff)
        self.ally_en_back.is_alive = False
        self.bf.friend_team = [self.caster, self.ally_en_front, self.ally_phys_front]

        # 给3个单位都施加debuff
        for u, did in [(self.caster, "c1"), (self.ally_phys_front, "p1"),
                       (self.ally_en_front, "e1")]:
            u.debuffs.clear()
            u.debuffs.append(BuffState(
                buff_id=did, name="毒", effect_type="poison",
                value=10.0, duration=3, timing_type=2, is_debuff=True,
            ))

        self.caster.skill_levels[120112] = 14
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120112, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # phys_front (heal目标) 的debuff应被解除
        self.assertEqual(len(self.ally_phys_front.debuffs), 0,
                         "phys_front(heal目标)的debuff应被解除")
        # caster的debuff不应被解除（自身以外优先，caster不是heal目标）
        self.assertEqual(len(self.caster.debuffs), 1,
                         "caster的debuff不应被解除(自身以外优先，不是heal目标)")
        # en_front的debuff不应被解除（不是heal目标）
        self.assertEqual(len(self.ally_en_front.debuffs), 1,
                         "en_front的debuff不应被解除(不是heal目标)")

