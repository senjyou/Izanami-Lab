    # ─── EX: 110050 装いを新たに ───

    def test_ex_110050_def_up_2_front_allies(self):
        """
        EX(110050) 前排2体防御UP
        验证:
        1. def_up施加给2个前排友方（ally_en_front, ally_phys_front）
        2. def_up值为百分比（Lv10 def tag=35.0%）
        3. duration=1 action
        4. 不施加给后排（caster自身和ally_en_back）
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110050, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"], f"EX执行应成功: {result.get('error', '')}")

        # 前排友方获得def_up
        en_front_def = [b for b in self.ally_en_front.buffs if b.effect_type == DEF_UP]
        phys_front_def = [b for b in self.ally_phys_front.buffs if b.effect_type == DEF_UP]
        self.assertGreater(len(en_front_def), 0, "EN前排应获得def_up")
        self.assertGreater(len(phys_front_def), 0, "物理前排应获得def_up")

        # def_up值为35.0%（Lv10）
        self.assertAlmostEqual(en_front_def[0].value, 35.0, places=1,
                               msg=f"def_up值应为35.0%, 实际: {en_front_def[0].value}")

        # duration=1
        self.assertEqual(en_front_def[0].duration, 1,
                         f"def_up duration应为1, 实际: {en_front_def[0].duration}")

        # 后排不获得def_up
        caster_def = [b for b in self.caster.buffs if b.effect_type == DEF_UP]
        en_back_def = [b for b in self.ally_en_back.buffs if b.effect_type == DEF_UP]
        self.assertEqual(len(caster_def), 0, "后排caster不应获得def_up")
        self.assertEqual(len(en_back_def), 0, "后排友方不应获得def_up")

    def test_ex_110050_sub_unit_same_targets(self):
        """
        EX(110050) 子機Ⅱ付与所有被加防的友方
        验证:
        1. 子機Ⅱ施加给被def_up的2个前排友方
        2. sub_unit HP = caster.max_hp × 25% = 20000 × 25% = 5000
        3. duration=3 action
        4. atk_pct = Lv10 atk tag = 31.2%
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110050, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 2个前排友方都获得sub_unit
        en_front_su = [b for b in self.ally_en_front.buffs if b.effect_type == SUB_UNIT]
        phys_front_su = [b for b in self.ally_phys_front.buffs if b.effect_type == SUB_UNIT]
        self.assertGreater(len(en_front_su), 0, "EN前排应获得子機Ⅱ")
        self.assertGreater(len(phys_front_su), 0, "物理前排应获得子機Ⅱ")

        # sub_unit HP = 20000 × 25% = 5000
        expected_hp = int(self.caster.max_hp * 25 / 100)
        self.assertEqual(en_front_su[0].sub_unit_hp, expected_hp,
                         f"子機HP应为{expected_hp}, 实际: {en_front_su[0].sub_unit_hp}")
        self.assertEqual(en_front_su[0].sub_unit_max_hp, expected_hp,
                         f"子機maxHP应为{expected_hp}, 实际: {en_front_su[0].sub_unit_max_hp}")

        # duration=3
        self.assertEqual(en_front_su[0].duration, 3,
                         f"子機duration应为3, 实际: {en_front_su[0].duration}")

        # atk_pct = 31.2% (Lv10 atk tag)
        self.assertAlmostEqual(en_front_su[0].value, 31.2, places=1,
                               msg=f"子機atk_pct应为31.2%, 实际: {en_front_su[0].value}")

    def test_ex_110050_sub_unit_name(self):
        """EX(110050) 子機名称为「子機Ⅱ」"""
        self.ss.execute_skill(
            caster=self.caster, skill_id=110050, battlefield=self.bf, skip_cost=True
        )
        su = [b for b in self.ally_en_front.buffs if b.effect_type == SUB_UNIT]
        self.assertGreater(len(su), 0)
        self.assertEqual(su[0].name, "子機Ⅱ",
                         f"子機名称应为「子機Ⅱ」, 实际: {su[0].name}")

    # ─── AS1: 120111 幸運のデコイ ───

    def test_as1_120111_atk_up_permanent(self):
        """
        AS1(120111) ATK+5%永久buff
        验证:
        1. atk_up值为5.0%
        2. duration=-1（永久）
        3. is_stackable=True（重複可）
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120111, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"], f"AS1执行应成功: {result.get('error', '')}")

        # 找到获得atk_up的友方（EN优先）
        en_front_atk = [b for b in self.ally_en_front.buffs if b.effect_type == ATK_UP]
        self.assertGreater(len(en_front_atk), 0, "EN前排应获得atk_up")

        atk_buff = en_front_atk[0]
        self.assertAlmostEqual(atk_buff.value, 5.0, places=1,
                               msg=f"atk_up值应为5.0%, 实际: {atk_buff.value}")
        self.assertEqual(atk_buff.duration, -1,
                         f"atk_up duration应为-1(永久), 实际: {atk_buff.duration}")
        self.assertTrue(atk_buff.is_stackable, "atk_up应可叠加")

    def test_as1_120111_en_type_priority(self):
        """
        AS1(120111) EN类型优先
        验证: 有EN类型友方时，atk_up和子機施加给EN友方（自身以外優先）
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120111, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # EN前排(character_type=2)应获得atk_up和子機
        en_front_atk = [b for b in self.ally_en_front.buffs if b.effect_type == ATK_UP]
        en_front_su = [b for b in self.ally_en_front.buffs if b.effect_type == SUB_UNIT]
        self.assertGreater(len(en_front_atk), 0, "EN前排应获得atk_up")
        self.assertGreater(len(en_front_su), 0, "EN前排应获得子機Ⅰ")

        # 物理前排(character_type=1)不应获得（EN优先）
        phys_front_atk = [b for b in self.ally_phys_front.buffs if b.effect_type == ATK_UP]
        self.assertEqual(len(phys_front_atk), 0, "物理前排不应获得atk_up（EN优先）")

    def test_as1_120111_en_priority_when_physical_ally_closer(self):
        """
        AS1(120111) EN类型优先 > 距离最近
        验证: 当物理友方比EN友方离caster更近时，仍优先选择EN友方
        场景: caster(后排中) + 物理友方(前排中, 距离1) + EN友方(后排左, 距离2)
        期望: EN友方获得atk_up和子機（EN优先于距离）
        """
        # 重新配置战场: 物理友方最近, EN友方次近
        self.bf.friend_team = [self.caster]

        # 物理友方在最近位置(前排中, 距离caster=1)
        self.ally_phys_front.position = Position.ALLY_CENTER_FRONT
        self.ally_phys_front.is_alive = True
        self.ally_phys_front.buffs.clear()
        self.bf.friend_team.append(self.ally_phys_front)

        # EN友方在次近位置(后排左, 距离caster=2)
        self.ally_en_back.position = Position.ALLY_LEFT_BACK
        self.ally_en_back.is_alive = True
        self.ally_en_back.buffs.clear()
        self.bf.friend_team.append(self.ally_en_back)

        # 移除不需要的单位
        self.ally_en_front.is_alive = False
        self.caster.buffs.clear()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120111, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # EN友方(后排左, 较远)应获得atk_up和子機（EN优先，即使物理友方更近）
        en_back_atk = [b for b in self.ally_en_back.buffs if b.effect_type == ATK_UP]
        en_back_su = [b for b in self.ally_en_back.buffs if b.effect_type == SUB_UNIT]
        self.assertGreater(len(en_back_atk), 0, "EN友方(较远)应获得atk_up（EN优先于距离）")
        self.assertGreater(len(en_back_su), 0, "EN友方(较远)应获得子機Ⅰ（EN优先于距离）")

        # 物理友方(前排中, 最近)不应获得
        phys_atk = [b for b in self.ally_phys_front.buffs if b.effect_type == ATK_UP]
        phys_su = [b for b in self.ally_phys_front.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(phys_atk), 0, "物理友方不应获得atk_up（即使距离最近，EN优先）")
        self.assertEqual(len(phys_su), 0, "物理友方不应获得子機Ⅰ（即使距离最近，EN优先）")

    def test_as1_120111_physical_ally_when_no_en_ally(self):
        """
        AS1(120111) 无EN友方时选择最近的物理友方（自身以外优先）
        验证: 只有物理友方(自身以外)时，选择物理友方而非自身
        场景: caster(后排中) + 物理友方(前排中)
        期望: 物理友方获得atk_up和子機（自身以外优先级 > EN类型优先级）
        """
        self.bf.friend_team = [self.caster]
        self.ally_phys_front.position = Position.ALLY_CENTER_FRONT
        self.ally_phys_front.is_alive = True
        self.ally_phys_front.buffs.clear()
        self.bf.friend_team.append(self.ally_phys_front)

        # 移除其他友方
        self.ally_en_front.is_alive = False
        self.ally_en_back.is_alive = False
        self.caster.buffs.clear()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120111, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 物理友方应获得（自身以外优先，即使非EN类型）
        phys_atk = [b for b in self.ally_phys_front.buffs if b.effect_type == ATK_UP]
        phys_su = [b for b in self.ally_phys_front.buffs if b.effect_type == SUB_UNIT]
        self.assertGreater(len(phys_atk), 0, "物理友方应获得atk_up（自身以外优先）")
        self.assertGreater(len(phys_su), 0, "物理友方应获得子機Ⅰ（自身以外优先）")

        # caster自身不应获得
        caster_atk = [b for b in self.caster.buffs if b.effect_type == ATK_UP]
        caster_su = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(caster_atk), 0, "caster不应获得atk_up（有其他友方时不回退自身）")
        self.assertEqual(len(caster_su), 0, "caster不应获得子機Ⅰ（有其他友方时不回退自身）")

    def test_as1_120111_sub_unit_name_and_duration(self):
        """AS1(120111) 子機Ⅰ, duration=3 action"""
        self.ss.execute_skill(
            caster=self.caster, skill_id=120111, battlefield=self.bf, skip_cost=True
        )
        su = [b for b in self.ally_en_front.buffs if b.effect_type == SUB_UNIT]
        self.assertGreater(len(su), 0)
        self.assertEqual(su[0].name, "子機Ⅰ", f"子機名称应为「子機Ⅰ」, 实际: {su[0].name}")
        self.assertEqual(su[0].duration, 3, f"子機duration应为3, 实际: {su[0].duration}")

    def test_as1_120111_fallback_self_when_no_other_ally(self):
        """
        AS1(120111) 无其他友方时回退到自身
        验证: 只有caster存活时，atk_up和子機施加给自身
        """
        # 移除所有其他友方
        self.bf.friend_team = [self.caster]
        for ally in [self.ally_en_front, self.ally_phys_front, self.ally_en_back]:
            ally.is_alive = False

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120111, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # caster自身获得atk_up和子機
        caster_atk = [b for b in self.caster.buffs if b.effect_type == ATK_UP]
        caster_su = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertGreater(len(caster_atk), 0, "无其他友方时caster应获得atk_up")
        self.assertGreater(len(caster_su), 0, "无其他友方时caster应获得子機Ⅰ")

    def test_as1_120111_lv11_add_status_spd_down(self):
        """
        AS1(120111) Lv11+ 子機追加伤害时施加spd_down
        验证: Lv11时子機的hit_limited_flags包含add_status_to_attack
        """
        self.caster.skill_levels[120111] = 11
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120111, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        su = [b for b in self.ally_en_front.buffs if b.effect_type == SUB_UNIT]
        self.assertGreater(len(su), 0)
        hlf = su[0].hit_limited_flags
        self.assertIn('add_status_to_attack', hlf, "Lv11+子機应包含add_status_to_attack")
        add_status = hlf['add_status_to_attack']
        self.assertEqual(add_status.get('status'), 'spd_down')
        # spd tag Lv11=10.0
        self.assertAlmostEqual(add_status.get('value', 0), 10.0, places=1,
                               msg=f"spd_down值应为10.0(Lv11), 实际: {add_status.get('value')}")

    # ─── AS2: 120112 仲間想いのリカバリー ───

    def test_as2_120112_heal_lowest_hp(self):
        """
        AS2(120112) 回复HP比例最低的友方
        验证: ally_en_back HP最低(10000/10000=100%但max_hp最低)
        实际: 设定ally_phys_front HP最低
        """
        # 设定ally_phys_front HP比例最低
        self.ally_phys_front.current_hp = 3000  # 3000/12000 = 25%

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120112, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"], f"AS2执行应成功: {result.get('error', '')}")

        # ally_phys_front HP应增加
        self.assertGreater(self.ally_phys_front.current_hp, 3000,
                           "最低HP友方应被治疗")

    def test_as2_120112_remove_debuff_shares_heal_target(self):
        """
        AS2(120112) remove_debuff与heal目标一致
        验证: heal选定的目标同时被remove_debuff解除debuff
        """
        # ally_phys_front HP最低
        self.ally_phys_front.current_hp = 3000
        # 给ally_phys_front施加2个debuff
        self.ally_phys_front.debuffs.append(BuffState(
            buff_id="d1", name="毒", effect_type="poison",
            value=10.0, duration=3, timing_type=2,
            is_debuff=True,
        ))
        self.ally_phys_front.debuffs.append(BuffState(
            buff_id="d2", name="炎上", effect_type="burn",
            value=10.0, duration=3, timing_type=2,
            is_debuff=True,
        ))

        # Lv12: remove 3 debuffs (但只有2个)
        self.caster.skill_levels[120112] = 12
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120112, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # ally_phys_front的debuff应被解除
        self.assertEqual(len(self.ally_phys_front.debuffs), 0,
                         f"heal目标应被解除所有debuff, 剩余: {len(self.ally_phys_front.debuffs)}")

        # 其他友方debuff不受影响（给ally_en_front也加debuff验证）
        self.ally_en_front.debuffs.append(BuffState(
            buff_id="d3", name="毒B", effect_type="poison",
            value=10.0, duration=3, timing_type=2,
            is_debuff=True,
        ))
        # 重新执行（ally_en_front现在HP最低？不，先恢复phys_front）
        # 这个验证已在上面完成

    def test_as2_120112_lv15_heal_2_targets(self):
        """
        AS2(120112) Lv15 治疗2体
