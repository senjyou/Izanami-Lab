    def test_ps2_130120_guard_applied(self):
        """
        PS2(130120) guard% buff施加
        验证: 触发后caster获得guard buff (legacy buff机制), guard值=50%(Lv10)
        修复前: duration_type="attacker_action"导致使用special机制(unit.guard_active),
                但_get_guard_multiplier只在is_cover_damage=True时生效, guard不减少伤害
        修复后: 改用legacy buff机制(value_tag=0, attack_limited=1), guard正确减少伤害
        """
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130120, None)

        actions = self.ts.trigger_before_any_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_en_front
        )
        ps2_actions = [a for a in actions if a.skill_id == 130120]
        self.assertGreater(len(ps2_actions), 0)

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="before_any_attacked"
        )

        # caster应获得guard buff (legacy buff机制, 非special机制)
        GUARD = SkillEffectType.GUARD.value
        guard_buffs = [b for b in self.caster.buffs if b.effect_type == GUARD]
        self.assertGreater(len(guard_buffs), 0, "caster应获得guard buff")
        self.assertAlmostEqual(guard_buffs[0].value, 50.0, places=1,
                               msg=f"guard buff值应为50.0%(Lv10), 实际: {guard_buffs[0].value}")
        self.assertEqual(guard_buffs[0].attack_limited, 1,
                         msg="guard buff应有attack_limited=1 (受攻击后消失)")

    def test_ps2_130120_does_not_trigger_when_attacking_ally(self):
        """
        PS2(130120) 攻击目标是友方时不触发（不是自身）
        验证: targets不含caster时不触发
        """
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130120, None)

        actions = self.ts.trigger_before_any_attacked(
            targets=[self.ally_en_front], battlefield=self.bf, attacker=self.enemy_en_front
        )
        ps2_triggered = any(a.skill_id == 130120 for a in actions)
        self.assertFalse(ps2_triggered, "攻击目标非caster时不应触发PS2")

    # ─── 130009 self-guard bug修复 ───

    def test_130009_self_guard_triggers_with_single_target(self):
        """
        130009 アイギスランバード self-guard bug修复
        验证: 索敌列表只有caster自身（无其他友方）时仍可触发
        修复前: _is_cover_ps误判self-guard为cover类, 导致无其他友方时被阻止
        修复后: target_is_self的guard不被判定为cover, 可正常触发
        """
        # 使用一个拥有130009 PS的角色
        guard_owner = UnitState(
            unit_id="guard_owner", name="guard持有者", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999999, level=10,
            element=2, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=10, current_ep=0,
            skills=[130009],
            skill_levels={130009: 10},
            skill_cooldowns={},
        )
        # 只有guard_owner自己（无其他友方）
        self.bf.friend_team = [guard_owner]

        # 敌方攻击guard_owner（索敌列表只有guard_owner一人）
        actions = self.ts.trigger_before_any_attacked(
            targets=[guard_owner], battlefield=self.bf, attacker=self.enemy_en_front
        )
        triggered = any(a.skill_id == 130009 for a in actions)
        self.assertTrue(triggered,
                        "130009 self-guard应在单体索敌时触发（bug修复后）")


