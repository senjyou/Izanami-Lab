    def test_ps1_multiple_stacks(self):
        """PS1(130154) 多次触发 → crit_rate_up 叠加（stackable）。

        触发2次PS1，应有2个 crit_rate_up buff。
        """
        self._reset_caster(hp=self.caster.max_hp, ep=0)
        self._reset_enemies()
        self._apply_kaihoukan(self.caster, count=1)
        self.caster.skill_cooldowns = {}

        # 第一次触发
        self.caster.crit_counter = 0
        actions1 = self.ts.trigger_pawn_caused_critical(
            caster=self.caster, battlefield=self.bf, count=2,
            crit_target=self.enemy_front
        )
        ps1_actions = [a for a in actions1 if a.skill_id == 130154]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="pawn_caused_critical"
        )

        buffs_after_first = [b for b in self.caster.buffs
                             if b.effect_type == STATUS_CRITICAL_CHANCE]
        self.assertEqual(len(buffs_after_first), 1, "第一次触发应有1个crit_rate_up buff")

        # 第二次触发
        self.caster.crit_counter = 0
        actions2 = self.ts.trigger_pawn_caused_critical(
            caster=self.caster, battlefield=self.bf, count=2,
            crit_target=self.enemy_front
        )
        ps2_actions = [a for a in actions2 if a.skill_id == 130154]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="pawn_caused_critical"
        )

        buffs_after_second = [b for b in self.caster.buffs
                              if b.effect_type == STATUS_CRITICAL_CHANCE]
        self.assertEqual(len(buffs_after_second), 2,
                         "第二次触发应叠加第2个crit_rate_up buff（stackable）")

    # ─── PS2: 130155 たまには羽を伸ばして ───

    def test_ps2_on_turn_start_triggers(self):
        """PS2(130155) on_turn_start: 回合开始时触发（cooldown=99 战闘中1回）。"""
        self._reset_caster(hp=self.caster.max_hp, ep=0)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.bf.turn_number = 2

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130155]
        self.assertGreater(len(ps2_actions), 0, "PS2应在回合开始时被收集")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证PS2执行后设置了冷却（cooldown=99）
        self.assertEqual(self.caster.skill_cooldowns.get(130155), 99,
                         "PS2执行后应设置 cooldown=99")

    def test_ps2_block1_consume_hp_and_dmg_taken_down(self):
        """PS2(130155) Block1: consume_hp 30% + dmg_taken_down(stackable, hp_ratio_dynamic, permanent)。"""
        self._reset_caster(hp=self.caster.max_hp, ep=0)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.bf.turn_number = 2

        hp_before = self.caster.current_hp

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130155]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证 HP 被消耗30%
        expected_consume = int(self.caster.max_hp * 0.30)
        actual_consume = hp_before - self.caster.current_hp
        self.assertEqual(actual_consume, expected_consume,
                         f"Block1应消耗30% HP={expected_consume}，实际={actual_consume}")

        # 验证 dmg_taken_down buff（hp_ratio_dynamic, stackable, permanent duration=-1）
        dmg_taken_downs = [b for b in self.caster.buffs
                           if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(dmg_taken_downs), 0, "应有 dmg_taken_down buff")
        self.assertTrue(dmg_taken_downs[0].is_stackable, "dmg_taken_down应可叠加")
        self.assertEqual(dmg_taken_downs[0].duration, -1,
                         "dmg_taken_down应永续（duration=-1）")
        self.assertTrue(getattr(dmg_taken_downs[0], 'hp_ratio_dynamic', False),
                        "dmg_taken_down应 hp_ratio_dynamic=True")

    def test_ps2_block2_lv11_grants_dmg_dealt_up(self):
        """PS2(130155) Block2: Lv11+ 时执行，dmg_dealt_up(stackable, target_hp_ratio_higher_than_self, permanent)。"""
        self._reset_caster(hp=self.caster.max_hp, ep=0)
