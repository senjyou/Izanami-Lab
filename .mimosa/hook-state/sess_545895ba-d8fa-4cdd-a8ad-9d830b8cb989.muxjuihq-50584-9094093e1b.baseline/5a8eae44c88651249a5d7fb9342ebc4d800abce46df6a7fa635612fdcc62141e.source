    def test_ps2_cooldown_99_blocks_retrigger(self):
        """PS2(130155) cooldown=99 阻止再次触发（戦闘中1回）。

        第一次触发后 cooldown=99，第二次 trigger_turn_start 不应再收集PS2。
        """
        self._reset_caster(hp=self.caster.max_hp, ep=0)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.bf.turn_number = 2

        # 第一次触发
        actions1 = self.ts.trigger_turn_start(self.bf)
        ps2_1 = [a for a in actions1 if a.skill_id == 130155]
        self.assertGreater(len(ps2_1), 0, "第一次应触发PS2")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_1, self.bf, trigger_timing="on_turn_start"
        )
        self.assertEqual(self.caster.skill_cooldowns.get(130155), 99,
                         "第一次执行后应设置 cooldown=99")

        # 第二次触发（PS2在冷却中）
        actions2 = self.ts.trigger_turn_start(self.bf)
        ps2_2 = [a for a in actions2 if a.skill_id == 130155]
        self.assertEqual(len(ps2_2), 0,
                         "PS2在冷却中 → 不应再次被收集")


