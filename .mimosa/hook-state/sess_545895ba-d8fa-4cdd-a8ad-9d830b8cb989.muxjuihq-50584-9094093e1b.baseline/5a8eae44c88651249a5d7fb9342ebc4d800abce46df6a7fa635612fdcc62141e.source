"""
角色142302 真夏の風紀委員長 专项E2E测试
- EX: 110070 真夏のトラブル発生！（自身mark[解放感,buff_mark]+atk_up[linked,stackable]+dmg_dealt_up[linked,stackable]+ep_gain_down[linked]; Lv11-15 cheat_death stack_count=1-5[linked]）
- AS1: 120156 海辺の取り締まり！（敵横一列EN攻撃；无解放感Block1威力/有解放感Block2威力2；HP>=30%时Block3消耗15%HP+追加150%消耗HP基底EN伤害）
- AS2: 120157 うっかり大惨事（敵3体EN攻撃；有解放感时Block2对attacked_targets付1行动気絶）
- PS1: 130154 リフレッシュ完了！（on_critical + crit_count_mod=2 每2暴击触发；无解放感Block1 add_ep 1；有解放感Block2 crit_rate_up[stackable]；Lv11+有解放感Block3 crit_dmg_up[stackable]）
- PS2: 130155 たまには羽を伸ばして（on_turn_start cooldown=99 戦闘中1回；Block1 consume_hp 30% + dmg_taken_down[stackable,hp_ratio_dynamic,permanent]；Lv11+ Block2 dmg_dealt_up[stackable,target_hp_ratio_higher_than_self,permanent]）

覆盖维度：
1. EX 解放感mark付与(buffs列表)+linked atk_up/dmg_dealt_up/ep_gain_down + Lv11-15 cheat_death stack_count分支
2. AS1 解放感有无Block1/Block2互斥 + HP>=30%/HP<30% Block3分支 + consume_hp+追加伤害
3. AS2 敵3体伤害 + 解放感有无Block2 stun付与
4. PS1 crit_count_mod=2触发阈值 + 解放感有无Block1/Block2互斥 + Lv11+ Block3 crit_dmg_up + stackable叠加
5. PS2 on_turn_start cooldown=99 + consume_hp 30% + dmg_taken_down(hp_ratio_dynamic) + Lv11+ dmg_dealt_up(target_hp_ratio_higher_than_self) + 再触发被冷却阻止
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# 注意：atk_up/atk_down 共用 STATUS_ATTACK 枚举
# crit_rate_up/crit_rate_down 共用 STATUS_CRITICAL_CHANCE
# crit_dmg_up/crit_dmg_down 共用 CRITICAL_BONUS_MODIFICATION
# dmg_taken_up/dmg_taken_down 共用 RECEIVED_DAMAGE
# dmg_dealt_up/dmg_dealt_down 共用 DEALT_DAMAGE
# mark 用 MARK 枚举（buff mark 进 buffs 列表，debuff mark 进 debuffs 列表）
MARK = SkillEffectType.MARK.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_CRITICAL_CHANCE = SkillEffectType.STATUS_CRITICAL_CHANCE.value
CRITICAL_BONUS_MODIFICATION = SkillEffectType.CRITICAL_BONUS_MODIFICATION.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
EP_GAIN_DOWN = SkillEffectType.EP_GAIN_DOWN.value
KNOCKOUT = SkillEffectType.KNOCKOUT.value  # stun 被映射为 KNOCKOUT（"Knockout"）
CHEAT_DEATH = "cheat_death"  # cheat_death 直接用字符串作为 effect_type


class TestActor142302(unittest.TestCase):
    """角色142302 真夏の風紀委員長 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 142302 真夏の風紀委員長 (火属性attr=1, EN型character_type=2, 灵活position_type=3, 攻撃role_type=2)
        # 默认Lv10，部分测试用Lv15验证Lv11+分支
        # caster 放前排中央（enemy_row 索敌选敌方前排）
        self.caster = UnitState(
            unit_id="ally_front", name="真夏の風紀委員長", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=142302, level=10,
            element=1, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110070, 120156, 120157, 130154, 130155],
            skill_levels={110070: 10, 120156: 10, 120157: 10,
                          130154: 10, 130155: 10},
            skill_cooldowns={},
        )

        # 敌方前排中央（最近敌，主目标）
        self.enemy_front = UnitState(
            unit_id="enemy_front", name="敌方前排", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（AS1 横列/AS2 3体测试用）
        self.enemy_left = UnitState(
            unit_id="enemy_left", name="敌方左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（AS1 横列/AS2 3体测试用）
        self.enemy_right = UnitState(
            unit_id="enemy_right", name="敌方右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=4500, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy_front, self.enemy_left, self.enemy_right]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ap = 4

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.crit_counter = 0

    def _apply_kaihoukan(self, target=None, count=1):
        """为指定目标附加「解放感」mark buff（is_buff_mark=true → buffs 列表，is_debuff=False）。

        142302 的核心状态：解放感 mark 驱动 AS1/AS2/PS1 多个 block 分支。
        """
        if target is None:
            target = self.caster
        for i in range(count):
            target.buffs.append(BuffState(
                buff_id=f"test_kaihoukan_{id(target)}_{i}",
                name="解放感", effect_type=MARK, value=0,
                duration=-1, timing_type=2, is_debuff=False,
                unremovable=False,
            ))

    # ─── EX: 110070 真夏のトラブル発生！ ───

    def test_ex_grants_kaihoukan_mark(self):
        """EX(110070) Block1: 自身付与「解放感」mark(is_buff_mark=true → buffs列表)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110070, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证解放感 mark 在 buffs 列表（is_buff_mark=true）
        marks = [b for b in self.caster.buffs
                 if b.effect_type == MARK and b.name == "解放感"]
        self.assertEqual(len(marks), 1, "应施加1个解放感mark")
        self.assertFalse(marks[0].is_debuff, "解放感mark应为buff（is_debuff=False）")
        self.assertEqual(marks[0].duration, 2, "解放感mark duration应为2")

    def test_ex_grants_atk_up_and_dmg_dealt_up_linked(self):
        """EX(110070) Block1: 自身付与 atk_up + dmg_dealt_up(stackable, linked_mark=解放感)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110070, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 atk_up buff
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "应有 atk_up buff")
        self.assertEqual(atk_ups[0].duration, 2, "atk_up duration应为2")
        self.assertTrue(atk_ups[0].is_stackable, "atk_up应可叠加")
        self.assertEqual(getattr(atk_ups[0], 'linked_buff_id', ""),
                         "解放感", "atk_up应 linked_buff_id=解放感")

        # 验证 dmg_dealt_up buff
        dmg_ups = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_ups), 0, "应有 dmg_dealt_up buff")
        self.assertEqual(dmg_ups[0].duration, 2, "dmg_dealt_up duration应为2")
        self.assertTrue(dmg_ups[0].is_stackable, "dmg_dealt_up应可叠加")
        self.assertEqual(getattr(dmg_ups[0], 'linked_buff_id', ""),
                         "解放感", "dmg_dealt_up应 linked_buff_id=解放感")

    def test_ex_grants_ep_gain_down_linked(self):
        """EX(110070) Block1: 自身付与 ep_gain_down(linked_mark=解放感, value=100%)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110070, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 ep_gain_down debuff（自身debuff）
        ep_downs = [d for d in self.caster.debuffs if d.effect_type == EP_GAIN_DOWN]
        self.assertGreater(len(ep_downs), 0, "应有 ep_gain_down debuff")
        self.assertEqual(ep_downs[0].value, 100.0, "ep_gain_down value应为100%")
        self.assertEqual(ep_downs[0].duration, 2, "ep_gain_down duration应为2")
        self.assertEqual(getattr(ep_downs[0], 'linked_buff_id', ""),
                         "解放感", "ep_gain_down应 linked_buff_id=解放感")

    def test_ex_lv10_no_cheat_death(self):
        """EX(110070) Lv10: 无 cheat_death buff（Block2-6 active_level_min=11 才触发）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[110070] = 10

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110070, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        cheat_deaths = [b for b in self.caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_deaths), 0, "Lv10不应有 cheat_death buff")

    def test_ex_lv11_grants_cheat_death_1hit(self):
        """EX(110070) Lv11 Block2: cheat_death(stack_count=1, linked=解放感)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[110070] = 11

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110070, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        cheat_deaths = [b for b in self.caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_deaths), 1, "Lv11应有1个 cheat_death buff")
        self.assertEqual(cheat_deaths[0].duration, 2, "cheat_death duration应为2")
        self.assertEqual(getattr(cheat_deaths[0], 'linked_buff_id', ""),
                         "解放感", "cheat_death应 linked_buff_id=解放感")

    def test_ex_lv15_grants_cheat_death_5hits(self):
        """EX(110070) Lv15 Block6: cheat_death(stack_count=5, linked=解放感)。

        Block2/3/4/5/6 通过 active_level_min=11/12/13/14/15 + active_level_max=同值
        实现互斥，仅对应等级的 Block 执行。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[110070] = 15

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110070, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        cheat_deaths = [b for b in self.caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_deaths), 1, "Lv15应有1个 cheat_death buff（Block6互斥）")
        # stack_count=5（Lv15-10=5）
        self.assertEqual(getattr(cheat_deaths[0], 'stack_count', 1), 5,
                         "Lv15 cheat_death stack_count应为5")
        self.assertEqual(getattr(cheat_deaths[0], 'linked_buff_id', ""),
                         "解放感", "cheat_death应 linked_buff_id=解放感")

    # ─── AS1: 120156 海辺の取り締まり！ ───

    def test_as1_block1_damage_without_kaihoukan(self):
        """AS1(120156) Block1: 无解放感时执行，enemy_row EN 伤害（威力）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 无解放感
        marks = [b for b in self.caster.buffs if b.name == "解放感"]
        self.assertEqual(len(marks), 0)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120156, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 enemy_row 命中敌方前排3体
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "enemy_front应受到Block1伤害")
        self.assertLess(self.enemy_left.current_hp, self.enemy_left.max_hp,
                        "enemy_left应受到Block1伤害")
        self.assertLess(self.enemy_right.current_hp, self.enemy_right.max_hp,
                        "enemy_right应受到Block1伤害")

        # 验证仅有1个damage effect（Block1）
        # 注意：Block3条件self_hp_above>=30%，caster HP=20000/20000=100%，满足，会执行Block3
        # Block3含consume_hp+damage，所以damage effect数≥2
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertGreaterEqual(len(dmg_effects), 2,
                                "应至少有2个damage effect（Block1威力 + Block3追加伤害）")

    def test_as1_block2_damage_with_kaihoukan(self):
        """AS1(120156) Block2: 有解放感时执行（威力2），Block1跳过。

        通过对比有/无解放感时的 enemy_front HP 损失，验证 Block1/Block2 互斥。
        注意：Block3 (HP>=30%) 在两种场景下都会执行，所以差异主要来自 Block1 vs Block2。
        """
        # 场景1: 无解放感 → Block1(威力) + Block3
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 不施加解放感
        result1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120156, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result1["success"])
        hp_loss_no_mark = self.enemy_front.max_hp - self.enemy_front.current_hp
        self.assertGreater(hp_loss_no_mark, 0, "无解放感时Block1应造成伤害")

        # 场景2: 有解放感 → Block2(威力2) + Block3
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_kaihoukan(self.caster, count=1)

        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120156, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result2["success"])

        # 验证 enemy_front 受到伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "enemy_front应受到Block2伤害")

        # 验证有解放感时(Block2威力2)伤害应不低于无解放感时(Block1威力)
        # 注意：Block3 追加伤害相同，差异主要来自 Block1/Block2
        hp_loss_with_mark = self.enemy_front.max_hp - self.enemy_front.current_hp
        self.assertGreater(hp_loss_with_mark, 0, "有解放感时Block2应造成伤害")

    def test_as1_block3_skipped_when_hp_below_30(self):
        """AS1(120156) Block3: HP<30%时跳过（不消耗HP，无追加伤害）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 设置 HP=20%（<30%）
        self.caster.current_hp = int(self.caster.max_hp * 0.20)

        hp_before = self.caster.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120156, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block3跳过：caster HP不应被消耗（consume_hp 15%）
        # Block1主伤害不影响caster HP
        self.assertEqual(self.caster.current_hp, hp_before,
                         "HP<30%时Block3跳过，caster HP不应被消耗")

        # 验证只有1个damage effect（仅Block1，无Block3追加）
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 1,
                         f"HP<30%时Block3跳过，应只有1个damage（Block1），实际: {len(dmg_effects)}")

    def test_as1_block3_consumes_hp_when_hp_above_30(self):
        """AS1(120156) Block3: HP>=30%时执行，消耗15% current HP。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # HP=100%（>=30%）
        self.caster.current_hp = self.caster.max_hp
        hp_before = self.caster.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120156, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 HP 被消耗（15% of current_hp）
        expected_consume = int(self.caster.max_hp * 0.15)
        actual_consume = hp_before - self.caster.current_hp
        self.assertEqual(actual_consume, expected_consume,
                         f"Block3应消耗15% HP={expected_consume}，实际消耗={actual_consume}")

        # 验证 consume_hp effect 存在
        consume_effects = [e for e in result["effects_applied"]
                           if e.get("effect_type") == "consume_hp"]
        self.assertGreater(len(consume_effects), 0, "应有 consume_hp effect")
        self.assertEqual(consume_effects[0].get("consumed"), expected_consume)

    def test_as1_block3_additional_damage_150pct_consume_base(self):
        """AS1(120156) Block3: 追加伤害(150% consume_hp base, EN)。

        consume_hp 消耗 15% × max_hp = 3000，追加伤害 = 3000 × 150% = 4500
        （ caster atk=10000, def=6000, 威力影响较小，主要验证追加伤害存在 ）
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # HP=100%（>=30%，触发Block3）
        hp_before = self.caster.current_hp
        enemy_hp_before = self.enemy_front.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120156, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证追加伤害存在（Block1 + Block3 共2个damage effect）
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 2,
                         f"应执行Block1+Block3共2个damage effect，实际: {len(dmg_effects)}")

        # consume_hp base = 3000，追加伤害 = 3000 × 150% = 4500（理论值）
        consume_amount = hp_before - self.caster.current_hp
        self.assertGreater(consume_amount, 0, "应已消耗HP")

    # ─── AS2: 120157 うっかり大惨事 ───

    def test_as2_block1_damage_3_targets(self):
        """AS2(120157) Block1: 敵3体 EN 伤害（target_count=3）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120157, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证3个敌方都受到伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "enemy_front应受到伤害")
        self.assertLess(self.enemy_left.current_hp, self.enemy_left.max_hp,
                        "enemy_left应受到伤害")
        self.assertLess(self.enemy_right.current_hp, self.enemy_right.max_hp,
                        "enemy_right应受到伤害")

        # 验证有1个damage effect（Block1，target_count=3命中3体）
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 1,
                         f"无解放感时只执行Block1，应有1个damage effect，实际: {len(dmg_effects)}")

    def test_as2_block2_skipped_without_kaihoukan(self):
        """AS2(120157) Block2: 无解放感时跳过（敌方无stun/Knockout debuff）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120157, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证3个敌方都无 stun (Knockout) debuff
        for e, name in [(self.enemy_front, "前排"), (self.enemy_left, "左前"),
                        (self.enemy_right, "右前")]:
            stuns = [d for d in e.debuffs if d.effect_type == KNOCKOUT]
            self.assertEqual(len(stuns), 0, f"{name}无解放感时不应有stun debuff")

    def test_as2_block2_stun_with_kaihoukan(self):
        """AS2(120157) Block2: 有解放感时执行，对 attacked_targets 付1行动気絶（Knockout）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_kaihoukan(self.caster, count=1)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120157, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证3个敌方都有 stun (Knockout) debuff
        for e, name in [(self.enemy_front, "前排"), (self.enemy_left, "左前"),
                        (self.enemy_right, "右前")]:
            stuns = [d for d in e.debuffs if d.effect_type == KNOCKOUT]
            self.assertGreater(len(stuns), 0, f"{name}有解放感时应有stun debuff")
            self.assertEqual(stuns[0].duration, 1, f"{name} stun duration应为1")

    def test_as2_block2_stun_all_attacked_targets(self):
        """AS2(120157) Block2: stun 命中所有被攻击目标（attacked_targets, 3体）。

        通过对比 Block1 damage 命中数 vs Block2 stun 命中数，验证一致性。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_kaihoukan(self.caster, count=1)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120157, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 所有受到伤害的敌方都应有 stun (Knockout)
        damaged = [e for e in self.bf.enemy_team
                   if e.current_hp < e.max_hp]
        self.assertEqual(len(damaged), 3, "应有3个敌方受到伤害")

        for e in damaged:
            stuns = [d for d in e.debuffs if d.effect_type == KNOCKOUT]
            self.assertGreater(len(stuns), 0,
                               f"{e.name}受到伤害 → 应有stun debuff")

    # ─── PS1: 130154 リフレッシュ完了！ ───

    def test_ps1_block1_add_ep_without_kaihoukan(self):
        """PS1(130154) Block1: 无解放感时执行，自身 add_ep 1。

        crit_count_mod=2 → 需2次暴击才触发。
        trigger_pawn_caused_critical(count=2) 会让 crit_counter=2，并触发PS收集。
        """
        self._reset_caster(hp=self.caster.max_hp, ep=0)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 模拟2次暴击触发PS1（crit_count_mod=2）
        # trigger_pawn_caused_critical 会增加 crit_counter 并返回PS actions
        actions = self.ts.trigger_pawn_caused_critical(
            caster=self.caster, battlefield=self.bf, count=2,
            crit_target=self.enemy_front
        )
        self.assertEqual(self.caster.crit_counter, 2, "2次暴击后 crit_counter=2")

        ps_actions = [a for a in actions if a.skill_id == 130154]
        self.assertGreater(len(ps_actions), 0, "PS1(130154)应在2次暴击时被收集")

        # 执行PS1
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="pawn_caused_critical"
        )

        # 验证 EP 增加（PS执行自动 generate_ep +1 + Block1 add_ep +1 = 2）
        self.assertEqual(self.caster.current_ep, 2,
                         "Block1无解放感 → generate_ep(1) + add_ep(1) = EP=2")

    def test_ps1_block2_crit_rate_up_with_kaihoukan(self):
        """PS1(130154) Block2: 有解放感时执行，自身 crit_rate_up(stackable)。"""
        self._reset_caster(hp=self.caster.max_hp, ep=0)
        self._reset_enemies()
        self._apply_kaihoukan(self.caster, count=1)
        self.caster.skill_cooldowns = {}

        # 2次暴击触发PS1
        actions = self.ts.trigger_pawn_caused_critical(
            caster=self.caster, battlefield=self.bf, count=2,
            crit_target=self.enemy_front
        )
        ps_actions = [a for a in actions if a.skill_id == 130154]
        self.assertGreater(len(ps_actions), 0, "PS1应在2次暴击时被收集")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="pawn_caused_critical"
        )

        # 验证 crit_rate_up buff
        crit_ups = [b for b in self.caster.buffs
                    if b.effect_type == STATUS_CRITICAL_CHANCE]
        self.assertGreater(len(crit_ups), 0, "Block2有解放感 → 应有 crit_rate_up buff")
        self.assertTrue(crit_ups[0].is_stackable, "crit_rate_up应可叠加")

        # 验证 EP 仅来自 PS 执行自动 generate_ep +1（Block1跳过，无 add_ep）
        self.assertEqual(self.caster.current_ep, 1,
                         "有解放感时Block1跳过，仅 generate_ep(1) → EP=1")

