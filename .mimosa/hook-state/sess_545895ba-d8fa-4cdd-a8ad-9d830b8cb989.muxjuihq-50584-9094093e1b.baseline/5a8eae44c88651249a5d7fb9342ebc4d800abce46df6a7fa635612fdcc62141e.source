        self.assertTrue(getattr(dmg_dealt_ups[0], 'target_hp_ratio_higher_than_self', False),
                        "dmg_dealt_up应 target_hp_ratio_higher_than_self=True")

    def test_ps2_block2_skipped_lv10(self):
