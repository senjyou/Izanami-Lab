    # ─── AS3: 一点突破の戦術 ───

    def test_as3_220377_damage_and_mark(self):
        """AS3(220377) 敵単体EN攻撃 + 凶兆+1"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220377, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "220377应造成伤害")

        # 敌方caster的"敵"指己方阵营，应对己方施加凶兆
        mark_count_front = _count_marks(self.ally_front, "凶兆")
        mark_count_left = _count_marks(self.ally_left, "凶兆")
        self.assertGreater(mark_count_front + mark_count_left, 0, "应施加凶兆mark到己方")

    # ─── EX: 静かな時を ───

    def test_ex_210101_mark_below_2_adds_mark(self):
        """EX(210101) 凶兆<2时施加凶兆+1"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=210101, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 应对所有己方施加凶兆
        mark_front = _count_marks(self.ally_front, "凶兆")
        mark_left = _count_marks(self.ally_left, "凶兆")
        self.assertGreaterEqual(mark_front, 1, "己方前排应有凶兆")
        self.assertGreaterEqual(mark_left, 1, "己方左前应有凶兆")

    def test_ex_210101_mark_ge_2_dmg_dealt_down(self):
        """EX(210101) 凶兆≥2时施加dmg_dealt_down100%(1attack)"""
        # 预先给己方2个凶兆
        for i in range(2):
            self.ally_front.debuffs.append(BuffState(
                buff_id=f"pre_mark_{i}", name="凶兆",
                effect_type=MARK, value=0,
                duration=-1, timing_type=1,
            ))
            self.ally_left.debuffs.append(BuffState(
                buff_id=f"pre_mark_l_{i}", name="凶兆",
                effect_type=MARK, value=0,
                duration=-1, timing_type=1,
            ))

        ally_hp_before_front = self.ally_front.current_hp
        ally_hp_before_left = self.ally_left.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=210101, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 凶兆≥2时不+1，而是施加dmg_dealt_down
        found_dealt_down = False
        for b in self.ally_front.debuffs + self.ally_left.debuffs:
            if b.effect_type == DEALT_DAMAGE:
                found_dealt_down = True
                break
        self.assertTrue(found_dealt_down, "凶兆≥2时应施加dmg_dealt_down")

        # 应造成伤害(EX仍包含enemy_all damage block1)
        self.assertLess(self.ally_front.current_hp, ally_hp_before_front,
                        "EX应对己方前排造成伤害")

    # ─── AS1: 遅効の毒計 ───

    def test_as1_220375_genwaku_applied(self):
        """AS1(220375) 对攻撃力最高己方施加幻惑"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220375, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # ally_front攻击力9000 > ally_left攻击力3000，应为ally_front
        genwaku_buff = _find_aura(self.ally_front, GENWAKU)
        self.assertIsNotNone(genwaku_buff, "应对攻撃力最高己方施加幻惑")

        # 验证凶兆+1
        mark_count = _count_marks(self.ally_front, "凶兆")
        self.assertGreaterEqual(mark_count, 1, "应施加凶兆mark")

        # 验证action_damage debuff被施加
        action_dmg = _find_aura(self.ally_front, ACTION_DAMAGE)
        self.assertIsNotNone(action_dmg, "应施加action_damage(継続ENダメージ)")

    def test_as1_220375_genwaku_value(self):
        """AS1(220375) 幻惑值正确(Lv10=70%)"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220375, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        genwaku_buff = _find_aura(self.ally_front, GENWAKU)
        self.assertIsNotNone(genwaku_buff, "应有幻惑")
        # Lv10 genwaku值=70
        self.assertEqual(genwaku_buff.value, 70.0, "Lv10幻惑值应为70%")

    def test_as1_220375_mark_ge_4_triggers_extra_and_removes(self):
        """AS1(220375) 凶兆≥4时追加100威力攻击 + 全解除"""
        # 预先给己方前排4个凶兆
        for i in range(4):
            self.ally_front.debuffs.append(BuffState(
                buff_id=f"pre_mark_{i}", name="凶兆",
                effect_type=MARK, value=0,
                duration=-1, timing_type=1,
            ))

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220375, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 凶兆应被全解除
        mark_after = _count_marks(self.ally_front, "凶兆")
        # block2会remove_all 凶兆，但block1又会+1，所以最终应为1
        self.assertLessEqual(mark_after, 1,
                             f"凶兆≥4触发后应全解除，再+1，最终≤1，实际={mark_after}")

    # ─── AS2: 逆転の方策 ───

    def test_as2_220376_blocked_by_deep_thought(self):
        """AS2(220376) 自身持有深慮时不发动(global_condition: self_lacks_mark)"""
        # 给caster施加深慮mark
        self.caster.buffs.append(BuffState(
            buff_id="test_deep_thought", name="深慮",
            effect_type=MARK, value=0,
            duration=-1, timing_type=1,
        ))

        ally_hp_before = self.ally_front.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220376, battlefield=self.bf, skip_cost=True
        )
        # global_condition不满足时，技能不发动
        self.assertEqual(self.ally_front.current_hp, ally_hp_before,
                         "持有深慮时220376应不造成伤害")

    def test_as2_220376_3hit_and_crit_down(self):
        """AS2(220376) 3hit EN攻撃 + 会心率/会心ダメ下降"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220376, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证3hit伤害
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "220376应造成伤害")

        # 验证crit_rate_down被施加 (STATUS_CRITICAL_CHANCE)
        found_crit_down = False
        for b in self.ally_front.debuffs:
            if b.effect_type == SkillEffectType.STATUS_CRITICAL_CHANCE.value:
                found_crit_down = True
                break
        self.assertTrue(found_crit_down, "应施加crit_rate_down")

        # 验证crit_dmg_down被施加 (CRITICAL_BONUS_MODIFICATION)
        found_crit_dmg_down = False
        for b in self.ally_front.debuffs:
            if b.effect_type == SkillEffectType.CRITICAL_BONUS_MODIFICATION.value:
                found_crit_dmg_down = True
                break
        self.assertTrue(found_crit_dmg_down, "应施加crit_dmg_down")

    def test_as2_220376_mark_and_action_damage(self):
        """AS2(220376) 施加凶兆+1和継続ENダメージ"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220376, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证凶兆+1
        mark_count = _count_marks(self.ally_front, "凶兆")
        self.assertGreaterEqual(mark_count, 1, "应施加凶兆mark")

        # 验证action_damage debuff被施加
        action_dmg = _find_aura(self.ally_front, ACTION_DAMAGE)
        self.assertIsNotNone(action_dmg, "应施加action_damage(継続ENダメージ)")

    # ─── PS: 起死回生の一手 ───

    def test_ps_230398_config_loads(self):
        """PS(230398) 配置正确加载"""
        skill_data = self.dl.get_skill_by_id(230398)
        self.assertIsNotNone(skill_data, "230398技能数据应存在")

        hybrid = self.dl.get_parsed_skill_data(230398)
        self.assertIsNotNone(hybrid, "230398 hybrid配置应存在")
        self.assertEqual(hybrid["trigger_type"], "on_cumulative_damage")
        # global_condition为condition_list组合: self_lacks_mark(深慮) + cumulative_damage_percent(>=20%)
        gc = hybrid["global_condition"]
        self.assertEqual(gc["type"], "condition_list")
        self.assertEqual(gc["mode"], "all")
        sub_marks = [c for c in gc["conditions"] if c.get("type") == "self_lacks_mark"]
        self.assertEqual(len(sub_marks), 1)
        self.assertEqual(sub_marks[0]["mark_name"], "深慮")
        sub_cumul = [c for c in gc["conditions"] if c.get("type") == "cumulative_damage_percent"]
        self.assertEqual(len(sub_cumul), 1)
        self.assertEqual(sub_cumul[0]["value"], 20, "累计伤害阈值应为20%")

        # 应有3个block
        self.assertEqual(len(hybrid["effect_blocks"]), 3)
        # block1: shield (无条件)
        # block2: cheat_death + mark(深慮) (HP<20%)
        # block3: level_min=5 + add_ep + cheat_death + mark(深慮) (HP<20%)
        block3 = next(b for b in hybrid["effect_blocks"] if b.get("block_id") == 3)
        self.assertEqual(block3.get("level_min"), 5, "block3 level_min应为5")

    def test_ps_230398_cheat_death_value(self):
        """PS(230398) cheat_death值为1.25%(敌方削弱版)"""
        hybrid = self.dl.get_parsed_skill_data(230398)
        # block2应有cheat_death effect，value=1.25
        block2 = next(b for b in hybrid["effect_blocks"] if b.get("block_id") == 2)
        cheat_death_effects = [e for e in block2["effects"] if e["effect_type"] == "cheat_death"]
        self.assertTrue(len(cheat_death_effects) > 0, "block2应有cheat_death effect")
        self.assertEqual(cheat_death_effects[0]["value"], 1.25, "cheat_death值应为1.25(敌方削弱版)")

    def test_ps_230398_enemy_skill_mapping(self):
        """PS(230398) 敌方技能映射正确"""
        enemy_skills = self.dl.load_enemy_skills()
        self.assertIn(722305, enemy_skills, "应存在722305敌方")
        self.assertIn(230398, enemy_skills[722305], "722305应包含230398技能")

    def test_ps_230398_blocked_by_deep_thought(self):
        """PS(230398) 自身持有深慮时不发动(global_condition: self_lacks_mark)"""
        # 给caster施加深慮mark
        self.caster.buffs.append(BuffState(
            buff_id="test_deep_thought", name="深慮",
            effect_type=MARK, value=0,
            duration=-1, timing_type=1,
        ))

        # 直接执行230398，验证shield未施加
        shield_before = len([b for b in self.caster.buffs if b.effect_type == SHIELD])
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=230398, battlefield=self.bf, skip_cost=True
        )
        shield_after = len([b for b in self.caster.buffs if b.effect_type == SHIELD])
        self.assertEqual(shield_before, shield_after,
                         "持有深慮时230398应不施加shield")
        # global_condition不满足时返回error
        self.assertIn("error", result, "持有深慮时230398应返回error")

    def test_ps_230398_shield_applied_when_no_deep_thought(self):
        """PS(230398) 无深慮时执行应施加shield"""
        # 确保无深慮
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]

        shield_before = len([b for b in self.caster.buffs if b.effect_type == SHIELD])
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=230398, battlefield=self.bf, skip_cost=True
        )
        shield_after = len([b for b in self.caster.buffs if b.effect_type == SHIELD])
        # block1无条件施加shield，应增加
        self.assertGreater(shield_after, shield_before,
                           "无深慮时230398应施加shield")

    def test_ps_230398_shield_value(self):
        """PS(230398) shield值正确(Lv10引用shield tag)"""
        # 确保无深慮
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=230398, battlefield=self.bf, skip_cost=True
        )
        # 验证shield被施加
        shield_buff = _find_aura(self.caster, SHIELD)
        self.assertIsNotNone(shield_buff, "应施加shield")
        # shield值来自tag，Lv10应引用shield tag的Lv3值0.63（因为只有L1和L3节点，Lv10使用最高可用节点）
        # shield value应为 max_hp * 0.63%
        # 这里只验证shield存在即可，具体值由tag解析决定

    def test_ps_230398_lv5_add_ep(self):
        """PS(230398) Lv5+ HP<20%时追加add_ep效果"""
        # 确保无深慮
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]
        # 设置HP<20%
        self.caster.current_hp = int(self.caster.max_hp * 0.15)  # 15% < 20%
        ep_before = self.caster.current_ep

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=230398, battlefield=self.bf, skip_cost=True
        )

        # Lv10应触发block3的add_ep效果
        # 验证深慮被施加（block2和block3都会施加深慮）
        deep_thought = _find_aura(self.caster, MARK, "深慮")
        self.assertIsNotNone(deep_thought, "HP<20%时应施加深慮mark")

        # 验证cheat_death被施加 (effect_type可能存为"cheat_death"或"CheatDeath")
        cheat_death_buffs = [b for b in self.caster.buffs + self.caster.debuffs
                             if b.effect_type in ("cheat_death", "CheatDeath")]
        self.assertGreater(len(cheat_death_buffs), 0, "HP<20%时应施加cheat_death")

    def test_ps_230398_hp_above_20_no_cheat_death(self):
        """PS(230398) HP>=20%时不施加cheat_death和深慮"""
        # 确保无深慮
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]
        # 设置HP>=20%
        self.caster.current_hp = int(self.caster.max_hp * 0.5)  # 50% >= 20%

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=230398, battlefield=self.bf, skip_cost=True
        )

        # 验证shield被施加（block1无条件）
        shield_buff = _find_aura(self.caster, SHIELD)
        self.assertIsNotNone(shield_buff, "HP>=20%时仍应施加shield")

        # 验证cheat_death未施加（block2/block3条件不满足）
        cheat_death_buffs = [b for b in self.caster.buffs + self.caster.debuffs
                             if b.effect_type in ("cheat_death", "CheatDeath")]
        self.assertEqual(len(cheat_death_buffs), 0, "HP>=20%时不应施加cheat_death")

        # 验证深慮未施加
        deep_thought = _find_aura(self.caster, MARK, "深慮")
        self.assertIsNone(deep_thought, "HP>=20%时不应施加深慮")

    def test_ps_230398_level_min_5_filter(self):
        """PS(230398) block3 level_min=5过滤正确"""
        hybrid = self.dl.get_parsed_skill_data(230398)
        block3 = next(b for b in hybrid["effect_blocks"] if b.get("block_id") == 3)
        self.assertEqual(block3.get("level_min"), 5, "block3 level_min应为5(敌方阈值)")

        # 验证Lv5+的add_ep效果存在
        add_ep_effects = [e for e in block3["effects"] if e["effect_type"] == "add_ep"]
        self.assertTrue(len(add_ep_effects) > 0, "block3应有add_ep effect")

    # ─── PS: 起死回生の一手 触发路径测试 ───

    def _make_trigger_service(self):
        """创建已注入data_loader的TriggerService"""
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        return ts

    def test_ps_230398_threshold_is_20_percent(self):
        """PS(230398) 累计伤害阈值应为20%(非10%)"""
        ts = self._make_trigger_service()
        threshold = ts._get_cumulative_damage_threshold(self.caster)
        self.assertIsNotNone(threshold, "应找到230398的累计伤害阈值")
        self.assertEqual(threshold, 20.0, "阈值应为20%%, 实际=%.1f" % threshold)

    def test_ps_230398_not_triggered_below_20_percent(self):
        """PS(230398) 累计伤害<20%最大HP时不触发(如115593/636919=18.2%<20%)"""
        # 模拟用户报告的场景: max_hp=636919, 伤害=115593 (18.2% < 20%)
        self.caster.max_hp = 636919
        self.caster.current_hp = 636919 - 115593
        self.caster.cumulative_hp_damage = 115593
        # 确保无深慮
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]

        ts = self._make_trigger_service()
        actions = ts.trigger_cumulative_damage(self.bf, damaged_units=[self.caster])
        # 115593 < 636919*20%=127384, 不应触发
        self.assertEqual(len(actions), 0, "累计伤害18.2%(<20%)不应触发起死回生の一手")

    def test_ps_230398_triggered_at_20_percent(self):
        """PS(230398) 累计伤害>=20%最大HP时触发"""
        # 累计伤害 = 20% max_hp = 127384
        self.caster.max_hp = 636919
        self.caster.current_hp = 636919 - 127384
        self.caster.cumulative_hp_damage = 127384
        # 确保无深慮
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]

        ts = self._make_trigger_service()
        actions = ts.trigger_cumulative_damage(self.bf, damaged_units=[self.caster])
        # 127384 >= 127384, 应触发
        self.assertGreater(len(actions), 0, "累计伤害=20%应触发起死回生の一手")

    def test_ps_230398_blocked_by_deep_thought_in_trigger(self):
        """PS(230398) 持有深慮时即使累计伤害>=20%也不触发(condition_list: self_lacks_mark)"""
        self.caster.max_hp = 636919
        self.caster.cumulative_hp_damage = 200000  # > 20%
        # 施加深慮mark
        self.caster.buffs.append(BuffState(
            buff_id="test_deep_thought", name="深慮",
            effect_type=MARK, value=0,
            duration=-1, timing_type=1,
        ))

        ts = self._make_trigger_service()
        actions = ts.trigger_cumulative_damage(self.bf, damaged_units=[self.caster])
        # 深慮存在, condition_list(self_lacks_mark + cumulative_damage_percent)不满足
        self.assertEqual(len(actions), 0, "持有深慮时不应触发起死回生の一手")

    def test_ps_230398_old_10pct_default_no_longer_applies(self):
        """PS(230398) 验证旧默认值10%不再生效: 15%伤害不应触发"""
        # 15% > 10%(旧默认) 但 < 20%(正确阈值)
        self.caster.max_hp = 636919
        self.caster.cumulative_hp_damage = int(636919 * 0.15)  # 95538 = 15%
        # 确保无深慮
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]

        ts = self._make_trigger_service()
        actions = ts.trigger_cumulative_damage(self.bf, damaged_units=[self.caster])
        # 15% < 20%, 不应触发(旧10%默认值会导致误触发)
        self.assertEqual(len(actions), 0, "累计伤害15%(>10%旧默认但<20%正确阈值)不应触发")


if __name__ == "__main__":
    unittest.main()
