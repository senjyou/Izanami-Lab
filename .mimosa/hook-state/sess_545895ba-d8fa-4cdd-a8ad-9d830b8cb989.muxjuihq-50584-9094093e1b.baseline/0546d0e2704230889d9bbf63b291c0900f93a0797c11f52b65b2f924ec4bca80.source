"""Regression: 追撃符 (130051) EnchantDamage buff duration bug.

Bug: add_damage_to_attack effect with duration=null results in duration=-1
(permanent) in _apply_aura. The EnchantDamage buff persists beyond the current
action instead of expiring at the end of the buffed unit's current action.

Fix: In _apply_aura, when add_damage_to_attack has null duration and
hit_limited > 0, set duration=1 and skip_restore=True. This ensures:
- If hit_limited consumes the buff during the attack → buff removed immediately
- If hit_limited is NOT consumed (e.g., AS skill deals no damage) → buff
  expires at end of current action via skip_restore bypassing just_applied
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType

ENCHANT_DAMAGE = SkillEffectType.ENCHANT_DAMAGE.value


class TestRegEnchantDamageDuration(unittest.TestCase):
    """追撃符 (130051) EnchantDamage buff should expire at end of current action."""

    def _setup_battlefield(self):
        """Create caster with 130051 and a front-row ally target."""
        bb = BattleBuilder()
        bb.add_ally(unit_id="caster", position=Position.ALLY_CENTER_BACK,
                    hp=20000, atk=10000, skills=[130051], level=10, pp=10)
        bb.add_ally(unit_id="target", position=Position.ALLY_CENTER_FRONT,
                    hp=20000, atk=10000, skills=[], level=10)
        bb.add_enemy(unit_id="enemy", position=Position.ENEMY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        return ctx

    def test_enchant_buff_duration_is_1_not_permanent(self):
        """EnchantDamage buff from add_damage_to_attack (hit_limited>0, null duration)
        should get duration=1, not -1 (permanent)."""
        ctx = self._setup_battlefield()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")

        result = ss.execute_skill(caster=caster, skill_id=130051, battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])

        target = next(u for u in bf.friend_team if u.unit_id == "target")
        enchant_buffs = [b for b in target.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchant_buffs), 1, "Should have 1 EnchantDamage buff")
        self.assertEqual(enchant_buffs[0].duration, 1,
                         "duration must be 1 (not -1/permanent) for hit_limited>0 enchant")

    def test_enchant_buff_has_skip_restore(self):
        """EnchantDamage buff should have skip_restore=True to bypass just_applied
        protection, ensuring decrement at end of current action."""
        ctx = self._setup_battlefield()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")

        result = ss.execute_skill(caster=caster, skill_id=130051, battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])

        target = next(u for u in bf.friend_team if u.unit_id == "target")
        buff = next(b for b in target.buffs if b.effect_type == ENCHANT_DAMAGE)
        self.assertTrue(getattr(buff, 'skip_restore', False),
                        "skip_restore must be True for hit_limited>0 enchant with null duration")

    def test_enchant_buff_removed_at_action_end(self):
        """EnchantDamage buff should be removed at end of current action
        even if hit_limited was not consumed (no attack happened)."""
        ctx = self._setup_battlefield()
        bf, ss, aus = ctx['bf'], ctx['ss'], ctx['aus']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")

        result = ss.execute_skill(caster=caster, skill_id=130051, battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])

        target = next(u for u in bf.friend_team if u.unit_id == "target")
        enchant_before = [b for b in target.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchant_before), 1, "Buff should exist before action end")

        # Simulate end of target's action
        aus.process_maneuver_end(target)
        aus.check_expiration(target, bf.get_all_units())

        enchant_after = [b for b in target.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchant_after), 0,
                         "EnchantDamage buff must be removed at end of current action")

    def test_enchant_buff_not_consumed_by_hit_limited_still_expires(self):
        """When hit_limited=1 is NOT consumed (no damage dealt),
        buff should still expire at end of current action via duration."""
        ctx = self._setup_battlefield()
        bf, ss, aus = ctx['bf'], ctx['ss'], ctx['aus']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")

        result = ss.execute_skill(caster=caster, skill_id=130051, battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])

        target = next(u for u in bf.friend_team if u.unit_id == "target")
        buff = next(b for b in target.buffs if b.effect_type == ENCHANT_DAMAGE)

        # Verify hit_limited is still 1 (not consumed, since no attack happened)
        self.assertEqual(buff.hit_limited, 1, "hit_limited should still be 1 (not consumed)")

        # End action without any attack
        aus.process_maneuver_end(target)
        aus.check_expiration(target, bf.get_all_units())

        # Buff should be gone via duration expiry, not hit_limited
        enchant_after = [b for b in target.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchant_after), 0,
                         "Buff should expire via duration even if hit_limited not consumed")

    def test_other_buffs_from_same_skill_have_normal_duration(self):
        """spd_down and crit_rate_up from 追撃符 should still have duration=1
        (these already had duration=1 in JSON, unaffected by the fix)."""
        ctx = self._setup_battlefield()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")

        result = ss.execute_skill(caster=caster, skill_id=130051, battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])

        target = next(u for u in bf.friend_team if u.unit_id == "target")
        spd_buffs = [b for b in target.debuffs if b.effect_type == SkillEffectType.STATUS_SPEED.value]
        if spd_buffs:
            self.assertEqual(spd_buffs[0].duration, 1, "spd_down duration should be 1")


if __name__ == '__main__':
    unittest.main()
