"""敌方283105 惨禍：榊野ヒイロ 专项E2E测试（同名己方115302的敌方版）

技能列表（5个，全部Lv10）:
- EX: 210126 ……私のこと、気になる？（敵単体 → 击杀后敵全体追加攻撃；敌方视角"敌"=friend_team）
- AS1: 220464 ブレイブバレット（回避不可+敵单+横1列解debuff3+闘志×1+实时加成，Lv5+附debuff无効/減傷；
      block1 active_level_max=4，Lv5-10 只走高级段，无双重生效）
- AS2: 220465 オーバーバースト（闘志>=4追加攻撃+Lv5+敌前卫；<4仅单体）
- PS1: 230494 エマージェンシーエイド（持闘志自身被单击傷>=maxHP0.75%→威力回復+解闘志1，Lv5+反撃）
- PS2: 230495 ファーストブランド+（回合开始先制最低HP敌+30%盾；无烙印、无once_per_battle、每回合发动）

覆盖维度:
1. EX 击杀后敌全体追加（敌方caster → 目标为friend_team）
2. AS1 闘志付与+实时atk加成+横1列(敌方侧)解debuff3；Lv10只走高级段（无重复buff）
3. AS2 闘志>=4追加+敌前卫；<4单体
4. PS1 0.75%阈值触发（回复+解闘志1+反撃）；低于阈值不触发
5. PS2 先制最低HP+30%盾；无烙印mark；第二回合再次发动
6. 配置校验（阈值/进阶块/无once_per_battle）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
CRIT_BONUS = SkillEffectType.CRITICAL_BONUS_MODIFICATION.value
MARK = SkillEffectType.MARK.value
SHIELD = SkillEffectType.SHIELD.value

TOUSHI = "闘志"
RAKUIN = "烙印"

EX_ID, AS1_ID, AS2_ID, PS1_ID, PS2_ID = 210126, 220464, 220465, 230494, 230495
ALL_SKILLS = [EX_ID, AS1_ID, AS2_ID, PS1_ID, PS2_ID]


def _mk_mark(name, source_id="src", stack=1):
    """生成一个mark BuffState（独立实例，模拟stackable mark叠加）。"""
    return BuffState(
        buff_id=f"{source_id}_mark_{name}_{id(name)}", name=name,
        effect_type=MARK, value=0, duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=source_id, source_skill_id=0, is_debuff=False,
        stack_count=stack, is_memory_buff=True,
    )


class TestActor283105(unittest.TestCase):

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()
        cls.dms = DamageService()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 敌方施法者（演习BOSS视角）
        self.caster = UnitState(
            unit_id="caster", name="惨禍ヒイロ", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=283105, level=10,
            element=1, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=5,
            skills=ALL_SKILLS,
            skill_levels={sid: 10 for sid in ALL_SKILLS},
            skill_cooldowns={},
        )
        # 敌方同排（横1列 debuff 解除目标）
        self.enemy_lf = self._mk_minion("enemy_lf", "敵左前", Position.ENEMY_LEFT_FRONT)
        self.enemy_rf = self._mk_minion("enemy_rf", "敵右前", Position.ENEMY_RIGHT_FRONT)
        # 敌方後排（前卫判定对照）
        self.enemy_cb = self._mk_minion("enemy_cb", "敵中後", Position.ENEMY_CENTER_BACK)
        # friend_team（敌方caster的攻击目标侧）
        self.ally_cf = self._mk_ally("ally_cf", "味方中前", Position.ALLY_CENTER_FRONT)
        self.ally_lf = self._mk_ally("ally_lf", "味方左前", Position.ALLY_LEFT_FRONT)
        self.ally_rf = self._mk_ally("ally_rf", "味方右前", Position.ALLY_RIGHT_FRONT)
        self.ally_cb = self._mk_ally("ally_cb", "味方中後", Position.ALLY_CENTER_BACK)

        self.bf.enemy_team = [self.caster, self.enemy_lf, self.enemy_rf, self.enemy_cb]
        self.bf.friend_team = [self.ally_cf, self.ally_lf, self.ally_rf, self.ally_cb]

        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs, damage_service=self.dms,
            aura_service=self.aus, status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _mk_minion(self, unit_id, name, position):
        return UnitState(
            unit_id=unit_id, name=name, side=Side.ENEMY,
            position=position, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    def _mk_ally(self, unit_id, name, position):
        return UnitState(
            unit_id=unit_id, name=name, side=Side.ALLY,
            position=position, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    def _reset(self, level=10):
        self.caster.current_hp = self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = 10
        self.caster.current_pp = 10
        self.caster.current_ep = 5
        self.caster.crit_counter = 0
        self.caster._damage_taken_in_action = 0
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = level
        for u in [self.enemy_lf, self.enemy_rf, self.enemy_cb]:
            u.current_hp = u.max_hp
            u.buffs = []
            u.debuffs = []
            u.is_alive = True
            u._damage_taken_in_action = 0
        for u in [self.ally_cf, self.ally_lf, self.ally_rf, self.ally_cb]:
            u.current_hp = u.max_hp
            u.buffs = []
            u.debuffs = []
            u.is_alive = True
            u._damage_taken_in_action = 0

    def _marks(self, unit, name=TOUSHI):
        return [b for b in unit.buffs + unit.debuffs
                if b.effect_type == MARK and b.name == name]

    def _toushi_count(self, unit):
        return sum(getattr(m, 'stack_count', 1) or 1 for m in self._marks(unit))

    # ─────────────── EX 210126 ───────────────

    def test_ex_210126_all_attack_on_kill(self):
        """EX: 敌方caster击杀friend_team单位后，对"敌全体"（=friend_team）追加攻击。"""
        self._reset()
        self.ally_cf.current_hp = 100
        hp_before = {u.unit_id: u.current_hp
                     for u in [self.ally_cf, self.ally_lf, self.ally_rf, self.ally_cb]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=EX_ID,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertEqual(self.ally_cf.current_hp, 0, "低血目标应被击杀")
        self.assertLess(self.ally_lf.current_hp, hp_before['ally_lf'],
                        "击杀后应对friend_team全体追加攻击")
        self.assertLess(self.ally_rf.current_hp, hp_before['ally_rf'])
        self.assertLess(self.ally_cb.current_hp, hp_before['ally_cb'])

    def test_ex_210126_no_extra_on_no_kill(self):
        """EX: 未击杀时不追加。"""
        self._reset()
        hp_before = {u.unit_id: u.current_hp
                     for u in [self.ally_lf, self.ally_rf, self.ally_cb]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=EX_ID,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertGreater(self.ally_cf.current_hp, 0, "满血目标不应被击杀")
        self.assertEqual(self.ally_lf.current_hp, hp_before['ally_lf'],
                         "未击杀时不追加")
        self.assertEqual(self.ally_cb.current_hp, hp_before['ally_cb'])

    # ─────────────── AS1 220464 ───────────────

    def _put_debuffs(self, unit, n):
        for i in range(n):
            unit.debuffs.append(BuffState(
                buff_id=f"db_{unit.unit_id}_{i}", name=f"debuff{i}",
                effect_type=RECEIVED_DAMAGE, value=10.0, duration=3,
                timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
                source_unit_id="ally_cf", source_skill_id=0, is_debuff=True,
            ))

    def test_as1_220464_row_cleanse_and_toushi_realtime(self):
        """AS1: 敌方caster横1列(敌方前排)解debuff3+闘志×1实时加成。"""
        self._reset()
        self._put_debuffs(self.enemy_lf, 3)
        atk_before = self.dms._calculate_final_stat(self.caster, "attack")
        result = self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertEqual(len(self.enemy_lf.debuffs), 0, "敌方侧横1列应解除3个debuff")
        self.assertEqual(self._toushi_count(self.caster), 1, "应获得闘志×1")
        atk_after = self.dms._calculate_final_stat(self.caster, "attack")
        self.assertEqual(atk_after, int(atk_before * 1.04), "闘志1个攻击力应+4%")

    def test_as1_220464_lv10_advanced_block_no_double(self):
        """AS1 Lv10: 只走高级段（min5），基础段(max4)不生效——无重复buff。"""
        self._reset()
        result = self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        immunes = [b for b in self.caster.buffs
                   if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertEqual(len(immunes), 1, "Lv10应恰好1个debuff_immune（基础段不重复生效）")
        downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(downs), 1, "Lv10应恰好1个被ダメ減（tag dmg Lv10=15）")

    def test_as1_220464_lv3_basic_block_only(self):
        """AS1 Lv3: 只走基础段（max4）——无debuff_immune/减伤。"""
        self._reset(level=3)
        result = self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertEqual(self._toushi_count(self.caster), 1, "基础段仍应有闘志×1")
        immunes = [b for b in self.caster.buffs
                   if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertEqual(len(immunes), 0, "Lv3不应有debuff_immune")
        downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(downs), 0, "Lv3不应有被ダメ減")

    # ─────────────── AS2 220465 ───────────────

    def test_as2_220465_toushi_ge4_front_row_extra(self):
        """AS2: 闘志>=4 → 威力2追加+敌前卫(friend_team前排)威力3；<4仅单体。"""
        self._reset()
        self.caster.buffs.append(_mk_mark(TOUSHI, "pre", 4))
        cf_before = self.ally_cf.current_hp
        lf_before = self.ally_lf.current_hp
        cb_before = self.ally_cb.current_hp
        result = self.ss.execute_skill(caster=self.caster, skill_id=AS2_ID,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        dmg_cf = cf_before - self.ally_cf.current_hp
        self.assertLess(self.ally_lf.current_hp, lf_before, "前卫(左前)应受威力3追击")
        self.assertEqual(self.ally_cb.current_hp, cb_before, "后排不应受追击")
        # <4 对比：仅单体威力，无追击
        self._reset()
        self.caster.buffs.append(_mk_mark(TOUSHI, "pre", 2))
        cf_before2 = self.ally_cf.current_hp
        lf_before2 = self.ally_lf.current_hp
        self.ss.execute_skill(caster=self.caster, skill_id=AS2_ID,
                              battlefield=self.bf, skip_cost=True)
        dmg_lt4 = cf_before2 - self.ally_cf.current_hp
        self.assertEqual(self.ally_lf.current_hp, lf_before2, "闘志<4时前卫不应受追击")
        self.assertGreater(dmg_cf, dmg_lt4, "闘志>=4时主目标伤害更高")

    # ─────────────── PS1 230494 ───────────────

    def _trigger_ps1(self, dmg):
        """模拟持闘志的敌方caster被攻击 dmg 点（单次）。"""
        self.caster._damage_taken_in_action = dmg
        actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.ally_cf, primary_target=self.caster,
        )
        return [a for a in actions if a.skill_id == PS1_ID]

    def test_ps1_230494_trigger_at_075pct_heal_remove_counter(self):
        """PS1: 持闘志自身受单击伤>=0.75%→回復+解闘志1+反撃。"""
        self._reset()
        for i in range(3):
            self.caster.buffs.append(_mk_mark(TOUSHI, f"pre_{i}", 1))
        self.caster.current_hp = int(self.caster.max_hp * 0.5)
        hp_before = self.caster.current_hp
        atk_before = self.ally_cf.current_hp
        dmg = int(self.caster.max_hp * 0.01)  # 1% >= 0.75%
        ps1 = self._trigger_ps1(dmg)
        self.assertGreater(len(ps1), 0, "受单击伤>=0.75%应触发")
        self.ss._execute_trigger_actions_inline(ps1, self.bf)
        expected_heal = int(self.caster.attack * 0.25)  # 威力 tag Lv10=25
        self.assertEqual(self.caster.current_hp - hp_before, expected_heal,
                         "回复量应为威力25%×攻击力")
        self.assertEqual(len(self._marks(self.caster)), 2, "应解除1个闘志")
        self.assertLess(self.ally_cf.current_hp, atk_before, "Lv10应反撃攻击者")

    def test_ps1_230494_no_trigger_below_075pct(self):
        """PS1: 受单击伤<0.75%不触发。"""
        self._reset()
        self.caster.buffs.append(_mk_mark(TOUSHI, "pre", 2))
        dmg = int(self.caster.max_hp * 0.005)  # 0.5% < 0.75%
        ps1 = self._trigger_ps1(dmg)
        self.assertEqual(len(ps1), 0, "受单击伤<0.75%不应触发")

    def test_ps1_230494_no_trigger_without_toushi(self):
        """PS1: 无闘志不触发。"""
        self._reset()
        dmg = int(self.caster.max_hp * 0.5)
        ps1 = self._trigger_ps1(dmg)
        self.assertEqual(len(ps1), 0, "无闘志不应触发")

    # ─────────────── PS2 230495 ───────────────

    def test_ps2_230495_preemptive_lowest_hp_shield_no_brand(self):
        """PS2: 回合开始先制打friend_team最低HP单位+30%盾；不施加烙印。"""
        self._reset()
        self.ally_cb.current_hp = int(self.ally_cb.max_hp * 0.1)  # 最低HP
        cf_before = self.ally_cf.current_hp
        cb_before = self.ally_cb.current_hp
        actions = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2 = [a for a in actions if a.skill_id == PS2_ID]
        self.assertGreater(len(ps2), 0, "回合开始应触发PS2")
        self.ss._execute_trigger_actions_inline(ps2, self.bf, trigger_timing="on_turn_start")
        self.assertLess(self.ally_cb.current_hp, cb_before, "应打最低HP的ally_cb")
        self.assertEqual(self.ally_cf.current_hp, cf_before, "不应打其他单位")
        # 敌方版无烙印
        rakuin = [b for b in self.ally_cb.buffs + self.ally_cb.debuffs
                  if b.effect_type == MARK and b.name == RAKUIN]
        self.assertEqual(len(rakuin), 0, "敌方版不应施加烙印mark")
        # 30% 伤盾
        self.assertGreater(self.caster.shield, 0, "应获得伤害30%的盾")

    def test_ps2_230495_every_turn_no_once_per_battle(self):
        """PS2: 无once_per_battle，第二回合再次发动。"""
        self._reset()
        actions = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2 = [a for a in actions if a.skill_id == PS2_ID]
        self.assertGreater(len(ps2), 0)
        self.ss._execute_trigger_actions_inline(ps2, self.bf, trigger_timing="on_turn_start")
        self.assertNotIn(PS2_ID, self.caster.once_per_battle_triggered,
                         "敌方版不应记录once_per_battle")
        # 第二回合
        self.bf.turn_number = 2
        self._clear_turn_state()
        actions2 = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2_2 = [a for a in actions2 if a.skill_id == PS2_ID]
        self.assertGreater(len(ps2_2), 0, "第二回合应再次发动")

    def _clear_turn_state(self):
        """清理由盾等状态影响的字段，避免干扰第二回合判定。"""
        self.caster.shield = 0
        for u in [self.ally_cf, self.ally_lf, self.ally_rf, self.ally_cb]:
            u.current_hp = u.max_hp
            u.buffs = []
            u.debuffs = []

    # ─────────────── 配置校验 ───────────────

    def test_config_validation(self):
        """配置校验: 敌方版阈值/进阶块/无once_per_battle。"""
        p126 = self.dl.get_parsed_skill_data(EX_ID)
        conds = [b['condition']['type'] if b.get('condition') else None
                 for b in p126['effect_blocks']]
        self.assertTrue(any(c and 'target_killed' in c for c in conds), "EX应有target_killed条件")

        p464 = self.dl.get_parsed_skill_data(AS1_ID)
        blocks = p464['effect_blocks']
        level_conds = [(b['condition']['type'], b['condition']['value'])
                       for b in blocks if b.get('condition')]
        self.assertIn(('active_level_max', 4), level_conds, "AS1基础段应为active_level_max 4")
        self.assertIn(('active_level_min', 5), level_conds, "AS1进阶段应为active_level_min 5")

        p465 = self.dl.get_parsed_skill_data(AS2_ID)
        front_effects = [e for b in p465['effect_blocks'] for e in b['effects']
                         if e.get('target_type') == 'enemy_front_row']
        self.assertTrue(front_effects, "AS2应有敌前卫追击")
        self.assertEqual(front_effects[0]['flags']['level_min'], 5, "前卫追击level_min应为5")

        p494 = self.dl.get_parsed_skill_data(PS1_ID)
        self.assertEqual(p494['trigger_type'], 'after_as_attacked')
        gc = p494.get('global_condition') or {}
        dtc = [c for c in gc.get('conditions', [])
               if c.get('type') == 'damage_taken_in_action_percent']
        self.assertEqual(len(dtc), 1, "PS1应有damage_taken_in_action_percent条件")
        self.assertEqual(dtc[0]['value'], 0.75, "敌方版受击阈值应为0.75%")
        counter = [e for b in p494['effect_blocks'] for e in b['effects']
                   if e.get('target_identifier') == 'trigger_attacker']
        self.assertTrue(counter, "PS1应有反击（trigger_attacker）")

        p495 = self.dl.get_parsed_skill_data(PS2_ID)
        self.assertIsNone(p495.get('once_per_battle'), "敌方PS2不应有once_per_battle")
        self.assertIsNone(p495.get('cooldown'), "敌方PS2不应有冷却")
        all_effects = [e for b in p495['effect_blocks'] for e in b['effects']]
        brands = [e for e in all_effects
                  if e.get('effect_type') == 'mark'
                  and (e.get('flags') or {}).get('mark_name') == RAKUIN]
        self.assertEqual(len(brands), 0, "敌方PS2不应有烙印mark效果")
        shields = [e for e in all_effects if e.get('effect_type') == 'shield_from_damage']
        self.assertTrue(shields and shields[0].get('value') == 30, "应有30%伤盾")
        lowest = [e for e in all_effects
                  if e.get('target_type') == 'enemy_single_lowest_hp_ratio']
        self.assertTrue(lowest, "应索敌最低HP比例单体")


if __name__ == '__main__':
    unittest.main()
