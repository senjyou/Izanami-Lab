"""Regression: クラッシュラッシュ (120064) burn bonus must be applied as
vulnerability (易伤/received_damage zone), NOT as an independent multiplier.

Bug: The 50% damage increase against burning targets was implemented as
bonus_type="power" (independent multiplier: final = base * 1.5 * received_mult),
but actual game behavior is a 50% vulnerability applied to the received
damage multiplier (易伤区: final = base * (received_mult + 0.5)).

Fix: Added bonus_type="received_damage" which adds a temporary dmg_taken_up
debuff (attack_limited=1, is_stackable=True) to the target before damage
calculation. This makes the bonus stack additively with other vulnerability
sources in the received_mult zone, and be consumed after the skill's attack.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType, AuraUpdateTiming
from src.entities_v2.unit_state import UnitState, BuffState


class TestRegCrashRushVulnZone(unittest.TestCase):
    """クラッシュラッシュ burn bonus must be in the vulnerability (易伤) zone."""

    @classmethod
    def setUpClass(cls):
        bb = BattleBuilder()
        # Caster: high ATK, level 15 (dmg tag = 50%)
        bb.add_ally(unit_id="caster", position=Position.ALLY_CENTER_FRONT,
                    hp=99999, atk=10000, speed=500, skills=[120064],
                    level=15, pp=10)
        # Target: high HP, low DEF for clear damage readings
        bb.add_enemy(unit_id="target", position=Position.ENEMY_CENTER_FRONT,
                     hp=999999, atk=1, defense=0, speed=100, level=15, pp=10)
        ctx = bb.build()
        cls.bf = ctx['bf']
        cls.ss = ctx['ss']
        cls.caster = next(u for u in cls.bf.friend_team if u.unit_id == "caster")
        cls.target = next(u for u in cls.bf.enemy_team if u.unit_id == "target")

    def setUp(self):
        """Reset target state before each test."""
        self.target.current_hp = self.target.max_hp
        self.target.debuffs = []
        self.target.buffs = []

    def _add_burn(self, target):
        """Add a burn (CONFLAGRATION) debuff to the target."""
        burn = BuffState(
            buff_id=f"burn_{target.unit_id}",
            name="炎上",
            effect_type=SkillEffectType.CONFLAGRATION.value,
            value=0,
            duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            is_debuff=True,
        )
        target.debuffs.append(burn)

    def _add_external_vuln(self, target, pct=30.0):
        """Add a pre-existing vulnerability (dmg_taken_up) debuff to the target."""
        vuln = BuffState(
            buff_id=f"ext_vuln_{target.unit_id}",
            name="ExternalVulnerability",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=pct,
            duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            is_debuff=True,
            is_stackable=True,
        )
        target.debuffs.append(vuln)

    def _deal_damage(self):
        """Execute クラッシュラッシュ and return the damage dealt.
        Caller is responsible for setting up target debuffs before calling."""
        hp_before = self.target.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120064,
            battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        return hp_before - self.target.current_hp

    def test_burn_bonus_applied_as_vulnerability(self):
        """With burn, damage should be higher than without burn."""
        # No burn
        dmg_no_burn = self._deal_damage()

        # Reset and add burn
        self.setUp()
        self._add_burn(self.target)
        dmg_with_burn = self._deal_damage()

        self.assertGreater(dmg_with_burn, dmg_no_burn,
                           "Burn target should take more damage from クラッシュラッシュ")

    def test_burn_bonus_stacks_additively_with_external_vulnerability(self):
        """The 50% burn bonus must stack ADDITIVELY with external vulnerability
        in the received_mult zone, not multiplicatively.

        - Independent multiplier (wrong): dmg = base * 1.5 * (1 + ext_vuln)
        - Vulnerability zone (correct):     dmg = base * (1 + 0.5 + ext_vuln)

        With ext_vuln=0.3 (30%):
        - Independent: base * 1.5 * 1.3 = base * 1.95
        - Vulnerability: base * 1.8

        Key: the burn bonus damage delta on top of ext_vuln should be
        SMALLER (additive: +50% of base) than without ext_vuln (multiplicative:
        would be +50% * 1.3 = +65% of base).
        """
        # 1. Base damage (no burn, no ext_vuln)
        self.setUp()
        dmg_base = self._deal_damage()

        # 2. Damage with only external vulnerability (no burn)
        self.setUp()
        self._add_external_vuln(self.target, pct=30.0)
        dmg_ext_vuln_only = self._deal_damage()

        # 3. Damage with only burn (no ext_vuln)
        self.setUp()
        self._add_burn(self.target)
        dmg_burn_only = self._deal_damage()

        # 4. Damage with burn + external vulnerability
        self.setUp()
        self._add_external_vuln(self.target, pct=30.0)
        self._add_burn(self.target)
        dmg_burn_and_ext = self._deal_damage()

        # Verify all damages are distinct (sanity checks)
        self.assertGreater(dmg_burn_only, dmg_base,
                           "Burn should increase damage")
        self.assertGreater(dmg_ext_vuln_only, dmg_base,
                           "External vulnerability should increase damage")
        self.assertGreater(dmg_burn_and_ext, dmg_burn_only,
                           "Burn + ext_vuln should be more than burn only")
        self.assertGreater(dmg_burn_and_ext, dmg_ext_vuln_only,
                           "Burn + ext_vuln should be more than ext_vuln only")

        # The key test: additive vs multiplicative
        # Additive (vulnerability zone):
        #   dmg_burn_and_ext = base * (1 + 0.5 + 0.3) = base * 1.8
        #   dmg_burn_only = base * (1 + 0.5) = base * 1.5
        #   dmg_ext_vuln_only = base * (1 + 0.3) = base * 1.3
        #   dmg_base = base * 1.0
        #   burn_delta_with_ext = dmg_burn_and_ext - dmg_ext_vuln_only = base * 0.5
        #   burn_delta_without_ext = dmg_burn_only - dmg_base = base * 0.5
        #   => burn_delta_with_ext == burn_delta_without_ext (additive)

        # Multiplicative (independent multiplier, wrong):
        #   dmg_burn_and_ext = base * 1.5 * 1.3 = base * 1.95
        #   dmg_burn_only = base * 1.5
        #   burn_delta_with_ext = base * 1.95 - base * 1.3 = base * 0.65
        #   burn_delta_without_ext = base * 1.5 - base = base * 0.5
        #   => burn_delta_with_ext > burn_delta_without_ext (multiplicative)

        burn_delta_with_ext = dmg_burn_and_ext - dmg_ext_vuln_only
        burn_delta_without_ext = dmg_burn_only - dmg_base

        # Additive: deltas should be approximately equal
        # Multiplicative: delta_with_ext should be ~30% larger
        self.assertAlmostEqual(burn_delta_with_ext, burn_delta_without_ext,
                               delta=burn_delta_without_ext * 0.05,
                               msg=f"Burn bonus should be additive (vulnerability zone): "
                                   f"burn_delta_with_ext={burn_delta_with_ext} should ≈ "
                                   f"burn_delta_without_ext={burn_delta_without_ext}")

    def test_temporary_vuln_consumed_after_skill(self):
        """The temporary vulnerability debuff must be consumed (attack_limited=1)
        after the skill execution, so it doesn't persist on the target."""
        self._add_burn(self.target)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120064,
            battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        # The temporary ConditionalVulnerability debuff should NOT persist
        vuln_debuffs = [d for d in self.target.debuffs
                        if d.name == "ConditionalVulnerability"]
        self.assertEqual(len(vuln_debuffs), 0,
                         "Temporary vulnerability debuff should be consumed "
                         "after skill execution (attack_limited=1)")

        # The original burn debuff should still be there (not consumed by attack_limited)
        burn_debuffs = [d for d in self.target.debuffs
                        if d.effect_type == SkillEffectType.CONFLAGRATION.value]
        self.assertEqual(len(burn_debuffs), 1,
                         "Original burn debuff should NOT be consumed by attack_limited")


if __name__ == '__main__':
    unittest.main()
