#!/usr/bin/env python
# -*- coding: utf-8 -*-
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))
from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()

# 查找角色132301的技能
with open('split_data/CharacterSkillMaster.json', 'r', encoding='utf-8') as f:
    char_skills = json.load(f)

skills = [x for x in char_skills if x['CharacterMasterId'] == 132301]
safe_print(f"Found {len(skills)} skills for character 132301:")
for s in skills:
    safe_print(f"  Skill ID: {s['SkillMasterId']}")
