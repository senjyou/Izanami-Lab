"""Regression: after_as_attacked counterattack PS must trigger被攻撃反応
(after_self_attacked / after_ally_attacked) on its damaged targets.

Bug: 捲土重来 (130046, after_as_attacked) counterattacks enemy 霞光, but
     若雷 (enemy, holds 若ノ再生 230383, after_ally_attacked) never fires heal
     on 霞光. Root cause: 'after_as_attacked' was NOT in
     _ACTIVE_ATTACK_TRIGGER_TYPES, so _trigger_being_attacked_reactions was
     never called for the counterattack damage.

Fix: Added 'after_as_attacked' to _ACTIVE_ATTACK_TRIGGER_TYPES in
     battle_flow_controller.py. Counterattack is an active attack and should
     trigger被攻撃反応, consistent with on_skill_use_count / on_critical /
     after_as_attack / after_ally_as_attack.

Recursion safety: after_as_attacked反击 → _trigger_being_attacked_reactions
     → after_self_attacked/after_ally_attacked. The latter two are NOT in
     _ACTIVE_ATTACK_TRIGGER_TYPES, so they do not re-trigger
     _trigger_being_attacked_reactions. Chain terminates.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.battle_flow_controller import BattleFlowController


# Skill IDs
GANDO_CHORAI = 130046       # 捲土重来 (after_as_attacked, counterattack)
WAKANE_SEISEI = 230383      # 若ノ再生 (after_ally_attacked, heal ally)
ENEMY_ALL_AS = 220369       # 紫影の斬撃 (AS true AoE)
GAISEN_KYOKA = 230029       # 外殻強化 (after_self_attacked, def_up to self)

HEAL_EFFECT = SkillEffectType.HEAL.value
DEF_UP = SkillEffectType.STATUS_DEFENSE.value


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ap=10):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


class TestRegAfterAsAttackedTriggersReactions(unittest.TestCase):
    """after_as_attacked counterattack PS must trigger被攻撃反応
    (after_self_attacked / after_ally_attacked) on damaged targets."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_controller(self, bf):
        controller = BattleFlowController(bf, data_loader=self.dl)
        controller._build_display_names()
        controller.skill_service.set_battlefield(bf)
        controller._deferred_crit_triggers = []
        return controller

    def _get_damaged_targets(self, result, bf):
        """Extract damaged target units from skill_result."""
        damaged = []
        for applied in result.get("effects_applied", []):
            if applied.get("effect_type") == "damage":
                for t in applied.get("targets", []):
                    for u in bf.get_all_units():
                        if u.unit_id == t.get('target_id', t.get('target')):
                            damaged.append(u)
        return damaged

    def test_after_as_attacked_is_in_active_attack_trigger_types(self):
        """Config check: 'after_as_attacked' must be in _ACTIVE_ATTACK_TRIGGER_TYPES."""
        self.assertIn(
            'after_as_attacked',
            BattleFlowController._ACTIVE_ATTACK_TRIGGER_TYPES,
            "after_as_attacked must be in _ACTIVE_ATTACK_TRIGGER_TYPES so that "
            "counterattack PS triggers被攻撃反応 on its targets"
        )

    def test_counterattack_triggers_after_ally_attacked_heal(self):
        """捲土重来 (after_as_attacked) counterattack must trigger若ノ再生
        (after_ally_attacked) heal on the counterattacked enemy.

        Setup:
        - Ally holder (捲土重来) at ALLY_LEFT_FRONT
        - Ally filler at ALLY_RIGHT_FRONT (so true AoE hits 2 allies)
        - Enemy attacker (霞光, true AoE AS) at ENEMY_CENTER_FRONT
        - Enemy healer (若雷, 若ノ再生) at ENEMY_RIGHT_BACK

        Flow:
        1. Enemy AS attacks allies → holder is primary target
        2. trigger_after_as_attacked → 捲土重来 counterattacks 霞光
        3. _execute_trigger_actions runs 捲土重来 → damages 霞光
        4. _trigger_being_attacked_reactions → after_ally_attacked
        5. 若ノ再生 triggers → heals 霞光

        Verify: 若雷 PP consumed (若ノ再生 cost=1) and 霞光 healed.
        """
        holder = _make_unit("holder", "厳格(捲土重来)", Side.ALLY,
                            Position.ALLY_LEFT_FRONT, hp=200000, atk=10000,
                            skills=[GANDO_CHORAI],
                            skill_levels={GANDO_CHORAI: 10})
        ally2 = _make_unit("ally2", "友方2", Side.ALLY,
                           Position.ALLY_RIGHT_FRONT, hp=100000, atk=100)
        attacker = _make_unit("attacker", "霞光", Side.ENEMY,
                              Position.ENEMY_CENTER_FRONT, hp=500000, atk=5000,
                              skills=[ENEMY_ALL_AS],
                              skill_levels={ENEMY_ALL_AS: 10})
        healer = _make_unit("healer", "若雷(若ノ再生)", Side.ENEMY,
                            Position.ENEMY_RIGHT_BACK, hp=200000, atk=10000,
                            skills=[WAKANE_SEISEI],
                            skill_levels={WAKANE_SEISEI: 10})

        bf = BattlefieldState()
        bf.friend_team = [holder, ally2]
        bf.enemy_team = [attacker, healer]
        controller = self._make_controller(bf)

        attacker_hp_before_as = attacker.current_hp
        healer_pp_before = healer.current_pp

        # 1. Enemy AS attacks allies
        result = controller.skill_service.execute_skill(
            caster=attacker, skill_id=ENEMY_ALL_AS, battlefield=bf,
            skip_cost=True,
        )
        self.assertTrue(result.get('success'), "AS execution should succeed")

        damaged_allies = self._get_damaged_targets(result, bf)
        self.assertGreater(len(damaged_allies), 0, "Allies should be damaged")

        # 2. Trigger after_as_attacked (捲土重来)
        original_primary = getattr(controller.skill_service,
                                   '_original_primary_target', None)
        primary_target = original_primary if original_primary else damaged_allies[0]
        after_as_actions = controller.trigger_service.trigger_after_as_attacked(
            damaged_allies, bf, actor=attacker, primary_target=primary_target
        )
        gando_actions = [a for a in after_as_actions if a.skill_id == GANDO_CHORAI]
        self.assertGreater(len(gando_actions), 0,
                           "捲土重来 should trigger from after_as_attacked")

        # 3. Execute 捲土重来 counterattack
        controller._execute_trigger_actions(gando_actions, attacker)

        # 4. Verify counterattack damaged 霞光
        # Note: 若ノ再生 may have healed 霞光, so check HP delta differently.
        # We verify via PP consumption instead (若ノ再生 cost=1).
        self.assertEqual(healer.current_pp, healer_pp_before - 1,
                         "若雷 PP should be consumed by 若ノ再生 "
                         "(triggered by 捲土重来 counterattack on 霞光). "
                         "Before=%d, After=%d" % (healer_pp_before, healer.current_pp))

    def test_counterattack_stun_blocks_after_self_attacked(self):
        """捲土重来 (after_as_attacked) counterattack applies stun (Knockout)
        to the target. Since stun is applied during execute_skill (before
        _trigger_being_attacked_reactions runs), the stunned target's
        after_self_attacked PS (外殻強化) is correctly skipped.

        This test verifies:
        1. The counterattack damages 霞光 (precondition)
        2. 霞光 is stunned (Knockout debuff applied)
        3. 外殻強化 (after_self_attacked) does NOT fire (def_up buff absent)
           because owner is stunned

        This is correct game behavior: stun from counterattack prevents
        the counterattacked unit's after_self_attacked PS from firing.
        The fix (adding 'after_as_attacked' to _ACTIVE_ATTACK_TRIGGER_TYPES)
        still correctly calls _trigger_being_attacked_reactions, but the
        stunned owner is skipped by _execute_trigger_actions.
        """
        holder = _make_unit("holder", "厳格(捲土重来)", Side.ALLY,
                            Position.ALLY_LEFT_FRONT, hp=200000, atk=10000,
                            skills=[GANDO_CHORAI],
                            skill_levels={GANDO_CHORAI: 10})
        ally2 = _make_unit("ally2", "友方2", Side.ALLY,
                           Position.ALLY_RIGHT_FRONT, hp=100000, atk=100)
        attacker = _make_unit("attacker", "霞光(外殻強化)", Side.ENEMY,
                              Position.ENEMY_CENTER_FRONT, hp=500000, atk=5000,
                              skills=[ENEMY_ALL_AS, GAISEN_KYOKA],
                              skill_levels={ENEMY_ALL_AS: 10, GAISEN_KYOKA: 10})

        bf = BattlefieldState()
        bf.friend_team = [holder, ally2]
        bf.enemy_team = [attacker]
        controller = self._make_controller(bf)

        attacker_hp_before = attacker.current_hp

        # Execute AS
        result = controller.skill_service.execute_skill(
            caster=attacker, skill_id=ENEMY_ALL_AS, battlefield=bf,
            skip_cost=True,
        )
        damaged_allies = self._get_damaged_targets(result, bf)
        self.assertGreater(len(damaged_allies), 0)

        # Trigger after_as_attacked
        original_primary = getattr(controller.skill_service,
                                   '_original_primary_target', None)
        primary_target = original_primary if original_primary else damaged_allies[0]
        after_as_actions = controller.trigger_service.trigger_after_as_attacked(
            damaged_allies, bf, actor=attacker, primary_target=primary_target
        )
        gando_actions = [a for a in after_as_actions if a.skill_id == GANDO_CHORAI]
        self.assertGreater(len(gando_actions), 0,
                           "捲土重来 should trigger")

        # Clear pre-existing buffs/debuffs on attacker
        attacker.buffs.clear()
        attacker.debuffs.clear()

        # Execute 捲土重来 counterattack
        controller._execute_trigger_actions(gando_actions, attacker)

        # 1. Counterattack damaged 霞光
        self.assertLess(attacker.current_hp, attacker_hp_before,
                        "捲土重来 counterattack should damage 霞光")

        # 2. 霞光 is stunned (Knockout debuff applied by 捲土重来)
        knockout_debuffs = [d for d in attacker.debuffs
                            if d.effect_type == SkillEffectType.KNOCKOUT.value]
        self.assertGreater(len(knockout_debuffs), 0,
                           "霞光 should be stunned (Knockout) by 捲土重来")

        # 3. 外殻強化 (after_self_attacked) does NOT fire because 霞光 is stunned
        def_up_buffs = [b for b in attacker.buffs if b.effect_type == DEF_UP]
        self.assertEqual(len(def_up_buffs), 0,
                         "外殻強化 (after_self_attacked) should NOT fire because "
                         "霞光 is stunned by 捲土重来's counterattack. "
                         "Stun is applied during execute_skill, before "
                         "_trigger_being_attacked_reactions runs.")

    def test_no_recursion_counterattack_chain_terminates(self):
        """Recursion safety: after_as_attacked反击 → after_ally_attacked
        (non-attack heal) → chain terminates.

        This test verifies that adding 'after_as_attacked' to
        _ACTIVE_ATTACK_TRIGGER_TYPES does not cause infinite recursion.
        若ノ再生 (after_ally_attacked) is a heal PS (not attack), so it does
        not re-trigger _trigger_being_attacked_reactions.
        """
        holder = _make_unit("holder", "厳格(捲土重来)", Side.ALLY,
                            Position.ALLY_LEFT_FRONT, hp=200000, atk=10000,
                            skills=[GANDO_CHORAI],
                            skill_levels={GANDO_CHORAI: 10})
        ally2 = _make_unit("ally2", "友方2", Side.ALLY,
                           Position.ALLY_RIGHT_FRONT, hp=100000, atk=100)
        attacker = _make_unit("attacker", "霞光", Side.ENEMY,
                              Position.ENEMY_CENTER_FRONT, hp=500000, atk=5000,
                              skills=[ENEMY_ALL_AS],
                              skill_levels={ENEMY_ALL_AS: 10})
        healer = _make_unit("healer", "若雷(若ノ再生)", Side.ENEMY,
                            Position.ENEMY_RIGHT_BACK, hp=200000, atk=10000,
                            skills=[WAKANE_SEISEI],
                            skill_levels={WAKANE_SEISEI: 10})

        bf = BattlefieldState()
        bf.friend_team = [holder, ally2]
        bf.enemy_team = [attacker, healer]
        controller = self._make_controller(bf)

        # Execute AS
        result = controller.skill_service.execute_skill(
            caster=attacker, skill_id=ENEMY_ALL_AS, battlefield=bf,
            skip_cost=True,
        )
        damaged_allies = self._get_damaged_targets(result, bf)

        # Trigger after_as_attacked
        original_primary = getattr(controller.skill_service,
                                   '_original_primary_target', None)
        primary_target = original_primary if original_primary else damaged_allies[0]
        after_as_actions = controller.trigger_service.trigger_after_as_attacked(
            damaged_allies, bf, actor=attacker, primary_target=primary_target
        )
        gando_actions = [a for a in after_as_actions if a.skill_id == GANDO_CHORAI]

        # This should complete without infinite recursion
        controller._execute_trigger_actions(gando_actions, attacker)

        # If we reached here, no recursion occurred
        # Verify 若ノ再生 triggered exactly once (PP consumed by 1)
        self.assertEqual(healer.current_pp, 9,
                         "若ノ再生 should trigger exactly once (PP 10→9), "
                         "no recursion loop")


if __name__ == '__main__':
    unittest.main()
