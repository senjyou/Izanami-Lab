"""Regression: 清廉なる一撃 primary target mark independently consumes 1 evasion layer.

Bug: Skill 清廉なる一撃 (120148/220372) has damage + mark(浮足) with target_type=
     "attacked_targets". When the target evaded all damage, the mark was
     skipped by _skill_evaced_targets, so the mark was never applied. This
     caused subsequent skills relying on the mark (e.g. 衣擦れの調べ 210099's
     atk_down conditioned on target_has_mark 浮足) to not trigger.

Fix: This is a game bug simulation. Only 清廉なる一撃's mark on the PRIMARY target
     (enemy_single_furthest) is NOT bound to the preceding damage — it bypasses
     the _skill_evaded_targets skip and falls through to the normal per-debuff
     evasion check, independently consuming 1 evasion layer.

     - Primary target with remaining evasion → mark evaded (consumes 1 layer)
     - Primary target with no remaining evasion → mark applied
     - Adjacent sub-targets: mark is still skipped by _skill_evaded_targets (normal)
     - Other skills' marks: still skipped by _skill_evaded_targets (normal)
     - Non-mark debuffs (atk_down etc.): still skipped (normal)
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

MARK = SkillEffectType.MARK.value
EVADE = SkillEffectType.EVADE.value
SEIKEI_NO_ICHIGEKI = 220372  # 清廉なる一撃 (enemy version: damage + mark 浮足)
UWASURE_NO_SHIRABE = 210099  # 衣擦れの調べ (damage + atk_down condition: target_has_mark 浮足)


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=6000,
               defense=0, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=10, current_ep=10,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_evade_buff(unit, hit_limited=1):
    """Add an evasion buff to a unit with the given number of hits."""
    buff = BuffState(
        buff_id=f"test_evade_{unit.unit_id}",
        name="回避", effect_type=EVADE, value=0.0,
        duration=-1, timing_type=0,
        source_unit_id=unit.unit_id,
        source_skill_id=0,
        is_debuff=False, is_stackable=False, is_memory_buff=False,
        hit_limited=hit_limited,
    )
    unit.buffs.append(buff)
    return buff


def _make_mark_buff(source_id, mark_name="浮足"):
    """Create a 浮足 mark buff for pre-applying to a target."""
    return BuffState(
        buff_id=f"test_mark_{mark_name}_{source_id}",
        name=mark_name, effect_type=MARK, value=1.0,
        duration=-1, timing_type=2,
        source_unit_id=source_id,
        source_skill_id=SEIKEI_NO_ICHIGEKI,
        is_debuff=True, is_stackable=True, is_memory_buff=False,
    )


class TestRegSeikeiPrimaryMarkEvasion(unittest.TestCase):
    """清廉なる一撃 primary target mark must independently consume 1 evasion layer."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    def _setup_single_target(self, *, evade_layers=0):
        """Single ally target (primary target, no adjacent targets)."""
        caster = _make_unit("enemy_caster", "施法者", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT, hp=100000, atk=6000,
                            skills=[SEIKEI_NO_ICHIGEKI],
                            skill_levels={SEIKEI_NO_ICHIGEKI: 10})
        target = _make_unit("ally_target", "目標", Side.ALLY,
                            Position.ALLY_CENTER_BACK, hp=100000, atk=1000)

        if evade_layers > 0:
            _make_evade_buff(target, hit_limited=evade_layers)

        bf = BattlefieldState()
        bf.friend_team = [target]
        bf.enemy_team = [caster]
        ss, _ = self._make_services(bf)
        return caster, target, bf, ss

    def _setup_multi_target(self, *, primary_evade=0, adjacent_evade=0):
        """Three ally targets: primary (LEFT_BACK, furthest from ENEMY_CENTER_FRONT)
        + 2 adjacent (CENTER_BACK and LEFT_FRONT, both adjacent to LEFT_BACK).
        Adjacent target that gets evasion is CENTER_BACK."""
        caster = _make_unit("enemy_caster", "施法者", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT, hp=100000, atk=6000,
                            skills=[SEIKEI_NO_ICHIGEKI],
                            skill_levels={SEIKEI_NO_ICHIGEKI: 10})
        # ALLY_LEFT_BACK is the highest-priority furthest target from ENEMY_CENTER_FRONT
        primary = _make_unit("ally_primary", "主目標", Side.ALLY,
                             Position.ALLY_LEFT_BACK, hp=100000, atk=1000)
        # Adjacent to ALLY_LEFT_BACK: ALLY_CENTER_BACK (1,1) and ALLY_LEFT_FRONT (0,0)
        adj1 = _make_unit("ally_adj1", "副目標1", Side.ALLY,
                          Position.ALLY_CENTER_BACK, hp=100000, atk=1000)
        adj2 = _make_unit("ally_adj2", "副目標2", Side.ALLY,
                          Position.ALLY_LEFT_FRONT, hp=100000, atk=1000)

        if primary_evade > 0:
            _make_evade_buff(primary, hit_limited=primary_evade)
        if adjacent_evade > 0:
            _make_evade_buff(adj1, hit_limited=adjacent_evade)

        bf = BattlefieldState()
        bf.friend_team = [primary, adj1, adj2]
        bf.enemy_team = [caster]
        ss, _ = self._make_services(bf)
        return caster, primary, adj1, adj2, bf, ss

    # ─── Test 1: Primary, 1 evasion layer → damage evaded, mark applied ───

    def test_primary_one_evade_layer_mark_applied(self):
        """清廉なる一撃 primary target with 1 evasion layer:
        damage evaded (consumes 1 layer), mark has no more layers → mark IS applied."""
        caster, target, bf, ss = self._setup_single_target(evade_layers=1)

        hp_before = target.current_hp
        ss.execute_skill(caster, SEIKEI_NO_ICHIGEKI, bf, skip_cost=True)

        self.assertEqual(target.current_hp, hp_before,
                         "HP should be unchanged (damage evaded)")

        evade_buffs = [b for b in target.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evade_buffs), 0,
                         "Evasion buff should be fully consumed by damage evasion")

        marks = [d for d in target.debuffs if d.effect_type == MARK and d.name == "浮足"]
        self.assertGreater(len(marks), 0,
                           "Mark 浮足 should be applied (no evasion layers remaining for mark)")

    # ─── Test 2: Primary, 2 evasion layers → damage evaded, mark also evaded ───

    def test_primary_two_evade_layers_mark_evaded(self):
        """清廉なる一撃 primary target with 2 evasion layers:
        damage evaded (consumes 1 layer), mark independently triggers evasion
        (consumes 1 layer) → mark IS evaded."""
        caster, target, bf, ss = self._setup_single_target(evade_layers=2)

        hp_before = target.current_hp
        ss.execute_skill(caster, SEIKEI_NO_ICHIGEKI, bf, skip_cost=True)

        self.assertEqual(target.current_hp, hp_before,
                         "HP should be unchanged (damage evaded)")

        evade_buffs = [b for b in target.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evade_buffs), 0,
                         "Evasion buff should be fully consumed (2 layers: damage + mark)")

        marks = [d for d in target.debuffs if d.effect_type == MARK and d.name == "浮足"]
        self.assertEqual(len(marks), 0,
                         "Mark 浮足 should NOT be applied (evaded by 2nd evasion layer)")

    # ─── Test 3: Primary, no evasion → damage hits, mark applied ───

    def test_primary_no_evade_mark_applied(self):
        """清廉なる一撃 primary target with no evasion: damage hits, mark applied."""
        caster, target, bf, ss = self._setup_single_target(evade_layers=0)

        hp_before = target.current_hp
        ss.execute_skill(caster, SEIKEI_NO_ICHIGEKI, bf, skip_cost=True)

        self.assertLess(target.current_hp, hp_before,
                        "HP should be reduced (no evasion)")

        marks = [d for d in target.debuffs if d.effect_type == MARK and d.name == "浮足"]
        self.assertGreater(len(marks), 0,
                           "Mark 浮足 should be applied (no evasion to block it)")

    # ─── Test 4: Adjacent target with evasion → mark IS skipped (normal behavior) ───

    def test_adjacent_target_evasion_mark_skipped(self):
        """清廉なる一撃 adjacent sub-target with 1 evasion layer:
        damage evaded → mark is SKIPPED by _skill_evaded_targets (normal behavior).
        Only the primary target gets the special mark treatment."""
        caster, primary, adj1, adj2, bf, ss = self._setup_multi_target(
            primary_evade=0, adjacent_evade=1
        )

        adj_hp_before = adj1.current_hp
        ss.execute_skill(caster, SEIKEI_NO_ICHIGEKI, bf, skip_cost=True)

        # Adjacent target should have evaded damage
        self.assertEqual(adj1.current_hp, adj_hp_before,
                         "Adjacent target HP should be unchanged (damage evaded)")

        # Evasion buff should be consumed by damage evasion
        adj_evade_buffs = [b for b in adj1.buffs if b.effect_type == EVADE]
        self.assertEqual(len(adj_evade_buffs), 0,
                         "Adjacent target evasion buff should be consumed by damage")

        # Mark should NOT be applied to adjacent target (normal skip behavior)
        adj_marks = [d for d in adj1.debuffs if d.effect_type == MARK and d.name == "浮足"]
        self.assertEqual(len(adj_marks), 0,
                         "Mark 浮足 should NOT be applied to adjacent target "
                         "(normal _skill_evaded_targets skip, no special treatment)")

        # Primary target (no evasion) should have mark applied normally
        primary_marks = [d for d in primary.debuffs if d.effect_type == MARK and d.name == "浮足"]
        self.assertGreater(len(primary_marks), 0,
                           "Mark 浮足 should be applied to primary target (no evasion, damage hit)")

    # ─── Test 5: Non-mark debuff still skipped when damage evaded ───

    def test_non_mark_debuff_skipped_when_damage_evaded(self):
        """When damage is evaded, non-mark debuffs (like atk_down) should
        still be skipped by _skill_evaded_targets.

        Uses 衣擦れの調べ (210099): damage + atk_down(condition: target_has_mark).
        Pre-apply 浮足 mark so the condition passes, then verify atk_down is
        still skipped when damage is evaded."""
        caster = _make_unit("enemy_caster", "施法者", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT, hp=100000, atk=6000,
                            skills=[UWASURE_NO_SHIRABE],
                            skill_levels={UWASURE_NO_SHIRABE: 10})
        target = _make_unit("ally_target", "目標", Side.ALLY,
                            Position.ALLY_CENTER_BACK, hp=100000, atk=1000)
        target.debuffs.append(_make_mark_buff(caster.unit_id))
        _make_evade_buff(target, hit_limited=1)

        bf = BattlefieldState()
        bf.friend_team = [target]
        bf.enemy_team = [caster]
        ss, _ = self._make_services(bf)

        hp_before = target.current_hp
        ss.execute_skill(caster, UWASURE_NO_SHIRABE, bf, skip_cost=True)

        self.assertEqual(target.current_hp, hp_before,
                         "HP should be unchanged (damage evaded)")

        atk_downs = [d for d in target.debuffs
                     if d.effect_type == SkillEffectType.STATUS_ATTACK.value
                     and d.is_debuff]
        self.assertEqual(len(atk_downs), 0,
                         "atk_down should NOT be applied (non-mark debuff skipped when damage evaded)")


if __name__ == '__main__':
    unittest.main(verbosity=2)
