#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
4v4 完整战斗日志脚本 - 用于检查所有触发点和战斗逻辑
输出: battle_4v4_log.txt
"""

import sys
import io
import logging
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillType
from src.combat_v2.battle_flow_controller import BattleFlowController
from src.combat_v2.skill_data_resolver import SkillDataResolver
from src.data.data_loader import DataLoader
from src.combat_v2.battle_logger import get_logger

OUTPUT_FILE = Path(__file__).parent / "battle_4v4_log.txt"

FRIENDS = [110301, 121301, 132301, 114301]
ENEMIES = [112301, 113301, 111301, 117302]

STYPE_MAP = {1: "AS", 2: "PS", 3: "EX"}


def setup_file_logging(append=False):
    mode = 'a' if append else 'w'
    logger = get_logger("MGGBattleSim")
    for h in list(logger.handlers):
        if isinstance(h, logging.FileHandler):
            logger.removeHandler(h)
    fh = logging.FileHandler(str(OUTPUT_FILE), mode=mode, encoding='utf-8')
    fh.setLevel(logging.DEBUG)
    fh.setFormatter(logging.Formatter(
        "[%(levelname)-5s] %(asctime)s | %(message)s",
        datefmt="%H:%M:%S",
    ))
    logger.addHandler(fh)
    return logger


def create_unit(data_loader, char_id, side, pos):
    char = data_loader.get_character_by_id(char_id)
    if not char:
        return None
    char_skills = data_loader.load_character_skills()
    skills = char_skills.get(char_id, [])
    lvl = 200
    lerp = data_loader.load_level_lerp_data().get(lvl, 1.0)
    ms, xs = char.min_level_stats, char.max_level_stats
    side_prefix = "F" if side == Side.ALLY else "E"
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}",
        name=char.name,
        side=side,
        position=pos,
        character_id=char_id,
        level=lvl,
        element=char.attribute,
        character_type=char.character_type,
        max_hp=int(ms.hp + (xs.hp - ms.hp) * lerp),
        current_hp=int(ms.hp + (xs.hp - ms.hp) * lerp),
        attack=int(ms.attack + (xs.attack - ms.attack) * lerp),
        defense=int(ms.defense + (xs.defense - ms.defense) * lerp),
        speed=int(ms.speed + (xs.speed - ms.speed) * lerp),
        crit_rate=ms.crit_rate + (xs.crit_rate - ms.crit_rate) * lerp,
        crit_damage=0.0,
        advantage_damage=0.0,
        initial_active_point=char.action_point,
        initial_passive_point=char.passive_point,
        max_extra_point=8,
        current_ap=char.action_point,
        current_pp=char.passive_point,
        current_ep=0,
        skills=skills,
        skill_cooldowns={},
        role_type=getattr(char, 'role_type', 0),
        position_type=getattr(char, 'position_type', 3),
    )


def print_full_panel(data_loader, resolver, side_label, char_ids):
    buf = []
    buf.append(f"\n{'='*70}")
    buf.append(f"  {side_label}")
    buf.append(f"{'='*70}")

    char_skills = data_loader.load_character_skills()
    lvl = 200
    lerp = data_loader.load_level_lerp_data().get(lvl, 1.0)

    for cid in char_ids:
        char = data_loader.get_character_by_id(cid)
        if not char:
            continue
        ms, xs = char.min_level_stats, char.max_level_stats
        hp = int(ms.hp + (xs.hp - ms.hp) * lerp)
        atk = int(ms.attack + (xs.attack - ms.attack) * lerp)
        defense = int(ms.defense + (xs.defense - ms.defense) * lerp)
        spd = int(ms.speed + (xs.speed - ms.speed) * lerp)
        crit = ms.crit_rate + (xs.crit_rate - ms.crit_rate) * lerp

        buf.append(f"\n  [{cid}] {char.name}  Lv.{lvl}")
        buf.append(f"    属性: ELEM={char.attribute} TYPE={char.character_type}")
        buf.append(f"    面板: HP={hp} ATK={atk} DEF={defense} SPD={spd}")
        buf.append(f"    暴击: CRIT_RATE={crit:.2%} CRIT_DMG=0.0% ADV_DMG=0.0%")
        buf.append(f"    资源: AP={char.action_point} PP={char.passive_point} EP=0/8")

        skills = char_skills.get(cid, [])
        buf.append(f"    技能({len(skills)}):")
        for sid in skills:
            resolved = resolver.resolve(sid, 1)
            meta = data_loader.get_skill_by_id(sid)
            if resolved and meta:
                st = STYPE_MAP.get(meta.skill_type, "??")
                buf.append(f"      [{st}] {resolved.name} (id={sid})")
                buf.append(f"          cost={meta.resource_cost} cd={meta.cooldown} cd_update={meta.cooldown_update_timing}")
                buf.append(f"          power={resolved.power:.1f} hits={resolved.hit_count or 1} element={resolved.element or char.attribute}")
                buf.append(f"          trigger_type={resolved.trigger_type or '—'} ignore_def={resolved.ignore_defense} ignore_shield={resolved.ignore_shield}")
                buf.append(f"          effect_blocks={len(resolved.effect_blocks)}")
                if resolved.global_condition:
                    buf.append(f"          global_condition: {resolved.global_condition}")

    return '\n'.join(buf)


def main():
    data_loader = DataLoader()
    data_loader.load_all()
    resolver = SkillDataResolver(data_loader)

    characters = data_loader.load_characters()
    skills = data_loader.load_skills()
    parsed = data_loader.load_parsed_skills()

    with open(OUTPUT_FILE, 'w', encoding='utf-8') as f:
        f.write("=" * 70 + "\n")
        f.write("  MGGBattleSimulation - 4v4 完整战斗日志\n")
        f.write("=" * 70 + "\n")

        f.write(f"\n  数据加载状态:\n")
        f.write(f"    角色: {len(characters)} 个\n")
        f.write(f"    技能: {len(skills)} 个\n")
        f.write(f"    解析技能效果: {len(parsed)} 个\n")

        f.write(print_full_panel(data_loader, resolver, "我方阵容 (FRIEND)", FRIENDS))
        f.write(print_full_panel(data_loader, resolver, "敌方阵容 (ENEMY)", ENEMIES))

        f.write(f"\n{'='*70}\n")
        f.write(f"  战斗开始 - 以下为实时日志\n")
        f.write(f"{'='*70}\n")
        f.flush()

    setup_file_logging(append=True)

    positions_f = [
        Position.ALLY_CENTER_FRONT, Position.ALLY_LEFT_FRONT,
        Position.ALLY_RIGHT_FRONT, Position.ALLY_CENTER_BACK,
    ]
    positions_e = [
        Position.ENEMY_CENTER_FRONT, Position.ENEMY_LEFT_FRONT,
        Position.ENEMY_RIGHT_FRONT, Position.ENEMY_CENTER_BACK,
    ]

    bf = BattlefieldState()
    friends, enemies = [], []

    for i, cid in enumerate(FRIENDS):
        u = create_unit(data_loader, cid, Side.ALLY, positions_f[i])
        if u:
            bf.add_unit(u)
            friends.append(u)

    for i, cid in enumerate(ENEMIES):
        u = create_unit(data_loader, cid, Side.ENEMY, positions_e[i])
        if u:
            bf.add_unit(u)
            enemies.append(u)

    controller = BattleFlowController(bf, data_loader=data_loader)
    result = controller.execute_battle()

    with open(OUTPUT_FILE, 'a', encoding='utf-8') as f:
        f.write(f"\n{'='*70}\n")
        f.write(f"  战斗结果\n")
        f.write(f"{'='*70}\n")
        f.write(f"  结果: {result['result']} | 回合: {result['total_turns']} | 胜者: {result['winner']}\n")
        f.write(f"  battlefield.turn_number={bf.turn_number} round_number={bf.round_number} total_actions={bf.total_actions}\n")
        f.write(f"\n  我方:\n")
        for u in friends:
            alive = "存活" if u.is_alive else "阵亡"
            f.write(f"    {u.name} [{alive}] HP={u.current_hp}/{u.max_hp} | 伤害={u.damage_dealt_total} | 行动={u.action_count_total} | 技能次数={sum(u.skill_use_count.values())}\n")
        f.write(f"\n  敌方:\n")
        for u in enemies:
            alive = "存活" if u.is_alive else "阵亡"
            f.write(f"    {u.name} [{alive}] HP={u.current_hp}/{u.max_hp} | 伤害={u.damage_dealt_total} | 行动={u.action_count_total} | 技能次数={sum(u.skill_use_count.values())}\n")
        f.write("=" * 70 + "\n")

    logger = get_logger("MGGBattleSim")
    logger.handlers.clear()
    print(f"\n日志已输出至: {OUTPUT_FILE}")


if __name__ == "__main__":
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')
    main()