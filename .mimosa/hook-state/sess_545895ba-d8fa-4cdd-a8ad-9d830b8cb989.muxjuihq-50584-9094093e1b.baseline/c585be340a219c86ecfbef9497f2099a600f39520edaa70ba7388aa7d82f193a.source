    def test_ps1_creates_sub_unit_and_kensaku_mark(self):
        """PS1(130133) 触发后: 自身mark[研鑽] + sub_unit[ドルズィヤⅡ, HP=shield%maxHP, 1action]。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.caster.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={"knockout"},
        )

        ps1_actions = [a for a in actions if a.skill_id == 130133]
        self.assertGreater(len(ps1_actions), 0, "PS1应触发")

        # 执行PS1
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_debuff_applied"
        )

        # 验证研鑽 mark
        marks = [b for b in self.caster.buffs
                 if b.effect_type == MARK and b.name == "研鑽"]
        self.assertEqual(len(marks), 1, "PS1应施加1个研鑽mark到自身")
        self.assertFalse(marks[0].is_debuff, "研鑽mark应为buff")

        # 验证 sub_unit「ドルズィヤⅡ」
        sub_units = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(sub_units), 1, "应创建1个sub_unit")
        su = sub_units[0]
        self.assertEqual(su.name, "ドルズィヤⅡ", "sub_unit名应为ドルズィヤⅡ")
        # HP = caster.max_hp × shield%(Lv10: 25%) = 20000 × 0.25 = 5000
        self.assertEqual(su.sub_unit_max_hp, 5000,
                         "sub_unit HP应为5000(Lv10 shield%=25% × max_hp)")
        self.assertEqual(su.duration, 1, "sub_unit duration应为1(1action)")
        self.assertEqual(su.timing_type, DURABLE_TARGET_MANEUVER_END,
                         "duration_type=action → timing_type=DURABLE_TARGET_MANEUVER_END(2)")

