"""角色144301 輝ける次代の娘 专项E2E测试（sub_unit + mark全链机制）

技能列表：
- EX: 110058 ぺたぺた雪だるま（敵単体(highest_atk)攻撃[威力] + 1行動気絶(knockout)
  + 自身mark[研鑽, is_buff_mark, stackable] + 自身sub_unit[ドルズィヤⅣ, 2action, HP=25%maxHP, atk%追加]）
- AS1: 120129 システマ・ヴラシェーニヤΩ（Block1 研鑽>=3 → 自身dmg_dealt_up[50%, 1hit]
  ; Block2 無条件: 敵単体(highest_spd)攻撃[威力] + spd_down[15fixed, -1turn, stackable]
    + メトカmark + 自身sub_unit[ドルズィヤⅠ, 1action]
  ; Block3 研鑽>=3 → remove_mark[研鑽, remove_all]
  ; Block4 Lv11+: 敵単体(highest_spd) dmg_dealt_down[dmg%, 1action, target_has_mark(メトカ)]）
- PS1: 130133 ヴォルコワの血脈Ω（on_debuff_applied + is_status_ailment
  ; 自身被付与状態異常時触发: 自身mark[研鑽] + 自身sub_unit[ドルズィヤⅡ, 1action, HP=shield%maxHP, atk%追加]
  ; 戦闘開始時・ターン開始/終了時不触发）
- PS2: 130134 隙ありです……！（on_debuff_applied + debuff_type=knockout
  ; 敵被付与気絶(knockout)時触发: 敵単体(debuff_applied_target)攻撃[威力]
    + 自身mark[研鑽] + 自身sub_unit[ドルズィヤⅢ, 1action, HP=25%maxHP, atk%追加]
  ; 戦闘開始時・ターン開始/終了時不触发）
- PS3: 130135 お母様、見ててください……！（on_skill_use_count + skill_use_count_modulo=3
  ; count_skill_types=[2](PS only), exclude_skill_ids=[130135]
  ; Block1 自身: atk_up[atk%, -1turn, stackable] + crit_dmg_up[crtdmg%, -1turn, stackable]
  ; Block2 Lv11+: 味方全員(ally_all) spd_up[spd fixed, -1turn, stackable]）

覆盖维度：
1. EX highest_atk索敌 + knockout気絶 + 研鑽mark(buff) + sub_unit创建
2. AS1 highest_spd索敌 + 研鑽mark_count>=3条件分支(Block1/3) + メトカmark(debuff)
   + target_has_mark(メトカ)快照检查(规则11.13) + remove_mark(remove_all)
   + spd_down(fixed) + sub_unit创建
3. PS1 on_debuff_applied + is_status_ailment条件(自身被状态异常时触发) + 排除戦闘開始/ターン開始/終了
4. PS2 on_debuff_applied + debuff_type=knockout条件(敵被赋予knockout時触发) + debuff_applied_target索敌
5. PS3 on_skill_use_count + skill_use_count_modulo=3 + count_skill_types=[2] + exclude_skill_ids
6. sub_unit 专项(6+用例)：HP计算(25%/shield%)、duration/timing、caster_attack快照、atk% from value_tag、stackable多实例、4种ドルズィヤ命名
7. mark 全链专项(6+用例)：研鑽(buff)/メトカ(debuff)区分、mark_count per-target独立(规则11.17)、
   remove_mark(remove_all)、target_has_mark快照(规则11.13)、mark_count<阈值跳过、PS1/PS2/EX/AS1 mark施加
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction, TriggerTiming
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# atk_up/atk_down 共用 STATUS_ATTACK 枚举
# crit_dmg_up/crit_dmg_down 共用 CRITICAL_BONUS_MODIFICATION
# dmg_dealt_up/dmg_dealt_down 共用 DEALT_DAMAGE
# spd_up/spd_down 共用 STATUS_SPEED
# mark 用 MARK 枚举（buff mark 进 buffs 列表，debuff mark 进 debuffs 列表）
# knockout 用 KNOCKOUT 枚举（気絶，进 debuffs 列表）
# sub_unit 用 SUB_UNIT 枚举（进 buffs 列表）
MARK = SkillEffectType.MARK.value
KNOCKOUT = SkillEffectType.KNOCKOUT.value
SUB_UNIT = SkillEffectType.SUB_UNIT.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
CRITICAL_BONUS_MODIFICATION = SkillEffectType.CRITICAL_BONUS_MODIFICATION.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
STATUS_SPEED = SkillEffectType.STATUS_SPEED.value

# AuraUpdateTiming 数值（用于断言 sub_unit 的 timing_type）
# 实际值: EPHEMERAL_SKILL_END=1, EPHEMERAL_MANEUVER_END=2,
#         DURABLE_SOURCE_MANEUVER_END=3, DURABLE_TARGET_MANEUVER_END=4,
#         DURABLE_WHEN_USED_ONCE_PER_SKILL=5, DURABLE_WHEN_USED=6
DURABLE_TARGET_MANEUVER_END = AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value   # 4: duration_type="action" 映射
DURABLE_SOURCE_MANEUVER_END = AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value   # 3: duration_type="turn" 映射


class TestActor144301(unittest.TestCase):
    """角色144301 輝ける次代の娘 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 144301 輝ける次代の娘 (土属性attr=4, 敏捷型character_type=3, 后排position_type=2, 控制role_type=5)
        # 默认Lv10，部分测试用Lv15验证Lv11+分支
        # caster 放后排中央（highest_atk/highest_spd 索敌选敌方）
        self.caster = UnitState(
            unit_id="caster", name="輝ける次代の娘", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=144301, level=10,
            element=4, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110058, 120129, 130133, 130134, 130135],
            skill_levels={110058: 10, 120129: 10, 130133: 10,
                          130134: 10, 130135: 10},
            skill_cooldowns={},
        )

        # 敌方前排中央（highest_atk/highest_spd 候选）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（highest_atk: 攻击力最高，最高HP；highest_spd 测试用）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=12000, defense=5000, speed=380,  # 攻击力最高
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（highest_spd: 速度最高）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=4500, speed=600,  # 速度最高
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.is_stunned = False
        self.caster.is_frozen = False
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.skill_use_count = {}
        self.caster.level = 10
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.is_stunned = False
            e.is_frozen = False
            e.current_ap = 4

    def _apply_kensaku_mark(self, target=None, count=1):
        """为指定目标附加「研鑽」mark buff（is_buff_mark=true → buffs 列表，is_debuff=False）。

        144301 的核心 buff mark：研鑽 驱动 AS1 Block1/Block3 条件分支。
        通常由 EX/PS1/PS2 付与自身。
        """
        if target is None:
            target = self.caster
        for i in range(count):
            target.buffs.append(BuffState(
                buff_id=f"test_kensaku_{id(target)}_{i}",
                name="研鑽", effect_type=MARK, value=0,
                duration=-1, timing_type=2, is_debuff=False,
                unremovable=False,
            ))

    def _apply_metoca_mark(self, target, count=1):
        """为指定敌方附加「メトカ」mark debuff（is_buff_mark 未设 → debuffs 列表，is_debuff=True）。

        144301 AS1 Block2 付与敌方メトカmark，Block4 (Lv11+) 用 target_has_mark(メトカ) 检查。
        """
        for i in range(count):
            target.debuffs.append(BuffState(
                buff_id=f"test_metoca_{id(target)}_{i}",
                name="メトカ", effect_type=MARK, value=0,
                duration=-1, timing_type=2, is_debuff=True,
                unremovable=False,
            ))

    def _apply_knockout_debuff(self, target):
        """为指定目标附加「knockout」状态异常debuff（気絶，进 debuffs 列表）。"""
        target.debuffs.append(BuffState(
            buff_id=f"test_knockout_{id(target)}",
            name="Knockout", effect_type=KNOCKOUT, value=0,
            duration=1, timing_type=2, is_debuff=True,
            unremovable=False,
        ))
        target.is_stunned = True

    # ════════════════════════════════════════════════════════════════
    # EX: 110058 ぺたぺた雪だるま
    # ════════════════════════════════════════════════════════════════

    def test_ex_targets_highest_atk_enemy(self):
        """EX(110058) Block1: highest_atk 索敌选择攻击力最高的敌方(enemy_lf atk=12000)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp  # atk=12000 最高
        hp_rf_before = self.enemy_rf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_lf (atk最高) 应受到伤害
        self.assertLess(self.enemy_lf.current_hp, hp_lf_before,
                        "enemy_lf(攻击力最高)应受到EX伤害")
        # 其他敌人不应受到伤害
        self.assertEqual(self.enemy_cf.current_hp, hp_cf_before,
                         "enemy_cf(非最高atk)不应受到EX伤害")
        self.assertEqual(self.enemy_rf.current_hp, hp_rf_before,
                         "enemy_rf(非最高atk)不应受到EX伤害")

    def test_ex_applies_knockout_to_target(self):
        """EX(110058) Block1: 对攻击目标施加 1行動 knockout(気絶)debuff。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_lf (主目标) 应被赋予 knockout debuff
        knockouts = [d for d in self.enemy_lf.debuffs if d.effect_type == KNOCKOUT]
        self.assertGreater(len(knockouts), 0, "enemy_lf应被赋予knockout(気絶)debuff")
        self.assertEqual(knockouts[0].duration, 1, "knockout duration应为1(1行動)")

    def test_ex_grants_kensaku_mark_to_self(self):
        """EX(110058) Block1: 自身付与「研鑽」mark(is_buff_mark=true → buffs列表, stackable)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证研鑽 mark 在 buffs 列表（is_buff_mark=true → is_debuff=False）
        marks = [b for b in self.caster.buffs
                 if b.effect_type == MARK and b.name == "研鑽"]
        self.assertEqual(len(marks), 1, "应施加1个研鑽mark")
        self.assertFalse(marks[0].is_debuff, "研鑽mark应为buff（is_debuff=False）")
        self.assertTrue(marks[0].is_stackable, "研鑽mark应可叠加(stackable=true)")
        self.assertEqual(marks[0].duration, -1, "研鑽mark duration应为-1(永続)")

    def test_ex_creates_sub_unit_doruziya_iv(self):
        """EX(110058) Block1: 自身付与 sub_unit「ドルズィヤⅣ」(HP=25%maxHP, 2action, atk%追加)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 sub_unit buff
        sub_units = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(sub_units), 1, "应创建1个sub_unit buff")
        su = sub_units[0]
        self.assertEqual(su.name, "ドルズィヤⅣ", "sub_unit名应为ドルズィヤⅣ")
        # HP = caster.max_hp × 25% = 20000 × 0.25 = 5000
        self.assertEqual(su.sub_unit_max_hp, 5000, "sub_unit HP应为5000(max_hp×25%)")
        self.assertEqual(su.sub_unit_hp, 5000, "sub_unit当前HP应为5000(满)")
        # duration=2 action → timing_type=DURABLE_TARGET_MANEUVER_END(2)
        self.assertEqual(su.duration, 2, "sub_unit duration应为2(2action)")
        self.assertEqual(su.timing_type, DURABLE_TARGET_MANEUVER_END,
                         "duration_type=action → timing_type=DURABLE_TARGET_MANEUVER_END(2)")
        # caster_attack = 快照 = caster.attack (无buff时=10000)
        self.assertEqual(su.caster_attack, 10000, "sub_unit caster_attack应为快照攻击力(10000)")
        # value = atk% (Lv10: 23.4%)
        self.assertAlmostEqual(su.value, 23.4, delta=0.5,
                               msg="sub_unit value应为atk%(Lv10≈23.4%)")
        # is_stackable=True（多实例可共存）
        self.assertTrue(su.is_stackable, "sub_unit应可叠加(stackable=true)")
        # is_debuff=False（buff，进buffs列表）
        self.assertFalse(su.is_debuff, "sub_unit应为buff（is_debuff=False）")

    def test_ex_sub_unit_atk_pct_value_tag_resolved(self):
        """EX(110058) sub_unit的value字段来自value_tag="atk"解析（Lv10: 23.4%）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        sub_units = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(sub_units), 1)
        # 验证 value 通过 value_tag="atk" 解析为实际数值（Lv10 atk=23.4）
        self.assertGreater(sub_units[0].value, 0, "sub_unit value应通过value_tag解析为正数")

    # ════════════════════════════════════════════════════════════════
    # AS1: 120129 システマ・ヴラシェーニヤΩ
    # ════════════════════════════════════════════════════════════════

    def test_as1_block2_targets_highest_spd_enemy(self):
        """AS1(120129) Block2: highest_spd 索敌选择速度最高的敌方(enemy_rf spd=600)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp  # spd=600 最高

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_rf (spd最高) 应受到伤害
        self.assertLess(self.enemy_rf.current_hp, hp_rf_before,
                        "enemy_rf(速度最高)应受到AS1 Block2伤害")
        # 其他敌人不应受到伤害
        self.assertEqual(self.enemy_cf.current_hp, hp_cf_before,
                         "enemy_cf(非最高spd)不应受到AS1 Block2伤害")
        self.assertEqual(self.enemy_lf.current_hp, hp_lf_before,
                         "enemy_lf(非最高spd)不应受到AS1 Block2伤害")

    def test_as1_block2_applies_spd_down_and_metoca_mark(self):
        """AS1(120129) Block2: 对主目标施加 spd_down(15fixed, -1turn, stackable) + メトカmark(debuff)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_rf 应被赋予 spd_down debuff
        spd_downs = [d for d in self.enemy_rf.debuffs if d.effect_type == STATUS_SPEED]
        self.assertGreater(len(spd_downs), 0, "enemy_rf应有spd_down debuff")
        self.assertEqual(spd_downs[0].value, 15.0, "spd_down value应为15(fixed)")
        self.assertEqual(spd_downs[0].duration, -1, "spd_down duration应为-1(永続turn)")
        self.assertTrue(spd_downs[0].is_stackable, "spd_down应可叠加(stackable=true)")

        # enemy_rf 应被赋予 メトカ mark debuff（is_buff_mark 未设 → debuffs列表）
        metoca_marks = [d for d in self.enemy_rf.debuffs
                        if d.effect_type == MARK and d.name == "メトカ"]
        self.assertEqual(len(metoca_marks), 1, "应施加1个メトカmark debuff")
        self.assertTrue(metoca_marks[0].is_debuff, "メトカmark应为debuff（is_debuff=True）")

    def test_as1_block2_creates_sub_unit_doruziya_i(self):
        """AS1(120129) Block2: 自身付与 sub_unit「ドルズィヤⅠ」(1action, HP=25%maxHP)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        sub_units = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(sub_units), 1, "应创建1个sub_unit buff")
        su = sub_units[0]
        self.assertEqual(su.name, "ドルズィヤⅠ", "sub_unit名应为ドルズィヤⅠ")
        self.assertEqual(su.duration, 1, "sub_unit duration应为1(1action)")
        self.assertEqual(su.sub_unit_max_hp, 5000, "sub_unit HP应为5000(max_hp×25%)")
        self.assertEqual(su.timing_type, DURABLE_TARGET_MANEUVER_END,
                         "duration_type=action → timing_type=DURABLE_TARGET_MANEUVER_END(2)")

    def test_as1_block1_skipped_without_kensaku_mark(self):
        """AS1(120129) Block1: 无研鑽mark时跳过(mark_count 研鑽>=3 不满足)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 不施加研鑽mark

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block1 dmg_dealt_up(self, 50%, hit, hit_limited=1) 不应被施加
        dmg_ups = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_ups), 0, "无研鑽mark时Block1应跳过，无dmg_dealt_up buff")

    def test_as1_block1_dmg_dealt_up_with_kensaku_3(self):
        """AS1(120129) Block1: 研鑽>=3时执行 dmg_dealt_up(self, 50%, 1hit)。

        注意: dmg_dealt_up duration_type=hit, duration=1 → 在Block2的damage效果中消耗。
        所以执行完成后 buff 已被移除（hit_limited=1 reach 0 → EXPIRED）。
        本测试通过对比"有/无研鑽"时Block2造成的伤害来验证Block1确实执行了dmg_dealt_up(50%)。
        """
        # 场景1: 无研鑽mark → Block1跳过 → Block2 base damage（dealt_mult=1.0）
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_no_mark = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_no_mark["success"])
        dmg_no_mark = result_no_mark.get("total_damage", 0)

        # 场景2: 3个研鑽mark → Block1执行 dmg_dealt_up(50%) → Block2 damage boosted by 50%
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_kensaku_mark(self.caster, count=3)
        result_with_mark = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_with_mark["success"])
        dmg_with_mark = result_with_mark.get("total_damage", 0)

        # 验证: 有研鑽时伤害应约为无研鑽时的1.5倍（dmg_dealt_up 50% 加成）
        self.assertGreater(dmg_with_mark, 0, "Block2应造成伤害")
        self.assertGreater(dmg_no_mark, 0, "Block2 base damage应>0")
        ratio = dmg_with_mark / dmg_no_mark
        self.assertAlmostEqual(ratio, 1.5, delta=0.05,
                               msg=f"3研鑽→dmg_dealt_up(50%)→伤害应×1.5，实际: {dmg_with_mark}/{dmg_no_mark}={ratio:.3f}")

    def test_as1_block3_remove_all_kensaku_after_threshold(self):
        """AS1(120129) Block3: 研鑽>=3时 remove_mark(研鑽, remove_all=true) 清除所有研鑽。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 预设4个研鑽mark
        self._apply_kensaku_mark(self.caster, count=4)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block3 应执行：remove_mark(研鑽, remove_all=true) → 研鑽 mark 应被全部移除
        remaining_kensaku = [b for b in self.caster.buffs
                             if b.effect_type == MARK and b.name == "研鑽"]
        # 研鑽 mark 应被清除（remove_all=true 移除所有4个）
        # 注意：Block3 在 Block2 之后执行，且条件检查在快照中（_marks_at_start_by_unit），
        # 所以 Block3 会基于执行前的快照判断（4个研鑽 >= 3）→ 触发 remove_all
        self.assertEqual(len(remaining_kensaku), 0,
                         f"研鑽>=3时Block3应remove_all，研鑽mark应全部清除，实际: {len(remaining_kensaku)}")

    def test_as1_block3_skipped_below_threshold(self):
        """AS1(120129) Block3: 研鑽<3时跳过（不执行 remove_mark）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 预设2个研鑽mark（<3）
        self._apply_kensaku_mark(self.caster, count=2)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 研鑽 mark 应保留（Block3 跳过，未执行 remove_all）
        remaining_kensaku = [b for b in self.caster.buffs
                             if b.effect_type == MARK and b.name == "研鑽"]
        self.assertEqual(len(remaining_kensaku), 2,
                         "研鑽<3时Block3应跳过，研鑽mark应保留2个")

    def test_as1_block4_lv10_skipped(self):
        """AS1(120129) Block4: Lv10时跳过（active_level_min=11 未满足）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[120129] = 10
        # 即使目标有メトカmark，Block4也不应执行
        self._apply_metoca_mark(self.enemy_rf)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
