    # PS3: 130135 お母様、見ててください……！
    # ════════════════════════════════════════════════════════════════

    def test_ps3_triggers_after_3_ps_uses(self):
        """PS3(130135) on_skill_use_count + skill_use_count_modulo=3: PS技能使用3次后触发。

        count_skill_types=[2]（仅PS计入），exclude_skill_ids=[130135]（自身不计入）。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 模拟3次PS使用（如PS1/PS2各被使用若干次）
        self.caster.skill_use_count = {130133: 2, 130134: 1}  # 合计3次

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)

        ps3_actions = [a for a in trigger_actions if a.skill_id == 130135]
        self.assertGreater(len(ps3_actions), 0, "PS使用3次后PS3应触发")

    def test_ps3_not_triggers_before_3_ps_uses(self):
        """PS3(130135) PS技能使用2次时不触发（<3）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.skill_use_count = {130133: 1, 130134: 1}  # 合计2次

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)

        ps3_actions = [a for a in trigger_actions if a.skill_id == 130135]
        self.assertEqual(len(ps3_actions), 0, "PS使用2次(<3)时PS3不应触发")

    def test_ps3_excludes_self_from_count(self):
        """PS3(130135) exclude_skill_ids=[130135]: 自身(130135)不计入skill_use_count。

        场景：130135使用3次 + 无其他PS → 不应触发（计数=0，<3）。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.skill_use_count = {130135: 5}  # 仅130135自身使用，应被排除

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)

        ps3_actions = [a for a in trigger_actions if a.skill_id == 130135]
        self.assertEqual(len(ps3_actions), 0,
                         "130135自身被exclude_skill_ids排除，计数=0→不应触发")

    def test_ps3_excludes_as_from_count(self):
        """PS3(130135) count_skill_types=[2]: AS技能(skill_type=1)不计入。

        场景：AS1(120129, skill_type=1)使用3次 → 不应触发（count_skill_types=[2]仅PS）。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 120129 是 AS(skill_type=1)，不应被计入
        self.caster.skill_use_count = {120129: 3}

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)

        ps3_actions = [a for a in trigger_actions if a.skill_id == 130135]
        self.assertEqual(len(ps3_actions), 0,
                         "AS技能(skill_type=1)不被count_skill_types=[2]计入→不应触发")

    def test_ps3_grants_atk_up_and_crit_dmg_up(self):
        """PS3(130135) Block1: 自身 atk_up + crit_dmg_up(-1turn, stackable, 永続)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.skill_use_count = {130133: 3}

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)

        ps3_actions = [a for a in trigger_actions if a.skill_id == 130135]
        self.assertGreater(len(ps3_actions), 0, "PS3应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_skill_use_count"
        )

        # 验证 atk_up buff
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "应有atk_up buff")
        self.assertTrue(atk_ups[0].is_stackable, "atk_up应可叠加(stackable=true)")
        self.assertEqual(atk_ups[0].duration, -1, "atk_up duration应为-1(永続turn)")

        # 验证 crit_dmg_up buff
        crit_dmg_ups = [b for b in self.caster.buffs
                        if b.effect_type == CRITICAL_BONUS_MODIFICATION]
        self.assertGreater(len(crit_dmg_ups), 0, "应有crit_dmg_up buff")
        self.assertTrue(crit_dmg_ups[0].is_stackable, "crit_dmg_up应可叠加")
        self.assertEqual(crit_dmg_ups[0].duration, -1, "crit_dmg_up duration应为-1(永続turn)")

    def test_ps3_lv10_no_spd_up_for_allies(self):
        """PS3(130135) Lv10 Block2 跳过（active_level_min=11 未满足）→ 无 spd_up。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[130135] = 10
        self.caster.skill_use_count = {130133: 3}

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)

        ps3_actions = [a for a in trigger_actions if a.skill_id == 130135]
        self.assertGreater(len(ps3_actions), 0, "PS3应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_skill_use_count"
        )

        # Lv10 时 Block2 跳过 → 无 spd_up buff
        spd_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_SPEED]
        self.assertEqual(len(spd_ups), 0, "Lv10时Block2应跳过，无spd_up buff")

    # ════════════════════════════════════════════════════════════════
    # Sub_unit 专项验证（6+ 用例）
    # ════════════════════════════════════════════════════════════════

    def test_sub_unit_hp_25pct_for_ex_as1_ps2(self):
        """sub_unit HP 计算: EX/AS1/PS2 的 sub_unit_hp_pct=25.0 → HP = max_hp × 25% = 5000。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # EX
        self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        su_ex = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(su_ex), 1)
        self.assertEqual(su_ex[0].sub_unit_max_hp, 5000,
                         "EX sub_unit HP应为5000(25%×20000)")
        self.assertEqual(su_ex[0].sub_unit_hp, 5000,
                         "EX sub_unit 当前HP应为5000(创建时满血)")

    def test_sub_unit_hp_shield_tag_for_ps1(self):
        """sub_unit HP 计算: PS1 用 sub_unit_hp_pct_tag="shield" → Lv10: 25%, Lv15: 35%。"""
        # Lv10: shield=25%
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[130133] = 10

        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.caster.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={"knockout"},
        )
        ps1_actions = [a for a in actions if a.skill_id == 130133]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_debuff_applied"
        )

        su_ps1 = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(su_ps1), 1)
        self.assertEqual(su_ps1[0].sub_unit_max_hp, 5000,
                         "PS1 Lv10 shield%=25% → sub_unit HP应为5000")

    def test_sub_unit_duration_action_timing(self):
        """sub_unit duration_type="action" → timing_type=DURABLE_TARGET_MANEUVER_END(2)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        su = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT][0]
        # duration_type=action → timing_type=DURABLE_TARGET_MANEUVER_END(=2)
        self.assertEqual(su.timing_type, DURABLE_TARGET_MANEUVER_END,
                         "duration_type=action → timing_type应为DURABLE_TARGET_MANEUVER_END(2)")
        self.assertEqual(su.duration, 2, "EX sub_unit duration应为2(2action)")

    def test_sub_unit_caster_attack_snapshot(self):
        """sub_unit 的 caster_attack 是创建时的快照（含atk_up buff加成）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 先给caster施加一个atk_up buff（30%）
        self.caster.buffs.append(BuffState(
            buff_id="test_atk_up_setup",
            name="ATK_UP", effect_type=STATUS_ATTACK, value=30.0,
            duration=-1, timing_type=2, is_debuff=False,
            is_stackable=True, unremovable=False,
        ))
        # 此时的 effective attack = 10000 × (1 + 30%) = 13000
        eff_atk = self.dms._calculate_final_stat(self.caster, "attack")
        self.assertEqual(eff_atk, 13000, "前置验证: 含atk_up后effective atk应为13000")

        # 执行EX创建sub_unit
        self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        su = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT][0]
        # caster_attack 应为快照值（13000），不是基础值（10000）
        self.assertEqual(su.caster_attack, 13000,
                         "sub_unit caster_attack应为快照(含atk_up)=13000，而非基础10000")

    def test_sub_unit_value_is_atk_pct(self):
        """sub_unit 的 value 字段 = atk% (额外伤害百分比)，来自 value_tag="atk" 解析。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # EX Lv10: atk=23.4%
        self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        su = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT][0]
        # Lv10 atk% ≈ 23.4
        self.assertAlmostEqual(su.value, 23.4, delta=0.5,
                               msg=f"sub_unit value应为atk%(Lv10≈23.4)，实际: {su.value}")
        self.assertGreater(su.value, 0, "sub_unit value应为正数(攻击追加伤害百分比)")

    def test_sub_unit_is_stackable_multiple_instances(self):
        """sub_unit is_stackable=True → 多个 sub_unit 实例可共存（EX + PS1 触发后）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 1. 先执行EX创建「ドルズィヤⅣ」
        self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        su_after_ex = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(su_after_ex), 1, "EX后应有1个sub_unit")

        # 2. 触发PS1创建「ドルズィヤⅡ」
        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.caster.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={"knockout"},
        )
        ps1_actions = [a for a in actions if a.skill_id == 130133]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_debuff_applied"
        )

        # 3. 验证两个不同名的sub_unit共存
        su_after_ps1 = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(su_after_ps1), 2, "EX+PS1后应有2个sub_unit(共存)")
        su_names = sorted([b.name for b in su_after_ps1])
        self.assertEqual(su_names, ["ドルズィヤⅡ", "ドルズィヤⅣ"],
                         f"两个sub_unit应共存: ドルズィヤⅡ + ドルズィヤⅣ，实际: {su_names}")

    def test_sub_unit_is_buff_not_debuff(self):
        """sub_unit is_debuff=False → 进 buffs 列表（不是 debuffs）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )

        # sub_unit 应在 buffs 列表
        su_in_buffs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        su_in_debuffs = [d for d in self.caster.debuffs if d.effect_type == SUB_UNIT]
        self.assertEqual(len(su_in_buffs), 1, "sub_unit应在buffs列表")
        self.assertEqual(len(su_in_debuffs), 0, "sub_unit不应在debuffs列表")
        self.assertFalse(su_in_buffs[0].is_debuff, "sub_unit is_debuff应为False")

    # ════════════════════════════════════════════════════════════════
    # Mark 全链专项验证（6+ 用例）
    # ════════════════════════════════════════════════════════════════

    def test_mark_kensaku_is_buff_mark(self):
        """「研鑽」mark is_buff_mark=true → 进 buffs 列表(is_debuff=False)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )

        # 研鑽 mark 应在 buffs 列表
        marks_in_buffs = [b for b in self.caster.buffs
                          if b.effect_type == MARK and b.name == "研鑽"]
        marks_in_debuffs = [d for d in self.caster.debuffs
                            if d.effect_type == MARK and d.name == "研鑽"]
        self.assertEqual(len(marks_in_buffs), 1, "研鑽mark应在buffs列表")
        self.assertEqual(len(marks_in_debuffs), 0, "研鑽mark不应在debuffs列表")
        self.assertFalse(marks_in_buffs[0].is_debuff, "研鑽mark is_debuff应为False")

    def test_mark_metoca_is_debuff(self):
        """「メトカ」mark is_buff_mark 未设 → 进 debuffs 列表(is_debuff=True)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )

        # メトカ mark 应在 enemy_rf (highest_spd) 的 debuffs 列表
        marks_in_buffs = [b for b in self.enemy_rf.buffs
                          if b.effect_type == MARK and b.name == "メトカ"]
        marks_in_debuffs = [d for d in self.enemy_rf.debuffs
                            if d.effect_type == MARK and b.name == "メトカ"] if False else \
                           [d for d in self.enemy_rf.debuffs
                            if d.effect_type == MARK and d.name == "メトカ"]
        self.assertEqual(len(marks_in_buffs), 0, "メトカmark不应在buffs列表")
        self.assertEqual(len(marks_in_debuffs), 1, "メトカmark应在debuffs列表")
        self.assertTrue(marks_in_debuffs[0].is_debuff, "メトカmark is_debuff应为True")

    def test_mark_count_per_target_independent(self):
        """AS1 Block1/Block3 mark_count 研鑽>=3 条件 per-target 独立判断(规则11.17)。

        注意：144301的研鑽mark施加给self（不是敌方），所以这里验证的是：
        AS1 Block1/Block3 的 mark_count条件 检查自身(caster)持有的研鑽mark数。
        场景: caster持有3个研鑽 → Block1(dmg_dealt_up) + Block3(remove_mark) 均执行。

        验证方式:
        - Block1 dmg_dealt_up(50%, 1hit) 会被 Block2 damage 消耗 → 通过伤害提升验证
        - Block3 remove_mark(remove_all=true) → 通过研鑽mark被全部清除验证
        """
        # 场景1: 无研鑽 → Block1跳过 → base damage
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_no_mark = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        dmg_no_mark = result_no_mark.get("total_damage", 0)

        # 场景2: 3个研鑽 → Block1执行(dmg_dealt_up 50%) + Block3执行(remove_mark)
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_kensaku_mark(self.caster, count=3)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block1 验证: dmg_dealt_up 50% → 伤害应×1.5
        dmg_with_mark = result.get("total_damage", 0)
        self.assertGreater(dmg_with_mark, 0, "Block2应造成伤害")
        self.assertGreater(dmg_no_mark, 0, "Block2 base damage应>0")
        ratio = dmg_with_mark / dmg_no_mark
        self.assertAlmostEqual(ratio, 1.5, delta=0.05,
                               msg=f"3研鑽→dmg_dealt_up(50%)→伤害应×1.5，实际: {ratio:.3f}")

        # Block3 验证: remove_mark(研鑽, remove_all=true) → 研鑽mark应被清除
        remaining = [b for b in self.caster.buffs
                     if b.effect_type == MARK and b.name == "研鑽"]
        self.assertEqual(len(remaining), 0, "研鑽>=3时Block3应remove_all研鑽mark")

    def test_mark_count_below_threshold_skips_block1_and_3(self):
        """AS1 Block1/Block3 研鑽<3 时跳过(不执行dmg_dealt_up, 不remove_mark)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_kensaku_mark(self.caster, count=2)  # <3

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block1 跳过: 无 dmg_dealt_up
        dmg_ups = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_ups), 0, "研鑽<3时Block1应跳过")

        # Block3 跳过: 研鑽mark保留
        remaining = [b for b in self.caster.buffs
                     if b.effect_type == MARK and b.name == "研鑽"]
        self.assertEqual(len(remaining), 2, "研鑽<3时Block3应跳过，研鑽mark应保留2个")

    def test_remove_mark_remove_all_clears_all_instances(self):
        """AS1 Block3 remove_mark(remove_all=true) 清除所有研鑽mark（多个实例）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 预设5个研鑽mark
        self._apply_kensaku_mark(self.caster, count=5)

        self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )

        # Block3 应执行 remove_all=true → 全部5个研鑽mark应被清除
        remaining = [b for b in self.caster.buffs
                     if b.effect_type == MARK and b.name == "研鑽"]
        self.assertEqual(len(remaining), 0,
                         f"remove_all=true应清除所有5个研鑽mark，实际剩余: {len(remaining)}")

    def test_target_has_mark_uses_snapshot_not_realtime(self):
        """AS1 Block4 target_has_mark(メトカ) 必须使用技能执行前的快照(规则11.13)。

        场景: 技能执行前enemy_rf无メトカ → Block2当次付与メトカ →
              Block4检查快照(无)→不应执行dmg_dealt_down(不会把当次付与的メトカ误判为"已有")。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[120129] = 11
        # 不预先施加メトカ

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证Block2确实付与了メトカmark（实时状态）
        metoca_now = [d for d in self.enemy_rf.debuffs
                      if d.effect_type == MARK and d.name == "メトカ"]
        self.assertEqual(len(metoca_now), 1,
                         "前置验证: Block2应已付与メトカmark到enemy_rf")

        # Block4 应不执行: 因为target_has_mark检查的是技能执行前的快照(无メトカ)
        # 即使Block2当次付与了メトカ，Block4也不应施加dmg_dealt_down
        dmg_downs = [d for d in self.enemy_rf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_downs), 0,
                         "target_has_mark(メトカ)用快照检查(规则11.13)，"
                         "技能执行前无メトカ→Block4不应执行dmg_dealt_down")

    def test_target_has_mark_passes_when_mark_preexists(self):
        """AS1 Block4 target_has_mark(メトカ): 技能执行前已有メトカ → Block4执行dmg_dealt_down。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[120129] = 11
        # 预先施加メトカmark（在技能执行前的快照中存在）
        self._apply_metoca_mark(self.enemy_rf)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block4 应执行: target_has_mark检查快照中有メトカ → 施加dmg_dealt_down
        dmg_downs = [d for d in self.enemy_rf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_downs), 0,
                           "技能执行前已有メトカ→Block4应执行dmg_dealt_down")

    def test_mark_kensaku_granted_by_ex_ps1_ps2(self):
        """研鑽mark 由 EX/PS1/PS2 付与自身(buffs列表, stackable)。"""
        # EX 付与
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.ss.execute_skill(
            caster=self.caster, skill_id=110058, battlefield=self.bf, skip_cost=True
        )
        kensaku_after_ex = [b for b in self.caster.buffs
                            if b.effect_type == MARK and b.name == "研鑽"]
        self.assertEqual(len(kensaku_after_ex), 1, "EX应付与1个研鑽mark")

        # PS1 触发也付与（再+1）
        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.caster.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={"knockout"},
        )
        ps1_actions = [a for a in actions if a.skill_id == 130133]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_debuff_applied"
        )
        kensaku_after_ps1 = [b for b in self.caster.buffs
                             if b.effect_type == MARK and b.name == "研鑽"]
        self.assertEqual(len(kensaku_after_ps1), 2,
                         "EX+PS1后应有2个研鑽mark(stackable共存)")


