        self.assertEqual(len(dmg_downs), 0, "Lv10时Block4应跳过(active_level_min=11未满足)")

    def test_as1_block4_lv11_target_has_mark_uses_snapshot(self):
        """AS1(120129) Block4 Lv11+: target_has_mark(メトカ)使用技能执行前的快照(规则11.13)。

        场景：技能执行前enemy_rf无メトカmark → Block2会付与メトカ → Block4检查快照(无) → 不应执行dmg_dealt_down。
        这验证了 target_has_mark 条件使用技能执行前的mark快照，不会把当次技能付与的メトカ误判为"已有"。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[120129] = 11
        # 不预先施加メトカmark（让Block2当次付与）

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block4 应不执行：因为target_has_mark(メトカ) 检查的是技能执行前的快照（无メトカ）
        # 即使 Block2 当次付与了メトカ mark，Block4 也不应施加 dmg_dealt_down
        dmg_downs = [d for d in self.enemy_rf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_downs), 0,
                         "target_has_mark(メトカ)用快照检查，技能执行前无メトカ→Block4不应执行dmg_dealt_down")

    def test_as1_block4_lv11_executes_when_target_already_has_metoca(self):
        """AS1(120129) Block4 Lv11+: 技能执行前目标已有メトカmark → Block4执行dmg_dealt_down。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[120129] = 11
        # 预先施加メトカmark（技能执行前快照中已有）
        self._apply_metoca_mark(self.enemy_rf)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120129, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block4 应执行：target_has_mark(メトカ) 检查快照中有メトカ → 施加 dmg_dealt_down
        dmg_downs = [d for d in self.enemy_rf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_downs), 0,
                           "技能执行前已有メトカ→Block4应执行dmg_dealt_down")
        self.assertEqual(dmg_downs[0].duration, 1, "dmg_dealt_down duration应为1(1action)")

