    def test_ps1_exclude_battle_start(self):
        """PS1(130133) on_debuff_applied 是事件驱动触发器，与戦闘開始/ターン開始等阶段无关。

        PAWN_RECEIVED_AURA 触发器在任意阶段被付与状態異常時都会触发（无 phase 过滤）。
        本测试验证: 即使设置 current_trigger_phase=BATTLE_START，PS1 仍能正常触发。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.bf.current_trigger_phase = TriggerTiming.BATTLE_START

        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.caster.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={"knockout"},
        )

        ps1_actions = [a for a in actions if a.skill_id == 130133]
        # PAWN_RECEIVED_AURA 是事件驱动，不受 current_trigger_phase 影响
        self.assertGreater(len(ps1_actions), 0, "PS1应触发（PAWN_RECEIVED_AURA不受phase过滤）")

        self.bf.current_trigger_phase = None

