    # ════════════════════════════════════════════════════════════════
    # PS2: 130046 捲土重来
    # ════════════════════════════════════════════════════════════════

    def test_ps2_trigger_after_as_attacked(self):
        """PS2(130046) trigger_type=after_as_attacked: AS被攻撃後触发。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 触发 after_as_attacked（targets=[caster], actor=enemy_cf）
        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.enemy_cf, primary_target=self.caster
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130046]
        self.assertGreater(len(ps2_actions), 0, "after_as_attacked应触发PS2")

    def test_ps2_damage_uses_trigger_attacker(self):
        """PS2(130046) damage target_identifier=trigger_attacker: 反撃定位攻击者。

        参考 project_rules 11.15: 反击型PS必须用 trigger_attacker 定位攻击者，
        不能误选最近敌方。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        hp_enemy_cf_before = self.enemy_cf.current_hp
        hp_enemy_lf_before = self.enemy_lf.current_hp

        # 让 enemy_lf（次近敌）攻击 caster
        # 这样可以验证反击定位 enemy_lf（攻击者）而非 enemy_cf（最近敌）
        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.enemy_lf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130046]
        # 设置 _trigger_attacker
        self.ss._trigger_attacker = self.enemy_lf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        # 验证 enemy_lf（攻击者）受到反击伤害
        self.assertLess(self.enemy_lf.current_hp, hp_enemy_lf_before,
                        "攻击者 enemy_lf 应受到反击伤害")
        # 验证 enemy_cf（最近敌）未受到反击伤害
        self.assertEqual(self.enemy_cf.current_hp, hp_enemy_cf_before,
                         "最近敌 enemy_cf 不应受到反击伤害（trigger_attacker 定位攻击者）")

    def test_ps2_damage_based_on_received_damage(self):
        """PS2(130046) damage value_source=received_damage: 反击伤害=受ダメージ×dmg%。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 先让 caster 受到 2000 点伤害
        received_damage = 2000
        self.caster.current_hp -= received_damage
        self.caster.last_received_damage = received_damage

        hp_enemy_before = self.enemy_cf.current_hp

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.enemy_cf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130046]
        self.ss._trigger_attacker = self.enemy_cf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        # dmg Lv1=80%, Lv10=100%。Lv10时反击伤害 = 2000 * 100 / 100 = 2000
        # 但实际伤害可能因防御减免而低于理论值，这里验证伤害>0且<=理论值
        actual_damage = hp_enemy_before - self.enemy_cf.current_hp
        self.assertGreater(actual_damage, 0, "反击伤害应>0")
        # 理论上限 = 2000（无防御减免时）
        # 实际伤害 <= 2000（受防御影响）
        # 这里只验证伤害存在且为正

    def test_ps2_stun_applied_to_trigger_attacker(self):
        """PS2(130046) add_status stun: 付与 trigger_attacker 1/action 気絶。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.enemy_cf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130046]
        self.ss._trigger_attacker = self.enemy_cf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        # 验证 enemy_cf（trigger_attacker）有 stun debuff
        stuns = [d for d in self.enemy_cf.debuffs if d.effect_type == STUN]
        self.assertGreater(len(stuns), 0, "trigger_attacker 应有 stun debuff")
        self.assertEqual(stuns[0].duration, 1, "stun duration应为1")

        # 验证其他敌方未获得 stun
        stuns_lf = [d for d in self.enemy_lf.debuffs if d.effect_type == STUN]
        self.assertEqual(len(stuns_lf), 0, "enemy_lf 不应有 stun（trigger_attacker 定位）")

    def test_ps2_lv10_no_remove_pp(self):
        """PS2(130046) Lv10: Block1 remove_pp 条件 hp_threshold_cross=30% 未满足时不削PP。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[130046] = 10
        # enemy_cf HP=100%（不会穿越30%）
        self.enemy_cf.current_pp = 4

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.enemy_cf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130046]
        self.ss._trigger_attacker = self.enemy_cf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        # 验证 enemy_cf PP 未被削减（HP未穿越30%）
        self.assertEqual(self.enemy_cf.current_pp, 4,
                         "HP未穿越30%时不应削PP")

    def test_ps2_lv11_remove_pp_when_hp_cross_30(self):
        """PS2(130046) Lv11+: HP穿越30%时削PP。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[130046] = 11
        # enemy_cf HP=35%（>30%），反击伤害应使其HP降到30%以下
        self.enemy_cf.current_hp = int(self.enemy_cf.max_hp * 0.35)
        self.enemy_cf.current_pp = 4
        # 让 caster 受到一定伤害以触发反击
        self.caster.last_received_damage = 5000

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.enemy_cf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130046]
        self.ss._trigger_attacker = self.enemy_cf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        # 验证 enemy_cf PP 被削减
        # PP Lv11=1，应削减1
        self.assertLess(self.enemy_cf.current_pp, 4,
                        "HP穿越30%时PP应被削减")

    def test_ps2_lv15_remove_all_pp(self):
        """PS2(130046) Lv15: Block2 remove_all_pp=true，削减全部PP。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[130046] = 15
        # enemy_cf HP=35%（>30%），反击伤害应使其HP降到30%以下
        self.enemy_cf.current_hp = int(self.enemy_cf.max_hp * 0.35)
        self.enemy_cf.current_pp = 4
        # 让 caster 受到一定伤害以触发反击
        self.caster.last_received_damage = 99999  # 极大伤害确保反击穿越30%

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.enemy_cf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130046]
        self.ss._trigger_attacker = self.enemy_cf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        # 验证 enemy_cf PP 被削减为0（remove_all_pp）
        self.assertEqual(self.enemy_cf.current_pp, 0,
                         "Lv15 HP穿越30%时应削减全部PP")

    def test_ps2_cooldown_1(self):
        """PS2(130046) cooldown=1: 触发后设置冷却。"""
        self._reset_caster(hp=self.caster.max_hp)
