"""角色105301 厳格な規律の守護者 专项E2E测试

技能列表：
- EX: 110014 規律遵守の精神（自身heal[max_hp×cure%] + atk_up[50%, 2/action, stackable] + block_specific_aura[knockout, 2/action]；Lv11+ shield[atk×shield%]）
- AS1: 120022 旱天の慈雨（ally_single lowest_hp_priority shield[atk×shield%]；Lv11+ heal_over_time[max_hp×cure%, 2/action]；cooldown=2）
- AS2: 120040 一閃（enemy_single damage[威力]）
- PS1: 130030 腹が減っては戦ができぬ（before_skill_use + heal[self, lost_hp×cure%]；cooldown=1）
- PS2: 130046 捲土重来（after_as_attacked + damage[trigger_attacker, 受ダメージ×dmg%] + stun[1/action, trigger_attacker] + Lv11+ remove_pp[trigger_attacker, hp_threshold_cross 30%] + Lv15 remove_all_pp；cooldown=1）

覆盖维度：
1. EX heal+atk_up(stackable)+block_specific_aura(knockout) + Lv11+ shield
2. AS1 lowest_hp_priority shield + Lv11+ HOT + cooldown
3. AS2 基础damage
4. PS1 before_skill_use + lost_hp base heal + cooldown
5. PS2 after_as_attacked反撃 + trigger_attacker定位（11.15规则） + stun + Lv11+ HP30%以下削PP + Lv15 全PP削除
6. block_specific_aura 专项：阻止knockout付与、不阻止其他debuff、过期后允许
7. lowest_hp_priority 专项：最低HP割合优先、同HP时按位置距离tiebreaker
8. trigger_attacker 专项：反击定位攻击者而非最近敌方
9. hp_threshold_cross 专项：HP穿越30%时削PP、未穿越不削
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerContext, TriggerTiming
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.skill_data_resolver import SkillDataResolver

# 简写
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value       # atk_up/atk_down
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value     # def_up/def_down
STUN = SkillEffectType.KNOCKOUT.value                     # 気絶
HEAL_OVER_TIME = SkillEffectType.HEAL_OVER_TIME.value
BLOCK_SPECIFIC_AURA = SkillEffectType.BLOCK_SPECIFIC_AURA.value


class TestActor105301(unittest.TestCase):
    """角色105301 厳格な規律の守護者 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 105301 厳格な規律の守護者 (風属性attr=4, 物理型character_type=1, 前排position_type=1, タンクrole_type=3)
        # AP=10, PP=10。默认Lv10，部分测试用Lv11/Lv15验证Lv11+分支
        # caster 放前排中央（105301 是前排坦克）
        self.caster = UnitState(
            unit_id="caster", name="厳格な規律の守護者", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=105301, level=10,
            element=4, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110014, 120022, 120040, 130030, 130046],
            skill_levels={110014: 10, 120022: 10, 120040: 10,
                          130030: 10, 130046: 10},
            skill_cooldowns={},
        )

        # 友方前排左（用于 multi-ally 场景 + lowest_hp_priority 测试）
        self.ally_lf = UnitState(
            unit_id="ally_lf", name="前列左友方", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999101, level=10,
            element=2, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方前排右（HP较低，用于 lowest_hp_priority 测试）
        self.ally_rf = UnitState(
            unit_id="ally_rf", name="前列右友方", side=Side.ALLY,
            position=Position.ALLY_RIGHT_FRONT, character_id=999102, level=10,
            element=3, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=7000, defense=3500, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方后排中央（用于 AS1 ally_single shield 测试）
        self.ally_cb = UnitState(
            unit_id="ally_cb", name="後列中央友方", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=999103, level=10,
            element=5, character_type=1,
            max_hp=10000, current_hp=10000,
            attack=6000, defense=3000, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央（最近敌，主目标）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
