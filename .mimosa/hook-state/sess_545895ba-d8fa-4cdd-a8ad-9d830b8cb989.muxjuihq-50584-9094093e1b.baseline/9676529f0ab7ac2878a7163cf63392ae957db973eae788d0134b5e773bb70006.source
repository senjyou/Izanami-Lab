    # ════════════════════════════════════════════════════════════════
    # 辅助方法
    # ════════════════════════════════════════════════════════════════

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.level = 10
        self.caster.shield = 0
        self.caster.physical_shield = 0
        self.caster.en_shield = 0
        self.caster.cumulative_hp_damage = 0
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10

    def _reset_all_allies(self):
        """重置所有友方状态。"""
        self._reset_caster()
        for ally in [self.ally_lf, self.ally_rf, self.ally_cb]:
            ally.current_hp = ally.max_hp
            ally.buffs = []
            ally.debuffs = []
            ally.is_alive = True
            ally.shield = 0
            ally.physical_shield = 0
            ally.en_shield = 0

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ap = 4
            e.current_pp = 4
            e.shield = 0
            e.physical_shield = 0
            e.en_shield = 0

    def _make_enemy_attack_caster(self, enemy, dmg_amount=2000):
        """让敌方攻击 caster，造成固定伤害。

        使用 120040 一閃 + 调整 enemy.attack 使伤害约为 dmg_amount。
        """
        # 通过设置 enemy.attack 让伤害可控
        # damage = atk * 威力 / 100 / def_factor，这里简单设置 attack
        enemy.attack = dmg_amount * 2  # 简化估算
        return self.ss.execute_skill(
            caster=enemy, skill_id=120040, battlefield=self.bf
        )

    # ════════════════════════════════════════════════════════════════
    # 角色数据加载验证
    # ════════════════════════════════════════════════════════════════

    def test_character_data_loadable(self):
        """角色数据可正常加载。"""
        cdata = self.dl.get_character_by_id(105301)
        self.assertIsNotNone(cdata, "105301 角色数据应可加载")
        self.assertEqual(cdata.character_type, 1, "character_type应为1(物理型)")
        self.assertEqual(cdata.attribute, 4, "attribute应为4(風)")
        self.assertEqual(cdata.position_type, 1, "position_type应为1(前排)")
        self.assertEqual(cdata.role_type, 3, "role_type应为3(タンク)")

    def test_all_skills_loadable(self):
        """所有技能可加载且 hybrid 配置存在。"""
        hybrid_map = self.dl.load_parsed_skills()
        for sid in [110014, 120022, 120040, 130030, 130046]:
            hybrid = hybrid_map.get(str(sid))
            self.assertIsNotNone(hybrid, f"技能 {sid} hybrid 配置应存在")
            self.assertNotEqual(hybrid.get('parse_status'), 'failed',
                                f"技能 {sid} parse_status 不应为 failed")

    def test_ps_trigger_type_valid(self):
        """PS 技能的 trigger_type 在 TRIGGER_TYPE_MAP 中已注册。"""
        from src.combat_v2.services.trigger_service import TRIGGER_TYPE_MAP
        hybrid_map = self.dl.load_parsed_skills()
        for sid in [130030, 130046]:
            hybrid = hybrid_map.get(str(sid))
            tt = hybrid.get('trigger_type')
            self.assertIsNotNone(tt, f"技能 {sid} 应有 trigger_type")
            self.assertIn(tt, TRIGGER_TYPE_MAP,
                          f"技能 {sid} trigger_type '{tt}' 应在 TRIGGER_TYPE_MAP 中")

    # ════════════════════════════════════════════════════════════════
    # EX: 110014 規律遵守の精神
    # ════════════════════════════════════════════════════════════════

    def test_ex_heal_based_on_max_hp(self):
        """EX(110014) Block1 heal: heal_base=max_hp，回复量=max_hp×cure%。"""
        # 设置 HP=20%（4000），确保 60% heal (12000) 不会超过 max_hp
        self._reset_caster(hp=int(self.caster.max_hp * 0.2))  # HP=20%
        hp_before = self.caster.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110014, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # cure Lv1=35%, Lv10=60%。Lv10时回复量 = 20000 * 60 / 100 = 12000
        expected_heal = int(self.caster.max_hp * 60 / 100)
        self.assertEqual(self.caster.current_hp, hp_before + expected_heal,
                         f"EX heal应回复max_hp×60%={expected_heal}，实际={self.caster.current_hp - hp_before}")

    def test_ex_atk_up_50_percent_stackable(self):
        """EX(110014) Block1 atk_up: 50%, 2/action, stackable。"""
        self._reset_caster(hp=self.caster.max_hp)

        self.ss.execute_skill(
            caster=self.caster, skill_id=110014, battlefield=self.bf, skip_cost=True
        )

        atk_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 1, "应有1个atk_up buff")
        self.assertEqual(atk_buffs[0].value, 50, "atk_up值应为50%")
        self.assertEqual(atk_buffs[0].duration, 2, "atk_up duration应为2")
        self.assertTrue(atk_buffs[0].is_stackable, "atk_up应为stackable")

    def test_ex_atk_up_stacks_with_multiple_casts(self):
        """EX(110014) atk_up stackable: 多次施放应叠加（buff_id 唯一）。"""
        self._reset_caster(hp=self.caster.max_hp)

        # 第一次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=110014, battlefield=self.bf, skip_cost=True
        )
        # 第二次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=110014, battlefield=self.bf, skip_cost=True
        )

        atk_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 2, "两次施放应有2个独立atk_up buff（stackable）")
        # 验证 buff_id 不同
        self.assertNotEqual(atk_buffs[0].buff_id, atk_buffs[1].buff_id,
                            "stackable buff 应有不同 buff_id")

    def test_ex_block_specific_aura_knockout(self):
        """EX(110014) Block1 block_specific_aura: 阻止 knockout 付与。"""
        self._reset_caster(hp=self.caster.max_hp)

        self.ss.execute_skill(
            caster=self.caster, skill_id=110014, battlefield=self.bf, skip_cost=True
        )

        block_auras = [b for b in self.caster.buffs if b.effect_type == BLOCK_SPECIFIC_AURA]
        self.assertEqual(len(block_auras), 1, "应有1个block_specific_aura buff")
        self.assertEqual(block_auras[0].duration, 2, "block_specific_aura duration应为2")
        self.assertIn('knockout', block_auras[0].block_status_list,
                      "block_status_list 应包含 'knockout'")

    def test_ex_block_specific_aura_prevents_stun(self):
        """EX(110014) block_specific_aura 实际阻止 stun 付与。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 先施放 EX 获得 block_specific_aura
        self.ss.execute_skill(
            caster=self.caster, skill_id=110014, battlefield=self.bf, skip_cost=True
        )
        block_auras = [b for b in self.caster.buffs if b.effect_type == BLOCK_SPECIFIC_AURA]
        self.assertGreater(len(block_auras), 0, "应有 block_specific_aura")

        # 尝试给 caster 施加 stun debuff
        stun_debuff = BuffState(
            buff_id="test_stun", name="stun", effect_type=STUN,
            value=0, duration=1, timing_type=2,
            is_debuff=True, is_stackable=False,
            source_unit_id="enemy_cf",
        )
        self.aus.add_aura(self.caster, stun_debuff)

        # 验证 stun 被阻止
        stuns = [d for d in self.caster.debuffs if d.effect_type == STUN]
        self.assertEqual(len(stuns), 0, "block_specific_aura 应阻止 stun 付与")

    def test_ex_block_specific_aura_does_not_block_other_debuffs(self):
        """EX(110014) block_specific_aura 仅阻止 knockout，不阻止其他 debuff。"""
        self._reset_caster(hp=self.caster.max_hp)

        self.ss.execute_skill(
            caster=self.caster, skill_id=110014, battlefield=self.bf, skip_cost=True
        )

        # 尝试给 caster 施加 atk_down debuff（非 knockout）
        atk_down = BuffState(
            buff_id="test_atk_down", name="atk_down", effect_type=STATUS_ATTACK,
            value=20, duration=2, timing_type=2,
            is_debuff=True, is_stackable=False,
            source_unit_id="enemy_cf",
        )
        self.aus.add_aura(self.caster, atk_down)

        # 验证 atk_down 未被阻止
        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_downs), 0, "block_specific_aura 不应阻止 atk_down")

    def test_ex_lv10_no_shield(self):
        """EX(110014) Lv10: Block2 (level_min=11) 跳过，无 shield。"""
        self._reset_caster(hp=self.caster.max_hp)
        self.caster.level = 10
        self.caster.skill_levels[110014] = 10

        self.ss.execute_skill(
            caster=self.caster, skill_id=110014, battlefield=self.bf, skip_cost=True
        )

        # caster.shield 应仍为 0
        self.assertEqual(self.caster.shield, 0, "Lv10时不应获得 shield")

    def test_ex_lv11_shield_based_on_atk(self):
        """EX(110014) Lv11+: Block2 shield，shield_base=atk，盾值=atk×shield%。"""
        self._reset_caster(hp=self.caster.max_hp)
        self.caster.level = 11
        self.caster.skill_levels[110014] = 11

        self.ss.execute_skill(
            caster=self.caster, skill_id=110014, battlefield=self.bf, skip_cost=True
        )

        # shield Lv11 在 template_tags 中查找（基础值约为120%-130%）
        # 这里仅验证 shield > 0，精确值由 template_tags 决定
        self.assertGreater(self.caster.shield, 0, "Lv11+应获得 shield")
        # 验证 shield 值约等于 atk × shield% / 100
        # shield Lv10=120, Lv11 应略高
        # 由于具体值依赖 template_tags 解析，这里只验证盾存在

    # ════════════════════════════════════════════════════════════════
    # AS1: 120022 旱天の慈雨
    # ════════════════════════════════════════════════════════════════

    def test_as1_shield_lowest_hp_priority(self):
        """AS1(120022) Block1 shield: lowest_hp_priority 优先最低HP割合友方。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_all_allies()
        # ally_cb HP割合最低 (10000/10000=100%, 但其他友方: caster 20000/20000=100%, ally_lf 15000/15000=100%, ally_rf 12000/12000=100%)
        # 让 ally_cb HP 割合最低
        self.ally_cb.current_hp = int(self.ally_cb.max_hp * 0.5)  # 50%

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120022, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 ally_cb（HP割合最低）获得 shield
        self.assertGreater(self.ally_cb.shield, 0, "HP割合最低的 ally_cb 应获得 shield")
        # 验证其他友方未获得 shield
        self.assertEqual(self.ally_lf.shield, 0, "ally_lf 不应获得 shield")
        self.assertEqual(self.ally_rf.shield, 0, "ally_rf 不应获得 shield")
        self.assertEqual(self.caster.shield, 0, "caster 自身不应获得 shield")

    def test_as1_shield_value_based_on_atk(self):
        """AS1(120022) Block1 shield: shield_base=atk，盾值=atk×shield%。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_all_allies()
        self.ally_cb.current_hp = int(self.ally_cb.max_hp * 0.5)

        self.ss.execute_skill(
            caster=self.caster, skill_id=120022, battlefield=self.bf, skip_cost=True
        )

        # shield Lv1=80%, Lv10=120%。Lv10时盾值 = 10000 * 120 / 100 = 12000
        expected_shield = int(self.caster.attack * 120 / 100)
        self.assertEqual(self.ally_cb.shield, expected_shield,
                         f"shield值应为atk×120%={expected_shield}，实际={self.ally_cb.shield}")

    def test_as1_lv10_no_hot(self):
        """AS1(120022) Lv10: Block2 (level_min=11) 跳过，无 HOT。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_all_allies()
        self.ally_cb.current_hp = int(self.ally_cb.max_hp * 0.5)
        self.caster.level = 10
        self.caster.skill_levels[120022] = 10

        self.ss.execute_skill(
            caster=self.caster, skill_id=120022, battlefield=self.bf, skip_cost=True
        )

        # 验证 ally_cb 未获得 HOT buff
        hots = [b for b in self.ally_cb.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hots), 0, "Lv10时不应获得 HOT")

    def test_as1_lv11_hot(self):
        """AS1(120022) Lv11+: Block2 heal_over_time，2/action。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_all_allies()
        self.ally_cb.current_hp = int(self.ally_cb.max_hp * 0.5)
        self.caster.level = 11
        self.caster.skill_levels[120022] = 11

        self.ss.execute_skill(
            caster=self.caster, skill_id=120022, battlefield=self.bf, skip_cost=True
        )

        # 验证 ally_cb 获得 HOT buff
        hots = [b for b in self.ally_cb.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hots), 1, "Lv11+应获得 HOT")
        self.assertEqual(hots[0].duration, 2, "HOT duration应为2")

    def test_as1_cooldown_set_after_use(self):
        """AS1(120022) cooldown=2: 施放后设置冷却。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_all_allies()
        self.ally_cb.current_hp = int(self.ally_cb.max_hp * 0.5)

        self.ss.execute_skill(
            caster=self.caster, skill_id=120022, battlefield=self.bf, skip_cost=True
        )
        self.ss.update_cooldown_after_skill_use(self.caster, 120022)

        self.assertEqual(self.caster.skill_cooldowns.get(120022), 2,
                         "AS1 cooldown应设置为2")

    # ════════════════════════════════════════════════════════════════
    # AS2: 120040 一閃
