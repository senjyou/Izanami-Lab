        self.ss.execute_skill(
            caster=self.caster, skill_id=120040, battlefield=self.bf, skip_cost=True
        )
        self.ss.update_cooldown_after_skill_use(self.caster, 120040)

        # cooldown=0/null，不应设置冷却
        self.assertNotIn(120040, self.caster.skill_cooldowns,
                         "AS2 cooldown=0，不应设置冷却")

    # ════════════════════════════════════════════════════════════════
    # PS1: 130030 腹が減っては戦ができぬ
    # ════════════════════════════════════════════════════════════════

    def test_ps1_trigger_before_skill_use(self):
        """PS1(130030) trigger_type=before_skill_use: AS使用直前触发。"""
        self._reset_caster(hp=int(self.caster.max_hp * 0.5))  # HP=50%
        self._reset_enemies()

        # 触发 before_skill_use（actor=caster, skill_id=AS2 120040）
        trigger_actions = self.ts.trigger_before_skill_use(
            self.caster, 120040, self.bf
        )
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130030]
        self.assertGreater(len(ps1_actions), 0, "before_skill_use应触发PS1")

    def test_ps1_heal_based_on_lost_hp(self):
        """PS1(130030) Block1 heal: heal_base=lost_hp，回复量=失ったHP×cure%。"""
        self._reset_caster(hp=int(self.caster.max_hp * 0.5))  # HP=50%
        self._reset_enemies()

        hp_before = self.caster.current_hp
        lost_hp = self.caster.max_hp - hp_before  # 10000

        # 触发 PS1
        trigger_actions = self.ts.trigger_before_skill_use(
            self.caster, 120040, self.bf
        )
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130030]
        self.ss._execute_trigger_actions_inline(ps1_actions, self.bf, "before_skill_use")

        # cure Lv1=25%, Lv10=40%。Lv10时回复量 = 10000 * 40 / 100 = 4000
        expected_heal = int(lost_hp * 40 / 100)
        self.assertEqual(self.caster.current_hp, hp_before + expected_heal,
                         f"PS1 heal应回复lost_hp×40%={expected_heal}，实际={self.caster.current_hp - hp_before}")

    def test_ps1_heal_zero_when_full_hp(self):
        """PS1(130030) heal_base=lost_hp: 满血时 lost_hp=0，回复0。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_before = self.caster.current_hp

        trigger_actions = self.ts.trigger_before_skill_use(
            self.caster, 120040, self.bf
        )
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130030]
        self.ss._execute_trigger_actions_inline(ps1_actions, self.bf, "before_skill_use")

        # 满血时 lost_hp=0，回复0
        self.assertEqual(self.caster.current_hp, hp_before,
                         "满血时PS1 heal应回复0")

    def test_ps1_cooldown_1(self):
        """PS1(130030) cooldown=1: 触发后设置冷却。"""
        self._reset_caster(hp=int(self.caster.max_hp * 0.5))
        self._reset_enemies()

        trigger_actions = self.ts.trigger_before_skill_use(
            self.caster, 120040, self.bf
        )
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130030]
        self.ss._execute_trigger_actions_inline(ps1_actions, self.bf, "before_skill_use")
        # 手动设置冷却（模拟 battle_flow_controller 的行为）
        self.ss.update_cooldown_after_skill_use(self.caster, 130030)

        self.assertEqual(self.caster.skill_cooldowns.get(130030), 1,
                         "PS1 cooldown应设置为1")

    def test_ps1_no_trigger_when_on_cooldown(self):
