    def test_as2_damage_enemy_single(self):
        """AS2(120040) Block1: 敌单体 damage。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120040, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证最近敌方 enemy_cf 受到伤害
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "enemy_cf应受到AS2伤害")
        # 验证仅单体受伤
        self.assertEqual(self.enemy_lf.current_hp, self.enemy_lf.max_hp,
                         "enemy_lf不应受到AS2伤害（单体）")
        self.assertEqual(self.enemy_rf.current_hp, self.enemy_rf.max_hp,
                         "enemy_rf不应受到AS2伤害（单体）")

    def test_as2_no_cooldown(self):
        """AS2(120040) cooldown=0: 施放后无冷却。"""
