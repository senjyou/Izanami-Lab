            caster=self.caster,
            skill_id=130118,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result2["success"])

        count_after_second = len([b for b in self.caster.buffs
                                  if b.effect_type == DEALT_DAMAGE])

        self.assertGreater(
            count_after_second, count_after_first,
            f"dmg_dealt_up应可叠加, 第一次后: {count_after_first}, 第二次后: {count_after_second}"
        )

    def test_ps_debuff_immune_blocks_one_debuff(self):
        """
        PS: Lv11+ debuff_immune阻止1次debuff
        技能描述: 自身に向けられるデバフを1つまで無効にするバフを付与する
        验证: 获得debuff_immune后，第1个debuff应被阻止
        """
        # 先触发PS获得debuff_immune
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=130118,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"])

        # 验证获得debuff_immune buff
        immune_buffs = [b for b in self.caster.buffs
                        if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertTrue(
            len(immune_buffs) > 0,
            f"PS触发后应获得debuff_immune buff, "
            f"实际buffs: {[(b.effect_type, getattr(b, 'hit_limited', None)) for b in self.caster.buffs]}"
        )

        # 验证hit_limited=1
        self.assertEqual(
            immune_buffs[0].hit_limited, 1,
            f"debuff_immune的hit_limited应为1, 实际: {immune_buffs[0].hit_limited}"
        )

    def test_ps_debuff_immune_consumed_after_blocking(self):
        """
        PS: debuff_immune阻止1次debuff后消失
        验证: 阻止1次debuff后，debuff_immune buff应被消费（hit_limited降为0并移除）
        """
        # 先触发PS获得debuff_immune
        self.ss.execute_skill(
            caster=self.caster,
            skill_id=130118,
            battlefield=self.bf,
            skip_cost=True,
        )

        # 确认有debuff_immune
        immune_count_before = len([b for b in self.caster.buffs
                                   if b.effect_type in ("debuff_immune", "DebuffImmune")])
        self.assertGreater(immune_count_before, 0, "应有debuff_immune buff")

        # 对施法者施加一个debuff（通过_apply_aura）
        class FakeEffect:
            effect_type = "spd_down"
            target_type = "self"
            value = 0.1
            value_tag = None
            value_source = None
            duration = 2
            duration_type = "action"
            duration_tag = None
            hit_count = None
            hit_count_tag = None
            condition = None
            flags = {"value_type": "percent"}
            ignore_defense = 0
            ignore_shield = 0
            target_identifier = None

        self.ss._apply_aura(self.caster, FakeEffect(), self.bf, is_debuff=True)

        # 验证debuff被阻止（施法者不应有spd_down debuff）
        spd_down_debuffs = [d for d in self.caster.debuffs
                            if d.effect_type == SET.STATUS_SPEED.value]
        self.assertEqual(
            len(spd_down_debuffs), 0,
            f"debuff_immune应阻止spd_down debuff, "
            f"实际debuffs: {[(d.effect_type, d.duration) for d in self.caster.debuffs]}"
        )

        # 验证debuff_immune被消费
        immune_count_after = len([b for b in self.caster.buffs
                                  if b.effect_type in ("debuff_immune", "DebuffImmune")])
        self.assertEqual(
            immune_count_after, 0,
            f"debuff_immune阻止1次debuff后应消失, 剩余: {immune_count_after}"
        )

    def test_ps_debuff_immune_not_consumed_by_own_attack(self):
        """
        PS: debuff_immune不应在施法者自身攻击后被消费
        场景: PS超集中赋予debuff_immune(hit_limited=1)后，施法者使用AS攻击敌人，
        debuff_immune应仍然存在（不被attack_limited消费），后续敌人施加debuff时应被阻止
        """
        # 触发PS获得debuff_immune
        self.ss.execute_skill(
            caster=self.caster,
            skill_id=130118,
            battlefield=self.bf,
            skip_cost=True,
        )

        # 确认有debuff_immune
        immune_before = [b for b in self.caster.buffs
                         if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertGreater(len(immune_before), 0, "PS触发后应有debuff_immune buff")

        # 施法者使用AS攻击敌人
        self.ss.execute_skill(
            caster=self.caster,
            skill_id=120109,
            battlefield=self.bf,
            skip_cost=True,
        )

        # 验证debuff_immune仍然存在（不被attack_limited消费）
        immune_after_attack = [b for b in self.caster.buffs
                               if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertEqual(
            len(immune_after_attack), 1,
            f"debuff_immune不应在施法者攻击后被消费, "
            f"剩余debuff_immune: {len(immune_after_attack)}"
        )

        # 敌人施加debuff，应被debuff_immune阻止
        class FakeEnemyDebuff:
            effect_type = "atk_down"
            target_type = "self"
            value = 0.1
            value_tag = None
            value_source = None
            duration = 2
            duration_type = "action"
            duration_tag = None
            hit_count = None
            hit_count_tag = None
            condition = None
            flags = {"value_type": "percent"}
            ignore_defense = 0
            ignore_shield = 0
            target_identifier = None

        self.ss._apply_aura(self.caster, FakeEnemyDebuff(), self.bf, is_debuff=True)

        # 验证debuff被阻止
        atk_down_debuffs = [d for d in self.caster.debuffs
                            if d.effect_type == STATUS_ATTACK]
        self.assertEqual(
            len(atk_down_debuffs), 0,
            f"debuff_immune应阻止atk_down debuff, "
            f"实际debuffs: {[(d.effect_type, d.duration) for d in self.caster.debuffs]}"
        )

        # 验证debuff_immune被消费（hit_limited降为0后移除）
        immune_after_block = [b for b in self.caster.buffs
                              if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertEqual(
            len(immune_after_block), 0,
            f"debuff_immune阻止1次debuff后应消失, 剩余: {len(immune_after_block)}"
        )

    def test_ps_debuff_immune_blocks_linked_mark_and_debuffs(self):
        """
        PS: debuff_immune免疫mark时，linked_mark的debuff也应被跳过
        场景: 敌方技能「攻撃魔法『ホーリーレイ』」赋予カースmark + atk_down(linked_mark=カース) + dmg_dealt_down(linked_mark=カース)
        当mark被debuff_immune免疫时，atk_down和dmg_dealt_down也不应施加
        """
        # 先触发PS获得debuff_immune
        self.ss.execute_skill(
            caster=self.caster,
            skill_id=130118,
            battlefield=self.bf,
            skip_cost=True,
        )

        # 确认有debuff_immune
        immune_before = [b for b in self.caster.buffs
                         if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertGreater(len(immune_before), 0, "PS触发后应有debuff_immune buff")

        # 施法者使用AS攻击敌人（debuff_immune不应被攻击消费）
        self.ss.execute_skill(
            caster=self.caster,
            skill_id=120109,
            battlefield=self.bf,
            skip_cost=True,
        )

        # 验证debuff_immune仍然存在
        immune_after_attack = [b for b in self.caster.buffs
                               if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertEqual(len(immune_after_attack), 1, "debuff_immune应在攻击后仍存在")

        # 模拟敌方技能220347施加カースmark（debuff形式）
        class FakeMarkEffect:
            effect_type = "mark"
            target_type = "self"
            value = None
            value_tag = None
            value_source = None
            duration = None
            duration_type = None
            duration_tag = None
            hit_count = None
            hit_count_tag = None
            condition = None
            flags = {"mark_name": "カース", "is_buff_mark": False}
            ignore_defense = 0
            ignore_shield = 0
            target_identifier = None

        # 敌方对施法者施加mark（is_debuff=True）
        self.ss._apply_aura(self.caster, FakeMarkEffect(), self.bf, is_debuff=True)

        # 验证mark被debuff_immune阻止
        curse_marks = [d for d in self.caster.debuffs
                       if d.effect_type == SkillEffectType.MARK.value
                       and getattr(d, 'name', '') == "カース"]
        self.assertEqual(
            len(curse_marks), 0,
            f"カースmark应被debuff_immune阻止, "
            f"实际debuffs: {[(d.effect_type, getattr(d, 'name', '')) for d in self.caster.debuffs]}"
        )

        # 验证debuff_immune被消费
        immune_after_mark = [b for b in self.caster.buffs
                             if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertEqual(len(immune_after_mark), 0, "debuff_immune应被消费")

        # 模拟敌方施加atk_down（linked_mark=カース）
        class FakeAtkDownEffect:
            effect_type = "atk_down"
            target_type = "self"
            value = 0.075
            value_tag = None
            value_source = None
            duration = None
            duration_type = None
            duration_tag = None
            hit_count = None
            hit_count_tag = None
            condition = None
            flags = {"value_type": "percent", "stackable": True, "linked_mark": "カース"}
            ignore_defense = 0
            ignore_shield = 0
            target_identifier = None

        self.ss._apply_aura(self.caster, FakeAtkDownEffect(), self.bf, is_debuff=True)

        # 验证atk_down也被跳过（因为linked_mark被免疫）
        atk_down_debuffs = [d for d in self.caster.debuffs
                            if d.effect_type == STATUS_ATTACK]
        self.assertEqual(
            len(atk_down_debuffs), 0,
            f"atk_down应因linked_mark被免疫而跳过, "
            f"实际debuffs: {[(d.effect_type, getattr(d, 'name', '')) for d in self.caster.debuffs]}"
        )

        # 模拟敌方施加dmg_dealt_down（linked_mark=カース）
        class FakeDmgDealtDownEffect:
            effect_type = "dmg_dealt_down"
            target_type = "self"
            value = 0.075
            value_tag = None
            value_source = None
            duration = None
            duration_type = None
            duration_tag = None
            hit_count = None
            hit_count_tag = None
            condition = None
            flags = {"value_type": "percent", "stackable": True, "linked_mark": "カース"}
            ignore_defense = 0
            ignore_shield = 0
            target_identifier = None

        self.ss._apply_aura(self.caster, FakeDmgDealtDownEffect(), self.bf, is_debuff=True)

        # 验证dmg_dealt_down也被跳过
        dmg_dealt_down_debuffs = [d for d in self.caster.debuffs
                                  if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(
            len(dmg_dealt_down_debuffs), 0,
            f"dmg_dealt_down应因linked_mark被免疫而跳过, "
            f"实际debuffs: {[(d.effect_type, getattr(d, 'name', '')) for d in self.caster.debuffs]}"
        )

    def test_ps_atk_up_is_attack_limited(self):
        """
        PS: atk_up为攻击限定（attack_limited）
        验证: atk_up buff的update_timing应为ATTACK，攻击后应被消费
        """
        # 触发PS
        self.ss.execute_skill(
            caster=self.caster,
            skill_id=130118,
            battlefield=self.bf,
            skip_cost=True,
        )

        # 验证atk_up存在
        atk_up_buffs = [b for b in self.caster.buffs
                        if b.effect_type == STATUS_ATTACK]
        self.assertTrue(len(atk_up_buffs) > 0, "应有StatusAttack buff")

        # 执行一次AS攻击
        self.ss.execute_skill(
            caster=self.caster,
            skill_id=120109,
            battlefield=self.bf,
            skip_cost=True,
        )

        # 验证atk_up已被消费（attack_limited在攻击后消费）
        atk_up_after = [b for b in self.caster.buffs
                        if b.effect_type == STATUS_ATTACK]
        self.assertEqual(
            len(atk_up_after), 0,
            f"atk_up应在攻击后被消费(attack_limited), "
            f"剩余atk_up: {len(atk_up_after)}"
        )


if __name__ == "__main__":
    unittest.main()
