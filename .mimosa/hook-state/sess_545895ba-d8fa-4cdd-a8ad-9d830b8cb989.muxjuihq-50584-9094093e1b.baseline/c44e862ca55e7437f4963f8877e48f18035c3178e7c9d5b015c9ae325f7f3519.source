    def test_ps_atk_up_on_before_skill_use(self):
        """
        PS: before_skill_use触发atk_up
        技能描述: 自身がアクティブスキルで攻撃する前に発動。攻撃力を上昇させる
        验证: 执行PS后，应获得atk_up buff（映射为StatusAttack，attack_limited）
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=130118,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"PS技能执行应成功: {result.get('error', '')}")

        # 验证获得atk_up buff (映射后为StatusAttack)
        atk_up_buffs = [b for b in self.caster.buffs
                        if b.effect_type == STATUS_ATTACK]
        self.assertTrue(
            len(atk_up_buffs) > 0,
            f"PS触发后应获得StatusAttack buff, "
            f"实际buffs: {[(b.effect_type, b.duration) for b in self.caster.buffs]}"
        )

        # 验证duration_type为attack（attack_limited）
        atk_buff = atk_up_buffs[0]
        self.assertEqual(
            atk_buff.attack_limited, 1,
            f"atk_up应为attack_limited(攻击限定, attack_limited=1), "
            f"实际attack_limited: {atk_buff.attack_limited}"
        )

    def test_ps_dmg_dealt_up_stackable(self):
        """
        PS: Lv11+ dmg_dealt_up可叠加
        技能描述: 与ダメージを増加させるバフ（重複可）
        验证: 多次触发PS时，dmg_dealt_up应叠加
        """
