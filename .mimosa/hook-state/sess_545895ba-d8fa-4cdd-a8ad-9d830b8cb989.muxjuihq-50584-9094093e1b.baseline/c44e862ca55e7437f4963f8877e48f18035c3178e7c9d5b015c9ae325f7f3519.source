#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""角色100302 蒼き穹舞うフラットスピン 技能效果集成测试

测试场景：
- 角色: 蒼き穹舞うフラットスピン (character_id=100302, 光属性=5, 物理型=3, 後列)
- EX: 110049 新たなる力 (最低HP比例敌单体攻击, 击杀时EP充满, Lv11+: 目标生存时追加target_lost_hp伤害上限ATK*80%)
- AS1: 120108 フラットスピン (最高ATK敌单体攻击, 削1AP, 目标有debuff时重置超集中冷却)
- AS2: 120109 スカイドライヴ (敌单体攻击, 目标有debuff时追加攻击)
- AS3: 120110 ハードラッシュ (敌单体2hit攻击, Lv11+: 目标有debuff时降低与伤害stackable)
- PS: 130118 超集中 (before_skill_use触发, atk_up攻击限定, dmg_dealt_up攻击限定stackable, debuff_immune 1次)
"""

import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService

# 常用枚举值简写
SET = SkillEffectType
STATUS_ATTACK = SET.STATUS_ATTACK.value       # atk_up映射后的值
DEALT_DAMAGE = SET.DEALT_DAMAGE.value         # dmg_dealt_up/dmg_dealt_down映射后的值
POISON = SET.POISON.value


def _make_poison_debuff(unit_id, duration=3):
    """创建一个毒debuff（用于测试target_has_status_ailment条件）"""
    return BuffState(
        buff_id=f"test_poison_{unit_id}",
        name="毒",
        effect_type=POISON,
        value=100.0,
        duration=duration,
        timing_type=2,  # 行动制
        source_unit_id=unit_id,
        is_debuff=True,
    )


class TestActor100302(unittest.TestCase):
    """角色100302 蒼き穹舞うフラットスピン 技能效果集成测试"""

    @classmethod
    def setUpClass(cls):
        """加载游戏数据（所有测试共享）"""
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        """每个测试前创建战场和服务"""
        self.bf = BattlefieldState()

        # 蒼き穹舞うフラットスピン (光属性=5, 物理型=3, 后排)
        self.caster = UnitState(
            unit_id="ally_momoka", name="光桃", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=100302, level=200,
            element=5, character_type=3,
            max_hp=120000, current_hp=120000,
            attack=150000, defense=50000, speed=1000,
            crit_rate=0.00, crit_damage=0.5, advantage_damage=0.0,  # crit_rate=0避免暴击影响测试
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=50,
            skills=[110049, 120108, 120109, 120110, 130118],
            skill_levels={110049: 15, 120108: 15, 120109: 15, 120110: 15, 130118: 15},
            skill_cooldowns={},
        )

        # 敌方A (低ATK, 高HP比例)
        self.enemy_low_atk = UnitState(
            unit_id="enemy_low_atk", name="敵A(低ATK)", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999001, level=200,
            element=1, character_type=1,
            max_hp=500000, current_hp=500000,
            attack=30000, defense=30000, speed=500,
            crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方B (高ATK, 高HP比例) - 用于测试highest_atk索敌
        self.enemy_high_atk = UnitState(
            unit_id="enemy_high_atk", name="敵B(高ATK)", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999002, level=200,
            element=1, character_type=1,
            max_hp=500000, current_hp=500000,
            attack=80000, defense=30000, speed=400,
            crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方C (低HP比例) - 用于测试lowest_hp_priority索敌
        self.enemy_low_hp = UnitState(
            unit_id="enemy_low_hp", name="敵C(低HP)", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999003, level=200,
            element=1, character_type=1,
            max_hp=500000, current_hp=100000,  # HP比例20%
            attack=50000, defense=30000, speed=300,
            crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方后排
        self.enemy_back = UnitState(
            unit_id="enemy_back", name="敵D(後列)", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=999004, level=200,
            element=1, character_type=1,
            max_hp=500000, current_hp=500000,
            attack=50000, defense=30000, speed=600,
            crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.add_unit(self.caster)
        self.bf.add_unit(self.enemy_low_atk)
        self.bf.add_unit(self.enemy_high_atk)
        self.bf.add_unit(self.enemy_low_hp)
        self.bf.add_unit(self.enemy_back)

        # 创建服务
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.asvc = AuraService()
        self.dmgsvc = DamageService()
        self.tgtsvc = TargetService()
        self.stsvc = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgtsvc,
            damage_service=self.dmgsvc,
            aura_service=self.asvc,
            status_service=self.stsvc,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

    # ============================================================
    # EX: 110049 新たなる力
    # ============================================================

    def test_ex_lowest_hp_priority_targeting(self):
        """
        EX: 最低HP比例索敌
        技能描述: 最もHP割合が低い敵単体に攻撃
        验证: 应选择HP比例最低的敌方(enemy_low_hp, 20%)作为目标
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110049,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(len(damage_effects) > 0, "EX技能应造成伤害")

        # 验证目标为HP比例最低的敌方
        target_ids = set()
        for dmg in damage_effects:
            for t in dmg.get("targets", []):
                target_ids.add(t.get("target_id"))

        self.assertIn(
            self.enemy_low_hp.unit_id, target_ids,
            f"EX技能应选择HP比例最低的敌方({self.enemy_low_hp.name}), "
            f"实际目标: {target_ids}"
        )

    def test_ex_add_ep_on_kill(self):
        """
        EX: 击杀时EP充满
        技能描述: このスキルによって対象を倒した場合、自身のEXゲージを満タンの状態にする
        验证: 击杀目标后，施法者EP应充满至max_ep
        """
        # 将低HP敌人设为可击杀状态
        self.enemy_low_hp.current_hp = 1
        max_ep = self.caster.max_extra_point

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110049,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证目标被击杀
        self.assertFalse(
            self.enemy_low_hp.is_alive,
            "低HP敌人应被击杀"
        )

        # 验证EP充满
        self.assertEqual(
            self.caster.current_ep, max_ep,
            f"击杀后EP应充满至{max_ep}, 实际: {self.caster.current_ep}"
        )

    def test_ex_no_ep_fill_on_survive(self):
        """
        EX: 目标生存时不充EP
        验证: 未击杀目标时，EP不应充满
        """
        # 敌人HP充足不会被击杀
        self.enemy_low_hp.current_hp = 500000
        max_ep = self.caster.max_extra_point

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110049,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 目标应存活
        self.assertTrue(
            self.enemy_low_hp.is_alive,
            "高HP敌人应存活"
        )

        # EP不应充满
        self.assertLess(
            self.caster.current_ep, max_ep,
            f"目标存活时EP不应充满, 当前EP: {self.caster.current_ep}, max_ep: {max_ep}"
        )

    def test_ex_hp_ratio_damage_on_survived(self):
        """
        EX: Lv11+ 目标生存时追加target_lost_hp伤害
        技能描述: 攻撃後に対象が生存していた場合、対象の失ったHP×威力2%のダメージを与える
        验证: 目标存活时应追加基于已损HP的伤害
        """
        # 设置敌人已损HP，但HP足够高不会被第一段伤害击杀
        # 第一段伤害约 ATK*(power/100) - DEF ≈ 150000*1.794 - 30000 ≈ 240000
        # 设置HP=450000，已损50000，第一段后剩余约210000，存活
        self.enemy_low_hp.current_hp = 450000

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110049,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证目标存活
        self.assertTrue(
            self.enemy_low_hp.is_alive,
            f"目标应存活以触发追加伤害, 当前HP: {self.enemy_low_hp.current_hp}"
        )

        # 验证存在hp_ratio_damage效果
        hp_ratio_effects = [e for e in result.get("effects_applied", [])
                            if e.get("effect_type") == "hp_ratio_damage"]
        self.assertTrue(
            len(hp_ratio_effects) > 0,
            "Lv11+目标存活时应追加hp_ratio_damage效果"
        )

    def test_ex_hp_ratio_damage_cap_atk_80pct(self):
        """
        EX: 追加伤害上限为ATK*80%
        技能描述: 追加攻撃によるダメージは自身の攻撃力×80%を上限とする
        验证: 追加伤害的raw_power不应超过施法者ATK*80%
        """
        # 设置敌人已损HP很大，使追加伤害触发上限
        self.enemy_low_hp.current_hp = 450000
        atk_cap = self.caster.attack * 0.8  # 120000

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110049,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证追加伤害不超过ATK*80%
        hp_ratio_effects = [e for e in result.get("effects_applied", [])
                            if e.get("effect_type") == "hp_ratio_damage"]
        if hp_ratio_effects:
            for eff in hp_ratio_effects:
                for t in eff.get("targets", []):
                    damage = t.get("damage", 0)
                    # 追加伤害应不超过ATK*80%（考虑防御减伤后可能更低）
                    self.assertLessEqual(
                        damage, atk_cap,
                        f"追加伤害{damage}不应超过ATK*80%={atk_cap}"
                    )

    def test_ex_no_hp_ratio_damage_on_kill(self):
        """
        EX: 击杀时不触发追加伤害
        验证: 击杀目标后，不应追加hp_ratio_damage
        """
        self.enemy_low_hp.current_hp = 1  # 可击杀

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110049,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 击杀后不应有hp_ratio_damage
        hp_ratio_effects = [e for e in result.get("effects_applied", [])
                            if e.get("effect_type") == "hp_ratio_damage"]
        self.assertEqual(
            len(hp_ratio_effects), 0,
            "击杀目标后不应追加hp_ratio_damage"
        )

    # ============================================================
    # AS1: 120108 フラットスピン
    # ============================================================

    def test_as1_highest_atk_targeting(self):
        """
        AS1: 最高ATK索敌
        技能描述: 攻撃力が最も高い敵単体に攻撃
        验证: 应选择ATK最高的敌方(enemy_high_atk, ATK=80000)作为目标
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120108,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(len(damage_effects) > 0, "AS1技能应造成伤害")

        # 验证目标为ATK最高的敌方
        target_ids = set()
        for dmg in damage_effects:
            for t in dmg.get("targets", []):
                target_ids.add(t.get("target_id"))

        self.assertIn(
            self.enemy_high_atk.unit_id, target_ids,
            f"AS1技能应选择ATK最高的敌方({self.enemy_high_atk.name}), "
            f"实际目标: {target_ids}"
        )

    def test_as1_remove_ap(self):
        """
        AS1: 削1AP
        技能描述: 対象のAPを1削る
        验证: 目标AP应减少1
        """
        initial_ap = self.enemy_high_atk.current_ap

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120108,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        ap_change = initial_ap - self.enemy_high_atk.current_ap
        self.assertGreaterEqual(
            ap_change, 1,
            f"目标({self.enemy_high_atk.name})的AP应至少减少1, "
            f"初始AP={initial_ap}, 当前AP={self.enemy_high_atk.current_ap}"
        )

    def test_as1_reset_cooldown_when_target_has_status_ailment(self):
        """
        AS1: 目标有异常状态时重置超集中冷却
        技能描述: 対象が状態異常だった場合、「超集中」のクールタイムを解除する
        验证: 目标有异常状态(毒)时，130118的冷却应被重置
        """
        # 给目标添加异常状态(毒)
        self.enemy_high_atk.debuffs.append(
            _make_poison_debuff(self.caster.unit_id)
        )

        # 设置130118在冷却中
        self.caster.skill_cooldowns[130118] = 1

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120108,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # 验证130118冷却被重置
        self.assertNotIn(
            130118, self.caster.skill_cooldowns,
            f"目标有异常状态时，超集中(130118)的冷却应被重置, "
            f"当前冷却: {self.caster.skill_cooldowns}"
        )

    def test_as1_no_reset_cooldown_when_target_no_debuff(self):
        """
        AS1: 目标无debuff时不重置超集中冷却
        验证: 目标无debuff时，130118的冷却不应被重置
        """
        # 确保目标无debuff
        self.enemy_high_atk.debuffs = []

        # 设置130118在冷却中
        self.caster.skill_cooldowns[130118] = 1

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120108,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # 验证130118冷却未被重置
        self.assertIn(
            130118, self.caster.skill_cooldowns,
            f"目标无debuff时，超集中(130118)的冷却不应被重置, "
            f"当前冷却: {self.caster.skill_cooldowns}"
        )

    def test_as1_no_reset_cooldown_when_target_has_non_ailment_debuff(self):
        """
        AS1: 目标只有非异常状态debuff时不重置超集中冷却
        验证: 異常状態≠debuff，非异常状态debuff（如spd_down）不应触发条件
        """
        # 给目标添加非异常状态debuff（spd_down不是异常状态）
        self.enemy_high_atk.debuffs.append(BuffState(
            buff_id="test_spd_down", name="减速",
            effect_type=SET.STATUS_SPEED.value,
            value=0.2, duration=3, timing_type=2,
            source_unit_id=self.caster.unit_id, is_debuff=True,
        ))

        # 设置130118在冷却中
        self.caster.skill_cooldowns[130118] = 1

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120108,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # 验证130118冷却未被重置（spd_down不是异常状态）
        self.assertIn(
            130118, self.caster.skill_cooldowns,
            f"目标只有非异常状态debuff时，超集中(130118)的冷却不应被重置, "
            f"当前冷却: {self.caster.skill_cooldowns}"
        )

    # ============================================================
    # AS2: 120109 スカイドライヴ
    # ============================================================

    def test_as2_base_damage_no_debuff(self):
        """
        AS2: 无异常状态时仅基础攻击
        技能描述: 敵単体に威力{威力}で攻撃する
        验证: 目标无异常状态时，只有1次伤害效果
        """
        # 确保所有目标无debuff
        self.enemy_low_atk.debuffs = []
        self.enemy_high_atk.debuffs = []
        self.enemy_low_hp.debuffs = []
        self.enemy_back.debuffs = []

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120109,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS2技能执行应成功: {result.get('error', '')}")

        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertEqual(
            len(damage_effects), 1,
            f"目标无异常状态时应有1次伤害效果, 实际: {len(damage_effects)}"
        )

    def test_as2_additional_damage_when_target_has_status_ailment(self):
        """
        AS2: 目标有异常状态时追加攻击
        技能描述: 対象が状態異常だった場合、さらに威力{威力2}で追加攻撃する
        验证: 目标有异常状态(毒)时，应有2次伤害效果
        """
        # AS2默认选前排中间(enemy_high_atk)，给该目标添加异常状态(毒)
        self.enemy_high_atk.debuffs.append(
            _make_poison_debuff(self.caster.unit_id)
        )

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120109,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS2技能执行应成功: {result.get('error', '')}")

        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertEqual(
            len(damage_effects), 2,
            f"目标有异常状态时应有2次伤害效果(基础+追加), 实际: {len(damage_effects)}"
        )

    def test_as2_no_additional_damage_when_target_has_non_ailment_debuff(self):
        """
        AS2: 目标只有非异常状态debuff时不追加攻击
        验证: 異常状態≠debuff，非异常状态debuff（如spd_down）不应触发追加攻击
        """
        # 给目标添加非异常状态debuff（spd_down不是异常状态）
        self.enemy_high_atk.debuffs.append(BuffState(
            buff_id="test_spd_down", name="减速",
            effect_type=SET.STATUS_SPEED.value,
            value=0.2, duration=3, timing_type=2,
            source_unit_id=self.caster.unit_id, is_debuff=True,
        ))

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120109,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS2技能执行应成功: {result.get('error', '')}")

        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertEqual(
            len(damage_effects), 1,
            f"目标只有非异常状态debuff时应有1次伤害效果, 实际: {len(damage_effects)}"
        )

