    def test_as3_two_hit_damage(self):
        """
        AS3: 2hit攻击
        技能描述: 敵単体に威力{威力}で2ヒット攻撃する
        验证: 伤害结果中应有2个hit
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120110,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS3技能执行应成功: {result.get('error', '')}")

        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(len(damage_effects) > 0, "AS3技能应造成伤害")

        # 验证目标有2个hit
        first_damage = damage_effects[0]
        targets = first_damage.get("targets", [])
        self.assertTrue(len(targets) > 0, "应有伤害目标")
        hits = targets[0].get("hits", [])
        self.assertEqual(
            len(hits), 2,
            f"AS3应为2hit攻击, 实际hits: {hits}"
        )

    def test_as3_dmg_dealt_down_when_target_has_status_ailment(self):
        """
        AS3: Lv11+ 目标有异常状态时降低与伤害(stackable)
        技能描述: 対象が状態異常だった場合、1行動の間対象の与ダメージを減少させるデバフを付与する（重複可）
        验证: 目标有异常状态(毒)时，应获得dmg_dealt_down debuff
        """
        # AS3默认选前排中间(enemy_high_atk)，给该目标添加异常状态(毒)
        self.enemy_high_atk.debuffs.append(
            _make_poison_debuff(self.caster.unit_id)
        )

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120110,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS3技能执行应成功: {result.get('error', '')}")

        # 验证目标获得dmg_dealt_down debuff (映射后为DealtDamage)
        dmg_down_debuffs = [d for d in self.enemy_high_atk.debuffs
                            if d.effect_type == DEALT_DAMAGE]
        self.assertTrue(
            len(dmg_down_debuffs) > 0,
            f"目标有异常状态时应获得DealtDamage debuff, "
            f"实际debuffs: {[(d.effect_type, d.duration) for d in self.enemy_high_atk.debuffs]}"
        )

        # 验证持续1行动
        self.assertEqual(
            dmg_down_debuffs[0].duration, 1,
            f"dmg_dealt_down持续应为1行动, 实际: {dmg_down_debuffs[0].duration}"
        )

    def test_as3_no_dmg_dealt_down_when_target_no_debuff(self):
        """
        AS3: 目标无异常状态时不降低与伤害
        验证: 目标无异常状态时，不应获得dmg_dealt_down debuff
