    def test_as3_dmg_dealt_down_stackable(self):
        """
        AS3: dmg_dealt_down可叠加
        技能描述: 重複可
        验证: 多次施加dmg_dealt_down时应叠加而非替换
        """
        # AS3默认选前排中间(enemy_high_atk)，给该目标添加debuff（触发条件）
        self.enemy_high_atk.debuffs.append(
            _make_poison_debuff(self.caster.unit_id, duration=10)
        )

        # 第一次执行
        result1 = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120110,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result1["success"])

        # 检查第一次后的DealtDamage debuff数量
        count_after_first = len([d for d in self.enemy_high_atk.debuffs
                                 if d.effect_type == DEALT_DAMAGE])

        # 第二次执行
        result2 = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120110,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result2["success"])

        # 检查第二次后的DealtDamage debuff数量（应增加）
        count_after_second = len([d for d in self.enemy_high_atk.debuffs
                                  if d.effect_type == DEALT_DAMAGE])

        self.assertGreater(
            count_after_second, count_after_first,
            f"dmg_dealt_down应可叠加, 第一次后: {count_after_first}, 第二次后: {count_after_second}"
        )

