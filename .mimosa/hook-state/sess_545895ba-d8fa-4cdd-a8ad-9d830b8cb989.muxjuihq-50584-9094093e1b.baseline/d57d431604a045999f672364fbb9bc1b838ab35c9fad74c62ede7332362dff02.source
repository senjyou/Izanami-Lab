"""Regression: 運ではなく実力で (130120/230271/230302) self-guard not working.

Bug 1 (230271/230302): Missing global_condition caused _is_cover_ps to misidentify
        the skill as a cover PS. With no ally to protect, BEFORE_ANY_ATTACKED trigger
        was blocked, so the guard never applied.
Bug 2 (130120): duration_type="attacker_action" routed the guard to the special
        mechanism (unit.guard_active), but _get_guard_multiplier only applies
        guard_active for is_cover_damage=True. Since 130120 is a self-guard (not
        cover), the guard never reduced damage.
Fix: All three skills now use legacy buff mechanism (duration_type=null,
     flags.attack_limited=1) with global_condition and(target_is_self + actor_character_type:2).
"""
import unittest
import sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.skill_data_resolver import SkillDataResolver

GUARD = SkillEffectType.GUARD.value
_EN_AS = 120001  # generic EN damage AS for testing


def _make_unit(side, unit_id, name, skills, level=15, character_type=1,
               hp=100000, atk=10000, defense=2000, position=None):
    if side == Side.ALLY:
        pos = position or Position.ALLY_CENTER_FRONT
    else:
        pos = position or Position.ENEMY_CENTER_FRONT
    skill_levels = {sid: level for sid in skills}
    return UnitState(
        unit_id=unit_id, name=name, side=side,
        position=pos, character_id=999900 + hash(unit_id) % 100, level=level,
        element=2, character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=500,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=10, current_ep=10,
        skills=skills, skill_levels=skill_levels, skill_cooldowns={},
    )


class TestRegUnarakoGuard(unittest.TestCase):

    def setUp(self):
        self.bb = BattleBuilder()
        # Use bb.build() to get the data_loader & services
        self.bb.add_ally(unit_id="dummy", hp=1)  # placeholder
        self.bb.add_enemy(unit_id="dummy_e", hp=1)
        ctx = self.bb.build()
        self.dl = ctx['services']['dl']
        self.ss = ctx['ss']
        self.ts = ctx['ts']
        self.dms = ctx['dms']
        self.resolver = SkillDataResolver(self.dl)

    def _resolve_as(self, level=15):
        return self.resolver.resolve(_EN_AS, skill_level=level)

    def test_ally_130120_reduces_damage_by_75pct_at_lv15(self):
        """130120 (ally self-guard) should reduce EN attack damage by 75% at Lv15."""
        guard_owner = _make_unit(Side.ALLY, "ally_guard", "guard持有者",
                                  skills=[130120], level=15, character_type=1)
        en_attacker = _make_unit(Side.ENEMY, "enemy_en", "EN攻击者",
                                  skills=[_EN_AS], level=15, character_type=2)
        bf = BattlefieldState()
        bf.friend_team = [guard_owner]
        bf.enemy_team = [en_attacker]
        as_data = self._resolve_as(15)

        # Baseline damage without guard
        guard_owner.buffs.clear()
        guard_owner.guard_active = False
        guard_owner.guard_rate = 0.0
        base = self.dms.calculate_damage(en_attacker, guard_owner, as_data).total_damage
        self.assertGreater(base, 0)

        # Apply 130120 guard via trigger
        guard_owner.buffs.clear()
        guard_owner.guard_active = False
        guard_owner.guard_rate = 0.0
        actions = self.ts.trigger_before_any_attacked(
            targets=[guard_owner], battlefield=bf, attacker=en_attacker
        )
        ps_actions = [a for a in actions if a.skill_id == 130120]
        self.assertGreater(len(ps_actions), 0, "130120 should trigger on EN attacker")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_any_attacked"
        )

        # Verify guard buff is added (legacy buff mechanism)
        guard_buffs = [b for b in guard_owner.buffs if b.effect_type == GUARD]
        self.assertGreater(len(guard_buffs), 0, "guard buff should be applied")
        self.assertAlmostEqual(guard_buffs[0].value, 75.0, places=1,
                               msg="guard value should be 75.0%% at Lv15")

        # Damage WITH guard should be ~25% of baseline (75% reduction)
        guarded = self.dms.calculate_damage(en_attacker, guard_owner, as_data).total_damage
        expected = base * 0.25
        self.assertAlmostEqual(guarded, expected, delta=expected * 0.1,
                               msg=f"guard should reduce damage by 75%: base={base}, "
                                   f"expected~{expected:.0f}, got={guarded}")

    def test_enemy_230271_reduces_damage_by_75pct_at_lv15(self):
        """230271 (enemy self-guard) should reduce EN attack damage by 75% at Lv15.

        Bug: Missing global_condition caused _is_cover_ps to misidentify this as a
        cover PS, blocking the trigger when no ally is available to protect.
        """
        en_attacker = _make_unit(Side.ALLY, "ally_en", "EN攻击者",
                                  skills=[_EN_AS], level=15, character_type=2)
        guard_owner = _make_unit(Side.ENEMY, "enemy_guard", "敌方guard持有者",
                                  skills=[230271], level=15, character_type=1)
        bf = BattlefieldState()
        bf.friend_team = [en_attacker]
        bf.enemy_team = [guard_owner]
        as_data = self._resolve_as(15)

        # Baseline damage without guard
        guard_owner.buffs.clear()
        guard_owner.guard_active = False
        guard_owner.guard_rate = 0.0
        base = self.dms.calculate_damage(en_attacker, guard_owner, as_data).total_damage
        self.assertGreater(base, 0)

        # Apply 230271 guard via trigger
        guard_owner.buffs.clear()
        guard_owner.guard_active = False
        guard_owner.guard_rate = 0.0
        actions = self.ts.trigger_before_any_attacked(
            targets=[guard_owner], battlefield=bf, attacker=en_attacker
        )
        ps_actions = [a for a in actions if a.skill_id == 230271]
        self.assertGreater(len(ps_actions), 0,
                           "230271 should trigger (was blocked by _is_cover_ps before fix)")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_any_attacked"
        )

        # Verify guard buff
        guard_buffs = [b for b in guard_owner.buffs if b.effect_type == GUARD]
        self.assertGreater(len(guard_buffs), 0, "guard buff should be applied")

        # Damage WITH guard should be ~25% of baseline (75% reduction)
        guarded = self.dms.calculate_damage(en_attacker, guard_owner, as_data).total_damage
        expected = base * 0.25
        self.assertAlmostEqual(guarded, expected, delta=expected * 0.1,
                               msg=f"230271 guard should reduce damage by 75%: "
                                   f"base={base}, expected~{expected:.0f}, got={guarded}")

    def test_enemy_230302_reduces_damage_by_75pct_at_lv15(self):
        """230302 (enemy self-guard, variant) should reduce EN attack damage by 75%."""
        en_attacker = _make_unit(Side.ALLY, "ally_en", "EN攻击者",
                                  skills=[_EN_AS], level=15, character_type=2)
        guard_owner = _make_unit(Side.ENEMY, "enemy_guard", "敌方guard持有者",
                                  skills=[230302], level=15, character_type=1)
        bf = BattlefieldState()
        bf.friend_team = [en_attacker]
        bf.enemy_team = [guard_owner]
        as_data = self._resolve_as(15)

        guard_owner.buffs.clear()
        base = self.dms.calculate_damage(en_attacker, guard_owner, as_data).total_damage
        self.assertGreater(base, 0)

        guard_owner.buffs.clear()
        actions = self.ts.trigger_before_any_attacked(
            targets=[guard_owner], battlefield=bf, attacker=en_attacker
        )
        ps_actions = [a for a in actions if a.skill_id == 230302]
        self.assertGreater(len(ps_actions), 0, "230302 should trigger")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_any_attacked"
        )

        guarded = self.dms.calculate_damage(en_attacker, guard_owner, as_data).total_damage
        expected = base * 0.25
        self.assertAlmostEqual(guarded, expected, delta=expected * 0.1,
                               msg=f"230302 guard should reduce damage by 75%")

    def test_130120_does_not_trigger_on_physical_attacker(self):
        """130120 should NOT trigger when a physical-type (character_type=1) enemy attacks."""
        guard_owner = _make_unit(Side.ALLY, "ally_guard", "guard持有者",
                                  skills=[130120], level=15, character_type=1)
        phys_attacker = _make_unit(Side.ENEMY, "enemy_phys", "物理攻击者",
                                    skills=[_EN_AS], level=15, character_type=1)
        bf = BattlefieldState()
        bf.friend_team = [guard_owner]
        bf.enemy_team = [phys_attacker]

        actions = self.ts.trigger_before_any_attacked(
            targets=[guard_owner], battlefield=bf, attacker=phys_attacker
        )
        ps_triggered = any(a.skill_id == 130120 for a in actions)
        self.assertFalse(ps_triggered,
                         "130120 should NOT trigger on physical-type attacker")

    def test_130120_does_not_trigger_when_ally_is_attacked(self):
        """130120 should NOT trigger when an ally (not self) is the attack target."""
        guard_owner = _make_unit(Side.ALLY, "ally_guard", "guard持有者",
                                  skills=[130120], level=15, character_type=1,
                                  position=Position.ALLY_LEFT_FRONT)
        other_ally = _make_unit(Side.ALLY, "ally_other", "其他友方",
                                 skills=[], level=15, character_type=1,
                                 position=Position.ALLY_CENTER_FRONT)
        en_attacker = _make_unit(Side.ENEMY, "enemy_en", "EN攻击者",
                                  skills=[_EN_AS], level=15, character_type=2)
        bf = BattlefieldState()
        bf.friend_team = [guard_owner, other_ally]
        bf.enemy_team = [en_attacker]

        # Attacker targets other_ally (not guard_owner)
        actions = self.ts.trigger_before_any_attacked(
            targets=[other_ally], battlefield=bf, attacker=en_attacker
        )
        ps_triggered = any(a.skill_id == 130120 for a in actions)
        self.assertFalse(ps_triggered,
                         "130120 should NOT trigger when ally (not self) is attacked")


if __name__ == '__main__':
    unittest.main(verbosity=2)
