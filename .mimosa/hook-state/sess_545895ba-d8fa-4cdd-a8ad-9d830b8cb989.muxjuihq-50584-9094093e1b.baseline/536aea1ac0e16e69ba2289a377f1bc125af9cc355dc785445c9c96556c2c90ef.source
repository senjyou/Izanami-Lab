"""
回归测试: HP比例伤害/特殊伤害/OVERKILL伤害的计分统计追踪

Bug: 角色 心色見つめるムードメーカー 在战术演习模式无法正常结算伤害统计。
     技能 120155 苦手なのはそこだね！(hp_ratio_damage, target_current_hp)的HP百分比伤害
     未被 scoring_tracker.record_damage 记录，导致计分统计中该角色伤害显示为0。

根因: skill_service.py 的 _apply_hp_ratio_damage (L7674) 和 _apply_damage_special (L7895)
     以及 OVERKILL 路径 (L2870) 仅更新了 caster.damage_dealt_total / target.damage_taken_total，
     缺少 scoring_tracker.record_damage 调用。而普通damage路径 (L3179) 既有 damage_dealt_total
     更新也有 scoring_tracker.record_damage 调用。

修复: 在三处伤害路径中添加 scoring_tracker.record_damage 调用，
     与普通damage路径保持一致。
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.scoring_tracker import ScoringTracker


def _make_ally_unit(unit_id, name, position, **kwargs):
    defaults = dict(
        side=Side.ALLY, character_id=145301, level=10,
        element=4, character_type=3,
        max_hp=15000, current_hp=15000,
        attack=6000, defense=4000, speed=480,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=2, initial_passive_point=2, max_extra_point=0,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )
    defaults.update(kwargs)
    return UnitState(unit_id=unit_id, name=name, position=position, **defaults)


def _make_enemy_unit(unit_id, name, position, **kwargs):
    defaults = dict(
        side=Side.ENEMY, character_id=999001, level=10,
        element=2, character_type=1,
        max_hp=50000, current_hp=50000,
        attack=1000, defense=1000, speed=300,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )
    defaults.update(kwargs)
    return UnitState(unit_id=unit_id, name=name, position=position, **defaults)


class TestRegScoringTrackerHpRatioDamage(unittest.TestCase):
    """HP比例伤害/特殊伤害/OVERKILL伤害的计分统计追踪"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.tracker = ScoringTracker()
        self.bf.scoring_tracker = self.tracker

        # 己方: 心色見つめるムードメーカー (持有120155 苦手なのはそこだね！)
        self.caster = _make_ally_unit(
            "ally_caster", "エレーナ", Position.ALLY_CENTER_FRONT,
            attack=6000,
            skills=[120155], skill_levels={120155: 10},
        )

        # 敌方: 高HP目标 (确保HP比例伤害有显著数值)
        self.enemy = _make_enemy_unit(
            "enemy_target", "敌方目标", Position.ENEMY_CENTER_FRONT,
            max_hp=100000, current_hp=100000,
        )

        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

    def test_hp_ratio_damage_tracked_by_scoring_tracker(self):
        """
        HP比例伤害(120155苦手なのはそこだね！)应被scoring_tracker记录。
        技能: 对象当前HP×12%伤害，上限自身ATK×30%。
        敌方HP=100000, 12%=12000, ATK=6000, cap=1800 => 实际伤害=1800
        """
        enemy_hp_before = self.enemy.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120155,
            battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证伤害确实造成了
        enemy_hp_loss = enemy_hp_before - self.enemy.current_hp
        self.assertGreater(enemy_hp_loss, 0, "敌方应受到HP比例伤害")

        # 验证scoring_tracker记录了伤害
        caster_stats = self.tracker._unit_stats.get(self.caster.unit_id)
        self.assertIsNotNone(caster_stats, "scoring_tracker应记录施法者统计")
        self.assertGreater(caster_stats.damage_dealt, 0,
                           "HP比例伤害应被scoring_tracker记录到damage_dealt")

        # 验证数值一致
        self.assertEqual(caster_stats.damage_dealt, enemy_hp_loss,
                         "scoring_tracker的damage_dealt应与敌方HP减少量一致")

        # 验证敌方受到伤害也记录了
        enemy_stats = self.tracker._unit_stats.get(self.enemy.unit_id)
        self.assertIsNotNone(enemy_stats, "scoring_tracker应记录敌方统计")
        self.assertEqual(enemy_stats.damage_received, enemy_hp_loss,
                         "scoring_tracker的damage_received应与HP减少量一致")

        # 验证总伤害得分计入
        expected_score = self.tracker.get_current_score()
        self.assertEqual(expected_score, enemy_hp_loss,
                         "总得分应等于对敌方造成的伤害")

    def test_hp_ratio_damage_multiple_uses_accumulate(self):
        """多次使用HP比例伤害应累加到scoring_tracker"""
        total_damage = 0
        for _ in range(3):
            enemy_hp_before = self.enemy.current_hp
            result = self.ss.execute_skill(
                caster=self.caster, skill_id=120155,
                battlefield=self.bf, skip_cost=True
            )
            self.assertTrue(result["success"])
            total_damage += (enemy_hp_before - self.enemy.current_hp)

        caster_stats = self.tracker._unit_stats.get(self.caster.unit_id)
        self.assertIsNotNone(caster_stats)
        self.assertEqual(caster_stats.damage_dealt, total_damage,
                         "多次HP比例伤害应累加到scoring_tracker")
        self.assertEqual(self.tracker.get_current_score(), total_damage,
                         "总得分应等于累计伤害")

    def test_hp_ratio_damage_no_shield_absorbed(self):
        """HP比例伤害在有护盾时，scoring_tracker只记录HP部分伤害"""
        # 给敌方添加护盾
        self.enemy.shield = 5000
        enemy_hp_before = self.enemy.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120155,
            battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        enemy_hp_loss = enemy_hp_before - self.enemy.current_hp

        caster_stats = self.tracker._unit_stats.get(self.caster.unit_id)
        self.assertIsNotNone(caster_stats)
        # scoring_tracker应记录HP部分伤害（不含盾吸收）
        self.assertEqual(caster_stats.damage_dealt, enemy_hp_loss,
                         "scoring_tracker应只记录HP部分伤害")


if __name__ == '__main__':
    unittest.main()
