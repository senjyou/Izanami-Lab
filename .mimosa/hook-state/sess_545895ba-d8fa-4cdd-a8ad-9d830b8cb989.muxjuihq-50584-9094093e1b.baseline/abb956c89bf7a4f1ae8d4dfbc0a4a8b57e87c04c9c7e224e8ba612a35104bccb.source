"""Regression: 土ノ浸食(220362) block_buff_by_type/stealth 叙事日志缺失。

Bug: _log_narrative_effects 不处理 block_buff_by_type 和 stealth 效果类型，
     导致土雷使用「土ノ浸食」后无任何叙事日志输出，且"锁定目标"错误显示为施法者自身。
Fix: 在 _log_narrative_effects 中将这两种 effect_type 纳入 aura 的叙事输出路径，
     并在 _apply_block_buff_by_type / _apply_stealth 的返回字典中补充 auras 和 is_debuff 字段。
"""
import unittest, sys, os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import SkillEffectType

BLOCK_BUFF_BY_TYPE = SkillEffectType.BLOCK_BUFF_BY_TYPE.value
STEALTH = SkillEffectType.STEALTH.value


class TestRegDoraiStealthNarrative(unittest.TestCase):

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="dorai", skills=[220362], ap=4, pp=4, level=10)
        bb.add_ally(unit_id="a1", ap=4, pp=4)
        bb.add_ally(unit_id="a2", ap=4, pp=4)
        ctx = bb.build()
        self.bf = ctx['bf']
        self.ss = ctx['ss']
        self.dorai = self.bf.enemy_team[0]
        self.dorai.name = "土雷"
        self.ally1 = self.bf.friend_team[0]
        self.ally1.name = "角色A"
        self.ally2 = self.bf.friend_team[1]
        self.ally2.name = "角色B"

    def test_block_buff_by_type_applied_to_all_allies(self):
        """block_buff_by_type debuff 应付与到所有玩家方单位。"""
        result = self.ss.execute_skill(caster=self.dorai, skill_id=220362,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        for ally in [self.ally1, self.ally2]:
            debuffs = [d for d in ally.debuffs if d.effect_type == BLOCK_BUFF_BY_TYPE]
            self.assertEqual(len(debuffs), 1,
                             f"{ally.name} 应获得 buff_block debuff")

    def test_stealth_applied_to_caster(self):
        """stealth buff 应付与到土雷自身。"""
        result = self.ss.execute_skill(caster=self.dorai, skill_id=220362,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        stealth_buffs = [b for b in self.dorai.buffs if b.effect_type == STEALTH]
        self.assertEqual(len(stealth_buffs), 1, "土雷应获得 ステルス buff")
        self.assertEqual(stealth_buffs[0].duration, 2)

    def test_return_dict_has_auras_for_narrative(self):
        """返回字典应包含 auras 和 is_debuff，供叙事日志使用。"""
        result = self.ss.execute_skill(caster=self.dorai, skill_id=220362,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        effects = result.get("effects_applied", [])
        block_eff = next((e for e in effects if e["effect_type"] == "block_buff_by_type"), None)
        stealth_eff = next((e for e in effects if e["effect_type"] == "stealth"), None)

        self.assertIsNotNone(block_eff)
        self.assertTrue(block_eff.get("is_debuff"), "block_buff_by_type 应标记 is_debuff=True")
        self.assertIn("auras", block_eff, "block_buff_by_type 返回字典应包含 auras")
        self.assertEqual(len(block_eff["auras"]), 2, "auras 应有2个目标")

        self.assertIsNotNone(stealth_eff)
        self.assertFalse(stealth_eff.get("is_debuff"), "stealth 应标记 is_debuff=False")
        self.assertIn("auras", stealth_eff, "stealth 返回字典应包含 auras")
        self.assertEqual(len(stealth_eff["auras"]), 1, "auras 应有1个目标(自身)")

    def test_stealth_consumed_by_target_selection(self):
        """ステルス 应在单体索敌时被消耗（将自身移到候选末尾）。"""
        result = self.ss.execute_skill(caster=self.dorai, skill_id=220362,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        # stealth 付与后 duration=2
        stealth_buffs = [b for b in self.dorai.buffs if b.effect_type == STEALTH]
        self.assertEqual(len(stealth_buffs), 1)
        self.assertEqual(stealth_buffs[0].duration, 2)


if __name__ == '__main__':
    unittest.main()
