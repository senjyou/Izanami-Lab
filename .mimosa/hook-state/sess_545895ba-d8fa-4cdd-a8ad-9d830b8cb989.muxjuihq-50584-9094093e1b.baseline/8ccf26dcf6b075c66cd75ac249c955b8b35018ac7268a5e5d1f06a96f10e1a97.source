#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
重新导入学园系统bonuses数据
"""

import sys
import json
import sqlite3
from pathlib import Path

PROJECT_ROOT = Path(__file__).parent.parent
DB_FILE = PROJECT_ROOT / "db" / "character_stats.db"
DATA_FILE = PROJECT_ROOT / "data" / "school_systems.json"

def main():
    print("Reimporting school system bonuses...")
    
    # 加载数据
    with open(DATA_FILE, 'r', encoding='utf-8') as f:
        data = json.load(f)
    
    bonuses = data['bonuses']
    
    # 连接数据库
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    
    count = 0
    for group_id_str, levels in bonuses.items():
        group_id = int(group_id_str)
        
        for level_str, bonus_data in levels.items():
            cursor.execute("""
                INSERT OR REPLACE INTO school_system_bonuses 
                (group_id, level, hp_bonus, attack_bonus, defense_bonus)
                VALUES (?, ?, ?, ?, ?)
            """, (
                group_id,
                bonus_data['level'],
                bonus_data['hp_bonus'],
                bonus_data['attack_bonus'],
                bonus_data['defense_bonus']
            ))
            count += 1
    
    conn.commit()
    print(f"Imported {count} records")
    
    # 验证
    cursor.execute("SELECT group_id, COUNT(*) FROM school_system_bonuses GROUP BY group_id")
    for row in cursor.fetchall():
        print(f"  Group {row[0]}: {row[1]} records")
    
    conn.close()
    print("Done!")

if __name__ == "__main__":
    main()
