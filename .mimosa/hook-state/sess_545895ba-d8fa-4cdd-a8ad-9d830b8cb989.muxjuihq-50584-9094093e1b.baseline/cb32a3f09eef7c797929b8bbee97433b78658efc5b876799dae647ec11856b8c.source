#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""Quick verification of Test 3 behavior"""
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).parent))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.entities_v2.custom_dummy import (
    CustomDummyConfig, build_synthetic_character_data,
    build_custom_skill_data, build_custom_parsed_skill,
)
from src.combat_v2.battle_flow_controller import BattleFlowController
from src.combat_v2.battle_narrative import BattleNarrativeWriter
from src.data.data_loader import DataLoader
from src.data.stat_calculator import StatCalculator
from src.config.panel_config import PanelConfig, ModuleConfig
from src.config.player_config import SchoolLevels


def create_dummy_unit(data_loader, name, side, pos, char_id, hp, atk, defense, speed,
                      ap, pp, ep_max=8, role_type=0, position_type=3, element=1, char_type=1,
                      as_config=None):
    cfg = CustomDummyConfig(
        name=name, element=element, character_type=char_type,
        position_type=position_type, role_type=role_type if role_type > 0 else 1,
        hp=hp, attack=atk, defense=defense, speed=speed, ap=ap, pp=pp,
    )
    char_data = build_synthetic_character_data(abs(char_id) - 1, cfg)
    char_data.character_id = char_id
    data_loader._custom_characters[char_id] = char_data
    base_idx = abs(char_id) - 1
    as_power = as_config.get("power", 100) if as_config else 100
    as_hit = as_config.get("hit_count", 1) if as_config else 1
    as_cooldown = as_config.get("cooldown", 0) if as_config else 0
    as_skill = build_custom_skill_data(base_idx, False, 1, "通常攻撃", as_power, as_hit, as_cooldown, 1, 3, 1, 1, 1)
    data_loader._custom_skills[as_skill.skill_id] = as_skill
    as_parsed = build_custom_parsed_skill(base_idx, False, 1, 3, 1, 1)
    data_loader._custom_parsed_skills[str(as_skill.skill_id)] = as_parsed
    data_loader._custom_character_skills[char_id] = [as_skill.skill_id]
    data_loader._custom_dummy_configs[char_id] = cfg
    side_prefix = "F" if side == Side.ALLY else "E"
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}", name=name, side=side, position=pos,
        character_id=char_id, level=200, element=cfg.element,
        character_type=cfg.character_type, max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed, crit_rate=0.15, crit_damage=0.5,
        advantage_damage=0.25, initial_active_point=ap, initial_passive_point=pp,
        max_extra_point=ep_max, current_ap=ap, current_pp=pp, current_ep=0,
        skills=[as_skill.skill_id], skill_levels={as_skill.skill_id: 1},
        skill_cooldowns={}, role_type=role_type, position_type=position_type,
    )


def create_character_unit(data_loader, stat_calculator, char_id, side, pos,
                          panel_config, player_config, speed_override=None):
    char = data_loader.get_character_by_id(char_id)
    char_config = panel_config.get_character_config(char_id, char.default_rarity)
    stats = stat_calculator.calculate_stats(char_config, player_config)
    char_skills = data_loader.load_character_skills()
    skills = char_skills.get(char_id, [])
    side_prefix = "F" if side == Side.ALLY else "E"
    max_ep = 7
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}", name=char.name, side=side,
        position=pos, character_id=char_id, level=char_config.level,
        element=char.attribute, character_type=char.character_type,
        max_hp=stats.hp, current_hp=stats.hp, attack=stats.attack,
        defense=stats.defense, speed=stats.speed if speed_override is None else speed_override,
        crit_rate=stats.critical_rate, crit_damage=stats.critical_damage - 1.5,
        advantage_damage=stats.advantage_damage - 1.25,
        initial_active_point=stats.initial_ap, initial_passive_point=stats.initial_pp,
        max_extra_point=max_ep, current_ap=stats.initial_ap,
        current_pp=stats.initial_pp, current_ep=0, skills=skills,
        skill_levels=panel_config.skill_levels.get(char_id, {}),
        skill_cooldowns={}, role_type=char.role_type,
        position_type=char.position_type, fury_count=0,
    )


def main():
    data_loader = DataLoader()
    data_loader.load_all()
    lerp_data = data_loader.load_level_lerp_data()
    stat_calculator = StatCalculator(lerp_data, data_loader)

    char_id = 111301
    skill_ids = [110020, 120027, 130013, 130035, 130051]

    panel_config = PanelConfig(
        character_level=200,
        school_levels=SchoolLevels(
            physical_level=25, en_level=25, agility_level=25,
            fire_level=25, water_level=25, earth_level=25, wind_level=25,
            light_level=25, dark_level=25,
        ),
        equipment_ids=[11, 12, 13, 14, 21, 22, 23, 24, 31, 32, 33, 34],
        equipment_enabled=False,
    )
    panel_config.rarities[char_id] = 14
    panel_config.affection_levels[char_id] = 40
    panel_config.skill_levels[char_id] = {sid: 10 for sid in skill_ids}
    module_ids = [21, 22, 23]
    panel_config.modules[char_id] = [
        ModuleConfig(module_id=mid, tier=9, level=50) for mid in module_ids
    ]
    player_config = panel_config.get_player_config()

    bf = BattlefieldState()
    caster = create_character_unit(
        data_loader, stat_calculator, char_id, Side.ALLY, Position.ALLY_CENTER_BACK,
        panel_config, player_config, speed_override=50
    )
    front_ally = create_dummy_unit(
        data_loader, "前卫味方", Side.ALLY, Position.ALLY_CENTER_FRONT,
        -103, 30000, 3000, 2000, 100, 2, 2
    )
    enemy = create_dummy_unit(
        data_loader, "敌C", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
        -203, 300000, 15000, 5000, 500, 2, 1
    )
    bf.add_unit(caster)
    bf.add_unit(front_ally)
    bf.add_unit(enemy)

    narrative = BattleNarrativeWriter(data_loader=data_loader)
    controller = BattleFlowController(bf, data_loader=data_loader, narrative=narrative)
    result = controller.execute_battle()

    print("=" * 60)
    print("BATTLE RESULT")
    print(f"Result: {result['result']}, Winner: {result['winner']}, Turns: {result['total_turns']}")
    for u in bf.get_all_units():
        s = f"HP={u.current_hp}/{u.max_hp}" if u.is_alive else "DEAD"
        buffs = [(b.effect_type, getattr(b, 'value', None), getattr(b, 'hit_limited', 0))
                 for b in u.buffs] if u.buffs else []
        debuffs = [(b.effect_type, getattr(b, 'value', None), getattr(b, 'hit_limited', 0))
                   for b in u.debuffs] if u.debuffs else []
        print(f"  [{u.unit_id}] {u.name}: {s} PP={u.current_pp}/{u.initial_passive_point}")
        print(f"    buffs={buffs} debuffs={debuffs}")

    print("=" * 60)
    print("KEY NARRATIVE LINES:")
    for line in narrative._lines:
        if any(kw in line for kw in ["PS触发", "代助", "EVADE", "Evade", "evade",
                                       "伤害", "前卫", "Miss", "miss"]):
            print(f"  {line}")

    # Write full log for inspection
    log_path = Path(__file__).parent / "data" / "battle_logs" / "verify_test3_log.txt"
    log_path.parent.mkdir(parents=True, exist_ok=True)
    narrative.write(str(log_path))
    print(f"\nFull log written to: {log_path}")


if __name__ == "__main__":
    main()