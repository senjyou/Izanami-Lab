"""
角色129301 忠義の狂犬メイド 专项测试
- EX: 110025 お嬢に近づくな……！（敵前後列3hit + 自身atk_up2行動(重複可) + debuff_immune2行動）
- AS1: 120062 スタンディクライン（敵前後列攻撃 + spd_down1行動 + Lv11+ 物理or敏捷类型に気絶1行動）
- AS2: 120063 シングル・プラス（敵単体攻撃 + Lv11+ 隣接する敵に追加攻撃）
- PS1: 130068 フィジカルガード（物理or敏捷敵から被攻撃時 + 自身guard% 1回被攻撃消費）
- PS2: 130069 スタート・プリエンプティブ（ターン開始時先制 + 敵前後列攻撃 + 物理/敏捷にPP-1 + 1ターン目不发動）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

GUARD = SkillEffectType.GUARD.value
ATK_UP = SkillEffectType.STATUS_ATTACK.value
SPD_DOWN = SkillEffectType.STATUS_SPEED.value
KNOCKOUT = SkillEffectType.KNOCKOUT.value


class TestActor129301(unittest.TestCase):
    """角色129301 忠義の狂犬メイド 专项测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 129301 忠義の狂犬メイド (风属性, 物理型, 前排)
        self.caster = UnitState(
            unit_id="ally_front", name="忠義の狂犬メイド", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=129301, level=10,
            element=3, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=8,
            current_ap=10, current_pp=10, current_ep=8,
            skills=[110025, 120062, 120063, 130068, 130069],
            skill_levels={110025: 10, 120062: 10, 120063: 10, 130068: 10, 130069: 10},
            skill_cooldowns={},
        )

        # 敌方中前: 物理类型 (character_type=1), 有PP
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前(物理)", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=5, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方中后: EN类型 (character_type=2), 有PP
        self.enemy_cb = UnitState(
            unit_id="enemy_cb", name="敵中後(EN)", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=999002, level=10,
            element=3, character_type=2,
            max_hp=12000, current_hp=12000,
            attack=6000, defense=4000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=5, current_ep=4,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前: 敏捷类型 (character_type=3), 有PP, 邻接中前
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前(敏捷)", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=4, character_type=3,
            max_hp=10000, current_hp=10000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=5, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前: 物理类型 (character_type=1), 有PP, 邻接中前
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前(物理)", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=5, character_type=1,
            max_hp=8000, current_hp=8000,
            attack=5000, defense=3000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=5, current_ep=1,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_cb, self.enemy_lf, self.enemy_rf]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    # ─── EX: お嬢に近づくな……！ ───

    def test_ex_damage_enemy_column(self):
        """EX(110025) 攻击前后列(纵列2人)"""
        hp_cf_before = self.enemy_cf.current_hp
        hp_cb_before = self.enemy_cb.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110025, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        self.assertLess(self.enemy_cf.current_hp, hp_cf_before, "中前应受到伤害")
        self.assertLess(self.enemy_cb.current_hp, hp_cb_before, "中后应受到伤害(纵列)")
        self.assertEqual(self.enemy_lf.current_hp, hp_lf_before, "左前不应受到伤害(非纵列)")
        self.assertEqual(self.enemy_rf.current_hp, hp_rf_before, "右前不应受到伤害(非纵列)")

    def test_ex_grants_atk_up(self):
        """EX(110025) 赋予自身atk_up(2行动,可叠加)"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110025, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        atk_buffs = [b for b in self.caster.buffs if b.effect_type == ATK_UP]
        self.assertGreater(len(atk_buffs), 0, "应获得atk_up buff")
        self.assertEqual(atk_buffs[0].duration, 2, "atk_up duration应为2")
        self.assertTrue(atk_buffs[0].is_stackable, "atk_up应可叠加")

    def test_ex_grants_debuff_immune(self):
        """EX(110025) 赋予自身debuff_immune(2行动)"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110025, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        immune_buffs = [b for b in self.caster.buffs
                        if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertGreater(len(immune_buffs), 0, "应获得debuff_immune buff")
        self.assertEqual(immune_buffs[0].duration, 2, "debuff_immune duration应为2")

    def test_ex_debuff_immune_blocks_debuff(self):
        """EX(110025) debuff_immune生效时免疫debuff"""
        self.ss.execute_skill(
            caster=self.caster, skill_id=110025, battlefield=self.bf, skip_cost=True
        )
        # 验证 _has_debuff_immune 返回 True（debuff_immune 检查在 skill_service._apply_aura 中）
        self.assertTrue(self.ss._has_debuff_immune(self.caster),
                        "EX后施法者应被识别为持有debuff_immune")

    # ─── AS1: スタンディクライン ───

    def test_as1_lv10_no_knockout(self):
        """AS1(120062) Lv10: 不施加気絶"""
        self.caster.skill_levels[120062] = 10
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120062, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        for e in [self.enemy_cf, self.enemy_cb]:
            ko = [d for d in e.debuffs if d.effect_type == KNOCKOUT]
            self.assertEqual(len(ko), 0, f"{e.name}不应有気絶(Lv10)")

    def test_as1_lv11_knockout_physical_only(self):
        """AS1(120062) Lv11: 物理类型施加気絶, EN类型不施加"""
        self.caster.skill_levels[120062] = 11
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120062, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        ko_cf = [d for d in self.enemy_cf.debuffs if d.effect_type == KNOCKOUT]
        self.assertGreater(len(ko_cf), 0, "中前(物理)应有気絶(Lv11)")

        ko_cb = [d for d in self.enemy_cb.debuffs if d.effect_type == KNOCKOUT]
        self.assertEqual(len(ko_cb), 0, "中后(EN)不应有気絶(仅物理/敏捷)")

    def test_as1_lv11_knockout_agile_type(self):
        """AS1(120062) Lv11: 敏捷类型也施加気絶"""
        self.caster.skill_levels[120062] = 11
        # 将中后改为敏捷类型以测试敏捷类型也施加気絶
        self.enemy_cb.character_type = 3
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120062, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        ko_cb = [d for d in self.enemy_cb.debuffs if d.effect_type == KNOCKOUT]
        self.assertGreater(len(ko_cb), 0, "中后(敏捷)应有気絶(Lv11)")

    def test_as1_applies_spd_down(self):
        """AS1(120062) 施加spd_down(1行动,fixed)"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120062, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        for e in [self.enemy_cf, self.enemy_cb]:
            spd = [d for d in e.debuffs if d.effect_type == SPD_DOWN]
            self.assertGreater(len(spd), 0, f"{e.name}应有spd_down")

    # ─── AS2: シングル・プラス ───

    def test_as2_lv10_single_target_only(self):
        """AS2(120063) Lv10: 仅攻击主目标(中前), 邻接不受伤害"""
        self.caster.skill_levels[120063] = 10
        hp_cf = self.enemy_cf.current_hp
        hp_cb = self.enemy_cb.current_hp
        hp_lf = self.enemy_lf.current_hp
        hp_rf = self.enemy_rf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120063, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        self.assertLess(self.enemy_cf.current_hp, hp_cf, "主目标(中前)应受到伤害")
        self.assertEqual(self.enemy_cb.current_hp, hp_cb, "中后不应受伤害(Lv10无邻接)")
        self.assertEqual(self.enemy_lf.current_hp, hp_lf, "左前不应受伤害(Lv10无邻接)")
        self.assertEqual(self.enemy_rf.current_hp, hp_rf, "右前不应受伤害(Lv10无邻接)")

    def test_as2_lv11_hits_adjacent_all(self):
        """AS2(120063) Lv11: 主目标+所有邻接敌方(中后,左前,右前)"""
        self.caster.skill_levels[120063] = 11
        hp_cf = self.enemy_cf.current_hp
        hp_cb = self.enemy_cb.current_hp
        hp_lf = self.enemy_lf.current_hp
        hp_rf = self.enemy_rf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120063, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        self.assertLess(self.enemy_cf.current_hp, hp_cf, "主目标(中前)应受到伤害")
        self.assertLess(self.enemy_cb.current_hp, hp_cb, "中后(邻接)应受到追加伤害")
        self.assertLess(self.enemy_lf.current_hp, hp_lf, "左前(邻接)应受到追加伤害")
        self.assertLess(self.enemy_rf.current_hp, hp_rf, "右前(邻接)应受到追加伤害")

    # ─── PS1: フィジカルガード ───

    def test_ps1_triggers_on_physical_attacker(self):
        """PS1(130068) 物理类型敌人攻击时触发guard"""
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130068, None)

        actions = self.ts.trigger_before_any_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130068]
        self.assertGreater(len(ps1_actions), 0, "物理敌人攻击应触发PS1")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_any_attacked"
        )

        guard_buffs = [b for b in self.caster.buffs if b.effect_type == GUARD]
        self.assertGreater(len(guard_buffs), 0, "应获得guard buff")
        self.assertEqual(guard_buffs[0].attack_limited, 1, "guard应有attack_limited=1")

    def test_ps1_triggers_on_agile_attacker(self):
        """PS1(130068) 敏捷类型敌人攻击时也触发guard"""
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130068, None)

        actions = self.ts.trigger_before_any_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_lf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130068]
        self.assertGreater(len(ps1_actions), 0, "敏捷敌人攻击应触发PS1")

    def test_ps1_does_not_trigger_on_en_attacker(self):
        """PS1(130068) EN类型敌人攻击时不触发"""
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130068, None)

        actions = self.ts.trigger_before_any_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cb
        )
        ps1_actions = [a for a in actions if a.skill_id == 130068]
        self.assertEqual(len(ps1_actions), 0, "EN敌人攻击不应触发PS1")

    def test_ps1_does_not_trigger_for_other_ally(self):
        """PS1(130068) 其他友方被攻击时不触发(target_is_self条件)"""
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130068, None)
        # 添加一个友方
        other_ally = UnitState(
            unit_id="ally_other", name="其他友方", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999100, level=10,
            element=1, character_type=1,
            max_hp=10000, current_hp=10000,
            attack=5000, defense=3000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.bf.friend_team = [self.caster, other_ally]

        actions = self.ts.trigger_before_any_attacked(
            targets=[other_ally], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130068]
        self.assertEqual(len(ps1_actions), 0, "其他友方被攻击不应触发PS1(target_is_self)")

    # ─── PS2: スタート・プリエンプティブ ───

    def test_ps2_round1_no_trigger(self):
        """PS2(130069) 第1回合不发动"""
        self.bf.turn_number = 1
        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130069]
        self.assertEqual(len(ps2_actions), 0, "PS2不应在第1回合发动")

    def test_ps2_round2_preemptive_attack(self):
        """PS2(130069) 第2回合先制攻击前后列"""
        self.bf.turn_number = 2
        self.caster.current_pp = 10
        hp_cf = self.enemy_cf.current_hp
        hp_cb = self.enemy_cb.current_hp

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130069]
        self.assertGreater(len(ps2_actions), 0, "PS2应在第2回合触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        self.assertLess(self.enemy_cf.current_hp, hp_cf, "中前应受到先制伤害")
        self.assertLess(self.enemy_cb.current_hp, hp_cb, "中后应受到先制伤害(纵列)")

    def test_ps2_remove_pp_physical_only(self):
        """PS2(130069) 仅对物理/敏捷类型扣PP, EN不扣"""
        self.bf.turn_number = 2
        self.caster.current_pp = 10
        pp_cf_before = self.enemy_cf.current_pp  # 物理
        pp_cb_before = self.enemy_cb.current_pp  # EN
        pp_lf_before = self.enemy_lf.current_pp  # 敏捷(非纵列, 不应扣)

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130069]
        self.assertGreater(len(ps2_actions), 0)

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 中前(物理)应扣1PP
        self.assertEqual(self.enemy_cf.current_pp, pp_cf_before - 1,
                         f"中前(物理)应扣1PP: {pp_cf_before} -> {self.enemy_cf.current_pp}")
        # 中后(EN)不应扣PP
        self.assertEqual(self.enemy_cb.current_pp, pp_cb_before,
                         f"中后(EN)不应扣PP: {pp_cb_before} -> {self.enemy_cb.current_pp}")
        # 左前(敏捷)不在纵列, 不应扣PP
        self.assertEqual(self.enemy_lf.current_pp, pp_lf_before,
                         f"左前(敏捷)不在纵列不应扣PP")


if __name__ == '__main__':
    unittest.main()
