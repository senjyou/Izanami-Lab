"""Regression tests for 【ドメスティックなリーダー】(135301) skill implementations.

Covers 5 skills:
- 110046 強襲掃討 (EX): enemy_row damage + Lv11+ lifesteal(dmg% of damage dealt)
- 120103 短連射 (AS1): 2-target damage + condition(self_has_mark "反重力おさげ")
  -> add_status knockout(1action) on 2 targets
- 130111 チェーンマニューバ (PS1): on_turn_start preemptive +
  enemy_single_lowest_max_hp damage + damage_link(self_and_primary_target,
  to_primary_target, 1ターン) + cooldown=99 (1度のみ)
- 130112 ハイ・リカバリー (PS2): before_as_attacked + target_is_self +
  cheat_death(cure% heal on lethal) + Lv11+ max_hp_up(buff%, 永続, unremovable)
  + cooldown=99 (1度のみ)
- 130113 怒らせすぎ注意 (PS3): on_cumulative_damage(>=85%) +
  enemy_single nearest: dmg_dealt_down(dmg%, attack_limited=1) +
  self: dmg_invulnerable(1行動, hit_limited=999) +
  self: mark 反重力おさげ(1行動) + Lv11+ enemy_single: add_status knockout(1行動)

New mechanism:
- enemy_single_lowest_max_hp target_type: selects the enemy with lowest max_hp,
  tie-broken by nearest position (uses select_min_with_stealth with key
  (u.max_hp, _get_sort_key(caster, u)))
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# Skill IDs
_EX = 110046
_AS1 = 120103
_PS1 = 130111
_PS2 = 130112
_PS3 = 130113

# Effect type constants
MARK = SkillEffectType.MARK.value
KNOCKOUT = SkillEffectType.KNOCKOUT.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
DMG_INVULNERABLE = SkillEffectType.DMG_INVULNERABLE.value
STATUS_MAX_HP = SkillEffectType.STATUS_MAX_HP.value


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.EARTH.value,
               character_type=1, skills=None, skill_levels=None,
               pp=10, ep=10, ap=10):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=ep,
        is_alive=True,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class _BaseTest(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.dl = None

    def _get_dl(self):
        if self.dl is None:
            from src.data.data_loader import DataLoader
            self.dl = DataLoader()
            self.dl.load_all()
        return self.dl

    def _make_services(self, bf):
        dl = self._get_dl()
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(dl, rs, target_service=tgs, damage_service=dms,
                          aura_service=aus, trigger_service=ts, status_service=sts)
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts, dms


# ════════════════════════════════════════════════════════════════════
# EX 110046 強襲掃討
# ════════════════════════════════════════════════════════════════════
class TestRegDomesticEX110046(_BaseTest):
    """110046 強襲掃討 (EX): 敵横一列 damage + Lv11+ lifesteal."""

    def test_config_basic_fields(self):
        """EX must be skill_type=3 (EX), cost=7 EP, no cooldown."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_EX)
        self.assertIsNotNone(parsed)
        self.assertEqual(parsed.get('skill_type'), 3)
        self.assertEqual(parsed.get('resource_cost'), 7)
        self.assertIsNone(parsed.get('cooldown'))

    def test_config_block1_enemy_row_damage(self):
        """Block1 should be enemy_row damage with 威力 tag."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_EX)
        blocks = parsed.get('effect_blocks', [])
        self.assertGreaterEqual(len(blocks), 1)
        b1 = blocks[0]
        self.assertIsNone(b1.get('condition'), "Block1 should have no condition")
        effs = b1.get('effects', [])
        self.assertEqual(len(effs), 1)
        d = effs[0]
        self.assertEqual(d['effect_type'], 'damage')
        self.assertEqual(d['target_type'], 'enemy_row')
        self.assertEqual(d['value_tag'], '威力')

    def test_config_block2_l11_lifesteal(self):
        """Block2 should be active_level_min=11 lifesteal on self."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_EX)
        blocks = parsed.get('effect_blocks', [])
        self.assertGreaterEqual(len(blocks), 2)
        b2 = blocks[1]
        cond = b2.get('condition')
        self.assertIsNotNone(cond)
        self.assertEqual(cond.get('type'), 'active_level_min')
        self.assertEqual(cond.get('value'), 11)
        effs = b2.get('effects', [])
        self.assertEqual(len(effs), 1)
        ls = effs[0]
        self.assertEqual(ls['effect_type'], 'lifesteal')
        self.assertEqual(ls['target_type'], 'self')
        self.assertEqual(ls['value_tag'], 'dmg')

    def test_l11_lifesteal_heals_caster(self):
        """Lv11+ EX should heal caster by dmg% of damage dealt."""
        caster = _make_unit("caster", "Leader", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=100000, atk=20000, skills=[_EX],
                            skill_levels={_EX: 11}, ep=10)
        # Place 3 enemies in front row to ensure enemy_row hits multiple
        e1 = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=50000)
        e2 = _make_unit("e2", "敵2", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=50000)
        e3 = _make_unit("e3", "敵3", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=50000)
        bf = _make_bf(caster, e1, e2, e3)
        ss, _, _ = self._make_services(bf)

        # Damage caster first so lifesteal heal is visible
        caster.current_hp = 10000
        hp_before = caster.current_hp

        result = ss.execute_skill(caster=caster, skill_id=_EX, battlefield=bf,
                                  skip_cost=True)
        self.assertTrue(result["success"])

        # Caster should heal (lifesteal Lv11=45%)
        self.assertGreater(caster.current_hp, hp_before,
                           "Lv11+ EX should heal caster via lifesteal")

    def test_l10_no_lifesteal(self):
        """Lv10 EX should NOT apply lifesteal (Block2 condition active_level_min=11)."""
        caster = _make_unit("caster", "Leader", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=100000, atk=20000, skills=[_EX],
                            skill_levels={_EX: 10}, ep=10)
        e1 = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=50000)
        e2 = _make_unit("e2", "敵2", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=50000)
        bf = _make_bf(caster, e1, e2)
        ss, _, _ = self._make_services(bf)

        caster.current_hp = 10000
        hp_before = caster.current_hp
        result = ss.execute_skill(caster=caster, skill_id=_EX, battlefield=bf,
                                  skip_cost=True)
        self.assertTrue(result["success"])
        self.assertEqual(caster.current_hp, hp_before,
                         "Lv10 EX should NOT heal (no lifesteal)")


# ════════════════════════════════════════════════════════════════════
# AS1 120103 短連射
# ════════════════════════════════════════════════════════════════════
class TestRegDomesticAS120103(_BaseTest):
    """120103 短連射 (AS1): 2-target damage + conditional knockout on self_has_mark."""

    def test_config_block1_damage_2_targets(self):
        """Block1 should be enemy_single damage with target_count=2."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_AS1)
        self.assertIsNotNone(parsed)
        b1 = parsed['effect_blocks'][0]
        effs = b1.get('effects', [])
        self.assertEqual(len(effs), 1)
        d = effs[0]
        self.assertEqual(d['effect_type'], 'damage')
        self.assertEqual(d['target_type'], 'enemy_single')
        self.assertEqual(d['flags'].get('target_count'), 2,
                         "should target 2 enemies")
        self.assertEqual(d['value_tag'], '威力')

    def test_config_block2_self_has_mark_condition(self):
        """Block2 should have self_has_mark '反重力おさげ' condition."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_AS1)
        b2 = parsed['effect_blocks'][1]
        cond = b2.get('condition')
        self.assertIsNotNone(cond)
        self.assertEqual(cond.get('type'), 'self_has_mark')
        self.assertEqual(cond.get('mark_name'), '反重力おさげ')

    def test_config_block2_knockout_2_targets(self):
        """Block2 should apply knockout to 2 enemies (target_count=2)."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_AS1)
        b2 = parsed['effect_blocks'][1]
        effs = b2.get('effects', [])
        self.assertEqual(len(effs), 1)
        e = effs[0]
        self.assertEqual(e['effect_type'], 'add_status')
        self.assertEqual(e['flags'].get('status_type'), 'knockout')
        self.assertEqual(e['flags'].get('target_count'), 2)
        self.assertEqual(e['duration'], 1)
        self.assertEqual(e['duration_type'], 'action')

    def test_no_mark_no_knockout(self):
        """Without 反重力おさげ mark, AS1 should NOT apply knockout."""
        caster = _make_unit("caster", "Leader", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=100000, atk=10000, skills=[_AS1],
                            skill_levels={_AS1: 10}, ap=10)
        e1 = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=50000)
        e2 = _make_unit("e2", "敵2", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=50000)
        bf = _make_bf(caster, e1, e2)
        ss, _, _ = self._make_services(bf)

        result = ss.execute_skill(caster=caster, skill_id=_AS1, battlefield=bf,
                                  skip_cost=True)
        self.assertTrue(result["success"])

        for e in (e1, e2):
            knockout_debuffs = [d for d in e.debuffs if d.effect_type == KNOCKOUT]
            self.assertEqual(len(knockout_debuffs), 0,
                             f"{e.unit_id} should NOT have knockout (no mark)")

    def test_with_mark_applies_knockout(self):
        """With 反重力おさげ mark on caster, AS1 should apply knockout to 2 targets."""
        caster = _make_unit("caster", "Leader", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=100000, atk=10000, skills=[_AS1],
                            skill_levels={_AS1: 10}, ap=10)
        e1 = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=50000)
        e2 = _make_unit("e2", "敵2", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=50000)
        bf = _make_bf(caster, e1, e2)
        ss, _, _ = self._make_services(bf)

        # Manually add 反重力おさげ mark buff to caster (simulating PS3 grant)
        from src.entities_v2.unit_state import BuffState
        import time
        mark_buff = BuffState(
            buff_id=f"mark_test_{int(time.time() * 1000)}",
            name="反重力おさげ",
            effect_type=MARK,
            value=0.0,
            duration=1,
            timing_type=2,  # 2=行动制
            source_skill_id=_PS3,
            source_unit_id=caster.unit_id,
            is_debuff=False,
        )
        caster.buffs.append(mark_buff)

        result = ss.execute_skill(caster=caster, skill_id=_AS1, battlefield=bf,
                                  skip_cost=True)
        self.assertTrue(result["success"])

        # Both targets should have knockout debuff
        for e in (e1, e2):
            knockout_debuffs = [d for d in e.debuffs if d.effect_type == KNOCKOUT]
            self.assertGreater(len(knockout_debuffs), 0,
                               f"{e.unit_id} should have knockout (caster has mark)")


# ════════════════════════════════════════════════════════════════════
# PS1 130111 チェーンマニューバ
# ════════════════════════════════════════════════════════════════════
class TestRegDomesticPS1130111(_BaseTest):
    """130111 チェーンマニューバ (PS1): on_turn_start preemptive +
    enemy_single_lowest_max_hp damage + damage_link."""

    def test_config_basic_fields(self):
        """PS1 must be skill_type=2, cost=2 PP, cooldown=99 (1度のみ)."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS1)
        self.assertIsNotNone(parsed)
        self.assertEqual(parsed.get('skill_type'), 2)
        self.assertEqual(parsed.get('resource_cost'), 2)
        self.assertEqual(parsed.get('cooldown'), 99,
                         "cooldown=99 means single-use per battle")
        self.assertEqual(parsed.get('cooldown_update_timing'), 1)
        self.assertEqual(parsed.get('trigger_type'), 'on_turn_start')

    def test_config_block1_has_preemptive_damage(self):
        """Block1 damage should have is_preemptive flag and target lowest_max_hp."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS1)
        b1 = parsed['effect_blocks'][0]
        effs = b1.get('effects', [])
        # First effect should be damage with is_preemptive
        dmg_effs = [e for e in effs if e['effect_type'] == 'damage']
        self.assertEqual(len(dmg_effs), 1)
        d = dmg_effs[0]
        self.assertEqual(d['target_type'], 'enemy_single_lowest_max_hp')
        self.assertTrue(d['flags'].get('is_preemptive'),
                        "damage should have is_preemptive flag")
        self.assertEqual(d['value_tag'], '威力')

    def test_config_block1_has_damage_link(self):
        """Block1 should have damage_link effect with to_primary_target mode."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS1)
        b1 = parsed['effect_blocks'][0]
        effs = b1.get('effects', [])
        link_effs = [e for e in effs if e['effect_type'] == 'damage_link']
        self.assertEqual(len(link_effs), 1)
        lk = link_effs[0]
        self.assertEqual(lk['target_type'], 'self_and_primary_target')
        self.assertEqual(lk['flags'].get('link_mode'), 'to_primary_target')
        self.assertEqual(lk['duration'], 1)
        self.assertEqual(lk['duration_type'], 'turn',
                         "damage_link duration_type='turn' (1ターン)")
        self.assertEqual(lk['value_tag'], 'dmg')

    def test_lowest_max_hp_target_selection(self):
        """enemy_single_lowest_max_hp should select enemy with lowest max_hp.

        Setup: 3 enemies with different max_hp values. The damage effect should
        hit the one with the lowest max_hp.
        """
        caster = _make_unit("caster", "Leader", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=100000, atk=10000, skills=[_PS1],
                            skill_levels={_PS1: 10}, pp=10)
        # Lowest max_hp enemy
        e_low = _make_unit("e_low", "LowHP", Side.ENEMY,
                           Position.ENEMY_LEFT_FRONT, hp=30000)
        e_mid = _make_unit("e_mid", "MidHP", Side.ENEMY,
                           Position.ENEMY_CENTER_FRONT, hp=60000)
        e_high = _make_unit("e_high", "HighHP", Side.ENEMY,
                            Position.ENEMY_RIGHT_FRONT, hp=90000)
        bf = _make_bf(caster, e_low, e_mid, e_high)
        ss, _, _ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in (e_low, e_mid, e_high)}
        result = ss.execute_skill(caster=caster, skill_id=_PS1, battlefield=bf,
                                  skip_cost=True)
        self.assertTrue(result["success"])

        # Only e_low should be damaged
        self.assertLess(e_low.current_hp, hp_before["e_low"],
                        "e_low (lowest max_hp) should be damaged")
        self.assertEqual(e_mid.current_hp, hp_before["e_mid"],
                         "e_mid should NOT be damaged")
        self.assertEqual(e_high.current_hp, hp_before["e_high"],
                         "e_high should NOT be damaged")

    def test_damage_link_applied_between_caster_and_primary_target(self):
        """PS1 should establish damage_link from caster to primary target.

        After PS1 execution, caster.damage_links should contain an outgoing
        entry pointing to the primary target (the lowest max_hp enemy).
        """
        caster = _make_unit("caster", "Leader", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=100000, atk=10000, skills=[_PS1],
                            skill_levels={_PS1: 10}, pp=10)
        e_low = _make_unit("e_low", "LowHP", Side.ENEMY,
                           Position.ENEMY_LEFT_FRONT, hp=30000)
        e_high = _make_unit("e_high", "HighHP", Side.ENEMY,
                            Position.ENEMY_RIGHT_FRONT, hp=90000)
        bf = _make_bf(caster, e_low, e_high)
        ss, _, _ = self._make_services(bf)

        result = ss.execute_skill(caster=caster, skill_id=_PS1, battlefield=bf,
                                  skip_cost=True)
        self.assertTrue(result["success"])

        # Caster should have an outgoing damage_link to e_low
        outgoing = [dl for dl in caster.damage_links
                    if dl.direction == 'outgoing' and dl.partner_unit_id == e_low.unit_id]
        self.assertGreater(len(outgoing), 0,
                           "Caster should have outgoing damage_link to primary target")
        # Verify value > 0
        self.assertGreater(outgoing[0].value, 0,
                           "damage_link value should be > 0")


# ════════════════════════════════════════════════════════════════════
# PS2 130112 ハイ・リカバリー
# ════════════════════════════════════════════════════════════════════
class TestRegDomesticPS2130112(_BaseTest):
    """130112 ハイ・リカバリー (PS2): before_as_attacked +
    cheat_death + Lv11+ max_hp_up."""

    def test_config_basic_fields(self):
        """PS2 must be skill_type=2, cost=1 PP, cooldown=99 (1度のみ)."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS2)
        self.assertIsNotNone(parsed)
        self.assertEqual(parsed.get('skill_type'), 2)
        self.assertEqual(parsed.get('resource_cost'), 1)
        self.assertEqual(parsed.get('cooldown'), 99,
                         "cooldown=99 means single-use per battle")
        self.assertEqual(parsed.get('trigger_type'), 'before_as_attacked')
        # global_condition target_is_self
        gc = parsed.get('global_condition')
        self.assertIsNotNone(gc)
        self.assertEqual(gc.get('type'), 'target_is_self')

    def test_config_block1_cheat_death(self):
        """Block1 should apply cheat_death with cure% heal value."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS2)
        b1 = parsed['effect_blocks'][0]
        effs = b1.get('effects', [])
        self.assertEqual(len(effs), 1)
        cd = effs[0]
        self.assertEqual(cd['effect_type'], 'cheat_death')
        self.assertEqual(cd['target_type'], 'self')
        self.assertEqual(cd['value_tag'], 'cure')
        self.assertEqual(cd['duration'], -1,
                         "cheat_death duration=-1 (persists until triggered)")

    def test_config_block2_l11_max_hp_up_unremovable(self):
        """Block2 should apply max_hp_up with unremovable flag (Lv11+)."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS2)
        b2 = parsed['effect_blocks'][1]
        cond = b2.get('condition')
        self.assertEqual(cond.get('type'), 'active_level_min')
        self.assertEqual(cond.get('value'), 11)
        effs = b2.get('effects', [])
        self.assertEqual(len(effs), 1)
        m = effs[0]
        self.assertEqual(m['effect_type'], 'max_hp_up')
        self.assertEqual(m['target_type'], 'self')
        self.assertEqual(m['value_tag'], 'buff')
        self.assertEqual(m['duration'], -1, "max_hp_up should be permanent")
        self.assertTrue(m['flags'].get('unremovable'),
                        "max_hp_up should be unremovable")
        self.assertEqual(m['flags'].get('value_type'), 'percent')


# ════════════════════════════════════════════════════════════════════
# PS3 130113 怒らせすぎ注意
# ════════════════════════════════════════════════════════════════════
class TestRegDomesticPS3130113(_BaseTest):
    """130113 怒らせすぎ注意 (PS3): on_cumulative_damage(>=85%) +
    dmg_dealt_down + dmg_invulnerable + mark + Lv11+ knockout."""

    def test_config_basic_fields(self):
        """PS3 must be skill_type=2, cost=1 PP, trigger on_cumulative_damage."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS3)
        self.assertIsNotNone(parsed)
        self.assertEqual(parsed.get('skill_type'), 2)
        self.assertEqual(parsed.get('resource_cost'), 1)
        self.assertEqual(parsed.get('trigger_type'), 'on_cumulative_damage')

    def test_config_global_condition_has_ge_operator(self):
        """global_condition must have operator='>=' (default '==' would never match).

        _eval_condition returns False for unknown operators, so without '>='
        the PS would never trigger even after cumulative damage exceeds 85%.
        """
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS3)
        gc = parsed.get('global_condition')
        self.assertIsNotNone(gc)
        self.assertEqual(gc.get('type'), 'cumulative_damage_percent')
        self.assertEqual(gc.get('operator'), '>=',
                         "operator must be '>=' so condition passes when "
                         "cumulative damage reaches 85% threshold")
        self.assertEqual(gc.get('value'), 85)

    def test_config_block1_dmg_dealt_down_on_enemy_single(self):
        """Block1 should apply dmg_dealt_down on enemy_single with attack_limited=1."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS3)
        b1 = parsed['effect_blocks'][0]
        effs = b1.get('effects', [])

        dmg_down_effs = [e for e in effs if e['effect_type'] == 'dmg_dealt_down']
        self.assertEqual(len(dmg_down_effs), 1)
        d = dmg_down_effs[0]
        self.assertEqual(d['target_type'], 'enemy_single')
        self.assertEqual(d['value_tag'], 'dmg')
        self.assertEqual(d['duration'], 1)
        self.assertEqual(d['duration_type'], 'action')
        self.assertEqual(d['flags'].get('attack_limited'), 1,
                         "attack_limited=1: consumed after enemy's next attack")
        self.assertEqual(d['flags'].get('value_type'), 'percent')

    def test_config_block1_dmg_invulnerable_on_self(self):
        """Block1 should apply dmg_invulnerable on self with hit_limited=999."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS3)
        b1 = parsed['effect_blocks'][0]
        effs = b1.get('effects', [])

        invuln_effs = [e for e in effs if e['effect_type'] == 'dmg_invulnerable']
        self.assertEqual(len(invuln_effs), 1)
        iv = invuln_effs[0]
        self.assertEqual(iv['target_type'], 'self')
        self.assertEqual(iv['duration'], 1)
        self.assertEqual(iv['duration_type'], 'action')
        self.assertEqual(iv['flags'].get('hit_limited'), 999,
                         "hit_limited=999: nullifies all hits during 1 action")

    def test_config_block1_mark_juryoku_osaage(self):
        """Block1 should apply mark '反重力おさげ' on self with is_buff_mark=true."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS3)
        b1 = parsed['effect_blocks'][0]
        effs = b1.get('effects', [])

        mark_effs = [e for e in effs if e['effect_type'] == 'mark']
        self.assertEqual(len(mark_effs), 1)
        m = mark_effs[0]
        self.assertEqual(m['target_type'], 'self')
        self.assertEqual(m['duration'], 1)
        self.assertEqual(m['duration_type'], 'action')
        self.assertEqual(m['flags'].get('mark_name'), '反重力おさげ')
        self.assertTrue(m['flags'].get('is_buff_mark'),
                        "is_buff_mark=true so mark is stored as buff")

    def test_config_block2_l11_knockout_on_enemy_single(self):
        """Block2 (Lv11+) should apply knockout on enemy_single."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(_PS3)
        b2 = parsed['effect_blocks'][1]
        cond = b2.get('condition')
        self.assertEqual(cond.get('type'), 'active_level_min')
        self.assertEqual(cond.get('value'), 11)
        effs = b2.get('effects', [])
        self.assertEqual(len(effs), 1)
        e = effs[0]
        self.assertEqual(e['effect_type'], 'add_status')
        self.assertEqual(e['flags'].get('status_type'), 'knockout')
        self.assertEqual(e['target_type'], 'enemy_single')
        self.assertEqual(e['duration'], 1)
        self.assertEqual(e['duration_type'], 'action')

    def test_behavior_mark_buff_stored_on_self(self):
        """PS3 mark '反重力おさげ' should be stored on caster.buffs (is_buff_mark=true)."""
        caster = _make_unit("caster", "Leader", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=100000, atk=10000, skills=[_PS3],
                            skill_levels={_PS3: 10}, pp=10)
        enemy = _make_unit("enemy", "敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=50000)
        bf = _make_bf(caster, enemy)
        ss, _, _ = self._make_services(bf)

        result = ss.execute_skill(caster=caster, skill_id=_PS3, battlefield=bf,
                                  skip_cost=True)
        self.assertTrue(result["success"])

        mark_buffs = [b for b in caster.buffs
                      if b.effect_type == MARK and getattr(b, 'name', '') == '反重力おさげ']
        self.assertGreater(len(mark_buffs), 0,
                           "Caster should have 反重力おさげ mark buff after PS3")

    def test_behavior_dmg_invulnerable_reduces_damage_to_1(self):
        """PS3 dmg_invulnerable should reduce each hit to 1 damage."""
        caster = _make_unit("caster", "Leader", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=100000, atk=10000, skills=[_PS3],
                            skill_levels={_PS3: 10}, pp=10)
        # Enemy will attack caster to verify dmg_invulnerable
        enemy = _make_unit("enemy", "敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                           hp=100000, atk=50000)
        bf = _make_bf(caster, enemy)
        ss, _, _ = self._make_services(bf)

        # Apply PS3 to caster (grants dmg_invulnerable)
        result = ss.execute_skill(caster=caster, skill_id=_PS3, battlefield=bf,
                                  skip_cost=True)
        self.assertTrue(result["success"])

        invuln_buffs = [b for b in caster.buffs if b.effect_type == DMG_INVULNERABLE]
        self.assertGreater(len(invuln_buffs), 0,
                           "Caster should have dmg_invulnerable buff")
        self.assertEqual(invuln_buffs[0].hit_limited, 999,
                         "hit_limited should be 999")

    def test_behavior_dmg_dealt_down_applied_to_nearest_enemy(self):
        """PS3 dmg_dealt_down should be applied to the nearest enemy_single."""
        caster = _make_unit("caster", "Leader", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=100000, atk=10000, skills=[_PS3],
                            skill_levels={_PS3: 10}, pp=10)
        # Nearest enemy to ALLY_CENTER_FRONT is ENEMY_CENTER_FRONT
        e_near = _make_unit("e_near", "Near", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT, hp=50000)
        e_far = _make_unit("e_far", "Far", Side.ENEMY,
                           Position.ENEMY_RIGHT_BACK, hp=50000)
        bf = _make_bf(caster, e_near, e_far)
        ss, _, _ = self._make_services(bf)

        result = ss.execute_skill(caster=caster, skill_id=_PS3, battlefield=bf,
                                  skip_cost=True)
        self.assertTrue(result["success"])

        # Nearest enemy should have dmg_dealt_down debuff
        near_dealt_down = [d for d in e_near.debuffs if d.effect_type == DEALT_DAMAGE]
        far_dealt_down = [d for d in e_far.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(near_dealt_down), 0,
                           "Nearest enemy should have dmg_dealt_down")
        self.assertEqual(len(far_dealt_down), 0,
                         "Far enemy should NOT have dmg_dealt_down")


# ════════════════════════════════════════════════════════════════════
# New mechanism: enemy_single_lowest_max_hp target_type
# ════════════════════════════════════════════════════════════════════
class TestRegEnemySingleLowestMaxHp(_BaseTest):
    """enemy_single_lowest_max_hp: selects enemy with lowest max_hp.

    Tie-broken by nearest position (uses _get_sort_key for secondary sort).
    This target_type is registered in:
    - _resolve_target_range ONE_PAWN list (skill_service.py:8905)
    - _SPECIAL_POSTFILTER_TYPES for damage (skill_service.py:903)
    - damage postfilter (skill_service.py:2061-2070)
    - aura postfilter (skill_service.py:6000-6009)
    - add_status postfilter (skill_service.py:7249)
    - prescan (skill_service.py:7353)
    - target range resolution (skill_service.py:9022-9028)
    - damage block target selection (skill_service.py:1896)
    - aura special postfilter set (skill_service.py:5619)
    """

    def test_selects_enemy_with_lowest_max_hp(self):
        """When 3 enemies have different max_hp, lowest_max_hp filter selects
        the one with the smallest max_hp value."""
        from src.combat_v2.services.target_service import TargetService

        ts = TargetService()
        caster = _make_unit("caster", "Caster", Side.ALLY,
                            Position.ALLY_CENTER_FRONT)
        e1 = _make_unit("e1", "E1", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=50000)
        e2 = _make_unit("e2", "E2", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=30000)
        e3 = _make_unit("e3", "E3", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=70000)

        bf = _make_bf(caster, e1, e2, e3)

        # Use select_min_with_stealth directly to verify lowest_max_hp key
        candidates = [e1, e2, e3]
        best = ts.select_min_with_stealth(
            candidates,
            key_func=lambda u: (u.max_hp, ts._get_sort_key(caster, u)),
            consume=False,
        )
        self.assertIsNotNone(best)
        self.assertEqual(best.unit_id, "e2",
                         "Should select e2 (max_hp=30000, lowest)")
        self.assertEqual(best.max_hp, 30000)

    def test_tiebreak_by_nearest_position(self):
        """When multiple enemies have the same max_hp, nearest position wins."""
        from src.combat_v2.services.target_service import TargetService

        ts = TargetService()
        # Caster at ALLY_CENTER_FRONT
        caster = _make_unit("caster", "Caster", Side.ALLY,
                            Position.ALLY_CENTER_FRONT)
        # All enemies have same max_hp=50000
        # Nearest to ALLY_CENTER_FRONT should be ENEMY_CENTER_FRONT
        e_cf = _make_unit("e_cf", "CenterFront", Side.ENEMY,
                          Position.ENEMY_CENTER_FRONT, hp=50000)
        e_lf = _make_unit("e_lf", "LeftFront", Side.ENEMY,
                          Position.ENEMY_LEFT_FRONT, hp=50000)
        e_rb = _make_unit("e_rb", "RightBack", Side.ENEMY,
                          Position.ENEMY_RIGHT_BACK, hp=50000)

        bf = _make_bf(caster, e_cf, e_lf, e_rb)

        candidates = [e_cf, e_lf, e_rb]
        best = ts.select_min_with_stealth(
            candidates,
            key_func=lambda u: (u.max_hp, ts._get_sort_key(caster, u)),
            consume=False,
        )
        self.assertIsNotNone(best)
        self.assertEqual(best.unit_id, "e_cf",
                         "Tie should be broken by nearest position "
                         "(ALLY_CENTER_FRONT -> ENEMY_CENTER_FRONT)")


# ════════════════════════════════════════════════════════════════════
# Integration: PS3 mark enables AS1 knockout
# ════════════════════════════════════════════════════════════════════
class TestRegDomesticPS3MarkEnablesAS1(_BaseTest):
    """Integration: PS3 grants 反重力おさげ mark, which enables AS1 Block2 knockout."""

    def test_ps3_then_as1_applies_knockout(self):
        """Execute PS3 first to gain mark, then AS1 should apply knockout."""
        caster = _make_unit("caster", "Leader", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=100000, atk=10000, skills=[_PS3, _AS1],
                            skill_levels={_PS3: 10, _AS1: 10}, pp=10, ap=10)
        e1 = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=50000)
        e2 = _make_unit("e2", "敵2", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=50000)
        bf = _make_bf(caster, e1, e2)
        ss, _, _ = self._make_services(bf)

        # Step 1: Execute PS3 to grant mark
        result_ps3 = ss.execute_skill(caster=caster, skill_id=_PS3, battlefield=bf,
                                       skip_cost=True)
        self.assertTrue(result_ps3["success"])

        # Verify mark is on caster
        mark_buffs = [b for b in caster.buffs
                      if b.effect_type == MARK and getattr(b, 'name', '') == '反重力おさげ']
        self.assertGreater(len(mark_buffs), 0,
                           "PS3 should grant 反重力おさげ mark to caster")

        # Step 2: Execute AS1 - should now apply knockout due to mark
        result_as1 = ss.execute_skill(caster=caster, skill_id=_AS1, battlefield=bf,
                                       skip_cost=True)
        self.assertTrue(result_as1["success"])

        # At least one of the two enemies should have knockout
        knockout_count = sum(
            1 for e in (e1, e2)
            for d in e.debuffs if d.effect_type == KNOCKOUT
        )
        self.assertGreater(knockout_count, 0,
                           "AS1 should apply knockout to at least 1 enemy "
                           "when caster has 反重力おさげ mark")


if __name__ == '__main__':
    unittest.main()
