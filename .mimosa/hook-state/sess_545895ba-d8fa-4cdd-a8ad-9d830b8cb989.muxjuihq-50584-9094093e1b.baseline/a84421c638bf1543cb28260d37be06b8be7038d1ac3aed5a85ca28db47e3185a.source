"""Regression: 起死回生の一手 (130151) self_hp_below 条件使用 pct 字段未读取 bug。

Bug: 技能「起死回生の一手」的Block2/3使用 condition.type="self_hp_below", pct=20,
     但代码只读 value 字段（不存在），threshold 默认为0，导致 hp_pct >= 0 永远为True,
     Block2/3 永远被跳过，HP<20%时的特别效果（cheat_death/mark/add_ep）从未触发。

Root cause: self_hp_below/self_hp_above/self_hp_above_not_full 条件读取
            block_condition.get('value', 0)，但130151的数据使用 'pct' 字段。

Fix: 改为 block_condition.get('value', block_condition.get('pct', 0))，
     同时接受 value 和 pct 字段。
"""
import unittest, sys, os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType

MARK = SkillEffectType.MARK.value
CHEAT_DEATH = SkillEffectType.CHEAT_DEATH.value
SHINRUI = "深慮"


class TestRegKishikaiseiHpBelowPct(unittest.TestCase):
    """起死回生の一手 (130151) self_hp_below pct 字段回归测试。"""

    def _setup(self, hp_ratio=1.0):
        """构建caster + 1敌场景。hp_ratio控制caster初始HP比例。"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="caster", hp=100000, atk=10000, skills=[130151], level=10,
                    speed=999, defense=5000, pp=10)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT,
                     hp=200000, atk=5000, defense=5000, speed=500)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")
        e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")
        caster.current_hp = int(caster.max_hp * hp_ratio)
        return bf, ss, caster, e1

    def _has_shinrui_mark(self, unit):
        return any(b.effect_type == MARK and b.name == SHINRUI for b in unit.buffs)

    def _has_cheat_death(self, unit):
        return any(b.effect_type in ("cheat_death", "CheatDeath") for b in unit.buffs)

    # ── HP < 20%: Block2/3 应触发 ──────────────────────────

    def test_hp_below_20pct_triggers_special_effects(self):
        """HP=15% < 20% → Block2/3应触发: cheat_death + 深慮mark。"""
        bf, ss, caster, e1 = self._setup(hp_ratio=0.15)
        ss.execute_skill(caster=caster, skill_id=130151, battlefield=bf, skip_cost=True)
        self.assertTrue(self._has_cheat_death(caster), "HP<20% 应获得 cheat_death")
        self.assertTrue(self._has_shinrui_mark(caster), "HP<20% 应获得 深慮 mark")

    def test_hp_exactly_19pct_triggers(self):
        """HP=19% < 20% → 应触发。"""
        bf, ss, caster, e1 = self._setup(hp_ratio=0.19)
        ss.execute_skill(caster=caster, skill_id=130151, battlefield=bf, skip_cost=True)
        self.assertTrue(self._has_cheat_death(caster), "HP=19% 应触发 cheat_death")
        self.assertTrue(self._has_shinrui_mark(caster), "HP=19% 应触发 深慮 mark")

    # ── HP >= 20%: Block2/3 应跳过 ─────────────────────────

    def test_hp_exactly_20pct_skips(self):
        """HP=20% = 20% → 不满足 <20%，应跳过Block2/3。"""
        bf, ss, caster, e1 = self._setup(hp_ratio=0.20)
        ss.execute_skill(caster=caster, skill_id=130151, battlefield=bf, skip_cost=True)
        self.assertFalse(self._has_cheat_death(caster), "HP=20% 不应触发 cheat_death")
        self.assertFalse(self._has_shinrui_mark(caster), "HP=20% 不应触发 深慮 mark")

    def test_hp_50pct_skips(self):
        """HP=50% >= 20% → 应跳过Block2/3。"""
        bf, ss, caster, e1 = self._setup(hp_ratio=0.50)
        ss.execute_skill(caster=caster, skill_id=130151, battlefield=bf, skip_cost=True)
        self.assertFalse(self._has_cheat_death(caster), "HP=50% 不应触发 cheat_death")
        self.assertFalse(self._has_shinrui_mark(caster), "HP=50% 不应触发 深慮 mark")

    def test_hp_full_skips(self):
        """HP=100% → 应跳过Block2/3。"""
        bf, ss, caster, e1 = self._setup(hp_ratio=1.0)
        ss.execute_skill(caster=caster, skill_id=130151, battlefield=bf, skip_cost=True)
        self.assertFalse(self._has_cheat_death(caster), "满HP 不应触发 cheat_death")
        self.assertFalse(self._has_shinrui_mark(caster), "满HP 不应触发 深慮 mark")

    # ── Block1 (无条件) 始终触发 ───────────────────────────

    def test_shield_always_applied(self):
        """Block1无条件，无论HP多少都应施加shield。"""
        for ratio in [0.15, 0.50, 1.0]:
            bf, ss, caster, e1 = self._setup(hp_ratio=ratio)
            ss.execute_skill(caster=caster, skill_id=130151, battlefield=bf, skip_cost=True)
            shield_buffs = [b for b in caster.buffs if b.effect_type == "Shield"]
            self.assertGreaterEqual(len(shield_buffs), 1,
                                    f"HP={ratio*100:.0f}% 时应有 shield (Block1无条件)")

    # ── 边界: HP=1% ────────────────────────────────────────

    def test_hp_1pct_triggers(self):
        """HP=1% << 20% → 应触发。"""
        bf, ss, caster, e1 = self._setup(hp_ratio=0.01)
        ss.execute_skill(caster=caster, skill_id=130151, battlefield=bf, skip_cost=True)
        self.assertTrue(self._has_cheat_death(caster), "HP=1% 应触发 cheat_death")
        self.assertTrue(self._has_shinrui_mark(caster), "HP=1% 应触发 深慮 mark")


if __name__ == '__main__':
    unittest.main()
