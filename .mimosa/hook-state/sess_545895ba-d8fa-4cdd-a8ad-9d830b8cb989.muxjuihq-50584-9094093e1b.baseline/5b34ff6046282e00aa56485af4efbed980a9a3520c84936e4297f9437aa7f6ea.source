    def test_ps2_trigger_after_as_attacked(self):
        """PS2(230423) trigger_type=after_as_attacked: AS被攻撃後触发。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_allies()

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.ally_cf, primary_target=self.caster
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 230423]
        self.assertGreater(len(ps2_actions), 0, "after_as_attacked应触发PS2")

    def test_ps2_damage_uses_trigger_attacker(self):
        """PS2(230423) damage target_identifier=trigger_attacker: 反撃定位攻击者。

        让 ally_lf（次近敌）攻击 caster，验证反击定位 ally_lf（攻击者）而非 ally_cf（最近敌）。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_allies()
        hp_ally_cf_before = self.ally_cf.current_hp
        hp_ally_lf_before = self.ally_lf.current_hp

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.ally_lf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 230423]
        self.ss._trigger_attacker = self.ally_lf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        # 验证 ally_lf（攻击者）受到反击伤害
        self.assertLess(self.ally_lf.current_hp, hp_ally_lf_before,
                        "攻击者 ally_lf 应受到反击伤害")
        # 验证 ally_cf（最近敌）未受到反击伤害
        self.assertEqual(self.ally_cf.current_hp, hp_ally_cf_before,
                         "最近敌 ally_cf 不应受到反击伤害（trigger_attacker 定位攻击者）")

    def test_ps2_damage_is_power_based(self):
        """PS2(230423) damage value_tag=威力: 反击伤害基于威力（非受ダメージ%）。

        敌方版 230423 使用威力(value_tag=威力)，与己方版 130046 的受ダメージ%(value_tag=dmg)不同。
        验证反击伤害 > 0 且不依赖 caster.last_received_damage。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_allies()
        # 不设置 last_received_damage，验证伤害仍能基于威力计算
        self.caster.last_received_damage = 0

        hp_ally_before = self.ally_cf.current_hp

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.ally_cf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 230423]
        self.ss._trigger_attacker = self.ally_cf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        actual_damage = hp_ally_before - self.ally_cf.current_hp
        self.assertGreater(actual_damage, 0, "威力反击伤害应>0（不依赖received_damage）")

    def test_ps2_stun_applied_to_trigger_attacker(self):
        """PS2(230423) add_status stun: 付与 trigger_attacker 1/action 気絶。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_allies()

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.ally_cf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 230423]
        self.ss._trigger_attacker = self.ally_cf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        stuns = [d for d in self.ally_cf.debuffs if d.effect_type == STUN]
        self.assertGreater(len(stuns), 0, "trigger_attacker 应有 stun debuff")
        self.assertEqual(stuns[0].duration, 1, "stun duration应为1")

        # 验证其他友方未获得 stun
        stuns_lf = [d for d in self.ally_lf.debuffs if d.effect_type == STUN]
        self.assertEqual(len(stuns_lf), 0, "ally_lf 不应有 stun（trigger_attacker 定位）")

    def test_ps2_lv4_no_remove_pp(self):
        """PS2(230423) Lv4: remove_pp 条件（level_min=5）未满足，PP tag值为0，不削PP。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_allies()
        self.caster.level = 4
        self.caster.skill_levels[230423] = 4
        self.ally_cf.current_pp = 4

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.ally_cf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 230423]
        self.ss._trigger_attacker = self.ally_cf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        # PP tag Lv4=0.0（template_tags: [(1,0),(5,1),(10,10)], interpolation_mode=3, Lv4<5 取第一个值 0）
        self.assertEqual(self.ally_cf.current_pp, 4,
                         "Lv4时PP tag=0，不应削PP")

    def test_ps2_lv5_remove_pp_when_hp_cross_30(self):
        """PS2(230423) Lv5+: HP穿越30%时削PP（PP tag Lv5=1.0，削1）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_allies()
        self.caster.level = 5
        self.caster.skill_levels[230423] = 5
        # ally_cf HP=35%（>30%），反击伤害应使其HP降到30%以下
        self.ally_cf.current_hp = int(self.ally_cf.max_hp * 0.35)
        self.ally_cf.current_pp = 4

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.ally_cf, primary_target=self.caster,
        )
        ps2_actions = [a for a in trigger_actions if a.skill_id == 230423]
        self.ss._trigger_attacker = self.ally_cf
        self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_as_attacked")

        # PP tag Lv5=1.0，应削减1
        self.assertLess(self.ally_cf.current_pp, 4,
                        "HP穿越30%时PP应被削减")

