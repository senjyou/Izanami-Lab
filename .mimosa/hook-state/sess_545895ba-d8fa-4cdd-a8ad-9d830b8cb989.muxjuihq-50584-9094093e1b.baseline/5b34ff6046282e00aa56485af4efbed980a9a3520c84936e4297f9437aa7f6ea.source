    def test_ps2_all_effects_target_trigger_attacker(self):
        """PS2(230423) 配置校验: 所有 effects 的 target_identifier='trigger_attacker'。"""
        hybrid_map = self.dl.load_parsed_skills()
        hybrid = hybrid_map.get("230423")
        for block in hybrid.get('effect_blocks', []):
            for eff in block.get('effects', []):
                self.assertEqual(
                    eff.get('target_identifier'), 'trigger_attacker',
                    f"effect_type={eff.get('effect_type')} target_identifier应为 'trigger_attacker'"
                )

    def test_ps2_damage_uses_power_not_received_damage(self):
        """PS2(230423) 配置校验: damage效果使用 value_tag=威力，非 value_source=received_damage。

        敌方版 230423 与己方版 130046 的关键差异：
        - 敌方: value_tag=威力, flags 无 value_source=received_damage
        - 己方: value_tag=dmg, flags.value_source=received_damage
        """
        hybrid_map = self.dl.load_parsed_skills()
        hybrid = hybrid_map.get("230423")
        block1 = hybrid['effect_blocks'][0]
        damage_eff = next(e for e in block1['effects'] if e['effect_type'] == 'damage')
        self.assertEqual(damage_eff.get('value_tag'), '威力',
                         "敌方230423 damage value_tag应为'威力'（非'dmg'）")
        self.assertNotIn('value_source', damage_eff.get('flags', {}),
                         "敌方230423 damage flags不应包含 value_source=received_damage")

    # ════════════════════════════════════════════════════════════════
    # 综合场景
    # ════════════════════════════════════════════════════════════════

    def test_full_battle_flow_self_heal_and_attack(self):
        """综合场景: caster受伤→PS1自愈→AS2攻击。"""
        self._reset_caster(hp=int(self.caster.max_hp * 0.5))  # HP=50%
        self._reset_allies()

        # Step1: PS1 触发自愈（before_skill_use）
        hp_before_ps1 = self.caster.current_hp
        trigger_actions = self.ts.trigger_before_skill_use(
            self.caster, 220408, self.bf
        )
        ps1_actions = [a for a in trigger_actions if a.skill_id == 230422]
        self.ss._execute_trigger_actions_inline(ps1_actions, self.bf, "before_skill_use")
        self.assertGreater(self.caster.current_hp, hp_before_ps1,
                           "PS1应回复HP")

        # Step2: AS2 攻击 ally_cf
        hp_ally_before = self.ally_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=220408, battlefield=self.bf, skip_cost=True
        )
        self.assertLess(self.ally_cf.current_hp, hp_ally_before,
                        "AS2应造成伤害")

    def test_ex_block_specific_aura_consumed_after_blocking(self):
        """EX(210115) block_specific_aura: 阻止1次stun后仍持续（block_status_count=0=不限次数）。"""
        self._reset_caster(hp=self.caster.max_hp)

        self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )

        for i in range(3):
            stun_debuff = BuffState(
                buff_id=f"test_stun_{i}", name="stun", effect_type=STUN,
                value=0, duration=1, timing_type=2,
                is_debuff=True, is_stackable=False,
                source_unit_id="ally_cf",
            )
            self.aus.add_aura(self.caster, stun_debuff)

        stuns = [d for d in self.caster.debuffs if d.effect_type == STUN]
        self.assertEqual(len(stuns), 0, "block_specific_aura 应阻止所有 stun 付与（不限次数）")


if __name__ == "__main__":
    unittest.main(verbosity=2)
