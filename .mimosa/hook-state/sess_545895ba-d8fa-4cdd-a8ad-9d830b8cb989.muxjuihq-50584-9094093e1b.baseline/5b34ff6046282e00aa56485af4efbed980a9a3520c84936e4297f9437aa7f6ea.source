    def test_as2_damage_enemy_single(self):
        """AS2(220408) Block1: 敌单体 damage（caster 的 enemy = friend_team）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_allies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220408, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证最近友方 ally_cf 受到伤害
        self.assertLess(self.ally_cf.current_hp, self.ally_cf.max_hp,
                        "ally_cf应受到AS2伤害")
