        self.assertEqual(self.ally_lf.current_hp, self.ally_lf.max_hp,
                         "ally_lf不应受到AS2伤害（单体）")
        self.assertEqual(self.ally_rf.current_hp, self.ally_rf.max_hp,
                         "ally_rf不应受到AS2伤害（单体）")

