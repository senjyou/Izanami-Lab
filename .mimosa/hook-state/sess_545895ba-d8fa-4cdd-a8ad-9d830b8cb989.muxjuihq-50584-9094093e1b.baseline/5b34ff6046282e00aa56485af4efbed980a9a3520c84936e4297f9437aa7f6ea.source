"""敌方角色 161418 惨禍：生駒葵 专项E2E测试

技能列表（同名己方 105301 厳格な規律の守護者）：
- EX: 210115 規律遵守の精神（自身heal[max_hp×cure%] + atk_up[50%, 2/action, stackable] + block_specific_aura[knockout, 2/action]；Lv5+ shield[atk×shield%]）
- AS1: 220407 旱天の慈雨（ally_single lowest_hp_priority shield[atk×shield%]；Lv5+ heal_over_time[max_hp×cure%, 2/action]；cooldown=2）
- AS2: 220408 一閃（enemy_single damage[威力]）
- PS1: 230422 腹が減っては戦ができぬ（before_skill_use + heal[self, lost_hp×cure%]；cooldown=1）
- PS2: 230423 捲土重来+（after_as_attacked + damage[trigger_attacker, 威力] + stun[1/action, trigger_attacker] + Lv5+ remove_pp[trigger_attacker, hp_threshold_cross 30%] + Lv10 remove_all_pp；cooldown=1）

与同名己方 105301 的差异：
- active_level_min阈值：11→5, 15→10
- EX cure削弱：己方Lv10=60% → 敌方Lv10=3.0%
- PS1 cure削弱：己方Lv10=40% → 敌方Lv10=5.0%
- PS2 damage：己方使用受ダメージ%(value_tag=dmg, value_source=received_damage) → 敌方使用威力(value_tag=威力)

阵营说明（敌方caster视角）：
- caster 属于 enemy_team
- caster 的 ally_single/enemy_single 等索敌类型从敌方视角指向：ally_single=enemy_team, enemy_single=friend_team
- PS2 反击目标 trigger_attacker 为攻击 caster 的友方（friend_team 成员）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerContext, TriggerTiming
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.skill_data_resolver import SkillDataResolver

# 简写
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value       # atk_up/atk_down
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value     # def_up/def_down
STUN = SkillEffectType.KNOCKOUT.value                     # 気絶
HEAL_OVER_TIME = SkillEffectType.HEAL_OVER_TIME.value
BLOCK_SPECIFIC_AURA = SkillEffectType.BLOCK_SPECIFIC_AURA.value


class TestActor161418(unittest.TestCase):
    """敌方角色 161418 惨禍：生駒葵 专项E2E测试

    caster 为敌方(Side.ENEMY)，敌方队伍放 enemy_team，友方（被攻击目标）放 friend_team。
    """

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 敌方施法者: 161418 惨禍：生駒葵 (土属性attr=4, 物理型character_type=1, 前排position_type=1, タンクrole_type=3)
        # 放敌方前排中央。AP=10, PP=10。默认Lv10，部分测试用Lv5/Lv10验证进阶分支
        self.caster = UnitState(
            unit_id="caster", name="惨禍：生駒葵", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=161418, level=10,
            element=4, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[210115, 220407, 220408, 230422, 230423],
            skill_levels={210115: 10, 220407: 10, 220408: 10,
                          230422: 10, 230423: 10},
            skill_cooldowns={},
        )

        # 敌方队友（caster 的 ally）：前排左（用于 lowest_hp_priority 测试）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前(队友)", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方队友（caster 的 ally）：前排右（HP较低，用于 lowest_hp_priority 测试）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前(队友)", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999002, level=10,
            element=3, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=7000, defense=3500, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方（caster 的 enemy）：前排中央（主目标，用于 AS2/PS2 反击测试）
        self.ally_cf = UnitState(
            unit_id="ally_cf", name="友中前", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999101, level=10,
            element=2, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[120040], skill_levels={120040: 10}, skill_cooldowns={},
        )

        # 友方（caster 的 enemy）：左前（次近敌，用于验证 trigger_attacker 不误选最近敌）
        self.ally_lf = UnitState(
            unit_id="ally_lf", name="友左前", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999103, level=10,
            element=3, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=3000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[120040], skill_levels={120040: 10}, skill_cooldowns={},
        )

        # 友方右前
        self.ally_rf = UnitState(
            unit_id="ally_rf", name="友右前", side=Side.ALLY,
            position=Position.ALLY_RIGHT_FRONT, character_id=999104, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=3500, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.enemy_team = [self.caster, self.enemy_lf, self.enemy_rf]
        self.bf.friend_team = [self.ally_cf, self.ally_lf, self.ally_rf]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)
        self.resolver = SkillDataResolver(self.dl)

    # ════════════════════════════════════════════════════════════════
    # 辅助方法
    # ════════════════════════════════════════════════════════════════

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.level = 10
        self.caster.shield = 0
        self.caster.physical_shield = 0
        self.caster.en_shield = 0
        self.caster.cumulative_hp_damage = 0
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10

    def _reset_enemy_allies(self):
        """重置敌方队友（caster 的 allies）状态。"""
        self._reset_caster()
        for e in [self.enemy_lf, self.enemy_rf]:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.shield = 0
            e.physical_shield = 0
            e.en_shield = 0

    def _reset_allies(self):
        """重置友方（caster 的 enemies）状态。"""
        for a in [self.ally_cf, self.ally_lf, self.ally_rf]:
            a.current_hp = a.max_hp
            a.buffs = []
            a.debuffs = []
            a.is_alive = True
            a.current_ap = 4
            a.current_pp = 4
            a.shield = 0
            a.physical_shield = 0
            a.en_shield = 0

    # ════════════════════════════════════════════════════════════════
    # 角色数据加载验证
    # ════════════════════════════════════════════════════════════════

    def test_enemy_data_loadable(self):
        """敌方角色数据可正常加载。"""
        from src.data.data_loader import DataLoader
        dl = DataLoader()
        dl.load_all()
        enemies = dl.get_tactical_exercise_enemies()
        # get_tactical_exercise_enemies 返回 Dict[int, Dict]，key 为 enemy_id
        self.assertIn(161418, enemies, "161418 应被加载到战术演习敌人列表")
        self.assertEqual(enemies[161418].get('name'), "惨禍：生駒葵")

    def test_all_skills_loadable(self):
        """所有技能可加载且 hybrid 配置存在。"""
        hybrid_map = self.dl.load_parsed_skills()
        for sid in [210115, 220407, 220408, 230422, 230423]:
            hybrid = hybrid_map.get(str(sid))
            self.assertIsNotNone(hybrid, f"技能 {sid} hybrid 配置应存在")
            self.assertNotEqual(hybrid.get('parse_status'), 'failed',
                                f"技能 {sid} parse_status 不应为 failed")

    def test_ps_trigger_type_valid(self):
        """PS 技能的 trigger_type 在 TRIGGER_TYPE_MAP 中已注册。"""
        from src.combat_v2.services.trigger_service import TRIGGER_TYPE_MAP
        hybrid_map = self.dl.load_parsed_skills()
        for sid in [230422, 230423]:
            hybrid = hybrid_map.get(str(sid))
            tt = hybrid.get('trigger_type')
            self.assertIsNotNone(tt, f"技能 {sid} 应有 trigger_type")
            self.assertIn(tt, TRIGGER_TYPE_MAP,
                          f"技能 {sid} trigger_type '{tt}' 应在 TRIGGER_TYPE_MAP 中")

    def test_level_thresholds_adjusted(self):
        """验证敌方 active_level_min 阈值已调整为 5/10（非己方的 11/15）。"""
        hybrid_map = self.dl.load_parsed_skills()
        # EX 210115 Block2 level_min 应为 5
        ex = hybrid_map.get("210115")
        block2 = next(b for b in ex['effect_blocks'] if b.get('block_id') == 2)
        self.assertEqual(block2.get('level_min'), 5,
                         "EX Block2 level_min 应为 5（敌方阈值）")
        # AS1 220407 Block2 level_min 应为 5
        as1 = hybrid_map.get("220407")
        block2 = next(b for b in as1['effect_blocks'] if b.get('block_id') == 2)
        self.assertEqual(block2.get('level_min'), 5,
                         "AS1 Block2 level_min 应为 5（敌方阈值）")
        # PS2 230423 Block2 level_min 应为 10
        ps2 = hybrid_map.get("230423")
        block2 = next(b for b in ps2['effect_blocks'] if b.get('block_id') == 2)
        self.assertEqual(block2.get('level_min'), 10,
                         "PS2 Block2 level_min 应为 10（敌方阈值）")

    # ════════════════════════════════════════════════════════════════
    # EX: 210115 規律遵守の精神
    # ════════════════════════════════════════════════════════════════

    def test_ex_heal_based_on_max_hp(self):
        """EX(210115) Block1 heal: heal_base=max_hp，回复量=max_hp×cure%。

        敌方 cure Lv10=3.0%（template_tags 最后值），回复量 = 20000 × 3 / 100 = 600。
        """
        self._reset_caster(hp=int(self.caster.max_hp * 0.2))  # HP=20%
        hp_before = self.caster.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 敌方 cure Lv10=3.0%（template_tags: [(1,1.75),(3,3.0)]，Lv10>=3 取最后值 3.0）
        expected_heal = int(self.caster.max_hp * 3.0 / 100)
        self.assertEqual(self.caster.current_hp, hp_before + expected_heal,
                         f"EX heal应回复max_hp×3.0%={expected_heal}，实际={self.caster.current_hp - hp_before}")

    def test_ex_atk_up_50_percent_stackable(self):
        """EX(210115) Block1 atk_up: 50%, 2/action, stackable。"""
        self._reset_caster(hp=self.caster.max_hp)

        self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )

        atk_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 1, "应有1个atk_up buff")
        self.assertEqual(atk_buffs[0].value, 50, "atk_up值应为50%")
        self.assertEqual(atk_buffs[0].duration, 2, "atk_up duration应为2")
        self.assertTrue(atk_buffs[0].is_stackable, "atk_up应为stackable")

    def test_ex_atk_up_stacks_with_multiple_casts(self):
        """EX(210115) atk_up stackable: 多次施放应叠加（buff_id 唯一）。"""
        self._reset_caster(hp=self.caster.max_hp)

        self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )
        self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )

        atk_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 2, "两次施放应有2个独立atk_up buff（stackable）")
        self.assertNotEqual(atk_buffs[0].buff_id, atk_buffs[1].buff_id,
                            "stackable buff 应有不同 buff_id")

    def test_ex_block_specific_aura_knockout(self):
        """EX(210115) Block1 block_specific_aura: 阻止 knockout 付与。"""
        self._reset_caster(hp=self.caster.max_hp)

        self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )

        block_auras = [b for b in self.caster.buffs if b.effect_type == BLOCK_SPECIFIC_AURA]
        self.assertEqual(len(block_auras), 1, "应有1个block_specific_aura buff")
        self.assertEqual(block_auras[0].duration, 2, "block_specific_aura duration应为2")
        self.assertIn('knockout', block_auras[0].block_status_list,
                      "block_status_list 应包含 'knockout'")

    def test_ex_block_specific_aura_prevents_stun(self):
        """EX(210115) block_specific_aura 实际阻止 stun 付与。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_allies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )

        stun_debuff = BuffState(
            buff_id="test_stun", name="stun", effect_type=STUN,
            value=0, duration=1, timing_type=2,
            is_debuff=True, is_stackable=False,
            source_unit_id="ally_cf",
        )
        self.aus.add_aura(self.caster, stun_debuff)

        stuns = [d for d in self.caster.debuffs if d.effect_type == STUN]
        self.assertEqual(len(stuns), 0, "block_specific_aura 应阻止 stun 付与")

    def test_ex_block_specific_aura_does_not_block_other_debuffs(self):
        """EX(210115) block_specific_aura 仅阻止 knockout，不阻止其他 debuff。"""
        self._reset_caster(hp=self.caster.max_hp)

        self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )

        atk_down = BuffState(
            buff_id="test_atk_down", name="atk_down", effect_type=STATUS_ATTACK,
            value=20, duration=2, timing_type=2,
            is_debuff=True, is_stackable=False,
            source_unit_id="ally_cf",
        )
        self.aus.add_aura(self.caster, atk_down)

        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_downs), 0, "block_specific_aura 不应阻止 atk_down")

    def test_ex_lv4_no_shield(self):
        """EX(210115) Lv4: Block2 (level_min=5) 跳过，无 shield。"""
        self._reset_caster(hp=self.caster.max_hp)
        self.caster.level = 4
        self.caster.skill_levels[210115] = 4

        self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )

        self.assertEqual(self.caster.shield, 0, "Lv4时不应获得 shield（level_min=5）")

    def test_ex_lv5_shield_based_on_atk(self):
        """EX(210115) Lv5+: Block2 shield，shield_base=atk，盾值=atk×shield%。

        敌方 shield Lv5=100%（template_tags: [(1,0),(4,0),(5,100),(10,150)]，Lv5=100）。
        注意：EX Block1 先施加 atk_up(50%)，shield 使用 buffed atk 计算。
        base_atk=10000, buffed_atk=10000×1.5=15000, 盾值=15000×100/100=15000。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self.caster.level = 5
        self.caster.skill_levels[210115] = 5

        self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )

        self.assertGreater(self.caster.shield, 0, "Lv5+应获得 shield")
        # shield Lv5=100%，使用 buffed atk（atk_up 50% 已在 Block1 施加）
        buffed_atk = int(self.caster.attack * 1.5)
        expected_shield = int(buffed_atk * 100 / 100)
        self.assertEqual(self.caster.shield, expected_shield,
                         f"shield值应为buffed_atk×100%={expected_shield}，实际={self.caster.shield}")

    def test_ex_lv10_shield_150_percent(self):
        """EX(210115) Lv10: shield=150%，盾值=buffed_atk×150%。

        base_atk=10000, buffed_atk=10000×1.5=15000, 盾值=15000×150/100=22500。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self.caster.level = 10
        self.caster.skill_levels[210115] = 10

        self.ss.execute_skill(
            caster=self.caster, skill_id=210115, battlefield=self.bf, skip_cost=True
        )

        # shield Lv10=150%，使用 buffed atk（atk_up 50% 已在 Block1 施加）
        buffed_atk = int(self.caster.attack * 1.5)
        expected_shield = int(buffed_atk * 150 / 100)
        self.assertEqual(self.caster.shield, expected_shield,
                         f"shield值应为buffed_atk×150%={expected_shield}，实际={self.caster.shield}")

    # ════════════════════════════════════════════════════════════════
    # AS1: 220407 旱天の慈雨
    # ════════════════════════════════════════════════════════════════

    def test_as1_shield_lowest_hp_priority(self):
        """AS1(220407) Block1 shield: lowest_hp_priority 优先最低HP割合友方（caster 的 ally）。

        caster 为敌方，ally_single 指向 enemy_team。
        让 enemy_rf HP 割合最低，应选择 enemy_rf。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemy_allies()
        # enemy_rf HP 割合最低 (50%)
        self.enemy_rf.current_hp = int(self.enemy_rf.max_hp * 0.5)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220407, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 enemy_rf（HP割合最低）获得 shield
        self.assertGreater(self.enemy_rf.shield, 0, "HP割合最低的 enemy_rf 应获得 shield")
        # 验证其他敌方队友未获得 shield
        self.assertEqual(self.enemy_lf.shield, 0, "enemy_lf 不应获得 shield")
        self.assertEqual(self.caster.shield, 0, "caster 自身不应获得 shield")

    def test_as1_shield_value_based_on_atk(self):
        """AS1(220407) Block1 shield: shield_base=atk，盾值=atk×shield%。

        敌方 shield Lv10=120%（template_tags: [(1,80),(3,120)]，Lv10>=3 取 120）。
        盾值 = 10000 × 120 / 100 = 12000。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemy_allies()
        self.enemy_rf.current_hp = int(self.enemy_rf.max_hp * 0.5)

        self.ss.execute_skill(
            caster=self.caster, skill_id=220407, battlefield=self.bf, skip_cost=True
        )

        expected_shield = int(self.caster.attack * 120 / 100)
        self.assertEqual(self.enemy_rf.shield, expected_shield,
                         f"shield值应为atk×120%={expected_shield}，实际={self.enemy_rf.shield}")

    def test_as1_lv4_no_hot(self):
        """AS1(220407) Lv4: Block2 (level_min=5) 跳过，无 HOT。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemy_allies()
        self.enemy_rf.current_hp = int(self.enemy_rf.max_hp * 0.5)
        self.caster.level = 4
        self.caster.skill_levels[220407] = 4

        self.ss.execute_skill(
            caster=self.caster, skill_id=220407, battlefield=self.bf, skip_cost=True
        )

        hots = [b for b in self.enemy_rf.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hots), 0, "Lv4时不应获得 HOT（level_min=5）")

    def test_as1_lv5_hot(self):
        """AS1(220407) Lv5+: Block2 heal_over_time，2/action。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemy_allies()
        self.enemy_rf.current_hp = int(self.enemy_rf.max_hp * 0.5)
        self.caster.level = 5
        self.caster.skill_levels[220407] = 5

        self.ss.execute_skill(
            caster=self.caster, skill_id=220407, battlefield=self.bf, skip_cost=True
        )

        hots = [b for b in self.enemy_rf.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hots), 1, "Lv5+应获得 HOT")
        self.assertEqual(hots[0].duration, 2, "HOT duration应为2")

    def test_as1_cooldown_set_after_use(self):
        """AS1(220407) cooldown=2: 施放后设置冷却。"""
