                        "Spd 最高的 a3 应受到 220370 Effect2 伤害")

    def test_kasumi_220370_b2_e1_pp_gain_on_crit_only_once(self):
        """220370 Block2 Effect1 (on_crit): modify_pp(self) +1
        即使 2 个 damage effect 都暴击，整技能仅 +1 PP (once_per_skill=true)
        """
        kasumi = self._make_kasumi(crit_rate=1.0)  # 强制暴击
        kasumi.current_pp = 2  # cap=4, 设 2 以便观察 +1→3
        # 提供两个不同目标 (atk 最高 / spd 最高) 让 2 个 effect 都暴击
        a1 = self._make_ally_dummy("a1", Position.ALLY_LEFT_FRONT,
                                   hp=100000, atk=9999, speed=100)
        a3 = self._make_ally_dummy("a3", Position.ALLY_RIGHT_FRONT,
                                   hp=100000, atk=500, speed=999)
        bf = _make_bf(kasumi, a1, a3)
        ss, ts, *_ = self._make_services(bf)

        pp_before = kasumi.current_pp
        result = ss.execute_skill(
            caster=kasumi, skill_id=220370, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        pp_gain = kasumi.current_pp - pp_before
        self.assertEqual(pp_gain, 1,
                         f"2 effect 都暴击时 PP 应仅 +1 (once_per_skill)，实际 +{pp_gain}")

    # ─── 230391 カウンターショット (PS, after_as_attacked) ───
    def test_kasumi_230391_b1_e1_counter_damage_to_attacker(self):
        """230391 Block1 Effect1: damage(enemy_single, trigger_attacker)
        友方 AS 攻击霞光 → 霞光反撃攻击者，攻击者 HP 下降
        """
        kasumi = self._make_kasumi(position=Position.ENEMY_CENTER_FRONT)
        ally_attacker = _make_unit(
            "ally_atk", "友方攻击者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.LIGHT.value,
            skills=[120049],  # 一个简单的 AS 技能
            skill_levels={120049: 10},
        )
        bf = _make_bf(kasumi, ally_attacker)
        ss, ts, *_ = self._make_services(bf)

        # 友方攻击者用 AS 攻击霞光
        result = ss.execute_skill(
            caster=ally_attacker, skill_id=120049, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 触发 after_as_attacked (霞光被 AS 攻击后)
        trigger_actions = ts.trigger_after_as_attacked(
            targets=[kasumi], battlefield=bf,
            actor=ally_attacker, primary_target=kasumi,
        )
        ps_actions = [a for a in trigger_actions if a.skill_id == 230391]
        self.assertGreater(len(ps_actions), 0,
                           "霞光应触发 230391 反撃 PS")

        # 执行 PS
        ss._pending_crit_triggers = []
        ally_hp_before = ally_attacker.current_hp
        ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="after_as_attacked"
        )

        # 攻击者应受到反撃伤害
        self.assertLess(ally_attacker.current_hp, ally_hp_before,
                        "攻击者应受到霞光 230391 反撃伤害")

    def test_kasumi_230391_b2_e1_pp_gain_on_crit(self):
        """230391 Block2 Effect1 (on_crit): modify_pp(self) +1
        反撃暴击时霞光 PP+1。
        注意: PS 自身消耗 1 PP，on_crit +1 抵消后净 PP 变化=0。
        因此通过检查 _inline_ps_results 中的 modify_pp 效果条目来验证 on_crit 生效，
        同时对比有暴击(净变≥0)与无暴击(净变=-1)的差异。
        """
        kasumi = self._make_kasumi(position=Position.ENEMY_CENTER_FRONT,
                                   crit_rate=1.0)  # 强制暴击
        kasumi.initial_passive_point = 10  # 提高 cap 避免截断
        kasumi.current_pp = 10
        ally_attacker = _make_unit(
            "ally_atk", "友方攻击者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.LIGHT.value,
            skills=[120049], skill_levels={120049: 10},
        )
        bf = _make_bf(kasumi, ally_attacker)
        ss, ts, *_ = self._make_services(bf)

        ss.execute_skill(
            caster=ally_attacker, skill_id=120049, battlefield=bf, skip_cost=True
        )
        trigger_actions = ts.trigger_after_as_attacked(
            targets=[kasumi], battlefield=bf,
            actor=ally_attacker, primary_target=kasumi,
        )
        ps_actions = [a for a in trigger_actions if a.skill_id == 230391]
        self.assertGreater(len(ps_actions), 0, "霞光应触发 230391 反撃 PS")

        pp_before = kasumi.current_pp
        ss._pending_crit_triggers = []
        ss._inline_ps_results = []
        ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="after_as_attacked"
        )

        # 1. 检查 _inline_ps_results 中存在 modify_pp 效果条目 (on_crit 生效的直接证据)
        modify_pp_found = False
        for ps_res in ss._inline_ps_results:
            for eff in ps_res.get("result", {}).get("effects_applied", []):
                if eff.get("effect_type") == "modify_pp":
                    modify_pp_found = True
                    self.assertEqual(eff.get("delta"), 1,
                                     f"on_crit modify_pp delta 应为 1, 实际 {eff.get('delta')}")
                    break
            if modify_pp_found:
                break
        self.assertTrue(modify_pp_found,
                        "反撃暴击时应触发 on_crit modify_pp(+1) 效果，"
                        "但 _inline_ps_results 中未找到 modify_pp 条目")

        # 2. 有暴击时 PP 净变化应 >= 0 (on_crit +1 抵消 PS 消耗 1 PP)
        pp_gain = kasumi.current_pp - pp_before
        self.assertGreaterEqual(pp_gain, 0,
                                f"反撃暴击时 PP 净变化应 >=0 (on_crit +1 抵消 PS cost), 实际 {pp_gain}")

    # ─── 230393 見切り構え・素 (PS, before_any_attacked) ───
    def test_kasumi_230393_b1_e1_guard_buff_applied(self):
        """230393 Block1 Effect1: guard(self) 50% (1 hit, attack_limited=1)
        霞光被攻撃前获得 guard buff
        """
        kasumi = self._make_kasumi(position=Position.ENEMY_CENTER_FRONT)
        ally_attacker = _make_unit(
            "ally_atk", "友方攻击者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.LIGHT.value,
            skills=[120049], skill_levels={120049: 10},
        )
        bf = _make_bf(kasumi, ally_attacker)
        ss, ts, *_ = self._make_services(bf)

        # 友方攻击者用 AS 攻击霞光
        ss.execute_skill(
            caster=ally_attacker, skill_id=120049, battlefield=bf, skip_cost=True
        )

        # 触发 before_any_attacked (霞光被攻撃前)
        trigger_actions = ts.trigger_before_any_attacked(
            targets=[kasumi], battlefield=bf, attacker=ally_attacker,
        )
        ps_actions = [a for a in trigger_actions if a.skill_id == 230393]
        self.assertGreater(len(ps_actions), 0,
                           "霞光应触发 230393 見切り構え・素 PS")

        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_any_attacked"
        )

        # 验证 guard buff
        guard_buff = _find_aura(kasumi, SkillEffectType.GUARD.value)
        self.assertIsNotNone(guard_buff, "霞光应获得 guard buff")

    def test_kasumi_230393_b1_e2_crit_rate_up_permanent_stackable(self):
        """230393 Block1 Effect2: crit_rate_up(self) +1% 永久重複可
        被攻 2 次后霞光应有 2 个 crit_rate_up buff (重複可)
        """
        kasumi = self._make_kasumi(position=Position.ENEMY_CENTER_FRONT,
                                   crit_rate=0.0)
        ally_attacker = _make_unit(
            "ally_atk", "友方攻击者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=1000, defense=4000, speed=500,  # 低 atk 避免打死
            element=Attribute.LIGHT.value,
            skills=[120049], skill_levels={120049: 10},
        )
        bf = _make_bf(kasumi, ally_attacker)
        ss, ts, *_ = self._make_services(bf)

        # 第 1 次被攻
        ss.execute_skill(
            caster=ally_attacker, skill_id=120049, battlefield=bf, skip_cost=True
        )
        trigger_actions_1 = ts.trigger_before_any_attacked(
            targets=[kasumi], battlefield=bf, attacker=ally_attacker,
        )
        ps_actions_1 = [a for a in trigger_actions_1 if a.skill_id == 230393]
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(
            ps_actions_1, bf, trigger_timing="before_any_attacked"
        )

        crit_up_count_1 = _count_auras(kasumi, SkillEffectType.STATUS_CRITICAL_CHANCE.value)
        self.assertGreaterEqual(crit_up_count_1, 1,
                                "第 1 次被攻后应有 ≥1 个 crit_rate_up buff")

        # 重置攻击者 cooldown 准备第 2 次攻击
        ally_attacker.skill_cooldowns = {}

        # 第 2 次被攻
        ss.execute_skill(
            caster=ally_attacker, skill_id=120049, battlefield=bf, skip_cost=True
        )
        trigger_actions_2 = ts.trigger_before_any_attacked(
            targets=[kasumi], battlefield=bf, attacker=ally_attacker,
        )
        ps_actions_2 = [a for a in trigger_actions_2 if a.skill_id == 230393]
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(
            ps_actions_2, bf, trigger_timing="before_any_attacked"
        )

        crit_up_count_2 = _count_auras(kasumi, SkillEffectType.STATUS_CRITICAL_CHANCE.value)
        self.assertGreater(crit_up_count_2, crit_up_count_1,
                           f"第 2 次被攻后 crit_rate_up 数量应增加 "
                           f"({crit_up_count_1} → {crit_up_count_2})，重複可生效")

    # ─── 230393 見切り構え・素: AS/PS/EX 攻撃タイプ別 guard 減傷テスト ───

    def _make_kasumi_for_guard_test(self, position=Position.ENEMY_CENTER_FRONT,
                                     with_guard=True, pp=4):
        """guard テスト用霞光を作成 (230393 の有無を切替)"""
        skills = [220369, 230393] if with_guard else [220369]
        levels = {220369: 10, 230393: 10} if with_guard else {220369: 10}
        u = _make_unit(
            "kasumi", "霞光", Side.ENEMY, position,
            hp=100000, atk=10000, defense=4000, speed=750,
            crit_rate=0.0, crit_damage=0.5,
            element=Attribute.DARK.value, character_type=1,
            skills=skills, skill_levels=levels,
        )
        u.current_pp = pp
        return u

    def test_kasumi_230393_guard_vs_as_attack(self):
        """見切り構え・素 vs AS攻撃: guard 85% (Lv10) 減傷検証
        AS攻撃 → before_any_attacked → 230393発動 → guard buff → 減傷
        """
        # --- baseline: 230393 なし ---
        kasumi_base = self._make_kasumi_for_guard_test(with_guard=False)
        ally1 = _make_unit(
            "ally1", "友方1", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.LIGHT.value,
            skills=[120049], skill_levels={120049: 10},
        )
        bf1 = _make_bf(kasumi_base, ally1)
        ss1, *_ = self._make_services(bf1)

        hp_base_before = kasumi_base.current_hp
        r1 = ss1.execute_skill(caster=ally1, skill_id=120049, battlefield=bf1, skip_cost=True)
        self.assertTrue(r1["success"])
        dmg_base = hp_base_before - kasumi_base.current_hp
        self.assertGreater(dmg_base, 0, "AS baseline ダメージ > 0 であるべき")

        # --- with guard: 230393 あり ---
        kasumi_guard = self._make_kasumi_for_guard_test(with_guard=True, pp=4)
        ally2 = _make_unit(
            "ally2", "友方2", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.LIGHT.value,
            skills=[120049], skill_levels={120049: 10},
        )
        bf2 = _make_bf(kasumi_guard, ally2)
        ss2, *_ = self._make_services(bf2)

        hp_guard_before = kasumi_guard.current_hp
        r2 = ss2.execute_skill(caster=ally2, skill_id=120049, battlefield=bf2, skip_cost=True)
        self.assertTrue(r2["success"])
        dmg_guard = hp_guard_before - kasumi_guard.current_hp

        # guard buff が消費されたか確認 (attack_limited=1)
        guard_buff = _find_aura(kasumi_guard, SkillEffectType.GUARD.value)
        # guard buff は1ヒットで消費されるため、実行後は残っていないかも
        # (attack_limited=1 → 1回攻撃で消滅)

        # guard 85% → dmg_guard ≈ dmg_base * 0.15
        self.assertLess(dmg_guard, dmg_base,
                        f"AS: guard有({dmg_guard}) < guard無({dmg_base}) であるべき")
        expected = dmg_base * 0.15
        self.assertAlmostEqual(dmg_guard, expected, delta=max(2, expected * 0.15),
                               msg=f"AS: guard 85% 減傷期待値 {expected:.0f}, 実際 {dmg_guard}")

    def test_kasumi_230393_guard_vs_ex_attack(self):
        """見切り構え・素 vs EX攻撃: guard 85% (Lv10) 減傷検証
        EX攻撃 → before_any_attacked → 230393発動 → guard buff → 減傷
        """
        # --- baseline: 230393 なし ---
        kasumi_base = self._make_kasumi_for_guard_test(with_guard=False)
        ally1 = _make_unit(
            "ally1", "友方1", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.LIGHT.value,
            skills=[210098], skill_levels={210098: 10},
            ep=10,
        )
        bf1 = _make_bf(kasumi_base, ally1)
        ss1, *_ = self._make_services(bf1)

        hp_base_before = kasumi_base.current_hp
        r1 = ss1.execute_skill(caster=ally1, skill_id=210098, battlefield=bf1, skip_cost=True)
        self.assertTrue(r1["success"])
        dmg_base = hp_base_before - kasumi_base.current_hp
        self.assertGreater(dmg_base, 0, "EX baseline ダメージ > 0 であるべき")

        # --- with guard: 230393 あり ---
        kasumi_guard = self._make_kasumi_for_guard_test(with_guard=True, pp=4)
        ally2 = _make_unit(
            "ally2", "友方2", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.LIGHT.value,
            skills=[210098], skill_levels={210098: 10},
            ep=10,
        )
        bf2 = _make_bf(kasumi_guard, ally2)
        ss2, *_ = self._make_services(bf2)

        hp_guard_before = kasumi_guard.current_hp
        r2 = ss2.execute_skill(caster=ally2, skill_id=210098, battlefield=bf2, skip_cost=True)
        self.assertTrue(r2["success"])
        dmg_guard = hp_guard_before - kasumi_guard.current_hp

        self.assertLess(dmg_guard, dmg_base,
                        f"EX: guard有({dmg_guard}) < guard無({dmg_base}) であるべき")
        expected = dmg_base * 0.15
        self.assertAlmostEqual(dmg_guard, expected, delta=max(2, expected * 0.15),
                               msg=f"EX: guard 85% 減傷期待値 {expected:.0f}, 実際 {dmg_guard}")

    def test_kasumi_230393_guard_vs_ps_attack(self):
        """見切り構え・素 vs PS攻撃 (反撃シナリオ): guard 85% (Lv10) 減傷検証
        霞光がASで味方を攻撃 → 味方の230391反撃 → 霞光にPS攻撃 → 230393発動 → 減傷
        """
        def _run_ps_scenario(with_guard):
            """PS反撃シナリオを実行し、霞光の反撃被ダメージを返す"""
            kasumi = self._make_kasumi_for_guard_test(
                position=Position.ENEMY_CENTER_FRONT,
                with_guard=with_guard, pp=4,
            )
            # 味方A: 230391反撃PS持ち (霞光のAS攻撃対象)
            ally_a = _make_unit(
                "ally_a", "反撃味方", Side.ALLY, Position.ALLY_CENTER_FRONT,
                hp=50000, atk=8000, defense=4000, speed=500,
                element=Attribute.LIGHT.value,
                skills=[230391], skill_levels={230391: 10},
            )
            bf = _make_bf(kasumi, ally_a)
            ss, ts, *_ = self._make_services(bf)

            # 霞光がAS(220369)で味方Aを攻撃
            r = ss.execute_skill(caster=kasumi, skill_id=220369, battlefield=bf, skip_cost=True)
            self.assertTrue(r["success"])

            # after_as_attacked トリガー発生 (味方AがAS攻撃された後)
            trigger_actions = ts.trigger_after_as_attacked(
                targets=[ally_a], battlefield=bf,
                actor=kasumi, primary_target=ally_a,
            )
            ps_actions = [a for a in trigger_actions if a.skill_id == 230391]
            self.assertGreater(len(ps_actions), 0, "味方Aの230391反撃が発動すべき")

            # PS反撃実行 → 霞光が攻撃される → 230393発動(guard有りの場合)
            hp_before = kasumi.current_hp
            ss._pending_crit_triggers = []
            ss._execute_trigger_actions_inline(
                ps_actions, bf, trigger_timing="after_as_attacked"
            )
            dmg = hp_before - kasumi.current_hp
            return dmg

        # --- baseline: 230393 なし ---
        dmg_base = _run_ps_scenario(with_guard=False)
        self.assertGreater(dmg_base, 0, "PS baseline 反撃ダメージ > 0 であるべき")

        # --- with guard: 230393 あり ---
        dmg_guard = _run_ps_scenario(with_guard=True)

        self.assertLess(dmg_guard, dmg_base,
                        f"PS: guard有({dmg_guard}) < guard無({dmg_base}) であるべき")
        expected = dmg_base * 0.15
        self.assertAlmostEqual(dmg_guard, expected, delta=max(2, expected * 0.15),
                               msg=f"PS: guard 85% 減傷期待値 {expected:.0f}, 実際 {dmg_guard}")


# =============================================================================
# 大雷 (161560553) — 4 技能 / 9 效果点
# =============================================================================
class TestS6DaleiEffectPoints(_S6TestBase):
    """大雷技能效果点独立测试
    大雷: 暗属性(6), EN型(2), EN攻撃角色
    技能: 220367(AS大掃射) / 220368(AS大双弾) / 230389(PS大反撃) / 230390(PS大増幅)
    """

    def _make_dalei(self, position=Position.ENEMY_LEFT_FRONT, *,
                    crit_rate=0.0, atk=10000, hp=100000):
        """构造大雷 (暗属性, EN型, EN攻撃)"""
        return _make_unit(
            "dalei", "大雷", Side.ENEMY, position,
            hp=hp, atk=atk, defense=4000, speed=750,
            crit_rate=crit_rate, crit_damage=0.5,
            element=Attribute.DARK.value, character_type=2,
            skills=[220367, 220368, 230389, 230390],
            skill_levels={220367: 10, 220368: 10, 230389: 10, 230390: 10},
        )

    def _make_ally_dummy(self, unit_id, position, *,
                         hp=10000, atk=5000, defense=3000, speed=400,
                         crit_rate=0.0):
        return _make_unit(
            unit_id, f"友方_{unit_id}", Side.ALLY, position,
            hp=hp, atk=atk, defense=defense, speed=speed,
            crit_rate=crit_rate,
            element=Attribute.LIGHT.value, character_type=1,
        )

    # ─── 220367 大ノ掃射 (AS) ───
    def test_dalei_220367_b1_e1_damage_row_with_hp_scaling(self):
        """220367 Block1 Effect1: damage(enemy_row) + hp_scaling(max_bonus_pct=100)
        横一列敌方 HP 下降；HP=100% 敌方伤害 ≥ HP=50% 敌方伤害
        """
        dalei = self._make_dalei()
        a_full = self._make_ally_dummy("a_full", Position.ALLY_LEFT_FRONT,
                                       hp=100000, defense=3000)
        a_half = self._make_ally_dummy("a_half", Position.ALLY_RIGHT_FRONT,
                                       hp=100000, defense=3000)
        a_half.current_hp = int(a_half.max_hp * 0.5)  # 50% HP
        bf = _make_bf(dalei, a_full, a_half)
        ss, ts, *_ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in [a_full, a_half]}
        result = ss.execute_skill(
            caster=dalei, skill_id=220367, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_full = hp_before["a_full"] - a_full.current_hp
        dmg_half = hp_before["a_half"] - a_half.current_hp
        self.assertGreater(dmg_full, 0, "HP=100% 敌方应受到伤害")
        self.assertGreater(dmg_half, 0, "HP=50% 敌方应受到伤害")
        self.assertGreaterEqual(dmg_full, dmg_half,
                                f"HP=100% 敌方伤害({dmg_full})应 >= HP=50% 敌方伤害({dmg_half})")

    def test_dalei_220367_b2_e1_remove_buff_on_crit(self):
        """220367 Block2 Effect1 (on_crit): remove_buff_by_type(self, filter=[atk_up, crit_rate_up])
        暴击时大雷身上 atk_up/crit_rate_up buff 全被解除
        """
        dalei = self._make_dalei(crit_rate=1.0)  # 强制暴击
        a1 = self._make_ally_dummy("a1", Position.ALLY_LEFT_FRONT, hp=100000)
        bf = _make_bf(dalei, a1)
        ss, ts, *_ = self._make_services(bf)

        atk_buff = BuffState(
            buff_id="test_atk_up", name="TestAtkUp",
            effect_type=SkillEffectType.STATUS_ATTACK.value,
            value=10.0, duration=-1, timing_type="durable_target_maneuver_end",
            source_unit_id="test", caster_attack=10000, is_debuff=False,
        )
        crit_buff = BuffState(
            buff_id="test_crit_up", name="TestCritUp",
            effect_type=SkillEffectType.STATUS_CRITICAL_CHANCE.value,
            value=10.0, duration=-1, timing_type="durable_target_maneuver_end",
            source_unit_id="test", caster_attack=10000, is_debuff=False,
        )
        dalei.buffs.append(atk_buff)
        dalei.buffs.append(crit_buff)
        self.assertEqual(len(dalei.buffs), 2, "前置: 大雷应有 2 个 buff")

        result = ss.execute_skill(
            caster=dalei, skill_id=220367, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        atk_remaining = [b for b in dalei.buffs
                         if b.effect_type == SkillEffectType.STATUS_ATTACK.value]
        crit_remaining = [b for b in dalei.buffs
                          if b.effect_type == SkillEffectType.STATUS_CRITICAL_CHANCE.value]
        self.assertEqual(len(atk_remaining), 0,
                         "暴击时大雷 atk_up buff 应被全解除")
        self.assertEqual(len(crit_remaining), 0,
                         "暴击时大雷 crit_rate_up buff 应被全解除")

    # ─── 220368 大ノ双弾 (AS) ───
    def test_dalei_220368_b1_e1_damage_two_targets(self):
        """220368 Block1 Effect1: damage(enemy_single, target_count=2)
        防御低順 2 体 HP 下降
        """
        dalei = self._make_dalei()
        a_low_def = self._make_ally_dummy("a_low", Position.ALLY_LEFT_FRONT,
                                          hp=100000, defense=1000)
        a_mid_def = self._make_ally_dummy("a_mid", Position.ALLY_CENTER_FRONT,
                                          hp=100000, defense=3000)
        a_high_def = self._make_ally_dummy("a_high", Position.ALLY_RIGHT_FRONT,
                                           hp=100000, defense=9999)
        bf = _make_bf(dalei, a_low_def, a_mid_def, a_high_def)
        ss, ts, *_ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in [a_low_def, a_mid_def, a_high_def]}
        result = ss.execute_skill(
            caster=dalei, skill_id=220368, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        self.assertLess(a_low_def.current_hp, hp_before["a_low"],
                        "防御最低的 a_low 应受到 220368 伤害")
        self.assertLess(a_mid_def.current_hp, hp_before["a_mid"],
                        "防御第二低的 a_mid 应受到 220368 伤害")

    def test_dalei_220368_b2_e1_remove_buff_on_crit(self):
        """220368 Block2 Effect1 (on_crit): remove_buff_by_type(self, filter=[atk_up, crit_rate_up])
        暴击时大雷 atk_up/crit_rate_up 全解除
        """
