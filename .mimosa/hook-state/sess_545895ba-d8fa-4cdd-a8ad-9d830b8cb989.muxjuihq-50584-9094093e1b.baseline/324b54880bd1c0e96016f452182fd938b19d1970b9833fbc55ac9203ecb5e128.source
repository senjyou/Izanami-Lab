    def test_kasumi_220370_b1_e2_damage_highest_spd(self):
        """220370 Block1 Effect2: damage(enemy_single_highest_spd) ×2 hit
        Spd 最高敌方受到伤害 (与 Atk 最高不同时单独验证)
        """
        kasumi = self._make_kasumi()
