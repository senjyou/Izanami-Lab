#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
第六赛季对抗压制战 (Circle Battle S6) — 效果点级集成测试

针对 5 个敌方单位 (霞光/大雷/若雷/鳴雷/土雷) 的 21 个技能的每个效果点
(effect block 内每个 effect) 建立独立测试用例，通过真实 SkillService.execute_skill
+ 真实 TriggerService 触发链路验证效果是否真正生效。

设计文档: docs/implementation_logs/circle_battle_s6_test_plan.md
"""

import os
import sys
import unittest

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType,
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig
from src.combat_v2.battle_narrative import BattleNarrativeWriter


# =============================================================================
# 辅助函数
# =============================================================================

def _find_aura(unit, effect_type, name=None):
    """在 unit.buffs + unit.debuffs 中查找指定 effect_type 的 aura"""
    pools = list(unit.buffs) + list(unit.debuffs)
    for b in pools:
        if b.effect_type != effect_type:
            continue
        if name is not None and getattr(b, 'name', '') != name:
            continue
        return b
    return None


def _count_auras(unit, effect_type, name=None):
    """统计指定 effect_type (可选 name) 的 aura 数量"""
    n = 0
    for b in list(unit.buffs) + list(unit.debuffs):
        if b.effect_type != effect_type:
            continue
        if name is not None and getattr(b, 'name', '') != name:
            continue
        n += 1
    return n


def _find_mark(unit, mark_name):
    """查找指定名称的 mark aura"""
    return _find_aura(unit, SkillEffectType.MARK.value, name=mark_name)


def _count_marks(unit, mark_name):
    """统计指定名称的 mark 数量"""
    return _count_auras(unit, SkillEffectType.MARK.value, name=mark_name)


def _find_status(unit, status_type):
    """查找指定 status_type 的 status aura (status 通常存在 debuffs)
    status_type 可以是: 'action_damage', 'stun', 'confusion' 等
    实际 aura 的 effect_type 是 SkillEffectType 对应的枚举值 (如 ActionDamage/Knockout/Confusion)
    """
    _STATUS_TO_EFFECT_TYPE = {
        "action_damage": SkillEffectType.ACTION_DAMAGE.value,
        "stun": SkillEffectType.KNOCKOUT.value,
        "knockout": SkillEffectType.KNOCKOUT.value,
        "confusion": SkillEffectType.CONFUSION.value,
        "poison": SkillEffectType.POISON.value if hasattr(SkillEffectType, 'POISON') else "Poison",
        "burn": SkillEffectType.BURN.value if hasattr(SkillEffectType, 'BURN') else "Burn",
    }
    target_et = _STATUS_TO_EFFECT_TYPE.get(status_type, status_type)
    for b in list(unit.buffs) + list(unit.debuffs):
        if b.effect_type != target_et:
            continue
        return b
    return None


def _make_unit(unit_id, name, side, position, *,
               hp=10000, atk=1000, defense=500, speed=500,
               crit_rate=0.0, crit_damage=0.5,
               element=Attribute.FIRE.value, character_type=1,
               level=10, ap=10, pp=10, ep=0,
               skills=None, skill_levels=None):
    """构造 UnitState"""
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=level, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=ep,
        is_alive=True,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    """构造 BattlefieldState"""
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


# =============================================================================
# 基础测试基类：提供完整服务搭建
# =============================================================================
class _S6TestBase(unittest.TestCase):
    """S6 效果点测试基类：搭建真实 DataLoader + 全套服务"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        """为指定战场构造全套服务并返回 (ss, ts, dms, aus, tgs, sts)"""
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts, dms, aus, tgs, sts

    # ── 强制暴击辅助 ──
    def _force_crit(self, unit):
        """强制 unit 攻击必定暴击 (crit_rate=1.0)"""
        unit.crit_rate = 1.0

    def _force_no_crit(self, unit):
        """强制 unit 攻击不暴击"""
        unit.crit_rate = 0.0


# =============================================================================
# 霞光 (165161363) — 5 技能 / 9 效果点
# =============================================================================
class TestS6KasumiEffectPoints(_S6TestBase):
    """霞光技能效果点独立测试"""

    def _make_kasumi(self, position=Position.ENEMY_CENTER_BACK, *,
                     crit_rate=0.0, atk=10000, hp=100000):
        """构造霞光 (暗属性, 物理型, 物攻)"""
        return _make_unit(
            "kasumi", "霞光", Side.ENEMY, position,
            hp=hp, atk=atk, defense=4000, speed=750,
            crit_rate=crit_rate, crit_damage=0.5,
            element=Attribute.DARK.value, character_type=1,
            skills=[210098, 220369, 220370, 230391, 230393],
            skill_levels={210098: 10, 220369: 10, 220370: 10,
                          230391: 10, 230393: 10},
        )

    def _make_ally_dummy(self, unit_id, position, *,
                         hp=10000, atk=5000, defense=3000, speed=400,
                         crit_rate=0.0):
        return _make_unit(
            unit_id, f"友方_{unit_id}", Side.ALLY, position,
            hp=hp, atk=atk, defense=defense, speed=speed,
            crit_rate=crit_rate,
            element=Attribute.LIGHT.value, character_type=1,
        )

    # ─── 210098 真・紫影の斬撃 (EX) ───
    def test_kasumi_210098_b1_e1_damage_all_enemies(self):
        """210098 Block1 Effect1: damage(enemy_all) → 全部敌方 HP 下降"""
        kasumi = self._make_kasumi()
        a1 = self._make_ally_dummy("a1", Position.ALLY_LEFT_FRONT, hp=10000)
        a2 = self._make_ally_dummy("a2", Position.ALLY_CENTER_FRONT, hp=10000)
        a3 = self._make_ally_dummy("a3", Position.ALLY_RIGHT_FRONT, hp=10000)
        bf = _make_bf(kasumi, a1, a2, a3)
        ss, ts, *_ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in [a1, a2, a3]}
        result = ss.execute_skill(
            caster=kasumi, skill_id=210098, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"], "210098 应执行成功")

        for ally in [a1, a2, a3]:
            self.assertLess(ally.current_hp, hp_before[ally.unit_id],
                            f"{ally.unit_id} 应受到 210098 伤害")

    # ─── 220369 紫影の斬撃 (AS) ───
    def test_kasumi_220369_b1_e1_damage_all_enemies(self):
        """220369 Block1 Effect1: damage(enemy_all) → 全部敌方 HP 下降"""
        kasumi = self._make_kasumi()
        a1 = self._make_ally_dummy("a1", Position.ALLY_LEFT_FRONT, hp=10000)
        a2 = self._make_ally_dummy("a2", Position.ALLY_CENTER_FRONT, hp=10000)
        a3 = self._make_ally_dummy("a3", Position.ALLY_RIGHT_FRONT, hp=10000)
        bf = _make_bf(kasumi, a1, a2, a3)
        ss, ts, *_ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in [a1, a2, a3]}
        result = ss.execute_skill(
            caster=kasumi, skill_id=220369, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        for ally in [a1, a2, a3]:
            self.assertLess(ally.current_hp, hp_before[ally.unit_id],
                            f"{ally.unit_id} 应受到 220369 伤害")

    def test_kasumi_220369_b2_e1_pp_gain_on_crit(self):
        """220369 Block2 Effect1 (on_crit): modify_pp(self) +1
        暴击时霞光 PP+1，且整技能仅 +1 (多敌暴击也只+1)
        """
        kasumi = self._make_kasumi(crit_rate=1.0)  # 强制暴击
        kasumi.current_pp = 2  # 低于 cap(4) 以便观察 +1 不被截断
        a1 = self._make_ally_dummy("a1", Position.ALLY_LEFT_FRONT, hp=10000)
        a2 = self._make_ally_dummy("a2", Position.ALLY_CENTER_FRONT, hp=10000)
        a3 = self._make_ally_dummy("a3", Position.ALLY_RIGHT_FRONT, hp=10000)
        bf = _make_bf(kasumi, a1, a2, a3)
        ss, ts, *_ = self._make_services(bf)

        pp_before = kasumi.current_pp
        result = ss.execute_skill(
            caster=kasumi, skill_id=220369, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        pp_gain = kasumi.current_pp - pp_before
        self.assertEqual(pp_gain, 1,
                         f"暴击时 PP 应 +1 (实际 +{pp_gain})；多敌暴击也只+1 (once_per_skill)")

    def test_kasumi_220369_b2_e1_no_pp_gain_without_crit(self):
        """220369 Block2 Effect1 (on_crit): 非暴击时 PP 不变"""
        kasumi = self._make_kasumi(crit_rate=0.0)  # 强制不暴击
        kasumi.current_pp = 2  # cap=4
        a1 = self._make_ally_dummy("a1", Position.ALLY_LEFT_FRONT, hp=10000)
        bf = _make_bf(kasumi, a1)
        ss, ts, *_ = self._make_services(bf)

        pp_before = kasumi.current_pp
        result = ss.execute_skill(
            caster=kasumi, skill_id=220369, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertEqual(kasumi.current_pp, pp_before,
                         "非暴击时 PP 不应变化")

    # ─── 220370 ラピッドファイア (AS) ───
