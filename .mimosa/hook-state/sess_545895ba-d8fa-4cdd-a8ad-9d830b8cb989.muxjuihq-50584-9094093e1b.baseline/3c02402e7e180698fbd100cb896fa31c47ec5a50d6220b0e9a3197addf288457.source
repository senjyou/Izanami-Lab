#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
效果参数加载工具

提供统一的参数加载接口
"""

from typing import Dict, Any, Optional
import sqlite3


class EffectParamsLoader:
    """效果参数加载器"""
    
    @staticmethod
    def load_effect_params(effect_id: int, db_conn: sqlite3.Connection) -> Dict[str, Any]:
        """
        加载效果的所有参数
        
        Args:
            effect_id: 效果ID
            db_conn: 数据库连接
            
        Returns:
            包含所有参数的字典
        """
        params = {}
        cursor = db_conn.cursor()
        
        # 1. 加载数值参数
        cursor.execute("""
            SELECT param_key, param_value, param_tag
            FROM effect_numeric_params
            WHERE effect_id = ?
        """, (effect_id,))
        
        for row in cursor.fetchall():
            key = row[0]
            params[key] = {
                'value': row[1],
                'tag': row[2]
            }
        
        # 2. 加载持续时间
        cursor.execute("""
            SELECT duration, duration_tag, duration_unit, trigger_count, trigger_count_tag
            FROM effect_duration_params
            WHERE effect_id = ?
        """, (effect_id,))
        
        row = cursor.fetchone()
        if row:
            params['duration'] = {
                'value': row[0],
                'tag': row[1],
                'unit': row[2]
            }
            if row[3] is not None:
                params['trigger_count'] = {
                    'value': row[3],
                    'tag': row[4]
                }
        
        # 3. 加载标志
        cursor.execute("""
            SELECT flag_key, flag_value
            FROM effect_flag_params
            WHERE effect_id = ?
        """, (effect_id,))
        
        for row in cursor.fetchall():
            params[row[0]] = bool(row[1])
        
        # 4. 加载文本参数
        cursor.execute("""
            SELECT param_key, param_value
            FROM effect_text_params
            WHERE effect_id = ?
        """, (effect_id,))
        
        for row in cursor.fetchall():
            params[row[0]] = row[1]
        
        return params
    
    @staticmethod
    def load_trigger_effect_params(effect_id: int, db_conn: sqlite3.Connection) -> Dict[str, Any]:
        """
        加载被动触发效果的所有参数
        
        Args:
            effect_id: 效果ID
            db_conn: 数据库连接
            
        Returns:
            包含所有参数的字典
        """
        params = {}
        cursor = db_conn.cursor()
        
        # 1. 加载数值参数
        cursor.execute("""
            SELECT param_key, param_value, param_tag
            FROM trigger_effect_numeric_params
            WHERE effect_id = ?
        """, (effect_id,))
        
        for row in cursor.fetchall():
            key = row[0]
            params[key] = {
                'value': row[1],
                'tag': row[2]
            }
        
        # 2. 加载持续时间
        cursor.execute("""
            SELECT duration, duration_tag, duration_unit, trigger_count, trigger_count_tag
            FROM trigger_effect_duration_params
            WHERE effect_id = ?
        """, (effect_id,))
        
        row = cursor.fetchone()
        if row:
            params['duration'] = {
                'value': row[0],
                'tag': row[1],
                'unit': row[2]
            }
            if row[3] is not None:
                params['trigger_count'] = {
                    'value': row[3],
                    'tag': row[4]
                }
        
        # 3. 加载标志
        cursor.execute("""
            SELECT flag_key, flag_value
            FROM trigger_effect_flag_params
            WHERE effect_id = ?
        """, (effect_id,))
        
        for row in cursor.fetchall():
            params[row[0]] = bool(row[1])
        
        # 4. 加载文本参数
        cursor.execute("""
            SELECT param_key, param_value
            FROM trigger_effect_text_params
            WHERE effect_id = ?
        """, (effect_id,))
        
        for row in cursor.fetchall():
            params[row[0]] = row[1]
        
        return params
    
    @staticmethod
    def get_numeric_param(params: Dict[str, Any], key: str, default: float = 0.0) -> float:
        """
        获取数值参数的实际值
        
        Args:
            params: 参数字典
            key: 参数键
            default: 默认值
            
        Returns:
            参数值（如果有tag则需要外部解析）
        """
        if key not in params:
            return default
        
        param = params[key]
        if isinstance(param, dict):
            return param.get('value', default)
        return param
    
    @staticmethod
    def get_flag_param(params: Dict[str, Any], key: str, default: bool = False) -> bool:
        """
        获取标志参数
        
        Args:
            params: 参数字典
            key: 参数键
            default: 默认值
            
        Returns:
            布尔值
        """
        return params.get(key, default)
    
    @staticmethod
    def get_text_param(params: Dict[str, Any], key: str, default: Optional[str] = None) -> Optional[str]:
        """
        获取文本参数
        
        Args:
            params: 参数字典
            key: 参数键
            default: 默认值
            
        Returns:
            字符串值
        """
        return params.get(key, default)


# 便捷函数
def load_effect_params(effect_id: int, db_conn: sqlite3.Connection) -> Dict[str, Any]:
    """加载主动效果参数"""
    return EffectParamsLoader.load_effect_params(effect_id, db_conn)


def load_trigger_effect_params(effect_id: int, db_conn: sqlite3.Connection) -> Dict[str, Any]:
    """加载被动触发效果参数"""
    return EffectParamsLoader.load_trigger_effect_params(effect_id, db_conn)
