# Part 12: 返回值结构
# ═══════════════════════════════════════════════════════════════════════

class TestHpRatioDamageReturnStructure(_BaseHpRatioDamageTest):
    """_apply_hp_ratio_damage: 返回值结构。"""

    def test_return_value_fields_complete(self):
        """返回值包含所有字段。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=50000)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        effect = _make_effect(value=50)

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["effect_type"], "hp_ratio_damage")
        self.assertIn("targets", result)
        self.assertIn("total_damage", result)
        self.assertIn("damage", result)
        self.assertEqual(result["total_damage"], result["damage"])

    def test_target_hit_fields_complete(self):
        """targets 列表项包含完整字段。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=50000)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        effect = _make_effect(value=50)

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        target_hit = result["targets"][0]
        self.assertEqual(target_hit["target"], "E")
        self.assertEqual(target_hit["target_id"], "e")
        self.assertEqual(target_hit["hp_before"], 50000)
        self.assertEqual(target_hit["hp_after"], 45000)
        self.assertEqual(target_hit["damage"], 5000)
        self.assertEqual(target_hit["actual_damage"], 5000)
        self.assertEqual(target_hit["shield_absorbed"], 0)
        self.assertEqual(target_hit["crit"], False)
        self.assertIn("hits", target_hit)
        self.assertEqual(target_hit["hits"], [5000])
        self.assertIn("calc_detail", target_hit)


# ═══════════════════════════════════════════════════════════════════════
# Part 13: 多目标处理
# ═══════════════════════════════════════════════════════════════════════

class TestHpRatioDamageMultiTarget(_BaseHpRatioDamageTest):
    """_apply_hp_ratio_damage: 多目标处理。"""

    def test_multi_target_damage(self):
        """多目标技能对所有目标造成伤害。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        e1 = _make_unit("e1", "E1", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                        hp=50000, current_hp=50000)
        e2 = _make_unit("e2", "E2", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                        hp=50000, current_hp=50000)
        bf = _make_bf(caster, e1, e2)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        # target_type='enemy_all' 选中所有敌方
        effect = _make_effect(value=50, target_type='enemy_all')

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        self.assertEqual(len(result["targets"]), 2)
        # 每个目标 5000 伤害
        for hit in result["targets"]:
            self.assertEqual(hit["damage"], 5000)
            self.assertEqual(hit["actual_damage"], 5000)
        # total_damage = 10000
        self.assertEqual(result["total_damage"], 10000)

    def test_dead_target_skipped(self):
        """死亡目标被跳过。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        alive = _make_unit("alive", "A", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=50000)
        dead = _make_unit("dead", "D", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                          hp=50000, current_hp=0)
        dead.is_alive = False
        bf = _make_bf(caster, alive, dead)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        effect = _make_effect(value=50, target_type='enemy_all')

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        # 只处理存活目标
        self.assertEqual(len(result["targets"]), 1)
        self.assertEqual(result["targets"][0]["target_id"], "alive")


# ═══════════════════════════════════════════════════════════════════════
# Part 14: 目标选择路径
# ═══════════════════════════════════════════════════════════════════════

class TestHpRatioDamageTargetSelection(_BaseHpRatioDamageTest):
    """_apply_hp_ratio_damage: 目标选择路径。"""

    def test_mark_condition_targets_used(self):
        """_mark_condition_targets 优先使用（target_type='enemy_single'）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        e1 = _make_unit("e1", "E1", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                        hp=50000, current_hp=50000)
        e2 = _make_unit("e2", "E2", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                        hp=50000, current_hp=50000)
        bf = _make_bf(caster, e1, e2)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        # 设置 _mark_condition_targets 为 [e2]
        ss._mark_condition_targets = [e2]
        effect = _make_effect(value=50, target_type='enemy_single')

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        # 应该选中 e2 而非默认的 e1
        self.assertEqual(len(result["targets"]), 1)
        self.assertEqual(result["targets"][0]["target_id"], "e2")

    def test_mark_condition_target_singular(self):
        """_mark_condition_target (singular) 优先使用。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        e1 = _make_unit("e1", "E1", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                        hp=50000, current_hp=50000)
        e2 = _make_unit("e2", "E2", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                        hp=50000, current_hp=50000)
        bf = _make_bf(caster, e1, e2)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        ss._mark_condition_target = e2
        effect = _make_effect(value=50, target_type='enemy_single')

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        self.assertEqual(len(result["targets"]), 1)
        self.assertEqual(result["targets"][0]["target_id"], "e2")

    def test_block_damage_targets_cache_used(self):
        """_block_damage_targets 缓存优先使用。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        e1 = _make_unit("e1", "E1", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                        hp=50000, current_hp=50000)
        e2 = _make_unit("e2", "E2", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                        hp=50000, current_hp=50000)
        bf = _make_bf(caster, e1, e2)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        ss._block_damage_targets = {'enemy_single': [e2]}
        effect = _make_effect(value=50, target_type='enemy_single')

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        self.assertEqual(len(result["targets"]), 1)
        self.assertEqual(result["targets"][0]["target_id"], "e2")

    def test_primary_target_used(self):
        """target_identifier='primary_target' + _primary_target 使用。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        e1 = _make_unit("e1", "E1", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                        hp=50000, current_hp=50000)
        e2 = _make_unit("e2", "E2", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                        hp=50000, current_hp=50000)
        bf = _make_bf(caster, e1, e2)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        ss._primary_target = e2
        effect = _make_effect(value=50, target_type='enemy_single',
                              target_identifier='primary_target')

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        self.assertEqual(len(result["targets"]), 1)
        self.assertEqual(result["targets"][0]["target_id"], "e2")

    def test_default_select_targets(self):
        """无特殊路径时使用 select_targets 默认选择。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        e1 = _make_unit("e1", "E1", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                        hp=50000, current_hp=50000)
        bf = _make_bf(caster, e1)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        effect = _make_effect(value=50, target_type='enemy_single')

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        self.assertEqual(len(result["targets"]), 1)
        self.assertEqual(result["targets"][0]["target_id"], "e1")


# ═══════════════════════════════════════════════════════════════════════
# Part 15: damage_dealt_total / damage_taken_total
# ═══════════════════════════════════════════════════════════════════════

class TestHpRatioDamageTotals(_BaseHpRatioDamageTest):
    """_apply_hp_ratio_damage: damage_dealt_total / damage_taken_total 更新。"""

    def test_damage_totals_updated(self):
        """caster.damage_dealt_total 和 target.damage_taken_total 更新。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=50000)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        effect = _make_effect(value=50)  # 5000 伤害

        ss._apply_hp_ratio_damage(caster, effect, bf)

        # damage_dealt_total 和 damage_taken_total 都应增加 5000
        self.assertEqual(caster.damage_dealt_total, 5000)
        self.assertEqual(enemy.damage_taken_total, 5000)

    def test_damage_totals_excludes_shield_absorbed(self):
        """damage_totals 只计 HP 部分，不含盾吸收。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK,
                            character_type=1)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=50000)
        enemy.shield = 3000
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        effect = _make_effect(value=50)  # 5000 伤害

        ss._apply_hp_ratio_damage(caster, effect, bf)

        # 3000 盾吸收 + 2000 HP 损失
        # damage_totals 只记 HP 部分
        self.assertEqual(caster.damage_dealt_total, 2000)
        self.assertEqual(enemy.damage_taken_total, 2000)


# ═══════════════════════════════════════════════════════════════════════
# Part 16: received_mult（受击方增减伤乘区）
# ═══════════════════════════════════════════════════════════════════════

class TestHpRatioDamageReceivedMult(_BaseHpRatioDamageTest):
    """_apply_hp_ratio_damage: 受击方增减伤乘区（received_mult）。

    公式: final = min(raw * received_mult, cap)
    - raw = base_value * dmg_pct / 100
    - received_mult = 1.0 - (减伤buff - 易伤debuff)
    - cap = effective_atk * cap_atk_pct / 100
    """

    def test_dmg_taken_down_reduces_damage(self):
        """目标持有减伤buff时，hp_ratio_damage 被减伤缩减。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=50000)
        # 添加 40% 减伤 buff (ReceivedDamage, buffs列表)
        dmg_down = BuffState(
            buff_id="dmg_down1", name="DmgTakenDown",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=40.0, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
            source_unit_id="enemy",
            is_debuff=False,
        )
        enemy.buffs.append(dmg_down)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        # raw_power = 10000 * 50 / 100 = 5000
        # received_mult = 1 - 0.4 = 0.6
        # final = 5000 * 0.6 = 3000
        effect = _make_effect(value=50)

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        target_hit = result["targets"][0]
        self.assertEqual(target_hit["damage"], 3000)
        self.assertAlmostEqual(target_hit["calc_detail"]["received_mult"], 0.6, places=4)
        self.assertEqual(enemy.current_hp, 47000)  # 50000 - 3000

    def test_dmg_taken_up_increases_damage(self):
        """目标持有易伤debuff时，hp_ratio_damage 被易伤放大。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=50000)
        # 添加 30% 易伤 debuff (ReceivedDamage, debuffs列表)
        dmg_up = BuffState(
            buff_id="dmg_up1", name="DmgTakenUp",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=30.0, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
            source_unit_id="caster",
            is_debuff=True,
        )
        enemy.debuffs.append(dmg_up)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        # raw_power = 10000 * 50 / 100 = 5000
        # received_mult = 1 - (-0.3) = 1.3
        # final = 5000 * 1.3 = 6500
        effect = _make_effect(value=50)

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        target_hit = result["targets"][0]
        self.assertEqual(target_hit["damage"], 6500)
        self.assertAlmostEqual(target_hit["calc_detail"]["received_mult"], 1.3, places=4)
        self.assertEqual(enemy.current_hp, 43500)  # 50000 - 6500

    def test_down_and_up_cancel_out(self):
        """减伤buff + 易伤debuff 同时存在时净值计算。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=50000)
        # 40% 减伤 buff + 7.5% 易伤 debuff => net = 0.4 - 0.075 = 0.325
        # received_mult = 1 - 0.325 = 0.675
        dmg_down = BuffState(
            buff_id="dmg_down1", name="DmgTakenDown",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=40.0, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
            source_unit_id="enemy",
            is_debuff=False,
        )
        dmg_up = BuffState(
            buff_id="dmg_up1", name="DmgTakenUp",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=7.5, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
            source_unit_id="caster",
            is_debuff=True,
        )
        enemy.buffs.append(dmg_down)
        enemy.debuffs.append(dmg_up)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        # raw_power = 10000 * 50 / 100 = 5000
        # received_mult = 0.675
        # final = 5000 * 0.675 = 3375
        effect = _make_effect(value=50)

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        target_hit = result["targets"][0]
        self.assertEqual(target_hit["damage"], 3375)
        self.assertAlmostEqual(target_hit["calc_detail"]["received_mult"], 0.675, places=4)

    def test_cap_applied_after_received_mult(self):
        """公式B: final = min(raw * received_mult, cap)，先应用received_mult再cap。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK, atk=10000)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=100000, current_hp=50000)
        # 40% 减伤 => received_mult = 0.6
        dmg_down = BuffState(
            buff_id="dmg_down1", name="DmgTakenDown",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=40.0, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
            source_unit_id="enemy",
            is_debuff=False,
        )
        enemy.buffs.append(dmg_down)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        # target_lost_hp: base=50000, dmg_pct=100 => raw=50000
        # received_mult=0.6 => raw*mult=30000
        # cap = atk(10000) * 100% = 10000
        # final = min(30000, 10000) = 10000
        effect = _make_effect(
            value=100, value_source="target_lost_hp",
            flags={'damage_cap_atk_pct': 100}
        )

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        target_hit = result["targets"][0]
        self.assertEqual(target_hit["damage"], 10000)
        self.assertAlmostEqual(target_hit["calc_detail"]["received_mult"], 0.6, places=4)

    def test_received_mult_below_cap_uses_raw(self):
        """raw * received_mult < cap 时，final = raw * received_mult（cap不截断）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK, atk=10000)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=100000, current_hp=50000)
        # 40% 减伤 => received_mult = 0.6
        dmg_down = BuffState(
            buff_id="dmg_down1", name="DmgTakenDown",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=40.0, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
            source_unit_id="enemy",
            is_debuff=False,
        )
        enemy.buffs.append(dmg_down)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        # target_lost_hp: base=5000, dmg_pct=100 => raw=5000
        # received_mult=0.6 => raw*mult=3000
        # cap = atk(10000) * 100% = 10000
        # final = min(3000, 10000) = 3000
        # 需要已损HP=5000，即 current_hp=95000
        enemy.current_hp = 95000
        effect = _make_effect(
            value=100, value_source="target_lost_hp",
            flags={'damage_cap_atk_pct': 100}
        )

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        target_hit = result["targets"][0]
        self.assertEqual(target_hit["damage"], 3000)

    def test_target_current_hp_with_received_mult(self):
        """value_source='target_current_hp' 也应用 received_mult。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=40000)
        # 50% 减伤 => received_mult = 0.5
        dmg_down = BuffState(
            buff_id="dmg_down1", name="DmgTakenDown",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=50.0, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
            source_unit_id="enemy",
            is_debuff=False,
        )
        enemy.buffs.append(dmg_down)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        # raw = 40000 * 50 / 100 = 20000
        # received_mult = 0.5 => final = 10000
        effect = _make_effect(value=50, value_source="target_current_hp")

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        target_hit = result["targets"][0]
        self.assertEqual(target_hit["damage"], 10000)
        self.assertAlmostEqual(target_hit["calc_detail"]["received_mult"], 0.5, places=4)
        self.assertEqual(enemy.current_hp, 30000)  # 40000 - 10000

    def test_no_buffs_received_mult_is_one(self):
        """无增减伤buff时，received_mult=1.0，伤害不受影响。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=50000)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        # raw = 10000 * 50 / 100 = 5000, received_mult = 1.0, final = 5000
        effect = _make_effect(value=50)

        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        target_hit = result["targets"][0]
        self.assertEqual(target_hit["damage"], 5000)
        self.assertAlmostEqual(target_hit["calc_detail"]["received_mult"], 1.0, places=4)


if __name__ == '__main__':
    unittest.main()
