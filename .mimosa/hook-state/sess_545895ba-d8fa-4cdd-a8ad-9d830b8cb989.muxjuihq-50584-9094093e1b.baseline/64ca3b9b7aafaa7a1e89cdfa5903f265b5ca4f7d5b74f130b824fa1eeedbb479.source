# Part 11: 死亡 deferred
# ═══════════════════════════════════════════════════════════════════════

class TestHpRatioDamageDeath(_BaseHpRatioDamageTest):
    """_apply_hp_ratio_damage: 死亡 deferred。"""

    def test_death_added_to_pending_deaths(self):
        """current_hp <= 0 时加入 _pending_deaths。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=1000)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        effect = _make_effect(value=100)  # raw_power = 10000 > 1000

        ss._apply_hp_ratio_damage(caster, effect, bf)

        self.assertIn("e", ss._pending_deaths)
        self.assertEqual(enemy.current_hp, 0)

    def test_no_death_when_survives(self):
        """存活时不加入 _pending_deaths。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        enemy = _make_unit("e", "E", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=50000, current_hp=50000)
        bf = _make_bf(caster, enemy)
        ss, *_ = self._make_services(bf)
        ss._hp_consumed = 10000
        effect = _make_effect(value=50)  # raw_power = 5000

        ss._apply_hp_ratio_damage(caster, effect, bf)

        self.assertNotIn("e", ss._pending_deaths)
        self.assertEqual(enemy.current_hp, 45000)


