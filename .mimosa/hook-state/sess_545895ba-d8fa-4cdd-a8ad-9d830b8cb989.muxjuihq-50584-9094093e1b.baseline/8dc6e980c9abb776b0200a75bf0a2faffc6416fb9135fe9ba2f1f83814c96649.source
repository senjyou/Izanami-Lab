            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    # ─── EX: フェアボルゲネ・ゲフューレ ───

    def test_ex_damage_and_remove_pp(self):
        """EX(110009) 横列伤害+PP削减"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110009, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 横列敌人都应受伤
        self.assertLess(self.enemy_left_front.current_hp, self.enemy_left_front.max_hp,
                        "EX应对敌方左前造成伤害")
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "EX应对敌方中前造成伤害")
        self.assertLess(self.enemy_right_front.current_hp, self.enemy_right_front.max_hp,
                        "EX应对敌方右前造成伤害")

        # 横列敌人PP应被削减为0
        self.assertEqual(self.enemy_left_front.current_pp, 0,
                         "EX应削减敌方左前PP为0")
        self.assertEqual(self.enemy_front.current_pp, 0,
                         "EX应削减敌方中前PP为0")
        self.assertEqual(self.enemy_right_front.current_pp, 0,
                         "EX应削减敌方右前PP为0")

        # 后排不应受影响
        self.assertEqual(self.enemy_back.current_hp, self.enemy_back.max_hp,
                         "EX不应影响后排敌人")
        self.assertEqual(self.enemy_back.current_pp, 5,
                         "EX不应削减后排PP")

    def test_ex_lv11_stun(self):
        """EX(110009) Lv11+横列敌人被赋予1行动气绝"""
        self.caster.skill_levels[110009] = 11

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110009, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 横列敌人都应被赋予气绝debuff
        for enemy in [self.enemy_left_front, self.enemy_front, self.enemy_right_front]:
            stun_debuffs = [d for d in enemy.debuffs if d.effect_type == KNOCKOUT]
            self.assertTrue(len(stun_debuffs) > 0,
                            f"EX Lv11+应赋予{enemy.name}气绝debuff")
            self.assertEqual(stun_debuffs[0].duration, 1,
                             "气绝应为1行动")

    # ─── AS1: クアッドエッジ ───

    def test_as1_quad_edge(self):
        """AS1(120018) 4次伤害"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 应对目标造成伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "AS1应对目标造成伤害")

        # 验证4次hit：通过damage结果中的hits字段验证
        damage_results = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(len(damage_results) > 0, "AS1应有伤害效果")

        # 检查targets中的hits列表长度
        total_hits = 0
        for dr in damage_results:
            for t in dr.get("targets", []):
                total_hits += len(t.get("hits", []))
        self.assertGreaterEqual(total_hits, 4, "AS1应有4次hit")

    def test_as1_lv11_lifesteal(self):
        """AS1(120018) Lv11+吸血40%"""
        self.caster.skill_levels[120018] = 11
        self.caster.current_hp = 15000  # HP不满

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 施法者应回复HP（吸血）
        self.assertGreater(self.caster.current_hp, 15000,
                           "AS1 Lv11+应通过吸血回复HP")

    # ─── AS2: アーマークラッシュ ───

    def test_as2_def_down_physical_type(self):
        """AS2(120036) 物理类型目标被赋予永续def_down"""
        # 敌方前排是character_type=1（物理类型）
        self.enemy_front.character_type = 1

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120036, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 应对目标造成伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "AS2应对目标造成伤害")

        # 物理类型目标应被赋予永续def_down
        def_down_debuffs = [d for d in self.enemy_front.debuffs
                            if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertTrue(len(def_down_debuffs) > 0,
                        "AS2应对物理类型目标赋予def_down")
        self.assertEqual(def_down_debuffs[0].duration, -1,
                         "def_down应为永续(duration=-1)")

    def test_as2_no_def_down_non_physical(self):
        """AS2(120036) EN类型目标不被赋予def_down"""
        # 敌方前排是character_type=2（EN类型）
        self.enemy_front.character_type = 2

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120036, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 应对目标造成伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "AS2应对目标造成伤害")

        # EN类型目标不应被赋予def_down
        def_down_debuffs = [d for d in self.enemy_front.debuffs
                            if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertEqual(len(def_down_debuffs), 0,
                         "AS2不应赋予EN类型目标def_down")

    def test_as2_lv11_atk_down_physical(self):
        """AS2(120036) Lv11+物理类型目标同时被赋予永续def_down和atk_down"""
        self.caster.skill_levels[120036] = 11
        self.enemy_front.character_type = 1

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120036, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 应被赋予def_down
        def_down_debuffs = [d for d in self.enemy_front.debuffs
                            if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertTrue(len(def_down_debuffs) > 0,
                        "AS2 Lv11+应赋予物理类型目标def_down")
        self.assertEqual(def_down_debuffs[0].duration, -1,
                         "def_down应为永续")

        # 应被赋予atk_down
        atk_down_debuffs = [d for d in self.enemy_front.debuffs
                            if d.effect_type == STATUS_ATTACK and d.is_debuff]
        self.assertTrue(len(atk_down_debuffs) > 0,
                        "AS2 Lv11+应赋予物理类型目标atk_down")
        self.assertEqual(atk_down_debuffs[0].duration, -1,
                         "atk_down应为永续")

    # ─── PS1: アーマー・ジャム ───

    def test_ps1_def_down_on_as_target(self):
        """PS1(130027) AS攻击后对目标赋予def_down"""
        # 先执行AS1攻击，记录_primary_target
        as_result = self.ss.execute_skill(
            caster=self.caster, skill_id=120018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(as_result["success"])

        # 设置_primary_target为AS攻击目标，使PS1的debuff_applied_target能正确解析
        primary_target = getattr(self.ss, '_last_primary_target', None)
        self.ss._primary_target = primary_target

        # 直接执行PS1技能
        ps_result = self.ss.execute_skill(
            caster=self.caster, skill_id=130027, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(ps_result["success"])

        # 被AS攻击的敌方应被赋予def_down
        def_down_debuffs = [d for d in self.enemy_front.debuffs
                            if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertTrue(len(def_down_debuffs) > 0,
                        "PS1应赋予AS攻击目标def_down")

        # def_down应为1行动制
        self.assertEqual(def_down_debuffs[0].duration, 1,
                         "PS1的def_down应为1行动")

        # def_down目标应是AS攻击目标（debuff在敌方身上，不是在自身身上）
        self.assertEqual(def_down_debuffs[0].source_unit_id, self.caster.unit_id,
                         "PS1的def_down来源应是施法者")

    def test_ps1_stackable(self):
        """PS1(130027) def_down可叠加"""
        # 第一次AS攻击+PS1
        self.ss.execute_skill(
            caster=self.caster, skill_id=120018, battlefield=self.bf, skip_cost=True
        )
        primary_target1 = getattr(self.ss, '_last_primary_target', None)
        self.ss._primary_target = primary_target1
        self.ss.execute_skill(
            caster=self.caster, skill_id=130027, battlefield=self.bf, skip_cost=True
        )

        # 重置AS1和PS1冷却
        self.caster.skill_cooldowns.pop(120018, None)
        self.caster.skill_cooldowns.pop(130027, None)

        # 第二次AS攻击+PS1
        self.ss.execute_skill(
            caster=self.caster, skill_id=120018, battlefield=self.bf, skip_cost=True
        )
        primary_target2 = getattr(self.ss, '_last_primary_target', None)
        self.ss._primary_target = primary_target2
        self.caster.skill_cooldowns.pop(130027, None)
        self.ss.execute_skill(
            caster=self.caster, skill_id=130027, battlefield=self.bf, skip_cost=True
        )

        # def_down应可叠加（2层）
        def_down_debuffs = [d for d in self.enemy_front.debuffs
                            if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertGreaterEqual(len(def_down_debuffs), 2,
                                "PS1的def_down应可叠加（2层）")

    # ─── PS2: クイックブースト ───

    def test_ps2_spd_up_and_ep(self):
        """PS2(130043) Lv11+友方spd_up+最近友方+1EP"""
        self.caster.skill_levels[130043] = 11

        # 直接执行PS2技能
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130043, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 友方应获得spd_up buff
        # 注：技能描述为"自身を除く味方全体"，当前代码ally_all映射为SELF_AND_FRIENDS（含自身）
        # 如代码修正为排除自身，此断言需相应调整
        for ally in [self.ally_back, self.ally_left_back]:
            spd_up_buffs = [b for b in ally.buffs if b.effect_type == STATUS_SPEED]
            self.assertTrue(len(spd_up_buffs) > 0,
                            f"PS2应赋予{ally.name}spd_up")
            self.assertEqual(spd_up_buffs[0].duration, 1,
                             "spd_up应为1行动")

        # 距离自身最近的友方应获得1 EP
        # 施法者在ALLY_CENTER_FRONT，最近的是ALLY_CENTER_BACK（距离1）
        self.assertGreater(self.ally_back.current_ep, 0,
                           "PS2 Lv11+应赋予最近友方1 EP")

    # ─── 补充测试：未覆盖的关键机制 ───

    def test_ps2_friends_excludes_self(self):
        """PS2(130043) target_type="friends" 不含caster自身"""
        self.caster.skill_levels[130043] = 11
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130043, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # caster 自身不应有 spd_up buff（target_type="friends"排除自身）
        caster_spd_up = [b for b in self.caster.buffs if b.effect_type == STATUS_SPEED]
        self.assertEqual(len(caster_spd_up), 0,
                         "PS2 target_type=friends 不应赋予caster自身spd_up")

    def test_ps2_lv10_no_ep_bonus(self):
        """PS2(130043) Lv10: 仅spd_up，无EP加成"""
        self.caster.skill_levels[130043] = 10
        # 记录所有友方初始EP
        ep_before = {a.unit_id: a.current_ep for a in self.bf.friend_team}

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130043, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证所有友方EP未增加（仅 Lv11+ 才有 EP 加成）
        for ally in self.bf.friend_team:
            if ally.unit_id == self.caster.unit_id:
                continue
            self.assertEqual(ally.current_ep, ep_before[ally.unit_id],
                             f"Lv10时友方{ally.name}不应获得EP加成")

    def test_as2_stackable_false_no_stacking(self):
        """AS2(120036) def_down stackable=false 不可叠加"""
        self.enemy_front.character_type = 1  # 物理类型
        # 第一次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=120036, battlefield=self.bf, skip_cost=True
        )
        debuffs_1 = [d for d in self.enemy_front.debuffs
                     if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        # 重置冷却
        self.caster.skill_cooldowns.pop(120036, None)
        # 第二次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=120036, battlefield=self.bf, skip_cost=True
        )
        debuffs_2 = [d for d in self.enemy_front.debuffs
                     if d.effect_type == STATUS_DEFENSE and d.is_debuff]

        # stackable=false 不可叠加：仍应只有1层（refresh原buff而非新增）
        self.assertEqual(len(debuffs_2), 1,
                         f"stackable=false时 def_down 应不可叠加, 第一次={len(debuffs_1)}, 第二次={len(debuffs_2)}")

    def test_as2_agile_type_no_def_down(self):
        """AS2(120036) 敏捷类型(character_type=3)目标不被赋予def_down"""
        self.enemy_front.character_type = 3  # 敏捷类型
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120036, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 敏捷类型目标不应被赋予 def_down（仅物理类型=1 才被赋予）
        def_down_debuffs = [d for d in self.enemy_front.debuffs
                            if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertEqual(len(def_down_debuffs), 0,
                         "AS2 不应赋予敏捷类型目标 def_down")

    def test_as1_hit_count_exactly_4(self):
        """AS1(120018) hit_count=4 精确验证（恰好4hit，非>=4）"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        damage_results = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(len(damage_results) > 0, "应有damage效果")

        # 验证恰好4次hit（而非 >=4）
        total_hits = 0
        for dr in damage_results:
            for t in dr.get("targets", []):
                total_hits += len(t.get("hits", []))
        self.assertEqual(total_hits, 4,
                         f"AS1应恰好为4hit, 实际={total_hits}")

    def test_as2_def_down_value_affects_effective_def(self):
        """AS2(120036) def_down value生效：实际降低effective_def"""
        self.enemy_front.character_type = 1  # 物理类型
        # Lv10时 def_down value=20% (来自 tag_values)
        self.caster.skill_levels[120036] = 10

        # 记录初始防御
        base_def = self.enemy_front.defense

        self.ss.execute_skill(
            caster=self.caster, skill_id=120036, battlefield=self.bf, skip_cost=True
        )

        # 验证 def_down 被赋予
        def_downs = [d for d in self.enemy_front.debuffs
                     if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertGreater(len(def_downs), 0, "应被赋予 def_down")

        # 验证 effective_def 降低（20% reduction）
        effective_def = self.dms._calculate_final_stat(
            self.enemy_front, "defense"
        )
        self.assertLess(effective_def, base_def,
                        f"def_down 生效后 effective_def 应降低: base={base_def}, effective={effective_def}")

    def test_ps1_not_triggered_by_ex_or_ps(self):
        """PS1(130027) trigger_type=after_as_attack: 仅AS触发，EX/PS不触发

        使用trigger_service真实触发链验证。
        """
        from src.combat_v2.services.trigger_service import TriggerContext

        # 先记录 enemy_front 当前 def_down 数量
        initial_def_downs = [d for d in self.enemy_front.debuffs
                             if d.effect_type == STATUS_DEFENSE and d.is_debuff]

        # 执行 EX 技能（skill_type=3，非AS）
        self.ss.execute_skill(
            caster=self.caster, skill_id=110009, battlefield=self.bf, skip_cost=True
        )

        # 验证 PS1 没有被触发（debuff数量未增加）
        after_ex_def_downs = [d for d in self.enemy_front.debuffs
                              if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertEqual(len(after_ex_def_downs), len(initial_def_downs),
                         "PS1 after_as_attack 不应被EX技能触发")


if __name__ == '__main__':
    unittest.main()
