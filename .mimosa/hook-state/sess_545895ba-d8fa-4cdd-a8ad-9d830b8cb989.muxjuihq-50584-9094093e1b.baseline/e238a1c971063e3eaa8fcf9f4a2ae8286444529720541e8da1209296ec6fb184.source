#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""全面测试敌方232315所有技能及buff乘区逻辑"""
import sys
import os
import json

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, TriggerTiming
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig
from src.combat_v2.battle_narrative import BattleNarrativeWriter
from src.combat_v2.services.trigger_service import TriggerService, TriggerContext
from src.combat_v2.services.aura_service import AuraService
from src.entities_v2.enums import SkillEffectType

# Setup
dl = DataLoader()
dl.load_all()

# Load enemy data
with open("data/tactical_exercise_enemies.json", "r", encoding="utf-8") as f:
    enemy_data = json.load(f)["232315"]

print("=" * 60)
print("敌方 232315 フィー・ドレーゼ 全面Debug")
print("=" * 60)

# --- Part 1: Skill data analysis ---
print("\n[1] 技能数据分析")
print("-" * 40)
skill_ids = enemy_data["skill_ids"]
for sid in skill_ids:
    sk = dl.get_skill_by_id(sid)
    parsed = dl.get_parsed_skill_data(sid)
    print(f"  {sid} {sk.name} (type={sk.skill_type})")
    if parsed:
        for block in parsed.get("effect_blocks", []):
            bmin = block.get("level_min", 1)
            bmax = block.get("level_max", "∞")
            effects = [e["effect_type"] for e in block.get("effects", [])]
            stackable_effects = [e["effect_type"] for e in block.get("effects", [])
                                if e.get("flags", {}).get("stackable")]
            print(f"    Block {block['block_id']} (Lv{bmin}-{bmax}): {effects}")
            if stackable_effects:
                print(f"      stackable: {stackable_effects}")
    else:
        print(f"    NO parsed data")

# --- Part 2: Create enemy with skill level 15 ---
print("\n[2] 创建敌方单位 (skill_level=15)")
print("-" * 40)
enemy = UnitState(
    unit_id="E_232315",
    name=enemy_data["character_name"],
    side=Side.ENEMY,
    position=Position.ENEMY_CENTER_BACK,
    character_id=enemy_data["enemy_id"],
    level=1,
    element=enemy_data["attribute"],
    character_type=enemy_data["type"],
    max_hp=enemy_data["hp"],
    current_hp=enemy_data["hp"],
    attack=enemy_data["attack"],
    defense=enemy_data["defense"],
    speed=enemy_data["speed"],
    crit_rate=enemy_data["critical_rate"],
    crit_damage=0.0,
    advantage_damage=0.0,
    initial_active_point=enemy_data.get("action_point", 2),
    initial_passive_point=enemy_data.get("passive_point", 2),
    max_extra_point=0,
    current_ap=enemy_data.get("action_point", 2),
    current_pp=enemy_data.get("passive_point", 2),
    current_ep=0,
    skills=skill_ids,
    skill_levels={sid: 15 for sid in skill_ids},
    skill_cooldowns={},
)
print(f"  Name: {enemy.name}")
print(f"  ATK: {enemy.attack}, DEF: {enemy.defense}, SPD: {enemy.speed}")
print(f"  Skill levels: {enemy.skill_levels}")

# --- Part 3: Create friend front-row units ---
print("\n[3] 创建友方前排单位")
print("-" * 40)
bf = BattlefieldState()
bf.add_unit(enemy)

for i, pos in enumerate([Position.ALLY_LEFT_FRONT, Position.ALLY_CENTER_FRONT, Position.ALLY_RIGHT_FRONT]):
    friend = UnitState(
        unit_id=f"F_FRONT_{i}",
        name=f"友方前排{i+1}",
        side=Side.ALLY,
        position=pos,
        character_id=100000 + i,
        level=100,
        element=1,
        character_type=1,
        max_hp=50000,
        current_hp=50000,
        attack=5000,
        defense=3000,
        speed=800,
        crit_rate=0.1,
        crit_damage=0.0,
        advantage_damage=0.0,
        initial_active_point=4,
        initial_passive_point=4,
        max_extra_point=0,
        current_ap=4,
        current_pp=4,
        current_ep=0,
        skills=[],
        skill_levels={},
        skill_cooldowns={},
    )
    bf.add_unit(friend)
    print(f"  {friend.name} added at {pos}")

# Also add back-row friends for ally_back targeting
for i, pos in enumerate([Position.ALLY_LEFT_BACK, Position.ALLY_RIGHT_BACK]):
    friend = UnitState(
        unit_id=f"F_BACK_{i}",
        name=f"友方后排{i+1}",
        side=Side.ALLY,
        position=pos,
        character_id=200000 + i,
        level=100,
        element=1,
        character_type=1,
        max_hp=50000,
        current_hp=50000,
        attack=5000,
        defense=3000,
        speed=800,
        crit_rate=0.1,
        crit_damage=0.0,
        advantage_damage=0.0,
        initial_active_point=4,
        initial_passive_point=4,
        max_extra_point=0,
        current_ap=4,
        current_pp=4,
        current_ep=0,
        skills=[],
        skill_levels={},
        skill_cooldowns={},
    )
    bf.add_unit(friend)
    print(f"  {friend.name} added at {pos}")

# --- Part 4: Test TURN_START triggers ---
print("\n[4] 测试TURN_START触发器")
print("-" * 40)
ts = TriggerService()
ts.set_data_loader(dl)
ctx = TriggerContext(TriggerTiming.TURN_START, bf)
actions = ts.check_triggers(TriggerTiming.TURN_START, ctx)
print(f"  Actions found: {len(actions)}")
for a in actions:
    owner = a.instance.owner
    print(f"    Skill ID: {a.skill_id}, Owner: {owner.name}")

# --- Part 5: Run full battle ---
print("\n[5] 完整战斗模拟 (1回合)")
print("-" * 40)
config = BattleConfig()
config.max_turns = 1
narrative = BattleNarrativeWriter()
controller = BattleFlowController(bf, data_loader=dl, config=config, narrative=narrative)
result = controller.execute_battle()

# Write log
log_dir = "data/battle_logs"
os.makedirs(log_dir, exist_ok=True)
log_path = os.path.join(log_dir, "test_enemy_full_debug.txt")
narrative.write(log_path)
print(f"  Battle result: {result}")
print(f"  Log: {log_path}")

# --- Part 6: Verify effects ---
print("\n[6] 效果验证")
print("-" * 40)

# Check enemy buffs
print(f"  Enemy buffs ({len(enemy.buffs)}):")
for b in enemy.buffs:
    print(f"    {b.effect_type}: value={b.value}, dur={b.duration}, id={b.buff_id}")

# Check friend debuffs - specifically atk_down on front row
print(f"\n  Friend front-row debuffs (should have StatusAttack atk_down):")
for u in bf.friend_team:
    if "FRONT" in u.position.name:
        if u.debuffs:
            print(f"    {u.name} (FRONT):")
            for d in u.debuffs:
                print(f"      {d.effect_type}: value={d.value}, dur={d.duration}, id={d.buff_id}")
        else:
            print(f"    {u.name} (FRONT): NO debuffs! ⚠")

# Check friend back-row buffs (should have StatusAttack atk_up)
print(f"\n  Friend back-row buffs (should have StatusAttack atk_up):")
for u in bf.friend_team:
    if "BACK" in u.position.name:
        if u.buffs:
            print(f"    {u.name} (BACK):")
            for b in u.buffs:
                print(f"      {b.effect_type}: value={b.value}, dur={b.duration}, id={b.buff_id}")
        else:
            print(f"    {u.name} (BACK): NO buffs! ⚠")

# Check friend back-row debuffs (should NOT have atk_down)
print(f"\n  Friend back-row debuffs (should NOT have StatusAttack atk_down):")
for u in bf.friend_team:
    if "BACK" in u.position.name:
        if u.debuffs:
            has_atk_down = any(d.effect_type == "StatusAttack" for d in u.debuffs)
            print(f"    {u.name} (BACK): has debuffs={len(u.debuffs)}, atk_down={has_atk_down} {'⚠WRONG' if has_atk_down else '✓OK'}")
        else:
            print(f"    {u.name} (BACK): no debuffs ✓")

# Friend front-row buffs (should NOT have atk_up from ステージブースト)
print(f"\n  Friend front-row buffs (should NOT have StatusAttack atk_up from ステージブースト):")
for u in bf.friend_team:
    if "FRONT" in u.position.name:
        if u.buffs:
            has_atk_up = any(b.effect_type == "StatusAttack" and b.source_skill_id == 230374 for b in u.buffs)
            print(f"    {u.name} (FRONT): has buffs={len(u.buffs)}, atk_up_from_230374={has_atk_up} {'⚠WRONG' if has_atk_up else '✓OK'}")
        else:
            print(f"    {u.name} (FRONT): no buffs ✓")

# Verify ステージブースト effects via narrative log
with open(log_path, "r", encoding="utf-8") as f:
    log = f.read()

# Check narrative log for correct target selection
front_row_targeted = "友方前排1" in log and "友方前排2" in log and "友方前排3" in log
back_row_not_targeted_for_atk_down = True  # verified below by unit state

checks = {
    "ステージブースト触发": "ステージブースト" in log,
    "atk_up (ally_back->敌方自身)": any(
        b.source_skill_id == 230374 and b.effect_type == "StatusAttack"
        for b in enemy.buffs
    ),
    "atk_down (enemy_front->友方前排)": all(
        any(d.effect_type == "StatusAttack" and d.source_skill_id == 230374 for d in u.debuffs)
        for u in bf.friend_team if "FRONT" in u.position.name
    ),
    "后排友方无atk_down": all(
        not any(d.effect_type == "StatusAttack" and d.source_skill_id == 230374 for d in u.debuffs)
        for u in bf.friend_team if "BACK" in u.position.name
    ),
}

for check, passed in checks.items():
    status = "✓" if passed else "✗"
    print(f"  [{status}] {check}")

# --- Part 7: Buff stacking test ---
print("\n[7] Buff叠加逻辑测试")
print("-" * 40)
asvc = AuraService()

# Test: non-stackable buff replacement with max value
test_unit = UnitState(
    unit_id="test_stacking",
    name="测试单位",
    side=Side.ALLY,
    position=Position.ALLY_LEFT_FRONT,
    character_id=999999,
    level=1,
    element=1,
    character_type=1,
    max_hp=10000,
    current_hp=10000,
    attack=1000,
    defense=500,
    speed=500,
    crit_rate=0.1,
    crit_damage=0.0,
    advantage_damage=0.0,
    initial_active_point=4,
    initial_passive_point=4,
    max_extra_point=0,
    current_ap=4,
    current_pp=4,
    current_ep=0,
    skills=[],
    skill_levels={},
    skill_cooldowns={},
)

from src.entities_v2.unit_state import BuffState

# Test 1: Non-stackable - weaker buff should NOT replace stronger
buff1 = BuffState(
    buff_id="caster1_DealtDamage_test_stacking",
    name="test1",
    effect_type="DealtDamage",
    value=20.0,
    duration=5,
    timing_type=1,
    source_unit_id="caster1",
    source_skill_id=1,
    is_debuff=False,
)
buff2 = BuffState(
    buff_id="caster1_DealtDamage_test_stacking",
    name="test2",
    effect_type="DealtDamage",
    value=10.0,
    duration=5,
    timing_type=1,
    source_unit_id="caster1",
    source_skill_id=1,
    is_debuff=False,
)

asvc.add_aura(test_unit, buff1)
print(f"  After buff1 (20%): {test_unit.buffs[0].value}%")

asvc.add_aura(test_unit, buff2)
print(f"  After buff2 (10%): {test_unit.buffs[0].value}% (should keep 20%)")

# Test 2: Stronger buff should replace weaker
test_unit.buffs.clear()
asvc.add_aura(test_unit, buff2)
print(f"  After buff2 (10%): {test_unit.buffs[0].value}%")

asvc.add_aura(test_unit, buff1)
print(f"  After buff1 (20%): {test_unit.buffs[0].value}% (should update to 20%)")

# Test 3: Stackable buffs should coexist
test_unit.buffs.clear()
stackable1 = BuffState(
    buff_id="caster1_DealtDamage_test_stacking_uuid1",
    name="stack1",
    effect_type="DealtDamage",
    value=10.0,
    duration=5,
    timing_type=1,
    source_unit_id="caster1",
    source_skill_id=1,
    is_debuff=False,
    is_stackable=True,
)
stackable2 = BuffState(
    buff_id="caster1_DealtDamage_test_stacking_uuid2",
    name="stack2",
    effect_type="DealtDamage",
    value=15.0,
    duration=5,
    timing_type=1,
    source_unit_id="caster1",
    source_skill_id=2,
    is_debuff=False,
    is_stackable=True,
)
asvc.add_aura(test_unit, stackable1)
asvc.add_aura(test_unit, stackable2)
total = asvc.get_aura_value(test_unit, "DealtDamage")
print(f"  Stackable buffs: {len(test_unit.buffs)} buffs, total={total}% (expect 2 buffs, 25% total)")

# Test 4: Memory card buffs coexist with skill buffs
test_unit.buffs.clear()
memory_buff = BuffState(
    buff_id="memory_400104_test_stacking",
    name="memory",
    effect_type="DealtDamage",
    value=15.0,
    duration=99,
    timing_type=1,
    source_unit_id="test_stacking",
    source_skill_id=400104,
    is_debuff=False,
    is_memory_buff=True,
)
skill_buff = BuffState(
    buff_id="caster1_DealtDamage_test_stacking",
    name="skill",
    effect_type="DealtDamage",
    value=20.0,
    duration=5,
    timing_type=1,
    source_unit_id="caster1",
    source_skill_id=1,
    is_debuff=False,
)
asvc.add_aura(test_unit, memory_buff)
asvc.add_aura(test_unit, skill_buff)
total = asvc.get_aura_value(test_unit, "DealtDamage")
print(f"  Memory + Skill buffs: {len(test_unit.buffs)} buffs, total={total}% (expect 2 buffs, 35% total)")

print("\n" + "=" * 60)
print("Debug完成!")
print("=" * 60)