        self.assertGreater(len(ps3_actions), 0, "PS3应在自身被赋予debuff时触发")

    def test_ps3_does_not_trigger_on_enemy_debuff(self):
        """PS3(130039) 敌方被赋予debuff时不触发"""
        actions = self.ts.trigger_pawn_received_aura(
            battlefield=self.bf,
            actor=self.caster,
            affected_unit_ids=[self.enemy_front.unit_id],
        )

        ps3_actions = [a for a in actions if a.skill_id == 130039]
        self.assertEqual(len(ps3_actions), 0, "PS3不应在敌方被赋予debuff时触发")

    def test_ps3_self_crit_rate_up(self):
        """PS3(130039) 提升自身会心率(2行动)"""
