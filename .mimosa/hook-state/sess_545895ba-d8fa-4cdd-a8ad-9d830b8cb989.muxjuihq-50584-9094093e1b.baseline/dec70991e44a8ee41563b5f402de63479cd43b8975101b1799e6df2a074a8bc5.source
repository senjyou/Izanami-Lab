        self.assertEqual(crit_buffs[0].duration, 2, "PS3会心率提升应持续2行动")

    def test_ps3_lv11_debuff_attacker_dmg_taken_up(self):
        """PS3(130039) Lv11+对debuff施加者赋予易伤"""
        self.caster.skill_levels[130039] = 11

        actions = self.ts.trigger_pawn_received_aura(
            battlefield=self.bf,
            actor=self.enemy_front,
            affected_unit_ids=[self.caster.unit_id],
        )

        ps3_actions = [a for a in actions if a.skill_id == 130039]
        self.assertGreater(len(ps3_actions), 0, "PS3应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_debuff_applied"
        )

        # 验证敌方前排（debuff施加者）获得dmg_taken_up debuff
        dmg_up_buffs = [b for b in self.enemy_front.debuffs if b.effect_type == DMG_TAKEN_UP]
        self.assertGreater(len(dmg_up_buffs), 0,
                           "Lv11+应对debuff施加者赋予易伤")


