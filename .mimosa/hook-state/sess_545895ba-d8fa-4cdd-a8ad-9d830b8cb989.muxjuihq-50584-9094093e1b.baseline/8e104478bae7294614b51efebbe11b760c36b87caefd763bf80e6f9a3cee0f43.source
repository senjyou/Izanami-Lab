"""回归测试：120110 ハードラッシュ

技能描述（Lv1-10）：
  敵単体に威力{威力}で2ヒット攻撃する

技能描述（Lv11+）：
  敵単体に威力{威力}で2ヒット攻撃する。対象が状態異常だった場合、1行動の間対象の与ダメージを{dmg}%減少させるデバフを付与する（重複可）

历史 bug：
  原 manual 配置将 damage 和 dmg_dealt_down 放在同一 Block1 中，
  dmg_dealt_down 仅靠 value_tag="dmg" 在 Lv1-10 时解析为 0% 隐式控制，
  但 _apply_aura 仍会创建 0% debuff 浪费 buff 槽位且日志冗余。

修复：
  在 dmg_dealt_down 的 flags 中添加 "level_min": 11（effect级 level_min），
  使 skill_service.py L2528-2534 在 Lv1-10 时直接跳过 effect，不创建 debuff。

验证点：
1. 配置校验：dmg_dealt_down 含 level_min=11
2. Lv10 时 target 有状态异常也不施加 dmg_dealt_down
3. Lv15 时 target 有状态异常时施加 dmg_dealt_down
4. Lv15 时 target 无状态异常时不施加 dmg_dealt_down
"""
import sys
import os
import unittest

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.enums import SkillEffectType
from tests.helpers.battle_builder import BattleBuilder

# effect_type 字符串映射到 SkillEffectType 枚举值
_DMG_DEALT_DOWN = SkillEffectType.DEALT_DAMAGE.value  # "DealtDamage"


class TestRegHardRush(unittest.TestCase):
    """120110 ハードラッシュ 回归测试。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()
        parsed = cls.dl.get_parsed_skill_data(120110)
        assert parsed is not None, "120110 parsed data should exist"
        assert parsed['parse_status'] == 'manual', f"120110 should be manual"
        effects = parsed['effect_blocks'][0]['effects']
        cls._eff_by_type = {e['effect_type']: e for e in effects}
        assert 'damage' in cls._eff_by_type, "missing damage effect"
        assert 'dmg_dealt_down' in cls._eff_by_type, "missing dmg_dealt_down effect"
        # dmg_dealt_down 应有 level_min=11
        assert cls._eff_by_type['dmg_dealt_down']['flags'].get('level_min') == 11, \
            "dmg_dealt_down should have level_min=11"
        # damage 不应有 level_min
        assert 'level_min' not in (cls._eff_by_type['damage'].get('flags') or {}), \
            "damage should NOT have level_min (Lv1+ applies)"

    def _build_battle(self, skill_level=10, with_status_ailment=False):
        """构建战场：己方100302(持120110) + 敌方1单位。

        Args:
            skill_level: 120110 技能等级
            with_status_ailment: 是否给敌方添加状态异常（knockout）
        """
        bb = BattleBuilder()
        # 100302 持有 120110
        bb.add_ally(unit_id="c", character_id=100302, hp=50000, atk=10000, level=skill_level)
        bb.add_enemy(unit_id="e", hp=50000, atk=5000)
        ctx = bb.build()
        bf = ctx['bf']
        caster = bf.friend_team[0]
        caster.buffs = []
        caster.skill_levels = {120110: skill_level}
        caster.current_pp = 10
        enemy = bf.enemy_team[0]
        enemy.buffs = []
        enemy.debuffs = []
        if with_status_ailment:
            # 添加 knockout 状态异常（持续1行动）作为 target_has_status_ailment 条件
            # 注意：状态异常属于 debuffs，不属于 buffs
            from src.entities_v2.unit_state import BuffState
            from src.entities_v2.enums import SkillEffectType, AuraUpdateTiming
            stun = BuffState(
                buff_id="test_stun",
                name="Stun",
                effect_type=SkillEffectType.KNOCKOUT.value,
                value=0,
                duration=1,
                timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
                source_unit_id="",
                source_skill_id=0,
                is_debuff=True,
            )
            enemy.debuffs.append(stun)
        return ctx

    def _execute_as(self, ctx):
        """直接 execute_skill 执行 120110 AS。"""
        bf = ctx['bf']
        ss = ctx['ss']
        caster = bf.friend_team[0]
        result = ss.execute_skill(
            caster=caster,
            skill_id=120110,
            battlefield=bf,
            skip_cost=True,
        )
        return result, caster

    def test_parses_correctly(self):
        """配置校验：120110 解析为 manual，dmg_dealt_down 含 level_min=11。"""
        parsed = self.dl.get_parsed_skill_data(120110)
        effects = parsed['effect_blocks'][0]['effects']
        eff_by_type = {e['effect_type']: e for e in effects}
        # damage: Lv1+ 无 level_min
        self.assertNotIn('level_min', eff_by_type['damage'].get('flags') or {})
        # dmg_dealt_down: Lv11+
        self.assertEqual(eff_by_type['dmg_dealt_down']['flags'].get('level_min'), 11)
        # dmg_dealt_down 条件
        self.assertEqual(eff_by_type['dmg_dealt_down']['condition']['type'], 'target_has_status_ailment')

    def test_lv10_no_debuff_even_with_status_ailment(self):
        """Lv10 时 target 有状态异常也不施加 dmg_dealt_down。"""
        ctx = self._build_battle(skill_level=10, with_status_ailment=True)
        result, caster = self._execute_as(ctx)
        self.assertTrue(result.get('success', False),
                        f"AS should execute successfully, got: {result}")
        enemy = ctx['bf'].enemy_team[0]
        # dmg_dealt_down 是 debuff，存储在 debuffs 中（buffs 中没有，因为 is_debuff=True）
        # 检查 buffs + debuffs 全集
        all_buff_types = [b.effect_type for b in enemy.buffs] + [b.effect_type for b in enemy.debuffs]
        # 排除预设的 stun（Knockout）
        non_stun_types = [t for t in all_buff_types if t != SkillEffectType.KNOCKOUT.value]
        # 不应有 dmg_dealt_down（DealtDamage）
        self.assertNotIn(_DMG_DEALT_DOWN, non_stun_types,
                         f"Lv10 should NOT have dmg_dealt_down, got: {non_stun_types}")

    def test_lv15_debuff_when_target_has_status_ailment(self):
        """Lv15 时 target 有状态异常时施加 dmg_dealt_down。"""
        ctx = self._build_battle(skill_level=15, with_status_ailment=True)
        result, caster = self._execute_as(ctx)
        self.assertTrue(result.get('success', False),
                        f"AS should execute successfully, got: {result}")
        enemy = ctx['bf'].enemy_team[0]
        # dmg_dealt_down 是 debuff，存储在 debuffs 中
        all_buff_types = [b.effect_type for b in enemy.buffs] + [b.effect_type for b in enemy.debuffs]
        # 应有 dmg_dealt_down（DealtDamage）
        self.assertIn(_DMG_DEALT_DOWN, all_buff_types,
                      f"Lv15 with status_ailment should have dmg_dealt_down, got: {all_buff_types}")

    def test_lv15_no_debuff_when_target_no_status_ailment(self):
        """Lv15 时 target 无状态异常时不施加 dmg_dealt_down（条件不满足）。"""
        ctx = self._build_battle(skill_level=15, with_status_ailment=False)
        result, caster = self._execute_as(ctx)
        self.assertTrue(result.get('success', False),
                        f"AS should execute successfully, got: {result}")
        enemy = ctx['bf'].enemy_team[0]
        all_buff_types = [b.effect_type for b in enemy.buffs] + [b.effect_type for b in enemy.debuffs]
        # 不应有 dmg_dealt_down（条件 target_has_status_ailment 不满足）
        self.assertNotIn(_DMG_DEALT_DOWN, all_buff_types,
                         f"Lv15 without status_ailment should NOT have dmg_dealt_down, got: {all_buff_types}")


if __name__ == '__main__':
    unittest.main()
