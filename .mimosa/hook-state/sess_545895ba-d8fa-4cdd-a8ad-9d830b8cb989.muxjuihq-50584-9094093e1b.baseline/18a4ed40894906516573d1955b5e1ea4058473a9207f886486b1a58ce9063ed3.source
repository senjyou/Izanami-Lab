#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""回归测试: 苦手なのはそこだね！(120155) 伤害计算两处缺陷

Bug日志: step_crit_console_tactical_20260819_122942.txt (L4098-4119)
  实际: hp_ratio_damage=37079 + add_damage=24917 = 61996
  期望: hp_ratio_damage=61999 + add_damage=12458 = 74457

Bug1: _apply_hp_ratio_damage 中 ATK上限(cap)在阈值减伤之前应用
  修复前顺序: raw=123998.75 → cap=74159.5 → 减伤50% → 37079 (错)
  修复后顺序: raw=123998.75 → 减伤50% → 61999 → cap不截断 → 61999 (实战验证)
  实战确认: 阈值判断基于减伤前的原始伤害

Bug2: add_damage 路径（_process_enchant_damage_for_target）完全缺失
  dmg_taken_down_threshold 减伤
  修复前: extra_dmg=24917 全额命中
  修复后: 24917 > threshold → 减伤50% → 12458

实战确认（hit_limited消耗语义）: 同一技能的 hp_ratio_damage 与
  add_damage 各消耗1次 hit_limited (2→1→0)，技能打完后减伤buff消失。

Fix: skill_service.py
  1. cap延迟到阈值减伤之后应用（pending_cap），3个value_source分支统一
  2. add_damage 在 extra_dmg 确定后应用阈值减伤并消耗 hit_limited
"""
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

DMG_TAKEN_DOWN_THRESHOLD = "dmg_taken_down_threshold"

_dl = None


def _get_dl():
    global _dl
    if _dl is None:
        _dl = DataLoader()
        _dl.load_all()
    return _dl


def _make_unit(unit_id, side, max_hp, hp, atk, defense=4000):
    pos = Position.ALLY_LEFT_BACK if side == Side.ALLY else Position.ENEMY_CENTER_BACK
    return UnitState(
        unit_id=unit_id, name=unit_id, side=side, position=pos,
        character_id=999901 if side == Side.ALLY else 999001,
        level=10, element=2, character_type=1,
        max_hp=max_hp, current_hp=hp, attack=atk, defense=defense, speed=500,
        crit_rate=0.0, crit_damage=50.0, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=10, current_pp=10, current_ep=0,
    )


def _make_dtd_buff(hit_limited=2, value=50, threshold_pct=2):
    return BuffState(
        buff_id="test_dtd", name=DMG_TAKEN_DOWN_THRESHOLD,
        effect_type=DMG_TAKEN_DOWN_THRESHOLD,
        value=value, duration=-1, timing_type=2,
        is_debuff=False, is_stackable=False, value_tag=0,
        hit_limited=hit_limited,
        threshold_pct=threshold_pct,
        threshold_base="current_hp",
    )


def _make_add_damage_buff(value=15, caster_attack=148319, source_id="a1"):
    return BuffState(
        buff_id="test_add_dmg", name="AddDamage",
        effect_type="AddDamage",
        value=value, duration=-1, timing_type=2,
        is_debuff=False, is_stackable=False, value_tag=0,
        caster_attack=caster_attack,
        source_unit_id=source_id,
    )


def _make_effect(value=12.5, cap_atk_pct=50):
    return type('obj', (object,), {
        'effect_type': 'hp_ratio_damage', 'value': value, 'value_tag': None,
        'value_source': 'target_current_hp', 'target_type': 'enemy_single',
        'flags': {'damage_cap_atk_pct': cap_atk_pct}, 'target_identifier': None,
        'hit_count': None, 'condition': None, 'duration': 1,
        'duration_type': None, 'ignore_shield': 0, 'ignore_defense': 0,
    })()


def _make_services(bf):
    dl = _get_dl()
    rs = ResourceService()
    ts = TriggerService()
    ts.set_data_loader(dl)
    aus = AuraService()
    dms = DamageService()
    tgs = TargetService()
    sts = StatusService()
    ss = SkillService(dl, rs, target_service=tgs, damage_service=dms,
                      aura_service=aus, trigger_service=ts, status_service=sts)
    ts.set_skill_service(ss)
    ts.set_damage_service(dms)
    ss.set_battlefield(bf)
    ss._current_skill_id = 120155
    ss._block_damage_total = {}
    ss._current_block_id = 1
    ss._block_damage_targets = {}
    ss._current_skill_priority = None
    ss._hp_consumed = 0
    ss._most_recent_damage = 0
    ss._per_hit_hp_losses = {}
    ss._pending_deaths = set()
    ss._primary_target = None
    ss._mark_condition_targets = None
    ss._mark_condition_target = None
    ss._newly_created_sub_unit_ids = set()
    return ss


# ═══════════════════════════════════════════════════════════════
# Bug1: 阈值减伤必须在ATK上限(cap)之前应用
# ═══════════════════════════════════════════════════════════════

class TestHpRatioReductionBeforeCap:

    def test_log_scenario_reduction_then_cap(self):
        """复现日志: raw=123998.75 超阈值 → 减伤50% → 61999, cap=74159.5 不截断

        修复前(先cap后减伤): min(123998.75, 74159.5)=74159 → 减伤 → 37079 (错)
        """
        # caster ATK=148319 → cap = 148319*50% = 74159.5
        caster = _make_unit("a1", Side.ALLY, 170589, 170589, 148319)
        # 复现日志: アニス・ベネット max=1120832, current=991990
        enemy = _make_unit("e1", Side.ENEMY, 1120832, 991990, 9831)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        dtd = _make_dtd_buff(hit_limited=2, value=50, threshold_pct=2)
        enemy.buffs.append(dtd)
        ss = _make_services(bf)

        result = ss._apply_hp_ratio_damage(caster, _make_effect(), bf)

        assert result is not None
        # raw = 991990*12.5% = 123998.75 → int 123998
        # threshold = 991990*2% = 19839.8 → 触发减伤50% → 61999
        # cap = 74159.5 > 61999 不截断
        assert result['targets'][0]['actual_damage'] == 61999
        assert enemy.current_hp == 991990 - 61999
        # hit_limited: 2 -> 1
        assert dtd.hit_limited == 1

    def test_cap_still_applies_after_reduction(self):
        """减伤后仍超过cap → cap截断（顺序: 减伤 → cap）"""
        # caster ATK=80000 → cap = 40000
        caster = _make_unit("a1", Side.ALLY, 170589, 170589, 80000)
        enemy = _make_unit("e1", Side.ENEMY, 1120832, 991990, 9831)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        dtd = _make_dtd_buff(hit_limited=2, value=50, threshold_pct=2)
        enemy.buffs.append(dtd)
        ss = _make_services(bf)

        result = ss._apply_hp_ratio_damage(caster, _make_effect(), bf)

        # raw 123998 → 减伤50% → 61999 → cap 40000 截断 → 40000
        assert result['targets'][0]['actual_damage'] == 40000
        assert enemy.current_hp == 991990 - 40000


# ═══════════════════════════════════════════════════════════════
# Bug2: add_damage 路径应用阈值减伤 + 双重hit_limited消耗
# ═══════════════════════════════════════════════════════════════

class TestAddDamageAppliesDtd:

    def test_add_damage_reduced_and_both_hits_consume(self):
        """复现日志完整链路: hp_ratio(61999, 2→1) + add_damage(减伤, 1→0, buff消失)

        实战确认: 同一技能的两笔伤害各消耗1次hit_limited, 技能打完后buff消失
        """
        caster = _make_unit("a1", Side.ALLY, 170589, 170589, 148319)
        enemy = _make_unit("e1", Side.ENEMY, 1120832, 991990, 9831, defense=4000)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        dtd = _make_dtd_buff(hit_limited=2, value=50, threshold_pct=2)
        enemy.buffs.append(dtd)
        # 追撃符式 add_damage buff: 快照ATK=148319, power=15%
        caster.buffs.append(_make_add_damage_buff(value=15, caster_attack=148319))
        ss = _make_services(bf)

        result = ss._apply_hp_ratio_damage(caster, _make_effect(), bf)

        # ── hp_ratio_damage: 61999 (Bug1修复) ──
        assert result['targets'][0]['actual_damage'] == 61999

        # ── add_damage: 应被阈值减伤 ──
        # base = max(0, 148319 + min(0, 148319-4000)) * 15% = 22247.85 → 22247
        # threshold = (991990-61999)*2% = 18599.82 → 22247 > threshold → 减伤50%
        # 期望 add_damage = int(22247*0.5) = 11123
        expected_add = int(int(148319 * 0.15) * 0.5)  # 11123
        assert enemy.current_hp == 991990 - 61999 - expected_add

        # ── 双重消耗: hp_ratio 2→1, add_damage 1→0, buff 消失 ──
        remaining = [b for b in enemy.buffs
                     if b.effect_type == DMG_TAKEN_DOWN_THRESHOLD]
        assert len(remaining) == 0, "实战确认: 技能打完后减伤buff消失"

    def test_add_damage_below_threshold_full_damage(self):
        """add_damage 低于阈值时不减伤，也不消耗hit_limited（实战验证）"""
        caster = _make_unit("a1", Side.ALLY, 170589, 170589, 148319)
        enemy = _make_unit("e1", Side.ENEMY, 1120832, 991990, 9831, defense=4000)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        # threshold = 929991*90% = 836991.9, 两笔伤害均远低于 → 均不减伤不消耗
        dtd = _make_dtd_buff(hit_limited=2, value=50, threshold_pct=90)
        enemy.buffs.append(dtd)
        caster.buffs.append(_make_add_damage_buff(value=15, caster_attack=148319))
        ss = _make_services(bf)

        result = ss._apply_hp_ratio_damage(caster, _make_effect(), bf)

        # hp_ratio: raw 123998 < threshold 836991.9 → 不减伤 → 123998
        # (123998 > cap 74159.5 → cap截断 → 74159)
        assert result['targets'][0]['actual_damage'] == 74159
        # add_damage: 22247 < threshold → 不减伤, 全额22247
        assert enemy.current_hp == 991990 - 74159 - 22247
        # 均未触发减伤, 不消耗 hit_limited: 保持2, buff 存活
        assert dtd.hit_limited == 2
        assert dtd in enemy.buffs

    def test_add_damage_dtd_exhausted_no_second_reduction(self):
        """hit_limited=1 时: hp_ratio消耗后buff消失, add_damage 无减伤"""
        caster = _make_unit("a1", Side.ALLY, 170589, 170589, 148319)
        enemy = _make_unit("e1", Side.ENEMY, 1120832, 991990, 9831, defense=4000)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        dtd = _make_dtd_buff(hit_limited=1, value=50, threshold_pct=2)
        enemy.buffs.append(dtd)
        caster.buffs.append(_make_add_damage_buff(value=15, caster_attack=148319))
        ss = _make_services(bf)

        result = ss._apply_hp_ratio_damage(caster, _make_effect(), bf)

        # hp_ratio: 减伤 → 61999, hit_limited 1→0, buff消失
        assert result['targets'][0]['actual_damage'] == 61999
        # add_damage: buff已消失 → 无减伤, 全额22247
        assert enemy.current_hp == 991990 - 61999 - 22247
