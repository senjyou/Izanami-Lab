"""Unit tests for trigger context passing in _execute_trigger_actions vs _execute_global_trigger_actions.

The key bug: _execute_global_trigger_actions (used by hp_below) bypassed
_execute_trigger_actions_inline, so _primary_target was never set on the skill_service.

Tests verify that both trigger execution paths correctly set _primary_target,
_trigger_attacker, and _damaged_targets on the skill_service before executing the PS.
"""
import unittest
import sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder


class TestGlobalTriggerContext(unittest.TestCase):
    """_execute_global_trigger_actions should pass trigger context."""

    def setUp(self):
        builder = BattleBuilder()
        builder.add_ally(unit_id="owner", hp=20000, atk=10000,
                         skills=[130041], level=10)
        builder.add_ally(unit_id="ally_A", hp=10000)  # full HP
        builder.add_enemy(unit_id="enemy", hp=50000)
        ctx = builder.quick_build()
        self.bf = ctx['bf']
        self.ts = ctx['ts']
        self.ss = ctx['ss']
        self.owner = next(u for u in self.bf.friend_team if u.unit_id == "owner")
        self.ally_A = next(u for u in self.bf.friend_team if u.unit_id == "ally_A")

    def test_hp_below_sets_primary_target(self):
        """trigger_hp_below action params should include primary_target=triggered_by."""
        self.ally_A.current_hp = 4000  # 40% of 10000
        self.ally_A.prev_hp_percent = 100.0
        self.owner.current_pp = 10

        actions = self.ts.trigger_hp_below(self.bf, [self.ally_A])
        ps_actions = [a for a in actions if a.skill_id == 130041]
        self.assertTrue(len(ps_actions) > 0, "should trigger")

        params = getattr(ps_actions[0], 'parameters', {})
        self.assertIn('primary_target', params, "params should contain primary_target")
        self.assertEqual(params['primary_target'].unit_id, self.ally_A.unit_id,
                         "primary_target should be the crossed ally")

    def test_hp_below_sets_targets_list(self):
        """trigger_hp_below action params may or may not include targets list."""
        self.ally_A.current_hp = 4000  # 40% of 10000
        self.ally_A.prev_hp_percent = 100.0
        self.owner.current_pp = 10

        actions = self.ts.trigger_hp_below(self.bf, [self.ally_A])
        ps_actions = [a for a in actions if a.skill_id == 130041]
        self.assertTrue(len(ps_actions) > 0)

        params = getattr(ps_actions[0], 'parameters', {})
        # 'targets' may be set from context.targets (for after_ally_attacked triggers)
        # For hp_below, context.targets is empty so params may not have 'targets'
        # At minimum, primary_target should be set
        self.assertIn('primary_target', params)


class TestAfterAllyAttackedTriggerContext(unittest.TestCase):
    """trigger_after_ally_attacked should pass damaged targets in action params."""

    def setUp(self):
        builder = BattleBuilder()
        builder.add_ally(unit_id="owner", hp=20000, atk=10000,
                         skills=[130025], level=10)
        builder.add_ally(unit_id="ally_A", hp=15000)
        builder.add_enemy(unit_id="enemy_attacker", hp=50000, atk=20000)
        ctx = builder.quick_build()
        self.bf = ctx['bf']
        self.ts = ctx['ts']
        self.ss = ctx['ss']
        self.owner = next(u for u in self.bf.friend_team if u.unit_id == "owner")
        self.ally_A = next(u for u in self.bf.friend_team if u.unit_id == "ally_A")
        self.enemy = next(u for u in self.bf.enemy_team if u.unit_id == "enemy_attacker")

    def test_after_ally_attacked_passes_targets(self):
        """Action params should include targets list for nearest-ally selection."""
        self.owner.current_pp = 10
        # Ensure global_condition passes (target HP not crossing below 50%)
        self.ally_A.prev_hp_percent = 100.0
        self.ally_A.current_hp = 15000  # 100% → stays at 100%

        actions = self.ts.trigger_after_ally_attacked(
            [self.ally_A], self.bf, actor=self.enemy, primary_target=self.ally_A
        )
        ps_actions = [a for a in actions if a.skill_id == 130025]
        if ps_actions:
            params = getattr(ps_actions[0], 'parameters', {})
            self.assertIn('primary_target', params)
            self.assertIn('targets', params, "params should include damaged targets list")
            self.assertEqual(len(params['targets']), 1)


if __name__ == '__main__':
    unittest.main()
