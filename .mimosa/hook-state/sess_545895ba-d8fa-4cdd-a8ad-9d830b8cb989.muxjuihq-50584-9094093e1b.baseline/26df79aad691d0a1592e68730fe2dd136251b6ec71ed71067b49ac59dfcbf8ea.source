#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
测试数据库缓存系统
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.data.stats_cache import CharacterStatsCache


def safe_print(text):
    """安全打印"""
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode('utf-8', errors='replace').decode('utf-8'))


def main():
    """测试缓存系统"""
    safe_print("="*80)
    safe_print("Testing Database Cache System")
    safe_print("="*80)
    
    # 初始化缓存
    cache = CharacterStatsCache()
    
    # 测试1: 读取角色缓存
    safe_print("\n[Test 1] Reading character cache...")
    char_id = 132301
    stats = cache.get_character_stats(char_id)
    
    if stats:
        safe_print(f"\nCharacter: {stats['name']} (ID: {char_id})")
        safe_print(f"Config:")
        safe_print(f"  Level: {stats['config']['level']}")
        safe_print(f"  Rarity: {stats['config']['rarity']}")
        safe_print(f"  Affection: {stats['config']['affection_level']}")
        safe_print(f"\nStats:")
        safe_print(f"  HP:      {stats['stats']['hp']:,}")
        safe_print(f"  Attack:  {stats['stats']['attack']:,}")
        safe_print(f"  Defense: {stats['stats']['defense']:,}")
        safe_print(f"  Speed:   {stats['stats']['speed']}")
    else:
        safe_print(f"Character {char_id} not found in cache!")
    
    # 测试2: 重置到默认
    safe_print(f"\n[Test 2] Resetting character {char_id} to default...")
    cache.reset_to_default(char_id)
    safe_print("Reset complete!")
    
    # 重新读取验证
    stats_after = cache.get_character_stats(char_id)
    if stats_after:
        safe_print(f"After reset - HP: {stats_after['stats']['hp']:,}, ATK: {stats_after['stats']['attack']:,}")
    
    safe_print("\n" + "="*80)
    safe_print("All tests completed!")
    safe_print("="*80)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        safe_print(f"\nERROR: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)
