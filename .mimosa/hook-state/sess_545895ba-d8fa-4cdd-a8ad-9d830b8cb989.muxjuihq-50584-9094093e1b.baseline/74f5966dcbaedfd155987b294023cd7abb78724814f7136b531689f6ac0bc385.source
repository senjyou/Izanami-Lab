"""Regression: HP ratio target selection precision must be truncated to 0.01%.

Bug: The simulator calculated HP ratios with full floating-point precision,
     distinguishing between units like 97327/97328 (99.99897%) and
     84497/84498 (99.99882%). The actual game uses lower precision (0.01%),
     treating these as the same 99.99%. When ratios are equal after truncation,
     position proximity (nearest to caster) is used as a tiebreaker.

     Example: 「私に任せて！+」(220378) heal_link with target_type
     "enemy_single_lowest_hp_ratio" selected 空っぽのアクター (84497/84498)
     instead of 唯一無二の幼なじみ (97327/97328) because 84497/84498 is
     slightly lower. With 0.01% precision, both are 99.99%, and 唯一無二の
     幼なじみ is selected by position proximity.

     Note: Truncation (int floor) is used instead of round() because
     round(0.99998972, 4) = 1.0 (rounds UP to 100%), which would treat -1 HP
     units as full HP. int(0.99998972 * 10000) / 10000 = 0.9999 correctly
     treats them as 99.99%, distinct from full HP (100%).

Fix: Truncate HP ratio to 4 decimal places (0.01%) via int(ratio*10000)/10000
     in all target selection locations. Add position proximity tiebreaker
     where missing.

Locations modified:
  1. target_service.py LOWEST_HP_PERCENT priority
  2. skill_service.py enemy_single_lowest_hp_ratio (damage, aura, heal_link)
  3. skill_service.py enemy_single_highest_hp_ratio (damage, aura)
  4. skill_service.py lowest_hp_priority flag
  5. battle_flow_controller.py memory card enemy_single_lowest_hp_ratio
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.services.target_service import TargetService


def _truncate_ratio(u):
    """ゲーム内挙動：HP比例を万分位（0.01%）に切り捨て。"""
    return int((u.current_hp / u.max_hp) * 10000) / 10000 if u.max_hp > 0 else 0


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=5000, speed=500, current_hp=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=15, element=2, character_type=1,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=10, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


class TestRegHpRatioPrecision(unittest.TestCase):
    """HP比例索敌精度テスト（万分位切捨て）."""

    def test_lowest_hp_ratio_truncated_to_4_decimals(self):
        """Units with HP ratios differing only beyond 4 decimal places
        should be treated as equal, with position proximity as tiebreaker.

        Scenario: Two enemy units, both at -1 HP:
          - Unit A: 97327/97328 = 0.99998972... -> truncates to 0.9999
          - Unit B: 84497/84498 = 0.99998816... -> truncates to 0.9999

        Without truncation, Unit B has a lower ratio and would be selected.
        With truncation, both are 99.99%, and position proximity decides.

        Note: round() would give 1.0 for both (rounding UP), incorrectly
        treating them as full HP. int() truncation gives 0.9999 (99.99%).
        """
        ts = TargetService()

        caster = _make_unit("caster", "Caster", Side.ALLY,
                            Position.ALLY_CENTER_FRONT)

        unit_a = _make_unit("enemy_a", "UnitA", Side.ENEMY,
                            Position.ENEMY_LEFT_FRONT,
                            hp=97328, current_hp=97327)

        unit_b = _make_unit("enemy_b", "UnitB", Side.ENEMY,
                            Position.ENEMY_RIGHT_FRONT,
                            hp=84498, current_hp=84497)

        # Verify truncation gives 0.9999, NOT 1.0 (which round() would give)
        self.assertEqual(_truncate_ratio(unit_a), 0.9999,
                         "97327/97328 must truncate to 0.9999, not round to 1.0")
        self.assertEqual(_truncate_ratio(unit_b), 0.9999,
                         "84497/84498 must truncate to 0.9999, not round to 1.0")

        candidates = [unit_a, unit_b]
        best = ts.select_min_with_stealth(
            candidates,
            key_func=lambda u: (_truncate_ratio(u),
                                ts._get_sort_key(caster, u)),
            consume=True
        )

        self.assertEqual(best.unit_id, unit_a.unit_id,
                         "With 0.01% precision, both units are 99.99%. "
                         "Unit A (LEFT_FRONT) is nearer to caster (CENTER_FRONT) "
                         "than Unit B (RIGHT_FRONT).")

    def test_lowest_hp_ratio_distinct_ratios_still_distinguished(self):
        """When HP ratios differ at the 4th decimal place or above, the
        lower one is still correctly selected."""
        ts = TargetService()

        caster = _make_unit("caster", "Caster", Side.ALLY,
                            Position.ALLY_CENTER_FRONT)

        unit_a = _make_unit("enemy_a", "UnitA", Side.ENEMY,
                            Position.ENEMY_LEFT_FRONT,
                            hp=100000, current_hp=80000)

        unit_b = _make_unit("enemy_b", "UnitB", Side.ENEMY,
                            Position.ENEMY_RIGHT_FRONT,
                            hp=100000, current_hp=90000)

        candidates = [unit_a, unit_b]
        best = ts.select_min_with_stealth(
            candidates,
            key_func=lambda u: (_truncate_ratio(u),
                                ts._get_sort_key(caster, u)),
            consume=True
        )

        self.assertEqual(best.unit_id, unit_a.unit_id,
                         "Unit A (80% HP) should be selected over Unit B (90% HP).")

    def test_full_hp_unit_distinct_from_minus_one_hp(self):
        """A full-HP unit (100%) must be distinct from a -1 HP unit (99.99%)
        after truncation. round() would treat both as 100%, but int()
        truncation correctly distinguishes them.

        Scenario: Full-HP unit (100%) vs -1 HP unit (99.99%).
        For lowest_hp_ratio, the -1 HP unit (99.99%) should be selected.
        """
        ts = TargetService()

        caster = _make_unit("caster", "Caster", Side.ALLY,
                            Position.ALLY_CENTER_FRONT)

        full_hp = _make_unit("full_hp", "FullHP", Side.ENEMY,
                             Position.ENEMY_LEFT_FRONT,
                             hp=79459, current_hp=79459)  # 100%

        minus_one = _make_unit("minus_one", "MinusOne", Side.ENEMY,
                               Position.ENEMY_RIGHT_FRONT,
                               hp=97328, current_hp=97327)  # 99.99%

        # Verify truncation distinguishes them
        self.assertEqual(_truncate_ratio(full_hp), 1.0,
                         "Full HP must truncate to 1.0 (100%)")
        self.assertEqual(_truncate_ratio(minus_one), 0.9999,
                         "-1 HP must truncate to 0.9999 (99.99%), NOT 1.0")

        candidates = [full_hp, minus_one]
        best = ts.select_min_with_stealth(
            candidates,
            key_func=lambda u: (_truncate_ratio(u),
                                ts._get_sort_key(caster, u)),
            consume=True
        )

        self.assertEqual(best.unit_id, minus_one.unit_id,
                         "99.99% (minus_one) is lower than 100% (full_hp), "
                         "so minus_one should be selected for lowest_hp_ratio.")

    def test_heal_link_lowest_hp_ratio_with_precision(self):
        """Multiple units at -1 HP should all be treated as 99.99%, and the
        nearest one to the caster should be selected (simulating heal_link
        target selection for skill 220378 私に任せて！+).
        """
        ts = TargetService()

        caster = _make_unit("caster", "Caster", Side.ALLY,
                            Position.ALLY_CENTER_FRONT,
                            hp=1000000, current_hp=1000000)

        ally_left = _make_unit("ally_left", "AllyLeft", Side.ALLY,
                               Position.ALLY_LEFT_FRONT,
                               hp=97328, current_hp=97327)
        ally_right = _make_unit("ally_right", "AllyRight", Side.ALLY,
                                Position.ALLY_RIGHT_FRONT,
                                hp=84498, current_hp=84497)
        ally_center_back = _make_unit("ally_cb", "AllyCenterBack", Side.ALLY,
                                      Position.ALLY_CENTER_BACK,
                                      hp=90514, current_hp=90513)

        candidates = [ally_left, ally_right, ally_center_back]

        for u in candidates:
            truncated = _truncate_ratio(u)
            self.assertEqual(truncated, 0.9999,
                             msg=f"{u.name} should truncate to 0.9999, not round to 1.0")

        best = ts.select_min_with_stealth(
            candidates,
            key_func=lambda u: (_truncate_ratio(u),
                                ts._get_sort_key(caster, u)),
            consume=True
        )

        self.assertEqual(best.unit_id, ally_left.unit_id,
                         f"With 0.01% precision, all are 99.99%. "
                         f"Nearest to caster should be selected. Got: {best.name}")

    def test_highest_hp_ratio_truncated_to_4_decimals(self):
        """Highest HP ratio should also use 0.01% precision with position
        tiebreaker (nearest wins when ratios are equal)."""
        ts = TargetService()

        caster = _make_unit("caster", "Caster", Side.ALLY,
                            Position.ALLY_CENTER_FRONT)

        unit_a = _make_unit("enemy_a", "UnitA", Side.ENEMY,
                            Position.ENEMY_LEFT_FRONT,
                            hp=97328, current_hp=97327)
        unit_b = _make_unit("enemy_b", "UnitB", Side.ENEMY,
                            Position.ENEMY_RIGHT_FRONT,
                            hp=84498, current_hp=84497)

        candidates = [unit_a, unit_b]
        best = ts.select_max_with_stealth(
            candidates,
            key_func=lambda u: (_truncate_ratio(u),
                                -ts._get_sort_key(caster, u)),
            consume=True
        )

        self.assertEqual(best.unit_id, unit_a.unit_id,
                         "With 0.01% precision, both are 99.99%. "
                         "Unit A (LEFT_FRONT) is nearer and should be selected.")


if __name__ == '__main__':
    unittest.main()
