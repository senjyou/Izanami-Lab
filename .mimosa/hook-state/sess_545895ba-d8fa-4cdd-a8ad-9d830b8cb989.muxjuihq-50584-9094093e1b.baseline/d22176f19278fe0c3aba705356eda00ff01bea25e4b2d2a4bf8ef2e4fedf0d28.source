"""
角色112302 発情バニー 专项E2E测试
- EX: 110057 バニー＆ベット（单体1hit + 敵全体除対象4hit追加攻撃[cannot_crit] + 自身good_luck + reset 120126 CD）
- AS1: 120126 オッドイーブン（单体2hit；威力2/威力3由good_luck状态互斥；Lv11+ dmg_dealt_down debuff）
- AS2: 120127 ハイローベット（残HP少ない順敵2体[Lv15→3体]；最HP少≤60%时暴击率+crt%）
- AS3: 120128 ストレートアップ（单体伤害）
- PS: 130132 ジャックポット（on_critical：crit_rate_up stackable；Lv11+ crit_dmg_up stackable）

覆盖维度：
1. EX 主目标+追加攻撃+cannot_crit验证+good_luck付与+reset_cooldown
2. AS1 good_luck状态互斥分支+Lv11+ debuff
3. AS2 lowest_hp_priority target_count分支+target_hp_below_crit暴击加成
4. AS3 基础伤害
5. PS on_critical触发+stackable+Lv11+ crit_dmg_up+不被cannot_crit追加攻撃触发
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# 注意：dmg_dealt_up/dmg_dealt_down 共用 DEALT_DAMAGE 枚举，区分方式：
#   up 在 buffs 列表，down 在 debuffs 列表
# crit_rate_up/crit_rate_down 共用 STATUS_CRITICAL_CHANCE
# crit_dmg_up/crit_dmg_down 共用 CRITICAL_BONUS_MODIFICATION
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
STATUS_CRITICAL_CHANCE = SkillEffectType.STATUS_CRITICAL_CHANCE.value
CRITICAL_BONUS_MODIFICATION = SkillEffectType.CRITICAL_BONUS_MODIFICATION.value


class TestActor112302(unittest.TestCase):
    """角色112302 発情バニー 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 112302 発情バニー (火属性attr=1, 物理型character_type=1, 灵活position_type=3, 物理アタッカーrole_type=1)
        # 默认Lv10，部分测试用Lv15验证Lv11+分支
        self.caster = UnitState(
            unit_id="ally_front", name="発情バニー", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=112302, level=10,
            element=1, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110057, 120126, 120127, 120128, 130132],
            skill_levels={110057: 10, 120126: 10, 120127: 10,
                          120128: 10, 130132: 10},
            skill_cooldowns={},
        )

        # 敌方前排中央（EX主目标，最近敌）
        self.enemy_front = UnitState(
            unit_id="enemy_front", name="敌方前排", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（AS2 多目标测试用）
        self.enemy_left = UnitState(
            unit_id="enemy_left", name="敌方左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（AS2 Lv15 三目标测试用）
        self.enemy_right = UnitState(
            unit_id="enemy_right", name="敌方右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=4500, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy_front, self.enemy_left, self.enemy_right]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ap = 4

    def _reset_caster(self, hp=None, ap=10):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.crit_counter = 0

    # ─── EX: 110057 バニー＆ベット ───

    def test_ex_main_damage_and_4hit_additional(self):
        """EX(110057) Block1: enemy_single 1hit主目标；Block2: enemy_all_except_last 4hit追加攻撃。

        caster位于ALLY_CENTER_FRONT，最近敌为enemy_front（ENEMY_CENTER_FRONT）。
        Block2排除主目标，对其他敌方(enemy_left, enemy_right)各4hit。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110057, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证主目标受到伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "主目标(enemy_front)应受到Block1的伤害")

        # 验证追加攻撃命中其他敌方（enemy_left, enemy_right 各4hit）
        self.assertLess(self.enemy_left.current_hp, self.enemy_left.max_hp,
                        "enemy_left应受到Block2的4hit追加攻撃")
        self.assertLess(self.enemy_right.current_hp, self.enemy_right.max_hp,
                        "enemy_right应受到Block2的4hit追加攻撃")

        # 验证伤害效果数（Block1 + Block2）
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertGreaterEqual(len(dmg_effects), 2,
                                "应有至少2个damage effect（主目标 + 追加攻撃）")

    def test_ex_additional_attacks_cannot_crit(self):
        """EX(110057) Block2 追加攻撃 flags.cannot_crit=true，即使主攻击force_crit也不暴击。

        设置DamageService.crit_override强制暴击，验证：
        - Block1 主攻击暴击（_pending_crit_triggers 收集到暴击事件）
        - Block2 追加攻撃不暴击（_pending_crit_triggers 不应增加）
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 强制暴击override
        self.dms.set_crit_override(lambda ctx: True)
        try:
            # 清空暴击触发器列表
            self.ss._pending_crit_triggers = []

            # 使用 defer_crit_triggers=True 让 execute_skill 不立即触发PS，
            # 保留 _pending_crit_triggers 供测试断言验证
            result = self.ss.execute_skill(
                caster=self.caster, skill_id=110057, battlefield=self.bf, skip_cost=True,
                defer_crit_triggers=True
            )
            self.assertTrue(result["success"])

            # 验证主攻击暴击被收集到 pending_crit_triggers
            # defer=True 时触发器在 result["pending_crit_triggers"] 中（_pending_crit_triggers 已被清空）
            crit_triggers = result.get("pending_crit_triggers", [])
            self.assertGreater(len(crit_triggers), 0,
                               "Block1主攻击应暴击，触发器应被收集")

            # 但追加攻撃(cannot_crit=true)不应增加暴击触发器
            # 由于Block1只1hit，Block2对2个目标各4hit，若无cannot_crit应有最多8个暴击事件
            # 有cannot_crit时只有Block1的1个暴击事件
            # 注意：暴击触发器收集是 per-target 一次（一个目标内多hit暴击只算1次）
            # Block1主目标(enemy_front)暴击1次 → 1个触发器
            # Block2追加攻撃 cannot_crit → 0个触发器
            self.assertEqual(len(crit_triggers), 1,
                             f"追加攻撃 cannot_crit=true 不应收集暴击触发器，实际: {len(crit_triggers)}")
        finally:
            self.dms.clear_crit_override()

    def test_ex_grants_good_luck(self):
        """EX(110057) Block3: 自身付与1行动「グッドラック」buff。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110057, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证good_luck buff
        good_luck_buffs = [b for b in self.caster.buffs
                           if b.effect_type == "good_luck"]
        self.assertTrue(len(good_luck_buffs) > 0,
                        "应有good_luck buff")
        self.assertEqual(good_luck_buffs[0].duration, 1, "good_luck应持续1行动")

    def test_ex_resets_odd_even_cooldown(self):
        """EX(110057) Block4: reset_cooldown 120126。

        先设置120126 cooldown=3，施放EX后CD应被重置为0。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 设置120126 CD=3
        self.caster.skill_cooldowns[120126] = 3
        self.assertEqual(self.caster.skill_cooldowns[120126], 3)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110057, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证CD被重置
        self.assertEqual(self.caster.skill_cooldowns.get(120126, 0), 0,
                         "EX应重置120126的cooldown")

    # ─── AS1: 120126 オッドイーブン ───

    def test_as1_without_good_luck_uses_block2(self):
        """AS1(120126) 无good_luck: Block1(威力1) + Block2(威力2)。

        Block3的condition(self_has_status good_luck)不满足，跳过。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 无good_luck状态
        good_luck_buffs = [b for b in self.caster.buffs if b.effect_type == "good_luck"]
        self.assertEqual(len(good_luck_buffs), 0)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120126, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证造成伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "enemy_front应受到伤害（Block1+Block2）")

        # 验证有2个damage effect（Block1 + Block2）
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 2,
                         f"无good_luck时应执行Block1+Block2共2个damage effect，实际: {len(dmg_effects)}")

    def test_as1_with_good_luck_uses_block3(self):
        """AS1(120126) 有good_luck: Block1(威力1) + Block3(威力3)。

        Block2的condition(self_no_status good_luck)不满足，跳过。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 预先施加good_luck buff（模拟EX的效果）
        from src.entities_v2.unit_state import BuffState
        good_luck = BuffState(
            buff_id="test_gl", name="グッドラック", effect_type="good_luck",
            value=0, duration=1, timing_type=2,
        )
        self.caster.buffs.append(good_luck)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120126, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证造成伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "enemy_front应受到伤害（Block1+Block3）")

        # 验证有2个damage effect（Block1 + Block3，跳过Block2）
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 2,
                         f"有good_luck时应执行Block1+Block3共2个damage effect，实际: {len(dmg_effects)}")

    def test_as1_lv11_grants_dmg_dealt_down(self):
        """AS1(120126) Block4: Lv11+时触发，敌方dmg_dealt_down debuff(stackable, 1/action)。"""
        self.caster.level = 15
        self.caster.skill_levels[120126] = 15
        self._reset_caster(hp=self.caster.max_hp)
        self.caster.skill_levels[120126] = 15
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120126, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证dmg_dealt_down debuff
        debuffs = [d for d in self.enemy_front.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertTrue(len(debuffs) > 0, "Lv11+敌方应有dmg_dealt_down debuff")
        self.assertEqual(debuffs[0].duration, 1, "dmg_dealt_down应持续1行动")
        self.assertTrue(debuffs[0].is_stackable, "dmg_dealt_down应可叠加")

    # ─── AS2: 120127 ハイローベット ───

    def test_as2_lv10_targets_lowest_hp_2(self):
        """AS2(120127) Lv1-14 Block1: 残HP少ない順敵2体。

        enemy_front(hp=30000) > enemy_left(hp=15000) > enemy_right(hp=12000)
        最HP少2体 = enemy_right + enemy_left
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 验证初始HP：enemy_right(12000) < enemy_left(15000) < enemy_front(30000)
        self.assertLess(self.enemy_right.current_hp, self.enemy_left.current_hp)
        self.assertLess(self.enemy_left.current_hp, self.enemy_front.current_hp)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120127, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证最HP少2体受到伤害
        self.assertLess(self.enemy_right.current_hp, self.enemy_right.max_hp,
                        "最HP少的enemy_right应受到伤害")
        self.assertLess(self.enemy_left.current_hp, self.enemy_left.max_hp,
                        "次HP少的enemy_left应受到伤害")

        # 验证HP最多的enemy_front未受伤害（target_count=2只选2体）
        self.assertEqual(self.enemy_front.current_hp, self.enemy_front.max_hp,
                         "HP最多的enemy_front不应被AS2 Lv10选中")

    def test_as2_lv15_targets_3(self):
        """AS2(120127) Lv15 Block2: 残HP少ない順敵3体。"""
        self.caster.level = 15
        self.caster.skill_levels[120127] = 15
        self._reset_caster(hp=self.caster.max_hp)
        self.caster.skill_levels[120127] = 15
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120127, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证3体敌人都受到伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "enemy_front应被AS2 Lv15选中并受到伤害")
        self.assertLess(self.enemy_left.current_hp, self.enemy_left.max_hp,
                        "enemy_left应被AS2 Lv15选中并受到伤害")
        self.assertLess(self.enemy_right.current_hp, self.enemy_right.max_hp,
                        "enemy_right应被AS2 Lv15选中并受到伤害")

    def test_as2_lowest_hp_below_60_crit_bonus(self):
        """AS2(120127) target_hp_below_crit: 最HP少目标≤60%时暴击率+crt%。

        enemy_right max_hp=12000, 60%=7200。
        设置enemy_right.current_hp=6000(50%) → 触发暴击率加成。
        验证：施放AS2后caster暴击伤害（暴击率提升→易暴击）。
        通过damage_service.crit_override验证加成是否传入。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 设置enemy_right HP=50%（≤60%）
        self.enemy_right.current_hp = int(self.enemy_right.max_hp * 0.5)

        # 收集crit_rate上下文验证暴击加成
        captured_ctx = []

        # 通过 override 强制不暴击，但先记录 crit_rate 上下文
        original_check = self.dms._crit_override_func

        def capture_ctx(ctx):
            captured_ctx.append(ctx.copy())
            return False  # 强制不暴击

        self.dms.set_crit_override(capture_ctx)
        try:
            result = self.ss.execute_skill(
                caster=self.caster, skill_id=120127, battlefield=self.bf, skip_cost=True
            )
            self.assertTrue(result["success"])

            # 验证暴击率上下文中含有加成（target_hp_below_crit 应增加 bonus_crit）
            # 注意：crit_override被调用时crit_rate字段已包含bonus_crit
            self.assertGreater(len(captured_ctx), 0, "应至少有1次暴击判定")

            # crit_rate 基础=0.0（caster.crit_rate=0.0），加成后>0说明 target_hp_below_crit 生效
            # crt Lv1=10%，所以加成后应≥0.10
            # 注意：context 中 crit_rate 字段可能为 None（如果是 force_crit 路径），但我们用的是 override 不是 force_crit
            for ctx in captured_ctx:
                if ctx.get('crit_rate') is not None:
                    self.assertGreater(ctx['crit_rate'], 0.0,
                                       "target_hp_below_crit触发时暴击率应增加（>0）")
                    break
            else:
                self.fail("未捕获到带 crit_rate 的上下文")
        finally:
            self.dms.clear_crit_override()

    # ─── AS3: 120128 ストレートアップ ───

    def test_as3_basic_damage(self):
        """AS3(120128) 基础伤害：敌单体威力攻撃。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120128, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证最近敌方受到伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "enemy_front应受到AS3伤害")

        # 验证只有1个damage effect
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 1, "AS3应只有1个damage effect")

    # ─── PS: 130132 ジャックポット ───

    def test_ps_on_critical_triggers_crit_rate_up(self):
        """PS(130132) Block1: on_critical触发，自身crit_rate_up(stackable)。

        直接调用trigger_pawn_caused_critical模拟暴击触发，验证PS被收集并执行后获得crit_rate_up buff。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 调用trigger_pawn_caused_critical收集PS触发器
        trigger_actions = self.ts.trigger_pawn_caused_critical(
            caster=self.caster, battlefield=self.bf, count=1,
            crit_target=self.enemy_front
        )

        # 验证PS(130132)被收集
        ps_actions = [a for a in trigger_actions if a.skill_id == 130132]
        self.assertTrue(len(ps_actions) > 0, "PS(130132)应在暴击时被收集")

        # 执行PS
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="pawn_caused_critical"
        )

        # 验证自身获得crit_rate_up buff
        crit_up_buffs = [b for b in self.caster.buffs
                         if b.effect_type == STATUS_CRITICAL_CHANCE]
        self.assertTrue(len(crit_up_buffs) > 0, "PS应给自身施加crit_rate_up buff")
        self.assertTrue(crit_up_buffs[0].is_stackable, "crit_rate_up应可叠加")

    def test_ps_multiple_crits_stack_crit_rate_up(self):
        """PS(130132) 多次暴击触发，crit_rate_up应叠加（stackable）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 第一次暴击触发
        actions1 = self.ts.trigger_pawn_caused_critical(
            caster=self.caster, battlefield=self.bf, count=1,
            crit_target=self.enemy_front
        )
        ps1_actions = [a for a in actions1 if a.skill_id == 130132]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="pawn_caused_critical"
        )

        buffs_after_first = [b for b in self.caster.buffs
                             if b.effect_type == STATUS_CRITICAL_CHANCE]
        self.assertEqual(len(buffs_after_first), 1, "第一次触发应有1个crit_rate_up buff")

        # 第二次暴击触发
        actions2 = self.ts.trigger_pawn_caused_critical(
            caster=self.caster, battlefield=self.bf, count=1,
            crit_target=self.enemy_front
        )
        ps2_actions = [a for a in actions2 if a.skill_id == 130132]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="pawn_caused_critical"
        )

        buffs_after_second = [b for b in self.caster.buffs
                              if b.effect_type == STATUS_CRITICAL_CHANCE]
        self.assertEqual(len(buffs_after_second), 2,
                         "第二次触发应叠加第2个crit_rate_up buff（stackable）")

    def test_ps_lv11_grants_crit_dmg_up(self):
        """PS(130132) Block2: Lv11+时触发，自身crit_dmg_up(stackable)。"""
        self.caster.level = 15
        self.caster.skill_levels[130132] = 15
        self._reset_caster(hp=self.caster.max_hp)
        self.caster.skill_levels[130132] = 15
        self._reset_enemies()

        # 触发暴击PS
        trigger_actions = self.ts.trigger_pawn_caused_critical(
            caster=self.caster, battlefield=self.bf, count=1,
            crit_target=self.enemy_front
        )
        ps_actions = [a for a in trigger_actions if a.skill_id == 130132]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="pawn_caused_critical"
        )

        # 验证crit_dmg_up buff
        crit_dmg_buffs = [b for b in self.caster.buffs
                          if b.effect_type == CRITICAL_BONUS_MODIFICATION]
        self.assertTrue(len(crit_dmg_buffs) > 0, "Lv11+应有crit_dmg_up buff")
        self.assertTrue(crit_dmg_buffs[0].is_stackable, "crit_dmg_up应可叠加")

    def test_ps_not_triggered_by_ex_additional_attacks(self):
        """PS(130132) 不应被EX追加攻撃触发：Block2 cannot_crit=true 不暴击，不收集暴击触发器。

        通过强制暴击override让Block1暴击，验证：
        - _pending_crit_triggers 只有1个（Block1主攻击）
        - 追加攻撃(cannot_crit=true)不增加触发器
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 强制暴击override
        self.dms.set_crit_override(lambda ctx: True)
        try:
            self.ss._pending_crit_triggers = []

            # 使用 defer_crit_triggers=True 让 execute_skill 不立即触发PS，
            # 保留 _pending_crit_triggers 供测试断言验证
            result = self.ss.execute_skill(
                caster=self.caster, skill_id=110057, battlefield=self.bf, skip_cost=True,
                defer_crit_triggers=True
            )
            self.assertTrue(result["success"])

            # 验证只有Block1主攻击暴击被收集（1个触发器）
            # 追加攻撃 cannot_crit=true 不应收集暴击触发器
            # defer=True 时触发器在 result["pending_crit_triggers"] 中（_pending_crit_triggers 已被清空）
            crit_triggers = result.get("pending_crit_triggers", [])
            self.assertEqual(len(crit_triggers), 1,
                             f"追加攻撃 cannot_crit=true 不应触发PS，应有1个暴击触发器，实际: {len(crit_triggers)}")
        finally:
            self.dms.clear_crit_override()


if __name__ == "__main__":
    unittest.main()
