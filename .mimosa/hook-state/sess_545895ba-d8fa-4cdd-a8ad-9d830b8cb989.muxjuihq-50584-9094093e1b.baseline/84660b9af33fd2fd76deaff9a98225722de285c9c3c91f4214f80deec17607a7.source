    # ─── 综合 mark全链 ───

    def test_mark_chain_as1_to_ps2(self):
        """mark全链：AS1施加高揚 → PS2 Block3检测高揚>=2时移除。

        场景：对同一敌人连续2次AS1（每次预设3浮足mark触发Block2）→ 该敌人累积2高揚mark
        → PS2 Block3 per-target 检测 高揚>=2 → remove_mark(高揚, remove_all=true) 移除该敌人所有高揚。

        注意：mark_count 条件是 per-target 独立判断，不是全局总数。
        2个敌人各1高揚 → Block3 跳过（每个目标都<2）。
        1个敌人2高揚 → Block3 触发（该目标>=2）。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_levels[120147] = 10
        self.caster.skill_levels[130148] = 10
        self.bf.turn_number = 2

        # 第一次AS1：对中前预设3浮足 → Block2触发 → 移除浮足+付1高揚
        self._apply_mark(self.enemy_cf, "浮足", count=3)
        result1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120147, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result1["success"])
        kouryo_cf_1 = [d for d in self.enemy_cf.debuffs if d.effect_type == MARK
                       and d.name == "高揚"]
        self.assertEqual(len(kouryo_cf_1), 1, "第一次AS1后中前应有1高揚mark")

        # 第二次AS1：再次预设3浮足 → Block2再次触发 → 再付1高揚（累积2个）
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._apply_mark(self.enemy_cf, "浮足", count=3)
        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120147, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result2["success"])
        kouryo_cf_2 = [d for d in self.enemy_cf.debuffs if d.effect_type == MARK
                       and d.name == "高揚"]
        self.assertEqual(len(kouryo_cf_2), 2, "第二次AS1后中前应有2高揚mark")

        # PS2 Block3：per-target检测 中前 高揚=2 >=2 → 触发 remove_mark(高揚, remove_all=true)
        self.caster.skill_cooldowns = {}  # 清除PS2冷却
        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130148]
        self.assertGreater(len(ps2_actions), 0, "PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # Block3执行：中前的2个高揚mark应被移除（remove_all=true）
        kouryo_cf_after = [d for d in self.enemy_cf.debuffs if d.effect_type == MARK
                           and d.name == "高揚"]
        self.assertEqual(len(kouryo_cf_after), 0,
                         "PS2 Block3应移除中前的所有高揚mark（per-target>=2触发remove_all）")

    def test_full_chain_ex_as2_as1_ps2(self):
        """全链测试：EX付浮足 → AS2 Block2触发HP比例伤害 → AS1累积3浮足换高揚 → PS2 Block3移除高揚。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_levels[130148] = 10
        self.bf.turn_number = 2

        # Step1: AS2 对左后付浮足mark（Block1 attacked_targets）
        # 主目标(左后)和邻接(左前,中后)都会有浮足
        result_as2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120148, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as2["success"])

        # 验证：左后、左前、中后各有1浮足
        marks_lb = [d for d in self.enemy_lb.debuffs if d.effect_type == MARK
                    and d.name == "浮足"]
        self.assertEqual(len(marks_lb), 1, "Step1后左后应有1浮足mark")

        # Step2: 再次AS2，左后累积2浮足
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        result_as2_2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120148, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as2_2["success"])
        marks_lb_2 = [d for d in self.enemy_lb.debuffs if d.effect_type == MARK
                      and d.name == "浮足"]
        self.assertEqual(len(marks_lb_2), 2, "Step2后左后应有2浮足mark")

        # Step3: 第三次AS2，左后累积3浮足
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        result_as2_3 = self.ss.execute_skill(
            caster=self.caster, skill_id=120148, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as2_3["success"])
        marks_lb_3 = [d for d in self.enemy_lb.debuffs if d.effect_type == MARK
                      and d.name == "浮足"]
        self.assertEqual(len(marks_lb_3), 3, "Step3后左后应有3浮足mark")

        # Step4: AS1 选中前为主目标（最近敌），但中前无浮足mark
        # 为了测试AS1 Block2，需要对中前预设浮足mark
        # 这里改用：将左后作为AS1主目标，通过杀死其他更近敌方
        # 简化：直接对中前预设3浮足mark，触发AS1 Block2
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._apply_mark(self.enemy_cf, "浮足", count=3)

        result_as1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120147, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as1["success"])

        # 中前应有1高揚mark
        kouryo_cf = [d for d in self.enemy_cf.debuffs if d.effect_type == MARK
                     and d.name == "高揚"]
        self.assertEqual(len(kouryo_cf), 1, "Step4后中前应有1高揚mark")

        # Step5: PS2 Block3 需要高揚>=2（per-target），目前中前只有1个，所以Block3跳过
        # 需要对同一敌人(中前)再付1高揚mark，使其累积到2个
        # 注意：mark_count 是 per-target 独立判断，不是全局总数
        self._apply_mark(self.enemy_cf, "高揚", count=1)  # 中前累积到2高揚

        self.caster.skill_cooldowns = {}
        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130148]
        self.assertGreater(len(ps2_actions), 0, "PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # Block3应执行：per-target检测中前 高揚=2 >=2 → remove_mark(高揚, remove_all=true)
        # 中前的所有高揚mark应被移除
        kouryo_cf_after = [d for d in self.enemy_cf.debuffs if d.effect_type == MARK
                           and d.name == "高揚"]
        self.assertEqual(len(kouryo_cf_after), 0,
                         "Step5: PS2 Block3应移除中前的所有高揚mark（per-target>=2触发remove_all）")


if __name__ == "__main__":
    unittest.main(verbosity=2)
