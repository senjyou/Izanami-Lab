    def test_ps2_block1_crit_rate_and_dmg_down(self):
        """PS2(130148) Block1: 回合开始时对敌单体 crit_rate_down + crit_dmg_down。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
