        self.assertGreater(len(ps2_actions), 0, "PS2应在回合开始时触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 最近敌方应有 crit_rate_down 和 crit_dmg_down debuff
        # 注意：buff value 是绝对值（非负），区分 buff/debuff 用 is_debuff 字段
        for e, name in [(self.enemy_cf, "中前(最近敵)")]:
            crit_downs = [d for d in e.debuffs
                          if d.effect_type == STATUS_CRITICAL_CHANCE and d.is_debuff]
            crit_dmg_downs = [d for d in e.debuffs
                              if d.effect_type == CRITICAL_BONUS_MODIFICATION and d.is_debuff]
            self.assertGreater(len(crit_downs), 0, f"{name}应有 crit_rate_down")
            self.assertGreater(len(crit_dmg_downs), 0, f"{name}应有 crit_dmg_down")

