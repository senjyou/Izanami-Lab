                     if d.effect_type == STATUS_ATTACK and d.is_debuff]
        self.assertGreater(len(atk_downs), 0,
                           "trigger_attacker应有 atk_down debuff")
        self.assertEqual(atk_downs[0].duration, 2, "atk_down duration应为2")

    def test_ps1_cooldown_99_blocks_retrigger(self):
        """PS1(130147) 冷却99阻止再次触发。

        场景：PS1已执行（cooldown=99），第二次触发应被跳过。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.bf.turn_number = 2

        # 第一次触发
        actions1 = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf, actor=self.enemy_cf,
            primary_target=self.caster,
        )
        ps1_actions1 = [a for a in actions1 if a.skill_id == 130147]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions1, self.bf, trigger_timing="after_as_attacked"
        )

        # 第二次触发（PS1在冷却中）
        actions2 = self.ts.trigger_after_as_attacked(
            targets=[self.caster], battlefield=self.bf, actor=self.enemy_cf,
            primary_target=self.caster,
        )
        ps1_actions2 = [a for a in actions2 if a.skill_id == 130147]
        self.assertEqual(len(ps1_actions2), 0,
                         "PS1在冷却中 → 不应再次触发")

