    def test_ps2_block3_remove_kouryo_when_count_2(self):
        """PS2(130148) Block3: 高揚mark>=2时 remove_mark(高揚, remove_all=true)。

        场景：敌方中前预设2个高揚mark → Block3执行 remove_mark。
        """
