"""
角色361215 惨禍：一条白奈 专项测试（同名己方参考 104301 純白のラッキーガール）
- EX:  210118 薄暮の宵火（敵横一列伤害 + 自身最大HP×2.8%/4%/5%盾 + 每行动-25%衰减）
- AS1: 220414 クールスラッシュ・トリプル（3hit伤害 + dmg_dealt_down 25% + dmg_taken_up 25%, duration_owner=caster, 可叠加）
- AS2: 220415 バックエイムファイア+（敌单体伤害; Lv5+ 自身获得ATK×value%盾, 3行动）
- PS1: 230435 スマートバリア+（on_hp_below 50%, 自身を含む水属性友方 dmg_taken_down dmg%, 可多次触发）
- PS2: 230436 セカンドライン・セーブ+（on_turn_start, 自身 2次物理减伤value%; Lv5+ 最远敌人3行动炎上, 可多次触发）

角色信息:
- 角色: 惨禍：一条白奈（敌方）/ 純白のラッキーガール（己方）
- 属性: 2 (水/スマート), 类型: 1 (物理), 站位: 2 (中前), 定位: 坦克
- 技能: 210118, 220414, 220415, 230435, 230436
- 站位: Enemy2MasterId -> ENEMY_CENTER_FRONT
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
SHIELD = SkillEffectType.SHIELD.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
CONFLAGRATION = SkillEffectType.CONFLAGRATION.value

ENEMY_ID = 361215
SKILLS = [210118, 220414, 220415, 230435, 230436]


class TestActor361215(unittest.TestCase):
    """角色361215 惨禍：一条白奈 专项测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_unit(self, uid, name, side, pos, cid, element, ctype,
                   max_hp, attack, defense, speed, ap=4, pp=4, skills=None):
        return UnitState(
            unit_id=uid, name=name, side=side, position=pos, character_id=cid, level=10,
            element=element, character_type=ctype,
            max_hp=max_hp, current_hp=max_hp,
            attack=attack, defense=defense, speed=speed,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=ap, initial_passive_point=pp, max_extra_point=10,
            current_ap=10, current_pp=10, current_ep=0,
            skills=skills or [], skill_levels={s: 10 for s in (skills or [])},
            skill_cooldowns={},
        )

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 361215 惨禍：一条白奈 (水属性, 物理, 中前坦克)
        self.caster = self._make_unit(
            "enemy_361215", "惨禍：一条白奈", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            ENEMY_ID, 2, 1, max_hp=20000, attack=8000, defense=5000, speed=500,
            skills=SKILLS,
        )

        # 敌方同阵营水属性（应获得 PS1 减伤）
        self.enemy_water = self._make_unit(
            "enemy_water", "敌方水属性", Side.ENEMY, Position.ENEMY_LEFT_BACK,
            999201, 2, 2, max_hp=15000, attack=7000, defense=4000, speed=400,
        )
        # 敌方同阵营火属性（不应获得 PS1 减伤）
        self.enemy_fire = self._make_unit(
            "enemy_fire", "敌方火属性", Side.ENEMY, Position.ENEMY_RIGHT_FRONT,
            999202, 1, 1, max_hp=12000, attack=9000, defense=4500, speed=380,
        )

        # 友方目标（从敌方视角为"敌"）
        self.ally_center_front = self._make_unit(
            "ally_center_front", "友方中前", Side.ALLY, Position.ALLY_CENTER_FRONT,
            999301, 1, 1, max_hp=60000, attack=8000, defense=6000, speed=400,
        )
        self.ally_center_back = self._make_unit(
            "ally_center_back", "友方中后", Side.ALLY, Position.ALLY_CENTER_BACK,
            999302, 2, 1, max_hp=60000, attack=6000, defense=4000, speed=350,
        )
        self.ally_right_back = self._make_unit(
            "ally_right_back", "友方右后", Side.ALLY, Position.ALLY_RIGHT_BACK,
            999303, 3, 1, max_hp=60000, attack=6000, defense=4000, speed=340,
        )
        # 从 ENEMY_CENTER_FRONT 看最远 = ALLY_LEFT_BACK
        self.ally_left_back = self._make_unit(
            "ally_left_back", "友方左后", Side.ALLY, Position.ALLY_LEFT_BACK,
            999304, 4, 2, max_hp=60000, attack=5000, defense=3000, speed=300,
        )

        self.bf.friend_team = [
            self.ally_center_front, self.ally_center_back,
            self.ally_right_back, self.ally_left_back,
        ]
        self.bf.enemy_team = [self.caster, self.enemy_water, self.enemy_fire]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

    # ─── 配置校验 ───

    def test_config_present_and_key_fields(self):
        """5个敌方技能均在 skills.json / skill_effects_hybrid.json 中，关键字段正确"""
        for sid in SKILLS:
            self.assertIsNotNone(self.dl.get_skill_by_id(sid), f"skills.json 缺少 {sid}")
            self.assertIsNotNone(self.dl.get_parsed_skill_data(sid), f"hybrid 缺少 {sid}")

        shield_tag = self.dl.get_skill_by_id(210118).template_tags["shield_pct"]
        self.assertEqual(shield_tag.get_value_at_level(10), 5.0)
        self.assertEqual(shield_tag.get_value_at_level(5), 4.0)
        self.assertEqual(shield_tag.get_value_at_level(1), 2.8)

        h_as2 = self.dl.get_parsed_skill_data(220415)
        blk2 = h_as2["effect_blocks"][1]
        self.assertEqual(blk2["condition"]["value"], 5)
        self.assertEqual(blk2["effects"][0]["target_type"], "self")

        h_ps1 = self.dl.get_parsed_skill_data(230435)
        self.assertEqual(h_ps1["trigger_type"], "on_hp_below")
        self.assertFalse(h_ps1.get("cooldown"), "敌方PS1不应有 cooldown（可多次触发）")

        h_ps2 = self.dl.get_parsed_skill_data(230436)
        self.assertEqual(h_ps2["effect_blocks"][0]["effects"][0]["target_type"], "self")
        self.assertEqual(h_ps2["effect_blocks"][1]["condition"]["value"], 5)
        self.assertFalse(h_ps2.get("cooldown"), "敌方PS2不应有 cooldown（可多次触发）")

    # ─── EX: 210118 薄暮の宵火 ───

    def test_ex_210118_damage_and_self_shield(self):
        """
        EX(210118) 敵横一列伤害（後列優先） + 自身最大HP×5%盾（Lv10）
        验证:
        1. 敌方后排友方受到伤害（後列優先 + enemy_row）
        2. 施法者自身获得shield buff
        3. shield_amount = max_hp × 5% = 1000
        4. shield_decay_pct=25, duration=-1（永续，靠衰减消失）
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=210118, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"], f"EX执行应成功: {result.get('error', '')}")

        # 後列優先：后排友方应受击
        self.assertLess(self.ally_center_back.current_hp, self.ally_center_back.max_hp,
                        "后排友方应受到EX伤害（後列優先）")
        self.assertLess(self.ally_left_back.current_hp, self.ally_left_back.max_hp,
                        "后卫友方应受到EX伤害（後列優先）")

        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertGreater(len(shield_buffs), 0, "caster应获得shield buff")
        shield = shield_buffs[0]

        expected_shield = int(self.caster.max_hp * 5.0 / 100)  # 20000 * 5% = 1000
        self.assertEqual(shield.shield_amount, expected_shield,
                         f"shield_amount应为max_hp×5%={expected_shield}, 实际: {shield.shield_amount}")
        self.assertEqual(shield.shield_decay_pct, 25,
                         f"shield_decay_pct应为25, 实际: {shield.shield_decay_pct}")
        self.assertEqual(shield.initial_shield_value, expected_shield,
                         f"initial_shield_value应为{expected_shield}, 实际: {shield.initial_shield_value}")
        self.assertEqual(shield.duration, -1,
                         f"shield duration应为-1(永续), 实际: {shield.duration}")
        self.assertGreater(self.caster.shield, 0, "caster.shield应大于0")

    def test_ex_210118_shield_pct_by_level(self):
        """EX(210118) Lv5=4% / Lv1=2.8%"""
        for lv, pct in [(5, 4.0), (1, 2.8)]:
            self.caster.skill_levels[210118] = lv
            self.caster.buffs = []
            self.caster.shield = 0
            self.ss.execute_skill(
                caster=self.caster, skill_id=210118, battlefield=self.bf, skip_cost=True
            )
            shields = [b for b in self.caster.buffs if b.effect_type == SHIELD]
            self.assertGreater(len(shields), 0, f"Lv{lv}应获得盾")
            expected = int(self.caster.max_hp * pct / 100)
            self.assertEqual(shields[0].shield_amount, expected,
                             f"Lv{lv} shield应为max_hp×{pct}%={expected}, 实际: {shields[0].shield_amount}")

    def test_ex_210118_shield_decay_per_action(self):
        """EX(210118) 施法当次行动豁免，之后每行动-25%初始值"""
        self.ss.execute_skill(
            caster=self.caster, skill_id=210118, battlefield=self.bf, skip_cost=True
        )
        shields = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertGreater(len(shields), 0)
        initial_amount = shields[0].shield_amount
        expected_decay = int(initial_amount * 25 / 100)

        # 第1次：当次行动 → 跳过
        self.aus.process_shield_decay(self.caster)
        shields_after = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertEqual(shields_after[0].shield_amount, initial_amount,
                         "首次（施法当次行动）应豁免衰减")

        # 第2次：正常衰减
        self.aus.process_shield_decay(self.caster)
        shields_after = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        if shields_after:
            self.assertEqual(shields_after[0].shield_amount, initial_amount - expected_decay,
                             "第二次应衰减初始值的25%")

    # ─── AS1: 220414 クールスラッシュ・トリプル ───

    def test_as1_220414_three_hit_damage(self):
        """AS1(220414) 3hit伤害"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220414, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        dmg_effects = [e for e in result.get("effects_applied", [])
                       if e.get("effect_type") == "damage"]
        self.assertGreater(len(dmg_effects), 0, "应有damage效果")
        any_damaged = any(e.current_hp < e.max_hp for e in self.bf.friend_team)
        self.assertTrue(any_damaged, "至少一个友方目标应受到伤害")

    def test_as1_220414_debuffs_duration_owner_caster(self):
        """AS1(220414) dmg_dealt_down 25% + dmg_taken_up 25%, duration_owner=caster, 可叠加"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220414, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        damaged = [e for e in self.bf.friend_team if e.current_hp < e.max_hp]
        self.assertGreater(len(damaged), 0, "应有友方目标受到伤害")
        target = damaged[0]

        dealt = [d for d in target.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dealt), 0,
                           f"目标应有dmg_dealt_down, 实际: {[d.effect_type for d in target.debuffs]}")
        self.assertTrue(dealt[0].is_stackable, "dmg_dealt_down应可叠加")
        self.assertEqual(dealt[0].timing_type, AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
                         "dmg_dealt_down应为DURABLE_SOURCE_MANEUVER_END")

        recv = [d for d in target.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(recv), 0,
                           f"目标应有dmg_taken_up, 实际: {[d.effect_type for d in target.debuffs]}")
        self.assertTrue(recv[0].is_stackable, "dmg_taken_up应可叠加")
        self.assertEqual(recv[0].timing_type, AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
                         "dmg_taken_up应为DURABLE_SOURCE_MANEUVER_END")

    # ─── AS2: 220415 バックエイムファイア+ ───

    def test_as2_220415_lv10_shield_on_self(self):
        """
        AS2(220415) Lv10: 伤害 + 自身获得ATK×100%盾（3行动）
        敌方版盾目标为自身（己方版为最近友方）
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220415, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        any_damaged = any(e.current_hp < e.max_hp for e in self.bf.friend_team)
        self.assertTrue(any_damaged, "应造成伤害")

        shields = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertGreater(len(shields), 0, "施法者自身应获得盾")
        shield = shields[0]
        expected = int(self.caster.attack * 100.0 / 100)  # Lv10 value=100
        self.assertEqual(shield.shield_amount, expected,
                         f"shield应为ATK×100%={expected}, 实际: {shield.shield_amount}")
        self.assertEqual(shield.duration, 3, f"shield duration应为3, 实际: {shield.duration}")

        # 其他敌方单位不应获得此盾
        for other in [self.enemy_water, self.enemy_fire]:
            self.assertEqual([b for b in other.buffs if b.effect_type == SHIELD], [],
                             f"{other.name}不应获得AS2盾")

    def test_as2_220415_lv4_no_shield(self):
        """AS2(220415) Lv4: shield block 未解锁（active_level_min=5），仅伤害"""
        self.caster.skill_levels[220415] = 4
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220415, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        shields = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shields), 0, "Lv4不应获得盾（block需Lv5+）")

    def test_as2_220415_lv5_shield_50_percent(self):
        """AS2(220415) Lv5: value=50 → 自身获得ATK×50%盾"""
        self.caster.skill_levels[220415] = 5
        self.ss.execute_skill(
            caster=self.caster, skill_id=220415, battlefield=self.bf, skip_cost=True
        )
        shields = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertGreater(len(shields), 0, "Lv5应获得盾")
        expected = int(self.caster.attack * 50.0 / 100)
        self.assertEqual(shields[0].shield_amount, expected,
                         f"Lv5 shield应为ATK×50%={expected}, 实际: {shields[0].shield_amount}")

    # ─── PS1: 230435 スマートバリア+ ───

    def test_ps1_230435_triggers_on_hp_below_50(self):
        """PS1(230435) HP≤50%触发"""
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.caster.prev_hp_percent = 100.0
        self.caster.current_pp = 10
        actions = self.ts.trigger_hp_below(self.bf, [self.caster])
        self.assertTrue(any(a.skill_id == 230435 for a in actions), "HP≤50%应触发PS1(230435)")

    def test_ps1_230435_does_not_trigger_above_50(self):
        """PS1(230435) HP>50%不触发"""
        self.caster.current_hp = int(self.caster.max_hp * 0.6)
        self.caster.prev_hp_percent = 100.0
        self.caster.current_pp = 10
        actions = self.ts.trigger_hp_below(self.bf, [self.caster])
        self.assertFalse(any(a.skill_id == 230435 for a in actions), "HP>50%不应触发PS1")

    def test_ps1_230435_only_affects_water_allies(self):
        """
        PS1(230435) 自身を含む水属性(element=2)の味方のみ dmg_taken_down
        验证: caster/水路友方获得；火路友方与对立阵营(ALLY)不获得
        """
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.caster.prev_hp_percent = 100.0
        self.caster.current_pp = 10
        actions = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1 = [a for a in actions if a.skill_id == 230435]
        self.assertGreater(len(ps1), 0, "PS1应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(ps1, self.bf, trigger_timing="on_hp_below")

        caster_buffs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(caster_buffs), 0, "caster(水)应获得dmg_taken_down")
        self.assertTrue(caster_buffs[0].is_stackable)

        water_buffs = [b for b in self.enemy_water.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(water_buffs), 0, "水路友方应获得dmg_taken_down")

        fire_buffs = [b for b in self.enemy_fire.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(fire_buffs), 0, "火路友方不应获得dmg_taken_down")

        for ally in self.bf.friend_team:
            self.assertEqual([b for b in ally.buffs if b.effect_type == RECEIVED_DAMAGE], [],
                             f"对立阵营{ally.name}不应获得dmg_taken_down")

    def test_ps1_230435_can_trigger_multiple_times(self):
        """PS1(230435) 敌方数据无「1度しか発動しない」→ 康复后再次降破50%可再次触发"""
        self.caster.current_pp = 10
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.caster.prev_hp_percent = 100.0
        actions1 = self.ts.trigger_hp_below(self.bf, [self.caster])
        self.assertTrue(any(a.skill_id == 230435 for a in actions1), "第一次应触发")
        self.ss._execute_trigger_actions_inline(
            [a for a in actions1 if a.skill_id == 230435], self.bf, trigger_timing="on_hp_below")

        # 模拟回复至50%以上，再次降至50%以下 → 再次跨越阈值
        self.caster.current_pp = 10
        self.caster.current_hp = int(self.caster.max_hp * 0.6)
        self.caster.prev_hp_percent = 60.0
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        actions2 = self.ts.trigger_hp_below(self.bf, [self.caster])
        self.assertTrue(any(a.skill_id == 230435 for a in actions2),
                        "再次跨越阈值仍应触发（敌方版无仅1次限制）")

    # ─── PS2: 230436 セカンドライン・セーブ+ ───

    def test_ps2_230436_triggers_on_turn_start_and_self_buff(self):
        """
        PS2(230436) on_turn_start：自身获得 2次物理减伤 value%
        验证: attack_limited=2, damage_element=1(物理), timing=DURABLE_WHEN_USED
        """
        self.caster.current_pp = 10
        actions = self.ts.trigger_turn_start(self.bf)
        ps2 = [a for a in actions if a.skill_id == 230436]
        self.assertGreater(len(ps2), 0, "回合开始应触发PS2(230436)")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(ps2, self.bf, trigger_timing="on_turn_start")

        buffs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(buffs), 0, "caster自身应获得减伤")
        buff = buffs[0]
        self.assertEqual(buff.attack_limited, 2, "减伤应 attack_limited=2")
        self.assertEqual(buff.damage_element, 1, "减伤应仅对物理(damage_element=1)")
        self.assertEqual(buff.timing_type, AuraUpdateTiming.DURABLE_WHEN_USED.value,
                         "应为 DURABLE_WHEN_USED(hit类型)")
        self.assertTrue(buff.is_stackable)

        # 敌方版目标为自身（非友方全体）
        for other in [self.enemy_water, self.enemy_fire]:
            self.assertEqual([b for b in other.buffs if b.effect_type == RECEIVED_DAMAGE], [],
                             f"{other.name}不应获得减伤（敌方版仅自身）")

    def test_ps2_230436_lv5plus_burn_on_furthest_ally(self):
        """PS2(230436) Lv5+ 对最远敌人（从ENEMY_CENTER_FRONT看为ALLY_LEFT_BACK）施加3行动炎上"""
        self.caster.current_pp = 10
        actions = self.ts.trigger_turn_start(self.bf)
        ps2 = [a for a in actions if a.skill_id == 230436]
        self.ss._execute_trigger_actions_inline(ps2, self.bf, trigger_timing="on_turn_start")

        burn_targets = [e for e in self.bf.friend_team
                        if any(d.effect_type == CONFLAGRATION for d in e.debuffs)]
        self.assertGreater(len(burn_targets), 0, "Lv10应有敌人获得burn")
        burn_target = burn_targets[0]
        self.assertEqual(burn_target.unit_id, "ally_left_back",
                         f"burn应施加在最远敌方(ally_left_back)，实际: {burn_target.unit_id}")
        burn_debuffs = [d for d in burn_target.debuffs if d.effect_type == CONFLAGRATION]
        self.assertEqual(burn_debuffs[0].duration, 3, "burn duration应为3")

        for e in self.bf.friend_team:
            if e.unit_id != "ally_left_back":
                self.assertEqual([d for d in e.debuffs if d.effect_type == CONFLAGRATION], [],
                                 f"非最远目标{e.name}不应有burn")

    def test_ps2_230436_lv4_no_burn(self):
        """PS2(230436) Lv4：burn block 未解锁（active_level_min=5），无炎上"""
        self.caster.skill_levels[230436] = 4
        self.caster.current_pp = 10
        actions = self.ts.trigger_turn_start(self.bf)
        ps2 = [a for a in actions if a.skill_id == 230436]
        self.ss._execute_trigger_actions_inline(ps2, self.bf, trigger_timing="on_turn_start")
        for e in self.bf.friend_team:
            self.assertEqual([d for d in e.debuffs if d.effect_type == CONFLAGRATION], [],
                             f"Lv4时{e.name}不应有burn")

    def test_ps2_230436_can_trigger_multiple_turns(self):
        """PS2(230436) 敌方数据无「1度しか発動しない」→ 后续回合仍可触发"""
        self.caster.current_pp = 10
        actions1 = self.ts.trigger_turn_start(self.bf)
        self.assertTrue(any(a.skill_id == 230436 for a in actions1), "第一次应触发")
        self.ss._execute_trigger_actions_inline(
            [a for a in actions1 if a.skill_id == 230436], self.bf, trigger_timing="on_turn_start")

        self.caster.current_pp = 10
        actions2 = self.ts.trigger_turn_start(self.bf)
        self.assertTrue(any(a.skill_id == 230436 for a in actions2),
                        "后续回合仍应触发（敌方版无仅1次限制）")


if __name__ == '__main__':
    unittest.main()
