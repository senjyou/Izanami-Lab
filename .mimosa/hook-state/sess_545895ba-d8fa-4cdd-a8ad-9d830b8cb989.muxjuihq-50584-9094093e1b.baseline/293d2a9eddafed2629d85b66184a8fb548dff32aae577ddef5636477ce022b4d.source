"""Generate skill_effects_hybrid.json entries for S6 霞光 (165161363) - 5 skills.
Merges into existing skill_effects_hybrid.json, preserving existing entries.

Skills:
    210098 真・紫影の斬撃 (EX) - enemy_all damage
    220369 紫影の斬撃 (AS) - enemy_all damage + on_crit modify_pp
    220370 ラピッドファイア (AS) - 2 targets 2 hit + on_crit modify_pp
    230391 カウンターショット (PS) - after_as_attacked_ally trigger_attacker damage + on_crit modify_pp
    230393 見切り構え・素 (PS) - before_any_attacked guard + crit_rate_up

Usage:
    python scripts/_import_s6_skill_effects_xiaguang.py
"""
from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HYBRID_JSON = ROOT / "data" / "skill_effects_hybrid.json"
SKILLS_JSON = ROOT / "data" / "skills.json"

# Field-order template matching existing 110059 entry
EFFECT_TEMPLATE = {
    "effect_type": None,
    "target_type": None,
    "target_identifier": None,
    "value": None,
    "value_tag": None,
    "value_source": None,
    "duration": None,
    "duration_type": None,
    "duration_tag": None,
    "hit_count": None,
    "hit_count_tag": None,
    "condition": None,
    "flags": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
}

BLOCK_TEMPLATE = {
    "block_id": 1,
    "condition": None,
    "effects": [],
}

SKILL_TEMPLATE = {
    "skill_id": None,
    "name": None,
    "skill_type": None,
    "resource_cost": None,
    "cooldown": None,
    "cooldown_update_timing": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
    "trigger_type": None,
    "global_condition": None,
    "effect_blocks": [],
    "display_target_priority": None,
    "display_target_range": None,
    "display_target_type": None,
    "parse_status": "manual",
    "parse_notes": [],
}


def make_effect(**kwargs) -> dict:
    """Build an effect dict preserving field order."""
    eff = {k: v for k, v in EFFECT_TEMPLATE.items()}
    for k, v in kwargs.items():
        if k in eff:
            eff[k] = v
        else:
            eff[k] = v
    return eff


def make_block(block_id: int, effects: list, condition=None) -> dict:
    return {
        "block_id": block_id,
        "condition": condition,
        "effects": effects,
    }


def make_skill(**kwargs) -> dict:
    skill = {k: v for k, v in SKILL_TEMPLATE.items()}
    for k, v in kwargs.items():
        if k in skill:
            skill[k] = v
        else:
            skill[k] = v
    return skill


def load_skills_meta() -> dict[int, dict]:
    """Load name/skill_type/resource_cost/cooldown from skills.json."""
    with SKILLS_JSON.open("r", encoding="utf-8") as fh:
        data = json.load(fh)
    out: dict[int, dict] = {}
    for k, v in data.items():
        try:
            sid = int(k)
        except (TypeError, ValueError):
            continue
        out[sid] = v
    return out


def build_xiaguang(skills_meta: dict[int, dict]) -> dict[str, dict]:
    out: dict[str, dict] = {}

    # 210098 真・紫影の斬撃 (EX)
    meta = skills_meta[210098]
    out["210098"] = make_skill(
        skill_id=210098,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type=None,
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_all",
                    value_tag="威力",
                    hit_count=1,
                    flags={"is_en_attack": False},
                ),
            ]),
        ],
        display_target_range=5,
        display_target_type=3,
        parse_notes=["EX: 敵全体に威力ダメージ"],
    )

    # 220369 紫影の斬撃 (AS) - damage + on_crit modify_pp
    meta = skills_meta[220369]
    out["220369"] = make_skill(
        skill_id=220369,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type=None,
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_all",
                    value_tag="威力",
                    hit_count=1,
                    flags={"is_en_attack": False},
                ),
            ]),
            make_block(2, [
                make_effect(
                    effect_type="modify_pp",
                    target_type="self",
                    value=1,
                    flags={},
                ),
            ], condition={"once_per_skill": True}),
        ],
        display_target_range=5,
        display_target_type=3,
        parse_notes=["AS: 敵全体威力ダメージ + on_crit PP+1"],
    )

    # 220370 ラピッドファイア (AS) - 2 targets 2 hits + on_crit modify_pp
    meta = skills_meta[220370]
    out["220370"] = make_skill(
        skill_id=220370,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type=None,
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_single_highest_atk",
                    value_tag="威力",
                    hit_count=2,
                    flags={"is_en_attack": False},
                ),
                make_effect(
                    effect_type="damage",
                    target_type="enemy_single_highest_spd",
                    value_tag="威力",
                    hit_count=2,
                    flags={"is_en_attack": False},
                ),
            ]),
            make_block(2, [
                make_effect(
                    effect_type="modify_pp",
                    target_type="self",
                    value=1,
                    flags={},
                ),
            ], condition={"once_per_skill": True}),
        ],
        display_target_range=None,
        display_target_type=3,
        parse_notes=["AS: Atk最高敵2hit + Spd最高敵2hit + on_crit PP+1"],
    )

    # 230391 カウンターショット (PS) - after_as_attacked_ally + trigger_attacker damage + on_crit modify_pp
    meta = skills_meta[230391]
    out["230391"] = make_skill(
        skill_id=230391,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type="after_as_attacked_ally",
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_single",
                    target_identifier="trigger_attacker",
                    value_tag="威力",
                    hit_count=1,
                    flags={"is_en_attack": False},
                ),
            ]),
            make_block(2, [
                make_effect(
                    effect_type="modify_pp",
                    target_type="self",
                    value=1,
                    flags={},
                ),
            ], condition={"once_per_skill": True}),
        ],
        display_target_range=1,
        display_target_type=3,
        parse_notes=["PS: 被AS攻撃後反撃 trigger_attacker + on_crit PP+1"],
    )

    # 230393 見切り構え・素 (PS) - before_any_attacked guard + crit_rate_up
    meta = skills_meta[230393]
    out["230393"] = make_skill(
        skill_id=230393,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type="before_any_attacked",
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="guard",
                    target_type="self",
                    value_tag="guard",
                    duration=1,
                    duration_type="hit",
                    hit_count=1,
                    flags={"attack_limited": 1},
                ),
                make_effect(
                    effect_type="crit_rate_up",
                    target_type="self",
                    value=1.0,
                    duration=-1,
                    duration_type=None,
                    flags={"value_type": "percent", "stackable": True},
                ),
            ]),
        ],
        display_target_range=1,
        display_target_type=1,
        parse_notes=["PS: 被攻撃前 guard 50% + crit_rate +1% 永久重複可"],
    )

    return out


def main() -> None:
    skills_meta = load_skills_meta()
    new_entries = build_xiaguang(skills_meta)
    print(f"[INFO] Built {len(new_entries)} 霞光 skill entries")

    with HYBRID_JSON.open("r", encoding="utf-8") as fh:
        hybrid = json.load(fh)
    print(f"[INFO] Loaded {len(hybrid)} existing skill_effects_hybrid.json entries")

    added: list[int] = []
    skipped: list[int] = []
    for sid_str, entry in new_entries.items():
        if sid_str in hybrid:
            skipped.append(int(sid_str))
            continue
        hybrid[sid_str] = entry
        added.append(int(sid_str))

    print(f"[INFO] Added: {added}")
    if skipped:
        print(f"[INFO] Skipped (already present): {skipped}")

    with HYBRID_JSON.open("w", encoding="utf-8") as fh:
        json.dump(hybrid, fh, ensure_ascii=False, indent=2)
    print(f"[OK] Wrote {HYBRID_JSON}")


if __name__ == "__main__":
    main()
