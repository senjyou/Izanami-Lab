#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""Fix character 133301 skill configurations in skill_effects_hybrid.json"""

import json
import copy

HYBRID_PATH = r"f:\MGG\muv_luv_girlsgardenx_cl\MGGBattleSimulation\data\skill_effects_hybrid.json"

with open(HYBRID_PATH, 'r', encoding='utf-8') as f:
    data = json.load(f)

# ============================================================
# 110031: 宝刀・皆琉神威 (EX)
# Fix: hit_count=5, remove duplicate stun effect, add Lv11+ dmg_taken_down
# ============================================================
block1_effects = data["110031"]["effect_blocks"][0]["effects"]
# Remove the redundant "stun" effect (third effect)
data["110031"]["effect_blocks"][0]["effects"] = [e for e in block1_effects if e["effect_type"] != "stun"]
# Set hit_count=5 on damage effect
for e in data["110031"]["effect_blocks"][0]["effects"]:
    if e["effect_type"] == "damage":
        e["hit_count"] = 5

# Add Lv11+ block: dmg_taken_down
data["110031"]["effect_blocks"].append({
    "block_id": 2,
    "level_min": 11,
    "condition": None,
    "effects": [
        {
            "effect_type": "dmg_taken_down",
            "target_type": "self",
            "target_identifier": None,
            "value": 0.0,
            "value_tag": "dmg",
            "value_source": None,
            "duration": -1,
            "duration_type": None,
            "duration_tag": None,
            "hit_count": None,
            "hit_count_tag": None,
            "condition": None,
            "flags": {
                "value_type": "percent",
                "stackable": True
            },
            "ignore_defense": 0,
            "ignore_shield": 0
        }
    ]
})

print("✓ 110031: hit_count=5, removed duplicate stun, added Lv11+ dmg_taken_down")

# ============================================================
# 120072: 己が為の刃に非ず (AS)
# Already correct: damage + spd_down + dmg_dealt_down
# ============================================================
print("✓ 120072: already correct (damage + spd_down + dmg_dealt_down)")

# ============================================================
# 120073: 牙無き者の為たれ (AS)
# Fix: replace heal with lifesteal, fix atk_up target_type to self
# ============================================================
block1_effects_120073 = data["120073"]["effect_blocks"][0]["effects"]
new_effects = []
for e in block1_effects_120073:
    if e["effect_type"] == "heal":
        # Replace heal with lifesteal
        new_effects.append({
            "effect_type": "lifesteal",
            "target_type": "self",
            "target_identifier": None,
            "value": 0.0,
            "value_tag": "cure",
            "value_source": None,
            "duration": None,
            "duration_type": None,
            "duration_tag": None,
            "hit_count": None,
            "hit_count_tag": None,
            "condition": None,
            "flags": {},
            "ignore_defense": 0,
            "ignore_shield": 0
        })
    elif e["effect_type"] == "atk_up":
        # Fix target_type to self
        e["target_type"] = "self"
        new_effects.append(e)
    else:
        new_effects.append(e)
data["120073"]["effect_blocks"][0]["effects"] = new_effects

print("✓ 120073: replaced heal with lifesteal(cure), fixed atk_up target to self")

