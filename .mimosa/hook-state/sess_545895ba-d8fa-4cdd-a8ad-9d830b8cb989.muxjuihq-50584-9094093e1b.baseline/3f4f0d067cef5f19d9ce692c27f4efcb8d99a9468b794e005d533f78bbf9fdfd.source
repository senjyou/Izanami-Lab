    def _add_test_buff(self, unit, buff_name, effect_type="AtkUp"):
        """添加测试用buff到unit.buffs列表"""
        buff = BuffState(
            buff_id=f"{unit.unit_id}_{buff_name}_{len(unit.buffs)}",
            name=buff_name,
            effect_type=effect_type,
            value=10.0,
            duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="test",
            source_skill_id=0,
            caster_attack=0,
            is_debuff=False,
        )
        unit.buffs.append(buff)
        return buff

    def _add_test_debuff(self, unit, debuff_name, effect_type="Poison"):
        """添加测试用debuff到unit.debuffs列表"""
        debuff = BuffState(
            buff_id=f"{unit.unit_id}_{debuff_name}_{len(unit.debuffs)}",
            name=debuff_name,
            effect_type=effect_type,
            value=10.0,
            duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="test",
            source_skill_id=0,
            caster_attack=0,
            is_debuff=True,
        )
        unit.debuffs.append(debuff)
        return debuff

    # ==================== EX 110023 チェックメイト ====================

    def test_ex_damage_and_remove_buff_lifo(self):
        """
        测试EX(110023) Lv10: 敵全体攻撃 + バフ3つ解除(LIFO)
        - 对敌方全体造成伤害
        - 解除每个敌方最多3个buff，采用后施加先移除(LIFO)逻辑
        """
        # 设置skill_level=10（不触发Lv11+ block_specific_aura）
        self.caster.skill_levels[110023] = 10

        # 给enemy_high_atk添加5个buff，验证只移除最后3个(LIFO)
        buff1 = self._add_test_buff(self.enemy_high_atk, "Buff1")
        buff2 = self._add_test_buff(self.enemy_high_atk, "Buff2")
        buff3 = self._add_test_buff(self.enemy_high_atk, "Buff3")
        buff4 = self._add_test_buff(self.enemy_high_atk, "Buff4")
        buff5 = self._add_test_buff(self.enemy_high_atk, "Buff5")

        original_buff_count = len(self.enemy_high_atk.buffs)

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110023,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证enemy_high_atk的buff被移除了3个（LIFO: 移除Buff3, Buff4, Buff5）
        remaining_buff_names = [b.name for b in self.enemy_high_atk.buffs]
        self.assertEqual(
            len(self.enemy_high_atk.buffs), original_buff_count - 3,
            f"应移除3个buff(LIFO)，剩余: {remaining_buff_names}"
        )
        # LIFO: 最早施加的Buff1, Buff2应保留
        self.assertIn("Buff1", remaining_buff_names, f"Buff1应保留(LIFO)，剩余: {remaining_buff_names}")
        self.assertIn("Buff2", remaining_buff_names, f"Buff2应保留(LIFO)，剩余: {remaining_buff_names}")
        # 最后施加的Buff3, Buff4, Buff5应被移除
        self.assertNotIn("Buff3", remaining_buff_names, f"Buff3应被移除(LIFO)，剩余: {remaining_buff_names}")
        self.assertNotIn("Buff4", remaining_buff_names, f"Buff4应被移除(LIFO)，剩余: {remaining_buff_names}")
        self.assertNotIn("Buff5", remaining_buff_names, f"Buff5应被移除(LIFO)，剩余: {remaining_buff_names}")

    def test_ex_lv11_block_specific_aura(self):
        """
        测试EX(110023) Lv15: 味方全体に2行動異常状態無効バフ付与
        - Lv11+应赋予友方全体block_specific_aura buff
        - 该buff应免疫7种异常状态: knockout, conflagration, poison, freeze, darkness, confusion, genwaku
        - block_specific_aura应存储在unit.buffs中（而非debuffs）
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110023,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证caster获得了block_specific_aura buff
        caster_block_buffs = [
            b for b in self.caster.buffs
            if b.effect_type == BLOCK_SPECIFIC_AURA
        ]
        self.assertTrue(
            len(caster_block_buffs) > 0,
            f"caster应获得BlockSpecificAura buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.caster.buffs]}"
        )

        # 验证ally_front也获得了block_specific_aura buff
        ally_block_buffs = [
            b for b in self.ally_front.buffs
            if b.effect_type == BLOCK_SPECIFIC_AURA
        ]
        self.assertTrue(
            len(ally_block_buffs) > 0,
            f"ally_front应获得BlockSpecificAura buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.ally_front.buffs]}"
        )

        # 验证block_status_list包含7种异常状态
        block_buff = caster_block_buffs[0]
        expected_status = {"knockout", "conflagration", "poison", "freeze", "darkness", "confusion", "genwaku"}
        actual_status = set(s.lower() for s in block_buff.block_status_list)
        self.assertEqual(
            actual_status, expected_status,
            f"block_status_list应包含7种异常状态, 实际: {actual_status}"
        )

        # 验证duration=2 (2行動)
        self.assertEqual(
            block_buff.duration, 2,
            f"block_specific_aura duration应为2, 实际: {block_buff.duration}"
        )

    def test_ex_block_specific_aura_immune_to_status_ailments(self):
        """
        测试EX(110023) Lv15的block_specific_aura实际免疫效果
        - 获得block_specific_aura后，尝试施加异常状态应被免疫
        - 测试knockout和genwaku两种代表类型
        """
        # 先执行EX获得block_specific_aura
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110023,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"])

        # 尝试对caster施加眩晕(knockout)
        knockout_aura = BuffState(
            buff_id="test_knockout",
            name="眩晕",
            effect_type=KNOCKOUT,
            value=0,
            duration=2,
            timing_type=AuraUpdateTiming.EPHEMERAL_SKILL_END.value,
            source_unit_id="enemy",
            source_skill_id=0,
            caster_attack=0,
            is_debuff=True,
        )
        # 通过aura_service.add_aura施加，应被免疫
        self.asvc.add_aura(self.caster, knockout_aura)

        # 验证caster没有被施加knockout
        knockout_debuffs = [d for d in self.caster.debuffs if d.effect_type == KNOCKOUT]
        self.assertEqual(
            len(knockout_debuffs), 0,
            f"caster应免疫knockout（因block_specific_aura），"
            f"实际debuffs: {[(d.name, d.effect_type) for d in self.caster.debuffs]}"
        )

        # 尝试对caster施加幻惑(genwaku)，同样应被免疫
        genwaku_aura = BuffState(
            buff_id="test_genwaku",
            name="幻惑",
            effect_type=GENWAKU,
            value=30.0,
            duration=1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="enemy",
            source_skill_id=0,
            caster_attack=0,
            is_debuff=True,
        )
        self.asvc.add_aura(self.caster, genwaku_aura)

        # 验证caster没有被施加genwaku
        genwaku_debuffs = [d for d in self.caster.debuffs if d.effect_type == GENWAKU]
        self.assertEqual(
            len(genwaku_debuffs), 0,
            f"caster应免疫genwaku（因block_specific_aura），"
            f"实际debuffs: {[(d.name, d.effect_type) for d in self.caster.debuffs]}"
        )

    # ==================== AS1 120057 ストライクリリース ====================

    def test_as1_atk_down_single_target(self):
        """
        测试AS1(120057): 敵単体の攻撃力を1行動の間低下させる
        - 对敌方单体施加atk_down debuff
        - duration=1 (1行動)
        - value_type=percent
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120057,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # 验证目标获得了atk_down debuff
        # AS1目标为enemy_single，应选择最近的敌方
        all_enemies = [self.enemy_high_atk, self.enemy_low_atk, self.enemy_back]
        enemies_with_atk_down = [
            e for e in all_enemies
            if any(d.effect_type == ATK_DOWN for d in e.debuffs)
        ]
        self.assertEqual(
            len(enemies_with_atk_down), 1,
            f"应只有1个敌方获得atk_down, "
            f"实际: {[(e.name, [d.effect_type for d in e.debuffs]) for e in all_enemies]}"
        )

        # 验证duration=1
        target = enemies_with_atk_down[0]
        atk_down_debuff = [d for d in target.debuffs if d.effect_type == ATK_DOWN][0]
        self.assertEqual(
            atk_down_debuff.duration, 1,
            f"atk_down duration应为1, 实际: {atk_down_debuff.duration}"
        )

    # ==================== AS2 120058 スキュア ====================

    def test_as2_targets_highest_atk_enemy(self):
        """
        测试AS2(120058) Lv10: 攻撃力が最も高い敵単体に攻撃
        - target_type=enemy_single_highest_atk
        - 应选择attack=20000的enemy_high_atk
        """
        self.caster.skill_levels[120058] = 10

        enemy_high_atk_hp_before = self.enemy_high_atk.current_hp
        enemy_low_atk_hp_before = self.enemy_low_atk.current_hp

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120058,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS2技能执行应成功: {result.get('error', '')}")

        # 验证enemy_high_atk受到了伤害
        self.assertLess(
            self.enemy_high_atk.current_hp, enemy_high_atk_hp_before,
            f"enemy_high_atk(最高ATK)应受到伤害, "
            f"HP: {enemy_high_atk_hp_before} -> {self.enemy_high_atk.current_hp}"
        )
        # 验证enemy_low_atk没有受到伤害
        self.assertEqual(
            self.enemy_low_atk.current_hp, enemy_low_atk_hp_before,
            f"enemy_low_atk不应受到伤害, "
            f"HP: {enemy_low_atk_hp_before} -> {self.enemy_low_atk.current_hp}"
        )

    def test_as2_lv11_permanent_atk_down_and_def_up(self):
        """
        测试AS2(120058) Lv15: 永続atk_down + 永続def_up（平衡措施）
        - Lv11+应同时施加atk_down和def_up
        - duration=-1（永続）
        - stackable=true
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120058,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS2技能执行应成功: {result.get('error', '')}")

        # 验证enemy_high_atk获得了atk_down debuff
        atk_down_debuffs = [d for d in self.enemy_high_atk.debuffs if d.effect_type == ATK_DOWN]
        self.assertTrue(
            len(atk_down_debuffs) > 0,
            f"enemy_high_atk应获得atk_down debuff, "
            f"实际debuffs: {[(d.name, d.effect_type) for d in self.enemy_high_atk.debuffs]}"
        )

        # 验证atk_down duration=-1（永続）
        self.assertEqual(
            atk_down_debuffs[0].duration, -1,
            f"atk_down应为永続(duration=-1), 实际: {atk_down_debuffs[0].duration}"
        )

        # 验证enemy_high_atk获得了def_up buff（平衡措施）
        def_up_buffs = [b for b in self.enemy_high_atk.buffs if b.effect_type == DEF_UP]
        self.assertTrue(
            len(def_up_buffs) > 0,
            f"enemy_high_atk应获得def_up buff（平衡措施）, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.enemy_high_atk.buffs]}"
        )

        # 验证def_up duration=-1（永続）
        self.assertEqual(
            def_up_buffs[0].duration, -1,
            f"def_up应为永続(duration=-1), 实际: {def_up_buffs[0].duration}"
        )

    # ==================== AS3 120059 インクリメントアタック ====================

    def test_as3_conditional_power_bonus_with_debuff(self):
        """
        测试AS3(120059) Lv10: 対象にデバフがかけられていた場合ダメージ増加
        - 目标有debuff时，conditional_power_bonus(target_has_debuff)应触发
        - bonus_type=power, value_tag=dmg
        """
        self.caster.skill_levels[120059] = 10

        # 给enemy_high_atk添加一个debuff
        self._add_test_debuff(self.enemy_high_atk, "TestPoison", POISON)

        hp_before = self.enemy_high_atk.current_hp

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120059,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS3技能执行应成功: {result.get('error', '')}")

        # 验证enemy_high_atk受到了伤害（有debuff时增伤）
        self.assertLess(
            self.enemy_high_atk.current_hp, hp_before,
            f"enemy_high_atk(有debuff)应受到增伤伤害, "
            f"HP: {hp_before} -> {self.enemy_high_atk.current_hp}"
        )

    def test_as3_no_bonus_without_debuff(self):
        """
        测试AS3(120059) Lv10: 目标无debuff时不触发增伤
        - 目标无debuff时，conditional_power_bonus不触发，正常伤害
        """
        self.caster.skill_levels[120059] = 10

        # 确保enemy_high_atk没有debuff
        self.enemy_high_atk.debuffs.clear()

        hp_before = self.enemy_high_atk.current_hp

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120059,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS3技能执行应成功: {result.get('error', '')}")

        # 验证enemy_high_atk受到了伤害（无增伤的基础伤害）
        self.assertLess(
            self.enemy_high_atk.current_hp, hp_before,
            f"enemy_high_atk(无debuff)应受到基础伤害, "
            f"HP: {hp_before} -> {self.enemy_high_atk.current_hp}"
        )

    def test_as3_lv11_remove_buff(self):
        """
        测试AS3(120059) Lv15: Lv11+ バフ1つ解除(LIFO)
        - Lv11+应解除目标1个buff
        """
        # 给enemy_high_atk添加2个buff，验证只移除最后1个(LIFO)
        self._add_test_buff(self.enemy_high_atk, "KeepBuff")
        self._add_test_buff(self.enemy_high_atk, "RemoveBuff")

        original_count = len(self.enemy_high_atk.buffs)

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120059,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS3技能执行应成功: {result.get('error', '')}")

        # 验证只移除了1个buff
        self.assertEqual(
            len(self.enemy_high_atk.buffs), original_count - 1,
            f"应移除1个buff(LIFO), 原有{original_count}个, 剩余{len(self.enemy_high_atk.buffs)}个"
        )

        # LIFO: 最后施加的RemoveBuff应被移除，KeepBuff应保留
        remaining_names = [b.name for b in self.enemy_high_atk.buffs]
        self.assertIn("KeepBuff", remaining_names, f"KeepBuff应保留, 剩余: {remaining_names}")
        self.assertNotIn("RemoveBuff", remaining_names, f"RemoveBuff应被移除, 剩余: {remaining_names}")

    def test_as3_remove_buff_after_as2_def_up(self):
        """
        测试AS3(120059) Lv15: 解除AS2(120058)施加的def_up buff
        - 先施放AS2对敌方施加def_up buff（平衡措施）
        - 再施放AS3，remove_buff应解除该def_up buff
        - 验证def_up被正确存储在buffs中（而非debuffs）
        """
        # Step 1: 施放AS2，对敌方施加atk_down debuff + def_up buff
        result_as2 = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120058,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result_as2["success"], f"AS2技能执行应成功: {result_as2.get('error', '')}")

        # 验证AS2施加了def_up buff（在buffs中，不是debuffs）
        def_up_buffs = [b for b in self.enemy_high_atk.buffs if b.effect_type == DEF_UP]
        self.assertTrue(
            len(def_up_buffs) > 0,
            f"AS2应在enemy_high_atk的buffs中施加def_up, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.enemy_high_atk.buffs]}"
        )

        # Step 2: 施放AS3，remove_buff应解除def_up buff
        result_as3 = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120059,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result_as3["success"], f"AS3技能执行应成功: {result_as3.get('error', '')}")

        # 验证def_up buff已被移除
        def_up_buffs_after = [b for b in self.enemy_high_atk.buffs if b.effect_type == DEF_UP]
        self.assertEqual(
            len(def_up_buffs_after), 0,
            f"AS3的remove_buff应移除def_up buff, "
            f"剩余buffs: {[(b.name, b.effect_type) for b in self.enemy_high_atk.buffs]}"
        )

    # ==================== PS1 130065 アフターシェイブ ====================

    def test_ps1_not_triggered_on_round_1(self):
        """
        测试PS1(130065): 1ターン目には発動しない
        - global_condition: round_number > 1
        - turn_number=1时不应触发
        """
        self.bf.turn_number = 1

        # 确保caster有PP
        self.caster.current_pp = 10

        # 触发on_turn_end
        trigger_actions = self.ts.trigger_turn_end(self.bf)

        # 验证PS1(130065)没有触发
        ps1_triggered = any(a.skill_id == 130065 for a in trigger_actions)
        self.assertFalse(
            ps1_triggered,
            f"PS1(130065)在1ターン目不应触发, trigger_actions: {[(a.skill_id) for a in trigger_actions]}"
        )

    def test_ps1_triggered_on_round_2_with_atk_down_and_remove_ep(self):
        """
        测试PS1(130065): 2ターン目以降発動 + 永続atk_down + EP削除1
        - turn_number=2时应触发
        - 应施加永続atk_down(duration=-1)
        - 应削除目标1点EP
        """
        self.bf.turn_number = 2

        # 确保caster有PP
        self.caster.current_pp = 10

        # 记录目标EP（PS1目标为enemy_single，最近敌方）
        all_enemies = [self.enemy_high_atk, self.enemy_low_atk, self.enemy_back]
        ep_before = {e.unit_id: e.current_ep for e in all_enemies}

        # 触发on_turn_end
        trigger_actions = self.ts.trigger_turn_end(self.bf)

        # 验证PS1(130065)触发了
        ps1_triggered = any(a.skill_id == 130065 for a in trigger_actions)
        self.assertTrue(
            ps1_triggered,
            f"PS1(130065)在2ターン目应触发, trigger_actions: {[(a.skill_id) for a in trigger_actions]}"
        )

        # 执行触发动作
        if ps1_triggered:
            self.ss._execute_trigger_actions_inline(
                [a for a in trigger_actions if a.skill_id == 130065],
                self.bf, trigger_timing="on_turn_end"
            )

        # 验证某个敌方获得了atk_down debuff（永続）
        enemies_with_atk_down = [
            e for e in all_enemies
            if any(d.effect_type == ATK_DOWN for d in e.debuffs)
        ]
        self.assertTrue(
            len(enemies_with_atk_down) > 0,
            f"应有敌方获得atk_down, "
            f"实际: {[(e.name, [d.effect_type for d in e.debuffs]) for e in all_enemies]}"
        )

        # 验证atk_down duration=-1（永続）
        target = enemies_with_atk_down[0]
        atk_down_debuff = [d for d in target.debuffs if d.effect_type == ATK_DOWN][0]
        self.assertEqual(
            atk_down_debuff.duration, -1,
            f"atk_down应为永続(duration=-1), 实际: {atk_down_debuff.duration}"
        )

        # 验证目标EP被削除了1点
        ep_after = {e.unit_id: e.current_ep for e in all_enemies}
        ep_reduced = [
            e for e in all_enemies
            if ep_after[e.unit_id] < ep_before[e.unit_id]
        ]
        self.assertTrue(
            len(ep_reduced) > 0,
            f"应有敌方EP被削除1点, "
            f"EP变化: {[(e.name, ep_before[e.unit_id], ep_after[e.unit_id]) for e in all_enemies]}"
        )

        # 验证EP削除量为1
        for e in ep_reduced:
            reduction = ep_before[e.unit_id] - ep_after[e.unit_id]
            self.assertEqual(
                reduction, 1,
                f"{e.name}的EP削除量应为1, 实际: {reduction}"
            )

    # ─── 补充测试：未覆盖的关键机制 ───

    def test_as2_lv10_no_atk_down_def_up(self):
        """AS2(120058) Lv10: level_min=11 gating, 不施加atk_down/def_up"""
        self.caster.skill_levels[120058] = 10
        # 清空目标debuffs
        self.enemy_high_atk.debuffs.clear()
        self.enemy_high_atk.buffs.clear()

        self.ss.execute_skill(
            caster=self.caster, skill_id=120058, battlefield=self.bf, skip_cost=True
        )

        # Lv10 时 level_min=11 effect 应被跳过
        atk_downs = [d for d in self.enemy_high_atk.debuffs if d.effect_type == ATK_DOWN]
        def_ups = [b for b in self.enemy_high_atk.buffs if b.effect_type == DEF_UP]
        self.assertEqual(len(atk_downs), 0, "Lv10 不应施加 atk_down")
        self.assertEqual(len(def_ups), 0, "Lv10 不应施加 def_up")

    def test_as2_atk_down_def_up_same_target_as_damage(self):
        """AS2(120058) 同block共享索敌缓存：damage+atk_down+def_up作用于同一highest_atk目标"""
        self.caster.skill_levels[120058] = 15
        # 清空所有敌方状态
        for e in [self.enemy_high_atk, self.enemy_low_atk, self.enemy_back]:
            e.debuffs.clear()
            e.buffs.clear()

        hp_high_before = self.enemy_high_atk.current_hp
        hp_low_before = self.enemy_low_atk.current_hp

        self.ss.execute_skill(
            caster=self.caster, skill_id=120058, battlefield=self.bf, skip_cost=True
        )

        # damage 应命中 highest_atk（enemy_high_atk）
        self.assertLess(self.enemy_high_atk.current_hp, hp_high_before,
                        "damage 应命中 highest_atk 敌")
        # atk_down/def_up 应在同一目标上
        self.assertTrue(any(d.effect_type == ATK_DOWN for d in self.enemy_high_atk.debuffs),
                        "atk_down 应与 damage 同目标（共享索敌缓存）")
        self.assertTrue(any(b.effect_type == DEF_UP for b in self.enemy_high_atk.buffs),
                        "def_up 应与 damage 同目标（共享索敌缓存）")
        # low_atk 不应受影响
        self.assertEqual(self.enemy_low_atk.current_hp, hp_low_before,
                         "非 highest_atk 敌不应受伤害")

    def test_as2_atk_down_stackable(self):
        """AS2(120058) atk_down stackable=true 可叠加"""
        self.caster.skill_levels[120058] = 15
        self.enemy_high_atk.debuffs.clear()

        # 第一次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=120058, battlefield=self.bf, skip_cost=True
        )
        debuffs_1 = [d for d in self.enemy_high_atk.debuffs if d.effect_type == ATK_DOWN]

        # 重置冷却
        self.caster.skill_cooldowns.pop(120058, None)
        # 第二次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=120058, battlefield=self.bf, skip_cost=True
        )
        debuffs_2 = [d for d in self.enemy_high_atk.debuffs if d.effect_type == ATK_DOWN]

        self.assertGreater(len(debuffs_2), len(debuffs_1),
                           f"stackable=true atk_down 应可叠加, 第一次={len(debuffs_1)}, 第二次={len(debuffs_2)}")

    def test_ex_remove_buff_lifo_targeting_correct_buff(self):
        """EX(110023) remove_buff LIFO: 移除最后施加的3个buff（验证LIFO顺序）"""
        # 给 enemy_high_atk 依次添加5个不同名字的buff
        names = ["Buff1", "Buff2", "Buff3", "Buff4", "Buff5"]
        for n in names:
            self._add_test_buff(self.enemy_high_atk, n)

        # 只在 enemy_high_atk 上有buff（其他敌方无buff）
        self.enemy_low_atk.buffs.clear()
        self.enemy_back.buffs.clear()

        # EX 应移除最后3个（Buff3, Buff4, Buff5）
        self.ss.execute_skill(
            caster=self.caster, skill_id=110023, battlefield=self.bf, skip_cost=True
        )

        # 验证剩下的是 Buff1, Buff2（前2个）
        remaining_names = [b.name for b in self.enemy_high_atk.buffs]
        self.assertEqual(remaining_names, ["Buff1", "Buff2"],
                         f"LIFO应移除最后3个, 剩余: {remaining_names}")

    def test_ex_remove_buff_less_than_count(self):
        """EX(110023) remove_buff: 目标buff数<3时全部移除"""
        # 只给 enemy_high_atk 2个buff
        self._add_test_buff(self.enemy_high_atk, "Only1")
        self._add_test_buff(self.enemy_high_atk, "Only2")
        self.enemy_low_atk.buffs.clear()
        self.enemy_back.buffs.clear()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110023, battlefield=self.bf, skip_cost=True
        )

        # 应该全部被移除
        self.assertEqual(len(self.enemy_high_atk.buffs), 0,
                         "目标buff数<3时应全部移除")

    def test_ps1_atk_down_stacks_across_rounds(self):
        """PS1(130065) atk_down stackable 跨回合叠加"""
        self.bf.turn_number = 2
        self.caster.current_pp = 10

        # 第一次触发（回合2）
        actions1 = self.ts.trigger_turn_end(self.bf)
        if any(a.skill_id == 130065 for a in actions1):
            self.ss._execute_trigger_actions_inline(
                [a for a in actions1 if a.skill_id == 130065],
                self.bf, trigger_timing="on_turn_end"
            )
        atk_downs_r2 = [d for e in self.bf.enemy_team for d in e.debuffs if d.effect_type == ATK_DOWN]

        # 第二次触发（回合3）
        self.bf.turn_number = 3
        self.caster.skill_cooldowns.pop(130065, None)
        actions2 = self.ts.trigger_turn_end(self.bf)
        if any(a.skill_id == 130065 for a in actions2):
            self.ss._execute_trigger_actions_inline(
                [a for a in actions2 if a.skill_id == 130065],
                self.bf, trigger_timing="on_turn_end"
            )
        atk_downs_r3 = [d for e in self.bf.enemy_team for d in e.debuffs if d.effect_type == ATK_DOWN]

        # stackable=true，回合3后 atk_down 数量应大于回合2
        self.assertGreater(len(atk_downs_r3), len(atk_downs_r2),
                           f"PS1 atk_down 应跨回合叠加, 回合2={len(atk_downs_r2)}, 回合3={len(atk_downs_r3)}")

    def test_as3_lv10_no_remove_buff(self):
        """AS3(120059) Lv10: 不执行 remove_buff（level_min=11 gating）"""
        self.caster.skill_levels[120059] = 10
        # 给目标2个buff
        self._add_test_buff(self.enemy_high_atk, "Keep1")
        self._add_test_buff(self.enemy_high_atk, "Keep2")
        original_count = len(self.enemy_high_atk.buffs)

        self.ss.execute_skill(
            caster=self.caster, skill_id=120059, battlefield=self.bf, skip_cost=True
        )

        # Lv10 时 Block2 (Lv11+) 应被跳过，buff 数量不变
        self.assertEqual(len(self.enemy_high_atk.buffs), original_count,
                         "Lv10 不应执行 remove_buff")


if __name__ == "__main__":
    unittest.main(verbosity=2)
