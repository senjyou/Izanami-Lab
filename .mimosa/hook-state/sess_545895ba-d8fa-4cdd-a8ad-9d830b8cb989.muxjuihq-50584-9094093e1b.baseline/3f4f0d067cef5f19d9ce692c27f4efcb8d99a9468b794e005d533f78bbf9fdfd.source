            position=Position.ALLY_CENTER_BACK, character_id=131301, level=15,
            element=1, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=12000, defense=5000, speed=600,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=100,
            skills=[110023, 120057, 120058, 120059, 130065],
            skill_levels={110023: 15, 120057: 15, 120058: 15, 120059: 15, 130065: 15},
            skill_cooldowns={},
        )

        # 友方前排（用于测试EX的ally_all block_specific_aura）
        self.ally_front = UnitState(
            unit_id="ally_front", name="友方前排", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999100, level=15,
            element=1, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央（攻击力最高，用于AS2测试）
        self.enemy_high_atk = UnitState(
            unit_id="enemy_high_atk", name="敵A(高ATK前列)", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=15,
            element=2, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=20000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=100,
            current_ap=4, current_pp=4, current_ep=10,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排左（低攻击力）
        self.enemy_low_atk = UnitState(
            unit_id="enemy_low_atk", name="敵B(低ATK前列)", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999002, level=15,
            element=2, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=5000, defense=3000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=100,
            current_ap=4, current_pp=4, current_ep=10,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方后排（用于测试全体攻击）
        self.enemy_back = UnitState(
            unit_id="enemy_back", name="敵C(後列)", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=999003, level=15,
            element=2, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=8000, defense=3000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=100,
