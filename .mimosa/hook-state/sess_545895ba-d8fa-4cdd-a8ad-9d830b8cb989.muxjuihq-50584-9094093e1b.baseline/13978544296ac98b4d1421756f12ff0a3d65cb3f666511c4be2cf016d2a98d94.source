"""_apply_damage核心路径单元测试。

测试目标：
1. DamageService.calculate_damage 核心伤害公式
   - 暴击/非暴击/force_crit/cannot_crit
   - 穿防（penetrate_defense buff / skill ignore_defense）
   - 属性克制（advantage_damage）
   - HP缩放（hp_scaling_bonus）
   - skill_power_down
   - 混乱（confusion proxy + dmg_reduction）
   - 多hit
   - 最低1点伤害（base_diff下限）

2. SkillService._apply_damage 关键分支
   - 护盾吸收（shield/en_shield/physical_shield）
   - 盾穿透（ignore_shield）
   - 子单位吸收（sub_unit）
   - HP扣减 + 累计伤害（cumulative_hp_damage）
   - 闪避（evade）
   - OVERKILL路径
   - 最低1点伤害作用于盾
"""
import sys
import os
import math
import pytest
from types import SimpleNamespace
from unittest.mock import MagicMock

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..', 'src'))

from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.damage_service import DamageService, DamageResult
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.trigger_service import TriggerService
from src.data.data_loader import DataLoader


# ─── 工厂函数 ──────────────────────────────────────────────

def make_unit(unit_id="u1", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT,
              hp=50000, max_hp=50000, atk=10000, defense=5000, speed=500,
              element=2, character_type=1, crit_rate=0.0, crit_damage=0.5,
              advantage_damage=0.0):
    """创建测试用单位。"""
    return UnitState(
        unit_id=unit_id, name=unit_id, side=side, position=position,
        character_id=999901, level=10, element=element, character_type=character_type,
        max_hp=max_hp, attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=advantage_damage,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_hp=hp, current_ap=10, current_pp=10, current_ep=10,
    )


def make_buff(name="b", effect_type="atk_up", value=10.0, duration=-1,
              value_tag=0, is_stackable=False, is_memory_buff=False,
              hit_limited=0, attack_limited=0, is_debuff=False, **extra):
    """创建测试用buff/debuff。"""
    kwargs = dict(
        buff_id=f"{name}_{id(object())}", name=name, effect_type=effect_type,
        value=value, duration=duration, timing_type=2, value_tag=value_tag,
        is_stackable=is_stackable, is_memory_buff=is_memory_buff,
        hit_limited=hit_limited, attack_limited=attack_limited,
        is_debuff=is_debuff,
    )
    kwargs.update(extra)
    return BuffState(**kwargs)


def make_skill(power=100, hit_count=1, element=None, ignore_defense=0,
               ignore_shield=0, hp_scaling_bonus=0, bonus_crit_rate=0,
               force_crit=False, cannot_crit=False, base_value_source=None,
               skill_id=99999, name="test_skill"):
    """创建测试用skill_data对象。"""
    return SimpleNamespace(
        skill_id=skill_id, name=name, power=power, hit_count=hit_count,
        element=element, ignore_defense=ignore_defense, ignore_shield=ignore_shield,
        hp_scaling_bonus=hp_scaling_bonus, bonus_crit_rate=bonus_crit_rate,
        force_crit=force_crit, cannot_crit=cannot_crit,
        base_value_source=base_value_source,
    )


# ─── DamageService.calculate_damage 公式测试 ──────────────

class TestCalculateDamageBasic:
    """基础伤害公式测试。"""

    def test_basic_damage_non_crit(self):
        """非暴击基础伤害：(ATK-DEF) * power% = (10000-5000) * 1.0 = 5000。"""
        attacker = make_unit("atk", atk=10000)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.clear_crit_override()
        # 强制不暴击
        attacker_id = attacker.unit_id

        def _nocrit(ctx):
            return False
        dms.set_crit_override(_nocrit)

        skill = make_skill(power=100, hit_count=1)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage == 5000
        assert result.is_critical is False
        assert len(result.hit_details) == 1
        assert result.hit_details[0] == 5000

    def test_basic_damage_with_power_50(self):
        """威力50%：(10000-5000) * 0.5 = 2500。"""
        attacker = make_unit("atk", atk=10000)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=50, hit_count=1)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage == 2500

    def test_atk_le_def_returns_min_1(self):
        """ATK <= DEF时base_diff下限为1，最终伤害≥1。"""
        attacker = make_unit("atk", atk=1000)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage >= 1
        # base_diff=max(1, 1000-5000)=1，最终伤害=1
        assert result.total_damage == 1

    def test_multi_hit_sums(self):
        """多hit伤害累加（3 hit, 非暴击）。"""
        attacker = make_unit("atk", atk=10000)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=3)
        result = dms.calculate_damage(attacker, defender, skill)

        # 3 hit * 5000 = 15000
        assert result.total_damage == 15000
        assert len(result.hit_details) == 3
        assert all(h == 5000 for h in result.hit_details)


class TestCalculateDamageCrit:
    """暴击相关测试。"""

    def test_force_crit_doubles_damage(self):
        """force_crit=True时暴击伤害 = base * (1.5 + crit_damage)。
        crit_damage=0.5, factor=2.0, damage = 5000 * 2 = 10000。
        """
        attacker = make_unit("atk", atk=10000, crit_damage=0.5)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()

        skill = make_skill(power=100, hit_count=1, force_crit=True)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.is_critical is True
        assert result.total_damage == 10000  # 5000 * (1.5 + 0.5) = 10000

    def test_cannot_crit_forces_non_crit(self):
        """cannot_crit=True时即使crit_rate=100%也不暴击。"""
        attacker = make_unit("atk", atk=10000, crit_rate=1.0)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()

        skill = make_skill(power=100, hit_count=1, cannot_crit=True)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.is_critical is False
        assert result.total_damage == 5000

    def test_force_crit_overrides_cannot_crit(self):
        """force_crit优先级高于cannot_crit（force_crit覆盖）。"""
        attacker = make_unit("atk", atk=10000, crit_damage=0.5)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()

        skill = make_skill(power=100, hit_count=1, force_crit=True, cannot_crit=True)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.is_critical is True
        assert result.total_damage == 10000

    def test_critical_forbidden_debuff_prevents_crit(self):
        """critical_forbidden debuff使攻击者无法暴击。"""
        attacker = make_unit("atk", atk=10000, crit_rate=1.0)
        # 添加critical_forbidden debuff
        attacker.debuffs.append(make_buff(
            name="cf", effect_type=SkillEffectType.CRITICAL_FORBIDDEN.value,
            value=0.0, is_debuff=True,
        ))
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()

        skill = make_skill(power=100, hit_count=1)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.is_critical is False

    def test_bonus_crit_rate_stacks(self):
        """bonus_crit_rate加到crit_rate上。"""
        attacker = make_unit("atk", atk=10000, crit_rate=0.3)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        # 通过crit_override强制判定
        rates_seen = []

        def _override(ctx):
            rates_seen.append(ctx.get('crit_rate', 0.0))
            return False
        dms.set_crit_override(_override)

        skill = make_skill(power=100, hit_count=1, bonus_crit_rate=20.0)
        dms.calculate_damage(attacker, defender, skill)

        # crit_rate=0.3 + bonus_crit_rate/100 = 0.3 + 0.2 = 0.5
        assert rates_seen[0] == pytest.approx(0.5)


class TestCalculateDamagePenetrate:
    """穿防相关测试。"""

    def test_penetrate_defense_buff(self):
        """penetrate_defense buff：DEF按比例减少。
        attacker atk=10000, defender def=5000, penetrate=50% → def=2500, base=7500。
        """
        attacker = make_unit("atk", atk=10000)
        attacker.buffs.append(make_buff(
            name="pen", effect_type=SkillEffectType.PENETRATE_DEFENSE.value,
            value=50.0,
        ))
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage == 7500
        assert result.calc_detail["def_after_penetrate"] == 2500
        assert result.calc_detail["penetrate_pct"] == pytest.approx(50.0)

    def test_skill_ignore_defense(self):
        """skill.ignore_defense：技能级穿防50%。
        atk=10000, def=5000, ignore=50% → def=2500, base=7500。
        """
        attacker = make_unit("atk", atk=10000)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1, ignore_defense=50)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage == 7500

    def test_penetrate_plus_ignore_defense_stacks(self):
        """buff穿防30% + 技能穿防40% = 70%穿防。
        atk=10000, def=5000, penetrate=70% → def=1500, base=8500。
        """
        attacker = make_unit("atk", atk=10000)
        attacker.buffs.append(make_buff(
            name="pen", effect_type=SkillEffectType.PENETRATE_DEFENSE.value,
            value=30.0,
        ))
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1, ignore_defense=40)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage == 8500

    def test_penetrate_capped_at_100(self):
        """穿防100%时DEF=0。"""
        attacker = make_unit("atk", atk=10000)
        attacker.buffs.append(make_buff(
            name="pen", effect_type=SkillEffectType.PENETRATE_DEFENSE.value,
            value=150.0,  # 超过100%
        ))
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage == 10000  # def=0
        assert result.calc_detail["def_after_penetrate"] == 0


class TestCalculateDamageAttribute:
    """属性克制测试。"""

    def test_no_advantage_returns_1(self):
        """无属性克制时attr_factor=1.0。"""
        attacker = make_unit("atk", atk=10000, element=1)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000, element=2)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1)
        result = dms.calculate_damage(attacker, defender, skill)

        # 检查属性因子为1.0
        assert result.attribute_factor == 1.0
        assert result.total_damage == 5000

    def test_advantage_returns_1_25_plus_bonus(self):
        """属性克制时attr_factor=1.25 + advantage_damage。
        advantage_damage=0.05 → factor=1.30, damage=5000*1.3=6500。
        """
        attacker = make_unit("atk", atk=10000, element=1, advantage_damage=0.05)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000, element=2)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1)
        # 检查属性克制（_check_element_advantage基于元素1对2有利）
        # 注意：实际有利关系由_check_element_advantage决定，下面断言基于实际逻辑
        result = dms.calculate_damage(attacker, defender, skill)

        # 若属性克制，factor=1.30
        if result.attribute_factor > 1.0:
            assert result.attribute_factor == pytest.approx(1.30)
            assert result.total_damage == 6500
        else:
            # 若非克制，按1.0处理
            assert result.total_damage == 5000


class TestCalculateDamageHpScaling:
    """HP缩放测试。"""

    def test_hp_scaling_bonus_increases_damage(self):
        """hp_scaling_bonus=50时，伤害×1.5。
        atk=10000, def=5000, base=5000, scaling=1.5 → 7500。
        """
        attacker = make_unit("atk", atk=10000)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1, hp_scaling_bonus=50)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage == 7500
        assert result.calc_detail["hp_scaling"] == pytest.approx(1.5)

    def test_hp_scaling_zero_no_effect(self):
        """hp_scaling_bonus=0时无影响。"""
        attacker = make_unit("atk", atk=10000)
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1, hp_scaling_bonus=0)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage == 5000


class TestCalculateDamageSkillPowerDown:
    """skill_power_down debuff测试。"""

    def test_skill_power_down_reduces_factor(self):
        """skill_power_down按百分比扣减skill_factor。
        power=100, sp_down=30% → factor=0.7, damage=5000*0.7=3500。
        """
        attacker = make_unit("atk", atk=10000)
        attacker.debuffs.append(make_buff(
            name="spd", effect_type=SkillEffectType.SKILL_POWER_DOWN.value,
            value=30.0, is_debuff=True,
        ))
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage == 3500
        assert result.calc_detail["skill_power_down_pct"] == pytest.approx(30.0)

    def test_multiple_skill_power_down_sums(self):
        """多个skill_power_down叠加（取和）。
        30% + 20% = 50% → factor=0.5, damage=5000*0.5=2500。
        """
        attacker = make_unit("atk", atk=10000)
        attacker.debuffs.append(make_buff(
            name="spd1", effect_type=SkillEffectType.SKILL_POWER_DOWN.value,
            value=30.0, is_debuff=True,
        ))
        attacker.debuffs.append(make_buff(
            name="spd2", effect_type=SkillEffectType.SKILL_POWER_DOWN.value,
            value=20.0, is_debuff=True,
        ))
        defender = make_unit("def", side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
                             defense=5000)
        dms = DamageService()
        dms.set_crit_override(lambda ctx: False)

        skill = make_skill(power=100, hit_count=1)
        result = dms.calculate_damage(attacker, defender, skill)

        assert result.total_damage == 2500


# ─── _apply_damage 关键分支测试（使用 BattleBuilder） ──────

def _init_ss_for_direct_apply(ss, bf):
    """初始化_apply_damage所需的全部内部状态。
    
    _apply_damage通常由execute_skill调用，依赖大量内部状态。
    直接调用_apply_damage时需要手动初始化这些状态。
    """
    # 基础状态
    ss._recursion_guard = True  # 防止PS触发
    ss._before_attack_triggers_fired = True
    ss._current_skill_id = 99999
    ss._current_block_id = 1
    ss._current_skill_priority = 1
    
    # 缓存与目标
    ss._block_damage_targets = {}
    ss._block_damage_total = {}
    ss._last_damage_hp_before = {}
    ss._damaged_targets = []
    ss._current_attack_targets = []
    ss._pre_scanned_cover_candidates = None
    ss._pre_scanned_non_damage_enemy_targets = []
    ss._primary_target = None
    ss._trigger_attacker = None
    ss._target_char_type_filter = None
    ss._target_element_filter = None
    ss._original_primary_target = None
    ss._last_primary_target = None
    
    # 累计与追踪
    ss._most_recent_damage = 0
    ss._skill_all_attacked_targets = []
    ss._hp_consumed = 0
    ss._per_hit_hp_losses = {}
    
    # 闪避/免疫
    ss._block_evaded_targets = set()
    ss._skill_evaded_targets = set()
    ss._debuff_immune_blocked_targets = set()
    
    # 暴击块
    ss._on_crit_blocks = []
    ss._on_crit_applied = False
    ss._on_crit_block_executed = {}
    ss._on_crit_target = None
    ss._on_crit_immediate_blocks = []
    ss._on_crit_immediate_applied = set()
    ss._on_crit_effects = []
    ss._deferred_on_crit_targets = []
    ss._pending_crit_triggers = []
    
    # 附魔缓存
    ss._per_target_enchant_cache = None
    ss._current_main_damage_power = None
    
    # mark快照
    ss._marks_at_start = {}
    ss._marks_at_start_by_unit = {}
    
    # PS相关
    ss._ps_received_targets = []
    ss._current_skill_is_ps = False
    
    # heal targets
    ss._last_heal_targets = []


class TestApplyDamageShield:
    """护盾吸收分支测试。"""

    def _build_context(self):
        """构造最小测试上下文：1友方+1敌方+SkillService。"""
        from tests.helpers.battle_builder import BattleBuilder
        bb = BattleBuilder()
        bb.add_ally(unit_id="ally", atk=10000, skills=[])
        bb.add_enemy(unit_id="enemy", hp=50000, defense=5000)
        ctx = bb.build()
        return ctx

    def _make_effect(self, target_type="enemy_single", value=100.0, hit_count=1,
                     ignore_defense=0, ignore_shield=0, flags=None):
        """构造_apply_damage的effect参数。"""
        return SimpleNamespace(
            effect_type="damage",
            target_type=target_type,
            target_identifier=None,
            value=value,
            hit_count=hit_count,
            ignore_defense=ignore_defense,
            ignore_shield=ignore_shield,
            flags=flags or {},
            condition=None,
        )

    def test_shield_absorbs_damage(self):
        """护盾吸收伤害：HP不变，shield减少。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        enemy.shield = 3000  # 护盾3000
        _init_ss_for_direct_apply(ss, ctx['bf'])

        hp_before = enemy.current_hp
        result = ss._apply_damage(ally, self._make_effect(), ctx['bf'])

        # 伤害5000，护盾吸收3000，HP扣减2000
        assert enemy.shield == 0
        assert enemy.current_hp == hp_before - 2000
        assert result is not None
        assert result['targets'][0]['shield_absorbed'] == 3000
        assert result['targets'][0]['actual_damage'] == 2000

    def test_shield_fully_absorbs(self):
        """护盾完全吸收伤害+最低1点伤害规则：盾额外吸收1点，HP不变。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        enemy.shield = 10000  # 护盾10000，足以吸收5000伤害
        _init_ss_for_direct_apply(ss, ctx['bf'])

        hp_before = enemy.current_hp
        ss._apply_damage(ally, self._make_effect(), ctx['bf'])

        # 伤害5000被盾完全吸收，触发最低1点伤害规则，盾额外吸收1点
        assert enemy.shield == 4999  # 10000-5000-1
        assert enemy.current_hp == hp_before  # HP未扣减

    def test_ignore_shield_bypasses_shield(self):
        """ignore_shield=100%时完全穿盾，HP直接扣减。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        enemy.shield = 10000
        _init_ss_for_direct_apply(ss, ctx['bf'])

        hp_before = enemy.current_hp
        # ignore_shield=100 → shield_penetration=1.0, direct_damage=all
        effect = self._make_effect(ignore_shield=100)
        ss._apply_damage(ally, effect, ctx['bf'])

        assert enemy.shield == 10000  # 护盾未消耗
        assert enemy.current_hp == hp_before - 5000  # HP直接扣减


class TestApplyDamageHpAndCumulative:
    """HP扣减 + 累计伤害测试。"""

    def _build_context(self):
        from tests.helpers.battle_builder import BattleBuilder
        bb = BattleBuilder()
        bb.add_ally(unit_id="ally", atk=10000, skills=[])
        bb.add_enemy(unit_id="enemy", hp=50000, defense=5000)
        ctx = bb.build()
        return ctx

    def _make_effect(self, **kwargs):
        return SimpleNamespace(
            effect_type="damage", target_type="enemy_single",
            target_identifier=None, value=100.0, hit_count=1,
            ignore_defense=0, ignore_shield=0, flags={}, condition=None,
            **kwargs,
        )

    def test_cumulative_hp_damage_updated(self):
        """伤害后target.cumulative_hp_damage累加HP损失。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        _init_ss_for_direct_apply(ss, ctx['bf'])

        assert enemy.cumulative_hp_damage == 0
        ss._apply_damage(ally, self._make_effect(), ctx['bf'])

        # 伤害5000（无盾），HP损失5000，累计伤害=5000
        assert enemy.cumulative_hp_damage == 5000

    def test_shield_absorbed_not_in_cumulative(self):
        """盾吸收的部分不计入cumulative_hp_damage。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        enemy.shield = 3000
        _init_ss_for_direct_apply(ss, ctx['bf'])

        ss._apply_damage(ally, self._make_effect(), ctx['bf'])

        # HP损失=2000（盾吸收3000），累计伤害=2000
        assert enemy.cumulative_hp_damage == 2000

    def test_last_received_damage_includes_shield(self):
        """last_received_damage包含盾吸收部分（用于反撃PS）。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        enemy.shield = 3000
        _init_ss_for_direct_apply(ss, ctx['bf'])

        ss._apply_damage(ally, self._make_effect(), ctx['bf'])

        # hp_loss=2000 + shield_absorbed=3000 = 5000
        assert enemy.last_received_damage == 5000

    def test_damage_totals_tracked(self):
        """attacker.damage_dealt_total和target.damage_taken_total更新。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        _init_ss_for_direct_apply(ss, ctx['bf'])

        ss._apply_damage(ally, self._make_effect(), ctx['bf'])

        assert ally.damage_dealt_total == 5000
        assert enemy.damage_taken_total == 5000


class TestApplyDamageOverkill:
    """OVERKILL路径测试（目标已倒下）。"""

    def _build_context(self):
        from tests.helpers.battle_builder import BattleBuilder
        bb = BattleBuilder()
        bb.add_ally(unit_id="ally", atk=10000, skills=[])
        bb.add_enemy(unit_id="enemy", hp=50000, defense=5000)
        ctx = bb.build()
        return ctx

    def _make_effect(self):
        return SimpleNamespace(
            effect_type="damage", target_type="enemy_single",
            target_identifier=None, value=100.0, hit_count=1,
            ignore_defense=0, ignore_shield=0, flags={}, condition=None,
        )

    def test_overkill_path_records_damage(self):
        """目标已倒下时走OVERKILL路径（需使用缓存目标），仍记录伤害但HP保持0。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        enemy.current_hp = 0
        enemy.is_alive = False
        _init_ss_for_direct_apply(ss, ctx['bf'])
        # OVERKILL路径需要is_using_cached=True（通过_block_damage_targets缓存）
        ss._block_damage_targets = {"enemy_single": [enemy]}

        result = ss._apply_damage(ally, self._make_effect(), ctx['bf'])

        assert result is not None
        target_hit = result['targets'][0]
        assert target_hit['overkill'] is True
        assert target_hit['actual_damage'] == 5000  # 仍计算伤害
        assert enemy.current_hp == 0  # HP保持0


class TestApplyDamageMinDamage:
    """最低1点伤害测试。"""

    def _build_context(self):
        from tests.helpers.battle_builder import BattleBuilder
        bb = BattleBuilder()
        bb.add_ally(unit_id="ally", atk=100, skills=[])  # 极低ATK
        bb.add_enemy(unit_id="enemy", hp=50000, defense=5000)
        ctx = bb.build()
        return ctx

    def _make_effect(self):
        return SimpleNamespace(
            effect_type="damage", target_type="enemy_single",
            target_identifier=None, value=100.0, hit_count=1,
            ignore_defense=0, ignore_shield=0, flags={}, condition=None,
        )

    def test_min_damage_when_atk_le_def(self):
        """ATK<=DEF时最低1点伤害作用于HP。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        _init_ss_for_direct_apply(ss, ctx['bf'])

        hp_before = enemy.current_hp
        result = ss._apply_damage(ally, self._make_effect(), ctx['bf'])

        # base_diff=max(1, 100-5000)=1，伤害=1
        assert result['targets'][0]['actual_damage'] == 1
        assert enemy.current_hp == hp_before - 1

    def test_min_damage_absorbed_by_shield(self):
        """ATK<=DEF时1点伤害优先被盾吸收+触发最低1点伤害规则再吸收1点。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        enemy.shield = 1000
        _init_ss_for_direct_apply(ss, ctx['bf'])

        hp_before = enemy.current_hp
        result = ss._apply_damage(ally, self._make_effect(), ctx['bf'])

        # base_diff=1的伤害先被盾吸收1点，触发最低1点伤害规则后盾再吸收1点
        # 共吸收2点，HP未扣减
        assert result['targets'][0]['shield_absorbed'] == 2
        assert result['targets'][0]['actual_damage'] == 0  # HP未扣减
        assert enemy.current_hp == hp_before  # HP未扣减
        assert enemy.shield == 998  # 1000-2


class TestApplyDamageSubUnit:
    """子单位吸收测试。"""

    def _build_context(self):
        from tests.helpers.battle_builder import BattleBuilder
        bb = BattleBuilder()
        bb.add_ally(unit_id="ally", atk=10000, skills=[])
        bb.add_enemy(unit_id="enemy", hp=50000, defense=5000)
        ctx = bb.build()
        return ctx

    def _make_effect(self):
        return SimpleNamespace(
            effect_type="damage", target_type="enemy_single",
            target_identifier=None, value=100.0, hit_count=1,
            ignore_defense=0, ignore_shield=0, flags={}, condition=None,
        )

    def test_sub_unit_absorbs_damage(self):
        """子单位吸收伤害：HP不变，sub_unit_hp减少。"""
        ctx = self._build_context()
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        # 给enemy添加sub_unit buff
        enemy.buffs.append(make_buff(
            name="sub_unit_test", effect_type=SkillEffectType.SUB_UNIT.value,
            value=0.0, sub_unit_hp=3000, sub_unit_max_hp=3000,
        ))
        _init_ss_for_direct_apply(ss, ctx['bf'])

        hp_before = enemy.current_hp
        result = ss._apply_damage(ally, self._make_effect(), ctx['bf'])

        # 伤害5000，子单位吸收3000，HP扣减2000
        assert enemy.current_hp == hp_before - 2000
        target_hit = result['targets'][0]
        assert target_hit['shield_absorbed'] == 3000
        assert target_hit['actual_damage'] == 2000


