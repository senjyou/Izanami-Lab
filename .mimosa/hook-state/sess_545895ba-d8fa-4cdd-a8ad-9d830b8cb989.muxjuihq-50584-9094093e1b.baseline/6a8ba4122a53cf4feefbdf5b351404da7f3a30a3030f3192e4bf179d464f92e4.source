        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

    # ─── EX: びしょ濡れだねー！ ───

    def test_ex_ignore_defense_and_shield(self):
        """
        EX(110018) 穿防穿盾
        验证: damage效果带有ignore_defense=100和ignore_shield=100
        """
        shield_buff = BuffState(
            buff_id="test_shield", name="shield", effect_type=SHIELD,
            value=5000, duration=-1, timing_type=1,
        )
        self.enemy_front.buffs.append(shield_buff)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 穿防穿盾：防御和护盾应被无视，伤害应直接扣HP
        # 验证敌人受到了伤害（HP降低）
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "穿防穿盾后应造成伤害")

    def test_ex_dmg_dealt_up_when_target_low_hp(self):
        """
        EX(110018) 低血量增伤（独立倍率乘区）
        验证: 目标HP≤40%时，伤害获得独立倍率加成（power * 1.5），而非dmg_dealt_up buff
        """
        self.enemy_front.current_hp = int(self.enemy_front.max_hp * 0.3)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 独立倍率乘区：不再添加dmg_dealt_up buff，而是直接修改power
        dmg_up_buffs = [b for b in self.caster.buffs
                        if b.effect_type == SkillEffectType.DEALT_DAMAGE.value]
        self.assertEqual(len(dmg_up_buffs), 0, "独立倍率乘区不应添加dmg_dealt_up buff")

        # 验证伤害结果中包含增伤效果（伤害应高于无增伤时的值）
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "应有伤害效果")
        # 低血量时伤害应包含1.5倍加成（power 156 * 1.5 = 234）
        total_dmg = sum(e.get("total_damage", 0) for e in dmg_effects)
        self.assertGreater(total_dmg, 0, "低血量时应造成伤害")

    def test_ex_no_dmg_dealt_up_when_target_high_hp(self):
        """
        EX(110018) 高血量不增伤
        验证: 目标HP>40%时，不获得独立倍率加成（无conditional_power_bonus）
        """
        self.enemy_front.current_hp = self.enemy_front.max_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_up_buffs = [b for b in self.caster.buffs
                        if b.effect_type == SkillEffectType.DEALT_DAMAGE.value]
        self.assertEqual(len(dmg_up_buffs), 0, "高血量时不应获得dmg_dealt_up buff")

    def test_ex_remove_ap_on_kill_lv11(self):
        """
        EX(110018) Lv11+击杀削AP
        验证: 击杀敌方后，敌方全体AP-1
        """
        self.caster.skill_levels[110018] = 15
        self.caster.level = 15

        # 设置敌方前排低血量以便击杀
        self.enemy_front.current_hp = 100
        self.enemy_back.current_ap = 3
        self.enemy_left_front.current_ap = 3

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证击杀
        self.assertFalse(self.enemy_front.is_alive, "应击杀敌方前排")

        # 验证其他敌方AP被削减
        remove_ap_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "remove_ap"]
        self.assertTrue(len(remove_ap_effects) > 0, "击杀后应有remove_ap效果")

    # ─── AS1: カオスキャノン ───

    def test_as1_furthest_target(self):
        """
        AS1(120025) 最远目标选择
        验证: 攻击距施法者最远的敌方
        caster在中前(col=1)，参考点(0,1)
        - 敌方前排(0,1) 距离=0
        - 敌方后排(1,1) 距离=1
        - 敌方左前(0,0) 距离=1
        - 敌方右后(1,2) 距离=2
        最远应为敌方右后(距离2)
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120025, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "AS1应造成伤害")

        target_ids = set()
        for e in dmg_effects:
            for t in e.get("targets", []):
                tid = t.get("target_id")
                if tid:
                    target_ids.add(tid)

        # 最远目标应为敌方右后(距离2)
        self.assertIn(self.enemy_right_back.unit_id, target_ids,
                      f"最远目标应为敌方右后, 实际目标: {target_ids}")

    def test_as1_burn_effect(self):
        """
        AS1(120025) 炎上效果
        验证: 对最远敌方目标施加3行动炎上
        caster在(0,1)，参考点(0,1)：
        - enemy_front(0,1) 距离²=0 (最近)
        - enemy_back(1,1) 距离²=1
        - enemy_left_front(0,0) 距离²=1
        - enemy_right_back(1,2) 距离²=2 (最远)
        burn应施加在最远敌方(enemy_right_back)，不应施加在最近敌方(enemy_front)
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120025, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        burn_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "add_status"]
        self.assertTrue(len(burn_effects) > 0, "AS1应施加炎上")

        # 核心断言：burn必须施加在最远敌方(enemy_right_back)
        burn_on_furthest = [d for d in self.enemy_right_back.debuffs if d.effect_type == CONFLAGRATION]
        self.assertTrue(len(burn_on_furthest) > 0,
                        "burn应施加在最远敌方(enemy_right_back)")
        self.assertEqual(burn_on_furthest[0].duration, 3, "炎上应持续3行动")

        # 验证非最远敌方未获得burn（避免误打到最近敌方）
        no_burn_enemies = [e for e in [self.enemy_front, self.enemy_back, self.enemy_left_front]
                           if any(d.effect_type == CONFLAGRATION for d in e.debuffs)]
        self.assertEqual(len(no_burn_enemies), 0,
                         f"非最远敌方不应获得burn: {[e.name for e in no_burn_enemies]}")

    # ─── AS2: マッドブレイドオーバーロード ───

    def test_as2_multi_hit(self):
        """
        AS2(120042) 多hit攻击
        验证: Lv10时4hit攻击
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120042, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "AS2应造成伤害")

        for e in dmg_effects:
            hits = e.get("hits", [])
            if hits:
                self.assertEqual(len(hits), 4, f"Lv10时应为4hit, 实际: {len(hits)}")

    def test_as2_lv11_five_hits(self):
        """
        AS2(120042) Lv11+ 5hit
        验证: Lv15时5hit攻击
        """
        self.caster.skill_levels[120042] = 15
        self.caster.level = 15

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120042, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "AS2应造成伤害")

        for e in dmg_effects:
            hits = e.get("hits", [])
            if hits:
                self.assertEqual(len(hits), 5, f"Lv15时应为5hit, 实际: {len(hits)}")

    # ─── PS1: アナーキーシールド ───

    def test_ps1_on_kill_def_up_and_ep(self):
        """
        PS1(130033) 击杀触发 + 防御UP + EP+1
        验证: 击杀敌人时，自身防御UP(可叠加) + EP+1
        """
        self.enemy_front.current_hp = 100

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120042, battlefield=self.bf, skip_cost=True
        )

        trigger_actions = self.ts.trigger_pawn_killed(self.caster, self.bf)
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130033]

        if ps1_actions:
            self.ss._execute_trigger_actions_inline(ps1_actions, self.bf, trigger_timing="on_kill")

            def_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_DEFENSE]
            self.assertTrue(len(def_buffs) > 0, "击杀后应获得防御UP")
            self.assertGreaterEqual(self.caster.current_ep, 1, "击杀后EP应+1")

    def test_ps1_def_up_stackable(self):
        """
        PS1(130033) 防御UP可叠加
        验证: 多次击杀后防御UP叠加
        """
        # 第一次击杀
        self.enemy_front.current_hp = 100
        self.ss.execute_skill(caster=self.caster, skill_id=120042, battlefield=self.bf, skip_cost=True)
        trigger_actions = self.ts.trigger_pawn_killed(self.caster, self.bf)
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130033]
        if ps1_actions:
            self.ss._execute_trigger_actions_inline(ps1_actions, self.bf, trigger_timing="on_kill")

        self.caster.skill_cooldowns = {}

        # 第二次击杀
        self.enemy_back.current_hp = 100
        self.ss.execute_skill(caster=self.caster, skill_id=120042, battlefield=self.bf, skip_cost=True)
        trigger_actions = self.ts.trigger_pawn_killed(self.caster, self.bf)
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130033]
        if ps1_actions:
            self.ss._execute_trigger_actions_inline(ps1_actions, self.bf, trigger_timing="on_kill")

        def_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertGreaterEqual(len(def_buffs), 2, "多次击杀后防御UP应叠加")

    def test_ps1_lv11_shield(self):
        """
        PS1(130033) Lv11+ 物理护盾
        验证: Lv11+击杀时还获得物理护盾
        """
        self.caster.skill_levels[130033] = 15
        self.caster.level = 15

        self.enemy_front.current_hp = 100
        self.ss.execute_skill(caster=self.caster, skill_id=120042, battlefield=self.bf, skip_cost=True)
        trigger_actions = self.ts.trigger_pawn_killed(self.caster, self.bf)
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130033]
        if ps1_actions:
            self.ss._execute_trigger_actions_inline(ps1_actions, self.bf, trigger_timing="on_kill")

            shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
            self.assertTrue(len(shield_buffs) > 0, "Lv11+击杀后应获得护盾")

            shield = shield_buffs[0]
            self.assertEqual(shield.damage_element, 1,
                             "护盾应仅抵挡物理伤害(damage_element=1)")

    # ─── PS2: フレンジーキャノン ───

    def test_ps2_counter_after_as_attacked(self):
        """
        PS2(130049) 被AS攻击后反击
        验证: 自身被AS攻击后，反击攻击者
        """
        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster],
            battlefield=self.bf,
            actor=self.enemy_front,
        )

        ps2_actions = [a for a in trigger_actions if a.skill_id == 130049]
        self.assertTrue(len(ps2_actions) > 0, "被AS攻击后PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="after_as_attacked"
        )

        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "反击应造成伤害")

    def test_ps2_no_counter_when_ally_attacked(self):
        """
        PS2(130049) 友方被攻击不触发
        验证: 只有自身被AS攻击时才触发
        """
        ally = UnitState(
            unit_id="ally_back", name="友方后排", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=999100, level=10,
            element=2, character_type=1,
            max_hp=10000, current_hp=10000,
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.bf.friend_team.append(ally)

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[ally],
            battlefield=self.bf,
            actor=self.enemy_front,
        )

        ps2_actions = [a for a in trigger_actions if a.skill_id == 130049]
        self.assertEqual(len(ps2_actions), 0, "友方被攻击时PS2不应触发")

    def test_ps2_lv11_remove_ep(self):
        """
        PS2(130049) Lv11+ 削EP
        验证: Lv11+反击时还削减攻击者EP
        """
        self.caster.skill_levels[130049] = 15
        self.caster.level = 15

        ep_before = self.enemy_front.current_ep

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster],
            battlefield=self.bf,
            actor=self.enemy_front,
        )

        ps2_actions = [a for a in trigger_actions if a.skill_id == 130049]
        self.assertTrue(len(ps2_actions) > 0, "被AS攻击后PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="after_as_attacked"
        )

        self.assertLess(self.enemy_front.current_ep, ep_before,
                        f"Lv11+反击应削减攻击者EP, EP: {ep_before} -> {self.enemy_front.current_ep}")



    # ─── 补充测试: PS2 反击目标 / Lv10限制 ───

    def test_ps2_counter_targets_attacker_not_nearest(self):
        """
        PS2(130049) 反击目标应为攻击者,而非最近敌方
        验证: 当攻击者不是最近敌方时,反击仍命中攻击者
        caster在中前(0,1),最近敌方是enemy_front(0,1)
        使用enemy_back(1,1)作为攻击者,反击应命中enemy_back而非enemy_front
        """
        hp_before_front = self.enemy_front.current_hp
        hp_before_back = self.enemy_back.current_hp

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster],
            battlefield=self.bf,
            actor=self.enemy_back,
        )

        ps2_actions = [a for a in trigger_actions if a.skill_id == 130049]
        self.assertTrue(len(ps2_actions) > 0, "被AS攻击后PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="after_as_attacked"
        )

        # 验证: 攻击者(后排)受到伤害,最近敌方(前排)未受伤害
        self.assertLess(self.enemy_back.current_hp, hp_before_back,
                        "反击应命中攻击者(后排enemy_back)")
        self.assertEqual(self.enemy_front.current_hp, hp_before_front,
                         "反击不应误伤最近敌方(前排enemy_front)")

    def test_ps2_lv10_no_remove_ep(self):
        """
        PS2(130049) Lv10不削EP
        验证: Lv10时反击不削减攻击者EP(remove_ep应仅Lv11+生效)
        """
        ep_before = self.enemy_front.current_ep

        trigger_actions = self.ts.trigger_after_as_attacked(
            targets=[self.caster],
            battlefield=self.bf,
            actor=self.enemy_front,
        )

        ps2_actions = [a for a in trigger_actions if a.skill_id == 130049]
        self.assertTrue(len(ps2_actions) > 0, "被AS攻击后PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="after_as_attacked"
        )

        self.assertEqual(self.enemy_front.current_ep, ep_before,
                         f"Lv10反击不应削EP, EP: {ep_before} -> {self.enemy_front.current_ep}")

    # ─── 补充测试: PS1 Lv10限制 ───

    def test_ps1_lv10_no_shield(self):
        """
        PS1(130033) Lv10不获得护盾
        验证: Lv10击杀时不获得物理护盾(shield应仅Lv11+生效)
        """
        self.caster.skill_levels[130033] = 10
        self.caster.level = 10

        self.enemy_front.current_hp = 100
        self.ss.execute_skill(caster=self.caster, skill_id=120042, battlefield=self.bf, skip_cost=True)
        trigger_actions = self.ts.trigger_pawn_killed(self.caster, self.bf)
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130033]
        if ps1_actions:
            self.ss._execute_trigger_actions_inline(ps1_actions, self.bf, trigger_timing="on_kill")

        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_buffs), 0, "Lv10击杀后不应获得护盾")

        # 验证def_up和add_ep仍然生效(Lv1-10核心效果)
        def_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertTrue(len(def_buffs) > 0, "Lv10击杀后应获得防御UP")

    # ─── 补充测试: EX Lv10限制 / 非击杀 ───

    def test_ex_lv10_no_remove_ap_on_kill(self):
        """
        EX(110018) Lv10击杀不削AP
        验证: Lv10击杀敌方时,不触发敵全体AP-1(remove_ap应仅Lv11+生效)
        """
        self.caster.skill_levels[110018] = 10
        self.caster.level = 10

        self.enemy_front.current_hp = 100
        ap_before_back = self.enemy_back.current_ap
        ap_before_left = self.enemy_left_front.current_ap

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证击杀
        self.assertFalse(self.enemy_front.is_alive, "应击杀敌方前排")

        # 验证其他敌方AP未被削减
        self.assertEqual(self.enemy_back.current_ap, ap_before_back,
                         "Lv10击杀不应削减其他敌方AP")
        self.assertEqual(self.enemy_left_front.current_ap, ap_before_left,
                         "Lv10击杀不应削减其他敌方AP")

    def test_ex_no_remove_ap_when_not_killed(self):
        """
        EX(110018) 非击杀不削AP
        验证: Lv15时若目标未被击杀,不触发敵全体AP-1(target_killed条件)
        """
        self.caster.skill_levels[110018] = 15
        self.caster.level = 15
        self.caster.attack = 100  # 降低攻击力避免击杀

        ap_before_front = self.enemy_front.current_ap
        ap_before_back = self.enemy_back.current_ap

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证目标未被击杀
        self.assertTrue(self.enemy_front.is_alive, "目标不应被击杀(攻击力低)")

        # 验证AP未被削减
        self.assertEqual(self.enemy_front.current_ap, ap_before_front,
                         "未击杀时不应削减目标AP")
        self.assertEqual(self.enemy_back.current_ap, ap_before_back,
                         "未击杀时不应削减其他敌方AP")

    # ─── 补充测试: AS1 ステルス重定向 ───

    def test_as1_stealth_redirection(self):
        """
        AS1(120025) ステルス重定向
        验证: 最远目标持ステルス时,重定向到次选最远目标
        caster(0,1), enemy_left_back(1,0)和enemy_right_back(1,2)均为距离²=2(最远)
        无ステルス时tiebreaker(tr,tc)升序选enemy_left_back(1,0)
        给enemy_left_back添加ステルス后,应重定向到enemy_right_back(1,2)
        """
        enemy_left_back = UnitState(
            unit_id="enemy_left_back", name="敌方左后", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_BACK, character_id=999005, level=10,
            element=2, character_type=1,
            max_hp=10000, current_hp=10000,
            attack=5000, defense=3000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.bf.enemy_team.append(enemy_left_back)

        # 给敌方左后(无ステルス时为首选最远)添加ステルス
        enemy_left_back.buffs.append(_make_stealth_buff(duration=2))

        hp_before_left_back = enemy_left_back.current_hp
        hp_before_right_back = self.enemy_right_back.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120025, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证: ステルス重定向,敌方右后(次选)受击,敌方左后(ステルス)未受击
        self.assertLess(self.enemy_right_back.current_hp, hp_before_right_back,
                        "ステルス重定向后应攻击敌方右后(次选最远)")
        self.assertEqual(enemy_left_back.current_hp, hp_before_left_back,
                         "ステルス单位不应受击")

    # ─── 补充测试: EX 低血量40%边界 ───

    def test_ex_low_hp_boundary_40pct(self):
        """
        EX(110018) 低血量增伤40%边界(含)
        验证: 目标HP=40%(含)时触发独立倍率增伤, HP>40%时不触发
        """
        self.caster.attack = 100  # 降低攻击力避免击杀

        # Run 1: HP at exactly 40% (boundary, inclusive)
        self.enemy_front.current_hp = int(self.enemy_front.max_hp * 0.40)
        result1 = self.ss.execute_skill(
            caster=self.caster, skill_id=110018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result1["success"])
        dmg1 = sum(e.get("total_damage", 0) for e in result1["effects_applied"]
                   if e.get("effect_type") == "damage")

        # 重置状态
        self.enemy_front.current_hp = int(self.enemy_front.max_hp * 0.41)
        self.enemy_front.buffs = []
        self.enemy_front.debuffs = []
        self.caster.buffs = []
        self.caster.skill_cooldowns = {}

        # Run 2: HP at 41% (just above boundary)
        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=110018, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result2["success"])
        dmg2 = sum(e.get("total_damage", 0) for e in result2["effects_applied"]
                   if e.get("effect_type") == "damage")

        # HP=40%时增伤(power*1.5), HP=41%时无增伤 → dmg1应约为dmg2的1.5倍
        self.assertGreater(dmg1, dmg2,
                           f"HP=40%时应触发增伤(dmg={dmg1}), HP=41%时无增伤(dmg={dmg2})")

    # ─── 补充测试: AS1 炎上伤害百分比 ───

    def test_as1_burn_damage_pct_30(self):
        """
        AS1(120025) 炎上伤害为攻击力×30%
        验证: burn debuff的value = caster.attack * 30 / 100 = 3000
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120025, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        burn_buffs = [d for d in self.enemy_right_back.debuffs if d.effect_type == CONFLAGRATION]
        self.assertTrue(len(burn_buffs) > 0, "应对最远敌方施加炎上")

        burn = burn_buffs[0]
        expected_value = self.caster.attack * 30 / 100  # 10000 * 30 / 100 = 3000
        self.assertEqual(int(burn.value), int(expected_value),
                         f"炎上伤害值应为攻击力×30%={expected_value}, 实际={burn.value}")

    # ─── 补充测试: PS1 护盾仅挡物理 ───

    def test_ps1_shield_only_blocks_physical(self):
        """
        PS1(130033) Lv11+护盾仅抵挡物理伤害
        验证: shield.damage_element=1(physical), shield_amount=atk*shield%
        """
        self.caster.skill_levels[130033] = 15
        self.caster.level = 15

        self.enemy_front.current_hp = 100
        self.ss.execute_skill(caster=self.caster, skill_id=120042, battlefield=self.bf, skip_cost=True)
        trigger_actions = self.ts.trigger_pawn_killed(self.caster, self.bf)
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130033]
        if ps1_actions:
            self.ss._execute_trigger_actions_inline(ps1_actions, self.bf, trigger_timing="on_kill")

        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertTrue(len(shield_buffs) > 0, "Lv15击杀后应获得护盾")

        shield = shield_buffs[0]
        self.assertEqual(shield.damage_element, 1,
                         "护盾应仅抵挡物理伤害(damage_element=1)")

        # 验证护盾值 = 攻击力 × shield%(Lv15=50%)
        expected_shield = self.caster.attack * 50 / 100  # 10000 * 50 / 100 = 5000
        self.assertEqual(shield.shield_amount, int(expected_shield),
                         f"护盾值应为攻击力×50%={expected_shield}, 实际={shield.shield_amount}")


if __name__ == "__main__":
    unittest.main()
