"""Regression: おたすけもとむ (130164/230440) remove_debuff value=1 必须按 LIFO 解除1个debuff。

Bug: `_apply_remove_debuff` 只从 flags.count / count_tag 读取 max_count，忽略
     effect.value。130164/230440 的 remove_debuff 配置为 value=1（解除1个debuff），
     被解析为 max_count=0 → 走「解除全部」分支 → 把战斗中先施加的
     回忆卡永续debuff（如 30031 被ダメージ上昇，battle_start 永续）也一并清除了。

Fix: flags.count/count_tag 未配置时回退到 effect.value，value>0 表示按数量 LIFO 解除
     （value<=0 或 None 保持「解除全部」语义，如セントリストア value=-1）。

Regression covers:
1. 同时存在 回忆卡永续debuff(先施加) + 普通debuff(后施加) → 只解除后者（LIFO），永续保留
2. 只存在回忆卡永续debuff → 解除它本身（无其他目标可解时）
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value

PS_OTASUKE = 130164  # おたすけもとむ (己方140302)
PS_OTASUKE_ENEMY = 230440  # おたすけもとむ (敌方451305)

MEM_DEBUFF_ID = "mem30031"


def _mk_unit(unit_id, side, skills=None):
    return UnitState(
        unit_id=unit_id, name=unit_id, side=side,
        position=Position.ALLY_CENTER_FRONT if side == Side.ALLY else Position.ENEMY_CENTER_FRONT,
        character_id=0, level=10, element=4, character_type=1,
        max_hp=20000, current_hp=20000, attack=8000, defense=4000, speed=500,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=5,
        current_ap=10, current_pp=10, current_ep=10,
        skills=skills or [], skill_levels={s: 10 for s in (skills or [])},
        skill_cooldowns={},
    )


def _mem_debuff():
    """回忆卡30031 被ダメージ上昇【敵前衛】: 战斗开始时施加的永续debuff"""
    return BuffState(
        buff_id=MEM_DEBUFF_ID, name="被ダメージ上昇", effect_type=RECEIVED_DAMAGE,
        value=7.5, duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id="mem", source_skill_id=400204,
        is_debuff=True, is_memory_buff=True,
    )


class TestRegOtasukeLifoRemoveOne(unittest.TestCase):
    """Regression: おたすけもとむ remove_debuff=LIFO 解除1个，不清除回忆卡永续debuff"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _build(self, skills):
        bf = BattlefieldState()
        self.caster = _mk_unit("caster", Side.ALLY, skills=skills)
        self.enemy = _mk_unit("enemy", Side.ENEMY)
        bf.friend_team = [self.caster]
        bf.enemy_team = [self.enemy]
        rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        self.ss = SkillService(self.dl, rs, target_service=tgs,
                               damage_service=dms, aura_service=aus,
                               status_service=sts, trigger_service=self.ts)
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(bf)
        return bf

    def test_remove_one_keeps_memory_debuff(self):
        """同时存在 回忆卡永续 + 普通debuff → 只解除普通(后施加=LIFO)，永续保留。"""
        bf = self._build([PS_OTASUKE])
        # 按施加时序：回忆卡先（战斗开始），普通后
        self.caster.debuffs.extend([_mem_debuff()])
        self.caster.debuffs.append(BuffState(
            buff_id="atkdown1", name="攻撃力低下", effect_type=STATUS_ATTACK,
            value=10.0, duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="e", source_skill_id=999999, is_debuff=True,
        ))
        self.assertEqual(len(self.caster.debuffs), 2, "前置：2个debuff")

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OTASUKE, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 回忆卡永续debuff保留（核心：旧bug被清除）
        mem_left = [d for d in self.caster.debuffs if d.buff_id == MEM_DEBUFF_ID]
        self.assertEqual(len(mem_left), 1, "回忆卡永续debuff不应被清除")
        # 后施加的普通debuff被解除（LIFO）
        atk_left = [d for d in self.caster.debuffs if d.buff_id == "atkdown1"]
        self.assertEqual(len(atk_left), 0, "后施加的普通debuff应被解除(LIFO)")
        # 总数：原2个 - 解除1个 = 1（仅剩回忆卡永续 + 子单元holder_debuff新增）
        # holder_debuff 的 atk_down 会额外追加，故仅断言未清空全部原始debuff
        self.assertGreaterEqual(len([d for d in self.caster.debuffs
                                     if d.buff_id == MEM_DEBUFF_ID]), 1)

    def test_enemy_version_230440_also_removes_one(self):
        """敌方版230440 同样 value=1 → LIFO 只解除1个。"""
        bf = self._build([PS_OTASUKE_ENEMY])
        self.caster.debuffs.extend([_mem_debuff()])
        self.caster.debuffs.append(BuffState(
            buff_id="atkdown1", name="攻撃力低下", effect_type=STATUS_ATTACK,
            value=10.0, duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="e", source_skill_id=999999, is_debuff=True,
        ))

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OTASUKE_ENEMY, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertEqual(len([d for d in self.caster.debuffs if d.buff_id == MEM_DEBUFF_ID]), 1,
                         "回忆卡永续debuff应保留")
        self.assertEqual(len([d for d in self.caster.debuffs if d.buff_id == "atkdown1"]), 0,
                         "后施加的普通debuff应被解除(LIFO)")

    def test_memory_debuff_alone_is_never_removed(self):
        """回忆卡debuff是唯一debuff时，おたすけもとむ 也不得解除它（真实日志场景）。

        实战日志: リディア 阶段1 时身上仅有回忆卡30031的被ダメージ上昇(永続debuff)，
        おたすけもとむ 却把它当作 LIFO 目标解除（max_count=1 → 唯一debuff被移除）。
        修复后：is_memory_buff 被排除，removed=0。
        """
        bf = self._build([PS_OTASUKE])
        self.caster.debuffs.extend([_mem_debuff()])
        self.assertEqual(len(self.caster.debuffs), 1, "前置：仅1个回忆卡debuff")

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OTASUKE, battlefield=bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertEqual(len([d for d in self.caster.debuffs if d.buff_id == MEM_DEBUFF_ID]), 1,
                         "回忆卡debuff是唯一debuff时也不得被解除")

    def test_centrestore_negative_value_removes_all(self):
        """セントリストア (130061) value=-1 保持「解除全部」语义不受影响。"""
        bf = self._build([130061])
        self.caster.debuffs.extend([
            BuffState(buff_id="db1", name="d1", effect_type=STATUS_ATTACK, value=5.0,
                      duration=3, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
                      source_unit_id="e", source_skill_id=1, is_debuff=True),
            BuffState(buff_id="db2", name="d2", effect_type=RECEIVED_DAMAGE, value=5.0,
                      duration=3, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
                      source_unit_id="e", source_skill_id=2, is_debuff=True),
        ])
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130061, battlefield=bf, skip_cost=True
        )
        # 130061 的 remove_debuff 只是其中一段效果；此处验证 value=-1 不触发 LIFO
        # （130061 实际还包含其他效果，执行不报错即可，count限制保持全部语义）
        self.assertTrue(result["success"])


if __name__ == '__main__':
    unittest.main()