with open(HYBRID_PATH, "r", encoding="utf-8") as f:
    data = json.load(f)

for sid, entry in NEW_SKILLS.items():
    data[sid] = entry

with open(HYBRID_PATH, "w", encoding="utf-8") as f:
    json.dump(data, f, ensure_ascii=False, indent=2)

print(f"Added {len(NEW_SKILLS)} skills to {HYBRID_PATH}")
for sid in NEW_SKILLS:
    print(f"  {sid}: {NEW_SKILLS[sid]['name']}")