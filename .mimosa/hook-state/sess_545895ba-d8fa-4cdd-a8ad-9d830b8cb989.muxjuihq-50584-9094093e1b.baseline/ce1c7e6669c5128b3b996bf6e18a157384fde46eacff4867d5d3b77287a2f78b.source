    def test_ps2_preemptive_targets_nearest(self):
        """PS2(130042) 先制攻撃目标为自身最近敵单体。

        caster位于ALLY_CENTER_FRONT，最近敌方是ENEMY_CENTER_FRONT(enemy_front)。
        验证enemy_back(中后)和enemy_right(右前)不受伤害。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.bf.turn_number = 2
        self.caster.skill_levels[130042] = 10
        self.caster.current_pp = 10

        hp_front_before = self.enemy_front.current_hp
        hp_back_before = self.enemy_back.current_hp
        hp_right_before = self.enemy_right.current_hp

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130042]
        self.assertGreater(len(ps2_actions), 0, "PS2应在第2回合触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 仅最近敌方受到伤害
        self.assertLess(self.enemy_front.current_hp, hp_front_before,
                        "最近敌方enemy_front应受到先制伤害")
        # 其他敌方不应受到伤害
        self.assertEqual(self.enemy_back.current_hp, hp_back_before,
                         "enemy_back不是最近敌方，不应受到伤害")
        self.assertEqual(self.enemy_right.current_hp, hp_right_before,
                         "enemy_right不是最近敌方，不应受到伤害")


if __name__ == '__main__':
    unittest.main()
