    def test_ps1_target_is_self_other_ally_no_trigger(self):
        """PS1(130026) global_condition target_is_self：其他友方被攻击不触发。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.skill_levels[130026] = 10
        self.caster.skill_cooldowns = {}
        self.caster.current_pp = 10

        # 添加其他友方
        other_ally = UnitState(
            unit_id="ally_other", name="其他友方", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999100, level=10,
            element=1, character_type=1,
            max_hp=10000, current_hp=10000,
            attack=5000, defense=3000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.bf.friend_team = [self.caster, other_ally]

        # 其他友方被攻击时不应触发PS1
        actions = self.ts.trigger_before_any_attacked(
            targets=[other_ally], battlefield=self.bf, attacker=self.enemy_front
        )
        ps1_actions = [a for a in actions if a.skill_id == 130026]
        self.assertEqual(len(ps1_actions), 0,
                         "其他友方被攻击不应触发PS1（target_is_self）")

    def test_ps1_dmg_taken_up_stackable(self):
        """PS1(130026) Lv1-14: dmg_taken_up stackable，连续触发应叠加。

        同一回合多次被攻击前触发PS1，dmg_taken_up应叠加。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.skill_levels[130026] = 10
        self.caster.skill_cooldowns = {}
        self.caster.current_pp = 10

        # 第一次触发
        actions1 = self.ts.trigger_before_any_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_front
        )
        ps1_actions1 = [a for a in actions1 if a.skill_id == 130026]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions1, self.bf, trigger_timing="before_any_attacked"
        )

        dmg_buffs_1 = [d for d in self.caster.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_buffs_1), 1, "第一次应有1个dmg_taken_up")

        # 第二次触发（PP充足）
        self.caster.skill_cooldowns = {}
        actions2 = self.ts.trigger_before_any_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_front
        )
        ps1_actions2 = [a for a in actions2 if a.skill_id == 130026]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions2, self.bf, trigger_timing="before_any_attacked"
        )

        # 验证stackable：两个独立的dmg_taken_up debuff
        dmg_buffs_2 = [d for d in self.caster.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_buffs_2), 2, "第二次触发应叠加为2个dmg_taken_up debuff")

    # ─── PS2: 130042 エモーショナルエッジ ───

    def test_ps2_round1_no_trigger(self):
        """PS2(130042) 第1回合不发动（global_condition round_number > 1）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.bf.turn_number = 1

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130042]
        self.assertEqual(len(ps2_actions), 0, "PS2不应在第1回合发动")

    def test_ps2_round2_preemptive_attack_and_critical_forbidden(self):
        """PS2(130042) 第2回合+: 先制攻撃 + critical_forbidden 2行動。

        caster最近敌方是enemy_front，应受到先制伤害。
        critical_forbidden debuff持续2行動。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.bf.turn_number = 2
        self.caster.skill_levels[130042] = 10
        self.caster.current_pp = 10

        hp_front_before = self.enemy_front.current_hp

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130042]
        self.assertGreater(len(ps2_actions), 0, "PS2应在第2回合触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证最近敌方受到先制伤害
        self.assertLess(self.enemy_front.current_hp, hp_front_before,
                        "enemy_front应受到先制攻撃伤害")

        # 验证critical_forbidden debuff
        cf_buffs = [d for d in self.enemy_front.debuffs if d.effect_type == CRITICAL_FORBIDDEN]
        self.assertEqual(len(cf_buffs), 1, "应有1个critical_forbidden debuff")
        self.assertEqual(cf_buffs[0].duration, 2, "critical_forbidden持续2行動")

