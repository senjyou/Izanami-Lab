"""45个无 test_actor 文件角色的 smoke test（数据完整性验证）。

验证维度：
1. 角色数据可从 characters.json 加载
2. 角色技能可从 character_skills.json 加载
3. 每个技能在 skill_effects_hybrid.json 中存在
4. 技能 parse_status 不为 'failed'
5. 技能 effect_blocks 非空（manual/ok 状态下）
6. PS 技能的 trigger_type 在 TRIGGER_TYPE_MAP 中已注册
7. 技能 skill_type 合法（1=AS, 2=PS, 3=EX）

分层策略：
- 本 smoke test 提供基础数据完整性覆盖，避免角色配置损坏未被发现
- 详细的 E2E 测试（T-P3-1b）按需补充，聚焦机制复杂/使用频繁的角色
"""
import json
import os
import sys
import unittest

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.combat_v2.services.trigger_service import TRIGGER_TYPE_MAP


# 45个无 test_actor 文件的角色 ID
MISSING_ACTOR_IDS = [
    100201, 101201, 101301, 102201, 102301, 102302, 103201, 103301, 103302,
    104201, 105301, 105302, 107301, 111301, 112302, 113302, 114301, 115301,
    117302, 118301, 120301, 121301, 122201, 124201, 125101, 125301, 126101,
    126301, 127101, 128101, 129302, 130301, 130302, 131302, 132301, 134301,
    135301, 138301, 140301, 141301, 142301, 142302, 144301, 149301, 154301,
]


class TestActorSmokeBase(unittest.TestCase):
    """共享的 setUpClass：加载游戏数据。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()
        # 加载原始 characters.json 与 character_skills.json
        base = os.path.join(os.path.dirname(__file__), '..')
        with open(os.path.join(base, 'data', 'characters.json'), 'r', encoding='utf-8') as f:
            cls.chars = json.load(f)
        with open(os.path.join(base, 'data', 'character_skills.json'), 'r', encoding='utf-8') as f:
            cls.char_skills = json.load(f)


def _make_test_class(character_id: int):
    """为单个角色生成一个 TestCase 类。"""

    class _TestClass(TestActorSmokeBase):
        """角色 {cid} 数据完整性 smoke test。"""

        def test_character_data_loadable(self):
            """角色数据可从 characters.json 加载。"""
            cdata = self.chars.get(str(character_id))
            self.assertIsNotNone(
                cdata, f"character_id={character_id} not found in characters.json")
            self.assertEqual(
                cdata.get('character_id'), character_id,
                f"character_id mismatch: expected {character_id}, got {cdata.get('character_id')}")
            # 必要字段
            for field in ['name', 'character_type', 'attribute']:
                self.assertIn(field, cdata, f"missing field '{field}' for {character_id}")

        def test_character_skills_loadable(self):
            """角色技能可从 character_skills.json 加载。"""
            skills_entry = self.char_skills.get(str(character_id))
            if skills_entry is None:
                skills_entry = self.char_skills.get(character_id)
            self.assertIsNotNone(
                skills_entry,
                f"character_id={character_id} not found in character_skills.json")
            # 应该有至少1个技能
            if isinstance(skills_entry, list):
                self.assertGreater(len(skills_entry), 0,
                                   f"character_id={character_id} has empty skill list")
            elif isinstance(skills_entry, dict):
                total = sum(len(v) if isinstance(v, list) else 1
                            for v in skills_entry.values())
                self.assertGreater(total, 0,
                                   f"character_id={character_id} has empty skill dict")

        def test_all_skills_in_hybrid(self):
            """角色的每个技能 ID 在 skill_effects_hybrid.json 中存在。"""
            skills_entry = self.char_skills.get(str(character_id))
            if skills_entry is None:
                skills_entry = self.char_skills.get(character_id)
            # 收集所有技能 ID
            skill_ids = []
            if isinstance(skills_entry, list):
                for s in skills_entry:
                    sid = s.get('skill_id') or s.get('Id') or s.get('id')
                    if sid:
                        skill_ids.append(int(sid))
            elif isinstance(skills_entry, dict):
                # 可能是 {'AS': [...], 'PS': [...], 'EX': [...]} 或 {skill_id: ...}
                for k, v in skills_entry.items():
                    if isinstance(v, list):
                        for s in v:
                            sid = s.get('skill_id') or s.get('Id') or s.get('id') if isinstance(s, dict) else s
                            if sid:
                                skill_ids.append(int(sid))
                    elif isinstance(v, dict):
                        sid = v.get('skill_id') or v.get('Id') or v.get('id')
                        if sid:
                            skill_ids.append(int(sid))
                    else:
                        try:
                            skill_ids.append(int(k))
                        except (ValueError, TypeError):
                            pass

            self.assertGreater(len(skill_ids), 0,
                               f"character_id={character_id}: no skill IDs extracted")

            # 每个技能应在 hybrid 中存在
            for sid in skill_ids:
                parsed = self.dl.get_parsed_skill_data(sid)
                self.assertIsNotNone(
                    parsed, f"character_id={character_id}: skill_id={sid} not in skill_effects_hybrid.json")

        def test_skills_parse_status_not_failed(self):
            """角色的每个技能 parse_status 不为 'failed'。"""
            skills_entry = self.char_skills.get(str(character_id))
            if skills_entry is None:
                skills_entry = self.char_skills.get(character_id)
            skill_ids = _extract_skill_ids(skills_entry)
            failed_skills = []
            for sid in skill_ids:
                parsed = self.dl.get_parsed_skill_data(sid)
                if parsed is None:
                    failed_skills.append((sid, "not in hybrid"))
                    continue
                status = parsed.get('parse_status', 'unknown')
                if status == 'failed':
                    failed_skills.append((sid, "parse_status=failed"))
            self.assertEqual(
                failed_skills, [],
                f"character_id={character_id}: skills with parse issues: {failed_skills}")

        def test_ps_skills_trigger_type_valid(self):
            """角色的 PS 技能 (skill_type=2) trigger_type 在 TRIGGER_TYPE_MAP 中已注册。"""
            skills_entry = self.char_skills.get(str(character_id))
            if skills_entry is None:
                skills_entry = self.char_skills.get(character_id)
            skill_ids = _extract_skill_ids(skills_entry)
            invalid_triggers = []
            for sid in skill_ids:
                parsed = self.dl.get_parsed_skill_data(sid)
                if parsed is None:
                    continue
                if parsed.get('skill_type') != 2:
                    continue  # 仅检查 PS
                trig = parsed.get('trigger_type')
                if not trig:
                    invalid_triggers.append((sid, "trigger_type is None/empty"))
                    continue
                if trig not in TRIGGER_TYPE_MAP:
                    invalid_triggers.append((sid, f"trigger_type='{trig}' not in TRIGGER_TYPE_MAP"))
            self.assertEqual(
                invalid_triggers, [],
                f"character_id={character_id}: PS skills with invalid trigger_type: {invalid_triggers}")

        def test_skills_have_effect_blocks(self):
            """角色的非 failed 技能应有效果配置（effect_blocks 非空 或 有 value_tag 等）。"""
            skills_entry = self.char_skills.get(str(character_id))
            if skills_entry is None:
                skills_entry = self.char_skills.get(character_id)
            skill_ids = _extract_skill_ids(skills_entry)
            empty_skills = []
            for sid in skill_ids:
                parsed = self.dl.get_parsed_skill_data(sid)
                if parsed is None:
                    continue
                status = parsed.get('parse_status', 'unknown')
                if status == 'failed':
                    continue  # failed 的不检查 effect_blocks
                blocks = parsed.get('effect_blocks', [])
                if len(blocks) == 0:
                    # 某些 PS 可能没有 effect_blocks（纯被动），但通常应有
                    # 这里仅记录，不 fail（避免误报）
                    pass
            # 此测试不产生 fail，仅作为信息收集
            # 实际断言在 test_skills_parse_status_not_failed 中

    _TestClass.__name__ = f"TestActorSmoke_{character_id}"
    _TestClass.__qualname__ = f"TestActorSmoke_{character_id}"
    return _TestClass


def _extract_skill_ids(skills_entry):
    """从 character_skills.json 的 entry 中提取所有技能 ID。"""
    skill_ids = []
    if skills_entry is None:
        return skill_ids
    if isinstance(skills_entry, list):
        for s in skills_entry:
            sid = s.get('skill_id') or s.get('Id') or s.get('id') if isinstance(s, dict) else s
            if sid:
                skill_ids.append(int(sid))
    elif isinstance(skills_entry, dict):
        for k, v in skills_entry.items():
            if isinstance(v, list):
                for s in v:
                    sid = s.get('skill_id') or s.get('Id') or s.get('id') if isinstance(s, dict) else s
                    if sid:
                        skill_ids.append(int(sid))
            elif isinstance(v, dict):
                sid = v.get('skill_id') or v.get('Id') or v.get('id')
                if sid:
                    skill_ids.append(int(sid))
            else:
                try:
                    skill_ids.append(int(k))
                except (ValueError, TypeError):
                    pass
    return skill_ids


# 为每个角色动态生成 TestCase 类
_test_classes = []
for _cid in MISSING_ACTOR_IDS:
    _cls = _make_test_class(_cid)
    globals()[_cls.__name__] = _cls
    _test_classes.append(_cls)


if __name__ == '__main__':
    unittest.main()
