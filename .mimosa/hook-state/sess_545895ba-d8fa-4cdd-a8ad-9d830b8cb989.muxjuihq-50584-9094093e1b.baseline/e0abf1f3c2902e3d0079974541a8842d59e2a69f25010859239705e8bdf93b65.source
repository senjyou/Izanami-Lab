    def test_ps_shokiku_and_suekiku_atk_up_value_differs(self):
        """PS 小吉(atk1) vs 末吉(atk2): 異なるvalue_tag → 異なるbuff值。"""
        # 小吉
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.ss.set_branch_override(lambda ctx: 3)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )
        shokiku_value = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK][0].value

        # 末吉
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.ss.set_branch_override(lambda ctx: 4)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )
        suekiku_value = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK][0].value

        # atk1 と atk2 は異なるtagなので値も異なる可能性が高い（同じ場合は別途確認）
        # ここでは両者が明確に数値であることを検証
        self.assertIsInstance(shokiku_value, (int, float))
        self.assertIsInstance(suekiku_value, (int, float))

    # ════════════════════════════════════════════════════════════════
    # random_choice 专项（4分支权重 + 単一分支執行 + Block5独立）
    # ════════════════════════════════════════════════════════════════

    def test_random_choice_weights_correct(self):
        """random_choice 4分支权重: 大吉10/中吉20/小吉30/末吉40。"""
        parsed = self.dl.get_parsed_skill_data(PS_OMIKUJI)
        blocks = parsed.get('effect_blocks', [])
        rc_blocks = [b for b in blocks if b.get('condition', {}).get('type') == 'random_choice']
        self.assertEqual(len(rc_blocks), 4, "应有4个 random_choice block")

        weights = [b['condition']['weight'] for b in rc_blocks]
        self.assertEqual(weights, [10, 20, 30, 40],
                         "权重: 大吉10/中吉20/小吉30/末吉40")

        # 全て同じ group_id=0
        groups = [b['condition'].get('group_id', 0) for b in rc_blocks]
        self.assertTrue(all(g == 0 for g in groups), "全て group_id=0")

    def test_random_choice_only_one_branch_executes(self):
        """random_choice: 4分支中只執行1つ（他はskip）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()

        # 大吉(Block1)を強制選択
        self.ss.set_branch_override(lambda ctx: 1)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )

        # 大吉の penetrate_defense buff のみ付与、小吉/末吉の atk_up は付与されない
        pen_buffs = [b for b in self.caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 1, "大吉のbuffのみ")

        atk_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 0,
                         "大吉選択時、小吉/末吉のatk_upは付与されない")

    def test_random_choice_block5_lv11_independent_of_branch(self):
        """random_choice Block5(Lv11+): 抽選結果に依存せず常に実行。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10, level=15)
        self._reset_enemies()

        # 大吉(Block1)を選択しても Block5(Lv11+)は別条件で常に実行
        self.ss.set_branch_override(lambda ctx: 1)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )

        # 大吉の penetrate_defense + Lv11+の dmg_dealt_up 両方
        pen_buffs = [b for b in self.caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 1, "大吉 penetrate_defense 付与")

        dmg_buffs = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_buffs), 0, "Lv11+ dmg_dealt_up 也应付与")
        self.assertTrue(dmg_buffs[0].is_stackable, "dmg_dealt_up stackable")
        self.assertEqual(getattr(dmg_buffs[0], 'attack_limited', 0), 1,
                         "dmg_dealt_up attack_limited=1")

    def test_random_choice_block5_lv10_not_executed(self):
        """random_choice Block5(Lv10): active_level_min=11 未満なので実行されない。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10, level=10)
        self._reset_enemies()

        self.ss.set_branch_override(lambda ctx: 1)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )

        dmg_buffs = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_buffs), 0, "Lv10 Block5 不実行")

    def test_random_choice_all_branches_executable(self):
        """random_choice 4分支: 各分支を個別に選択して実行可能。"""
        for block_id, expected_effect, expected_value_check in [
            (1, PENETRATE_DEFENSE, lambda b: b.value == 50),
            (2, PENETRATE_DEFENSE, lambda b: b.value == 25),
            (3, STATUS_ATTACK, lambda b: b.value > 0),
            (4, STATUS_ATTACK, lambda b: b.value > 0),
        ]:
            with self.subTest(block_id=block_id):
                self._reset_caster(hp=self.caster.max_hp, pp=10)
                self._reset_enemies()
                self.ss.set_branch_override(lambda ctx, bid=block_id: bid)
                self.ss.execute_skill(
                    caster=self.caster, skill_id=PS_OMIKUJI,
                    battlefield=self.bf, skip_cost=True
                )
                matching = [b for b in self.caster.buffs if b.effect_type == expected_effect]
                self.assertGreater(len(matching), 0,
                                   f"Block{block_id} 应付与 {expected_effect}")
                self.assertTrue(expected_value_check(matching[0]),
                                f"Block{block_id} 値チェック失敗: {matching[0].value}")

    # ════════════════════════════════════════════════════════════════
    # PS buff 消費タイミング专项
    # ════════════════════════════════════════════════════════════════

    def test_ps_buff_persists_after_ps_no_damage(self):
        """PS buff: PS実行後も残存（PS無傷害のためattack_limited消費スキップ）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()

        self.ss.set_branch_override(lambda ctx: 1)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )

        pen_buffs = [b for b in self.caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 1, "PS実行直後: buff存在")

        # PS自体はダメージを与えないので、buffは残存する
        # 注: PSの実行自体は attack_limited を消費しない
        self.assertEqual(getattr(pen_buffs[0], 'attack_limited', 0), 1,
                         "PS実行後も attack_limited=1 のまま")

    def test_ps_buff_consumed_after_as_skill(self):
        """PS buff: AS実行後に消費（attack_limited=1, AS終了時消費）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()

        # Step 1: PS大吉実行 → penetrate_defense buff付与
        self.ss.set_branch_override(lambda ctx: 1)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )
        pen_buffs = [b for b in self.caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 1, "PS後: buff存在")

        # Step 2: AS実行 → buff消費
        self.ss.clear_branch_override()
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )

        pen_buffs = [b for b in self.caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 0,
                         "AS実行後: buff应消費（attack_limited=1）")

    # ════════════════════════════════════════════════════════════════
    # 集成シナリオ: PS buff + AS攻撃 全鏈路
    # ════════════════════════════════════════════════════════════════

    def test_integration_daikiku_penetrate_increases_as_damage(self):
        """集成: PS大吉(50%穿防) + AS3 → ダメージ増加。

        完全鏈路:
        1. PS大吉 → penetrate_defense 50% buff付与
        2. AS3攻撃 → 穿防適用で敵防御半減 → ダメージ増加
        3. buff消費
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        # 高防御の敵で穿防効果を明確化
        self.enemy_cf.defense = 8000

        # Step 1: PS大吉 → 50%穿防buff
        self.ss.set_branch_override(lambda ctx: 1)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )
        pen_buffs = [b for b in self.caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(len(pen_buffs), 1, "大吉 buff付与")

        # Step 2: AS3攻撃（穿防適用）
        self.ss.clear_branch_override()
        hp_before_with_pen = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        dmg_with_penetrate = hp_before_with_pen - self.enemy_cf.current_hp

        # Step 3: 穿防なしでAS3 → ダメージ比較
        self._reset_enemy(self.enemy_cf)
        self.enemy_cf.defense = 8000
        hp_before_no_pen = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        dmg_without_penetrate = hp_before_no_pen - self.enemy_cf.current_hp

        # 穿防50%時の方がダメージが大きい
        self.assertGreater(dmg_with_penetrate, dmg_without_penetrate,
                           f"大吉(50%穿防) dmg={dmg_with_penetrate} 应 > 無穿防 dmg={dmg_without_penetrate}")

    def test_integration_chukiku_penetrate_25_increases_as_damage(self):
        """集成: PS中吉(25%穿防) + AS3 → ダメージ増加（大吉より効果小）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.enemy_cf.defense = 8000

        # PS中吉 → 25%穿防
        self.ss.set_branch_override(lambda ctx: 2)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )
        pen_buffs = [b for b in self.caster.buffs if b.effect_type == PENETRATE_DEFENSE]
        self.assertEqual(pen_buffs[0].value, 25, "中吉 penetrate value=25")

        # AS3攻撃（25%穿防適用）
        self.ss.clear_branch_override()
        hp_before = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        dmg_with_25pen = hp_before - self.enemy_cf.current_hp

        # 無穿防
        self._reset_enemy(self.enemy_cf)
        self.enemy_cf.defense = 8000
        hp_before = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        dmg_no_pen = hp_before - self.enemy_cf.current_hp

        self.assertGreater(dmg_with_25pen, dmg_no_pen,
                           "中吉(25%穿防)也应增加伤害")

    def test_integration_shokiku_atk_up_increases_as_damage(self):
        """集成: PS小吉(atk_up) + AS3 → ダメージ増加。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()

        # PS小吉 → atk_up buff
        self.ss.set_branch_override(lambda ctx: 3)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )
        atk_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_buffs), 0, "小吉 atk_up buff付与")

        # AS3攻撃（atk_up適用）
        self.ss.clear_branch_override()
        hp_before_with_buff = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        dmg_with_atk_up = hp_before_with_buff - self.enemy_cf.current_hp

        # buffなしでAS3 → ダメージ比較
        self._reset_enemy(self.enemy_cf)
        self.caster.buffs = []  # buff全削除
        hp_before_no_buff = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        dmg_without_atk_up = hp_before_no_buff - self.enemy_cf.current_hp

        self.assertGreater(dmg_with_atk_up, dmg_without_atk_up,
                           "小吉(atk_up) 应增加伤害")

    def test_integration_lv11_dmg_dealt_up_increases_as_damage(self):
        """集成: PS Lv11+ dmg_dealt_up + AS3 → ダメージ増加。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10, level=15)
        self._reset_enemies()

        # PS Lv15 大吉選択 → penetrate_defense + dmg_dealt_up 両方
        self.ss.set_branch_override(lambda ctx: 1)
        self.ss.execute_skill(
            caster=self.caster, skill_id=PS_OMIKUJI, battlefield=self.bf, skip_cost=True
        )
        dmg_buffs = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_buffs), 0, "Lv15 dmg_dealt_up 付与")

        # AS3攻撃
        self.ss.clear_branch_override()
        hp_before = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        dmg_with_buff = hp_before - self.enemy_cf.current_hp
        self.assertGreater(dmg_with_buff, 0, "应造成伤害")

    # ════════════════════════════════════════════════════════════════
    # 凍結附魔 統合テスト（EX + AS連携）
    # ════════════════════════════════════════════════════════════════

    def test_integration_ex_freeze_then_as_breaks_freeze(self):
        """集成: EX凍結付与 → AS3攻撃で凍結解除 + 増傷ダメージ。"""
        self._reset_caster(hp=self.caster.max_hp, level=15)
        self._reset_enemies()

        # Step 1: EX(Lv15)で凍結付与
        self.ss.execute_skill(
            caster=self.caster, skill_id=EX_DOKO, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(self.enemy_cf.is_frozen, "EX後 enemy_cf frozen")
        freeze_value = [d for d in self.enemy_cf.debuffs if d.effect_type == FREEZE][0].value

        # Step 2: AS3攻撃 → 凍結解除 + 増傷
        hp_before_as = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        # 凍結解除
        self.assertFalse(self.enemy_cf.is_frozen, "AS後 frozen 解除")
        freeze_after = [d for d in self.enemy_cf.debuffs if d.effect_type == FREEZE]
        self.assertEqual(len(freeze_after), 0, "AS後 freeze debuff 除去")

    def test_integration_ex_freeze_applied_to_adjacent_targets(self):
        """集成: EX Lv11+ 凍結は主目標+鄰接2体の全3体に付与。"""
        self._reset_caster(hp=self.caster.max_hp, level=15)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=EX_DOKO, battlefield=self.bf, skip_cost=True
        )

        # 全3体が凍結状態
        for enemy, label in [(self.enemy_cf, "cf"), (self.enemy_lf, "lf"), (self.enemy_rf, "rf")]:
            self.assertTrue(enemy.is_frozen, f"{label} 凍結状態")
            freeze_debuffs = [d for d in enemy.debuffs if d.effect_type == FREEZE]
            self.assertGreater(len(freeze_debuffs), 0, f"{label} freeze debuff 存在")

    # ════════════════════════════════════════════════════════════════
    # attacked_targets 专项（跨block累积）
    # ════════════════════════════════════════════════════════════════

    def test_ex_attacked_targets_includes_main_and_adjacent(self):
        """EX attacked_targets: 主目標+鄰接2体の全3体が累積される。"""
        self._reset_caster(hp=self.caster.max_hp, level=15)
        self._reset_enemies()

        # EX Block2 で attacked_targets に凍結が付与される → 全3体に凍結
        # これで attacked_targets が主+鄰接を含むことを間接検証
        self.ss.execute_skill(
            caster=self.caster, skill_id=EX_DOKO, battlefield=self.bf, skip_cost=True
        )

        # 全3体に凍結（attacked_targets が正しく累積されている証拠）
        for enemy, label in [(self.enemy_cf, "cf"), (self.enemy_lf, "lf"), (self.enemy_rf, "rf")]:
            freeze_debuffs = [d for d in enemy.debuffs if d.effect_type == FREEZE]
            self.assertGreater(len(freeze_debuffs), 0,
                               f"{label} 应有 freeze（attacked_targets 累積）")

    def test_as2_attacked_targets_includes_all_row_targets(self):
        """AS2 attacked_targets: 前排3人全てが累積される。"""
        self._reset_caster(hp=self.caster.max_hp, level=15)
        self._reset_enemies()

        # AS2 Block2 で attacked_targets に dmg_dealt_down が付与される → 全3体にデバフ
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_YAKU, battlefield=self.bf, skip_cost=True
        )

        # 全3体に dmg_dealt_down（attacked_targets が前排3人を含む証拠）
        for enemy, label in [(self.enemy_cf, "cf"), (self.enemy_lf, "lf"), (self.enemy_rf, "rf")]:
            debuffs = [d for d in enemy.debuffs if d.effect_type == DEALT_DAMAGE]
            self.assertGreater(len(debuffs), 0,
                               f"{label} 应有 dmg_dealt_down（attacked_targets 累積）")

    # ════════════════════════════════════════════════════════════════
    # 配置検証（スキル効果設定の整合性）
    # ════════════════════════════════════════════════════════════════

    def test_config_all_5_skills_exist(self):
        """配置検証: 5技能すべてがskill_effects_hybrid.jsonに存在。"""
        for sid in [EX_DOKO, AS_HAMA, AS_YAKU, AS_SHO, PS_OMIKUJI]:
            parsed = self.dl.get_parsed_skill_data(sid)
            self.assertIsNotNone(parsed, f"skill {sid} 应存在")

    def test_config_ex_block1_has_two_damage_effects(self):
        """配置検証: EX Block1 は enemy_single + adjacent_enemies の2つのdamage効果。"""
        parsed = self.dl.get_parsed_skill_data(EX_DOKO)
        blocks = parsed.get('effect_blocks', [])
        b1_effects = blocks[0].get('effects', [])
        dmg_effs = [e for e in b1_effects if e.get('effect_type') == 'damage']
        self.assertEqual(len(dmg_effs), 2, "Block1 应有2个 damage 效果")
        self.assertEqual(dmg_effs[0].get('target_type'), 'enemy_single')
        self.assertEqual(dmg_effs[1].get('target_type'), 'adjacent_enemies')
        self.assertEqual(dmg_effs[1].get('flags', {}).get('target_count'), 2)

    def test_config_ex_block2_lv11_freeze_attacked_targets(self):
        """配置検証: EX Block2 は Lv11+ add_status(freeze) to attacked_targets。"""
        parsed = self.dl.get_parsed_skill_data(EX_DOKO)
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(blocks[1].get('condition', {}).get('type'), 'active_level_min')
        self.assertEqual(blocks[1].get('condition', {}).get('value'), 11)
        b2_effects = blocks[1].get('effects', [])
        freeze_effs = [e for e in b2_effects if e.get('effect_type') == 'add_status']
        self.assertEqual(len(freeze_effs), 1)
        self.assertEqual(freeze_effs[0].get('target_type'), 'attacked_targets')
        self.assertEqual(freeze_effs[0].get('flags', {}).get('status_type'), 'freeze')

    def test_config_as1_enemy_column_target(self):
        """配置検証: AS1 は enemy_column（縦列2人）。"""
        parsed = self.dl.get_parsed_skill_data(AS_HAMA)
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(blocks[0]['effects'][0]['target_type'], 'enemy_column')

    def test_config_as2_enemy_row_target(self):
        """配置検証: AS2 は enemy_row（横一列3人）。"""
        parsed = self.dl.get_parsed_skill_data(AS_YAKU)
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(blocks[0]['effects'][0]['target_type'], 'enemy_row')

    def test_config_as3_no_cooldown(self):
        """配置検証: AS3 は無冷却。"""
        parsed = self.dl.get_parsed_skill_data(AS_SHO)
        self.assertIsNone(parsed.get('cooldown'))

    def test_config_ps_trigger_before_skill_use(self):
        """配置検証: PS は before_skill_use トリガー。"""
        parsed = self.dl.get_parsed_skill_data(PS_OMIKUJI)
        self.assertEqual(parsed.get('trigger_type'), 'before_skill_use')

    def test_config_ps_global_condition_self_hp_50(self):
        """配置検証: PS global_condition は self_hp_percent>=50。"""
        parsed = self.dl.get_parsed_skill_data(PS_OMIKUJI)
        gc = parsed.get('global_condition')
        self.assertEqual(gc.get('type'), 'self_hp_percent')
        self.assertEqual(gc.get('operator'), '>=')
        self.assertEqual(gc.get('value'), 50)

    def test_config_ps_block5_lv11_dmg_dealt_up(self):
        """配置検証: PS Block5 は Lv11+ dmg_dealt_up。"""
        parsed = self.dl.get_parsed_skill_data(PS_OMIKUJI)
        blocks = parsed.get('effect_blocks', [])
        b5 = blocks[4]
        self.assertEqual(b5.get('condition', {}).get('type'), 'active_level_min')
        self.assertEqual(b5.get('condition', {}).get('value'), 11)
        effs = b5.get('effects', [])
        self.assertEqual(effs[0].get('effect_type'), 'dmg_dealt_up')
        self.assertEqual(effs[0].get('flags', {}).get('attack_limited'), 1)
        self.assertTrue(effs[0].get('flags', {}).get('stackable'))


if __name__ == "__main__":
    unittest.main()
