    # AS3: 120092 必勝祈願（enemy_single + 無冷却）
    # ════════════════════════════════════════════════════════════════

    def test_as3_targets_only_nearest_enemy(self):
        """AS3: 最近敵(中前)のみ攻撃、他は被弾しない。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_before = {u.unit_id: u.current_hp for u in
                     [self.enemy_cf, self.enemy_lf, self.enemy_rf, self.enemy_cb]}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 最近敵(enemy_cf) のみ被弾
        self.assertLess(self.enemy_cf.current_hp, hp_before['enemy_cf'],
                        "最近敵 enemy_cf 应被攻撃")
        # 他は被弾しない
        self.assertEqual(self.enemy_lf.current_hp, hp_before['enemy_lf'],
                         "enemy_lf 不应被攻撃（単体）")
        self.assertEqual(self.enemy_rf.current_hp, hp_before['enemy_rf'],
                         "enemy_rf 不应被攻撃（単体）")
        self.assertEqual(self.enemy_cb.current_hp, hp_before['enemy_cb'],
                         "enemy_cb 不应被攻撃（単体）")

    def test_as3_no_cooldown(self):
        """AS3: 無冷却。使用後 cooldown 設定なし。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        self.assertNotIn(AS_SHO, self.caster.skill_cooldowns,
                         "AS3 应无 cooldown")

    def test_as3_consecutive_uses_no_cooldown(self):
        """AS3: 連続使用可能（無冷却）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 1回目
        result1 = self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result1["success"])

        # 2回目（cooldown なしで即時使用可能）
        self._reset_enemies()
        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=AS_SHO, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result2["success"], "AS3 无冷却应可连续使用")

