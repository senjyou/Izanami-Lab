#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
RDPSTracker 单元测试
tests/test_rdps_tracker.py

测试覆盖：
1. 守恒性验证（sum_unit_rdps + sum_memory_rdps == total_damage）
2. 直接伤害归因（无 buff 时全归攻击者）
3. ATK buff 归因（增益贡献归 buff 施加者）
4. DEF debuff 归因（减益贡献归 debuff 施加者）
5. 暴击归因（三分割：crit_damage_up / crit_rate_up / inherent）
6. 附魔/追加/子单位伤害归因（100% 归 buff 提供者）
7. HP比例伤害归因（cap 触及/未触及）
8. 特殊伤害归因（self_max_hp / self_current_hp / ATK 模式）
9. 记忆卡独立统计
10. 多来源 buff 按值比例归因
11. 敌方减伤作为前提（baseline_ally 保留敌方 buff）
12. enable_rdps 开关功能
"""

import sys
import unittest
from unittest.mock import MagicMock, patch
from pathlib import Path
from dataclasses import dataclass

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.enums import Side, Position, UnitActionPhase, Attribute, CharacterType, SkillEffectType
from src.entities_v2.battlefield_state import BattlefieldState
from src.combat_v2.services.damage_service import DamageService, DamageResult
from src.combat_v2.rdps_tracker import RDPSTracker, UnitRDPSStats, MemoryCardRDPSStats, RDPSResult
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig


def make_unit(unit_id="a1", name="TestAlly", side=Side.ALLY,
              attack=1000, defense=500, max_hp=10000, crit_rate=0.0, crit_damage=0.0,
              element=1, character_type=1, position=Position.ALLY_LEFT_FRONT):
    """创建测试用单位"""
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=100001, level=80, element=element, character_type=character_type,
        max_hp=max_hp, attack=attack, defense=defense, speed=100,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=3, initial_passive_point=3, max_extra_point=5,
        current_hp=max_hp, current_ap=3, current_pp=3, current_ep=0,
    )


def make_buff(buff_id, name, effect_type, value, source_unit_id="a1",
              source_skill_id=0, is_memory_buff=False, is_stackable=False,
              value_tag=0, is_debuff=False):
    """创建测试用 buff"""
    return BuffState(
        buff_id=buff_id, name=name, effect_type=effect_type,
        value=value, duration=3, timing_type=2,
        source_unit_id=source_unit_id, source_skill_id=source_skill_id,
        is_memory_buff=is_memory_buff, is_stackable=is_stackable,
        value_tag=value_tag, is_debuff=is_debuff,
    )


def make_dmg_result(total_damage, is_critical=False, calc_detail=None,
                    hit_details=None, hit_crits=None):
    """创建测试用 DamageResult"""
    if hit_details is None:
        hit_details = [total_damage]
    if hit_crits is None:
        hit_crits = [is_critical]
    return DamageResult(
        total_damage=total_damage,
        is_critical=is_critical,
        attribute_factor=1.0,
        hit_details=hit_details,
        hit_crits=hit_crits,
        hit_evades=[False],
        calc_detail=calc_detail or {},
    )


class TestRDPSConservation(unittest.TestCase):
    """测试守恒性"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_no_buff_conservation(self):
        """无 buff 时守恒：direct_damage == total_damage"""
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(600, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 600, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=[self.caster, self.target])
        self.assertEqual(result.discrepancy, 0)
        self.assertEqual(result.sum_unit_rdps, 600)

    def test_with_atk_buff_conservation(self):
        """有 ATK buff 时守恒"""
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)

        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1100, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1100, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=[self.caster, self.target, supporter])
        self.assertEqual(result.discrepancy, 0)

    def test_multiple_damage_events_conservation(self):
        """多次伤害事件守恒"""
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(600, calc_detail=calc)
        for _ in range(5):
            self.tracker.record_damage_with_attribution(
                self.caster, self.target, 600, dmg, "main",
                battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=[self.caster, self.target])
        self.assertEqual(result.discrepancy, 0)
        self.assertEqual(result.sum_unit_rdps, 3000)


class TestDirectDamageAttribution(unittest.TestCase):
    """测试直接伤害归因"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_no_buff_all_direct(self):
        """无 buff 时全部归攻击者 direct_damage"""
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(600, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 600, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=[self.caster, self.target])
        stats = result.unit_stats["a1"]
        self.assertEqual(stats.direct_damage, 600)
        self.assertEqual(stats.buff_contribution, 0)
        self.assertEqual(stats.debuff_contribution, 0)

    def test_enemy_debuff_as_precondition(self):
        """敌方减伤作为前提，不参与己方归因"""
        # 敌方自身有 def_up buff（作为前提保留在 baseline_ally 中）
        enemy_def_up = make_buff("e_def", "DEF Up", SkillEffectType.STATUS_DEFENSE.value,
                                 50, source_unit_id="e1")
        self.target.buffs.append(enemy_def_up)

        # 实际伤害 350（ATK 1000 - DEF 600 = 400, 但 def_up 使 DEF=600）
        calc = {
            "atk": 1000, "def_orig": 600, "def_after_penetrate": 600,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 400,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        # baseline_ally: ATK 1000 - DEF 600 = 400 (same as actual, no ally buff)
        # bonus_ally = 0, all goes to direct_damage
        dmg = make_dmg_result(400, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 400, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=[self.caster, self.target])
        stats = result.unit_stats["a1"]
        self.assertEqual(stats.direct_damage, 400)
        self.assertEqual(stats.buff_contribution, 0)


class TestATKBuffAttribution(unittest.TestCase):
    """测试 ATK buff 归因"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.supporter = make_unit("a2", "Supporter", attack=500)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster, self.supporter]
        self.bf.enemy_team = [self.target]

    def test_atk_buff_to_supporter(self):
        """ATK buff 贡献归 supporter"""
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)

        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1100, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1100, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=[self.caster, self.supporter, self.target])

        # baseline_ally: ATK 1000 - DEF 400 = 600, actual = 1100
        # bonus = 500, all from ATK buff -> supporter
        stats_attacker = result.unit_stats["a1"]
        stats_supporter = result.unit_stats["a2"]
        self.assertEqual(stats_attacker.direct_damage, 600)
        self.assertGreater(stats_supporter.buff_contribution, 0)
        self.assertEqual(result.discrepancy, 0)

    def test_multiple_atk_buffs_proportional(self):
        """多个 ATK buff 按值比例归因"""
        atk_buff1 = make_buff("b1", "ATK Up 30%", SkillEffectType.STATUS_ATTACK.value,
                              30, source_unit_id="a2")
        atk_buff2 = make_buff("b2", "ATK Up 20%", SkillEffectType.STATUS_ATTACK.value,
                              20, source_unit_id="a3")
        self.caster.buffs.append(atk_buff1)
        self.caster.buffs.append(atk_buff2)
        supporter2 = make_unit("a3", "Supporter2", attack=500)
        self.bf.friend_team.append(supporter2)

        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1100, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1100, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        stats_s1 = result.unit_stats["a2"]
        stats_s2 = result.unit_stats["a3"]
        # 30% vs 20% => 3:2 ratio
        self.assertAlmostEqual(stats_s1.buff_contribution / stats_s2.buff_contribution, 1.5, places=1)

    def test_mixed_fixed_and_pct_atk_buffs_fair(self):
        """固值ATK buff 和 百分比ATK buff 公平归因

        场景：base_atk=1000, 支援者A给+50%ATK(等效+500), 支援者B给+500固值ATK
        两者实际各贡献500 ATK，应按 1:1 分配 bonus
        修复前：固值权重500 vs 百分比权重0.5 => 固值独占99.9%
        修复后：固值权重500 vs 百分比权重0.5*1000=500 => 1:1公平分配
        """
        pct_buff = make_buff("b1", "ATK Up 50%", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2", value_tag=0)
        fixed_buff = make_buff("b2", "ATK Up +500", SkillEffectType.STATUS_ATTACK.value,
                               500, source_unit_id="a3", value_tag=1)
        self.caster.buffs.append(pct_buff)
        self.caster.buffs.append(fixed_buff)
        supporter2 = make_unit("a3", "FixedSupporter", attack=500)
        self.bf.friend_team.append(supporter2)

        # base_atk=1000 + 50%(=500) + 500(fixed) = 2000 total ATK
        # base_diff = 2000 - 400 = 1600, baseline = 1000 - 400 = 600, bonus = 1000
        calc = {
            "atk": 2000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1600, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1600, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        stats_pct = result.unit_stats["a2"]
        stats_fixed = result.unit_stats["a3"]
        # 两者贡献应接近 1:1（各约500）
        self.assertAlmostEqual(stats_pct.buff_contribution, stats_fixed.buff_contribution,
                               delta=50,
                               msg=f"百分比buff贡献={stats_pct.buff_contribution}, "
                                   f"固值buff贡献={stats_fixed.buff_contribution}, 应接近1:1")
        self.assertEqual(result.discrepancy, 0)


class TestDebuffAttribution(unittest.TestCase):
    """测试 debuff 归因"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.supporter = make_unit("a2", "Supporter", attack=500)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster, self.supporter]
        self.bf.enemy_team = [self.target]

    def test_def_down_to_supporter(self):
        """DEF down debuff 贡献归 supporter"""
        def_down = make_buff("d1", "DEF Down", SkillEffectType.STATUS_DEFENSE.value,
                             50, source_unit_id="a2", is_debuff=True)
        self.target.debuffs.append(def_down)

        # actual: ATK 1000, DEF = 400 * (1-0.5) = 200, base_diff = 800
        # baseline: ATK 1000, DEF 400, base_diff = 600
        calc = {
            "atk": 1000, "def_orig": 200, "def_after_penetrate": 200,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 800,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(800, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 800, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        stats_supporter = result.unit_stats["a2"]
        self.assertGreater(stats_supporter.debuff_contribution, 0)
        self.assertEqual(result.discrepancy, 0)


class TestEnchantAttribution(unittest.TestCase):
    """测试附魔/追加/子单位伤害归因"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.supporter = make_unit("a2", "Supporter", attack=500)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster, self.supporter]
        self.bf.enemy_team = [self.target]

    def test_enchant_damage_to_provider(self):
        """附魔伤害 100% 归 buff 提供者"""
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 300, None, "enchant",
            enchant_source_id="a2",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats = result.unit_stats["a2"]
        self.assertEqual(stats.enchant_contribution, 300)

    def test_add_damage_to_provider(self):
        """追加伤害 100% 归 buff 提供者"""
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 250, None, "add_dmg",
            enchant_source_id="a2",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats = result.unit_stats["a2"]
        self.assertEqual(stats.enchant_contribution, 250)

    def test_sub_unit_damage_to_provider(self):
        """子单位伤害 100% 归 buff 提供者"""
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 400, None, "sub_unit",
            enchant_source_id="a2",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats = result.unit_stats["a2"]
        self.assertEqual(stats.enchant_contribution, 400)

    def test_enchant_no_source_defaults_to_caster(self):
        """附魔伤害无 source_id 时归攻击者"""
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 300, None, "enchant",
            enchant_source_id=None,
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats = result.unit_stats["a1"]
        self.assertEqual(stats.enchant_contribution, 300)


class TestHPRatioDamage(unittest.TestCase):
    """测试 HP 比例伤害归因"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_hp_ratio_no_cap_all_direct(self):
        """HP比例伤害未触及上限：全归 direct"""
        calc_detail = {
            "value_source": "target_lost_hp",
            "dmg_pct": 10,
            "base_value": 10000,
            "raw_power": 1000,
        }
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1000, None, "hp_ratio",
            calc_detail=calc_detail,
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats = result.unit_stats["a1"]
        self.assertEqual(stats.direct_damage, 1000)
        self.assertEqual(stats.buff_contribution, 0)

    def test_hp_ratio_with_cap_atk_buff(self):
        """HP比例伤害触及上限：ATK buff 归因"""
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)

        # raw_power = 20000 * 10% = 2000, cap = 1500 * 100 / 100 = 1500, raw > cap
        # actual = cap = 1500
        # baseline_cap = 1000 * 100 / 100 = 1000
        # bonus = 500 -> ATK buff
        calc_detail = {
            "value_source": "target_lost_hp",
            "dmg_pct": 10,
            "base_value": 20000,
            "raw_power": 2000,
            "cap": 1500,
            "effective_atk": 1500,
            "cap_atk_pct": 100,
        }
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1500, None, "hp_ratio",
            calc_detail=calc_detail,
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats_attacker = result.unit_stats["a1"]
        stats_supporter = result.unit_stats["a2"]
        self.assertEqual(stats_attacker.direct_damage, 1000)
        self.assertGreater(stats_supporter.buff_contribution, 0)
        self.assertEqual(result.discrepancy, 0)


class TestDamageSpecial(unittest.TestCase):
    """测试特殊伤害归因"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000, max_hp=10000)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_special_self_current_hp_all_direct(self):
        """self_current_hp 模式全归 direct"""
        calc_detail = {
            "value_source": "self_current_hp",
            "dmg_pct": 50,
            "effective_value": 10000,
            "base_value": 10000,
        }
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 5000, None, "special",
            calc_detail=calc_detail,
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats = result.unit_stats["a1"]
        self.assertEqual(stats.direct_damage, 5000)

    def test_special_atk_mode_with_buff(self):
        """ATK 模式特殊伤害受 ATK buff 影响"""
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)

        # effective_atk = 1500, raw = 1500 * 50 / 100 = 750
        # baseline = 1000 * 50 / 100 = 500
        # bonus = 250 -> ATK buff
        calc_detail = {
            "value_source": "",
            "dmg_pct": 50,
            "effective_value": 1500,
            "base_value": 1500,
        }
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 750, None, "special",
            calc_detail=calc_detail,
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats_attacker = result.unit_stats["a1"]
        stats_supporter = result.unit_stats["a2"]
        self.assertEqual(stats_attacker.direct_damage, 500)
        self.assertGreater(stats_supporter.buff_contribution, 0)
        self.assertEqual(result.discrepancy, 0)


class TestMemoryCardAttribution(unittest.TestCase):
    """测试记忆卡独立统计"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.supporter = make_unit("a2", "Supporter", attack=500)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster, self.supporter]
        self.bf.enemy_team = [self.target]

    def test_memory_card_buff_tracked(self):
        """记忆卡 buff 贡献独立统计，不双重计算到角色"""
        self.tracker.ensure_memory_card(400001, "TestCard")
        self.tracker.register_card_skill(400001, 400001)

        # 记忆卡 buff: ATK up 30%, source_skill_id = 400001
        mem_buff = make_buff("m1", "MemATK", SkillEffectType.STATUS_ATTACK.value,
                             30, source_unit_id="a1", source_skill_id=400001,
                             is_memory_buff=True)
        self.caster.buffs.append(mem_buff)

        calc = {
            "atk": 1300, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 900,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(900, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 900, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        card_stats = result.memory_card_stats.get(400001)
        self.assertIsNotNone(card_stats)
        self.assertGreater(card_stats.buff_contribution, 0)
        self.assertEqual(result.discrepancy, 0)

        # 回忆卡 buff 贡献不应双重计算到角色统计
        caster_stats = result.unit_stats.get("a1")
        self.assertIsNotNone(caster_stats)
        self.assertEqual(caster_stats.buff_contribution, 0,
                         "回忆卡 buff 贡献不应归因到角色")

    def test_memory_card_enchant_tracked(self):
        """记忆卡附魔伤害归因到回忆卡 direct_damage"""
        self.tracker.ensure_memory_card(400002, "EnchantCard")
        self.tracker.register_card_skill(400002, 400002)

        # 记忆卡附魔 buff
        enchant_buff = make_buff("e1", "MemEnchant", SkillEffectType.ENCHANT_DAMAGE.value,
                                 50, source_unit_id="a1", source_skill_id=400002,
                                 is_memory_buff=True)

        self.tracker.record_damage_with_attribution(
            caster=self.caster, target=self.target, actual_damage=200,
            damage_type="enchant",
            enchant_source_id="a1",
            battlefield=self.bf, damage_service=self.ds,
            enchant_buff=enchant_buff,
        )
        result = self.tracker.build_result(units=self.bf.get_all_units())

        card_stats = result.memory_card_stats.get(400002)
        self.assertIsNotNone(card_stats)
        self.assertEqual(card_stats.direct_damage, 200)
        self.assertEqual(card_stats.buff_contribution, 0)

        # 附魔伤害不应归因到角色的 enchant_contribution
        caster_stats = result.unit_stats.get("a1")
        self.assertIsNotNone(caster_stats)
        self.assertEqual(caster_stats.enchant_contribution, 0,
                         "回忆卡附魔伤害不应归因到角色")


class TestMemoryCardEnemyDebuffAttribution(unittest.TestCase):
    """测试回忆卡对敌方施加debuff的RDPS归因

    bug: _apply_structured_effect_to_unit 中 source_unit_id=target_unit.unit_id，
    对敌方debuff这意味着source_unit_id=敌方unit_id。_is_ally_source 通过
    source_unit_id 查找单位判断阵营，敌方单位side!=caster.side → 返回False，
    导致: (1)baseline包含该debuff → 无bonus; (2)归因排除该debuff → 无归因。
    修复: _is_ally_source 优先检查 _skill_to_card 映射，玩家回忆卡buff一律视为我方。
    """

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_received_damage_debuff_on_enemy_attributed(self):
        """400204: 回忆卡对敌方施加ReceivedDamage debuff应归因到回忆卡"""
        card_id = 30031
        skill_id = 400204
        self.tracker.ensure_memory_card(card_id, "お嬢様直伝マナー講座")
        self.tracker.register_card_skill(card_id, skill_id)

        debuff = BuffState(
            buff_id=f"memory_{skill_id}_e1",
            name="被ダメージ上昇【敵前衛】",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=7.5, duration=-1, timing_type=3, value_tag=0,
            source_unit_id="e1",
            source_skill_id=skill_id,
            is_debuff=True, is_memory_buff=True,
        )
        self.target.debuffs.append(debuff)

        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.075,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        actual_damage = 645
        dmg = make_dmg_result(actual_damage, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, actual_damage, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        card_stats = result.memory_card_stats.get(card_id)
        self.assertIsNotNone(card_stats, "回忆卡统计应存在")
        self.assertGreater(card_stats.debuff_contribution, 0,
                           "ReceivedDamage debuff应归因到回忆卡的debuff_contribution")
        self.assertEqual(result.discrepancy, 0, "守恒性应满足")

    def test_status_attack_buff_on_ally_attributed(self):
        """400064: 回忆卡对友方施加StatusAttack固值buff应归因到回忆卡"""
        card_id = 20026
        skill_id = 400064
        self.tracker.ensure_memory_card(card_id, "みんなの為なら")
        self.tracker.register_card_skill(card_id, skill_id)

        buff = BuffState(
            buff_id=f"memory_{skill_id}_a1",
            name="攻撃上昇【ノエル】",
            effect_type=SkillEffectType.STATUS_ATTACK.value,
            value=1000, duration=-1, timing_type=3, value_tag=1,
            source_unit_id="a1",
            source_skill_id=skill_id,
            is_debuff=False, is_memory_buff=True,
        )
        self.caster.buffs.append(buff)

        calc = {
            "atk": 2000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        actual_damage = 1600
        dmg = make_dmg_result(actual_damage, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, actual_damage, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        card_stats = result.memory_card_stats.get(card_id)
        self.assertIsNotNone(card_stats, "回忆卡统计应存在")
        self.assertGreater(card_stats.buff_contribution, 0,
                           "StatusAttack buff应归因到回忆卡的buff_contribution")
        self.assertEqual(result.discrepancy, 0, "守恒性应满足")

    def test_dealt_damage_buff_on_ally_attributed(self):
        """400065: 回忆卡对友方施加DealtDamage百分比buff应归因到回忆卡"""
        card_id = 20026
        skill_id = 400065
        self.tracker.ensure_memory_card(card_id, "みんなの為なら")
        self.tracker.register_card_skill(card_id, skill_id)

        buff = BuffState(
            buff_id=f"memory_{skill_id}_a1",
            name="物理ダメージ上昇【アグレッシブ】",
            effect_type=SkillEffectType.DEALT_DAMAGE.value,
            value=2.1, duration=-1, timing_type=3, value_tag=0,
            source_unit_id="a1",
            source_skill_id=skill_id,
            is_debuff=False, is_memory_buff=True,
            damage_element=1,
        )
        self.caster.buffs.append(buff)

        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.021, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        actual_damage = 612
        dmg = make_dmg_result(actual_damage, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, actual_damage, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        card_stats = result.memory_card_stats.get(card_id)
        self.assertIsNotNone(card_stats, "回忆卡统计应存在")
        self.assertGreater(card_stats.buff_contribution, 0,
                           "DealtDamage buff应归因到回忆卡的buff_contribution")
        self.assertEqual(result.discrepancy, 0, "守恒性应满足")

    def test_enemy_stage_buff_not_treated_as_ally(self):
        """回归测试: 敌方舞台增量buff(source_skill_id=0)不应被我方归因"""
        stage_buff = BuffState(
            buff_id="stage_e1_buff",
            name="Stage Buff",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=10.0, duration=-1, timing_type=0, value_tag=0,
            source_unit_id="e1",
            source_skill_id=0,
            is_debuff=True, is_memory_buff=True,
        )
        self.target.debuffs.append(stage_buff)

        is_ally = self.tracker._is_ally_source(stage_buff, self.caster)
        self.assertFalse(is_ally, "敌方舞台buff不应被判断为我方来源")

        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.10,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        actual_damage = 660
        dmg = make_dmg_result(actual_damage, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, actual_damage, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        caster_stats = result.unit_stats.get("a1")
        self.assertIsNotNone(caster_stats)
        self.assertEqual(caster_stats.direct_damage, actual_damage,
                         "舞台buff作为baseline前提，伤害全归direct")
        self.assertEqual(caster_stats.debuff_contribution, 0,
                         "舞台buff不应归因到我方角色")
        self.assertEqual(result.discrepancy, 0, "守恒性应满足")


class TestEnableRDPSSwitch(unittest.TestCase):
    """测试 enable_rdps 开关"""

    def test_rdps_disabled(self):
        """关闭 RDPS 时返回 None"""
        bf = BattlefieldState()
        config = BattleConfig(enable_rdps=False)
        controller = BattleFlowController(bf, config)
        self.assertIsNone(controller._rdps_tracker)
        self.assertIsNone(bf.rdps_tracker)

    def test_rdps_enabled(self):
        """开启 RDPS 时创建 tracker"""
        bf = BattlefieldState()
        config = BattleConfig(enable_rdps=True)
        controller = BattleFlowController(bf, config)
        self.assertIsNotNone(controller._rdps_tracker)
        self.assertIsNotNone(bf.rdps_tracker)

    def test_rdps_default_enabled(self):
        """默认开启 RDPS"""
        bf = BattlefieldState()
        config = BattleConfig()
        controller = BattleFlowController(bf, config)
        self.assertIsNotNone(controller._rdps_tracker)


class TestFullBattleIntegration(unittest.TestCase):
    """完整战斗流程集成测试"""

    def test_battle_returns_rdps_result(self):
        """战斗结果包含 rdps 字段"""
        bf = BattlefieldState()
        caster = make_unit("a1", "Attacker", attack=1000)
        target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=500, defense=300, max_hp=5000)
        bf.friend_team = [caster]
        bf.enemy_team = [target]

        config = BattleConfig(max_turns=1)
        controller = BattleFlowController(bf, config)

        # Mock execute_battle 的核心流程，直接测试返回结构
        # 这里通过实际运行一个简单的1回合战斗来验证
        with patch.object(controller, '_execute_turn', return_value=False):
            result = controller.execute_battle()

        self.assertIn("rdps", result)
        self.assertIsInstance(result["rdps"], dict)
        self.assertIn("total_damage_to_enemies", result["rdps"])
        self.assertIn("unit_stats", result["rdps"])
        self.assertIn("discrepancy", result["rdps"])


class TestEdgeCases(unittest.TestCase):
    """边界情况测试"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_zero_damage_skipped(self):
        """0 伤害不记录"""
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 0, None, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        self.assertEqual(result.total_damage_to_enemies, 0)

    def test_ally_target_skipped(self):
        """目标为己方时不记录"""
        ally = make_unit("a2", "Ally2", attack=500)
        self.bf.friend_team.append(ally)
        self.tracker.record_damage_with_attribution(
            self.caster, ally, 500, None, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        self.assertEqual(result.total_damage_to_enemies, 0)

    def test_no_calc_detail_all_direct(self):
        """无 calc_detail 时全归 direct"""
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 500, None, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats = result.unit_stats["a1"]
        self.assertEqual(stats.direct_damage, 500)

    def test_dealt_buff_attribution(self):
        """dealt_dmg_up buff 归因"""
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        dealt_buff = make_buff("b1", "Dealt Up", SkillEffectType.DEALT_DAMAGE.value,
                               30, source_unit_id="a2")
        self.caster.buffs.append(dealt_buff)

        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.3, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(780, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 780, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats_supporter = result.unit_stats["a2"]
        self.assertGreater(stats_supporter.buff_contribution, 0)
        self.assertEqual(result.discrepancy, 0)

    def test_dealt_zone_no_double_counting(self):
        """dealt 乘区不应双重计入 share

        回归测试：原实现分两次调用 _attribute_buffs_by_value（DealtDamage + SKILL_POWER_DOWN），
        各传相同 share。当只有 DealtDamage buff 无 SKILL_POWER_DOWN debuff 时，
        第二次调用触发 "no ally buffs" fallback 将同一 share 再次计入 direct_damage，
        导致 direct_damage 被虚增（等于 dealt zone share 被计了两次）。
        修复后单次调用合并归因，fallback 仅触发一次。
        """
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        dealt_buff = make_buff("b1", "Dealt Up", SkillEffectType.DEALT_DAMAGE.value,
                               30, source_unit_id="a2")
        self.caster.buffs.append(dealt_buff)

        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.3, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(780, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 780, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        stats_caster = result.unit_stats["a1"]
        stats_supporter = result.unit_stats["a2"]

        # 守恒性必须成立（修复前因双重计入会违反）
        self.assertEqual(result.discrepancy, 0)

        # direct_damage 不应包含 dealt zone 的 share（应全部归 supporter）
        # baseline_ally_non_crit = 780 / 1.3 = 600，direct 应为 600
        self.assertAlmostEqual(stats_caster.direct_damage, 600, delta=1)
        # supporter 获得 dealt zone 的全部 bonus
        self.assertGreater(stats_supporter.buff_contribution, 100)

    def test_dealt_zone_skill_power_down_debuff_only(self):
        """SKILL_POWER_DOWN debuff 不在 dealt 乘区归因

        SKILL_POWER_DOWN 影响 skill_factor（独立乘区），不影响 dealt_mult。
        baseline 使用实际 skill_factor（已含 SKILL_POWER_DOWN 效果），故 bonus=0，
        dealt 乘区无 share 产生。此为已知建模限制：SKILL_POWER_DOWN 暂无独立乘区归因。
        原实现的 bug：额外调用 SKILL_POWER_DOWN 归因时，因无 DEALT_DAMAGE buff 触发
        fallback，将不存在的 dealt zone share 计入 direct_damage（虚增 direct）。
        """
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        spd_debuff = make_buff("d1", "Skill Power Down", SkillEffectType.SKILL_POWER_DOWN.value,
                               20, source_unit_id="a2", is_debuff=True)
        self.caster.debuffs.append(spd_debuff)

        # SKILL_POWER_DOWN 影响 skill_factor（0.8），不影响 dealt_mult（1.0）
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 0.8, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(480, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 480, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        # 守恒性
        self.assertEqual(result.discrepancy, 0)
        # 全部归 direct_damage（skill_factor 变化已含在 baseline 中，bonus=0）
        stats_caster = result.unit_stats["a1"]
        self.assertAlmostEqual(stats_caster.direct_damage, 480, delta=1)
        # supporter 不应获得 dealt 乘区归因
        stats_supporter = result.unit_stats["a2"]
        self.assertEqual(stats_supporter.debuff_contribution, 0)

    def test_dealt_zone_combined_buff_and_debuff(self):
        """dealt 乘区有 DealtDamage buff 和 SKILL_POWER_DOWN debuff 时，
        dealt zone share 仅归因到 DealtDamage buff（SKILL_POWER_DOWN 不参与）"""
        supporter = make_unit("a2", "Supporter", attack=500)
        debuffer = make_unit("a3", "Debuffer", attack=500)
        self.bf.friend_team.append(supporter)
        self.bf.friend_team.append(debuffer)

        dealt_buff = make_buff("b1", "Dealt Up 30", SkillEffectType.DEALT_DAMAGE.value,
                               30, source_unit_id="a2")
        spd_debuff = make_buff("d1", "Skill Power Down 20", SkillEffectType.SKILL_POWER_DOWN.value,
                               20, source_unit_id="a3", is_debuff=True)
        self.caster.buffs.append(dealt_buff)
        self.caster.debuffs.append(spd_debuff)

        # dealt_mult=1.3（仅受 DealtDamage buff 影响），skill_factor=0.8（受 SKILL_POWER_DOWN 影响）
        # actual = 600 * 0.8 * 1.3 = 624
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 0.8, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.3, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(624, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 624, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)
        # DealtDamage buff 应获得 dealt 乘区归因
        stats_supporter = result.unit_stats["a2"]
        self.assertGreater(stats_supporter.buff_contribution, 0)
        # SKILL_POWER_DOWN 不应获得 dealt 乘区归因（已知限制）
        stats_debuffer = result.unit_stats["a3"]
        self.assertEqual(stats_debuffer.debuff_contribution, 0)

    def test_enemy_memory_buff_not_classified_as_ally(self):
        """敌方舞台增量 buff（is_memory_buff=True, source=敌方）不应归为 我方

        回归测试：原 _is_ally_source 在检查来源单位阵营前先检查 is_memory_buff，
        对所有 is_memory_buff=True 的 buff 直接返回 True（视为我方）。
        但敌方舞台增量 buff 也设置 is_memory_buff=True（用于阶段清理），
        source_unit_id 指向敌方单位，应视为非我方（作为前提保留在 baseline_ally 中）。
        """
        # 敌方有舞台增量 DEF buff（is_memory_buff=True, source=敌方自身）
        enemy_stage_def = make_buff("e_stage_def", "阶段增量DEF",
                                    SkillEffectType.STATUS_DEFENSE.value,
                                    200, source_unit_id="e1",
                                    is_memory_buff=True)
        self.target.buffs.append(enemy_stage_def)

        # calc 中 def_orig 因舞台增量而提高
        calc = {
            "atk": 1000, "def_orig": 600, "def_after_penetrate": 600,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 400,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(400, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 400, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        stats_caster = result.unit_stats["a1"]
        stats_enemy = result.unit_stats.get("e1")

        # 敌方舞台增量 DEF 作为前提保留在 baseline_ally 中，bonus=0
        # 全部伤害归 direct_damage，无 buff/debuff 贡献
        self.assertAlmostEqual(stats_caster.direct_damage, 400, delta=1)
        self.assertEqual(stats_caster.buff_contribution, 0)
        self.assertEqual(stats_caster.debuff_contribution, 0)
        # 敌方不应有贡献
        if stats_enemy:
            self.assertEqual(stats_enemy.debuff_contribution, 0)
        # 守恒
        self.assertEqual(result.discrepancy, 0)

    def test_received_debuff_attribution(self):
        """received_dmg_up debuff 归因"""
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        received_debuff = make_buff("d1", "Received Up", SkillEffectType.RECEIVED_DAMAGE.value,
                                    30, source_unit_id="a2", is_debuff=True)
        self.target.debuffs.append(received_debuff)

        # received_mult = 1.0 + 0.3 = 1.3 (RECEIVED_DAMAGE is additive in damage_service)
        # Actually _get_damage_received_multiplier returns 1.0 - net, but for debuffs...
        # Wait, received_dmg_up on target makes it take more damage.
        # In damage_service: received_mult = max(0, 1.0 - net) where net = buff_val - debuff_val
        # If target has received_dmg_up debuff (is_debuff=True), debuff_val = 0.3
        # net = 0 - 0.3 = -0.3, received_mult = 1.0 - (-0.3) = 1.3
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.3,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(780, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 780, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats_supporter = result.unit_stats["a2"]
        self.assertGreater(stats_supporter.debuff_contribution, 0)
        self.assertEqual(result.discrepancy, 0)


class TestCritAttribution(unittest.TestCase):
    """测试暴击归因"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000, crit_rate=0.5, crit_damage=0.2)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_crit_no_buff_conservation(self):
        """暴击无 buff 时守恒"""
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.7,  # 1.5 + 0.2 inherent
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1020, is_critical=True, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1020, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        self.assertEqual(result.discrepancy, 0)

    def test_crit_with_crit_damage_up(self):
        """暴击伤害提升 buff 归因"""
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        crit_dmg_buff = make_buff("b1", "CritDmg Up", SkillEffectType.CRITICAL_BONUS_MODIFICATION.value,
                                  30, source_unit_id="a2")
        self.caster.buffs.append(crit_dmg_buff)

        # effective_crit_factor = 1.5 + 0.2 + 0.3 = 2.0
        # baseline_crit_factor = 1.5 + 0.2 = 1.7
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 2.0,
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1200, is_critical=True, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1200, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        stats_supporter = result.unit_stats["a2"]
        self.assertGreater(stats_supporter.buff_contribution, 0)
        self.assertEqual(result.discrepancy, 0)

    def test_crit_leak_atk_buff_not_in_direct(self):
        """暴击时ATK buff的暴击放大收益不应泄漏到direct_damage

        回归测试：修复前 inherent_crit_share 包含 bonus_nc * (baseline_crit - 1) * p_base/p_final，
        导致友方ATK buff通过暴击放大的收益被归入攻击者direct_damage而非buff施加者。
        修复后：true_inherent 仅包含 baseline_ally_nc 的暴击收益，leaked_crit 加入 bonus 做log-ratio归因。

        场景：caster base_atk=1000, crit_rate=0.5, crit_damage=0.2
        supporter 给 +50% ATK buff → actual_atk=1500
        暴击: eff_crit=1.7, baseline_crit=1.7 (无crit buff)
        actual_damage = (1500-400) * 1.7 = 1870
        non_crit = 1870 / 1.7 = 1100
        baseline_ally = (1000-400) * 1.7 = 1020
        baseline_ally_nc = 1020 / 1.7 = 600
        bonus_nc = 1100 - 600 = 500
        inherent = 1870 - 1100 = 770 (全部crit payoff)
        true_inherent = 600 * (1.7-1) * 0.5/0.5 = 420
        leaked = 770 - 420 = 350 (应归buff，不应归direct)
        direct应为 = 600 + 420 = 1020（= baseline_ally，不含leaked）
        """
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)

        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.7,  # 1.5 + 0.2 inherent, no crit buff
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1870, is_critical=True, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1870, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        # 守恒性
        self.assertEqual(result.discrepancy, 0)

        stats_attacker = result.unit_stats["a1"]
        stats_supporter = result.unit_stats["a2"]

        # direct_damage 应为 baseline_ally = 1020（不含 leaked_crit）
        # 修复前 direct 会是 600 + 770 = 1370（含 leaked）
        self.assertAlmostEqual(stats_attacker.direct_damage, 1020, delta=5,
                               msg=f"direct应为1020(baseline_ally), 实际={stats_attacker.direct_damage}")

        # supporter 应获得 bonus_nc(500) + leaked_crit(350) = 850 的 buff 贡献
        # 修复前 supporter 只获得 bonus_nc=500
        self.assertGreater(stats_supporter.buff_contribution, 800,
                           msg=f"supporter buff贡献应>800(含leaked), 实际={stats_supporter.buff_contribution}")

    def test_crit_leak_no_buff_no_leak(self):
        """无友方buff暴击时leaked_crit=0，direct=inherent全部归攻击者"""
        # caster 无buff，暴击时 bonus_nc=0, leaked=0
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.7,  # 1.5 + 0.2 inherent
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1020, is_critical=True, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1020, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)
        stats_attacker = result.unit_stats["a1"]
        # 无buff时全部归direct: baseline_ally_nc(600) + true_inherent(420) = 1020
        self.assertAlmostEqual(stats_attacker.direct_damage, 1020, delta=1)
        self.assertEqual(stats_attacker.buff_contribution, 0)


class TestUnifiedCritLeakFix(unittest.TestCase):
    """统一暴击泄漏修复的专项测试（文档section 6）

    验证所有基于 crit_payoff 的分配都只使用 baseline 部分，
    bonus 部分通过 log-ratio 归因到 non-crit buff 施加者。
    """

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000, crit_rate=0.5, crit_damage=0.2)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_crit_dmg_up_no_leak_with_atk_buff(self):
        """6.1 回忆卡提供暴击伤害buff时，ATK buff的暴击放大收益不泄漏到回忆卡

        场景: caster atk=1000, crit_rate=0.5, crit_damage=0.2
        - supporter B(a2): +50% ATK buff
        - 回忆卡(card 400001): +30% 暴击伤害buff
        暴击: eff_crit=2.0, baseline_crit=1.7
        actual_damage = (1500-400) * 2.0 = 2200

        修复前(泄漏): 回忆卡获得 (600+500)*(2.0-1.7) = 330（含150泄漏）
        修复后(正确): 回忆卡获得 baseline_ally_nc*(eff_crit-baseline_crit) = 600*0.3 = 180
        """
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)

        self.tracker.ensure_memory_card(400001, "CritDmgCard")
        self.tracker.register_card_skill(400001, 400001)
        crit_dmg_buff = make_buff("m1", "MemCritDmg", SkillEffectType.CRITICAL_BONUS_MODIFICATION.value,
                                  30, source_unit_id="a1", source_skill_id=400001,
                                  is_memory_buff=True)
        self.caster.buffs.append(crit_dmg_buff)

        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 2.0,  # 1.5 + 0.2 inherent + 0.3 card
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(2200, is_critical=True, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 2200, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)

        card_stats = result.memory_card_stats.get(400001)
        self.assertIsNotNone(card_stats)
        # 回忆卡应仅获得 baseline_crit_dmg_up = 600*(2.0-1.7) = 180
        # 修复前会获得 ~330（含ATK buff的暴击放大泄漏）
        self.assertAlmostEqual(card_stats.buff_contribution, 180, delta=5,
                               msg=f"回忆卡暴击伤害贡献应为180(无泄漏), 实际={card_stats.buff_contribution}")

        # ATK buff 施加者应获得 bonus_nc(500) + bonus_crit_payoff(500) = 1000
        stats_supporter = result.unit_stats["a2"]
        self.assertGreater(stats_supporter.buff_contribution, 900,
                           msg=f"ATK buff支持者应获得>900(含暴击放大), 实际={stats_supporter.buff_contribution}")

    def test_enchant_crit_not_affected_by_crit_dmg_buff(self):
        """6.2 附魔伤害暴击固定1.5倍，暴击伤害buff不影响附魔伤害归因

        附魔伤害使用固定1.5x暴击，不套用暴击伤害buff。
        暴击伤害buff施加者的 buff_contribution 不应因附魔伤害暴击而增加。
        """
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)

        # 暴击伤害buff（来源a2）
        crit_dmg_buff = make_buff("b1", "CritDmg Up", SkillEffectType.CRITICAL_BONUS_MODIFICATION.value,
                                  50, source_unit_id="a2")
        self.caster.buffs.append(crit_dmg_buff)

        # 附魔伤害（暴击，固定1.5x）归因给附魔buff提供者a2
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 300, None, "enchant",
            enchant_source_id="a2",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        stats_supporter = result.unit_stats["a2"]
        # 附魔伤害300全部归 enchant_contribution，不应进入 buff_contribution
        self.assertEqual(stats_supporter.enchant_contribution, 300)
        self.assertEqual(stats_supporter.buff_contribution, 0,
                         "暴击伤害buff不应影响附魔伤害归因")

    def test_atk_buff_and_def_debuff_split(self):
        """6.3 ATK buff与DEF debuff按 delta_atk:delta_def 线性比例分配

        场景: caster atk=1000, target def=400
        - supporter B(a2): +50% ATK buff → actual_atk=1500
        - supporter C(a3): -50% DEF debuff → actual_def=200
        base_diff: actual=1300, baseline=600, bonus=700
        delta_atk=500, delta_def=200 → B得500, C得200
        """
        supporter_b = make_unit("a2", "ATKSupporter", attack=500)
        supporter_c = make_unit("a3", "DEFSupporter", attack=500)
        self.bf.friend_team.extend([supporter_b, supporter_c])

        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)
        def_down = make_buff("d1", "DEF Down", SkillEffectType.STATUS_DEFENSE.value,
                             50, source_unit_id="a3", is_debuff=True)
        self.target.debuffs.append(def_down)

        calc = {
            "atk": 1500, "def_orig": 200, "def_after_penetrate": 200,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1300,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1300, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1300, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)

        stats_b = result.unit_stats["a2"]
        stats_c = result.unit_stats["a3"]
        # B获得ATK部分: 500, C获得DEF部分: 200
        self.assertAlmostEqual(stats_b.buff_contribution, 500, delta=5,
                               msg=f"ATK buff贡献应为500, 实际={stats_b.buff_contribution}")
        self.assertAlmostEqual(stats_c.debuff_contribution, 200, delta=5,
                               msg=f"DEF debuff贡献应为200, 实际={stats_c.debuff_contribution}")

    def test_multi_buff_cross_crit_no_leak(self):
        """6.4 多buff交叉暴击：ATK/暴击伤害/暴击率/增伤 同时存在

        场景: caster atk=1000, crit_rate=0.5, crit_damage=0.2
        - B(a2): +50% ATK buff
        - C(a3): +30% 暴击伤害 buff
        - D(a4): +20% 暴击率 buff
        - E(a5): +30% 增伤 buff
        暴击: eff_crit=2.0, baseline_crit=1.7, p_base=0.5, p_final=0.7
        actual = 1100 * 2.0 * 1.3 = 2860

        修复后:
        - C获得 baseline_crit_dmg_up = 600*(2.0-1.7) = 180（无泄漏）
        - D获得 baseline_crit_rate_up = 600*0.7*(0.7-0.5)/0.7 = 120（无泄漏）
        - B和E通过log-ratio分配 bonus_nc+bonus_crit_payoff
        """
        for uid, name in [("a2", "ATKB"), ("a3", "CritDmgC"), ("a4", "CritRateD"), ("a5", "DealtE")]:
            self.bf.friend_team.append(make_unit(uid, name, attack=500))

        self.caster.buffs.append(make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                                          50, source_unit_id="a2"))
        self.caster.buffs.append(make_buff("b2", "CritDmg Up", SkillEffectType.CRITICAL_BONUS_MODIFICATION.value,
                                          30, source_unit_id="a3"))
        self.caster.buffs.append(make_buff("b3", "CritRate Up", SkillEffectType.STATUS_CRITICAL_CHANCE.value,
                                          20, source_unit_id="a4"))
        self.caster.buffs.append(make_buff("b4", "Dealt Up", SkillEffectType.DEALT_DAMAGE.value,
                                          30, source_unit_id="a5"))

        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 2.0,  # 1.5 + 0.2 + 0.3
            "dealt_mult": 1.3, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(2860, is_critical=True, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 2860, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0,
                         f"守恒性失败: discrepancy={result.discrepancy}")

        stats_c = result.unit_stats["a3"]
        stats_d = result.unit_stats["a4"]

        # C(暴击伤害)应仅获得 baseline_crit_dmg_up = 600*(2.0-1.7)/(2.0-1.0) = 180
        # 修复前会获得 (600+830)*0.3 = 429（含大量泄漏）
        self.assertAlmostEqual(stats_c.buff_contribution, 180, delta=5,
                               msg=f"暴击伤害buff贡献应为180(无泄漏), 实际={stats_c.buff_contribution}")

        # D(暴击率)应仅获得 baseline_crit_rate_up = 600*0.7*(0.7-0.5)/0.7 = 120
        # 修复前会获得 (600+830)*0.7*(0.7-0.5)/0.7 = 295（含大量泄漏）
        self.assertAlmostEqual(stats_d.buff_contribution, 120, delta=5,
                               msg=f"暴击率buff贡献应为120(无泄漏), 实际={stats_d.buff_contribution}")

    def test_non_crit_no_leak(self):
        """6.5 非暴击时无crit_payoff分解，bonus全部通过log-ratio归因"""
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)

        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0,  # 非暴击
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1100, is_critical=False, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1100, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)
        stats_attacker = result.unit_stats["a1"]
        stats_supporter = result.unit_stats["a2"]
        # 非暴击: direct=baseline_ally=600, supporter得bonus=500
        self.assertAlmostEqual(stats_attacker.direct_damage, 600, delta=1)
        self.assertAlmostEqual(stats_supporter.buff_contribution, 500, delta=1)


class TestMultiHitCritEstimation(unittest.TestCase):
    """测试多段暴击乘率估算"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000, crit_rate=0.5, crit_damage=0.2)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_multi_hit_crit_factor_estimation(self):
        """多段伤害暴击乘率从 hit_details 估算"""
        # 3 hits: 200 (non-crit), 300 (crit), 200 (non-crit)
        # avg_crit = 300, avg_non_crit = 200, effective_crit_factor = 1.5
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0,  # multi-hit stores 1.0
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(700, is_critical=True,
                              hit_details=[200, 300, 200],
                              hit_crits=[False, True, False],
                              calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 700, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        self.assertEqual(result.discrepancy, 0)


class TestTrackingLog(unittest.TestCase):
    """测试 RDPS 追踪日志功能"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.supporter = make_unit("a2", "Supporter", attack=500)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster, self.supporter]
        self.bf.enemy_team = [self.target]

    def test_tracking_disabled_by_default(self):
        """默认不启用追踪日志"""
        self.assertFalse(self.tracker.is_tracking_enabled())
        self.assertEqual(self.tracker.get_tracking_log(), [])

    def test_tracking_enabled_logs_events(self):
        """启用追踪后记录伤害归因事件"""
        self.tracker.enable_tracking()
        self.assertTrue(self.tracker.is_tracking_enabled())

        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(600, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 600, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)

        log = self.tracker.get_tracking_log()
        self.assertGreater(len(log), 0)
        self.assertTrue(any("RDPS Track #001" in line for line in log))
        self.assertTrue(any("[main]" in line for line in log))
        self.assertTrue(any("[baseline]" in line for line in log))
        self.assertTrue(any("[direct]" in line for line in log))

    def test_tracking_logs_buff_attribution(self):
        """追踪日志记录 buff 权重和归因决策"""
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2", value_tag=0)
        self.caster.buffs.append(atk_buff)

        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1100, calc_detail=calc)

        self.tracker.enable_tracking()
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1100, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)

        log = self.tracker.get_tracking_log()
        # 应记录 buff 权重明细
        self.assertTrue(any("[buff_attr]" in line for line in log),
                        f"Expected [buff_attr] in log, got: {log}")
        # 应记录 ATK Up buff
        self.assertTrue(any("ATK Up" in line for line in log))
        # 应记录权重值（base_atk * pct = 1000 * 0.5 = 500）
        self.assertTrue(any("weight=500" in line for line in log),
                        f"Expected weight=500 in log, got: {log}")
        # 应记录归因到 supporter
        self.assertTrue(any("unit a2" in line for line in log))

    def test_tracking_logs_mixed_buff_weights(self):
        """追踪日志区分固值/百分比 buff 的权重转换"""
        pct_buff = make_buff("b1", "ATK Up 50%", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2", value_tag=0)
        fixed_buff = make_buff("b2", "ATK Up +500", SkillEffectType.STATUS_ATTACK.value,
                               500, source_unit_id="a3", value_tag=1)
        self.caster.buffs.append(pct_buff)
        self.caster.buffs.append(fixed_buff)
        supporter2 = make_unit("a3", "FixedSupporter", attack=500)
        self.bf.friend_team.append(supporter2)

        calc = {
            "atk": 2000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1600, calc_detail=calc)

        self.tracker.enable_tracking()
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1600, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)

        log = self.tracker.get_tracking_log()
        # 两者权重都应为 500（百分比 0.5*1000=500，固值 500）
        self.assertTrue(any("val_tag=0" in line and "weight=500.00" in line for line in log),
                        f"Expected pct buff weight=500, got: {log}")
        self.assertTrue(any("val_tag=1" in line and "weight=500.00" in line for line in log),
                        f"Expected fixed buff weight=500, got: {log}")
        # total_weight 应为 1000
        self.assertTrue(any("total_weight=1000" in line for line in log))

    def test_disable_tracking_stops_logging(self):
        """禁用追踪后不再记录"""
        self.tracker.enable_tracking()
        self.tracker.disable_tracking()
        self.assertFalse(self.tracker.is_tracking_enabled())

        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(600, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 600, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)

        self.assertEqual(self.tracker.get_tracking_log(), [])

    def test_tracking_log_conservation_unchanged(self):
        """启用追踪日志不影响归因结果和守恒性"""
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)
        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1100, calc_detail=calc)

        # 启用追踪
        self.tracker.enable_tracking()
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1100, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result_tracked = self.tracker.build_result(units=self.bf.get_all_units())

        # 不启用追踪（重置）
        self.tracker.disable_tracking()
        self.tracker._unit_stats = {}
        self.tracker._memory_card_stats = {}
        self.tracker._total_damage_to_enemies = 0
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1100, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result_untracked = self.tracker.build_result(units=self.bf.get_all_units())

        # 两者结果应一致
        self.assertEqual(result_tracked.discrepancy, result_untracked.discrepancy)
        self.assertEqual(result_tracked.sum_unit_rdps, result_untracked.sum_unit_rdps)
        self.assertEqual(
            result_tracked.unit_stats["a2"].buff_contribution,
            result_untracked.unit_stats["a2"].buff_contribution)


class TestTrackingLogViaController(unittest.TestCase):
    """测试通过 BattleConfig.enable_rdps_tracking 启用追踪"""

    def test_config_enable_rdps_tracking(self):
        """BattleConfig.enable_rdps_tracking=True 时 tracker 启用追踪"""
        from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig

        bf = BattlefieldState()
        caster = make_unit("a1", "Attacker", attack=1000)
        target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        bf.add_unit(caster)
        bf.add_unit(target)

        config = BattleConfig(max_turns=2, enable_rdps=True, enable_rdps_tracking=True)
        controller = BattleFlowController(bf, config=config)
        self.assertTrue(controller._rdps_tracker.is_tracking_enabled())

    def test_config_tracking_disabled_by_default(self):
        """默认不启用追踪"""
        from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig

        bf = BattlefieldState()
        config = BattleConfig(max_turns=2, enable_rdps=True)
        controller = BattleFlowController(bf, config=config)
        self.assertFalse(controller._rdps_tracker.is_tracking_enabled())


class TestConservationVerification(unittest.TestCase):
    """测试守恒性验证方法"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.supporter = make_unit("a2", "Supporter", attack=500)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster, self.supporter]
        self.bf.enemy_team = [self.target]

    def test_total_conservation_no_buff(self):
        """无 buff 时总量守恒"""
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(600, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 600, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        self.assertEqual(self.tracker.verify_total_conservation(), 0)

    def test_total_conservation_with_buff(self):
        """有 buff 时总量守恒"""
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)
        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1100, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1100, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        self.assertEqual(self.tracker.verify_total_conservation(), 0)

    def test_tracking_log_conservation_no_buff(self):
        """无 buff 时逐次攻击守恒"""
        self.tracker.enable_tracking()
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(600, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 600, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        violations = self.tracker.verify_tracking_log_conservation()
        self.assertEqual(len(violations), 0, f"Conservation violations: {violations}")

    def test_tracking_log_conservation_with_buff(self):
        """有 buff 时逐次攻击守恒"""
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)
        self.tracker.enable_tracking()
        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1100, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1100, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        violations = self.tracker.verify_tracking_log_conservation()
        self.assertEqual(len(violations), 0, f"Conservation violations: {violations}")

    def test_tracking_log_conservation_hp_ratio_capped(self):
        """HP比例伤害（触及cap）逐次攻击守恒"""
        self.tracker.enable_tracking()
        calc_detail = {
            "raw_power": 75232.75, "cap": 61358.0,
            "effective_atk": 122716, "cap_atk_pct": 50.0,
        }
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 61358, None, "hp_ratio",
            battlefield=self.bf, damage_service=self.ds,
            calc_detail=calc_detail)
        violations = self.tracker.verify_tracking_log_conservation()
        self.assertEqual(len(violations), 0, f"Conservation violations: {violations}")

    def test_tracking_log_conservation_hp_ratio_uncapped(self):
        """HP比例伤害（未触及cap）逐次攻击守恒"""
        self.tracker.enable_tracking()
        calc_detail = {
            "raw_power": 44472.5, "cap": 59897.0,
            "effective_atk": 119794, "cap_atk_pct": 50.0,
        }
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 44472, None, "hp_ratio",
            battlefield=self.bf, damage_service=self.ds,
            calc_detail=calc_detail)
        violations = self.tracker.verify_tracking_log_conservation()
        self.assertEqual(len(violations), 0, f"Conservation violations: {violations}")

    def test_tracking_log_conservation_special_atk_mode(self):
        """特殊伤害（ATK模式）逐次攻击守恒"""
        self.tracker.enable_tracking()
        calc_detail = {
            "value_source": "self_atk", "dmg_pct": 50,
            "base_value": 1000, "effective_value": 500,
        }
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 500, None, "special",
            battlefield=self.bf, damage_service=self.ds,
            calc_detail=calc_detail)
        violations = self.tracker.verify_tracking_log_conservation()
        self.assertEqual(len(violations), 0, f"Conservation violations: {violations}")

    def test_tracking_log_conservation_enchant(self):
        """附魔伤害逐次攻击守恒"""
        self.tracker.enable_tracking()
        enchant_buff = make_buff("e1", "Enchant", SkillEffectType.ENCHANT_DAMAGE.value,
                                 100, source_unit_id="a2")
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 300, None, "enchant",
            battlefield=self.bf, damage_service=self.ds,
            enchant_source_id="a2", enchant_buff=enchant_buff)
        violations = self.tracker.verify_tracking_log_conservation()
        self.assertEqual(len(violations), 0, f"Conservation violations: {violations}")

    def test_tracking_log_conservation_multiple_attacks(self):
        """多次攻击（混合类型）逐次攻击守恒"""
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)
        self.tracker.enable_tracking()

        # 主伤害
        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1100, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1100, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)

        # 附魔伤害
        enchant_buff = make_buff("e1", "Enchant", SkillEffectType.ENCHANT_DAMAGE.value,
                                 100, source_unit_id="a2")
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 200, None, "enchant",
            battlefield=self.bf, damage_service=self.ds,
            enchant_source_id="a2", enchant_buff=enchant_buff)

        # HP比例伤害
        calc_detail = {
            "raw_power": 75232.75, "cap": 61358.0,
            "effective_atk": 1500, "cap_atk_pct": 50.0,
        }
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 750, None, "hp_ratio",
            battlefield=self.bf, damage_service=self.ds,
            calc_detail=calc_detail)

        violations = self.tracker.verify_tracking_log_conservation()
        self.assertEqual(len(violations), 0, f"Conservation violations: {violations}")
        self.assertEqual(self.tracker.verify_total_conservation(), 0)

    def test_tracking_log_conservation_crit(self):
        """暴击伤害逐次攻击守恒"""
        self.tracker.enable_tracking()
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.5, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(900, is_critical=True, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 900, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        violations = self.tracker.verify_tracking_log_conservation()
        self.assertEqual(len(violations), 0, f"Conservation violations: {violations}")

    def test_verify_no_tracking_returns_empty(self):
        """未启用追踪时 verify_tracking_log_conservation 返回空列表"""
        violations = self.tracker.verify_tracking_log_conservation()
        self.assertEqual(violations, [])


class TestMultiHitAllCritConservation(unittest.TestCase):
    """测试多段全暴击时的守恒性（修复 eff_crit < baseline_crit 的 bug）"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        # crit_damage=0.495 => 实际暴击乘率 = 1.995
        self.caster = make_unit("a1", "Attacker", attack=1000, crit_rate=0.5, crit_damage=0.495)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_all_hits_crit_conservation(self):
        """多段全暴击 + crit_damage>0 时守恒（旧bug: eff_crit=1.5 < baseline_crit=1.995）"""
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0,  # multi-hit stores 1.0
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        # 3 hits all crit, each = 200 * 1.995 = 399
        dmg = make_dmg_result(1197, is_critical=True,
                              hit_details=[399, 399, 399],
                              hit_crits=[True, True, True],
                              calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1197, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        self.assertEqual(result.discrepancy, 0,
                         "多段全暴击守恒违反：eff_crit应=1.995而非1.5")

    def test_all_hits_crit_with_atk_buff_conservation(self):
        """多段全暴击 + ATK buff 时守恒"""
        supporter = make_unit("a2", "Supporter", attack=500)
        self.bf.friend_team.append(supporter)
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             50, source_unit_id="a2")
        self.caster.buffs.append(atk_buff)

        calc = {
            "atk": 1500, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1100,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0,
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        # 3 hits all crit, each = (1100/3) * 1.995 ≈ 731.5
        actual = 2195
        dmg = make_dmg_result(actual, is_critical=True,
                              hit_details=[732, 732, 731],
                              hit_crits=[True, True, True],
                              calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, actual, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        self.assertEqual(result.discrepancy, 0)

    def test_all_hits_crit_no_crit_damage_conservation(self):
        """多段全暴击 + crit_damage=0 时守恒（eff_crit=1.5=baseline_crit）"""
        caster_no_cd = make_unit("a3", "NoCDAttacker", attack=1000, crit_rate=0.5, crit_damage=0.0)
        self.bf.friend_team.append(caster_no_cd)

        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0,
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        # 3 hits all crit, each = 200 * 1.5 = 300
        dmg = make_dmg_result(900, is_critical=True,
                              hit_details=[300, 300, 300],
                              hit_crits=[True, True, True],
                              calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            caster_no_cd, self.target, 900, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())
        self.assertEqual(result.discrepancy, 0)

    def test_all_hits_crit_tracking_log_conservation(self):
        """多段全暴击的追踪日志守恒性验证"""
        self.tracker.enable_tracking()
        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0,
            "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        dmg = make_dmg_result(1197, is_critical=True,
                              hit_details=[399, 399, 399],
                              hit_crits=[True, True, True],
                              calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, 1197, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        violations = self.tracker.verify_tracking_log_conservation()
        self.assertEqual(len(violations), 0,
                         f"守恒违反: {violations}")


class TestMultiCardSkillSharing(unittest.TestCase):
    """测试多张回忆卡共享同一 skill_id 时的归因分配"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        self.caster = make_unit("a1", "Attacker", attack=1000)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800, defense=400, max_hp=50000)
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.target]

    def test_two_cards_share_skill_both_attributed(self):
        """两张卡共享同一 skill_id 时，两者均获得归因（修复覆盖 bug）"""
        # 模拟 20026 (みんなの為なら) 和 20061 (迷子のウサギちゃん) 共享 skill 400065
        self.tracker.ensure_memory_card(20026, "みんなの為なら")
        self.tracker.ensure_memory_card(20061, "迷子のウサギちゃん")
        self.tracker.register_card_skill(20026, 400065)
        self.tracker.register_card_skill(20061, 400065)

        # DealtDamage buff from shared skill 400065
        mem_buff = make_buff("m1", "SharedDealt", SkillEffectType.DEALT_DAMAGE.value,
                             10, source_unit_id="a1", source_skill_id=400065,
                             is_memory_buff=True)
        self.caster.buffs.append(mem_buff)

        calc = {
            "atk": 1000, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 600,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.1, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        actual = 660  # 600 * 1.1
        dmg = make_dmg_result(actual, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, actual, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        card_20026 = result.memory_card_stats.get(20026)
        card_20061 = result.memory_card_stats.get(20061)
        self.assertIsNotNone(card_20026, "卡20026应存在统计")
        self.assertIsNotNone(card_20061, "卡20061应存在统计")
        self.assertGreater(card_20026.buff_contribution, 0,
                           "卡20026应获得buff归因（非0）")
        self.assertGreater(card_20061.buff_contribution, 0,
                           "卡20061应获得buff归因（非0）")
        # 两者应均分
        self.assertAlmostEqual(card_20026.buff_contribution, card_20061.buff_contribution,
                               delta=1.0)
        self.assertEqual(result.discrepancy, 0)

    def test_two_cards_share_enchant_skill_both_attributed(self):
        """两张卡共享同一附魔 skill_id 时，两者均获得附魔伤害归因"""
        self.tracker.ensure_memory_card(30001, "CardA")
        self.tracker.ensure_memory_card(30002, "CardB")
        self.tracker.register_card_skill(30001, 400099)
        self.tracker.register_card_skill(30002, 400099)

        enchant_buff = make_buff("e1", "SharedEnchant", SkillEffectType.ENCHANT_DAMAGE.value,
                                 50, source_unit_id="a1", source_skill_id=400099,
                                 is_memory_buff=True)

        self.tracker.record_damage_with_attribution(
            caster=self.caster, target=self.target, actual_damage=200,
            damage_type="enchant",
            enchant_source_id="a1",
            battlefield=self.bf, damage_service=self.ds,
            enchant_buff=enchant_buff,
        )
        result = self.tracker.build_result(units=self.bf.get_all_units())

        card_a = result.memory_card_stats.get(30001)
        card_b = result.memory_card_stats.get(30002)
        self.assertIsNotNone(card_a)
        self.assertIsNotNone(card_b)
        self.assertEqual(card_a.direct_damage, 100, "卡A应分得一半附魔伤害")
        self.assertEqual(card_b.direct_damage, 100, "卡B应分得一半附魔伤害")

    def test_four_cards_share_skill_all_attributed(self):
        """四张卡共享同一 skill_id（如 400027 被4张卡共享）时均获得归因"""
        for cid in [20005, 20024, 20058, 20072]:
            self.tracker.ensure_memory_card(cid, f"Card{cid}")
            self.tracker.register_card_skill(cid, 400027)

        mem_buff = make_buff("m1", "SharedATK", SkillEffectType.STATUS_ATTACK.value,
                             40, source_unit_id="a1", source_skill_id=400027,
                             is_memory_buff=True)
        self.caster.buffs.append(mem_buff)

        calc = {
            "atk": 1400, "def_orig": 400, "def_after_penetrate": 400,
            "penetrate_pct": 0, "ignore_def_pct": 0, "base_diff": 1000,
            "skill_power": 100, "skill_factor": 1.0, "attr_factor": 1.0,
            "crit_factor": 1.0, "dealt_mult": 1.0, "received_mult": 1.0,
            "guard_mult": 1.0, "hp_scaling": 1.0,
        }
        actual = 1000
        dmg = make_dmg_result(actual, calc_detail=calc)
        self.tracker.record_damage_with_attribution(
            self.caster, self.target, actual, dmg, "main",
            battlefield=self.bf, damage_service=self.ds)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        for cid in [20005, 20024, 20058, 20072]:
            card = result.memory_card_stats.get(cid)
            self.assertIsNotNone(card, f"卡{cid}应存在统计")
            self.assertGreater(card.buff_contribution, 0,
                               f"卡{cid}应获得buff归因（非0）")
        self.assertEqual(result.discrepancy, 0)

    def test_register_card_skill_no_duplicate(self):
        """重复注册同一 card_id+skill_id 不产生重复条目"""
        self.tracker.register_card_skill(20026, 400065)
        self.tracker.register_card_skill(20026, 400065)
        self.assertEqual(len(self.tracker._skill_to_card[400065]), 1)


if __name__ == '__main__':
    unittest.main()
