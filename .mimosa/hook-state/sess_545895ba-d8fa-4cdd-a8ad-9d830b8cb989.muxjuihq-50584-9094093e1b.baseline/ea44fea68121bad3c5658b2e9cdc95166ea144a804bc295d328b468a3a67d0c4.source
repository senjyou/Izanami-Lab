            max_hp=15000, current_hp=15000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=2, current_pp=2, current_ep=0,
            skills=[110013, 120039, 120021, 120046, 120047],
            skill_levels={110013: 10, 120039: 10, 120021: 10, 120046: 10, 120047: 10},
            skill_cooldowns={},
        )

        # 友方前排左
        self.ally_left_front = UnitState(
            unit_id="ally_left_front", name="友方前排左", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999101, level=10,
            element=1, character_type=1,
            max_hp=10000, current_hp=3000,  # 低HP
            attack=5000, defense=3000, speed=350,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方前排中
        self.ally_center_front = UnitState(
            unit_id="ally_center_front", name="友方前排中", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999102, level=10,
            element=2, character_type=1,
            max_hp=12000, current_hp=8000,  # 中HP
            attack=6000, defense=4000, speed=380,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
