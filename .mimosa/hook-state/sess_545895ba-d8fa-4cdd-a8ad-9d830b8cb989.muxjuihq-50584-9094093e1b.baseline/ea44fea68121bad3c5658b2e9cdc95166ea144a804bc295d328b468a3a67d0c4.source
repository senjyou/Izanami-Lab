            max_hp=11000, current_hp=6000,  # 高HP
            attack=7000, defense=3500, speed=420,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方后排左 (与ally_left_front同纵列col=0)
        self.ally_left_back = UnitState(
            unit_id="ally_left_back", name="友方后排左", side=Side.ALLY,
            position=Position.ALLY_LEFT_BACK, character_id=999104, level=10,
            element=1, character_type=1,
            max_hp=10000, current_hp=7000,
