    # ─── AS1: 120039 スナイプリフレクター ───

    def test_as1_damage_and_shield(self):
        """
        AS1(120039) 验证:
        1. 对后列敌人造成EN攻击
        2. 若目标有buff，赋予友方护盾
        """
        # 先给敌人加一个buff（使用正确的BuffState参数）
        # timing_type: 1=回合制, 2=行动制
        self.enemy_back.buffs.append(BuffState(
            buff_id="test_buff",
            name="test_buff",
            effect_type="atk_up",
            value=10,
            duration=2,
            timing_type=1,  # 回合制
            source_unit_id="test"
        ))

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 应该有伤害效果
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "AS1应造成伤害")

        # 检查护盾效果（目标有buff时应触发护盾）
        shield_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "shield"]
        # 护盾可能没有被触发（需要检查目标是否有buff）
        print(f"Shield effects: {shield_effects}")

    def test_as1_shield_attack_limited(self):
        """
        AS1(120039) 护盾验证:
        护盾应受到1次攻击后消失
        """
        # 给敌人加buff以触发护盾
        # timing_type: 1=回合制, 2=行动制
        self.enemy_back.buffs.append(BuffState(
            buff_id="test_buff",
            name="test_buff",
            effect_type="atk_up",
            value=10,
            duration=2,
            timing_type=1,  # 回合制
            source_unit_id="test"
        ))

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 检查护盾效果 - 直接检查友方身上的buff
        shield_buffs = [b for b in self.ally_left_front.buffs if b.effect_type == "Shield"]
        self.assertTrue(len(shield_buffs) > 0, "目标有buff时应赋予护盾")

        # 检查护盾的attack_limited标志
        for buff in shield_buffs:
            print(f"Shield buff: attack_limited={buff.attack_limited}")
            self.assertEqual(buff.attack_limited, 1, "护盾应受1次攻击后消失")

    # ─── AS2: 120021 アライアリング ───

    def test_as2_heal_lowest_hp(self):
        """
        AS2(120021) 即时回复验证:
        对HP比例最低的友方进行攻击力×威力%的回复
        HP最低的友方是ally_left_front (3000/10000 = 30%)
        """
        original_hp = self.ally_left_front.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120021, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 即时回复应该对HP最低的友方生效
        # 攻击力8000 × 威力45%(Lv10) = 3600
        heal_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "heal"]
        self.assertTrue(len(heal_effects) > 0, "AS2应造成治疗效果")

        print(f"Heal effects: {heal_effects}")
        print(f"ally_left_front HP: {original_hp} -> {self.ally_left_front.current_hp}")

    def test_as2_hot_effect(self):
        """
        AS2(120021) HOT验证:
        对HP最低友方及其同纵列队友施加2行动HOT
        HP最低的友方是ally_left_front (前排左, col=0)
        同纵列队友是ally_left_back (后排左, col=0)
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120021, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 检查HOT效果 - 直接检查目标身上的buff
        hot_buffs_left = [b for b in self.ally_left_front.buffs if b.effect_type == "HealOverTime"]
        hot_buffs_left_back = [b for b in self.ally_left_back.buffs if b.effect_type == "HealOverTime"]
        # 不同列的友方不应获得HOT
        hot_buffs_center = [b for b in self.ally_center_front.buffs if b.effect_type == "HealOverTime"]
        self.assertTrue(len(hot_buffs_left) > 0, "ally_left_front(col=0)应有HOT效果")
        self.assertTrue(len(hot_buffs_left_back) > 0, "ally_left_back(col=0)应有HOT效果(同纵列)")
        self.assertEqual(len(hot_buffs_center), 0, "ally_center_front(col=1)不应有HOT效果(不同列)")

        print(f"ally_left_front HOT buffs: {hot_buffs_left}")
        print(f"ally_left_back HOT buffs: {hot_buffs_left_back}")

    # ─── AS3: 120046 パワーアプライ ───

    def test_as3_atk_up_highest_atk(self):
        """
        AS3(120046) atk_up验证:
        对攻击力最高的友方施加1行动atk_up
        """
        # caster的攻击力最高(8000)，应该是目标
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120046, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 检查caster身上是否有atk_up buff (effect_type存储为StatusAttack)
        atk_up_buffs = [b for b in self.caster.buffs if b.effect_type == "StatusAttack"]
        self.assertTrue(len(atk_up_buffs) > 0, "AS3应赋予atk_up效果给攻击力最高的友方")

        # 检查buff数值和持续时间
        for buff in atk_up_buffs:
            print(f"ATK_UP buff: value={buff.value}, duration={buff.duration}")

    def test_as3_ap_boost(self):
        """
        AS3(120046) AP回复验证:
        对攻击力最高的友方施加AP+1
        """
        original_ap = self.caster.current_ap

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120046, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 检查AP回复
        resource_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "add_ap"]
        self.assertTrue(len(resource_effects) > 0, "AS3应回复AP")

        print(f"AP boost: {original_ap} -> {self.caster.current_ap}")

    # ─── AS4: 120047 シングル・スナイプ ───

    def test_as4_single_en_attack(self):
        """
        AS4(120047) 单体EN攻击验证
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120047, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 检查伤害效果
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "AS4应造成伤害")

        # 验证是EN攻击（is_en_attack标志）
        for effect in dmg_effects:
            print(f"Damage effect: {effect}")

    # ─── EX: 110013 さて……準備はできたわ ───

    def test_ex_heal_and_atk_up(self):
        """
        EX(110013) 验证:
        1. 前列友方HP回复（攻击力×威力%）
        2. 前列友方10%atk_up (1action)
        3. 敌横排EN攻击
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110013, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 检查治疗效果
        heal_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "heal"]
        self.assertTrue(len(heal_effects) > 0, "EX应造成治疗效果")

        # 检查atk_up效果（固定10%）- 直接检查前列友方身上的buff
        atk_up_buffs_left = [b for b in self.ally_left_front.buffs if b.effect_type == "StatusAttack"]
        atk_up_buffs_center = [b for b in self.ally_center_front.buffs if b.effect_type == "StatusAttack"]
        self.assertTrue(len(atk_up_buffs_left) > 0 or len(atk_up_buffs_center) > 0, "EX应赋予atk_up效果")

        # 检查敌横排攻击
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "EX应造成敌横排伤害")

        print(f"Heal effects: {heal_effects}")
        print(f"ally_left_front ATK_UP buffs: {atk_up_buffs_left}")
        print(f"ally_center_front ATK_UP buffs: {atk_up_buffs_center}")
        print(f"Damage effects: {dmg_effects}")

    # ════════════════════════════════════════════════════════════════
    # 补充测试: AS1(120039) target_has_buff 条件block反向分支
    # ════════════════════════════════════════════════════════════════

    def test_as1_no_buff_no_shield(self):
        """
        AS1(120039) Block2 条件 target_has_buff 反向分支:
        目标无buff时，shield不被付与（条件block跳过）。
        """
        # 不给 enemy_back 加任何 buff
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 检查所有友方身上均无 Shield buff
        for ally in self.bf.friend_team:
            shield_buffs = [b for b in ally.buffs if b.effect_type == "Shield"]
            self.assertEqual(len(shield_buffs), 0,
                             f"目标无buff时 {ally.name} 不应有 Shield buff")

    def test_as1_with_buff_grants_shield(self):
        """
        AS1(120039) Block2 条件 target_has_buff 正向分支:
        目标有buff时，shield被付与。
        """
        # 给 enemy_back 加一个 buff
        self.enemy_back.buffs.append(BuffState(
            buff_id="test_buff", name="test_buff",
            effect_type="atk_up", value=10, duration=2,
            timing_type=1, source_unit_id="test"
        ))

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 至少有一个友方获得 Shield buff
        all_shields = [b for ally in self.bf.friend_team for b in ally.buffs
                       if b.effect_type == "Shield"]
        self.assertGreater(len(all_shields), 0, "目标有buff时应付与 Shield")

    # ════════════════════════════════════════════════════════════════
    # 补充测试: AS1(120039) shield 的 exclude_self=True
    # ════════════════════════════════════════════════════════════════

    def test_as1_shield_excludes_self(self):
        """
        AS1(120039) shield exclude_self=True:
        施法者自身不被加盾（exclude_self）。
        """
        # 给 enemy_back 加 buff 触发 shield
        self.enemy_back.buffs.append(BuffState(
            buff_id="test_buff", name="test_buff",
            effect_type="atk_up", value=10, duration=2,
            timing_type=1, source_unit_id="test"
        ))

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 施法者自身不应有 Shield buff
        caster_shields = [b for b in self.caster.buffs if b.effect_type == "Shield"]
        self.assertEqual(len(caster_shields), 0,
                         "exclude_self=True: 施法者自身不应被加盾")

    def test_as1_shield_given_to_other_allies(self):
        """
        AS1(120039) shield exclude_self=True:
        其他友方被加盾（除施法者外的所有存活友方）。
        """
        # 给 enemy_back 加 buff 触发 shield
        self.enemy_back.buffs.append(BuffState(
            buff_id="test_buff", name="test_buff",
            effect_type="atk_up", value=10, duration=2,
            timing_type=1, source_unit_id="test"
        ))

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 除施法者外的所有友方应有 Shield buff
        other_allies = [a for a in self.bf.friend_team if a.unit_id != self.caster.unit_id]
        for ally in other_allies:
            shield_buffs = [b for b in ally.buffs if b.effect_type == "Shield"]
            self.assertGreater(len(shield_buffs), 0,
                               f"非施法者友方 {ally.name} 应被加盾")
            # 验证 attack_limited=1
            self.assertEqual(getattr(shield_buffs[0], 'attack_limited', 0), 1,
                             f"{ally.name} 的 Shield 应有 attack_limited=1")

    # ════════════════════════════════════════════════════════════════
    # 补充测试: AS1(120039) shield 的 attack_limited=1 消耗
    # ════════════════════════════════════════════════════════════════

    def test_as1_shield_consumed_after_attack(self):
        """
        AS1(120039) shield attack_limited=1:
        被攻击1次后 Shield 消失。
        """
        # Step 1: 给 enemy_back 加 buff 触发 shield
        self.enemy_back.buffs.append(BuffState(
            buff_id="test_buff", name="test_buff",
            effect_type="atk_up", value=10, duration=2,
            timing_type=1, source_unit_id="test"
        ))

        # Step 2: 施放 AS1，给除施法者外的所有友方加盾
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 ally_center_front 获得了 Shield（后续将被攻击）
        shields_before = [b for b in self.ally_center_front.buffs if b.effect_type == "Shield"]
        self.assertGreater(len(shields_before), 0,
                           "ally_center_front 应在攻击前有 Shield buff")

        # Step 3: 让 enemy_front 攻击 ally_center_front（最近敌对友方）
        # enemy_front 在 ENEMY_CENTER_FRONT，最近友方是 ally_center_front
        self.ss.execute_skill(
            caster=self.enemy_front, skill_id=120047, battlefield=self.bf, skip_cost=True
        )

        # 验证 ally_center_front 的 Shield 被消耗（attack_limited 达到 0 后移除）
        shields_after = [b for b in self.ally_center_front.buffs if b.effect_type == "Shield"]
        self.assertEqual(len(shields_after), 0,
                         "Shield 应在1次被攻击后被消耗 (attack_limited=1)")

    def test_as1_shield_retained_when_not_attacked(self):
        """
        AS1(120039) shield attack_limited=1:
        未被攻击时 Shield 保留。
        """
        # 给 enemy_back 加 buff 触发 shield
        self.enemy_back.buffs.append(BuffState(
            buff_id="test_buff", name="test_buff",
            effect_type="atk_up", value=10, duration=2,
            timing_type=1, source_unit_id="test"
        ))

        # 施放 AS1
        self.ss.execute_skill(
            caster=self.caster, skill_id=120039, battlefield=self.bf, skip_cost=True
        )

        # 不攻击任何友方，验证 Shield 仍存在
        for ally in self.bf.friend_team:
            if ally.unit_id == self.caster.unit_id:
                continue  # 施法者被 exclude_self 排除
            shield_buffs = [b for b in ally.buffs if b.effect_type == "Shield"]
            self.assertGreater(len(shield_buffs), 0,
                               f"未被攻击时 {ally.name} 的 Shield 应保留")
            self.assertEqual(getattr(shield_buffs[0], 'attack_limited', 0), 1,
                             f"{ally.name} 的 Shield attack_limited 应仍为 1")

    # ════════════════════════════════════════════════════════════════
    # 补充测试: AS2(120021) ally_column + lowest_hp_row_only 范围限定
    # ════════════════════════════════════════════════════════════════

    def test_as2_hot_only_same_column_as_lowest_hp(self):
        """
        AS2(120021) Block2 heal_over_time ally_column + lowest_hp_row_only:
        HOT 仅作用于与最低HP友方同列的友方。
        - ally_left_front (col=0, HP=30%, 最低) → HOT ✓
        - ally_left_back (col=0) → HOT ✓
        - ally_center_front (col=1) → 无 HOT
        - ally_center_back (col=1) → 无 HOT
        - caster (col=1) → 无 HOT
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120021, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # col=0 友方应有 HOT
        hot_left_front = [b for b in self.ally_left_front.buffs if b.effect_type == "HealOverTime"]
        hot_left_back = [b for b in self.ally_left_back.buffs if b.effect_type == "HealOverTime"]
        self.assertGreater(len(hot_left_front), 0, "ally_left_front(col=0) 应有 HOT")
        self.assertGreater(len(hot_left_back), 0, "ally_left_back(col=0) 应有 HOT")

        # col=1 友方不应有 HOT
        hot_center_front = [b for b in self.ally_center_front.buffs if b.effect_type == "HealOverTime"]
        hot_center_back = [b for b in self.ally_center_back.buffs if b.effect_type == "HealOverTime"]
        hot_caster = [b for b in self.caster.buffs if b.effect_type == "HealOverTime"]
        self.assertEqual(len(hot_center_front), 0, "ally_center_front(col=1) 不应有 HOT")
        self.assertEqual(len(hot_center_back), 0, "ally_center_back(col=1) 不应有 HOT")
        self.assertEqual(len(hot_caster), 0, "caster(col=1) 不应有 HOT")

    def test_as2_hot_excludes_different_column(self):
        """
        AS2(120021) ally_column + lowest_hp_row_only:
        不同列的友方不获得 heal_over_time（更彻底的反向验证）。
        构造场景：最低HP友方在 col=0，验证 col=1 和 col=2 友方均无 HOT。
        """
        # 添加一个 col=2（右列）友方
        ally_right_front = UnitState(
            unit_id="ally_right_front", name="友方前排右", side=Side.ALLY,
            position=Position.ALLY_RIGHT_FRONT, character_id=999105, level=10,
            element=4, character_type=1,
            max_hp=10000, current_hp=9000,  # 高HP
            attack=5500, defense=3000, speed=350,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.bf.friend_team.append(ally_right_front)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120021, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # col=0 友方有 HOT
        hot_left_front = [b for b in self.ally_left_front.buffs if b.effect_type == "HealOverTime"]
        self.assertGreater(len(hot_left_front), 0, "ally_left_front(col=0, 最低HP) 应有 HOT")

        # col=1 友方无 HOT
        hot_center_front = [b for b in self.ally_center_front.buffs if b.effect_type == "HealOverTime"]
        self.assertEqual(len(hot_center_front), 0, "ally_center_front(col=1) 不应有 HOT")

        # col=2 友方无 HOT
        hot_right_front = [b for b in ally_right_front.buffs if b.effect_type == "HealOverTime"]
        self.assertEqual(len(hot_right_front), 0, "ally_right_front(col=2) 不应有 HOT")

    # ════════════════════════════════════════════════════════════════
    # 补充测试: AS2(120021) heal_over_time 效果属性
    # ════════════════════════════════════════════════════════════════

    def test_as2_hot_buff_properties(self):
        """
        AS2(120021) Block2 heal_over_time buff 属性验证:
        - duration=2 (2 actions)
        - value=10.0 (max_hp 的 10%)
        - value_source=max_hp
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120021, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        hot_buffs = [b for b in self.ally_left_front.buffs if b.effect_type == "HealOverTime"]
        self.assertGreater(len(hot_buffs), 0, "ally_left_front 应有 HOT buff")

        hot = hot_buffs[0]
        # duration=2 (Lv10 配置)
        self.assertEqual(hot.duration, 2,
                         f"HOT duration 应为 2, 实际 {hot.duration}")
        # value=10.0 (Lv10 配置: max_hp 的 10%)
        self.assertAlmostEqual(hot.value, 10.0, delta=0.01,
                               msg=f"HOT value 应为 10.0, 实际 {hot.value}")

    def test_as2_hot_buff_is_buff_not_debuff(self):
        """
        AS2(120021) heal_over_time 应为 buff (增益)，不是 debuff。
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120021, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        hot_buffs = [b for b in self.ally_left_front.buffs if b.effect_type == "HealOverTime"]
        self.assertGreater(len(hot_buffs), 0, "HOT 应存在于 buffs 列表")
        # 验证 HOT 不在 debuffs 列表
        hot_debuffs = [d for d in self.ally_left_front.debuffs if d.effect_type == "HealOverTime"]
        self.assertEqual(len(hot_debuffs), 0, "HOT 不应存在于 debuffs 列表")

    # ════════════════════════════════════════════════════════════════
    # 补充测试: AS3(120046) ally_highest_atk 索敌
    # ════════════════════════════════════════════════════════════════

    def test_as3_targets_highest_atk_ally(self):
        """
        AS3(120046) ally_highest_atk 索敌:
        默认场景下 caster(attack=8000) 是最高ATK友方，atk_up 应作用于 caster。
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120046, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # caster 应获得 atk_up (StatusAttack)
        caster_atk_ups = [b for b in self.caster.buffs if b.effect_type == "StatusAttack"]
        self.assertGreater(len(caster_atk_ups), 0,
                           "caster(最高ATK) 应获得 atk_up")

        # 其他友方不应获得 atk_up
        for ally in self.bf.friend_team:
            if ally.unit_id == self.caster.unit_id:
                continue
            atk_ups = [b for b in ally.buffs if b.effect_type == "StatusAttack"]
            self.assertEqual(len(atk_ups), 0,
                             f"非最高ATK友方 {ally.name} 不应获得 atk_up")

    def test_as3_target_switches_when_highest_atk_changes(self):
        """
        AS3(120046) ally_highest_atk 索敌切换:
        当另一友方ATK更高时，索敌切换到该友方。
        - 修改 ally_center_back.attack=9000 (> caster 8000)
        - AS3 的 atk_up+add_ap 应作用于 ally_center_back 而非 caster
        """
        # 修改 ally_center_back 的攻击力为 9000（高于 caster 的 8000）
        self.ally_center_back.attack = 9000
        # 将 AP 设为较低值（避免 AP cap 限制导致 add_ap 无效）
        self.ally_center_back.current_ap = 2

        original_ap_caster = self.caster.current_ap
        original_ap_center_back = self.ally_center_back.current_ap

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120046, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # ally_center_back 应获得 atk_up
        center_back_atk_ups = [b for b in self.ally_center_back.buffs if b.effect_type == "StatusAttack"]
        self.assertGreater(len(center_back_atk_ups), 0,
                           "ally_center_back(attack=9000, 最高ATK) 应获得 atk_up")

        # caster 不应获得 atk_up
        caster_atk_ups = [b for b in self.caster.buffs if b.effect_type == "StatusAttack"]
        self.assertEqual(len(caster_atk_ups), 0,
                         "caster(attack=8000, 非最高ATK) 不应获得 atk_up")

        # ally_center_back 应获得 AP+1
        self.assertEqual(self.ally_center_back.current_ap, original_ap_center_back + 1,
                         "ally_center_back 应获得 AP+1")
        # caster AP 不变
        self.assertEqual(self.caster.current_ap, original_ap_caster,
                         "caster AP 不应变")

    # ════════════════════════════════════════════════════════════════
    # 补充测试: EX(110013) atk_up 的 stackable=True 叠加
    # ════════════════════════════════════════════════════════════════

    def test_ex_atk_up_stackable_two_casts(self):
        """
        EX(110013) atk_up stackable=True:
        连续2次施放EX，atk_up buff数量=2（stackable叠加）。
        """
        # 第一次施放 EX
        result1 = self.ss.execute_skill(
            caster=self.caster, skill_id=110013, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result1["success"])

        # 验证第一次施放后有1个 atk_up buff
        atk_ups_after_1 = [b for b in self.ally_left_front.buffs if b.effect_type == "StatusAttack"]
        self.assertEqual(len(atk_ups_after_1), 1,
                         f"第一次EX后应有1个atk_up buff, 实际 {len(atk_ups_after_1)}")

        # 第二次施放 EX
        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=110013, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result2["success"])

        # 验证第二次施放后有2个 atk_up buff（stackable叠加）
        atk_ups_after_2 = [b for b in self.ally_left_front.buffs if b.effect_type == "StatusAttack"]
        self.assertEqual(len(atk_ups_after_2), 2,
                         f"第二次EX后应有2个atk_up buff(stackable叠加), 实际 {len(atk_ups_after_2)}")

    def test_ex_atk_up_stackable_buffs_independent(self):
        """
        EX(110013) atk_up stackable=True:
        2个buff独立存在（不同 buff_id）。
        """
        # 施放两次 EX
        self.ss.execute_skill(
            caster=self.caster, skill_id=110013, battlefield=self.bf, skip_cost=True
        )
        self.ss.execute_skill(
            caster=self.caster, skill_id=110013, battlefield=self.bf, skip_cost=True
        )

        atk_ups = [b for b in self.ally_left_front.buffs if b.effect_type == "StatusAttack"]
        self.assertEqual(len(atk_ups), 2, "应有2个独立的atk_up buff")

        # 验证两个 buff 有不同的 buff_id（独立存在）
        buff_ids = [b.buff_id for b in atk_ups]
        self.assertEqual(len(set(buff_ids)), 2,
                         f"2个atk_up buff应有不同buff_id, 实际 {buff_ids}")

        # 验证两个 buff 的 value 都是 10.0
        for buff in atk_ups:
            self.assertAlmostEqual(getattr(buff, 'value', 0), 10.0, delta=0.01,
                                   msg=f"atk_up buff value 应为 10.0, 实际 {buff.value}")


if __name__ == "__main__":
    unittest.main()
