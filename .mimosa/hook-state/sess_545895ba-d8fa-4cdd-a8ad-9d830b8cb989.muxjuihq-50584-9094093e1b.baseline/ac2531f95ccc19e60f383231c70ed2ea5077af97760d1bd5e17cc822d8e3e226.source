"""
角色145301 心色見つめるムードメーカー (エレーナ・パステルコワ) 专项测试
- EX: 110069 あったかいの、どうぞ♪ (攻撃力最高味方にatk_up35%+dmg_dealt_up10%+add_damage_to_attack(被附魔者ATK×dmg%, 永続))
- AS1: 120154 私に任せて！ (現在HP10%消費 + 最低HP味方回復(consume_hp×cure%) + 自身と最低HP敵に回復リンク + 3条件global_condition)
- AS2: 120155 苦手なのはそこだね！ (対象現在HP×dmg%ダメージ, 上限自身ATK×max%)
- PS1: 130152 リラックスだよ～♪ (AS4回使用ごとに自身HP回復)
- PS2: 130153 それはやりすぎ！ (味方撃破反応 + 自身atk_up(stackable, skill duration) + 敵全体威力攻撃)
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
ENCHANT_DAMAGE = SkillEffectType.ENCHANT_DAMAGE.value
ADD_DAMAGE = SkillEffectType.ADD_DAMAGE.value
HEAL_LINK = SkillEffectType.HEAL_LINK.value


def _find_aura(unit, effect_type, name=None):
    """在unit.buffs和unit.debuffs中查找指定effect_type的aura"""
    pools = list(unit.buffs) + list(unit.debuffs)
    for b in pools:
        if b.effect_type != effect_type:
            continue
        if name is not None and getattr(b, 'name', '') != name:
            continue
        return b
    return None


class TestActor145301(unittest.TestCase):
    """角色145301 心色見つめるムードメーカー 专项测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 145301 エレーナ (土属性, 敏捷型, 后排, 辅助)
        self.caster = UnitState(
            unit_id="ally_back", name="エレーナ", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=145301, level=10,
            element=4, character_type=3,
            max_hp=15000, current_hp=15000,
            attack=6000, defense=4000, speed=480,
            crit_rate=0.10, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=8,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110069, 120154, 120155, 130152, 130153],
            skill_levels={110069: 10, 120154: 10, 120155: 10, 130152: 10, 130153: 10},
            skill_cooldowns={},
        )

        # 友方前排 (攻击力最高, 用于EX 110069测试)
        self.ally_front = UnitState(
            unit_id="ally_front", name="友方前排", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999100, level=10,
            element=1, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央
        self.enemy_front = UnitState(
            unit_id="enemy_front", name="敌方前排", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=9000, defense=5000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前 (HP比例较低, 用于heal_link测试)
        self.enemy_left = UnitState(
            unit_id="enemy_left", name="敌方左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=4, character_type=1,
            max_hp=40000, current_hp=10000,
            attack=3000, defense=3000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally_front]
        self.bf.enemy_team = [self.enemy_front, self.enemy_left]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
