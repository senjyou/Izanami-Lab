"""Unit tests for hp_below trigger behavior.

Tests:
- Single unit crossing threshold triggers once
- Multiple units crossing threshold → one trigger per owner, nearest unit selected
- prev_hp_percent updated AFTER condition checks
"""
import unittest
import sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import SkillEffectType, Position


class TestHpBelowSingleUnit(unittest.TestCase):
    """Single unit crossing HP threshold."""

    def setUp(self):
        builder = BattleBuilder()
        builder.add_ally(unit_id="owner", hp=20000, atk=10000,
                         skills=[130041], level=10)
        builder.add_ally(unit_id="ally_A", hp=10000)  # full HP
        builder.add_enemy(unit_id="enemy", hp=50000)
        ctx = builder.quick_build()
        self.bf = ctx['bf']
        self.ts = ctx['ts']
        self.owner = next(u for u in self.bf.friend_team if u.unit_id == "owner")
        self.ally_A = next(u for u in self.bf.friend_team if u.unit_id == "ally_A")

    def test_single_unit_crosses_triggers_once(self):
        """One unit crossing 50% should produce exactly one action."""
        self.ally_A.current_hp = 4000  # 40% of 10000 HP
        self.ally_A.prev_hp_percent = 100.0
        self.owner.current_pp = 10

        actions = self.ts.trigger_hp_below(self.bf, [self.ally_A])
        ps_actions = [a for a in actions if a.skill_id == 130041]
        self.assertEqual(len(ps_actions), 1,
                         f"should trigger exactly once, got {len(ps_actions)}")

    def test_prev_hp_preserved_for_condition_check(self):
        """prev_hp_percent should remain at pre-damage value during condition check."""
        self.ally_A.current_hp = 4000  # 40% of 10000 HP
        self.ally_A.prev_hp_percent = 100.0
        self.owner.current_pp = 10

        actions = self.ts.trigger_hp_below(self.bf, [self.ally_A])
        self.assertTrue(len(actions) > 0, "should trigger")
        # After trigger, prev should be updated to current (40%)
        self.assertAlmostEqual(self.ally_A.prev_hp_percent, 40.0, delta=0.1)

    def test_no_trigger_when_not_crossing(self):
        """Unit at 70% HP should NOT trigger."""
        self.ally_A.current_hp = 7000  # 70% of 10000 HP
        self.ally_A.prev_hp_percent = 80.0  # still above 50%
        actions = self.ts.trigger_hp_below(self.bf, [self.ally_A])
        ps_actions = [a for a in actions if a.skill_id == 130041]
        self.assertEqual(len(ps_actions), 0, "should not trigger when above threshold")


class TestHpBelowMultiUnit(unittest.TestCase):
    """Multiple units crossing threshold simultaneously."""

    def setUp(self):
        builder = BattleBuilder()
        builder.add_ally(unit_id="owner", hp=20000, atk=10000,
                         skills=[130041], level=10)
        builder.add_ally(unit_id="ally_near", position=Position.ALLY_CENTER_FRONT,
                         hp=10000)  # full HP
        builder.add_ally(unit_id="ally_far", position=Position.ALLY_RIGHT_BACK,
                         hp=10000)  # full HP
        builder.add_enemy(unit_id="enemy", hp=50000)
        ctx = builder.quick_build()
        self.bf = ctx['bf']
        self.ts = ctx['ts']
        self.owner = next(u for u in self.bf.friend_team if u.unit_id == "owner")
        self.ally_near = next(u for u in self.bf.friend_team if u.unit_id == "ally_near")
        self.ally_far = next(u for u in self.bf.friend_team if u.unit_id == "ally_far")

    def test_multi_cross_produces_one_action_per_owner(self):
        """Two units crossing → one action (nearest selected)."""
        for a in [self.ally_near, self.ally_far]:
            a.current_hp = 4000  # 40% of 10000 HP
            a.prev_hp_percent = 100.0
        self.owner.current_pp = 10

        actions = self.ts.trigger_hp_below(self.bf, [self.ally_near, self.ally_far])
        ps_actions = [a for a in actions if a.skill_id == 130041]
        self.assertEqual(len(ps_actions), 1,
                         f"two units crossing should produce one action per owner, got {len(ps_actions)}")

    def test_nearest_crossed_unit_selected(self):
        """Nearest crossed unit should be selected as primary_target."""
        for a in [self.ally_near, self.ally_far]:
            a.current_hp = 4000  # 40% of 10000 HP
            a.prev_hp_percent = 100.0
        self.owner.current_pp = 10

        actions = self.ts.trigger_hp_below(self.bf, [self.ally_near, self.ally_far])
        ps_actions = [a for a in actions if a.skill_id == 130041]
        if ps_actions:
            params = getattr(ps_actions[0], 'parameters', {})
            primary = params.get('primary_target')
            self.assertIsNotNone(primary, "primary_target should be set")
            self.assertEqual(primary.unit_id, self.ally_near.unit_id,
                             f"expected nearest ally (ally_near), got {primary.unit_id if primary else 'None'}")


if __name__ == '__main__':
    unittest.main()
