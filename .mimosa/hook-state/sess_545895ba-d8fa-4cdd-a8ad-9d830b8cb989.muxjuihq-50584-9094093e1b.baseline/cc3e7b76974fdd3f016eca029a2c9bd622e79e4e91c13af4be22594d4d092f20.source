"""Regression: PS skill 130119 (on_skill_use_count) attack should trigger
target's after_self_attacked PS (230029 外殻強化).

Bug: BattleFlowController._execute_trigger_actions (Phase 2 PS path) did not
     trigger after_self_attacked for damaged targets, unlike
     _execute_global_trigger_actions. So when 130119 (期待に応えたい,
     on_skill_use_count) attacked an enemy with 230029 (外殻強化,
     after_self_attacked), the enemy's def_up PS never fired.

Fix: Extracted _trigger_being_attacked_reactions helper and called it from
     _execute_trigger_actions for active attack trigger types
     (on_skill_use_count / on_critical / after_as_attack / after_ally_as_attack).
     Reaction-type PS (after_self_attacked etc.) are excluded to prevent recursion.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.battle_flow_controller import BattleFlowController


DEF_UP = SkillEffectType.STATUS_DEFENSE.value


class TestRegPsAttackTriggersAfterSelfAttacked(unittest.TestCase):
    """Regression: Active attack PS (on_skill_use_count) must trigger
    target's after_self_attacked PS (外殻強化)."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # Caster: character 104302 (has 130119 on_skill_use_count PS)
        self.caster = UnitState(
            unit_id="caster", name="期待応える輝きの穹", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=104302, level=10,
            element=3, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=4000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110050, 120111, 120112, 130119, 130120],
            skill_levels={110050: 10, 120111: 10, 120112: 10,
                          130119: 10, 130120: 10},
            skill_cooldowns={},
        )

        # Enemy: has 230029 外殻強化 (after_self_attacked -> def_up to self)
        # High HP to survive 130119's 5-hit EN attack
        self.enemy = UnitState(
            unit_id="enemy", name="敵(外殻強化)", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999999, level=10,
            element=1, character_type=1,
            max_hp=999999, current_hp=999999,
            attack=100, defense=3000, speed=100,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=10, current_ep=0,
            skills=[230029],
            skill_levels={230029: 10},
            skill_cooldowns={},
        )

        self.bf.add_unit(self.caster)
        self.bf.add_unit(self.enemy)

        # Create BattleFlowController (the code path that was fixed)
        self.controller = BattleFlowController(self.bf, data_loader=self.dl)
        # Normally called in execute_battle(); call manually for direct method test
        self.controller._build_display_names()
        self.controller.skill_service.set_battlefield(self.bf)
        # _deferred_crit_triggers is normally initialized in _execute_turn/_execute_unit_action
        self.controller._deferred_crit_triggers = []

    def _trigger_130119(self):
        """Set up skill_use_count=2 and trigger 130119 via on_skill_use_count."""
        self.caster.skill_use_count = {120111: 2}
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130119, None)
        self.enemy.buffs.clear()

        actions = self.controller.trigger_service.trigger_skill_use_count(
            self.caster, self.bf)
        ps1_actions = [a for a in actions if a.skill_id == 130119]
        self.assertGreater(len(ps1_actions), 0, "130119 should trigger")
        return ps1_actions

    def test_130119_attack_triggers_enemy_230029_def_up(self):
        """130119 (on_skill_use_count) attacking enemy with 230029
        (after_self_attacked) should trigger enemy's def_up PS.

        Bug: _execute_trigger_actions did not call after_self_attacked
             for PS attack damage, so 230029 never fired.
        Fix: _trigger_being_attacked_reactions called for active attack
             trigger types (on_skill_use_count is in _ACTIVE_ATTACK_TRIGGER_TYPES).
        """
        ps1_actions = self._trigger_130119()
        self.controller._execute_trigger_actions(ps1_actions, self.caster)

        # Enemy should have def_up buff from 230029 (after_self_attacked)
        def_up_buffs = [b for b in self.enemy.buffs if b.effect_type == DEF_UP]
        self.assertGreater(len(def_up_buffs), 0,
                           "Enemy should have def_up from 230029 "
                           "(after_self_attacked) triggered by 130119's attack")

    def test_130119_attack_deals_damage_to_enemy(self):
        """Sanity check: 130119 should deal damage to the enemy."""
        ps1_actions = self._trigger_130119()
        hp_before = self.enemy.current_hp

        self.controller._execute_trigger_actions(ps1_actions, self.caster)

        self.assertLess(self.enemy.current_hp, hp_before,
                        "Enemy should take damage from 130119's 5-hit EN attack")

    def test_230029_does_not_trigger_without_attack(self):
        """Negative check: 230029 should NOT trigger if enemy is not attacked.
        Casting a non-damage skill (110050 EX) on allies should not trigger
        the enemy's after_self_attacked PS."""
        # Execute EX (buff skill, no enemy damage)
        self.enemy.buffs.clear()
        self.caster.skill_cooldowns.pop(110050, None)
        self.controller.skill_service.execute_skill(
            caster=self.caster, skill_id=110050,
            battlefield=self.bf, skip_cost=True,
        )

        def_up_buffs = [b for b in self.enemy.buffs if b.effect_type == DEF_UP]
        self.assertEqual(len(def_up_buffs), 0,
                         "Enemy should NOT have def_up when not attacked")


if __name__ == '__main__':
    unittest.main()
