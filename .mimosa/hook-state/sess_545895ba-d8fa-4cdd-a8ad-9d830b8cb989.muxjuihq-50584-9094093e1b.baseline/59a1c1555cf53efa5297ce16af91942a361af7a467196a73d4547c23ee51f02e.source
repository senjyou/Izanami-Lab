#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
数据库连接管理器

提供对角色数据库和技能数据库的统一访问接口
"""

import sqlite3
from pathlib import Path
from typing import Optional


class DatabaseManager:
    """数据库连接管理器（单例模式）"""
    
    _instance = None
    _char_conn: Optional[sqlite3.Connection] = None
    _skill_conn: Optional[sqlite3.Connection] = None
    
    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
        return cls._instance
    
    def __init__(self):
        """初始化数据库连接"""
        if self._char_conn is None or self._skill_conn is None:
            project_root = Path(__file__).parent.parent.parent
            
            char_db = project_root / "db" / "character_stats.db"
            skill_db = project_root / "db" / "skill_data.db"
            
            self._char_conn = sqlite3.connect(str(char_db))
            self._skill_conn = sqlite3.connect(str(skill_db))
            
            # 设置行工厂
            self._char_conn.row_factory = sqlite3.Row
            self._skill_conn.row_factory = sqlite3.Row
    
    @property
    def char_db(self) -> sqlite3.Connection:
        """获取角色数据库连接"""
        if self._char_conn is None:
            self.__init__()
        return self._char_conn
    
    @property
    def skill_db(self) -> sqlite3.Connection:
        """获取技能数据库连接"""
        if self._skill_conn is None:
            self.__init__()
        return self._skill_conn
    
    def execute_char_query(self, sql: str, params=None):
        """在角色数据库执行查询"""
        cursor = self.char_db.cursor()
        if params:
            return cursor.execute(sql, params)
        return cursor.execute(sql)
    
    def execute_skill_query(self, sql: str, params=None):
        """在技能数据库执行查询"""
        cursor = self.skill_db.cursor()
        if params:
            return cursor.execute(sql, params)
        return cursor.execute(sql)
    
    def commit_char(self):
        """提交角色数据库事务"""
        self.char_db.commit()
    
    def commit_skill(self):
        """提交技能数据库事务"""
        self.skill_db.commit()
    
    def commit_all(self):
        """提交所有数据库事务"""
        self.char_db.commit()
        self.skill_db.commit()
    
    def close(self):
        """关闭所有数据库连接"""
        if self._char_conn:
            self._char_conn.close()
            self._char_conn = None
        if self._skill_conn:
            self._skill_conn.close()
            self._skill_conn = None
    
    def __del__(self):
        """析构时关闭连接"""
        self.close()


# 全局数据库管理器实例
db_manager = DatabaseManager()


# 便捷函数
def get_char_db() -> sqlite3.Connection:
    """获取角色数据库连接"""
    return db_manager.char_db


def get_skill_db() -> sqlite3.Connection:
    """获取技能数据库连接"""
    return db_manager.skill_db
