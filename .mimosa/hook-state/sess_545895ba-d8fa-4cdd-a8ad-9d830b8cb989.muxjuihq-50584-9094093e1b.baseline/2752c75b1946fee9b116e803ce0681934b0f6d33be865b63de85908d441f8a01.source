    # ============================================================
    # EX: 110015 大儲けだー！
    # ============================================================

    def test_ex_damage(self):
        """
        EX: 敌横列hit伤害（hit数随等级变化，Lv15=12hit）
        技能描述: 敵横列に威力{威力}で{hit}ヒット攻撃する
        验证: Lv15时伤害结果中应有12个hit
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110015,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(len(damage_effects) > 0, "EX技能应造成伤害")

        # 验证hit数：Lv15时hit=12（Lv1-10=7, Lv15=12）
        first_damage = damage_effects[0]
        targets = first_damage.get("targets", [])
        self.assertTrue(len(targets) > 0, "应有伤害目标")
        hits = targets[0].get("hits", [])
        expected_hits = 12  # skill_level=15, hit tag: level15=12
        self.assertEqual(
            len(hits), expected_hits,
            f"EX技能Lv15应为{expected_hits}hit攻击, 实际hits: {len(hits)}"
        )

    def test_ex_dmg_invulnerable(self):
        """
        EX: 赋予自身dmg_invulnerable buff（hit_limited=1）
        技能描述: 自身にダメージ無効バフを付与する（1回限り）
        验证: EX使用后，施法者应获得dmg_invulnerable buff，hit_limited=1
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110015,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证获得dmg_invulnerable buff
        invuln_buffs = [b for b in self.caster.buffs
                        if b.effect_type == DMG_INVULNERABLE]
        self.assertTrue(
            len(invuln_buffs) > 0,
            f"EX技能后应获得DmgInvulnerable buff, "
            f"实际buffs: {[(b.effect_type, getattr(b, 'hit_limited', None)) for b in self.caster.buffs]}"
        )

        # 验证hit_limited=1
        self.assertEqual(
            invuln_buffs[0].hit_limited, 1,
            f"dmg_invulnerable的hit_limited应为1, 实际: {invuln_buffs[0].hit_limited}"
        )

        # 验证下次受到攻击时伤害变为1点
        hp_before_attack = self.caster.current_hp
        # 用敌方攻击施法者
        atk_result = self.ss.execute_skill(
            caster=self.enemy_phys_front,
            skill_id=120041,  # 四連突，4hit
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(atk_result["success"], f"敌方攻击执行应成功: {atk_result.get('error', '')}")

        # 验证dmg_invulnerable被消费
        invuln_after = [b for b in self.caster.buffs
                        if b.effect_type == DMG_INVULNERABLE]
        self.assertEqual(
            len(invuln_after), 0,
            f"dmg_invulnerable应在受到攻击后被消费, 剩余: {len(invuln_after)}"
        )

        # 验证伤害被无效化（hp减少应远小于正常伤害）
        # 正常4hit攻击伤害远大于4点，无效化后每hit只造成1点
        hp_loss = hp_before_attack - self.caster.current_hp
        self.assertLessEqual(
            hp_loss, 4,
            f"dmg_invulnerable应将每hit伤害无效化为1点, "
            f"HP损失: {hp_loss}, 应<=4"
        )

    # ============================================================
    # AS1: 120023 フォーカススラスト
    # ============================================================

    def test_as1_damage_and_crit_up(self):
        """
        AS1: 敌column攻击 + 自身暴击率上升1行动
        技能描述: 敵columnに攻撃 + 自身の会心率を1行動上昇させる
        验证: AS1使用后，施法者应获得crit_rate_up buff，持续1行动
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120023,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # 验证造成伤害
        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(len(damage_effects) > 0, "AS1技能应造成伤害")

        # 验证获得crit_rate_up buff
        crit_buffs = [b for b in self.caster.buffs
                      if b.effect_type == STATUS_CRIT]
        self.assertTrue(
            len(crit_buffs) > 0,
            f"AS1使用后应获得暴击率上升buff, "
            f"实际buffs: {[(b.effect_type, b.duration) for b in self.caster.buffs]}"
        )

        # 验证持续1行动
        self.assertEqual(
            crit_buffs[0].duration, 1,
            f"crit_rate_up持续应为1行动, 实际: {crit_buffs[0].duration}"
        )

    def test_as1_lv11_extra_attack_physical(self):
        """
        AS1: Lv11+ 主目标为物理类型时追加攻击
        技能描述: Lv11+ 対象が物理タイプだった場合、追加攻撃する
        验证: 主目标为物理类型(character_type=1)时，应有追加伤害效果
        """
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120023,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        # Lv11+且目标为物理类型时，应有2次伤害效果（基础+追加）
        self.assertGreaterEqual(
            len(damage_effects), 2,
            f"Lv11+主目标为物理类型时应有至少2次伤害效果(基础+追加), "
            f"实际: {len(damage_effects)}"
        )

    def test_as1_lv11_no_extra_attack_non_physical(self):
        """
        AS1: Lv11+ 主目标非物理类型时不追加攻击
        验证: 主目标为非物理类型(character_type!=1)时，只有1次伤害效果
        """
        # 创建只有非物理型敌人的战场
        bf2 = BattlefieldState()
        # EN型敌人在前排中间（AS1的enemy_column默认选前排中间）
        enemy_en_center = UnitState(
            unit_id="enemy_en_center", name="敵(EN前列中)", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999003, level=200,
            element=1, character_type=2,  # EN型=2
            max_hp=500000, current_hp=500000,
            attack=50000, defense=30000, speed=400,
            crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        bf2.add_unit(self.caster)
        bf2.add_unit(enemy_en_center)

        # 重建服务绑定到新战场
        ss2 = SkillService(
            self.dl, self.rs,
            target_service=self.tgtsvc,
            damage_service=self.dmgsvc,
            aura_service=self.asvc,
            status_service=self.stsvc,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(ss2)
        ss2.set_battlefield(bf2)

        result = ss2.execute_skill(
            caster=self.caster,
            skill_id=120023,
            battlefield=bf2,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage" and len(e.get("targets", [])) > 0]
        # 主目标非物理类型时，只有1次伤害效果（追加攻击因char_type过滤无目标）
        self.assertEqual(
            len(damage_effects), 1,
            f"主目标非物理类型时应有1次伤害效果, 实际: {len(damage_effects)}"
        )

        # 恢复原始服务的战场绑定
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

