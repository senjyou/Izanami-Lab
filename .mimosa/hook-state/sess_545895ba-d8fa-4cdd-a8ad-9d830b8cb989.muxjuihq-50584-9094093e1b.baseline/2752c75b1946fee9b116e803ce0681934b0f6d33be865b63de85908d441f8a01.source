#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""角色119301 戦うアントレプレナー 技能效果集成测试

测试场景：
- 角色: 戦うアントレプレナー (character_id=119301, 火属性=1, 敏捷型=3, 灵活站位)
- EX: 110015 大儲けだー！ (敌横列hit攻击[Lv1-10:7hit, Lv15:12hit], 自身dmg_invulnerable buff hit_limited=1)
- AS1: 120023 フォーカススラスト (敌column攻击, 自身暴击率上升1行动, Lv11+: 主目标物理型追加攻击)
- AS2: 120041 四連突 (敌单体4hit攻击)
- PS1: 130031 CRTフォーカス (on_turn_start触发, 自身暴击率永续可叠加, cooldown=99, Lv11+: 追加4行动必中)
- PS2: 130047 ラッキー4！ (on_critical触发, crit_count_mod=4, 敌单体伤害+自身最大HP×20%特殊伤害)
"""

import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService

# 常用枚举值简写
SET = SkillEffectType
STATUS_CRIT = SET.STATUS_CRITICAL_CHANCE.value   # crit_rate_up映射后的值
DMG_INVULNERABLE = SET.DMG_INVULNERABLE.value     # dmg_invulnerable映射后的值
SURE_HIT = SET.SURE_HIT.value                     # sure_hit映射后的值
EVADE = SET.EVADE.value                           # evade映射后的值
GUARD = SET.GUARD.value                           # guard映射后的值


class TestActor119301(unittest.TestCase):
    """角色119301 戦うアントレプレナー 技能效果集成测试"""

    @classmethod
