            max_hp=120000, current_hp=120000,
            attack=150000, defense=50000, speed=1000,
            crit_rate=0.00, crit_damage=0.5, advantage_damage=0.0,  # crit_rate=0避免暴击影响测试
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=50,
            skills=[110015, 120023, 120041, 130031, 130047],
            skill_levels={110015: 15, 120023: 15, 120041: 15, 130031: 15, 130047: 15},
            skill_cooldowns={},
        )

        # 敌方A (物理型=1, 前排左)
        self.enemy_phys_front = UnitState(
