    def test_120077_as_mark_count_uses_pre_crit_state(self):
        """120077 AS: mark_count检查的是暴击前的mark数，不包含当次暴击施加的mark。

        场景: 目标有2个mark（<3，不应knockout），暴击后+1 mark = 3个。
        若错误使用暴击后的mark数，会误判为3个导致knockout。
        """
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[120077],
                    level=15, atk=10000, speed=999, crit_rate=1.0)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT, hp=9999999)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
        e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")
        # 2 marks pre-existing
        for m in _make_target_mark("pre", 2):
            e1.debuffs.append(m)

        ss.execute_skill(caster=rebel, skill_id=120077, battlefield=bf, skip_cost=True)

        # After crit, target should have 3 marks (2 pre + 1 from crit)
        marks = [d for d in e1.debuffs if d.effect_type == MARK and d.name == TARGET_MARK]
        self.assertEqual(len(marks), 3, "Target should have 3 marks after crit (2 pre + 1 new)")
        # But no knockout (pre-crit mark count was 2, < 3)
        knockouts = [d for d in e1.debuffs if d.effect_type == KNOCKOUT]
        self.assertEqual(len(knockouts), 0,
                         "No knockout: pre-crit mark count was 2 (<3), even though post-crit is 3")

    def test_120077_as_repeated_crits_accumulate_marks(self):
        """120077 AS: 多次暴击应累积mark数。

        bug: Block3 mark未配置stackable=true时，buff_id固定为
        `{caster}_{skill_id}_Mark_{target}`，add_aura中同buff_id走refresh逻辑
        (相同value+duration时不更新)，导致mark_count永远=1。
        修复: mark effect flags添加stackable=true，每次crit生成唯一buff_id独立存储。

        场景: 同一目标连续暴击3次，期望mark_count=3 (满足120076 Block2 burn条件)。
        """
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[120077],
                    level=15, atk=10000, speed=999, crit_rate=1.0)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT, hp=99999999)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
        e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")

        # 连续3次暴击施放120077
        for i in range(3):
            ss.execute_skill(caster=rebel, skill_id=120077, battlefield=bf, skip_cost=True)

        # 应累积3个mark实例
        marks = [d for d in e1.debuffs if d.effect_type == MARK and d.name == TARGET_MARK]
        self.assertEqual(len(marks), 3,
                         "3次暴击应累积3个ターゲットmark (stackable=true, each crit generates unique buff_id)")

    def test_120077_as_repeated_crits_lv15_knockout_triggers(self):
        """120077 AS Lv15: 累积3个mark后，第4次暴击应触发knockout。

        验证: 多次暴击累积mark + Lv11+ mark>=3条件触发knockout。
        """
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[120077],
                    level=15, atk=10000, speed=999, crit_rate=1.0)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT, hp=99999999)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
        e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")

        # 先累积3个mark (3次暴击)
        for i in range(3):
            ss.execute_skill(caster=rebel, skill_id=120077, battlefield=bf, skip_cost=True)
        # 此时mark_count=3

        # 第4次暴击: pre-crit mark=3 >= 3, 应触发knockout
        ss.execute_skill(caster=rebel, skill_id=120077, battlefield=bf, skip_cost=True)

        knockouts = [d for d in e1.debuffs if d.effect_type == KNOCKOUT]
        self.assertGreater(len(knockouts), 0,
                           "第4次暴击时pre-crit mark=3>=3, 应触发knockout")
        self.assertEqual(knockouts[0].duration, 1, "knockout应持续1行动")

    def test_120076_as_burn_triggers_when_mark_ge_3(self):
        """120076 AS: 通过120077累积3个mark后，120076 Block2应触发burn。

        验证: 120076 Block2条件 mark_count>=3 通过120077 mark累积后能正常触发。
        """
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[120076, 120077],
                    level=15, atk=10000, speed=999, crit_rate=1.0)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT, hp=99999999)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
        e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")

        # 先用120077累积3个mark
        for i in range(3):
            ss.execute_skill(caster=rebel, skill_id=120077, battlefield=bf, skip_cost=True)
        marks_before = [d for d in e1.debuffs if d.effect_type == MARK and d.name == TARGET_MARK]
        self.assertEqual(len(marks_before), 3, "前置: 3次120077暴击应累积3个mark")

        # 执行120076: 此时mark_count=3, Block2应触发burn
        ss.execute_skill(caster=rebel, skill_id=120076, battlefield=bf, skip_cost=True)

        burns = [d for d in e1.debuffs if d.effect_type == BURN]
        self.assertGreater(len(burns), 0,
                           "120076 Block2应在mark>=3时施加burn")
        self.assertEqual(burns[0].duration, 1, "burn应持续1行动")

    # ── 130086 PS ────────────────────────────────────────────

    def test_130086_ps_trigger_type_on_ally_killed(self):
        """130086 PS: trigger_type应为on_ally_killed。"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[130086], level=10)
        ctx = bb.build()
        ss = ctx['ss']
        parsed = ss.data_loader.get_parsed_skill_data(130086)
        self.assertEqual(parsed.get('trigger_type'), 'on_ally_killed',
                         "130086 trigger_type should be on_ally_killed")

    def test_130086_ps_triggers_on_ally_killed_targets_killer(self):
        """130086 PS: 味方被击倒时触发，对killer施加damage + ターゲットmark。"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[130086],
                    level=10, atk=10000, speed=999, pp=10)
        bb.add_ally(unit_id="ally1", hp=100, atk=100, speed=100)  # will be killed
        bb.add_enemy(unit_id="killer", position=Position.ENEMY_CENTER_FRONT,
                     hp=999999, atk=50000, speed=500)
        ctx = bb.build()
        bf, ss, ts = ctx['bf'], ctx['ss'], ctx['ts']
        rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
        ally1 = next(u for u in bf.friend_team if u.unit_id == "ally1")
        killer = next(u for u in bf.enemy_team if u.unit_id == "killer")

        # Kill ally1
        ally1.current_hp = 0
        ally1.is_alive = False

        # Trigger on_ally_killed with killer
        actions = ts.trigger_pawn_died([ally1], bf, killer=killer)
        ps_actions = [a for a in actions if a.skill_id == 130086]
        self.assertGreater(len(ps_actions), 0,
                           "130086 should trigger when ally is killed")
        # Verify trigger_attacker is the killer
        self.assertEqual(ps_actions[0].parameters.get('trigger_attacker').unit_id, "killer",
                         "trigger_attacker should be the killer")

        # Execute the PS action
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps_actions, bf, trigger_timing="pawn_died")

        # Killer should have ターゲット mark and have taken damage
        marks = [d for d in killer.debuffs if d.effect_type == MARK and d.name == TARGET_MARK]
        self.assertGreater(len(marks), 0, "Killer should have ターゲット mark")
        self.assertLess(killer.current_hp, killer.max_hp, "Killer should take damage from 130086")

    def test_130086_ps_lv11_plus_applies_dmg_taken_up(self):
        """130086 PS Lv11+: on_ally_killed时对killer施加dmg_taken_up(attack_limited=1)。"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[130086],
                    level=15, atk=10000, speed=999, pp=10)
        bb.add_ally(unit_id="ally1", hp=100, atk=100, speed=100)
        bb.add_enemy(unit_id="killer", position=Position.ENEMY_CENTER_FRONT,
                     hp=999999, atk=50000, speed=500)
        ctx = bb.build()
        bf, ss, ts = ctx['bf'], ctx['ss'], ctx['ts']
        rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
        ally1 = next(u for u in bf.friend_team if u.unit_id == "ally1")
        killer = next(u for u in bf.enemy_team if u.unit_id == "killer")

        ally1.current_hp = 0
        ally1.is_alive = False

        actions = ts.trigger_pawn_died([ally1], bf, killer=killer)
        ps_actions = [a for a in actions if a.skill_id == 130086]
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps_actions, bf, trigger_timing="pawn_died")

        dmg_taken_up_buffs = [d for d in killer.debuffs if d.effect_type == DMG_TAKEN_UP]
        self.assertGreater(len(dmg_taken_up_buffs), 0,
                           "Killer should have dmg_taken_up at Lv15")
        self.assertEqual(dmg_taken_up_buffs[0].attack_limited, 1,
                         "dmg_taken_up should have attack_limited=1")

