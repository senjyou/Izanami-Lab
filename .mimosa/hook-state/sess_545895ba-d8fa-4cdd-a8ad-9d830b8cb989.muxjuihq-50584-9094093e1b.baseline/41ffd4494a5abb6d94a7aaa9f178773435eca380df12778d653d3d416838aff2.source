"""Regression tests for 【気高きランウェイモデル】レイヴェル・ブライトリーフ (138301).

Tests 5 skills:
- 110033 (EX): damage + ターゲットmark + (Lv11+) dmg_taken_up
- 120076 (AS): damage with conditional_power_bonus (mark tiers) + (mark>=3) burn
- 120077 (AS): damage + on_crit mark + (Lv11+ mark>=3) knockout
- 130086 (PS): on_ally_killed → damage + mark + (Lv11+) dmg_taken_up on killer
- 130087 (PS): on_turn_end → ターゲットmark filter → remove_ep + def_down

Also covers code modifications:
- on_crit block collection supports `and` condition with on_crit sub-condition
- _apply_on_crit_blocks evaluates mark_count sub-condition on crit target
- _apply_aura supports target_identifier="trigger_attacker"
- _apply_add_status supports target_type="crit_target"
- trigger_pawn_died supports killer parameter (on_ally_killed trigger_attacker=killer)
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute, SkillEffectType
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.resource_service import ResourceService

MARK = SkillEffectType.MARK.value
TARGET_MARK = "ターゲット"
KNOCKOUT = SkillEffectType.KNOCKOUT.value
BURN = SkillEffectType.CONFLAGRATION.value
DEF_DOWN = SkillEffectType.STATUS_DEFENSE.value
DMG_TAKEN_UP = SkillEffectType.RECEIVED_DAMAGE.value


def _make_target_mark(source_id="pre", count=1):
    """Generate count pre-existing ターゲット mark BuffStates (debuff)."""
    return [
        BuffState(
            buff_id=f"{source_id}_target_mark_{i}",
            name=TARGET_MARK,
            effect_type=MARK,
            value=0,
            duration=-1,
            timing_type=2,
            source_unit_id=source_id,
            source_skill_id=0,
            is_debuff=True,
        )
        for i in range(count)
    ]


class TestRegRebel138301(unittest.TestCase):
    """138301 レイヴェル・ブライトリーフ skill effects regression tests."""

    # ── 110033 EX ────────────────────────────────────────────

    def test_110033_ex_damage_and_mark_all_enemies(self):
        """110033 EX: 全敵に威力ダメージ + ターゲットmark(永続)付与。"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[110033],
                    level=10, atk=10000, speed=999)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT, hp=200000)
        bb.add_enemy(unit_id="e2", position=Position.ENEMY_LEFT_FRONT, hp=200000)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
        e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")
        e2 = next(u for u in bf.enemy_team if u.unit_id == "e2")

        ss.execute_skill(caster=rebel, skill_id=110033, battlefield=bf, skip_cost=True)

        # Both enemies should have ターゲット mark (permanent)
        e1_marks = [d for d in e1.debuffs if d.effect_type == MARK and d.name == TARGET_MARK]
        e2_marks = [d for d in e2.debuffs if d.effect_type == MARK and d.name == TARGET_MARK]
        self.assertEqual(len(e1_marks), 1, "e1 should have 1 ターゲット mark from EX")
        self.assertEqual(len(e2_marks), 1, "e2 should have 1 ターゲット mark from EX")
        self.assertEqual(e1_marks[0].duration, -1, "ターゲット mark should be permanent (duration=-1)")
        self.assertEqual(e2_marks[0].duration, -1, "ターゲット mark should be permanent (duration=-1)")
        # Both enemies should have taken damage
        self.assertLess(e1.current_hp, e1.max_hp, "e1 should take damage from EX")
        self.assertLess(e2.current_hp, e2.max_hp, "e2 should take damage from EX")

    def test_110033_ex_lv11_plus_applies_dmg_taken_up(self):
        """110033 EX Lv11+: 全敵に威力ダメージ + ターゲットmark + dmg_taken_up(attack_limited=1, stackable)。"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[110033],
                    level=15, atk=10000, speed=999)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT, hp=200000)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
        e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")

        ss.execute_skill(caster=rebel, skill_id=110033, battlefield=bf, skip_cost=True)

        dmg_taken_up_buffs = [d for d in e1.debuffs if d.effect_type == DMG_TAKEN_UP]
        self.assertGreater(len(dmg_taken_up_buffs), 0,
                           "e1 should have dmg_taken_up debuff at Lv15")
        self.assertEqual(dmg_taken_up_buffs[0].attack_limited, 1,
                         "dmg_taken_up should have attack_limited=1 (consumed after 1 attack)")

