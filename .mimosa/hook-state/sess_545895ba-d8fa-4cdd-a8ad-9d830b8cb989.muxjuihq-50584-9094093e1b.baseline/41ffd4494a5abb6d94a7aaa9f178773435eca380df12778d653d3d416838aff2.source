    # ── 120076 AS ────────────────────────────────────────────

    def test_120076_as_conditional_power_bonus_by_mark_count(self):
        """120076 AS: 根据目标mark数量阶梯增伤 (0→0%, 1→10%, 2→20%, 3→30%)。"""
        # Test each tier with separate setup, comparing damage
        def _setup_with_marks(mark_count):
            bb = BattleBuilder()
            bb.add_ally(unit_id="rebel", character_id=138301, skills=[120076],
                        level=15, atk=10000, speed=999, crit_rate=0.0)
            bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT, hp=9999999)
            ctx = bb.build()
            bf, ss = ctx['bf'], ctx['ss']
            rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
            e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")
            if mark_count > 0:
                for m in _make_target_mark("pre", mark_count):
                    e1.debuffs.append(m)
            return bf, ss, rebel, e1

        # No mark baseline
        bf, ss, rebel, e1 = _setup_with_marks(0)
        hp_before = e1.current_hp
        ss.execute_skill(caster=rebel, skill_id=120076, battlefield=bf, skip_cost=True)
        dmg_0 = hp_before - e1.current_hp

        # 1 mark: +10%
        bf, ss, rebel, e1 = _setup_with_marks(1)
        hp_before = e1.current_hp
        ss.execute_skill(caster=rebel, skill_id=120076, battlefield=bf, skip_cost=True)
        dmg_1 = hp_before - e1.current_hp

        # 3 marks: +30%
        bf, ss, rebel, e1 = _setup_with_marks(3)
        hp_before = e1.current_hp
        ss.execute_skill(caster=rebel, skill_id=120076, battlefield=bf, skip_cost=True)
        dmg_3 = hp_before - e1.current_hp

        # Damage should increase with mark count
        self.assertGreater(dmg_1, dmg_0, "Damage with 1 mark should be higher than 0 marks (10% bonus)")
        self.assertGreater(dmg_3, dmg_1, "Damage with 3 marks should be higher than 1 mark (30% vs 10%)")
        # Approximate ratio check (allow some tolerance for defense calculations)
        ratio_1 = dmg_1 / dmg_0 if dmg_0 > 0 else 0
        ratio_3 = dmg_3 / dmg_0 if dmg_0 > 0 else 0
        self.assertGreater(ratio_1, 1.05, f"1 mark bonus should be ~10% (got ratio={ratio_1:.3f})")
        self.assertGreater(ratio_3, 1.25, f"3 marks bonus should be ~30% (got ratio={ratio_3:.3f})")

