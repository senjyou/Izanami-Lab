    def test_120077_as_lv11_plus_crit_mark_ge_3_applies_knockout(self):
        """120077 AS Lv11+: 暴击且目标已有3+mark时追加1行动気絶。

        关键: Block2(knockout)在Block3(mark)之前执行，检查的是攻击前的mark数。
        """
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[120077],
                    level=15, atk=10000, speed=999, crit_rate=1.0)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT, hp=9999999)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
        e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")
        # 3 marks pre-existing (BEFORE this skill's crit mark)
        for m in _make_target_mark("pre", 3):
            e1.debuffs.append(m)

        ss.execute_skill(caster=rebel, skill_id=120077, battlefield=bf, skip_cost=True)

        knockouts = [d for d in e1.debuffs if d.effect_type == KNOCKOUT]
        self.assertGreater(len(knockouts), 0,
                           "e1 with 3 pre-existing marks should get knockout on crit at Lv15")
        self.assertEqual(knockouts[0].duration, 1, "knockout should last 1 action")

