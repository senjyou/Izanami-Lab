        # 3 marks pre-existing
        for m in _make_target_mark("pre", 3):
            e1.debuffs.append(m)

        ss.execute_skill(caster=rebel, skill_id=120076, battlefield=bf, skip_cost=True)

        burns = [d for d in e1.debuffs if d.effect_type == BURN]
        self.assertGreater(len(burns), 0, "e1 with 3 marks should get burn")
        self.assertEqual(burns[0].duration, 1, "burn should last 1 action")

