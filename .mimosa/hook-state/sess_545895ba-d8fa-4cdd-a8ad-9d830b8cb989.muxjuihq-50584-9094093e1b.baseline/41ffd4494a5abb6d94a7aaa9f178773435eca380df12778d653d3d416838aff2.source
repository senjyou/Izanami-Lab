    # ── 130087 PS ────────────────────────────────────────────

    def test_130087_ps_trigger_type_on_turn_end(self):
        """130087 PS: trigger_type应为on_turn_end。"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[130087], level=10)
        ctx = bb.build()
        ss = ctx['ss']
        parsed = ss.data_loader.get_parsed_skill_data(130087)
        self.assertEqual(parsed.get('trigger_type'), 'on_turn_end',
                         "130087 trigger_type should be on_turn_end")

    def test_130087_ps_filters_marked_enemies(self):
        """130087 PS: on_turn_end → ターゲットmarkを持つ敵にremove_ep + def_down。

        场景: e1有mark，e2无mark。PS应只作用于e1。
        """
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[130087],
                    level=10, atk=10000, speed=999, pp=10)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT,
                     hp=200000, ep=5)
        bb.add_enemy(unit_id="e2", position=Position.ENEMY_LEFT_FRONT,
                     hp=200000, ep=5)
        ctx = bb.build()
        bf, ss, ts = ctx['bf'], ctx['ss'], ctx['ts']
        rebel = next(u for u in bf.friend_team if u.unit_id == "rebel")
        e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")
        e2 = next(u for u in bf.enemy_team if u.unit_id == "e2")

        # Only e1 gets ターゲット mark
        for m in _make_target_mark("pre", 1):
            e1.debuffs.append(m)
        e1_ep_before = e1.current_ep
        e2_ep_before = e2.current_ep

        # Trigger on_turn_end
        actions = ts.trigger_turn_end(bf)
        ps_actions = [a for a in actions if a.skill_id == 130087]
        self.assertGreater(len(ps_actions), 0,
                           "130087 should trigger on turn_end when marked enemies exist")

        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps_actions, bf, trigger_timing="turn_end")

        # e1 should have: EP reduced, def_down applied
        self.assertLess(e1.current_ep, e1_ep_before,
                        "e1 (marked) should have EP reduced")
        e1_def_downs = [d for d in e1.debuffs if d.effect_type == DEF_DOWN]
        self.assertGreater(len(e1_def_downs), 0,
                           "e1 (marked) should have def_down")
        self.assertEqual(e1_def_downs[0].duration, 2, "def_down should last 2 actions")

        # e2 (no mark) should NOT be affected
        self.assertEqual(e2.current_ep, e2_ep_before,
                         "e2 (no mark) should NOT have EP reduced")
        e2_def_downs = [d for d in e2.debuffs if d.effect_type == DEF_DOWN]
        self.assertEqual(len(e2_def_downs), 0,
                         "e2 (no mark) should NOT have def_down")

    def test_130087_ps_no_marked_enemies_no_effect(self):
        """130087 PS: 无mark敌时不施加任何效果。"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[130087],
                    level=10, atk=10000, speed=999, pp=10)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT,
                     hp=200000, ep=5)
        ctx = bb.build()
        bf, ss, ts = ctx['bf'], ctx['ss'], ctx['ts']
        e1 = next(u for u in bf.enemy_team if u.unit_id == "e1")
        e1_ep_before = e1.current_ep

        # No mark on any enemy
        actions = ts.trigger_turn_end(bf)
        ps_actions = [a for a in actions if a.skill_id == 130087]
        # 130087 should not trigger (mark_count condition not met)
        # Even if it triggers (PS collects), the mark_count block should skip
        if ps_actions:
            ss._pending_crit_triggers = []
            ss._execute_trigger_actions_inline(ps_actions, bf, trigger_timing="turn_end")

        # e1 should not have EP reduced or def_down applied
        self.assertEqual(e1.current_ep, e1_ep_before,
                         "e1 (no mark) should NOT have EP reduced")
        e1_def_downs = [d for d in e1.debuffs if d.effect_type == DEF_DOWN]
        self.assertEqual(len(e1_def_downs), 0,
                         "e1 (no mark) should NOT have def_down")

    # ── trigger_pawn_died killer parameter ───────────────────

    def test_trigger_pawn_died_passes_killer_as_actor(self):
        """trigger_pawn_died应将killer作为TriggerContext.actor传递。"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="rebel", character_id=138301, skills=[130086], level=10)
        bb.add_ally(unit_id="ally1", hp=100)
        bb.add_enemy(unit_id="killer", position=Position.ENEMY_CENTER_FRONT, hp=999999)
        ctx = bb.build()
        ts = ctx['ts']
        bf = ctx['bf']
        ally1 = next(u for u in bf.friend_team if u.unit_id == "ally1")
        killer = next(u for u in bf.enemy_team if u.unit_id == "killer")

        ally1.current_hp = 0
        ally1.is_alive = False

        # With killer parameter
        actions_with_killer = ts.trigger_pawn_died([ally1], bf, killer=killer)
        # Find 130086 action
        ps_actions = [a for a in actions_with_killer if a.skill_id == 130086]
        self.assertGreater(len(ps_actions), 0,
                           "130086 should trigger when killer is passed")
        self.assertEqual(
            ps_actions[0].parameters.get('trigger_attacker').unit_id,
            "killer",
            "trigger_attacker should be the killer"
        )

        # Without killer parameter (backward compat) - trigger_attacker should be None
        actions_no_killer = ts.trigger_pawn_died([ally1], bf)
        ps_actions_no_killer = [a for a in actions_no_killer if a.skill_id == 130086]
        if ps_actions_no_killer:
            self.assertIsNone(
                ps_actions_no_killer[0].parameters.get('trigger_attacker'),
                "Without killer parameter, trigger_attacker should be None"
            )


if __name__ == '__main__':
    unittest.main(verbosity=2)
