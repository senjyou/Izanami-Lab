"""角色102303 穹に閃く探求の学識 专项E2E测试（随机索敌EN连击 + 资源破坏 + 友方被AS攻击追击 + 回合开始威力up）

技能列表（5个）:
- EX: 110079 推測通り……だね♪（随机敌单体5hit EN攻击，L11+同目标追加1hit）
- AS1: 120169 コンクルージョン・ブラスト（随机敌单体EN攻击[回避不可]+AP/PP各削2，敌存活>=3限定）
- AS2: 120170 プレゼンスリザルト（敌单体EN攻击）
- PS1: 130177 アナライズチェイス（他の味方被敌AS攻击后→EN反击攻击者+与ダメdown 1行动重複可）
- PS2: 130178 イントロダクションライド（ターン開始時スキル威力up 1ターン，1ターン目不发動）

覆盖维度:
1. EX 随机索敌（seed固定）: 5hit全中同一随机目标；L11+ 第6hit同目标（缓存复用）；L10时第6hit不执行
2. AS1 随机目标削资源（damage与remove_ap/remove_pp同目标）；敌存活<3时gc阻止（不消耗AP）
3. AS1 sure_hit（回避不可）buff存在
4. AS2 标准单体EN攻击
5. PS1 友方被AS攻击→反击攻击者（trigger_attacker）+debuff；自身被攻击不触发
6. PS2 回合1不触发/回合2+触发+威力乘区实际生效（skill_power_up buff + SKILL_POWER_UP伤害提升）
7. 配置校验
"""
import unittest
import sys
import os
import random

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
MODIFY_SKILL_POWER = SkillEffectType.MODIFY_SKILL_POWER.value


class TestActor102303(unittest.TestCase):

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        self.caster = UnitState(
            unit_id="caster", name="探求の学識", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=102303, level=10,
            element=4, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=5,
            skills=[110079, 120169, 120170, 130177, 130178],
            skill_levels={110079: 10, 120169: 10, 120170: 10,
                          130177: 10, 130178: 10},
            skill_cooldowns={},
        )
        self.ally_lf = UnitState(
            unit_id="ally_lf", name="味方左前", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=5000, speed=450,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.enemy_cf = self._mk_enemy("enemy_cf", "敵中前", Position.ENEMY_CENTER_FRONT)
        self.enemy_lf = self._mk_enemy("enemy_lf", "敵左前", Position.ENEMY_LEFT_FRONT)
        self.enemy_rf = self._mk_enemy("enemy_rf", "敵右前", Position.ENEMY_RIGHT_FRONT)

        self.bf.friend_team = [self.caster, self.ally_lf]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs, damage_service=self.dms,
            aura_service=self.aus, status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _mk_enemy(self, unit_id, name, position):
        return UnitState(
            unit_id=unit_id, name=name, side=Side.ENEMY,
            position=position, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    def _reset(self, level=10):
        self.caster.current_hp = self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = 10
        self.caster.current_pp = 10
        self.caster.current_ep = 5
        self.caster.level = level
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = level
        self.ally_lf.current_hp = self.ally_lf.max_hp
        self.ally_lf.buffs = []
        self.ally_lf.debuffs = []
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.current_ap = 4
            e.current_pp = 4
            e.is_alive = True

    def _damaged_enemies(self, before):
        return [u for u in [self.enemy_cf, self.enemy_lf, self.enemy_rf]
                if u.current_hp < before[u.unit_id]]

    # ══════════════════ EX 110079 ══════════════════

    def test_ex_110079_random_single_target_lv10(self):
        """EX Lv10: 5hit全中同一随机目标（seed固定），只有一个敌人受击。"""
        self._reset()
        random.seed(12345)
        before = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=110079,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertGreater(result["total_damage"], 0)
        hit = self._damaged_enemies(before)
        self.assertEqual(len(hit), 1, f"5hit应全部落在同一随机目标，实际命中: {hit}")

    def test_ex_110079_lv11_sixth_hit_same_target(self):
        """EX Lv11+: 5hit+追加1hit，6hit全中同一随机目标。"""
        self._reset(level=11)
        random.seed(999)
        before = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=110079,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        hit = self._damaged_enemies(before)
        self.assertEqual(len(hit), 1, "6hit应全部落在同一随机目标（缓存复用）")

    def test_ex_110079_lv10_no_sixth_hit(self):
        """EX Lv10: 无第6hit（威力2 tag Lv1-10=0且effect level_min=11）。
        验证方式: Lv10与Lv11同seed下总伤不同（第6hit存在差异）。"""
        self._reset(level=10)
        random.seed(777)
        before10 = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        self.ss.execute_skill(caster=self.caster, skill_id=110079,
                              battlefield=self.bf, skip_cost=True)
        dmg_lv10 = sum(before10[u.unit_id] - u.current_hp
                       for u in [self.enemy_cf, self.enemy_lf, self.enemy_rf])
        self._reset(level=11)
        random.seed(777)
        before11 = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        self.ss.execute_skill(caster=self.caster, skill_id=110079,
                              battlefield=self.bf, skip_cost=True)
        dmg_lv11 = sum(before11[u.unit_id] - u.current_hp
                       for u in [self.enemy_cf, self.enemy_lf, self.enemy_rf])
        self.assertGreater(dmg_lv11, dmg_lv10, "Lv11+应有第6hit加成（同seed对比）")

    # ══════════════════ AS1 120169 ══════════════════

    def test_as1_120169_random_target_resource_drain(self):
        """AS1: 随机目标受击且AP/PP各-2（与damage同一目标）。"""
        self._reset()
        random.seed(42)
        before = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=120169,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        hit = self._damaged_enemies(before)
        self.assertEqual(len(hit), 1, "随机单体应只有1个目标受击")
        target = hit[0]
        self.assertEqual(target.current_ap, 2, "被击目标AP应-2")
        self.assertEqual(target.current_pp, 2, "被击目标PP应-2")
        # 未被击目标资源不变
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            if e.unit_id != target.unit_id:
                self.assertEqual(e.current_ap, 4, "未击中目标AP不变")
                self.assertEqual(e.current_pp, 4, "未击中目标PP不变")

    def test_as1_120169_blocked_when_enemies_below_3(self):
        """AS1: 生存敌人<3时global_condition阻止发动（select_skill层过滤，规则11.20设计）。"""
        self._reset()
        resolved = self.ss._resolver.resolve(120169, 10)
        # 3敌存活 → 允许
        self.assertTrue(self.ss._check_skill_global_condition(resolved, self.caster, self.bf),
                        "敌存活3时应允许发动")
        # 1敌存活 → 阻止
        self.enemy_lf.is_alive = False
        self.enemy_rf.is_alive = False
        self.assertFalse(self.ss._check_skill_global_condition(resolved, self.caster, self.bf),
                         "敌存活<3时应阻止发动")
        # select_skill应跳过被gc阻止的120169，回退到无gc条件的120170（不浪费AP）
        self.enemy_lf.is_alive = True
        self.enemy_rf.is_alive = False
        self.caster.current_ep = 0  # 阻止EX
        chosen = self.ss.select_skill(self.caster)
        self.assertEqual(chosen, 120170,
                         "120169被gc阻止时select_skill应回退到120170")

    def test_as1_120169_sure_hit_buff_applied(self):
        """AS1: sure_hit（回避不可）buff随技能施加（skill级时效）。"""
        self._reset()
        random.seed(7)
        # 拦截检查：技能执行期间sure_hit存在（执行后skill级清除，这里验证执行成功即路径走通）
        result = self.ss.execute_skill(caster=self.caster, skill_id=120169,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertGreater(result["total_damage"], 0)

    # ══════════════════ AS2 120170 ══════════════════

    def test_as2_120170_single_target(self):
        """AS2: 敌单体EN攻击（最近敌）。"""
        self._reset()
        before = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=120170,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        hit = self._damaged_enemies(before)
        self.assertEqual(len(hit), 1)
        self.assertEqual(hit[0].unit_id, "enemy_cf", "应攻击最近敌cf")

    # ══════════════════ PS1 130177 ══════════════════

    def _trigger_chase(self, attacked_ally):
        actions = self.ts.trigger_after_as_attacked_ally(
            targets=[attacked_ally], battlefield=self.bf,
            actor=self.enemy_cf, primary_target=attacked_ally,
        )
        return [a for a in actions if a.skill_id == 130177]

    def test_ps1_130177_counter_attacker(self):
        """PS1: 其他友方被敌AS攻击后→EN反击攻击者+与ダメdown debuff。"""
        self._reset()
        cf_hp_before = self.enemy_cf.current_hp
        ps1 = self._trigger_chase(self.ally_lf)
        self.assertGreater(len(ps1), 0, "友方被AS攻击应触发追击")
        self.ss._execute_trigger_actions_inline(ps1, self.bf)
        self.assertLess(self.enemy_cf.current_hp, cf_hp_before, "应反击攻击者enemy_cf")
        downs = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreaterEqual(len(downs), 1, "攻击者应获得与ダメdown debuff")
        self.assertEqual(downs[0].duration, 1, "debuff持续1行动")

    def test_ps1_130177_no_trigger_when_self_attacked(self):
        """PS1: 自身被攻击时不触发（他の味方限定）。"""
        self._reset()
        cf_hp_before = self.enemy_cf.current_hp
        ps1 = self._trigger_chase(self.caster)
        self.assertEqual(len(ps1), 0, "自身被攻击不应触发")
        self.assertEqual(self.enemy_cf.current_hp, cf_hp_before)

    # ══════════════════ PS2 130178 ══════════════════

    def _run_turn_start(self):
        actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2 = [a for a in actions if a.skill_id == 130178]
        if ps2:
            self.ss._execute_trigger_actions_inline(ps2, self.bf, trigger_timing="on_turn_start")
        return ps2

    def test_ps2_130178_no_trigger_round_1(self):
        """PS2: 1ターン目不发动。"""
        self._reset()
        self.bf.turn_number = 1
        ps2 = self._run_turn_start()
        self.assertEqual(len(ps2), 0, "1ターン目不应触发")

    def test_ps2_130178_triggers_round_2_with_buff(self):
        """PS2: 回合2+触发，获得スキル威力up buff（1ターン）。"""
        self._reset()
        self.bf.turn_number = 2
        ps2 = self._run_turn_start()
        self.assertGreater(len(ps2), 0, "回合2应触发")
        buffs = [b for b in self.caster.buffs if b.effect_type == MODIFY_SKILL_POWER]
        self.assertGreaterEqual(len(buffs), 1, "应获得skill_power_up buff")
        self.assertEqual(buffs[0].duration, 1, "持续1ターン")
        self.assertEqual(getattr(buffs[0], 'original_duration_type', None), "turn",
                         "应为回合制持续时间")

    def test_ps2_130178_power_up_increases_damage(self):
        """PS2: 威力up实际生效——skill_factor提升使伤害增大。"""
        self._reset()
        self.bf.turn_number = 2
        self._run_turn_start()
        # 无buff基准
        buff = [b for b in self.caster.buffs if b.effect_type == MODIFY_SKILL_POWER][0]
        self.caster.buffs.remove(buff)
        dmg_obj = type('obj', (object,), {
            'power': 100.0, 'hit_count': 1, 'element': 4,
            'ignore_defense': 0, 'ignore_shield': 0, 'hp_scaling_bonus': 0.0,
            'cannot_crit': True, 'force_crit': False, 'bonus_crit_rate': 0.0,
            'skill_id': 120170, 'name': 'test', 'base_value_source': None,
        })
        base_dmg = self.dms.calculate_damage(self.caster, self.enemy_cf, dmg_obj).total_damage
        self.caster.buffs.append(buff)
        buffed_dmg = self.dms.calculate_damage(self.caster, self.enemy_cf, dmg_obj).total_damage
        # Lv10 buff tag = 5.0 → 伤害应约×1.05
        self.assertAlmostEqual(buffed_dmg, base_dmg * 1.05, delta=max(5, base_dmg * 0.02),
                               msg=f"威力up 5%应生效: base={base_dmg} buffed={buffed_dmg}")

    # ══════════════════ 配置校验 ══════════════════

    def test_config_validation(self):
        """配置校验: gc/triggers注册。"""
        p169 = self.dl.get_parsed_skill_data(120169)
        self.assertEqual(p169.get('global_condition', {}).get('type'), 'enemy_alive_count')
        p177 = self.dl.get_parsed_skill_data(130177)
        self.assertEqual(p177['trigger_type'], 'after_as_attacked_ally')
        for blk_ in p177['effect_blocks']:
            for eff_ in blk_['effects']:
                self.assertEqual(eff_.get('target_identifier'), 'trigger_attacker',
                                 "反击效果必须定位trigger_attacker")
        p178 = self.dl.get_parsed_skill_data(130178)
        self.assertEqual(p178['trigger_type'], 'on_turn_start')
        self.assertEqual(p178.get('global_condition', {}).get('type'), 'round_number')


if __name__ == '__main__':
    unittest.main()
