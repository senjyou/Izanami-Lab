import json
import os
import sys
from pathlib import Path

# 添加项目根目录到路径
project_root = Path(__file__).parent.parent.parent
sys.path.append(str(project_root))

from src.combat.skill_parser import SkillParser
from src.combat.effect import Effect

def dump_skill_effects():
    """转储技能效果"""
    data_dir = project_root / "data"
    skills_file = data_dir / "skills.json"
    output_file = data_dir / "skill_effects.json"
    
    print(f"Loading skills from {skills_file}...")
    
    with open(skills_file, "r", encoding="utf-8") as f:
        skills_data = json.load(f)
        
    dump_data = {}
    
    success_count = 0
    fail_count = 0
    
    for skill_id, skill_info in skills_data.items():
        # 获取最高等级的描述作为模板
        descriptions = skill_info.get("descriptions", [])
        if not descriptions:
            continue
            
        # 通常使用最后一个描述（最高等级）
        desc_template = descriptions[-1]["template"]
        
        try:
            effects = SkillParser.parse(desc_template)
            dump_data[skill_id] = [effect.to_dict() for effect in effects]
            success_count += 1
        except Exception as e:
            print(f"Failed to parse skill {skill_id} ({skill_info.get('name')}): {e}")
            fail_count += 1
            
    print(f"Parsed {success_count} skills, failed {fail_count} skills.")
    print(f"Saving to {output_file}...")
    
    with open(output_file, "w", encoding="utf-8") as f:
        json.dump(dump_data, f, indent=2, ensure_ascii=False)
        
    print("Done.")

if __name__ == "__main__":
    dump_skill_effects()
