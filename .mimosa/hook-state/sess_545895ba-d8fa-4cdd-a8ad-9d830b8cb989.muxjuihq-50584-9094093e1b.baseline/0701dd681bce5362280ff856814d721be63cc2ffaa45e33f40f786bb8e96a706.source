"""Tests for enemy character 152205 - 惨禍：姜小花.

Skills: 210114(EX), 220405(AS1+), 220406(AS2), 230420(PS1), 230421(PS2+)

敌方版技能与己方131302 砂浜の策謀家 (110071/120158/120159/130156/130157) 同名同机制，
差异：
- DefaultMaxLevel: 敌方=10, 己方=15
- active_level_min阈值：敌方Lv5（EX damage_link），己方Lv11
- AS2(220406) shield值大幅削弱：敌方Lv10=0.5%，己方Lv10=7.5%
- AS2(220406) heal值：敌方固定0.38%（target_killed时），己方无此机制
- AS2(220406) 威力值：敌方Lv10=31.8，己方Lv10=23.4（敌方反而更高）
- PS2(230421) 无damage_link：敌方仅max_hp_up，己方有damage_link(friends, to_caster)
"""
import unittest
import sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import BuffState, DamageLinkEntry
from src.entities_v2.enums import SkillEffectType, Position, Side

STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value
STATUS_MAX_HP = SkillEffectType.STATUS_MAX_HP.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
MARK = SkillEffectType.MARK.value
SHIELD = SkillEffectType.SHIELD.value


def _make_hot_mark(caster_unit_id):
    """预施加暑気 mark（用于AS2有暑気分支测试）。敌方版220405的暑気可解除。"""
    return BuffState(
        buff_id="hot_mark_test", name="暑気", effect_type=MARK, value=0,
        duration=-1, timing_type=2, source_unit_id=caster_unit_id,
        source_skill_id=220405, is_debuff=False, is_stackable=False,
        is_memory_buff=False, unremovable=False,
    )


# ═══════════════════════════════════════════════════════════════
# 210114 少しお行儀悪いですが…… (EX)
# ═══════════════════════════════════════════════════════════════

class TestEX210114(unittest.TestCase):
    """EX：最もHP割合が高い敵単体に現在HP×35%のENダメージ（上限ATK×75%）
    + self_has_ap: remove_ap(target,2) + remove_ap(self,1)
    + self_no_ap: atk_down(target, {atk}%, 2action, stackable)
    + Lv5+: damage_link(self_and_primary_target, {dmg}%, 1action, unremovable)"""

    def setUp(self):
        bb = BattleBuilder()
        # 敌方caster，atk=10000 → ATK cap=7500
        bb.add_enemy(unit_id="c", hp=360750, atk=10000, defense=7341, speed=512,
                     skills=[210114], level=10, ep=10, ap=0)
        # 己方目标：a_high HP最高（作为highest_hp_ratio目标）
        bb.add_ally(unit_id="a_high", position=Position.ALLY_CENTER_FRONT, hp=30000, atk=8000)
        bb.add_ally(unit_id="a_low", position=Position.ALLY_RIGHT_BACK, hp=10000, atk=6000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a_high = next(u for u in self.bf.friend_team if u.unit_id == "a_high")
        self.a_low = next(u for u in self.bf.friend_team if u.unit_id == "a_low")
        self.caster.current_ap = 0  # 默认走self_no_ap分支

    def test_hp_ratio_damage_targets_highest_hp_ratio(self):
        """EX应命中HP比例最高的己方单位（a_high=100% > a_low=100%但HP更高）。

        注意：a_high和a_low都满血时HP比例相同(100%)，highest_hp_ratio按HP绝对值选a_high。
        """
        # 设置a_low HP较低，确保a_high是最高比例
        self.a_low.current_hp = 5000  # 50%
        result = self.ss.execute_skill(caster=self.caster, skill_id=210114,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        dmg_targets = []
        for e in result["effects_applied"]:
            if e.get("effect_type") in ("damage", "hp_ratio_damage"):
                for t in e.get("targets", []):
                    dmg_targets.append(t.get("target_id"))
        self.assertEqual(len(dmg_targets), 1)
        self.assertEqual(dmg_targets[0], self.a_high.unit_id,
                         "应命中HP比例最高的a_high")

    def test_hp_ratio_damage_capped_by_atk_75pct(self):
        """EX伤害应受 ATK×75% 上限约束。

        caster.atk=10000, a_high.current_hp=30000
        基础伤害 = 30000×35% = 10500
        上限 = 10000×75% = 7500
        预期伤害 ≈ 7500
        """
        self.caster.current_ap = 0  # 走self_no_ap分支，避免AP干扰
        result = self.ss.execute_skill(caster=self.caster, skill_id=210114,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        hp_loss = self.a_high.max_hp - self.a_high.current_hp
        # 允许±20%误差（属性克制、防御等影响）
        self.assertLess(abs(hp_loss - 7500), 1500,
                        f"EX伤害应受ATK×75%上限约束，预期约7500，实际{hp_loss}")

    def test_self_has_ap_branch_removes_ap(self):
        """self_has_ap分支：自身有AP时消耗1AP削目标2AP。"""
        self.caster.current_ap = 5
        self.a_high.current_ap = 4
        caster_ap_before = self.caster.current_ap
        enemy_ap_before = self.a_high.current_ap
        result = self.ss.execute_skill(caster=self.caster, skill_id=210114,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertEqual(self.caster.current_ap, caster_ap_before - 1,
                         "self_has_ap分支应消耗caster 1 AP")
        self.assertEqual(self.a_high.current_ap, enemy_ap_before - 2,
                         "self_has_ap分支应削减目标2 AP")

    def test_self_no_ap_branch_atk_down(self):
        """self_no_ap分支：自身无AP时对目标施加atk_down 2action stackable。"""
        self.caster.current_ap = 0
        result = self.ss.execute_skill(caster=self.caster, skill_id=210114,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 验证任一己方有 atk_down debuff
        all_atk_down = []
        for a in self.bf.friend_team:
            all_atk_down.extend([d for d in a.debuffs if d.effect_type == STATUS_ATTACK])
        self.assertTrue(len(all_atk_down) > 0, "self_no_ap分支应对目标施加atk_down")
        self.assertEqual(all_atk_down[0].duration, 2, "atk_down应持续2 action")
        self.assertTrue(all_atk_down[0].is_stackable, "atk_down应可叠加")

    def test_lv5_damage_link_applied(self):
        """Lv5+: damage_link(self_and_primary_target, {dmg}%, 1action, unremovable)。

        敌方Lv5时dmg=1.5%，Lv10时dmg=2.5%。
        """
        # 设置Lv5
        self.caster.skill_levels[210114] = 5
        self.caster.current_ap = 0
        result = self.ss.execute_skill(caster=self.caster, skill_id=210114,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 验证caster有outgoing damage_link
        caster_outgoing = [dl for dl in self.caster.damage_links
                           if dl.direction == "outgoing"]
        self.assertTrue(len(caster_outgoing) > 0,
                        "Lv5+应建立damage_link (caster outgoing)")
        self.assertAlmostEqual(caster_outgoing[0].value, 1.5, places=1,
                               msg="Lv5时dmg应为1.5%")
        self.assertTrue(caster_outgoing[0].is_unremovable, "damage_link应unremovable")

    def test_lv4_no_damage_link(self):
        """Lv4: 不应建立damage_link（active_level_min=5）。"""
        self.caster.skill_levels[210114] = 4
        self.caster.current_ap = 0
        # 清除可能残留的damage_links
        self.caster.damage_links = []
        self.a_high.damage_links = []
        result = self.ss.execute_skill(caster=self.caster, skill_id=210114,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        caster_outgoing = [dl for dl in self.caster.damage_links
                           if dl.direction == "outgoing"]
        self.assertEqual(len(caster_outgoing), 0,
                         "Lv4不应建立damage_link (active_level_min=5)")


# ═══════════════════════════════════════════════════════════════
# 220405 たまには子供っぽく+ (AS1)
# ═══════════════════════════════════════════════════════════════

class TestAS1220405(unittest.TestCase):
    """AS1+: global_condition=(self_hp<50% AND self_lacks_mark 暑気)
    remove_damage_links(self) + atk_up(self, {atk}%, permanent) + mark(self, 暑気, permanent, 敌方版可解除)"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=360750, atk=7283, defense=7341, speed=512,
                     skills=[220405], level=10, ap=5)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")

    def test_blocked_by_full_hp(self):
        """HP>=50%时AS1不发动。"""
        self.caster.current_hp = self.caster.max_hp  # 100%
        result = self.ss.execute_skill(caster=self.caster, skill_id=220405,
                                        battlefield=self.bf, skip_cost=True)
        self.assertFalse(result.get("success", False),
                         "HP>=50%时AS1不应发动")
        self.assertEqual(result.get("error"), "global_condition not met")

    def test_blocked_by_hot_mark(self):
        """持有暑気mark时AS1不发动。"""
        self.caster.current_hp = int(self.caster.max_hp * 0.3)  # 30% < 50%
        self.caster.buffs.append(_make_hot_mark(self.caster.unit_id))
        result = self.ss.execute_skill(caster=self.caster, skill_id=220405,
                                        battlefield=self.bf, skip_cost=True)
        self.assertFalse(result.get("success", False),
                         "持有暑気mark时AS1不应发动")
        self.assertEqual(result.get("error"), "global_condition not met")

    def test_remove_links_atk_up_hot_mark(self):
        """正常发动：清除damage_links + atk_up + 暑気mark。"""
        self.caster.current_hp = int(self.caster.max_hp * 0.3)  # 30% < 50%
        # 预先施加damage_link
        fake_link = DamageLinkEntry(
            link_id="test_link_1", partner_unit_id="a1",
            value=50.0, source_skill_id=210114, source_unit_id=self.caster.unit_id,
            direction="incoming", is_unremovable=True, duration=-1, duration_type="",
        )
        self.caster.damage_links.append(fake_link)
        self.assertEqual(len(self.caster.damage_links), 1)

        result = self.ss.execute_skill(caster=self.caster, skill_id=220405,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        # 验证damage_links被清除
        self.assertEqual(len(self.caster.damage_links), 0,
                         "AS1应清除自身所有damage_links")

        # 验证atk_up buff
        atk_up_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertTrue(len(atk_up_buffs) > 0, "AS1应施加atk_up buff")

        # 验证暑気mark（敌方版描述无"解除不可"，应可解除）
        hot_marks = [b for b in self.caster.buffs
                     if b.effect_type == MARK and getattr(b, 'name', '') == "暑気"]
        self.assertTrue(len(hot_marks) > 0, "AS1应施加暑気mark")
        self.assertFalse(getattr(hot_marks[0], 'unremovable', False),
                         "敌方版暑気mark应可解除（描述无'解除不可'）")


# ═══════════════════════════════════════════════════════════════
# 220406 夏のせいです (AS2)
# ═══════════════════════════════════════════════════════════════

class TestAS2220406(unittest.TestCase):
    """AS2: Block1(self_lacks_mark 暑気): shield + dmg_dealt_down(enemy_front, 5%, 1action)
    Block2(self_has_mark 暑気): damage(5hit, EN, lifesteal=40%) + heal(0.38%, target_killed, max_hp)"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=360750, atk=7283, defense=7341, speed=512,
                     skills=[220406], level=10, ap=5)
        # 仅添加a1，确保a1是唯一伤害目标（避免target_service选其他目标）
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000, atk=8000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")

    def test_no_hot_shield_and_debuff(self):
        """无暑気分支：自身shield + 敌前列dmg_dealt_down 5%。"""
        # 确保无暑気mark
        self.assertEqual(len([b for b in self.caster.buffs
                              if b.effect_type == MARK]), 0)
        result = self.ss.execute_skill(caster=self.caster, skill_id=220406,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        # 验证caster有shield buff
        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertTrue(len(shield_buffs) > 0, "无暑気分支应施加shield buff")
        self.assertEqual(shield_buffs[0].duration, 1, "shield应持续1 action")

        # 验证己方前排有dmg_dealt_down debuff
        # 注意：从敌方caster角度，"enemy_front"对应己方前排
        a1_debuffs = [d for d in self.a1.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertTrue(len(a1_debuffs) > 0, "己方前排(a1)应有dmg_dealt_down debuff")
        self.assertTrue(a1_debuffs[0].is_stackable, "dmg_dealt_down应可叠加")
        self.assertEqual(a1_debuffs[0].duration, 1, "dmg_dealt_down应持续1 action")

    def test_no_hot_shield_value_weakened(self):
        """敌方shield值应大幅削弱（Lv10=0.5%，而非己方7.5%）。"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=220406,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertTrue(len(shield_buffs) > 0)
        # 敌方Lv10 shield=0.5%，max_hp=360750 → shield_amount ≈ 1803
        # 己方Lv10 shield=7.5% → 27056，差距约15倍
        shield_amount = getattr(shield_buffs[0], 'shield_amount', 0)
        expected_shield = int(self.caster.max_hp * 0.005)  # 0.5%
        self.assertGreater(shield_amount, 0, "shield_amount应>0")
        self.assertLess(abs(shield_amount - expected_shield),
                        max(50, expected_shield * 0.1),
                        f"敌方shield值应约为{expected_shield}(max_hp×0.5%)，实际{shield_amount}")

    def test_with_hot_5hit_lifesteal(self):
        """有暑気分支：5hit EN攻击 + lifesteal 40%。"""
        self.caster.current_hp = int(self.caster.max_hp * 0.5)
        self.caster.buffs.append(_make_hot_mark(self.caster.unit_id))
        caster_hp_before = self.caster.current_hp
        enemy_hp_before = self.a1.current_hp

        result = self.ss.execute_skill(caster=self.caster, skill_id=220406,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        # 验证5hit
        dmg_effects = [e for e in result.get("effects_applied", [])
                       if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "应有damage effect")
        first_dmg = dmg_effects[0]
        first_target = first_dmg["targets"][0] if first_dmg.get("targets") else {}
        hit_count = first_dmg.get("hit_count") or len(first_target.get("hits", []))
        self.assertEqual(hit_count, 5, f"应为5hit，实际: {hit_count}")

        # 验证己方受到伤害
        self.assertLess(self.a1.current_hp, enemy_hp_before, "己方应受到伤害")

        # 验证lifesteal
        actual_damage = enemy_hp_before - self.a1.current_hp
        expected_heal = int(actual_damage * 0.4)
        hp_gain = self.caster.current_hp - caster_hp_before
        self.assertGreater(hp_gain, 0, "caster应通过lifesteal回复HP")

    def test_with_hot_target_killed_heal_0_38pct(self):
        """有暑気分支击杀时：追加max_hp×0.38%回复。"""
        self.caster.current_hp = int(self.caster.max_hp * 0.3)  # HP=30%
        # 设置己方HP极低，确保5hit击杀
        self.a1.current_hp = 100
        self.caster.buffs.append(_make_hot_mark(self.caster.unit_id))
        caster_hp_before = self.caster.current_hp

        result = self.ss.execute_skill(caster=self.caster, skill_id=220406,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        # 验证己方被击杀
        self.assertFalse(self.a1.is_alive, "己方应被击杀")

        # 验证caster回复（lifesteal + 击杀追加heal）
        # 击杀追加heal = max_hp × 0.38% = 360750 × 0.0038 ≈ 1370
        hp_gain = self.caster.current_hp - caster_hp_before
        expected_kill_heal = int(self.caster.max_hp * 0.0038)
        self.assertGreater(hp_gain, expected_kill_heal - 200,
                           f"击杀时应追加max_hp 0.38%回复(≥{expected_kill_heal})，实际总回复{hp_gain}")

    def test_with_hot_no_shield_applied(self):
        """有暑気分支不应施加shield（应执行Block2伤害分支）。"""
        self.caster.buffs.append(_make_hot_mark(self.caster.unit_id))
        result = self.ss.execute_skill(caster=self.caster, skill_id=220406,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_buffs), 0,
                         "有暑気时不应施加shield（应执行Block2伤害分支）")


# ═══════════════════════════════════════════════════════════════
# 230420 油断は禁物ですよ (PS1)
# ═══════════════════════════════════════════════════════════════

class TestPS1230420(unittest.TestCase):
    """PS1: before_as_attacked触发
    def_up(self, {def}%, attack_limited=1, hp_ratio_dynamic_direct=true)"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=360750, atk=7283, defense=7341, speed=512,
                     skills=[230420], level=10, pp=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000, atk=10000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")

    def test_triggers_before_as_attacked(self):
        """PS1应在被AS攻击前触发。"""
        self.caster.skill_cooldowns = {}
        trigger_actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            attacker=self.a1, skill_id=120048
        )
        ps1_actions = [a for a in trigger_actions if a.skill_id == 230420]
        self.assertTrue(len(ps1_actions) > 0, "PS1应在被AS攻击前被收集")

        # 执行PS1
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 验证def_up buff
        def_up_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertTrue(len(def_up_buffs) > 0, "PS1应施加def_up buff")
        # hp_ratio_dynamic_direct: value在施加时按HP比例冻结（满血时=原值17.0）
        self.assertGreater(def_up_buffs[0].value, 0,
                           "def_up value应已按HP比例冻结（满血时应>0）")
        self.assertEqual(def_up_buffs[0].attack_limited, 1,
                         "def_up应attack_limited=1")

    def test_def_up_high_hp_more_effective(self):
        """HP越高def_up效果越强（hp_ratio_dynamic_direct线性）。"""
        from src.combat_v2.services.damage_service import DamageService as _DS
        dms = _DS()

        # 高HP（100%）
        self.caster.current_hp = self.caster.max_hp
        self.caster.skill_cooldowns = {}
        self.caster.buffs = []
        actions_high = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            attacker=self.a1, skill_id=120048
        )
        ps1_high = [a for a in actions_high if a.skill_id == 230420]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_high, self.bf, trigger_timing="before_as_attacked"
        )
        effective_def_high = dms._calculate_final_stat(self.caster, "defense")

        # 低HP（30%）
        self.caster.current_hp = int(self.caster.max_hp * 0.3)
        self.caster.skill_cooldowns = {}
        self.caster.buffs = []
        actions_low = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            attacker=self.a1, skill_id=120048
        )
        ps1_low = [a for a in actions_low if a.skill_id == 230420]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_low, self.bf, trigger_timing="before_as_attacked"
        )
        effective_def_low = dms._calculate_final_stat(self.caster, "defense")

        self.assertGreater(effective_def_high, effective_def_low,
                           f"HP 100%时有效防御力({effective_def_high})应大于HP 30%时({effective_def_low})")

    def test_def_up_frozen_within_same_action(self):
        """PS1(230420) def_up值在施加时冻结，同一行动中HP变化不影响DEF。

        回归场景：多段伤害攻击中，第一段扣HP后第二段计算DEF时
        hp_ratio_dynamic_direct不应重新计算，DEF应保持一致。
        """
        from src.combat_v2.services.damage_service import DamageService as _DS
        dms = _DS()

        # 满血触发PS1
        self.caster.current_hp = self.caster.max_hp
        self.caster.skill_cooldowns = {}
        self.caster.buffs = []
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            attacker=self.a1, skill_id=120048
        )
        ps1 = [a for a in actions if a.skill_id == 230420]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1, self.bf, trigger_timing="before_as_attacked"
        )

        # 第一段伤害前的DEF（满血）
        def_before = dms._calculate_final_stat(self.caster, "defense")

        # 模拟第一段伤害扣HP（降到30%）
        self.caster.current_hp = int(self.caster.max_hp * 0.3)

        # 第二段伤害时的DEF应与第一段相同（value已冻结）
        def_after = dms._calculate_final_stat(self.caster, "defense")

        self.assertEqual(def_before, def_after,
                         f"同一行动中HP变化后DEF应不变（value已冻结）："
                         f"第一段={def_before}, 第二段={def_after}")


# ═══════════════════════════════════════════════════════════════
# 230421 わたくしがしっかりしないと+ (PS2)
# ═══════════════════════════════════════════════════════════════

class TestPS2230421(unittest.TestCase):
    """PS2+: on_turn_start, cooldown=99（每战一次）
    max_hp_up(self, {hp}%, permanent, unremovable) — 敌方版无damage_link"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=360750, atk=7283, defense=7341, speed=512,
                     skills=[230421], level=10, pp=10)
        bb.add_enemy(unit_id="c2", hp=200000)  # 友方敌军（用于验证无damage_link）
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.c2 = next(u for u in self.bf.enemy_team if u.unit_id == "c2")

    def test_turn_start_max_hp_up(self):
        """PS2应在回合开始时触发，提升自身最大HP。"""
        self.caster.skill_cooldowns = {}
        original_max_hp = self.caster.max_hp

        trigger_actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in trigger_actions if a.skill_id == 230421]
        self.assertTrue(len(ps2_actions) > 0, "PS2应在回合开始时被收集")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="turn_start"
        )

        # 验证max_hp增加80%（Lv10 hp=80%）
        expected_max_hp = int(original_max_hp * 1.8)
        self.assertAlmostEqual(self.caster.max_hp, expected_max_hp, delta=1,
                               msg=f"max_hp应增加80%（{original_max_hp}→{expected_max_hp}）")

    def test_turn_start_max_hp_up_syncs_current_hp(self):
        """PS2 max_hp_up应同步提升current_hp，保持HP比例不被稀释。

        场景：PS2(230421)触发后max_hp提升80%，current_hp应同步增加80%增量。
        这对PS1(230420)的hp_ratio_dynamic_direct机制至关重要——
        若current_hp未同步，hp_ratio会从1.0降到0.5556，导致PS1加防幅度被稀释。
        """
        self.caster.skill_cooldowns = {}
        # 起始满血
        self.caster.current_hp = self.caster.max_hp
        original_max_hp = self.caster.max_hp
        original_current_hp = self.caster.current_hp

        trigger_actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in trigger_actions if a.skill_id == 230421]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="turn_start"
        )

        # max_hp增加80%
        hp_increase = int(original_max_hp * 0.8)
        expected_max_hp = original_max_hp + hp_increase
        self.assertAlmostEqual(self.caster.max_hp, expected_max_hp, delta=1,
                               msg=f"max_hp应增加80%（{original_max_hp}→{expected_max_hp}）")

        # current_hp应同步增加hp_increase（满血→满血）
        expected_current_hp = min(original_current_hp + hp_increase, self.caster.max_hp)
        self.assertAlmostEqual(self.caster.current_hp, expected_current_hp, delta=1,
                               msg=f"current_hp应同步提升（{original_current_hp}→{expected_current_hp}）")

        # HP比例应保持1.0（满血）
        hp_ratio = self.caster.current_hp / self.caster.max_hp
        self.assertAlmostEqual(hp_ratio, 1.0, places=3,
                               msg=f"max_hp_up后HP比例应保持1.0（实际{hp_ratio:.4f}）")

    def test_no_damage_link_enemy_version(self):
        """敌方版PS2不应施加damage_link（己方版130157有damage_link to_caster）。"""
        self.caster.skill_cooldowns = {}
        self.caster.damage_links = []
        self.c2.damage_links = []

        trigger_actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in trigger_actions if a.skill_id == 230421]
        self.assertTrue(len(ps2_actions) > 0)
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="turn_start"
        )

        # 验证c2（友军）没有outgoing damage_link指向caster
        c2_outgoing = [dl for dl in self.c2.damage_links
                       if dl.direction == "outgoing"]
        self.assertEqual(len(c2_outgoing), 0,
                         "敌方版PS2不应为友军建立damage_link（无damage_link效果）")

        # 验证caster没有incoming damage_link（除了自身outgoing配对）
        caster_incoming = [dl for dl in self.caster.damage_links
                           if dl.direction == "incoming"]
        self.assertEqual(len(caster_incoming), 0,
                         "敌方版PS2不应有incoming damage_link（无damage_link效果）")

    def test_once_per_battle_cooldown_99(self):
        """PS2战斗中只发动1次（cooldown=99）。"""
        self.caster.skill_cooldowns = {}

        # 第一次触发
        actions1 = self.ts.trigger_turn_start(self.bf)
        ps2_actions1 = [a for a in actions1 if a.skill_id == 230421]
        self.assertTrue(len(ps2_actions1) > 0, "第一次应被收集")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions1, self.bf, trigger_timing="turn_start"
        )

        # 第二次触发（冷却中）
        actions2 = self.ts.trigger_turn_start(self.bf)
        ps2_actions2 = [a for a in actions2 if a.skill_id == 230421]
        self.assertEqual(len(ps2_actions2), 0,
                         "冷却中时PS2不应再次被收集（once per battle）")

        # 验证PS2进入冷却
        self.assertIn(230421, self.caster.skill_cooldowns,
                      "PS2执行后应进入冷却")
        self.assertGreaterEqual(self.caster.skill_cooldowns[230421], 99,
                                "PS2冷却应≥99")


# ═══════════════════════════════════════════════════════════════
# 联动测试：PS2 max_hp_up → PS1 按满血计算加防
# ═══════════════════════════════════════════════════════════════

class TestChainPS2PS1(unittest.TestCase):
    """PS2(230421) max_hp_up同步current_hp → PS1(230420) hp_ratio_dynamic_direct按满血计算

    回归场景：PS2触发前current_hp=max_hp=360750（满血，hp_ratio=1.0）。
    PS2触发后max_hp=649350（+80%），若current_hp未同步则hp_ratio=0.5556，
    导致PS1的def_up从17.0%被稀释为9.44%（7341→8034而非7341→8589）。
    修复后current_hp应同步提升到649350，hp_ratio保持1.0，PS1按17.0%满血加防。
    """

    def setUp(self):
        bb = BattleBuilder()
        # 敌方caster同时持有PS1和PS2
        bb.add_enemy(unit_id="c", hp=360750, atk=7283, defense=7341, speed=512,
                     skills=[230420, 230421], level=10, pp=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000, atk=10000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")

    def test_ps2_then_ps1_full_hp_def_up(self):
        """PS2 max_hp_up后PS1应按满血(17.0%)加防，而非被稀释为9.44%。"""
        from src.combat_v2.services.damage_service import DamageService as _DS
        dms = _DS()

        # 起始满血
        self.caster.current_hp = self.caster.max_hp
        self.caster.skill_cooldowns = {}
        original_max_hp = self.caster.max_hp
        base_def = self.caster.defense  # 7341

        # Step 1: 触发PS2（on_turn_start）
        ps2_actions = self.ts.trigger_turn_start(self.bf)
        ps2_only = [a for a in ps2_actions if a.skill_id == 230421]
        self.assertTrue(len(ps2_only) > 0, "PS2应在回合开始时被收集")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_only, self.bf, trigger_timing="turn_start"
        )

        # 验证PS2后max_hp和current_hp都提升，hp_ratio=1.0
        hp_increase = int(original_max_hp * 0.8)
        expected_max_hp = original_max_hp + hp_increase
        self.assertAlmostEqual(self.caster.max_hp, expected_max_hp, delta=1,
                               msg="PS2后max_hp应+80%")
        self.assertAlmostEqual(self.caster.current_hp, expected_max_hp, delta=1,
                               msg="PS2后current_hp应同步到新max_hp（满血）")
        hp_ratio_after_ps2 = self.caster.current_hp / self.caster.max_hp
        self.assertAlmostEqual(hp_ratio_after_ps2, 1.0, places=3,
                               msg=f"PS2后HP比例应为1.0（实际{hp_ratio_after_ps2:.4f}）")

        # Step 2: 触发PS1（before_as_attacked）
        self.caster.buffs = []  # 清空buffs以便干净验证PS1的def_up
        ps1_actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf,
            attacker=self.a1, skill_id=120048
        )
        ps1_only = [a for a in ps1_actions if a.skill_id == 230420]
        self.assertTrue(len(ps1_only) > 0, "PS1应在被AS攻击前被收集")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_only, self.bf, trigger_timing="before_as_attacked"
        )

        # 验证PS1 def_up buff存在，且value已在施加时按HP比例冻结
        def_up_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertTrue(len(def_up_buffs) > 0, "PS1应施加def_up buff")
        # hp_ratio=1.0（满血），冻结值=17.0*1.0=17.0
        self.assertAlmostEqual(def_up_buffs[0].value, 17.0, delta=0.1,
                               msg="def_up value应在满血时冻结为17.0（17%×hp_ratio=1.0）")

        # 验证有效防御力按满血17.0%计算（而非被稀释为9.44%）
        effective_def = dms._calculate_final_stat(self.caster, "defense")
        # 预期：base_def * (1 + 0.17) = 7341 * 1.17 = 8588.97
        expected_def_full_hp = base_def * 1.17
        # 被稀释的值：base_def * (1 + 0.17 * 0.5556) = 7341 * 1.0944 = 8033.0
        diluted_def = base_def * (1 + 0.17 * 0.5556)

        self.assertGreater(effective_def, diluted_def + 100,
                           f"有效防御力{effective_def}应高于被稀释值{diluted_def:.1f}（差值应>100）")
        self.assertAlmostEqual(effective_def, expected_def_full_hp, delta=5,
                               msg=f"PS2+PS1后有效防御力应按满血17.0%计算（预期~{expected_def_full_hp:.1f}，"
                                   f"被稀释值~{diluted_def:.1f}，实际{effective_def}）")


# ═══════════════════════════════════════════════════════════════
# 联动测试：AS1→AS2 暑気mark全链
# ═══════════════════════════════════════════════════════════════

class TestChainAS1AS2(unittest.TestCase):
    """AS1付与暑気 → AS2进入有暑気分支（5hit伤害）"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=360750, atk=7283, defense=7341, speed=512,
                     skills=[220405, 220406], level=10, ap=5)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000, atk=8000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.a1 = next(u for u in self.bf.friend_team if u.unit_id == "a1")

    def test_as1_then_as2_hot_mark_chain(self):
        """AS1付与暑気 → AS2进入有暑気分支。"""
        # Step 1: AS1发动（HP<50% + 无暑気）→ 付与暑気mark
        self.caster.current_hp = int(self.caster.max_hp * 0.3)
        result1 = self.ss.execute_skill(caster=self.caster, skill_id=220405,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result1["success"], "AS1应成功发动")

        # 验证暑気mark已付与
        hot_marks = [b for b in self.caster.buffs
                     if b.effect_type == MARK and getattr(b, 'name', '') == "暑気"]
        self.assertTrue(len(hot_marks) > 0, "AS1应付与暑気mark")

        # Step 2: AS2发动（有暑気→Block2: 5hit EN攻击）
        enemy_hp_before = self.a1.current_hp
        caster_hp_before = self.caster.current_hp

        result2 = self.ss.execute_skill(caster=self.caster, skill_id=220406,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result2["success"], "AS2应成功发动")

        # 验证AS2执行了Block2（damage效果），而非Block1（shield）
        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_buffs), 0,
                         "有暑気时AS2不应施加shield")

        # 验证己方受到伤害
        self.assertLess(self.a1.current_hp, enemy_hp_before,
                        "AS2有暑気分支应对己方造成伤害")

        # 验证5hit
        dmg_effects = [e for e in result2.get("effects_applied", [])
                       if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0)
        first_dmg = dmg_effects[0]
        first_target = first_dmg["targets"][0] if first_dmg.get("targets") else {}
        hit_count = first_dmg.get("hit_count") or len(first_target.get("hits", []))
        self.assertEqual(hit_count, 5, f"应为5hit，实际: {hit_count}")

        # 验证lifesteal
        self.assertGreater(self.caster.current_hp, caster_hp_before,
                           "AS2有暑気分支应通过lifesteal回复HP")


if __name__ == "__main__":
    unittest.main(verbosity=2)
