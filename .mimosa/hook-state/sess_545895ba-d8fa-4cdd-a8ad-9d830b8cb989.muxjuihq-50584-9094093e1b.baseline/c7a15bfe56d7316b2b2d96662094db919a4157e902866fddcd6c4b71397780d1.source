#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
提取「惨禍」敌方数据脚本
从 split_data 中提取战术演习模式相关数据并转储到 data/tactical_exercise_enemies.json
"""

import json
import sys
from pathlib import Path

# 确保项目根目录在 sys.path 中
PROJECT_ROOT = Path(__file__).parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

SPLIT_DATA_DIR = PROJECT_ROOT / "split_data"
DATA_DIR = PROJECT_ROOT / "data"


def extract_tactical_exercise_enemies():
    """提取所有名称含「惨禍」的敌方数据"""
    
    # 1. 加载 EnemyMaster.json
    enemy_master_path = SPLIT_DATA_DIR / "EnemyMaster.json"
    with open(enemy_master_path, "r", encoding="utf-8") as f:
        enemy_master = json.load(f)
    
    print(f"[INFO] EnemyMaster.json 中总条目数: {len(enemy_master)}")
    
    # 2. 筛选名称含「惨禍」的敌方
    sanka_enemies = {}
    for item in enemy_master:
        name = item.get("Name", "")
        if "惨禍" in name:
            enemy_id = item["Id"]
            # 提取角色名（去掉「惨禍：」前缀）
            character_name = name.replace("惨禍：", "")
            
            sanka_enemies[enemy_id] = {
                "enemy_id": enemy_id,
                "name": name,
                "character_name": character_name,
                "asset_id": item.get("AssetId", ""),
                "hp": item["Hp"],
                "attack": item["Attack"],
                "defense": item["Defense"],
                "speed": item["Speed"],
                "hp_grade": item["HpGrade"],
                "attack_grade": item["AttackGrade"],
                "defense_grade": item["DefenseGrade"],
                "speed_grade": item["SpeedGrade"],
                "critical_rate": item["CriticalRate"],
                "critical_rate_grade": item["CriticalRateGrade"],
                "attribute": item["Attribute"],
                "type": item["Type"],
                "role_type": item["RoleType"],
                "rarity": item["Rarity"],
                "action_point": item.get("ActionPoint", 2),
                "passive_point": item.get("PassivePoint", 2),
                "enemy_flags": item.get("EnemyFlags", 0),
                "character_team_master_id": item.get("CharacterTeamMasterId"),
                "skill_ids": [],
                "position": 0,  # 站位（1-6），稍后填充
                "party_id": None,  # 所属 EnemyParty 的 ID
            }
    
    print(f"[INFO] 找到 {len(sanka_enemies)} 个「惨禍」敌方单位")
    print(f"[INFO] 敌方 ID 列表: {list(sanka_enemies.keys())}")
    
    # 3. 加载 EnemySkillMaster.json 关联技能
    enemy_skill_path = SPLIT_DATA_DIR / "EnemySkillMaster.json"
    with open(enemy_skill_path, "r", encoding="utf-8") as f:
        enemy_skill_master = json.load(f)
    
    for item in enemy_skill_master:
        enemy_id = item["EnemyMasterId"]
        if enemy_id in sanka_enemies:
            sanka_enemies[enemy_id]["skill_ids"].append(item["SkillMasterId"])
    
    for eid, data in sanka_enemies.items():
        print(f"[INFO] [{eid}] {data['name']}: 技能数={len(data['skill_ids'])}, 技能={data['skill_ids']}")
    
    # 4. 加载 EnemyPartyMaster.json 查找站位
    enemy_party_path = SPLIT_DATA_DIR / "EnemyPartyMaster.json"
    with open(enemy_party_path, "r", encoding="utf-8") as f:
        enemy_party_master = json.load(f)
    
    # 构建 enemy_id -> (position, party_id) 的映射
    # 位置 1-6 对应 Enemy1MasterId ~ Enemy6MasterId
    enemy_position_map = {}
    for party in enemy_party_master:
        party_id = party["Id"]
        for pos_idx in range(1, 7):
            master_id = party.get(f"Enemy{pos_idx}MasterId")
            if master_id is not None and master_id in sanka_enemies:
                enemy_position_map[master_id] = (pos_idx, party_id)
    
    for eid, data in sanka_enemies.items():
        if eid in enemy_position_map:
            pos, party_id = enemy_position_map[eid]
            data["position"] = pos
            data["party_id"] = party_id
            pos_name = ["", "左前", "中前", "右前", "左后", "中后", "右后"][pos]
            print(f"[INFO] [{eid}] {data['name']}: 站位={pos}({pos_name}), PartyID={party_id}")
        else:
            print(f"[INFO] [{eid}] {data['name']}: 未在 EnemyPartyMaster 中找到站位信息")
    
    # 5. 保存转储数据
    output_path = DATA_DIR / "tactical_exercise_enemies.json"
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(sanka_enemies, f, ensure_ascii=False, indent=2)
    
    print(f"\n[OK] 数据已保存至: {output_path}")
    print(f"[OK] 共转储 {len(sanka_enemies)} 个「惨禍」敌方单位")
    
    # 6. 按名字去重（同名角色保留第一个），输出可选敌方列表
    seen_names = set()
    unique_enemies = []
    for eid, data in sorted(sanka_enemies.items(), key=lambda x: x[1]["character_name"]):
        if data["character_name"] not in seen_names:
            seen_names.add(data["character_name"])
            unique_enemies.append(data)
    
    print(f"\n[INFO] 去重后可选用敌方角色: {len(unique_enemies)} 个")
    for data in unique_enemies:
        pos_name = ["", "左前", "中前", "右前", "左后", "中后", "右后"][data["position"]] if data["position"] else "未知"
        print(f"  [{data['enemy_id']}] {data['character_name']} (站位: {pos_name})")
    
    return sanka_enemies


if __name__ == "__main__":
    extract_tactical_exercise_enemies()