    """400248 HP上昇【ラミ】: 朽葉ラミ(CharacterBaseMasterId=103)HP+1500"""

    def test_rami_hp_up(self):
        rami = _make_ally(103303, "朽葉ラミ", Position.ALLY_RIGHT_FRONT)
        other = _make_ally(100101, "其他", Position.ALLY_CENTER_FRONT)
        enemy = _make_enemy()
        bf = BattlefieldState()
        bf.friend_team = [rami, other]
        bf.enemy_team = [enemy]
        bf.memory_cards = [_make_card(20090)]

        hp_before = dms._calculate_final_stat(rami, "max_hp")
        hp_before_other = dms._calculate_final_stat(other, "max_hp")

        controller, _ = _make_controller(bf)
        controller._apply_memory_card_effects()

        self.assertEqual(
            dms._calculate_final_stat(rami, "max_hp"),
