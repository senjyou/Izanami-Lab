class TestMemory20090Skill400249(unittest.TestCase):
    """400249 速度減少【敵後衛】: 敵後衛速度-7"""

    def test_enemy_back_row_speed_down(self):
        back_enemy = _make_enemy(speed=200, position=Position.ENEMY_CENTER_BACK)
        front_enemy = _make_enemy(speed=200, position=Position.ENEMY_CENTER_FRONT)
        ally = _make_ally(100101, "友方", Position.ALLY_CENTER_FRONT)
        bf = BattlefieldState()
        bf.friend_team = [ally]
        bf.enemy_team = [back_enemy, front_enemy]
        bf.memory_cards = [_make_card(20090)]

        spd_back_before = dms._calculate_final_stat(back_enemy, "speed")
        spd_front_before = dms._calculate_final_stat(front_enemy, "speed")

        controller, _ = _make_controller(bf)
        controller._apply_memory_card_effects()

        self.assertEqual(
            dms._calculate_final_stat(back_enemy, "speed"),
            spd_back_before - 7, "敵後衛应速度-7")
        self.assertEqual(
            dms._calculate_final_stat(front_enemy, "speed"),
            spd_front_before, "敵前衛不应被buff")

        spd_debuffs = _speed_debuffs(back_enemy)
        self.assertEqual(len(spd_debuffs), 1)
        self.assertEqual(spd_debuffs[0].value, 7)


class TestMemoryNewStructuredEntries(unittest.TestCase):
    """新增结构化条目可通过DataLoader加载且字段完整"""

    def test_new_memory_effects_loaded(self):
        for skill_id in (400233, 400234, 400235, 400236, 400248, 400249):
            effect = dl.get_memory_effect(skill_id)
            self.assertIsNotNone(effect, f"skill {skill_id} 应有结构化效果数据")
            self.assertEqual(effect.get("skill_id"), skill_id)
            self.assertEqual(effect["trigger"]["type"], "battle_start")
            self.assertTrue(effect.get("blocks"), f"skill {skill_id} blocks 非空")

    def test_400236_uses_ally_single_lowest_spd(self):
        effect = dl.get_memory_effect(400236)
        self.assertEqual(effect["blocks"][0]["target_type"], "ally_single_lowest_spd")

    def test_400234_has_two_blocks(self):
        effect = dl.get_memory_effect(400234)
        self.assertEqual(len(effect["blocks"]), 2)
        block_targets = [b["target_type"] for b in effect["blocks"]]
        self.assertEqual(block_targets, ["ally_position", "ally_position"])
        positions = [b.get("party_position") for b in effect["blocks"]]
        self.assertEqual(positions, [16, 2], "400234: 中央列後衛(16)减速 + 中央列前衛(2)加速")


if __name__ == "__main__":
    unittest.main()