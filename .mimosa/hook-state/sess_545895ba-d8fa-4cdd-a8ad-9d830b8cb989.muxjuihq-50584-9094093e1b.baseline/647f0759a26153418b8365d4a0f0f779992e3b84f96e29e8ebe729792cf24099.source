#!/usr/bin/env python
# -*- coding: utf-8 -*-

import unittest
from unittest.mock import MagicMock, patch
import sys
from pathlib import Path

# 添加项目根目录到路径
sys.path.insert(0, str(Path(__file__).parent.parent))

from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.enums import Side, Position, Attribute, SkillEffectType
from src.combat_v2.services.damage_service import DamageService, DamageResult

class TestDamageService(unittest.TestCase):
    
    def setUp(self):
        self.service = DamageService()
        
        # Attacker
        self.attacker = MagicMock(spec=UnitState)
        self.attacker.unit_id = "atk_1"
        self.attacker.name = "Attacker"
        self.attacker.attack = 1000
        self.attacker.max_hp = 10000
        self.attacker.current_hp = 10000
        self.attacker.element = Attribute.FIRE.value
        self.attacker.crit_rate = 0.0 # No crit default
        self.attacker.crit_damage = 0.0
        self.attacker.advantage_damage = 0.0
        self.attacker.buffs = []
        self.attacker.debuffs = []
        
        # Defender
        self.defender = MagicMock(spec=UnitState)
        self.defender.unit_id = "def_1"
        self.defender.name = "Defender"
        self.defender.defense = 500
        self.defender.max_hp = 10000
        self.defender.current_hp = 10000
        self.defender.element = Attribute.FIRE.value # Neutral
        self.defender.buffs = []
        self.defender.debuffs = []

    def test_basic_damage(self):
        """测试基础伤害: 攻防差 * 技能倍率"""
        # Diff = 1000 - 500 = 500
        # Skill = 100% -> 1.0
        # Result = 500
        skill_data = MagicMock()
        skill_data.power = 100
        skill_data.hit_count = 1
        skill_data.element = None
        skill_data.ignore_defense = 0
        skill_data.bonus_crit_rate = 0.0
        skill_data.cannot_crit = False
        skill_data.hp_scaling_bonus = 0.0
        
        result = self.service.calculate_damage(self.attacker, self.defender, skill_data)
        
        self.assertEqual(result.total_damage, 500)
        self.assertEqual(len(result.hit_details), 1)

    def test_attribute_advantage(self):
        """测试属性克制: Fire vs Wind -> 1.25x"""
        self.defender.element = Attribute.WIND.value
        
        skill_data = MagicMock()
        skill_data.power = 100
        skill_data.hit_count = 1
        skill_data.element = None # Explicitly set to None
        skill_data.ignore_defense = 0
        skill_data.bonus_crit_rate = 0.0
        skill_data.cannot_crit = False
        skill_data.hp_scaling_bonus = 0.0
        
        # Diff = 500
        # Factor = 1.25
        # Exp = 500 * 1.25 = 625
        result = self.service.calculate_damage(self.attacker, self.defender, skill_data)
        
        self.assertEqual(result.total_damage, 625)
        self.assertAlmostEqual(result.attribute_factor, 1.25)

    def test_skill_power_and_hit_count(self):
        """测试技能威力和多Hit"""
        # Power = 50% -> 0.5
        # Hits = 3
        # Diff = 500
        # Per Hit = 500 * 0.5 = 250
        # Total = 750
        skill_data = MagicMock()
        skill_data.power = 50
        skill_data.hit_count = 3
        skill_data.ignore_defense = 0
        skill_data.bonus_crit_rate = 0.0
        skill_data.cannot_crit = False
        skill_data.hp_scaling_bonus = 0.0
        
        result = self.service.calculate_damage(self.attacker, self.defender, skill_data)
        
        self.assertEqual(result.total_damage, 750)
        self.assertEqual(len(result.hit_details), 3)
        self.assertEqual(result.hit_details[0], 250)

    @patch('random.random')
    def test_critical_hit(self, mock_random):
        """测试暴击: 1.5x"""
        # Force Crit: random() < rate
        self.attacker.crit_rate = 1.0
        mock_random.return_value = 0.0 # Always crit
        
        skill_data = MagicMock()
        skill_data.power = 100
        skill_data.hit_count = 1
        skill_data.ignore_defense = 0
        skill_data.bonus_crit_rate = 0.0
        skill_data.cannot_crit = False
        skill_data.hp_scaling_bonus = 0.0
        
        # Diff = 500
        # Crit = 1.5
        # Exp = 750
        result = self.service.calculate_damage(self.attacker, self.defender, skill_data)
        
        self.assertEqual(result.total_damage, 750)
        self.assertTrue(result.is_critical)

    def test_buff_calculation(self):
        """测试 Buff 计算: 攻击力Up, 减伤Shield"""
        # Attacker: Atk + 20%
        # Defender: DamageRecv - 10% (Guard)
        
        atk_buff = BuffState(buff_id="1", name="AtkUp", effect_type=SkillEffectType.STATUS_ATTACK.value, value=20, duration=2, timing_type=1)
        self.attacker.buffs.append(atk_buff)
        
        def_buff = BuffState(buff_id="2", name="Guard", effect_type=SkillEffectType.GUARD.value, value=10, duration=2, timing_type=1)
        self.defender.buffs.append(def_buff)
        
        # Calc Atk: 1000 * 1.2 = 1200
        # Def: 500
        # Diff: 700
        
        # Damage Recv Mult: 1.0 - 0.1 = 0.9
        
        # Skill = 1.0
        # Total = 700 * 1.0 * 1.0 * 1.0 * 1.0 * 0.9 = 630
        
        skill_data = MagicMock()
        skill_data.power = 100
        skill_data.hit_count = 1
        skill_data.ignore_defense = 0
        skill_data.bonus_crit_rate = 0.0
        skill_data.cannot_crit = False
        skill_data.hp_scaling_bonus = 0.0
        
        result = self.service.calculate_damage(self.attacker, self.defender, skill_data)
        
        self.assertEqual(result.total_damage, 630)

    def test_fixed_value_buff(self):
        """测试固定值 Buff Calculation"""
        # Attacker Base: 1000
        # Add Fixed Buff: +200 (value_tag=1)
        # Add Percent Buff: +10% (value_tag=0)
        # Final Atk = 1000 * 1.1 + 200 = 1100 + 200 = 1300
        # Def: 500
        # Diff: 800
        
        fixed_buff = BuffState(
            buff_id="fix", name="AtkFix", effect_type=SkillEffectType.STATUS_ATTACK.value, 
            value=200, duration=2, timing_type=1, value_tag=1
        )
        pct_buff = BuffState(
            buff_id="pct", name="AtkPct", effect_type=SkillEffectType.STATUS_ATTACK.value, 
            value=10, duration=2, timing_type=1, value_tag=0
        )
        self.attacker.buffs = [fixed_buff, pct_buff]
        
        skill_data = MagicMock()
        skill_data.power = 100
        skill_data.hit_count = 1
        skill_data.element = None
        skill_data.ignore_defense = 0
        skill_data.bonus_crit_rate = 0.0
        skill_data.cannot_crit = False
        skill_data.hp_scaling_bonus = 0.0
        
        result = self.service.calculate_damage(self.attacker, self.defender, skill_data)
        
        self.assertEqual(result.total_damage, 800)

if __name__ == '__main__':
    unittest.main()
