"""
角色118302 旋律を紡ぐ静謐のディーヴァ 专项测试
- EX:  110052 紡ぎ出すメロディー（敌单体伤害 + 1行动眩晕）
- AS1: 120115 フォルテピアノ（敌单体伤害 + 敌dmg_dealt_down 1attack + 自dmg_dealt_down 1attack; Lv15移除自debuff）
- AS2: 120116 リフレイン（敌单体伤害 + 自markリズミカル; 若已有mark→追加伤害 + Lv11+ dmg_dealt_down）
- PS1: 130123 コン・フオーコ（敌状态异常→敌横列伤害+眩晕, Lv11+先自atk_up; 眩晕升级; 排除特定时机）
- PS2: 130124 テンポプリモ（回合开始→前排友方crit_rate_up + 前排敌方crit_dmg_down; Lv11+追加后排）

角色信息:
- 角色: 旋律を紡ぐ静謐のディーヴァ
- 属性: 3 (风), 类型: 3 (敏捷), 站位: 灵活, 定位: 控制
- 技能: 110052, 120115, 120116, 130123, 130124
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
KNOCKOUT = SkillEffectType.KNOCKOUT.value
CRIT_RATE = SkillEffectType.STATUS_CRITICAL_CHANCE.value
CRIT_DAMAGE = SkillEffectType.CRITICAL_BONUS_MODIFICATION.value
MARK = SkillEffectType.MARK.value


class TestActor118302(unittest.TestCase):
    """角色118302 旋律を紡ぐ静謐のディーヴァ 专项测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 118302 旋律を紡ぐ静謐のディーヴァ (风属性, 敏捷, 灵活)
        self.caster = UnitState(
            unit_id="caster", name="旋律を紡ぐ静謐のディーヴァ", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=118302, level=10,
            element=3, character_type=3,
            max_hp=12000, current_hp=12000,
            attack=8000, defense=4000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110052, 120115, 120116, 130123, 130124],
            skill_levels={110052: 10, 120115: 10, 120116: 10, 130123: 10, 130124: 10},
            skill_cooldowns={},
        )

        # 友方前排
        self.ally_front = UnitState(
            unit_id="ally_front", name="友方前排", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999101, level=10,
            element=2, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=4500, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方后排
        self.ally_back = UnitState(
            unit_id="ally_back", name="友方后排", side=Side.ALLY,
            position=Position.ALLY_LEFT_BACK, character_id=999102, level=10,
            element=5, character_type=2,
            max_hp=12000, current_hp=12000,
            attack=6000, defense=3500, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央 (主目标)
        self.enemy_front = UnitState(
            unit_id="enemy_front", name="敌方前排", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排右侧 (用于横列测试)
        self.enemy_front_right = UnitState(
            unit_id="enemy_front_right", name="敌方前排右", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999003, level=10,
            element=4, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方后排右侧
        self.enemy_back_right = UnitState(
            unit_id="enemy_back_right", name="敌方后排右", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_BACK, character_id=999004, level=10,
            element=5, character_type=2,
            max_hp=50000, current_hp=50000,
            attack=5000, defense=3000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=1,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前 (用于横列测试)
        self.enemy_left_front = UnitState(
            unit_id="enemy_left_front", name="敌方左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999005, level=10,
            element=3, character_type=1,
            max_hp=10000, current_hp=10000,
            attack=6500, defense=4000, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [
            self.caster, self.ally_front, self.ally_back
        ]
        self.bf.enemy_team = [
            self.enemy_front, self.enemy_front_right,
            self.enemy_back_right, self.enemy_left_front
        ]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            trigger_service=self.ts,
            status_service=self.sts,
        )
        self.ts.set_skill_service(self.ss)

    # ─── EX: 110052 紡ぎ出すメロディー ───

    def test_ex_damage_and_knockout(self):
        """EX(110052) 敌单体伤害 + 1行动眩晕"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110052, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 验证伤害
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "EX应造成伤害")
        self.assertGreater(result["total_damage"], 0, "EX应有非零伤害")
        # 验证眩晕
        stun_debuffs = [d for d in self.enemy_front.debuffs if d.effect_type == KNOCKOUT]
        self.assertTrue(len(stun_debuffs) > 0, "EX应施加气绝")
        self.assertEqual(stun_debuffs[0].duration, 1, "Lv1-10气绝应持续1行动")

    # ─── AS1: 120115 フォルテピアノ ───

    def test_as1_damage_and_enemy_debuff(self):
        """AS1(120115) 敌单体伤害 + 敌dmg_dealt_down(1attack)"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120115, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 伤害
        self.assertGreater(result["total_damage"], 0, "AS1应有伤害")
        # 敌dmg_dealt_down
        enemy_debuffs = [d for d in self.enemy_front.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertTrue(len(enemy_debuffs) > 0, "AS1应对敌人施加dmg_dealt_down")
        self.assertEqual(enemy_debuffs[0].attack_limited, 1, "dmg_dealt_down应限1次攻击")

    def test_as1_self_debuff_lv1(self):
        """AS1(120115) Lv10 自身dmg_dealt_down 20%"""
        self.caster.skill_levels[120115] = 10
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120115, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 自dmg_dealt_down
        self_debuffs = [d for d in self.caster.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertTrue(len(self_debuffs) > 0, "AS1 Lv1-14应对自身施加dmg_dealt_down")
        self.assertEqual(self_debuffs[0].attack_limited, 1, "自身dmg_dealt_down应限1次攻击")

    def test_as1_self_debuff_removed_at_lv15(self):
        """AS1(120115) Lv15 自身debuff完全不存在（block被level_max:14跳过）"""
        self.caster.skill_levels[120115] = 15
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120115, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # Lv15自身debuff应完全不存在
        self_debuffs = [d for d in self.caster.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(self_debuffs), 0,
                         "Lv15自身dmg_dealt_down应完全不存在(block仅在Lv1-14生效)")
        # 敌人debuff应存在
        enemy_debuffs = [d for d in self.enemy_front.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertTrue(len(enemy_debuffs) > 0, "Lv15敌dmg_dealt_down应存在")

    def test_as1_enemy_debuff_stacks(self):
        """AS1(120115) 敌dmg_dealt_down可叠加"""
        self.ss.execute_skill(caster=self.caster, skill_id=120115, battlefield=self.bf, skip_cost=True)
        self.ss.execute_skill(caster=self.caster, skill_id=120115, battlefield=self.bf, skip_cost=True)
        enemy_debuffs = [d for d in self.enemy_front.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreaterEqual(len(enemy_debuffs), 2, "多次AS1后敌dmg_dealt_down应叠加(至少2层)")

    # ─── AS2: 120116 リフレイン ───

    def test_as2_damage_and_mark(self):
        """AS2(120116) 敌单体伤害 + 自mark(リズミカル)"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120116, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertGreater(result["total_damage"], 0, "AS2应有伤害")
        # 验证mark
        marks = [b for b in self.caster.buffs if b.effect_type == MARK and b.name == "リズミカル"]
        self.assertTrue(len(marks) > 0, "AS2应对自身施加リズミカルmark")

    def test_as2_first_cast_no_extra_attack(self):
        """AS2(120116) 首次施放(无mark)不触发block2追加攻击"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120116, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 首次应只有1个damage效果(block1), block2因has_mark_at_start=false跳过
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 1, "首次AS2(无mark)应只有1次伤害(block1)")

    def test_as2_second_cast_extra_attack(self):
        """AS2(120116) 第二次施放(有pre-skill mark)触发额外攻击"""
        # 第一次施放 → 施加mark
        self.ss.execute_skill(caster=self.caster, skill_id=120116, battlefield=self.bf, skip_cost=True)
        # 手动施加mark模拟"技能执行前mark已存在"(pre-skill check)
        mark = BuffState(
            buff_id="test_mark", name="リズミカル", effect_type=MARK,
            value=1, duration=1, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=self.caster.unit_id, source_skill_id=120116,
            is_debuff=False,
        )
        self.caster.buffs.append(mark)
        # 第二次施放
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120116, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 应有2个damage效果(block1 + block2)
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 2, "第二次AS2(有pre-skill mark)应有2次伤害")

    def test_as2_lv11_dmg_dealt_down(self):
        """AS2(120116) Lv11+ 额外攻击时附加dmg_dealt_down"""
        self.caster.skill_levels[120116] = 15
        # 预先施加mark
        mark = BuffState(
            buff_id="test_mark", name="リズミカル", effect_type=MARK,
            value=1, duration=1, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=self.caster.unit_id, source_skill_id=120116,
            is_debuff=False,
        )
        self.caster.buffs.append(mark)
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120116, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        enemy_debuffs = [d for d in self.enemy_front.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertTrue(len(enemy_debuffs) > 0, "AS2 Lv11+应附加dmg_dealt_down")

    # ─── PS1: 130123 コン・フオーコ ───

    def test_ps1_damage_row_and_knockout(self):
        """PS1(130123) 敌横列伤害 + 眩晕"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130123, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertGreater(result["total_damage"], 0, "PS1应有伤害")
        # 眩晕应施加在攻击目标上
        stun = any(d.effect_type == KNOCKOUT for d in self.enemy_front.debuffs)
        self.assertTrue(stun, "PS1应对敌人施加气绝")

    def test_ps1_knockout_upgrade(self):
        """PS1(130123) 目标已有1行动眩晕 → 升级为2行动"""
        # 先给敌人施加1行动眩晕
        existing_stun = BuffState(
            buff_id="existing_stun", name=KNOCKOUT, effect_type=KNOCKOUT,
            value=0, duration=1, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=self.caster.unit_id, source_skill_id=130123,
            is_debuff=True,
        )
        self.enemy_front.debuffs.append(existing_stun)
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130123, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 检查眩晕是否升级为2行动
        stuns = [d for d in self.enemy_front.debuffs if d.effect_type == KNOCKOUT]
        # 原有stun应该被覆盖/移除，新的stun duration=2
        has_dur2 = any(d.duration == 2 for d in stuns)
        self.assertTrue(has_dur2, "已有1行动眩晕时应升级为2行动")

    def test_ps1_knockout_upgrade_after_ex(self):
        """完整流程: EX(110052)施加1行动眩晕 → PS(130123)升级为2行动"""
        # Step1: EX施加眩晕
        ex_result = self.ss.execute_skill(
            caster=self.caster, skill_id=110052, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(ex_result["success"])
        stuns_after_ex = [d for d in self.enemy_front.debuffs if d.effect_type == KNOCKOUT]
        self.assertEqual(len(stuns_after_ex), 1, "EX应施加1个眩晕")
        self.assertEqual(stuns_after_ex[0].duration, 1, "EX眩晕应为1行动")
        # Step2: PS执行(模拟PS触发后的执行)
        ps_result = self.ss.execute_skill(
            caster=self.caster, skill_id=130123, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(ps_result["success"])
        # Step3: 验证眩晕升级
        stuns_after_ps = [d for d in self.enemy_front.debuffs if d.effect_type == KNOCKOUT]
        self.assertEqual(len(stuns_after_ps), 1, "PS后应仍只有1个眩晕(升级而非叠加)")
        self.assertEqual(stuns_after_ps[0].duration, 2,
                         f"EX施加1行动眩晕后PS应升级为2行动, 实际: {stuns_after_ps[0].duration}")

    def test_ps1_lv11_atk_up(self):
        """PS1(130123) Lv11+ 先自atk_up再攻击（duration_type=attacker_action，攻击者行动结束时清除）"""
        self.caster.skill_levels[130123] = 15
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130123, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # atk_up应在攻击者行动结束时清除（duration_type=attacker_action）
        # 在execute_skill内部仍应存在
        atk_buffs = [b for b in self.caster.buffs if b.effect_type == SkillEffectType.STATUS_ATTACK.value]
        attacker_action_atk = [b for b in atk_buffs if getattr(b, 'original_duration_type', '') == 'attacker_action']
        self.assertTrue(len(attacker_action_atk) > 0,
                        "atk_up(duration_type=attacker_action)应在skill执行期间存在")

    # ─── PS2: 130124 テンポプリモ ───

    def test_ps2_front_ally_crit_rate_up(self):
        """PS2(130124) 友方前排crit_rate_up"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130124, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        ally_crit = [b for b in self.ally_front.buffs if b.effect_type == CRIT_RATE]
        self.assertTrue(len(ally_crit) > 0, "PS2应对友方前排施加crit_rate_up")
        self.assertEqual(ally_crit[0].duration, 1, "crit_rate_up持续1回合")

    def test_ps2_front_enemy_crit_dmg_down(self):
        """PS2(130124) 敌方前排crit_dmg_down"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130124, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        enemy_debuffs = [d for d in self.enemy_front.debuffs if d.effect_type == CRIT_DAMAGE]
        # 敌方前排中央应被影响
        front_enemies = [u for u in [self.enemy_front, self.enemy_front_right, self.enemy_left_front] if u.is_alive]
        affected = 0
        for u in front_enemies:
            if any(d.effect_type == CRIT_DAMAGE for d in u.debuffs):
                affected += 1
        self.assertGreater(affected, 0, "PS2应对敌方前排施加crit_dmg_down")

    def test_ps2_lv11_back_row(self):
        """PS2(130124) Lv11+ 后排友方crit_rate_up + 后排敌方crit_dmg_down"""
        self.caster.skill_levels[130124] = 15
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130124, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 友方后排crit_rate_up
        ally_back_crit = [b for b in self.ally_back.buffs if b.effect_type == CRIT_RATE]
        self.assertTrue(len(ally_back_crit) > 0, "PS2 Lv11+应对友方后排施加crit_rate_up")
        # 敌方后排crit_dmg_down
        back_enemies = [u for u in [self.enemy_back_right] if u.is_alive]
        affected = any(
            any(d.effect_type == CRIT_DAMAGE for d in u.debuffs)
            for u in back_enemies
        )
        self.assertTrue(affected, "PS2 Lv11+应对敌方后排施加crit_dmg_down")


if __name__ == '__main__':
    unittest.main()
