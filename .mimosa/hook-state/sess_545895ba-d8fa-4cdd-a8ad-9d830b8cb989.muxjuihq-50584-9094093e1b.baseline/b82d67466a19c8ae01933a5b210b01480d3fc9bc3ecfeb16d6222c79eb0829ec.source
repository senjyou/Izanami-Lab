#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
角色133301技能验证测试

技能列表:
  - 110031 宝刀・皆琉神威 (EX): 敌单体5hit攻击(威力) + 1行动气绝(stun)
    Lv11+: 追加自身dmg_taken_down(stackable)
  - 120072 己が為の刃に非ず (AS): 敌单体攻击(威力) + 1行动dmg_dealt_down(debuff,stackable) + spd_down(debuff)
  - 120073 牙無き者の為たれ (AS): 敌单体攻击(威力) + lifesteal(cure%) + atk_up(self,stackable)
  - 130082 明鏡止水 (PS): 被debuff时触发, remove_debuff + debuff_immune(1action) + shield(atk%)
    Lv11+: 追加1action atk_up
  - 130083 一意専心 (PS): AS攻击前触发, crit_rate_up + crit_dmg_up(hp_scaling, target HP)
"""

import sys
import os
import time
import logging
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))

from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities.memory_card import MemoryCard, MemoryHighlight
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.entities_v2.custom_dummy import (
    CustomDummyConfig, build_synthetic_character_data, build_custom_skill_data,
    build_custom_parsed_skill, collect_custom_skill_ids,
)
from src.combat_v2.battle_flow_controller import BattleFlowController
from src.combat_v2.battle_narrative import BattleNarrativeWriter
from src.data.data_loader import DataLoader
from src.data.stat_calculator import StatCalculator
from src.config.panel_config import PanelConfig, ModuleConfig
from src.config.player_config import SchoolLevels


class LogCaptureHandler(logging.Handler):
    def __init__(self):
        super().__init__()
        self.records = []

    def emit(self, record):
        self.records.append(record.getMessage())


def create_dummy_unit(data_loader, name, side, pos, char_id, hp, atk, defense, speed,
                      ap, pp, ep_max=8, role_type=0, position_type=3, element=1, char_type=1):
    cfg = CustomDummyConfig(
        name=name,
        element=element,
        character_type=char_type,
        position_type=position_type,
        role_type=role_type if role_type > 0 else 1,
        hp=hp,
        attack=atk,
        defense=defense,
        speed=speed,
        ap=ap,
        pp=pp,
    )
    char_data = build_synthetic_character_data(abs(char_id) - 1, cfg)
    char_data.character_id = char_id
    data_loader._custom_characters[char_id] = char_data

    base_idx = abs(char_id) - 1
    as_skill = build_custom_skill_data(
        base_idx, False, 1, "通常攻撃", 100, 1, 0, 1, 3, 1, 1, 1
    )
    data_loader._custom_skills[as_skill.skill_id] = as_skill
    as_parsed = build_custom_parsed_skill(
        base_idx, False, 1, 3, 1, 1
    )
    data_loader._custom_parsed_skills[str(as_skill.skill_id)] = as_parsed
    data_loader._custom_character_skills[char_id] = [as_skill.skill_id]
    data_loader._custom_dummy_configs[char_id] = cfg

    side_prefix = "F" if side == Side.ALLY else "E"
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}",
        name=name,
        side=side,
        position=pos,
        character_id=char_id,
        level=200,
        element=cfg.element,
        character_type=cfg.character_type,
        max_hp=hp,
        current_hp=hp,
        attack=atk,
        defense=defense,
        speed=speed,
        crit_rate=0.15,
        crit_damage=0.5,
        advantage_damage=0.25,
        initial_active_point=ap,
        initial_passive_point=pp,
        max_extra_point=ep_max,
        current_ap=ap,
        current_pp=pp,
        current_ep=0,
        skills=[as_skill.skill_id],
        skill_levels={as_skill.skill_id: 1},
        skill_cooldowns={},
        role_type=role_type,
        position_type=position_type,
    )


def create_character_unit(data_loader, stat_calculator, char_id, side, pos,
                          panel_config, player_config, fury_count=0):
    char = data_loader.get_character_by_id(char_id)
    if not char:
        raise ValueError(f"Character {char_id} not found!")
    char_config = panel_config.get_character_config(char_id, char.default_rarity)
    stats = stat_calculator.calculate_stats(char_config, player_config)
    char_skills = data_loader.load_character_skills()
    skills = char_skills.get(char_id, [])
    side_prefix = "F" if side == Side.ALLY else "E"
    max_ep = 8
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}",
        name=char.name,
        side=side,
        position=pos,
        character_id=char_id,
        level=char_config.level,
        element=char.attribute,
        character_type=char.character_type,
        max_hp=stats.hp,
        current_hp=stats.hp,
        attack=stats.attack,
        defense=stats.defense,
        speed=stats.speed,
        crit_rate=stats.critical_rate,
        crit_damage=stats.critical_damage - 1.5,
        advantage_damage=stats.advantage_damage - 1.25,
        initial_active_point=stats.initial_ap,
        initial_passive_point=stats.initial_pp,
        max_extra_point=max_ep,
        current_ap=stats.initial_ap,
        current_pp=stats.initial_pp,
        current_ep=0,
        skills=skills,
        skill_levels=panel_config.skill_levels.get(char_id, {}),
        skill_cooldowns={},
        role_type=char.role_type,
        position_type=char.position_type,
        fury_count=fury_count,
    )


def _verify_and_print(bf, test_name, checks):
    print(f"\n{'─'*50}")
    print(f"[验证] {test_name}")
    print(f"{'─'*50}")
    passed = 0
    failed = 0
    for desc, condition, expected, actual in checks:
        status = "✅" if condition else "❌"
        if condition:
            passed += 1
        else:
            failed += 1
        print(f"  {status} {desc}")
        if not condition:
            print(f"     期望: {expected}, 实际: {actual}")
    print(f"  结果: {passed}通过 / {failed}失败")
    return failed == 0


def run_test(name, friends_config, enemies_config, data_loader, panel_config,
             player_config, stat_calculator, memory_card_ids=None, test_index=0,
             capture_logs=False):
    print(f"\n{'='*60}")
    print(f"Test {test_index}: {name}")
    print(f"{'='*60}")

    bf = BattlefieldState()
    friends = []
    enemies = []

    for cfg in friends_config:
        if cfg.get("is_dummy"):
            u = create_dummy_unit(
                data_loader, cfg["name"], Side.ALLY, cfg["pos"], cfg["char_id"],
                cfg["hp"], cfg["atk"], cfg["defense"], cfg["speed"],
                cfg["ap"], cfg["pp"], cfg.get("ep", 8),
                cfg.get("role_type", 0),
                cfg.get("position_type", 3),
                cfg.get("element", 1),
                cfg.get("char_type", 1),
            )
        else:
            u = create_character_unit(
                data_loader, stat_calculator, cfg["char_id"],
                Side.ALLY, cfg["pos"], panel_config, player_config,
                fury_count=cfg.get("fury_count", 0),
            )
            cooldown_override = cfg.get("skill_cooldown_override", None)
            if cooldown_override:
                for sk_id, cd_val in cooldown_override.items():
                    u.skill_cooldowns[sk_id] = cd_val
            ep_override = cfg.get("ep_override", None)
            if ep_override is not None:
                u.current_ep = ep_override
            speed_override = cfg.get("speed_override", None)
            if speed_override is not None:
                u.speed = speed_override
            hp_override = cfg.get("hp_override", None)
            if hp_override is not None:
                u.current_hp = hp_override
            ap_override = cfg.get("ap_override", None)
            if ap_override is not None:
                u.current_ap = ap_override
            crit_override = cfg.get("crit_rate_override", None)
            if crit_override is not None:
                u.crit_rate = crit_override
            pre_buffs = cfg.get("pre_buffs", None)
            if pre_buffs:
                for b_data in pre_buffs:
                    bf_buff = BuffState(
                        buff_id=b_data.get("buff_id", "pre_buff"),
                        name=b_data.get("name", "PreBuff"),
                        effect_type=b_data.get("effect_type", "PreBuff"),
                        value=b_data.get("value", 0),
                        duration=b_data.get("duration", -1),
                        timing_type=b_data.get("timing_type", AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value),
                        source_unit_id=u.unit_id,
                        caster_attack=u.attack,
                        is_debuff=b_data.get("is_debuff", False),
                    )
                    if b_data.get("is_debuff"):
                        u.debuffs.append(bf_buff)
                    else:
                        u.buffs.append(bf_buff)
        bf.add_unit(u)
        friends.append(u)

    for cfg in enemies_config:
        if cfg.get("is_dummy"):
            u = create_dummy_unit(
                data_loader, cfg["name"], Side.ENEMY, cfg["pos"], cfg["char_id"],
                cfg["hp"], cfg["atk"], cfg["defense"], cfg["speed"],
                cfg["ap"], cfg["pp"], cfg.get("ep", 8),
                cfg.get("role_type", 0),
                cfg.get("position_type", 3),
                cfg.get("element", 1),
                cfg.get("char_type", 1),
            )
        else:
            u = create_character_unit(
                data_loader, stat_calculator, cfg["char_id"],
                Side.ENEMY, cfg["pos"], panel_config, player_config,
            )
        hp_override = cfg.get("hp_override", None)
        if hp_override is not None:
            u.current_hp = hp_override
        bf.add_unit(u)
        enemies.append(u)

    if memory_card_ids:
        bf.memory_cards = []
        for card_id in memory_card_ids:
            memory_data = data_loader.get_memory(card_id)
            if memory_data:
                highlights = [
                    MemoryHighlight(
                        character_attribute=hl.character_attribute,
                        character_base_master_id=hl.character_base_master_id,
                        character_master_id=hl.character_master_id,
                        character_role=hl.character_role,
                        character_team_master_id=hl.character_team_master_id,
                        character_type=hl.character_type,
                        is_targeting_friendly_party=hl.is_targeting_friendly_party,
                        party_position=hl.party_position,
                        skill_master_id=hl.skill_master_id,
                    )
                    for hl in memory_data.highlights
                ]
                bf.memory_cards.append(MemoryCard(
                    card_id=card_id,
                    name=memory_data.name,
                    description=memory_data.description,
                    rarity=memory_data.rarity,
                    highlights=highlights,
                ))

    print(f"  己方: {[f'{u.name}({u.position.name})' for u in friends]}")
    print(f"  敌方: {[f'{u.name}({u.position.name})' for u in enemies]}")
    for u in friends:
        print(f"    [{u.name}] HP={u.current_hp}/{u.max_hp} ATK={u.attack} DEF={u.defense} SPD={u.speed} EP={u.current_ep}/{u.max_extra_point} AP={u.current_ap} CRIT={u.crit_rate}")
    for u in enemies:
        print(f"    [{u.name}] HP={u.current_hp}/{u.max_hp} ATK={u.attack} DEF={u.defense} SPD={u.speed}")

    controller = BattleFlowController(
        bf, data_loader=data_loader,
        narrative=BattleNarrativeWriter(data_loader=data_loader)
    )

    log_records = []
    if capture_logs:
        capture_handler = LogCaptureHandler()
        battle_logger = logging.getLogger('MGGBattleSim')
        battle_logger.addHandler(capture_handler)
        old_level = battle_logger.level
        battle_logger.setLevel(logging.INFO)

    result = controller.execute_battle()

    if capture_logs:
        battle_logger.removeHandler(capture_handler)
        battle_logger.setLevel(old_level)
        log_records = capture_handler.records

    print(f"\n  战斗结果: {result['result']} | 回合: {result['total_turns']} | 胜者: {result['winner']}")
    for u in bf.get_all_units():
        s = f"HP={u.current_hp}/{u.max_hp}" if u.is_alive else "阵亡"
        shield_s = f" shield={u.shield}" if u.shield > 0 else ""
        atk_up_buffs = [b for b in u.buffs if b.effect_type in ("atk_up", "StatusAttack")]
        atk_up_info = f" atk_up={atk_up_buffs[0].value}" if atk_up_buffs else ""
        dmg_down_buffs = [b for b in u.buffs if b.effect_type in ("dmg_taken_down", "ReceivedDamage")]
        dmg_down_info = f" dmg_down={dmg_down_buffs[0].value}" if dmg_down_buffs else ""
        spd_up_buffs = [b for b in u.buffs if b.effect_type in ("spd_up", "StatusSpeed")]
        spd_up_info = f" spd_up={spd_up_buffs[0].value}" if spd_up_buffs else ""
        cd_info = ""
        if u.skill_cooldowns:
            cd_info = f" CDs={dict(u.skill_cooldowns)}"
        print(f"    [{u.unit_id}] {u.name}({u.position.name}): {s}{shield_s}{atk_up_info}{dmg_down_info}{spd_up_info}{cd_info}")

    if controller.narrative:
        log_dir = os.path.join(os.path.dirname(__file__), "data", "battle_logs")
        os.makedirs(log_dir, exist_ok=True)
        safe_name = name.replace(" ", "_").replace("/", "_").replace(":", "")[:40]
        timestamp = time.strftime("%Y%m%d_%H%M%S")
        log_path = os.path.join(log_dir, f"test{test_index:02d}_{safe_name}_{timestamp}.txt")
        controller.narrative.write(log_path)
        print(f"\n  日志: {log_path}")
        return log_path, bf, result, log_records
    return None, bf, result, log_records


def run_debuff_trigger_test(name, char_id, panel_config, data_loader, stat_calculator,
                             test_index=0, capture_logs=True):
    print(f"\n{'='*60}")
    print(f"Test {test_index}: {name}")
    print(f"{'='*60}")

    log_records = []
    if capture_logs:
        capture_handler = LogCaptureHandler()
        battle_logger = logging.getLogger('MGGBattleSim')
        battle_logger.addHandler(capture_handler)
        old_level = battle_logger.level
        battle_logger.setLevel(logging.INFO)

    bf = BattlefieldState()

    player_config = panel_config.get_player_config()
    char = create_character_unit(
        data_loader, stat_calculator, char_id,
        Side.ALLY, Position.ALLY_CENTER_FRONT, panel_config, player_config,
    )
    char.speed = 999
    for sk_id in list(char.skill_cooldowns.keys()):
        char.skill_cooldowns[sk_id] = 0
    bf.add_unit(char)

    enemy = create_dummy_unit(
        data_loader, "TestEnemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
        -999, 500000, 1000, 0, 1, 1, 1,
    )
    bf.add_unit(enemy)

    print(f"  己方: [{char.name}] HP={char.current_hp}/{char.max_hp} ATK={char.attack} PP={char.current_pp}")
    print(f"  敌方: [{enemy.name}] HP={enemy.current_hp}/{enemy.max_hp}")

    controller = BattleFlowController(bf, data_loader=data_loader)

    debuff = BuffState(
        buff_id=f"test_debuff_{char.unit_id}",
        name="TestDebuff",
        effect_type="StatusAttack",
        value=-10, duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
        source_unit_id=enemy.unit_id,
        caster_attack=0,
        is_debuff=True,
    )
    char.debuffs.append(debuff)
    print(f"  施加debuff: {char.name} debuff_count={len(char.debuffs)}")

    trigger_actions = controller.trigger_service.trigger_pawn_received_aura(bf, [char.unit_id])
    print(f"  触发actions数量: {len(trigger_actions) if trigger_actions else 0}")

    controller._execute_trigger_actions(trigger_actions, char)

    if capture_logs:
        battle_logger.removeHandler(capture_handler)
        battle_logger.setLevel(old_level)
        log_records = capture_handler.records

    print(f"\n  战斗后状态:")
    s = f"HP={char.current_hp}/{char.max_hp}" if char.is_alive else "阵亡"
    shield_s = f" shield={char.shield}" if char.shield > 0 else ""
    print(f"    [{char.name}]: {s}{shield_s}")
    print(f"    buffs={[(b.effect_type, b.value) for b in char.buffs]}")
    print(f"    debuffs={[(b.effect_type, b.value) for b in char.debuffs]}")

    return bf, char, log_records


def main():
    panel_config = PanelConfig(
        character_level=200,
        school_levels=SchoolLevels(
            physical_level=25, en_level=25, agility_level=25,
            fire_level=25, water_level=25, earth_level=25, wind_level=25,
            light_level=25, dark_level=25,
        ),
        equipment_ids=[11, 12, 13, 14, 21, 22, 23, 24, 31, 32, 33, 34],
        equipment_enabled=False,
    )

    data_loader = DataLoader()
    data_loader.load_all()

    lerp_data = data_loader.load_level_lerp_data()
    stat_calculator = StatCalculator(lerp_data)

    char_id = 133301

    char = data_loader.get_character_by_id(char_id)
    panel_config.rarities[char_id] = 14
    panel_config.affection_levels[char_id] = 40
    skill_ids = data_loader.load_character_skills().get(char_id, [])
    panel_config.skill_levels[char_id] = {sid: 10 for sid in skill_ids}
    module_ids = [int(f"{char.character_type}1"), int(f"{char.character_type}2"),
                  int(f"{char.character_type}3")]
    panel_config.modules[char_id] = [
        ModuleConfig(module_id=mid, tier=9, level=50)
        for mid in module_ids
    ]

    player_config = panel_config.get_player_config()

    test_idx = 0

    # ============================================================
    # Test 1: 110031 宝刀・皆琉神威 (EX) Lv10 — 5hit单体+stun
    # 验证: 5hit攻击 + stun施加
    # ============================================================
    test_idx += 1
    _, bf1, _, logs1 = run_test("EX_110031_宝刀皆琉神威_Lv10_5hit+stun",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT, "ep_override": 8,
             "skill_cooldown_override": {}},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌A", "char_id": -101,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 500000, "atk": 1000, "defense": 1000, "speed": 1,
             "ap": 1, "pp": 1},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True,
    )
    enemy_a1 = next((u for u in bf1.get_all_units() if u.name == "敌A"), None)
    used_110031 = any("宝刀" in log for log in logs1)
    hit5_log = any("hit_count=5" in log for log in logs1)
    stun_log = any("stun" in log.lower() or "knockout" in log.lower() for log in logs1)
    _verify_and_print(bf1, "EX 110031 宝刀・皆琉神威 (Lv10, 5hit+stun)", [
        (f"110031使用(日志)", used_110031, "有", "无" if not used_110031 else "有"),
        (f"5hit攻击(日志)", hit5_log, "有", "无" if not hit5_log else "有"),
        (f"stun施加(日志)", stun_log, "有", "无" if not stun_log else "有"),
    ])

    # ============================================================
    # Test 2: 110031 宝刀・皆琉神威 (EX) Lv11+ — 5hit+stun+dmg_taken_down
    # 验证: dmg_taken_down buff施加
    # ============================================================
    test_idx += 1
    panel_config.skill_levels[char_id] = {sid: 12 for sid in skill_ids}
    player_config2 = panel_config.get_player_config()
    _, bf2, _, logs2 = run_test("EX_110031_宝刀皆琉神威_Lv11_dmg_taken_down",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT, "ep_override": 8,
             "speed_override": 999,
             "skill_cooldown_override": {}},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌A", "char_id": -201,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 500000, "atk": 1000, "defense": 1000, "speed": 1,
             "ap": 1, "pp": 1},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config2, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True,
    )
    char2 = next((u for u in bf2.get_all_units() if u.character_id == char_id), None)
    used_110031_l11 = any("宝刀" in log for log in logs2)
    dmg_taken_down_log = any("dmg_taken_down" in log or "ReceivedDamage" in log for log in logs2)
    char2_has_dmg_taken_down = any(b.effect_type in ("dmg_taken_down", "ReceivedDamage") for b in (char2.buffs if char2 else []))
    _verify_and_print(bf2, "EX 110031 宝刀・皆琉神威 (Lv11+, dmg_taken_down)", [
        (f"110031使用(日志)", used_110031_l11, "有", "无" if not used_110031_l11 else "有"),
        (f"dmg_taken_down施加(日志)", dmg_taken_down_log, "有", "无" if not dmg_taken_down_log else "有"),
        (f"自身dmg_taken_down buff", char2_has_dmg_taken_down, "有", "无" if not char2_has_dmg_taken_down else "有"),
    ])

    # ============================================================
    # Test 3: 120072 己が為の刃に非ず (AS) — 单体+dmg_dealt_down+spd_down
    # 验证: spd_down + dmg_dealt_down debuff
    # ============================================================
    test_idx += 1
    panel_config.skill_levels[char_id] = {sid: 10 for sid in skill_ids}
    player_config3 = panel_config.get_player_config()
    _, bf3, _, logs3 = run_test("AS_120072_己が為の刃に非ず_debuff",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT, "speed_override": 999,
             "skill_cooldown_override": {}},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌A", "char_id": -301,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 500000, "atk": 1000, "defense": 0, "speed": 100,
             "ap": 1, "pp": 1},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config3, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True,
    )
    enemy_a3 = next((u for u in bf3.get_all_units() if u.name == "敌A"), None)
    used_120072 = any("己が為" in log for log in logs3)
    spd_down_log = any("spd_down" in log or "StatusSpeed" in log for log in logs3)
    dmg_dealt_down_log = any("dmg_dealt_down" in log or "DealtDamage" in log for log in logs3)
    _verify_and_print(bf3, "AS 120072 己が為の刃に非ず (debuff)", [
        (f"120072使用(日志)", used_120072, "有", "无" if not used_120072 else "有"),
        (f"spd_down施加(日志)", spd_down_log, "有", "无" if not spd_down_log else "有"),
        (f"dmg_dealt_down施加(日志)", dmg_dealt_down_log, "有", "无" if not dmg_dealt_down_log else "有"),
    ])

    # ============================================================
    # Test 4: 120073 牙無き者の為たれ (AS) — 单体+lifesteal+atk_up
    # 验证: lifesteal治疗 + atk_up buff(self)
    # ============================================================
    test_idx += 1
    _, bf4, _, logs4 = run_test("AS_120073_牙無き者の為たれ_lifesteal+atk_up",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT, "speed_override": 999,
             "hp_override": 5000,
             "skill_cooldown_override": {}},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌A", "char_id": -401,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 500000, "atk": 1000, "defense": 0, "speed": 1,
             "ap": 1, "pp": 1},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config3, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True,
    )
    char4 = next((u for u in bf4.get_all_units() if u.character_id == char_id), None)
    used_120073 = any("牙無き" in log for log in logs4)
    lifesteal_log = any("LIFESTEAL" in log for log in logs4)
    atk_up_log4 = any("atk_up" in log or "StatusAttack" in log for log in logs4)
    char4_has_atk_up = any(b.effect_type in ("atk_up", "StatusAttack") for b in (char4.buffs if char4 else []))
    _verify_and_print(bf4, "AS 120073 牙無き者の為たれ (lifesteal+atk_up)", [
        (f"120073使用(日志)", used_120073, "有", "无" if not used_120073 else "有"),
        (f"lifesteal执行(日志)", lifesteal_log, "有", "无" if not lifesteal_log else "有"),
        (f"atk_up施加(日志)", atk_up_log4, "有", "无" if not atk_up_log4 else "有"),
        (f"自身atk_up buff", char4_has_atk_up, "有", "无" if not char4_has_atk_up else "有"),
    ])

    # ============================================================
    # Test 5: 130082 明鏡止水 (PS) Lv10 — 自身被debuff时触发, remove_debuff+debuff_immune+shield
    # 验证: 仅自身收到debuff时触发 + remove_debuff + debuff_immune + shield
    # 策略: 手动给角色施加debuff -> 触发PAWN_RECEIVED_AURA事件 -> 验证仅owner触发
    # ============================================================
    test_idx += 1
    panel_config.skill_levels[char_id] = {sid: 10 for sid in skill_ids}
    bf5, char5, logs5 = run_debuff_trigger_test(
        "PS_130082_明鏡止水_Lv10_remove+immune+shield",
        char_id, panel_config, data_loader, stat_calculator,
        test_index=test_idx,
    )
    triggered_130082 = any("明鏡止水" in log for log in logs5)
    remove_debuff_log = any("REMOVE_DEBUFF" in log for log in logs5)
    debuff_immune_log = any("debuff_immune" in log or "DebuffImmune" in log for log in logs5)
    shield_log5 = any("+shield" in log for log in logs5)
    char5_has_debuff_immune = any(b.effect_type in ("debuff_immune", "DebuffImmune") for b in (char5.buffs if char5 else []))
    char5_debuff_count = len(char5.debuffs) if char5 else -1
    _verify_and_print(bf5, "PS 130082 明鏡止水 (Lv10, remove+immune+shield)", [
        (f"130082触发(日志)", triggered_130082, "有", "无" if not triggered_130082 else "有"),
        (f"remove_debuff(日志)", remove_debuff_log, "有", "无" if not remove_debuff_log else "有"),
        (f"debuff_immune施加(日志)", debuff_immune_log, "有", "无" if not debuff_immune_log else "有"),
        (f"debuff_immune buff存在", char5_has_debuff_immune, "有", "无" if not char5_has_debuff_immune else "有"),
        (f"shield施加(日志)", shield_log5, "有", "无" if not shield_log5 else "有"),
        (f"自身debuff已清除", char5_debuff_count == 0, f"debuff=0", f"debuff={char5_debuff_count}" if char5_debuff_count == -1 else f"debuff={char5_debuff_count}"),
    ])

    # ============================================================
    # Test 6: 130082 明鏡止水 (PS) — 验证非自身收到debuff时不触发
    # 验证: 仅当debuff应用于owner时才触发
    # ============================================================
    test_idx += 1
    panel_config.skill_levels[char_id] = {sid: 10 for sid in skill_ids}
    bf6_test, char6_test, logs6_test = run_debuff_trigger_test(
        "PS_130082_明鏡止水_only_owner_triggers",
        char_id, panel_config, data_loader, stat_calculator,
        test_index=test_idx,
    )
    enemy6 = next((u for u in bf6_test.get_all_units() if u.name == "TestEnemy"), None)
    controller6 = BattleFlowController(bf6_test, data_loader=data_loader)
    enemy_debuff = BuffState(
        buff_id=f"test_debuff_enemy_{enemy6.unit_id}",
        name="TestDebuffEnemy", effect_type="StatusAttack",
        value=-10, duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
        source_unit_id=char6_test.unit_id, caster_attack=0, is_debuff=True,
    )
    enemy6.debuffs.append(enemy_debuff)
    trigger_actions_enemy = controller6.trigger_service.trigger_pawn_received_aura(bf6_test, [enemy6.unit_id])
    enemy_triggered = any(a.owner_id == char6_test.unit_id for a in (trigger_actions_enemy or []))
    _verify_and_print(bf6_test, "PS 130082 明鏡止水 (仅owner收到debuff时触发)", [
        (f"敌方收debuff不触发130082", not enemy_triggered, "不触发(正确)", "触发(错误)" if enemy_triggered else "不触发(正确)"),
    ])

    # ============================================================
    # Test 7: 130082 明鏡止水 (PS) Lv11+ — +atk_up
    # 验证: Lv11+追加atk_up施加
    # ============================================================
    test_idx += 1
    panel_config.skill_levels[char_id] = {sid: 12 for sid in skill_ids}
    bf7, char7, logs7 = run_debuff_trigger_test(
        "PS_130082_明鏡止水_Lv11_atk_up",
        char_id, panel_config, data_loader, stat_calculator,
        test_index=test_idx,
    )
    triggered_130082_l11 = any("明鏡止水" in log for log in logs7)
    atk_up_log7 = any("atk_up" in log or "StatusAttack" in log for log in logs7)
    char7_has_atk_up = any(b.effect_type in ("atk_up", "StatusAttack") for b in (char7.buffs if char7 else []))
    _verify_and_print(bf7, "PS 130082 明鏡止水 (Lv11+, +atk_up)", [
        (f"130082触发(日志)", triggered_130082_l11, "有", "无" if not triggered_130082_l11 else "有"),
        (f"atk_up施加(日志)", atk_up_log7, "有", "无" if not atk_up_log7 else "有"),
        (f"自身atk_up buff", char7_has_atk_up, "有", "无" if not char7_has_atk_up else "有"),
    ])

    # ============================================================
    # Test 8: 130083 一意専心 (PS) — AS攻击前触发, crit_rate_up+crit_dmg_up
    # 验证: before_skill_use触发 + crit_rate_up + crit_dmg_up (hp_scaling_enemy: 基于敌方HP)
    # ============================================================
    test_idx += 1
    panel_config.skill_levels[char_id] = {sid: 10 for sid in skill_ids}
    player_config8 = panel_config.get_player_config()
    _, bf8, _, logs8 = run_test("PS_130083_一意専心_before_skill_use",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT, "speed_override": 999,
             "skill_cooldown_override": {}},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌A", "char_id": -801,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 500000, "atk": 1000, "defense": 0, "speed": 1,
             "ap": 1, "pp": 1},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config8, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True,
    )
    char8 = next((u for u in bf8.get_all_units() if u.character_id == char_id), None)
    triggered_130083 = any("一意専心" in log for log in logs8)
    crit_rate_log = any("StatusCriticalChance" in log or "crit_rate_up" in log for log in logs8)
    crit_dmg_log = any("CriticalBonusModification" in log or "crit_dmg_up" in log for log in logs8)
    hp_scaling_log = any("HP-scaling" in log for log in logs8)
    _verify_and_print(bf8, "PS 130083 一意専心 (before_skill_use, crit_up+hp_scaling_enemy)", [
        (f"130083触发(日志)", triggered_130083, "有", "无" if not triggered_130083 else "有"),
        (f"crit_rate_up(日志)", crit_rate_log, "有", "无" if not crit_rate_log else "有"),
        (f"crit_dmg_up(日志)", crit_dmg_log, "有", "无" if not crit_dmg_log else "有"),
        (f"hp_scaling(日志)", hp_scaling_log, "有", "无" if not hp_scaling_log else "有"),
    ])

    print(f"\n{'='*60}")
    print(f"全部测试完成!")
    print(f"{'='*60}")


if __name__ == "__main__":
    main()