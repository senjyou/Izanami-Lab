"""Regression: 紙一重なメイズオタク (102201) skill effects config validation.

Character 102201 has 3 skills:
- AS 120009 アブノーマル・ポイント: 敵単体に攻撃 + 対象が状態異常時PP-1
- PS 130007 スタン・オブ・ダウン: 自身がAS攻撃された後、攻撃者にspd_down + アグレッシブ(火=1)時気絶
- PS 130018 ディミニッシュ・オンリー: 自身HP≤40%時、4攻撃まで物理被ダメージ減少

Fixes applied:
- 120009: removed duplicate damage, replaced add_ep with remove_pp (value=1) + target_has_status_ailment condition
- 130007: trigger_type=after_as_attacked, target_identifier=trigger_attacker on spd_down + stun, Block2 target_element=1 condition
- 130018: global_condition self_hp_percent<=40, duration_type=attack + attack_limited=4 + damage_element=physical
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


ABNORMAL_POINT = 120009  # アブノーマル・ポイント
STUN_OF_DOWN = 130007  # スタン・オブ・ダウン
DIMINISH_ONLY = 130018  # ディミニッシュ・オンリー


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.WATER.value,
               character_type=2, skills=None, skill_levels=None, pp=4):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=pp, current_ep=0,
        is_alive=hp > 0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class TestReg102201MazeOtaku(unittest.TestCase):
    """紙一重なメイズオタク (102201) skill effects validation."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    # ---- 120009 アブノーマル・ポイント config ----

    def test_config_120009_damage_enemy_single(self):
        """120009 must have exactly one damage effect targeting enemy_single."""
        parsed = self.dl.get_parsed_skill_data(ABNORMAL_POINT)
        self.assertIsNotNone(parsed, "120009 parsed data missing")

        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(len(blocks), 1, "120009 must have 1 effect block")

        dmg_effs = [e for e in blocks[0].get('effects', [])
                    if e.get('effect_type') == 'damage']
        self.assertEqual(len(dmg_effs), 1, "120009 must have exactly 1 damage effect")
        eff = dmg_effs[0]
        self.assertEqual(eff.get('target_type'), 'enemy_single')
        self.assertEqual(eff.get('value_tag'), '威力')

    def test_config_120009_remove_pp_with_status_ailment_condition(self):
        """120009 must have remove_pp (value=1) with target_has_status_ailment condition."""
        parsed = self.dl.get_parsed_skill_data(ABNORMAL_POINT)
        blocks = parsed.get('effect_blocks', [])

        pp_effs = [e for e in blocks[0].get('effects', [])
                   if e.get('effect_type') == 'remove_pp']
        self.assertGreater(len(pp_effs), 0,
                           "120009 must have remove_pp effect (replaces add_ep bug)")
        eff = pp_effs[0]
        self.assertEqual(eff.get('target_type'), 'enemy_single')
        self.assertEqual(eff.get('value'), 1, "remove_pp must reduce PP by 1")

        cond = eff.get('condition')
        self.assertIsNotNone(cond, "remove_pp must have condition")
        self.assertEqual(cond.get('type'), 'target_has_status_ailment',
                         "remove_pp only triggers when target has status ailment")

    def test_config_120009_no_duplicate_damage(self):
        """120009 must NOT have duplicate damage effects (regression check)."""
        parsed = self.dl.get_parsed_skill_data(ABNORMAL_POINT)
        blocks = parsed.get('effect_blocks', [])
        dmg_count = sum(1 for e in blocks[0].get('effects', [])
                        if e.get('effect_type') == 'damage')
        self.assertEqual(dmg_count, 1, "120009 must have exactly 1 damage (no duplicate)")

    # ---- 130007 スタン・オブ・ダウン config ----

    def test_config_130007_trigger_type_after_as_attacked(self):
        """130007 must have trigger_type=after_as_attacked."""
        parsed = self.dl.get_parsed_skill_data(STUN_OF_DOWN)
        self.assertIsNotNone(parsed, "130007 parsed data missing")
        self.assertEqual(parsed.get('trigger_type'), 'after_as_attacked')
        self.assertEqual(parsed.get('skill_type'), 2, "130007 must be PS (skill_type=2)")

    def test_config_130007_block1_spd_down_trigger_attacker(self):
        """130007 Block1 spd_down must target_identifier=trigger_attacker."""
        parsed = self.dl.get_parsed_skill_data(STUN_OF_DOWN)
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(len(blocks), 2, "130007 must have 2 effect blocks")

        block1 = blocks[0]
        self.assertIsNone(block1.get('condition'),
                           "Block1 has no condition (always applies spd_down)")

        spd_effs = [e for e in block1.get('effects', [])
                    if e.get('effect_type') == 'spd_down']
        self.assertGreater(len(spd_effs), 0, "Block1 must have spd_down")
        eff = spd_effs[0]
        self.assertEqual(eff.get('target_type'), 'enemy_single')
        self.assertEqual(eff.get('target_identifier'), 'trigger_attacker',
                         "spd_down must target the attacker (trigger_attacker)")
        self.assertEqual(eff.get('duration'), 2)
        self.assertEqual(eff.get('duration_type'), 'action')
        self.assertTrue(eff.get('flags', {}).get('stackable'),
                        "spd_down must be stackable")
        self.assertEqual(eff.get('flags', {}).get('value_type'), 'percent')

    def test_config_130007_block2_stun_aggressive_only(self):
        """130007 Block2 must have target_element=1 (アグレッシブ/火) condition + stun."""
        parsed = self.dl.get_parsed_skill_data(STUN_OF_DOWN)
        blocks = parsed.get('effect_blocks', [])
        block2 = blocks[1]

        cond = block2.get('condition')
        self.assertIsNotNone(cond, "Block2 must have target_element condition")
        self.assertEqual(cond.get('type'), 'target_element')
        self.assertEqual(cond.get('value'), 1,
                         "Block2 stun targets アグレッシブ(火=1) only")

        stun_effs = [e for e in block2.get('effects', [])
                     if e.get('effect_type') == 'add_status']
        self.assertGreater(len(stun_effs), 0, "Block2 must have add_status stun")
        eff = stun_effs[0]
        self.assertEqual(eff.get('target_type'), 'enemy_single')
        self.assertEqual(eff.get('target_identifier'), 'trigger_attacker')
        self.assertEqual(eff.get('value_tag'), 'stun')
        self.assertEqual(eff.get('duration'), 1)
        self.assertEqual(eff.get('duration_type'), 'action')

    # ---- 130018 ディミニッシュ・オンリー config ----

    def test_config_130018_global_condition_self_hp_percent_40(self):
        """130018 must have global_condition self_hp_percent<=40."""
        parsed = self.dl.get_parsed_skill_data(DIMINISH_ONLY)
        self.assertIsNotNone(parsed, "130018 parsed data missing")
        self.assertEqual(parsed.get('trigger_type'), 'on_hp_below')

        gc = parsed.get('global_condition')
        self.assertIsNotNone(gc, "130018 must have global_condition")
        self.assertEqual(gc.get('type'), 'self_hp_percent',
                         "130018 must use self_hp_percent (自身HP≤40%)")
        self.assertEqual(gc.get('operator'), '<=')
        self.assertEqual(gc.get('value'), 40)

    def test_config_130018_dmg_taken_down_attack_limited_4_physical(self):
        """130018 dmg_taken_down must have attack_limited=4 + damage_element=physical."""
        parsed = self.dl.get_parsed_skill_data(DIMINISH_ONLY)
        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(len(blocks), 1)

        effs = blocks[0].get('effects', [])
        buff_effs = [e for e in effs if e.get('effect_type') == 'dmg_taken_down']
        self.assertGreater(len(buff_effs), 0, "130018 must have dmg_taken_down effect")
        eff = buff_effs[0]

        self.assertEqual(eff.get('target_type'), 'self')
        self.assertEqual(eff.get('duration_type'), 'attack',
                         "130018 must use duration_type=attack (consumed per attack)")
        self.assertEqual(eff.get('flags', {}).get('attack_limited'), 4,
                         "130018 must have attack_limited=4 (4 attacks)")
        self.assertEqual(eff.get('flags', {}).get('damage_element'), 'physical',
                         "130018 must reduce physical damage only")
        self.assertTrue(eff.get('flags', {}).get('stackable'),
                        "130018 dmg_taken_down must be stackable")
        self.assertEqual(eff.get('flags', {}).get('value_type'), 'percent')

    def test_config_130018_cooldown_99_once_per_battle(self):
        """130018 must have cooldown=99 (戦闘中1度のみ)."""
        parsed = self.dl.get_parsed_skill_data(DIMINISH_ONLY)
        self.assertEqual(parsed.get('cooldown'), 99,
                         "130018 cooldown=99 (once per battle)")
        self.assertEqual(parsed.get('cooldown_update_timing'), 1)

    # ---- 120009 behavior: remove_pp with status ailment ----

    def test_behavior_120009_remove_pp_when_target_has_ailment(self):
        """アブノーマル・ポイント: target with status ailment → PP-1.

        Setup: enemy with poison debuff (status ailment). After 120009 executes,
        enemy.current_pp should decrease by 1.
        """
        caster = _make_unit(
            "caster", "アブノーマル使用者", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[ABNORMAL_POINT], skill_levels={ABNORMAL_POINT: 10}, pp=1,
        )
        enemy = _make_unit(
            "enemy", "毒状態の敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=5000, defense=4000, pp=4,
        )
        # Apply poison debuff to enemy (status ailment)
        poison = BuffState(
            buff_id="test_poison_1",
            name="poison",
            effect_type=SkillEffectType.POISON.value,
            value=1000,
            duration=2,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=caster.unit_id,
            is_debuff=True,
        )
        enemy.debuffs.append(poison)

        bf = _make_bf(caster, enemy)
        ss, _ = self._make_services(bf)

        pp_before = enemy.current_pp
        result = ss.execute_skill(caster, ABNORMAL_POINT, bf)
        self.assertTrue(result.get('success'))

        self.assertEqual(enemy.current_pp, pp_before - 1,
                         "Enemy with status ailment must have PP reduced by 1")

    def test_behavior_120009_no_pp_removal_when_no_ailment(self):
        """アブノーマル・ポイント: target without status ailment → NO PP reduction.

        Setup: enemy with NO debuffs. After 120009 executes,
        enemy.current_pp should remain unchanged.
        """
        caster = _make_unit(
            "caster", "アブノーマル使用者", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[ABNORMAL_POINT], skill_levels={ABNORMAL_POINT: 10}, pp=1,
        )
        enemy = _make_unit(
            "enemy", "通常状態の敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=5000, defense=4000, pp=4,
        )
        # enemy has NO debuffs (no status ailment)

        bf = _make_bf(caster, enemy)
        ss, _ = self._make_services(bf)

        pp_before = enemy.current_pp
        result = ss.execute_skill(caster, ABNORMAL_POINT, bf)
        self.assertTrue(result.get('success'))

        self.assertEqual(enemy.current_pp, pp_before,
                         "Enemy without status ailment must NOT have PP reduced")


if __name__ == '__main__':
    unittest.main()
