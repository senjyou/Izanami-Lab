"""Regression: リフホーシルト (210097) target selection by highest current HP (absolute).

History:
  1. Bug: Skill 210097 was configured with target_type
     `enemy_single_highest_hp_ratio_back_priority` (strict back-row priority),
     but its in-game description is "最も残りHPが多い敵単体に..." with NO
     "後列優先で" (back-row priority). Fixed to `enemy_single_highest_hp_ratio`.

  2. Re-verification: After real combat testing, the skill should compare by
     current HP ABSOLUTE value, not HP percentage. Changed target_type to
     `enemy_single_highest_current_hp`.

     Distinguishing scenario:
       - Unit A: 80000/100000 (80% ratio, 80000 absolute)
       - Unit B: 45000/50000  (90% ratio, 45000 absolute)
       - HP ratio mode would select B (90% > 80%)
       - Absolute HP mode selects A (80000 > 45000) ← correct

Note: Skill 120085 (届け、マイソング！) which has "後列優先で" in its description
keeps the `_back_priority` variant and uses HP ratio, verified by
test_actor_108302.py.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position


class TestRegRiehoSchildTarget(unittest.TestCase):
    """リフホーシルト (210097) must target the enemy with the highest
    current HP (absolute value), regardless of row position."""

    @classmethod
    def setUpClass(cls):
        bb = BattleBuilder()
        # Caster: enemy boss using skill 210097
        bb.add_enemy(unit_id="caster", position=Position.ENEMY_CENTER_FRONT,
                     hp=999999, atk=5000, defense=5000, speed=500,
                     skills=[210097], level=10, pp=10, ep=10)
        ctx = bb.build()
        cls.bf = ctx['bf']
        cls.ss = ctx['ss']
        cls.caster = next(u for u in cls.bf.enemy_team if u.unit_id == "caster")

    def setUp(self):
        """Reset battlefield allies before each test."""
        self.bf.friend_team = []

    def _add_ally(self, unit_id, position, max_hp, current_hp):
        """Add an ally unit with specified HP."""
        from src.entities_v2.unit_state import UnitState
        from src.entities_v2.enums import Side
        u = UnitState(
            unit_id=unit_id, name=unit_id, side=Side.ALLY,
            position=position, character_id=999901,
            level=10, element=2, character_type=1,
            max_hp=max_hp, current_hp=current_hp,
            attack=1000, defense=1000, speed=100,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=10,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.bf.friend_team.append(u)
        return u

    def test_front_row_higher_current_hp_is_targeted(self):
        """Front row with HIGHER current HP must be selected over back row
        with LOWER current HP, even if back row has a higher HP percentage.

        This is the original bug scenario (adapted for absolute HP):
          - Front row: 163180/163182 (99.9988%, 163180 absolute)
          - Back row:  120672/120677 (99.9961%, 120672 absolute)
        """
        front = self._add_ally(
            "ally_front", Position.ALLY_CENTER_FRONT,
            max_hp=163182, current_hp=163180)
        back = self._add_ally(
            "ally_back", Position.ALLY_CENTER_BACK,
            max_hp=120677, current_hp=120672)

        hp_before = {u.unit_id: u.current_hp for u in [front, back]}

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=210097,
            battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        # Front row (higher current HP) should be damaged
        self.assertLess(front.current_hp, hp_before["ally_front"],
                        "Front row with higher current HP should be targeted")
        self.assertEqual(back.current_hp, hp_before["ally_back"],
                          "Back row with lower current HP should NOT be targeted")

    def test_back_row_higher_current_hp_is_targeted(self):
        """When back row has higher current HP, it should be selected
        (no row bias in either direction — purely by current HP absolute value)."""
        front = self._add_ally(
            "ally_front", Position.ALLY_CENTER_FRONT,
            max_hp=50000, current_hp=30000)
        back = self._add_ally(
            "ally_back", Position.ALLY_CENTER_BACK,
            max_hp=50000, current_hp=45000)

        hp_before = {u.unit_id: u.current_hp for u in [front, back]}

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=210097,
            battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        # Back row (higher current HP) should be damaged
        self.assertLess(back.current_hp, hp_before["ally_back"],
                        "Back row with higher current HP should be targeted")
        self.assertEqual(front.current_hp, hp_before["ally_front"],
                         "Front row with lower current HP should NOT be targeted")

    def test_absolute_hp_overrides_hp_percentage(self):
        """Distinguishing test: when one unit has higher HP% but lower absolute HP,
        the skill must select the unit with higher ABSOLUTE current HP.

        Scenario:
          - Front: 80000/100000 (80% ratio, 80000 absolute) ← higher absolute
          - Back:  45000/50000  (90% ratio, 45000 absolute) ← higher ratio

        With HP ratio mode: back would be selected (90% > 80%)
        With absolute HP mode: front is selected (80000 > 45000) ← correct
        """
        front = self._add_ally(
            "ally_front", Position.ALLY_CENTER_FRONT,
            max_hp=100000, current_hp=80000)
        back = self._add_ally(
            "ally_back", Position.ALLY_CENTER_BACK,
            max_hp=50000, current_hp=45000)

        hp_before = {u.unit_id: u.current_hp for u in [front, back]}

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=210097,
            battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

        # Front (higher absolute HP, lower ratio) should be damaged
        self.assertLess(front.current_hp, hp_before["ally_front"],
                        "Front row with higher absolute HP (80000 > 45000) "
                        "should be targeted despite lower ratio (80% < 90%)")
        self.assertEqual(back.current_hp, hp_before["ally_back"],
                         "Back row with lower absolute HP should NOT be targeted")

    def test_single_target_no_crash(self):
        """Skill should work normally with a single target."""
        only = self._add_ally(
            "ally_only", Position.ALLY_CENTER_FRONT,
            max_hp=50000, current_hp=50000)

        hp_before = only.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=210097,
            battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertLess(only.current_hp, hp_before,
                        "Single target should be damaged")


if __name__ == '__main__':
    unittest.main()
