"""
角色107302 クリスマスコーデの参謀 专项测试
- EX: 110037 クリスマス・デコレーション（味方全体シールド + Lv11+ HOT）
- AS1: 120083 聖夜の祝砲！？（敵単体攻撃 + Lv11+ 条件self dmg_taken_down）
- AS2: 120084 プレゼント・タイム（最低HP味方回復 + low_hp_heal_bonus + Lv11+ def_up[healed_target]）
- PS1: 130095 セルフ・プロデュース（被攻撃時guard + 状態異常1つ無効 + Lv11+ behind_self dmg_taken_down）
- PS2: 130096 はらぐろさくしー（会心時発動、対象のバフ解除[Lv1-14: N個, Lv15: 全解除]）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, AuraUpdateTiming
)

from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 簡写
ATK_UP = SkillEffectType.STATUS_ATTACK.value
DEF_UP = SkillEffectType.STATUS_DEFENSE.value
SHIELD = SkillEffectType.SHIELD.value
GUARD = SkillEffectType.GUARD.value
DMG_TAKEN_DOWN = SkillEffectType.RECEIVED_DAMAGE.value
BLOCK_SPECIFIC_AURA = SkillEffectType.BLOCK_SPECIFIC_AURA.value
KNOCKOUT = SkillEffectType.KNOCKOUT.value
POISON = SkillEffectType.POISON.value


def make_buff(unit, name, effect_type=ATK_UP, value=10.0, is_debuff=False,
              unremovable=False, is_memory_buff=False):
    """添加测试用buff到unit.buffs列表"""
    b = BuffState(
        buff_id=f"{unit.unit_id}_{name}_{len(unit.buffs)}",
        name=name, effect_type=effect_type, value=value,
        duration=3, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id="test", source_skill_id=0, caster_attack=0,
        is_debuff=is_debuff, unremovable=unremovable, is_memory_buff=is_memory_buff,
    )
    unit.buffs.append(b)
    return b


class TestActor107302(unittest.TestCase):
    """角色107302 クリスマスコーデの参謀"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 107302 クリスマスコーデの参謀 (前排中央)
        self.caster = UnitState(
            unit_id="ally_caster", name="クリスマスコーデの参謀", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=107302, level=15,
            element=5, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.5, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=3, initial_passive_point=3, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=100,
            skills=[110037, 120083, 120084, 130095, 130096],
            skill_levels={110037: 15, 120083: 15, 120084: 15, 130095: 15, 130096: 15},
            skill_cooldowns={},
        )

        # 友方后排中央（位于施法者身后，用于PS1 behind_self测试）
        self.ally_back = UnitState(
            unit_id="ally_back", name="味方後列", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=999100, level=15,
            element=5, character_type=1,
            max_hp=15000, current_hp=5000,  # HP较低，用于low_hp_heal_bonus测试
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=3, initial_passive_point=3, max_extra_point=100,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方前排左（HP满，用于low_hp_heal_bonus对比）
        self.ally_front_l = UnitState(
            unit_id="ally_front_l", name="味方前列左", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999101, level=15,
            element=5, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=3, initial_passive_point=3, max_extra_point=100,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央
        self.enemy = UnitState(
            unit_id="enemy", name="敵A", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=15,
            element=6, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=15000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=100,
            current_ap=4, current_pp=4, current_ep=10,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.add_unit(self.caster)
        self.bf.add_unit(self.ally_back)
        self.bf.add_unit(self.ally_front_l)
        self.bf.add_unit(self.enemy)

        # 创建服务
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.asvc = AuraService()
        self.dmgsvc = DamageService()
        self.tgtsvc = TargetService()
        self.stsvc = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgtsvc,
            damage_service=self.dmgsvc,
            aura_service=self.asvc,
            status_service=self.stsvc,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)


class TestAS2LowHpHealBonus(TestActor107302):
    """AS2 120084 プレゼント・タイム: low_hp_heal_bonus テスト"""

    def test_heal_scales_with_low_hp(self):
        """HPが少ないほど回復量が増加する（+50%まで）"""
        # ally_back HP=5000/15000 (33.3%) → bonus_mult = 1 + 0.5*(1-0.333) = 1.333
        result = self.ss.execute_skill(self.caster, 120084, self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        heals = result.get("effects_applied", [])
        heal_entry = next((e for e in heals if e.get("effect_type") == "heal"), None)
        self.assertIsNotNone(heal_entry, "heal effect should exist")
        heal_details = heal_entry.get("heals", [])
        self.assertTrue(len(heal_details) > 0)
        # 回復量 > 0
        self.assertGreater(heal_details[0]["amount"], 0)
        # ally_backのHPが増加
        self.assertGreater(self.ally_back.current_hp, 5000)

    def test_heal_bonus_at_full_hp(self):
        """満血時はbonus無し（bonus_mult=1.0）"""
        # ally_backを満血にする
        self.ally_back.current_hp = self.ally_back.max_hp
        result = self.ss.execute_skill(self.caster, 120084, self.bf, skip_cost=True)
        # 満血なのでactual_heal=0
        heals = result.get("effects_applied", [])
        heal_entry = next((e for e in heals if e.get("effect_type") == "heal"), None)
        if heal_entry:
            heal_details = heal_entry.get("heals", [])
            if heal_details:
                # 満血時はactual_heal=0（回復量は缺失HPまで）
                self.assertEqual(heal_details[0]["amount"], 0)

    def test_heal_bonus_formula_displayed(self):
        """heal_formulaにlow_hp_bonusが含まれる"""
        result = self.ss.execute_skill(self.caster, 120084, self.bf, skip_cost=True)
        heals = result.get("effects_applied", [])
        heal_entry = next((e for e in heals if e.get("effect_type") == "heal"), None)
        self.assertIsNotNone(heal_entry)
        heal_details = heal_entry.get("heals", [])
        if heal_details:
            formula = heal_details[0].get("heal_formula", "")
            self.assertIn("low_hp_bonus", formula)


class TestAS2HealedTarget(TestActor107302):
    """AS2 120084: healed_target identifier テスト（Lv11+ def_up）"""

    def test_def_up_applied_to_healed_target(self):
        """Lv11+で回復対象にdef_upが付与される"""
        self.caster.skill_levels[120084] = 15
        result = self.ss.execute_skill(self.caster, 120084, self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # ally_backにdef_up buffがある
        def_up_buffs = [b for b in self.ally_back.buffs if b.effect_type == DEF_UP]
        self.assertTrue(len(def_up_buffs) > 0, "def_up should be applied to healed target")

    def test_no_def_up_below_level_11(self):
        """Lv10以下ではdef_upが付与されない"""
        self.caster.skill_levels[120084] = 10
        result = self.ss.execute_skill(self.caster, 120084, self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        def_up_buffs = [b for b in self.ally_back.buffs if b.effect_type == DEF_UP]
        self.assertEqual(len(def_up_buffs), 0, "def_up should NOT be applied below Lv11")


class TestPS1BehindSelf(TestActor107302):
    """PS1 130095 セルフ・プロデュース: behind_self identifier テスト"""

    def test_behind_self_targets_back_row_ally(self):
        """Lv11+で同列後位の味方にdmg_taken_downが付与される"""
        self.caster.skill_levels[130095] = 15
        # PS1はbefore_any_attacked + target_is_self
        # 手動で_execute_trigger_actions_inlineを呼ぶ代わりにexecute_skillでテスト
        self.ss._trigger_attacker = self.enemy
        self.ss._primary_target = self.caster
        result = self.ss.execute_skill(self.caster, 130095, self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # ally_back（casterの後位）にdmg_taken_downがある
        dmg_down_buffs = [b for b in self.ally_back.buffs if b.effect_type == DMG_TAKEN_DOWN]
        self.assertTrue(len(dmg_down_buffs) > 0, "dmg_taken_down should be applied to ally behind self")

    def test_no_behind_self_when_caster_in_back_row(self):
        """casterが後列の場合、behind_self対象なし"""
        self.caster.position = Position.ALLY_CENTER_BACK
        self.caster.skill_levels[130095] = 15
        self.ss._trigger_attacker = self.enemy
        self.ss._primary_target = self.caster
        result = self.ss.execute_skill(self.caster, 130095, self.bf, skip_cost=True)
        # 後列の場合、behind_self対象なし
        dmg_down_buffs = [b for b in self.ally_back.buffs if b.effect_type == DMG_TAKEN_DOWN]
        self.assertEqual(len(dmg_down_buffs), 0)


class TestPS1BlockStatusCount(TestActor107302):
    """PS1 130095: block_status_count (1つ無効) テスト"""

    def test_block_specific_aura_count_field(self):
        """block_status_count=1がBuffStateに正しく設定される"""
        self.ss._trigger_attacker = self.enemy
        self.ss._primary_target = self.caster
        result = self.ss.execute_skill(self.caster, 130095, self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        bsa_buffs = [b for b in self.caster.buffs if b.effect_type == BLOCK_SPECIFIC_AURA]
        self.assertTrue(len(bsa_buffs) > 0)
        self.assertEqual(bsa_buffs[0].block_status_count, 1)

    def test_block_status_count_decrements_on_block(self):
        """状態異常1つ阻止後にcount減少、buff消失"""
        from src.entities_v2.unit_state import BuffState as BS
        # block_specific_auraを手動付与
        bsa = BS(
            buff_id="test_bsa", name="状態異常無効",
            effect_type=BLOCK_SPECIFIC_AURA, value=0,
            duration=-1, timing_type=2,
            block_status_list=["knockout", "poison"],
            block_status_count=1,
            source_unit_id="test", source_skill_id=0, caster_attack=0,
            is_debuff=False,
        )
        self.caster.buffs.append(bsa)

        # knockout auraを付与しようとする
        knockout_aura = BS(
            buff_id="test_ko", name="眩暈",
            effect_type=KNOCKOUT, value=0,
            duration=1, timing_type=2,
            source_unit_id="enemy", source_skill_id=0, caster_attack=0,
            is_debuff=True,
        )
        blocked = self.asvc._is_immune(self.caster, knockout_aura)
        self.assertTrue(blocked, "knockout should be blocked")
        # count減少
        self.assertEqual(bsa.block_status_count, 0)
        # buff消失
        bsa_remaining = [b for b in self.caster.buffs if b.buff_id == "test_bsa"]
        self.assertEqual(len(bsa_remaining), 0, "block_specific_aura should be removed after count reaches 0")

    def test_second_status_not_blocked(self):
        """1つ阻止後は2つ目の状態異常は阻止されない"""
        from src.entities_v2.unit_state import BuffState as BS
        bsa = BS(
            buff_id="test_bsa2", name="状態異常無効",
            effect_type=BLOCK_SPECIFIC_AURA, value=0,
            duration=-1, timing_type=2,
            block_status_list=["knockout", "poison"],
            block_status_count=1,
            source_unit_id="test", source_skill_id=0, caster_attack=0,
            is_debuff=False,
        )
        self.caster.buffs.append(bsa)

        # 1つ目: knockout
        ko1 = BS(
            buff_id="ko1", name="眩暈", effect_type=KNOCKOUT, value=0,
            duration=1, timing_type=2,
            source_unit_id="enemy", source_skill_id=0, caster_attack=0, is_debuff=True,
        )
        blocked1 = self.asvc._is_immune(self.caster, ko1)
        self.assertTrue(blocked1)

        # 2つ目: poison（bsa既に消失）
        poison2 = BS(
            buff_id="poison2", name="毒", effect_type=POISON, value=100,
            duration=3, timing_type=2,
            source_unit_id="enemy", source_skill_id=0, caster_attack=5000, is_debuff=True,
        )
        blocked2 = self.asvc._is_immune(self.caster, poison2)
        self.assertFalse(blocked2, "second status should NOT be blocked (count exhausted)")


class TestPS2RemoveBuff(TestActor107302):
    """PS2 130096 はらぐろさくしー: remove_buff テスト"""

    def test_remove_buff_crit_target_lv15_all(self):
        """Lv15: 全バフ解除（remove_all=true）"""
        self.caster.skill_levels[130096] = 15
        # 敵に3つのbuff付与
        make_buff(self.enemy, "ATKバフ", ATK_UP)
        make_buff(self.enemy, "DEFバフ", DEF_UP)
        make_buff(self.enemy, "SPDバフ", SkillEffectType.STATUS_SPEED.value)

        # _primary_targetを敵に設定（on_critical PSのcrit_target）
        self.ss._primary_target = self.enemy
        result = self.ss.execute_skill(self.caster, 130096, self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 全buff解除
        self.assertEqual(len(self.enemy.buffs), 0, "all removable buffs should be removed at Lv15")

    def test_remove_buff_crit_target_lv10_count(self):
        """Lv10: buff tag値分解除（5個）"""
        self.caster.skill_levels[130096] = 10
        # 敵に6つのbuff付与
        for i in range(6):
            make_buff(self.enemy, f"バフ{i}", ATK_UP)

        self.ss._primary_target = self.enemy
        result = self.ss.execute_skill(self.caster, 130096, self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # Lv10のbuff tag値=5 → 5個解除
        self.assertEqual(len(self.enemy.buffs), 1, "5 buffs should be removed (6-5=1)")

    def test_remove_buff_excludes_memory_buff(self):
        """回憶卡buffは解除されない"""
        self.caster.skill_levels[130096] = 15
        make_buff(self.enemy, "通常バフ", ATK_UP)
        make_buff(self.enemy, "回憶卡バフ", ATK_UP, is_memory_buff=True)

        self.ss._primary_target = self.enemy
        result = self.ss.execute_skill(self.caster, 130096, self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 回憶卡buffは残る
        mem_buffs = [b for b in self.enemy.buffs if b.is_memory_buff]
        self.assertEqual(len(mem_buffs), 1, "memory buff should NOT be removed")

    def test_remove_buff_excludes_unremovable(self):
        """unremovable buffは解除されない"""
        self.caster.skill_levels[130096] = 15
        make_buff(self.enemy, "通常バフ", ATK_UP)
        make_buff(self.enemy, "不可解除バフ", ATK_UP, unremovable=True)

        self.ss._primary_target = self.enemy
        result = self.ss.execute_skill(self.caster, 130096, self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # unremovable buffは残る
        unremovable_buffs = [b for b in self.enemy.buffs if b.unremovable]
        self.assertEqual(len(unremovable_buffs), 1, "unremovable buff should NOT be removed")

    def test_remove_buff_no_target(self):
        """crit_target未設定の場合は何もしない"""
        self.caster.skill_levels[130096] = 15
        make_buff(self.enemy, "バフ", ATK_UP)
        # _primary_targetも_on_crit_targetも未設定
        result = self.ss.execute_skill(self.caster, 130096, self.bf, skip_cost=True)
        # buffは残る
        self.assertEqual(len(self.enemy.buffs), 1, "no target → no buff removed")

    def test_remove_all_flag_in_result(self):
        """remove_all=trueの場合、resultにremove_all=trueが含まれる"""
        self.caster.skill_levels[130096] = 15
        make_buff(self.enemy, "バフ", ATK_UP)
        self.ss._primary_target = self.enemy
        result = self.ss.execute_skill(self.caster, 130096, self.bf, skip_cost=True)
        rb_entry = next((e for e in result.get("effects_applied", [])
                         if e.get("effect_type") == "remove_buff"), None)
        self.assertIsNotNone(rb_entry)
        self.assertTrue(rb_entry.get("remove_all", False))

    def test_remove_count_flag_in_result_lv14(self):
        """Lv14: remove_all=false, count=9"""
        self.caster.skill_levels[130096] = 14
        for i in range(10):
            make_buff(self.enemy, f"バフ{i}", ATK_UP)
        self.ss._primary_target = self.enemy
        result = self.ss.execute_skill(self.caster, 130096, self.bf, skip_cost=True)
        rb_entry = next((e for e in result.get("effects_applied", [])
                         if e.get("effect_type") == "remove_buff"), None)
        self.assertIsNotNone(rb_entry)
        self.assertFalse(rb_entry.get("remove_all", True))
        # Lv14 tag値=9 → 9個解除 → 1個残る
        self.assertEqual(len(self.enemy.buffs), 1)


class TestLowHpHealBonusCalculation(unittest.TestCase):
    """low_hp_heal_bonus の数値計算テスト（単体）"""

    def test_bonus_formula_full_hp(self):
        """満血: bonus_mult = 1.0"""
        max_bonus = 0.5
        hp_ratio = 1.0
        bonus_mult = 1.0 + max_bonus * (1.0 - hp_ratio)
        self.assertAlmostEqual(bonus_mult, 1.0)

    def test_bonus_formula_half_hp(self):
        """半血: bonus_mult = 1.25"""
        max_bonus = 0.5
        hp_ratio = 0.5
        bonus_mult = 1.0 + max_bonus * (1.0 - hp_ratio)
        self.assertAlmostEqual(bonus_mult, 1.25)

    def test_bonus_formula_zero_hp(self):
        """0血: bonus_mult = 1.5 (最大+50%)"""
        max_bonus = 0.5
        hp_ratio = 0.0
        bonus_mult = 1.0 + max_bonus * (1.0 - hp_ratio)
        self.assertAlmostEqual(bonus_mult, 1.5)

    def test_bonus_formula_quarter_hp(self):
        """1/4血: bonus_mult = 1.375"""
        max_bonus = 0.5
        hp_ratio = 0.25
        bonus_mult = 1.0 + max_bonus * (1.0 - hp_ratio)
        self.assertAlmostEqual(bonus_mult, 1.375)


if __name__ == "__main__":
    unittest.main()
