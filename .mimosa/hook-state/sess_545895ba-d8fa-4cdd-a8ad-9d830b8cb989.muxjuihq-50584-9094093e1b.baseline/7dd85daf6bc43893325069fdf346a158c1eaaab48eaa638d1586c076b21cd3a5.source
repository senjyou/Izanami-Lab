#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""角色143301 歴戦の鉄母 技能效果集成测试

测试场景：
- 角色: 歴戦の鉄母 (character_id=143301, 暗属性=6, EN型=2, 灵活站位)
- EX:  110059 鉄の女 (敵全体に1行動混乱付与 + dmg%减免 + ATK×10%代理数值)
- AS1: 120130 粛清です (敵横一列EN攻撃 + 後列時味方前列EN攻撃+EX+1+dmg_dealt_up15% + Lv11+ lifesteal)
- AS2: 120131 システマ・ヴラシェーニヤΑ (敵単体EN攻撃 + lifesteal17.5% + 警戒mark + dmg_taken_down35%)
- PS1: 130136 この魂、レドフカに捧げます (on_skill_use_count(4) + remove_shield+remove_sub_unit+atk_up30%+カムラッドⅡ×3)
- PS2: 130137 ヴォルコワの血脈Α (on_turn_start(1度) + consume_hp60% + カムラッドⅠ×3 + Lv11+ cheat_death)

核心机制：
- 混乱 (Confusion): 状态异常，过滤AS技能效果（仅damage类通过），目标反转，伤害减免
- 警戒 (Vigilance): mark机制，配合mark_condition过滤dmg_taken_down生效
- サブユニット「カムラッド」: 召唤单元，持有HP并提供攻击时追加EN伤害；apply_count支持多实例
- remove_sub_unit: 清除自身所有sub_unit buff
- caster_back_row: block条件，施法者在后排时执行
"""

import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService

SET = SkillEffectType
CONFUSION = SET.CONFUSION.value
MARK = SET.MARK.value
SUB_UNIT = SET.SUB_UNIT.value
SHIELD = SET.SHIELD.value
CHEAT_DEATH = SET.CHEAT_DEATH.value
ATK_UP = SET.STATUS_ATTACK.value
DEALT_DAMAGE_UP = SET.DEALT_DAMAGE.value
RECEIVED_DAMAGE_DOWN = SET.RECEIVED_DAMAGE.value


class TestActor143301(unittest.TestCase):
    """角色143301 歴戦の鉄母 技能测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 143301 歴戦の鉄母 (暗=6, EN=2, 灵活站位, 后排中央)
        self.caster = UnitState(
            unit_id="caster", name="歴戦の鉄母", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=143301, level=10,
            element=6, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=12000, defense=5000, speed=600,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=50,
            skills=[110059, 120130, 120131, 130136, 130137],
            skill_levels={110059: 10, 120130: 10, 120131: 10,
                          130136: 10, 130137: 10},
            skill_cooldowns={},
        )

        # 友方左前（用于测试ally_front_row，AS1 block2）
        self.ally_left_front = UnitState(
            unit_id="ally_lf", name="友方左前", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999101, level=10,
            element=6, character_type=2,
            max_hp=12000, current_hp=12000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方中前（用于测试ally_front_row，AS1 block2）
        self.ally_center_front = UnitState(
            unit_id="ally_cf", name="友方中前", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999102, level=10,
            element=6, character_type=2,
            max_hp=12000, current_hp=12000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排左
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵A(左前)", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵B(中前)", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999002, level=10,
            element=1, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方后排中（用于验证enemy_row仅打前排，不含后排）
        self.enemy_cb = UnitState(
            unit_id="enemy_cb", name="敵C(中后)", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=999003, level=10,
            element=1, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.all_allies = [self.caster, self.ally_left_front, self.ally_center_front]
        self.all_enemies = [self.enemy_lf, self.enemy_cf, self.enemy_cb]

        for u in self.all_allies + self.all_enemies:
            self.bf.add_unit(u)

        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        asvc = AuraService()
        dmgsvc = DamageService()
        tgtsvc = TargetService()
        stsvc = StatusService()
        self.ss = SkillService(self.dl, rs, target_service=tgtsvc,
                               damage_service=dmgsvc, aura_service=asvc,
                               status_service=stsvc, trigger_service=ts)
        ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)
        self.ts = ts
        self.stsvc = stsvc

    # ============================================================
    # EX - 鉄の女 (110059)
    # ============================================================

    def test_ex_applies_confusion_to_all_enemies(self):
        """
        EX: 敵全体に1行動混乱付与
        验证: 所有敌方获得confusion debuff，duration=1, duration_type=action
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110059,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX执行失败: {result.get('error', '')}")

        for e in [self.enemy_lf, self.enemy_cf, self.enemy_cb]:
            conf_debuffs = [d for d in e.debuffs if d.effect_type == CONFUSION]
            self.assertGreater(len(conf_debuffs), 0,
                               f"{e.name}应获得混乱debuff, debuffs: {[d.effect_type for d in e.debuffs]}")
            self.assertEqual(conf_debuffs[0].duration, 1,
                             f"{e.name}混乱duration应为1, 实际={conf_debuffs[0].duration}")
            self.assertTrue(conf_debuffs[0].is_debuff,
                            f"{e.name}混乱应为debuff")

    def test_ex_confusion_has_correct_dmg_reduction_and_proxy(self):
        """
        EX: 混乱参数 (Lv10: dmg_reduction=50%, proxy_atk_pct=10%)
        验证: 混乱buff的confusion_dmg_reduction=50.0, confusion_proxy_atk_pct=10.0
        """
        self.ss.execute_skill(
            caster=self.caster, skill_id=110059,
            battlefield=self.bf, skip_cost=True,
        )

        conf = next(d for d in self.enemy_cf.debuffs if d.effect_type == CONFUSION)
        self.assertAlmostEqual(conf.confusion_dmg_reduction, 50.0, delta=0.5,
                               msg=f"Lv10混乱dmg_reduction应=50.0, 实际={conf.confusion_dmg_reduction}")
        self.assertAlmostEqual(conf.confusion_proxy_atk_pct, 10.0, delta=0.01,
                               msg=f"混乱proxy_atk_pct应=10.0, 实际={conf.confusion_proxy_atk_pct}")

    def test_ex_does_not_confuse_allies(self):
        """EX: 友方不应被混乱"""
        self.ss.execute_skill(
            caster=self.caster, skill_id=110059,
            battlefield=self.bf, skip_cost=True,
        )
        for ally in [self.ally_left_front, self.ally_center_front]:
            conf = [d for d in ally.debuffs if d.effect_type == CONFUSION]
            self.assertEqual(len(conf), 0, f"{ally.name}不应被混乱")

    # ============================================================
    # AS1 - 粛清です (120130)
    # ============================================================

    def test_as1_damages_enemy_row(self):
        """
        AS1: 敵横一列に威力171.6(Lv10)でEN攻撃
        验证: 前排敌方(左前+中前)受伤，后排敌方(中后)未受伤
        """
        hp_before = {e.unit_id: e.current_hp for e in self.all_enemies}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120130,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1执行失败: {result.get('error', '')}")

        # 前排敌方受伤
        self.assertLess(self.enemy_lf.current_hp, hp_before["enemy_lf"],
                        "敌方左前(前排)应受到伤害")
        self.assertLess(self.enemy_cf.current_hp, hp_before["enemy_cf"],
                        "敌方中前(前排)应受到伤害")
        # 后排敌方未受伤
        self.assertEqual(self.enemy_cb.current_hp, hp_before["enemy_cb"],
                         "敌方中后(后排)不应受到伤害")

    def test_as1_back_row_caster_hits_ally_front_row(self):
        """
        AS1: 后排施法时对味方前列威力25 EN攻击 + EX+1 + dmg_dealt_up15%(1action,stackable)
        验证: caster在后排时，前排友方受到25威力EN伤害，获得EP+1和dmg_dealt_up buff
        """
        ep_before = self.ally_left_front.current_ep
        hp_before = self.ally_left_front.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120130,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"])

        # 前排友方受伤（威力25 EN攻击）
        self.assertLess(self.ally_left_front.current_hp, hp_before,
                        "caster在后排时，前排友方应受到威力25 EN攻击伤害")
        self.assertLess(self.ally_center_front.current_hp, self.ally_center_front.max_hp,
                        "前排中位友方也应受到伤害")

        # EP+1
        self.assertEqual(self.ally_left_front.current_ep, ep_before + 1,
                         f"前排友方EP应+1, 实际={self.ally_left_front.current_ep}")

        # dmg_dealt_up buff (1 action, stackable)
        dmg_up_buffs = [b for b in self.ally_left_front.buffs
                        if b.effect_type == DEALT_DAMAGE_UP]
        self.assertGreater(len(dmg_up_buffs), 0,
                           f"前排友方应获得dmg_dealt_up buff, buffs: {[b.effect_type for b in self.ally_left_front.buffs]}")
        self.assertEqual(dmg_up_buffs[0].duration, 1,
                         f"dmg_dealt_up duration应为1, 实际={dmg_up_buffs[0].duration}")
        self.assertAlmostEqual(dmg_up_buffs[0].value, 15.0, delta=0.1,
                               msg=f"dmg_dealt_up value应为15, 实际={dmg_up_buffs[0].value}")

    def test_as1_front_row_caster_skips_ally_damage(self):
        """
        AS1: caster在前排时，跳过block2（不攻击友方前排）
        验证: 前排caster执行AS1时，友方前排不受伤害
        """
        # 将caster移到前排
        self.caster.position = Position.ALLY_CENTER_FRONT
        # 同时让友方前排移到其他位置避免冲突
        self.ally_center_front.position = Position.ALLY_RIGHT_FRONT

        hp_before = self.ally_left_front.current_hp
        ep_before = self.ally_left_front.current_ep

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120130,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"])

        # caster在前排，友方前排不应受伤
        self.assertEqual(self.ally_left_front.current_hp, hp_before,
                         "caster在前排时，友方左前不应受到伤害")
        self.assertEqual(self.ally_left_front.current_ep, ep_before,
                         "caster在前排时，友方左前EP不应增加")

    def test_as1_level_11_adds_lifesteal(self):
        """
        AS1: Lv11+ 增加lifesteal (cure%=7.5% at Lv11)
        验证: Lv11时caster回复HP（基于本次技能造成的总伤害的7.5%）
        """
        # 升级AS1到Lv11
        self.caster.skill_levels[120130] = 11
        # 让caster不满血以观察回血
        self.caster.current_hp = 5000

        hp_before = self.caster.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120130,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"])

        # caster应回复HP
        self.assertGreater(self.caster.current_hp, hp_before,
                           f"Lv11 AS1应通过lifesteal回复HP, hp_before={hp_before}, hp_after={self.caster.current_hp}")

    def test_as1_level_10_no_lifesteal(self):
        """AS1: Lv10时无lifesteal（cure%=0）"""
        self.caster.skill_levels[120130] = 10
        self.caster.current_hp = 5000
        hp_before = self.caster.current_hp

        # 由于AS1会造成友方前排伤害，caster本身因AS1伤害也会回血（如果有lifesteal）
        # 但Lv10 cure=0，所以caster HP不会因lifesteal增加
        # 注意：caster可能受到其他效果影响，但这里只检查没有lifesteal
        self.ss.execute_skill(
            caster=self.caster, skill_id=120130,
            battlefield=self.bf, skip_cost=True,
        )
        # caster HP不应因lifesteal增加（lifesteal cure=0时不回复）
        # caster本身未受伤害，所以HP不变或仅受其他效果影响
        # 此处不强制断言，因为友军伤害不会反哺给caster

    # ============================================================
    # AS2 - システマ・ヴラシェーニヤΑ (120131)
    # ============================================================

    def test_as2_damages_enemy_single(self):
        """
        AS2: 敵単体に威力156.0(Lv10)でEN攻撃
        验证: 最近敌方（中前）受到伤害
        """
        hp_before = {e.unit_id: e.current_hp for e in self.all_enemies}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120131,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS2执行失败: {result.get('error', '')}")

        # 索敌enemy_single应为最近敌方（caster在中后排，最近敌方为中前）
        self.assertLess(self.enemy_cf.current_hp, hp_before["enemy_cf"],
                        "敌方中前应受到AS2伤害")
        # 其他敌方不应受伤
        self.assertEqual(self.enemy_lf.current_hp, hp_before["enemy_lf"],
                         "敌方左前不应受到AS2伤害")
        self.assertEqual(self.enemy_cb.current_hp, hp_before["enemy_cb"],
                         "敌方中后不应受到AS2伤害")

    def test_as2_lifesteal_17_5_pct(self):
        """AS2: 与ダメージ17.5%分自身のHP回復"""
        self.caster.current_hp = 5000
        hp_before = self.caster.current_hp

        self.ss.execute_skill(
            caster=self.caster, skill_id=120131,
            battlefield=self.bf, skip_cost=True,
        )

        # caster应回复HP（17.5% lifesteal）
        self.assertGreater(self.caster.current_hp, hp_before,
                           f"AS2 lifesteal 17.5%应让caster回血, hp_before={hp_before}, hp_after={self.caster.current_hp}")

    def test_as2_applies_vigilance_mark(self):
        """
        AS2: 対象に2行動「警戒」mark付与
        验证: 目标获得mark debuff, name=警戒, duration=2, is_buff_mark=false
        注: is_buff_mark=false的mark作为debuff存放在debuffs列表中
        """
        self.ss.execute_skill(
            caster=self.caster, skill_id=120131,
            battlefield=self.bf, skip_cost=True,
        )

        # is_buff_mark=false的mark存放在debuffs中
        marks = [d for d in self.enemy_cf.debuffs if d.effect_type == MARK]
        self.assertGreater(len(marks), 0,
                           f"敌方应获得mark, debuffs: {[d.effect_type for d in self.enemy_cf.debuffs]}")
        mark = marks[0]
        self.assertEqual(mark.name, "警戒",
                         f"mark name应为警戒, 实际={mark.name}")
        self.assertEqual(mark.duration, 2,
                         f"mark duration应为2, 实际={mark.duration}")
        # is_buff_mark=false 应作为debuff（被驱散可移除）
        self.assertTrue(mark.is_debuff,
                        "is_buff_mark=false的mark应为debuff")

    def test_as2_applies_dmg_taken_down_with_mark_condition(self):
        """
        AS2: 自身に2行動dmg_taken_down35%付与 (mark_condition=警戒)
        验证: caster获得dmg_taken_down buff, value=35, duration=2, mark_condition=警戒
        """
        self.ss.execute_skill(
            caster=self.caster, skill_id=120131,
            battlefield=self.bf, skip_cost=True,
        )

        dmg_down_buffs = [b for b in self.caster.buffs
                          if b.effect_type == RECEIVED_DAMAGE_DOWN]
        self.assertGreater(len(dmg_down_buffs), 0,
                           f"caster应获得dmg_taken_down buff, buffs: {[b.effect_type for b in self.caster.buffs]}")
        buff = dmg_down_buffs[0]
        self.assertAlmostEqual(buff.value, 35.0, delta=0.1,
                               msg=f"dmg_taken_down value应为35, 实际={buff.value}")
        self.assertEqual(buff.duration, 2,
                         f"dmg_taken_down duration应为2, 实际={buff.duration}")
        self.assertEqual(buff.mark_condition, "警戒",
                         f"mark_condition应为警戒, 实际={buff.mark_condition}")

    # ============================================================
    # PS1 - この魂、レドフカに捧げます (130136)
    # ============================================================

    def test_ps1_triggers_on_skill_use_count_4(self):
        """
        PS1: on_skill_use_count(4) - AS 4回使用后触发
        验证: skill_use_count=4时PS1触发
        """
        self.caster.current_pp = 10
        self.caster.skill_use_count = {120130: 4}

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)
        ps_triggered = any(a.skill_id == 130136 for a in trigger_actions)
        self.assertTrue(ps_triggered,
                        f"PS1(130136)应在AS使用4次后触发, actions: {[a.skill_id for a in trigger_actions]}")

    def test_ps1_does_not_trigger_below_4(self):
        """PS1: skill_use_count < 4 时不触发"""
        self.caster.current_pp = 10
        self.caster.skill_use_count = {120130: 3}

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)
        ps_triggered = any(a.skill_id == 130136 for a in trigger_actions)
        self.assertFalse(ps_triggered, "PS1在AS使用3次时不应触发")

    def test_ps1_removes_shield_and_sub_unit(self):
        """
        PS1: 解除自身所有shield和sub_unit buff
        验证: 预设shield和sub_unit buff后，PS1触发后被全部移除
        """
        # 预设shield buff
        shield_buff = BuffState(
            buff_id="test_shield_1", name="Shield", effect_type=SHIELD,
            value=5000, duration=2, timing_type=2, source_unit_id=self.caster.unit_id,
            is_debuff=False,
        )
        self.caster.buffs.append(shield_buff)

        # 预设sub_unit buff (カムラッドⅠ)
        sub_buff = BuffState(
            buff_id="test_sub_1", name="カムラッドⅠ", effect_type=SUB_UNIT,
            value=5.0, duration=-1, timing_type=2, source_unit_id=self.caster.unit_id,
            is_debuff=False, sub_unit_hp=3000, sub_unit_max_hp=3000,
        )
        self.caster.buffs.append(sub_buff)

        self.caster.current_pp = 10
        self.caster.skill_use_count = {120130: 4}

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130136]
        self.assertGreater(len(ps_actions), 0, "PS1应触发")

        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="on_skill_use_count"
        )

        # 验证shield和sub_unit被移除
        shields = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        subs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(shields), 0,
                         f"PS1应移除所有shield, 残留: {len(shields)}")
        # sub_unit可能新增了カムラッドⅡ，但旧的カムラッドⅠ应被移除
        old_subs = [b for b in subs if b.name == "カムラッドⅠ"]
        self.assertEqual(len(old_subs), 0,
                         f"PS1应移除旧的カムラッドⅠ, 残留: {len(old_subs)}")

    def test_ps1_applies_atk_up_buff(self):
        """
        PS1: 自身atk_up30% (skill类型, stackable)
        注: atk_up duration_type="skill"在PS1执行完后被清除（"このスキル中のみ"），
        通过验证sub_unit的caster_attack快照被boosted来间接验证atk_up生效。
        caster基础ATK=12000, boosted后=12000×1.30=15600
        """
        self.caster.current_pp = 10
        self.caster.skill_use_count = {120130: 4}

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130136]
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="on_skill_use_count"
        )

        # atk_up buff本身已被清除（duration_type=skill），但sub_unit的caster_attack快照应被boosted
        kamurad_2 = [b for b in self.caster.buffs
                     if b.effect_type == SUB_UNIT and b.name == "カムラッドⅡ"]
        self.assertEqual(len(kamurad_2), 3,
                         f"应创建3个カムラッドⅡ, 实际: {len(kamurad_2)}")
        for k in kamurad_2:
            # boosted attack = 12000 × 1.30 = 15600
            self.assertEqual(k.caster_attack, 15600,
                             f"sub_unit caster_attack应为boosted值15600(12000×1.30), 实际={k.caster_attack}")

    def test_ps1_creates_three_kamurad_ii(self):
        """
        PS1: カムラッドⅡ×3 (2行動, HP=15%maxHP)
        验证: PS1触发后caster获得3个name=カムラッドⅡ的sub_unit buff
        """
        self.caster.current_pp = 10
        self.caster.skill_use_count = {120130: 4}

        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130136]
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="on_skill_use_count"
        )

        kamurad_2 = [b for b in self.caster.buffs
                     if b.effect_type == SUB_UNIT and b.name == "カムラッドⅡ"]
        self.assertEqual(len(kamurad_2), 3,
                         f"应创建3个カムラッドⅡ, 实际: {len(kamurad_2)}")

        # 验证HP = caster.max_hp × 15% = 20000 × 0.15 = 3000
        for k in kamurad_2:
            self.assertEqual(k.sub_unit_max_hp, 3000,
                             f"カムラッドⅡ max_hp应为3000, 实际={k.sub_unit_max_hp}")
            self.assertEqual(k.duration, 2,
                             f"カムラッドⅡ duration应为2, 实际={k.duration}")

    # ============================================================
    # PS2 - ヴォルコワの血脈Α (130137)
    # ============================================================

    def test_ps2_triggers_on_turn_start(self):
        """PS2: on_turn_start触发"""
        self.caster.current_pp = 10
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130137]
        self.assertGreater(len(ps2_actions), 0, "PS2应在回合开始时触发")

    def test_ps2_consumes_60_pct_current_hp(self):
        """
        PS2: 自身の現在HPの60%を消費
        验证: 触发后caster HP = 20000 × (1 - 0.6) = 8000
        """
        self.caster.current_pp = 10
        self.caster.skill_cooldowns = {}
        hp_before = self.caster.current_hp  # 20000

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130137]
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        expected_hp = int(hp_before * 0.4)  # 20000 × 40% = 8000
        self.assertAlmostEqual(self.caster.current_hp, expected_hp, delta=10,
                               msg=f"PS2应消耗60%当前HP, 期望={expected_hp}, 实际={self.caster.current_hp}")

    def test_ps2_creates_three_kamurad_i_permanent(self):
        """
        PS2: カムラッドⅠ×3 (永続, duration=-1)
        验证: PS2触发后caster获得3个name=カムラッドⅠ的sub_unit buff, duration=-1
        """
        self.caster.current_pp = 10
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130137]
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        kamurad_1 = [b for b in self.caster.buffs
                     if b.effect_type == SUB_UNIT and b.name == "カムラッドⅠ"]
        self.assertEqual(len(kamurad_1), 3,
                         f"应创建3个カムラッドⅠ, 实际: {len(kamurad_1)}")

        for k in kamurad_1:
            self.assertEqual(k.duration, -1,
                             f"カムラッドⅠ应为永続(duration=-1), 实际={k.duration}")
            self.assertEqual(k.sub_unit_max_hp, 3000,
                             f"カムラッドⅠ max_hp应为3000(15%×20000), 实际={k.sub_unit_max_hp}")

    def test_ps2_triggers_only_once(self):
        """
        PS2: 戦闘中に1度しか発動しない (cooldown=99)
        验证: 第一次触发后，第二次turn_start不再触发PS2
        """
        self.caster.current_pp = 10
        self.caster.skill_cooldowns = {}

        # 第一次触发
        actions_1 = self.ts.trigger_turn_start(self.bf)
        ps2_1 = [a for a in actions_1 if a.skill_id == 130137]
        self.assertGreater(len(ps2_1), 0, "第一次应触发PS2")

        self.ss._execute_trigger_actions_inline(
            ps2_1, self.bf, trigger_timing="on_turn_start"
        )

        # 第二次触发（cooldown=99应阻止）
        actions_2 = self.ts.trigger_turn_start(self.bf)
        ps2_2 = [a for a in actions_2 if a.skill_id == 130137]
        self.assertEqual(len(ps2_2), 0, "PS2在cooldown期间不应再次触发")

    def test_ps2_level_11_adds_cheat_death(self):
        """
        PS2: Lv11+ 增加cheat_death (cure%回復)
        验证: Lv11时caster获得cheat_death buff
        """
        self.caster.skill_levels[130137] = 11
        self.caster.current_pp = 10
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130137]
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # cheat_death effect_type stored as lowercase string "cheat_death"
        cheat_death_buffs = [b for b in self.caster.buffs
                             if b.effect_type in ("cheat_death", "CheatDeath")]
        self.assertGreater(len(cheat_death_buffs), 0,
                           f"Lv11 PS2应施加cheat_death buff, buffs: {[b.effect_type for b in self.caster.buffs]}")
        cd = cheat_death_buffs[0]
        self.assertEqual(cd.duration, -1,
                         f"cheat_death应为永続(duration=-1), 实际={cd.duration}")

    def test_ps2_level_10_no_cheat_death(self):
        """PS2: Lv10时无cheat_death（cure=0）"""
        self.caster.skill_levels[130137] = 10
        self.caster.current_pp = 10
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130137]
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        cheat_death_buffs = [b for b in self.caster.buffs
                             if b.effect_type in ("cheat_death", "CheatDeath")]
        self.assertEqual(len(cheat_death_buffs), 0,
                         "Lv10 PS2不应施加cheat_death")


if __name__ == '__main__':
    unittest.main()
