"""Generate skill_effects_hybrid.json entries for S6 鳴雷 (161620553) - 4 skills.
Merges into existing skill_effects_hybrid.json, preserving existing entries.

Skills:
    220365 鳴ノ掃射 (AS) - enemy_row EN damage + dmg_taken_up debuff (1行動, 重複可)
    220366 鳴ノ双弾 (AS) - 2 targets EN damage + dmg_dealt_down debuff (1行動, 重複可)
    230386 鳴ノ硬直 (PS) - after_as_attacked_ally 反撃 add_status (気絶/混乱 by target_has_mark)
    230387 鳴ノ抑制 (PS) - on_turn_start 神鳴りmark + dmg_taken_down buff (mark_condition)

Requires new condition types: target_has_mark, target_without_mark

Usage:
    python scripts/_import_s6_skill_effects_minglei.py
"""
from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HYBRID_JSON = ROOT / "data" / "skill_effects_hybrid.json"
SKILLS_JSON = ROOT / "data" / "skills.json"

EFFECT_TEMPLATE = {
    "effect_type": None,
    "target_type": None,
    "target_identifier": None,
    "value": None,
    "value_tag": None,
    "value_source": None,
    "duration": None,
    "duration_type": None,
    "duration_tag": None,
    "hit_count": None,
    "hit_count_tag": None,
    "condition": None,
    "flags": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
}

SKILL_TEMPLATE = {
    "skill_id": None,
    "name": None,
    "skill_type": None,
    "resource_cost": None,
    "cooldown": None,
    "cooldown_update_timing": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
    "trigger_type": None,
    "global_condition": None,
    "effect_blocks": [],
    "display_target_priority": None,
    "display_target_range": None,
    "display_target_type": None,
    "parse_status": "manual",
    "parse_notes": [],
}


def make_effect(**kwargs) -> dict:
    eff = {k: v for k, v in EFFECT_TEMPLATE.items()}
    for k, v in kwargs.items():
        eff[k] = v
    return eff


def make_block(block_id: int, effects: list, condition=None) -> dict:
    return {"block_id": block_id, "condition": condition, "effects": effects}


def make_skill(**kwargs) -> dict:
    skill = {k: v for k, v in SKILL_TEMPLATE.items()}
    for k, v in kwargs.items():
        if k in skill:
            skill[k] = v
        else:
            skill[k] = v
    return skill


def load_skills_meta() -> dict[int, dict]:
    with SKILLS_JSON.open("r", encoding="utf-8") as fh:
        data = json.load(fh)
    out: dict[int, dict] = {}
    for k, v in data.items():
        try:
            sid = int(k)
        except (TypeError, ValueError):
            continue
        out[sid] = v
    return out


def build_minglei(skills_meta: dict[int, dict]) -> dict[str, dict]:
    out: dict[str, dict] = {}

    # 220365 鳴ノ掃射 (AS) - enemy_row EN + dmg_taken_up 3.15% (1行動, 重複可)
    meta = skills_meta[220365]
    out["220365"] = make_skill(
        skill_id=220365,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_row",
                    value_tag="威力",
                    hit_count=1,
                    flags={"is_en_attack": True},
                ),
                make_effect(
                    effect_type="dmg_taken_up",
                    target_type="enemy_row",
                    value=3.15,
                    duration=1,
                    duration_type="action",
                    flags={"value_type": "percent", "stackable": True},
                ),
            ]),
        ],
        display_target_range=6,
        display_target_type=3,
        parse_notes=["AS: 横一列EN + 被ダメ+3.15% (1行動, 重複可)"],
    )

    # 220366 鳴ノ双弾 (AS) - 2 targets EN + dmg_dealt_down 15% (1行動, 重複可)
    meta = skills_meta[220366]
    out["220366"] = make_skill(
        skill_id=220366,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_single",
                    value_tag="威力",
                    hit_count=1,
                    flags={"target_count": 2, "is_en_attack": True},
                ),
                make_effect(
                    effect_type="dmg_dealt_down",
                    target_type="enemy_single",
                    value=15.0,
                    duration=1,
                    duration_type="action",
                    flags={"value_type": "percent", "stackable": True, "target_count": 2},
                ),
            ]),
        ],
        display_target_range=2,
        display_target_type=3,
        parse_notes=["AS: 敵2体EN + 与ダメ-15% (1行動, 重複可)"],
    )

    # 230386 鳴ノ硬直 (PS) - after_as_attacked_ally + 気絶/混乱 (分歧 by target_has_mark)
    meta = skills_meta[230386]
    out["230386"] = make_skill(
        skill_id=230386,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type="after_as_attacked_ally",
        effect_blocks=[
            # Block 1: 未所持神鳴り → 気絶
            make_block(1, [
                make_effect(
                    effect_type="add_status",
                    target_type="enemy_single",
                    target_identifier="trigger_attacker",
                    value=1,
                    duration=1,
                    duration_type="action",
                    flags={"status_type": "stun"},
                ),
            ], condition={"type": "target_without_mark", "mark_name": "神鳴り"}),
            # Block 2: 所持神鳴り → 混乱
            make_block(2, [
                make_effect(
                    effect_type="add_status",
                    target_type="enemy_single",
                    target_identifier="trigger_attacker",
                    duration=1,
                    duration_type="action",
                    flags={
                        "status_type": "confusion",
                        "confusion_dmg_reduction_tag": "dmg",
                        "confusion_proxy_atk_pct": 10.0,
                    },
                ),
            ], condition={"type": "target_has_mark", "mark_name": "神鳴り"}),
        ],
        display_target_range=1,
        display_target_type=3,
        parse_notes=["PS: 被AS反撃 気絶(未所持神鳴り)/混乱(所持) 分歧"],
    )

    # 230387 鳴ノ抑制 (PS) - on_turn_start 神鳴りmark + dmg_taken_down buff (mark_condition)
    meta = skills_meta[230387]
    out["230387"] = make_skill(
        skill_id=230387,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type="on_turn_start",
        global_condition={"type": "round_number", "operator": ">", "value": 1},
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="mark",
                    target_type="enemy_single",
                    value=1,
                    duration=-1,
                    duration_type=None,
                    flags={"mark_name": "神鳴り", "priority_no_mark": True},
                ),
                make_effect(
                    effect_type="dmg_taken_down",
                    target_type="ally_front",
                    value=30.0,
                    duration=-1,
                    duration_type=None,
                    flags={"value_type": "percent", "mark_condition": "神鳴り"},
                ),
            ]),
        ],
        display_target_range=6,
        display_target_type=2,
        parse_notes=["PS: ターン開始 敵1体に神鳴りmark + 味方前衛dmg-30% (神鳴り所持相手から)"],
    )

    return out


def main() -> None:
    skills_meta = load_skills_meta()
    new_entries = build_minglei(skills_meta)
    print(f"[INFO] Built {len(new_entries)} 鳴雷 skill entries")

    with HYBRID_JSON.open("r", encoding="utf-8") as fh:
        hybrid = json.load(fh)
    print(f"[INFO] Loaded {len(hybrid)} existing skill_effects_hybrid.json entries")

    added: list[int] = []
    skipped: list[int] = []
    for sid_str, entry in new_entries.items():
        if sid_str in hybrid:
            skipped.append(int(sid_str))
            continue
        hybrid[sid_str] = entry
        added.append(int(sid_str))

    print(f"[INFO] Added: {added}")
    if skipped:
        print(f"[INFO] Skipped (already present): {skipped}")

    with HYBRID_JSON.open("w", encoding="utf-8") as fh:
        json.dump(hybrid, fh, ensure_ascii=False, indent=2)
    print(f"[OK] Wrote {HYBRID_JSON}")


if __name__ == "__main__":
    main()
