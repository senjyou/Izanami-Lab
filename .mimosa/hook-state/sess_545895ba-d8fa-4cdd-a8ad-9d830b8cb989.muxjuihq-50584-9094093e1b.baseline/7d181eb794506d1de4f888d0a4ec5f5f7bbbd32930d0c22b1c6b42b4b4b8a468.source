#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""角色123201 毒舌メイド娘 技能效果集成测试

测试场景：
- 角色: 毒舌メイド娘 (character_id=123201, 土属性=4, EN型=2, 控制型=5, 灵活站位)
- AS1: 120008 アシッドカノン (HP最高敌方单体EN攻击 + 2行动毒)
- AS2: 120031 パージショット (敌方单体EN攻击 + 永续def_down)
- PS:  130017 アーマーブレイク (on_turn_end触发 + HP最高敌方def_down + HP比例缩放 + 可叠加)

核心机制：
- HP比例最高敌方索敌 (enemy_single_highest_hp_ratio)
- 标准毒机制 (默认10%当前HP伤害)
- HP比例缩放降防 (scale_by_target_hp_ratio)
"""

import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService

SET = SkillEffectType
STATUS_DEFENSE = SET.STATUS_DEFENSE.value
POISON = SET.POISON.value


class TestActor123201(unittest.TestCase):
    """角色123201 毒舌メイド娘 技能测试"""

    def setUp(self):
        self.dl = DataLoader()
        self.dl.load_all()
        self.bf = BattlefieldState()

        # 毒舌メイド娘 (EN/控制/灵活)
        self.caster = UnitState(
            unit_id='ally_maid', name='毒舌メイド娘', side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=123201, level=10,
            element=4, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=12000, defense=5000, speed=600,
            crit_rate=0.05, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=1, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=50,
            skills=[120008, 120031, 130017],
            skill_levels={120008: 10, 120031: 10, 130017: 10},
            skill_cooldowns={},
        )

        # 敌方A: HP比例最高 (满血)
        self.enemy_full_hp = UnitState(
            unit_id='enemy_full_hp', name='enemy(FullHP)', side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=100000, current_hp=100000,
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方B: HP比例中等 (50%)
        self.enemy_half_hp = UnitState(
            unit_id='enemy_half_hp', name='enemy(HalfHP)', side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999002, level=10,
            element=1, character_type=1,
            max_hp=80000, current_hp=40000,  # 50%
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方C: HP比例最低 (25%)
        self.enemy_low_hp = UnitState(
            unit_id='enemy_low_hp', name='enemy(LowHP)', side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999003, level=10,
            element=1, character_type=1,
            max_hp=80000, current_hp=20000,  # 25%
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.all_enemies = [self.enemy_full_hp, self.enemy_half_hp, self.enemy_low_hp]

        self.bf.add_unit(self.caster)
        for e in self.all_enemies:
            self.bf.add_unit(e)

        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        asvc = AuraService()
        dmgsvc = DamageService()
        tgtsvc = TargetService()
        stsvc = StatusService()
        self.ss = SkillService(self.dl, rs, target_service=tgtsvc,
                               damage_service=dmgsvc, aura_service=asvc,
                               status_service=stsvc, trigger_service=ts)
        ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)
        self.ts = ts
        self.stsvc = stsvc

    # ============================================================
    # AS1 - アシッドカノン (120008)
    # ============================================================

    def test_as1_targets_highest_hp_ratio_enemy(self):
        """
        AS1: 索敌HP比例最高的敌方
        验证: 3个敌方HP比例不同(100%/50%/25%)时，攻击命中HP比例最高的enemy_full_hp
        """
        hp_before = {e.unit_id: e.current_hp for e in self.all_enemies}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120008,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1执行失败: {result.get('error', '')}")

        # 验证enemy_full_hp受到伤害（HP比例最高），其他敌方未受伤
        self.assertLess(self.enemy_full_hp.current_hp, hp_before['enemy_full_hp'],
                        "HP比例最高的enemy_full_hp应受到伤害")
        self.assertEqual(self.enemy_half_hp.current_hp, hp_before['enemy_half_hp'],
                         "enemy_half_hp不应受到伤害")
        self.assertEqual(self.enemy_low_hp.current_hp, hp_before['enemy_low_hp'],
                         "enemy_low_hp不应受到伤害")

    def test_as1_applies_poison(self):
        """
        AS1: 赋予2行动毒
        验证: 目标被赋予毒debuff，duration=2, duration_type=action
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120008,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"])

        poison_debuffs = [d for d in self.enemy_full_hp.debuffs if d.effect_type == POISON]
        self.assertTrue(len(poison_debuffs) > 0,
                        f"应附加毒debuff, debuffs: {[d.name for d in self.enemy_full_hp.debuffs]}")
        self.assertEqual(poison_debuffs[0].duration, 2,
                         f"毒duration应为2, 实际={poison_debuffs[0].duration}")

    def test_as1_poison_damage_is_10pct_current_hp(self):
        """
        AS1: 毒伤害为10%当前HP
        验证: 毒结算时，伤害=当前HP×10%
        """
        # 先用AS1施加毒
        self.ss.execute_skill(
            caster=self.caster, skill_id=120008,
            battlefield=self.bf, skip_cost=True,
        )

        # 记录毒结算前的HP
        hp_before_poison = self.enemy_full_hp.current_hp
        expected_damage = int(hp_before_poison * 0.1)

        # 手动结算毒伤害
        total_damage, calc_detail = self.stsvc.apply_poison_damage(self.enemy_full_hp)

        # 验证毒伤害 ≈ 10%当前HP（允许int取整误差）
        self.assertGreater(total_damage, 0, "毒伤害应大于0")
        self.assertAlmostEqual(total_damage, expected_damage, delta=1,
                               msg=f"毒伤害应为10%当前HP={expected_damage}, 实际={total_damage}")

    # ============================================================
    # AS2 - パージショット (120031)
    # ============================================================

    def test_as2_applies_permanent_def_down(self):
        """
        AS2: 永续def_down
        验证: 目标被赋予def_down debuff，duration=-1（永续）
        """
        # AS2索敌为enemy_single（最近敌方），目标为enemy_full_hp（CENTER_FRONT最近）
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120031,
            battlefield=self.bf, skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS2执行失败: {result.get('error', '')}")

        # 找到有def_down的敌方
        enemies_with_def_down = [
            e for e in self.all_enemies
            if any(d.effect_type == STATUS_DEFENSE and d.is_debuff for d in e.debuffs)
        ]
        self.assertTrue(len(enemies_with_def_down) > 0,
                        f"应有敌方获得def_down, 实际: {[(e.name, [d.effect_type for d in e.debuffs]) for e in self.all_enemies]}")

        # 验证duration=-1（永续）
        def_down_debuff = next(
            d for e in enemies_with_def_down
            for d in e.debuffs
            if d.effect_type == STATUS_DEFENSE and d.is_debuff
        )
        self.assertEqual(def_down_debuff.duration, -1,
                         f"def_down应为永续(duration=-1), 实际={def_down_debuff.duration}")

    # ============================================================
    # PS - アーマーブレイク (130017)
    # ============================================================

    def test_ps_triggers_on_turn_end(self):
        """
        PS: on_turn_end触发
        验证: 调用trigger_turn_end后，PS(130017)被触发
        """
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}

        trigger_actions = self.ts.trigger_turn_end(self.bf)
        ps_triggered = any(a.skill_id == 130017 for a in trigger_actions)
        self.assertTrue(ps_triggered,
                        f"PS(130017)应在回合结束时触发, actions: {[a.skill_id for a in trigger_actions]}")

    def test_ps_targets_highest_hp_ratio_enemy(self):
        """
        PS: 索敌HP比例最高的敌方
        验证: 3个敌方HP比例不同时，PS对HP比例最高的enemy_full_hp施加def_down
        """
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}

        trigger_actions = self.ts.trigger_turn_end(self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130017]
        self.assertTrue(len(ps_actions) > 0, "PS应触发")

        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 验证enemy_full_hp(HP比例最高)有def_down，其他敌方没有
        full_hp_def_down = [d for d in self.enemy_full_hp.debuffs
                            if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        half_hp_def_down = [d for d in self.enemy_half_hp.debuffs
                            if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        low_hp_def_down = [d for d in self.enemy_low_hp.debuffs
                           if d.effect_type == STATUS_DEFENSE and d.is_debuff]

        self.assertTrue(len(full_hp_def_down) > 0,
                        "HP比例最高的enemy_full_hp应获得def_down")
        self.assertEqual(len(half_hp_def_down), 0, "enemy_half_hp不应获得def_down")
        self.assertEqual(len(low_hp_def_down), 0, "enemy_low_hp不应获得def_down")

    def test_ps_def_down_scales_by_target_hp_ratio(self):
        """
        PS: def_down值随目标当前HP比例线性缩放
        公式: final_value = base_value × (current_hp / max_hp)
        验证: 满血目标(100%)的def_down值 > 半血目标(50%)的def_down值
        """
        # 场景1: 目标满血时施加PS
        self.caster.current_pp = 4  # 足够2次PS
        self.caster.skill_cooldowns = {}

        # 先对满血目标施加PS
        trigger_actions_1 = self.ts.trigger_turn_end(self.bf)
        ps_actions_1 = [a for a in trigger_actions_1 if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions_1, self.bf, trigger_timing="on_turn_end"
        )

        # 取满血目标的def_down值
        full_hp_def_downs = [d for d in self.enemy_full_hp.debuffs
                             if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertTrue(len(full_hp_def_downs) > 0, "满血目标应有def_down")
        value_at_full_hp = full_hp_def_downs[0].value

        # 清除满血目标的def_down，便于第二次测试
        self.enemy_full_hp.debuffs = [d for d in self.enemy_full_hp.debuffs
                                      if not (d.effect_type == STATUS_DEFENSE and d.is_debuff)]

        # 场景2: 将目标HP降到50%，再施加PS
        self.enemy_full_hp.current_hp = self.enemy_full_hp.max_hp // 2  # 50% HP
        self.caster.current_pp = 4
        self.caster.skill_cooldowns = {}

        trigger_actions_2 = self.ts.trigger_turn_end(self.bf)
        ps_actions_2 = [a for a in trigger_actions_2 if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions_2, self.bf, trigger_timing="on_turn_end"
        )

        half_hp_def_downs = [d for d in self.enemy_full_hp.debuffs
                             if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertTrue(len(half_hp_def_downs) > 0, "半血目标应有def_down")
        value_at_half_hp = half_hp_def_downs[0].value

        # 满血时的值应约为半血时的2倍
        self.assertAlmostEqual(value_at_full_hp, value_at_half_hp * 2, delta=value_at_half_hp * 0.1,
                               msg=f"满血时def_down值({value_at_full_hp})应约为半血时({value_at_half_hp})的2倍")

    def test_ps_stackable(self):
        """
        PS: def_down可叠加
        验证: 连续触发2次PS后，目标def_down数量增加
        """
        self.caster.current_pp = 4
        self.caster.skill_cooldowns = {}

        # 第一次触发PS
        trigger_actions_1 = self.ts.trigger_turn_end(self.bf)
        ps_actions_1 = [a for a in trigger_actions_1 if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions_1, self.bf, trigger_timing="on_turn_end"
        )
        count1 = len([d for d in self.enemy_full_hp.debuffs
                      if d.effect_type == STATUS_DEFENSE and d.is_debuff])

        # 第二次触发PS
        self.caster.skill_cooldowns = {}
        trigger_actions_2 = self.ts.trigger_turn_end(self.bf)
        ps_actions_2 = [a for a in trigger_actions_2 if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions_2, self.bf, trigger_timing="on_turn_end"
        )
        count2 = len([d for d in self.enemy_full_hp.debuffs
                      if d.effect_type == STATUS_DEFENSE and d.is_debuff])

        self.assertGreater(count2, count1,
                           f"PS def_down应可叠加, count1={count1} count2={count2}")

    # ============================================================
    # 补充测试 - PS(130017) scale_by_target_hp_ratio 缩放曲线
    # ============================================================

    def test_ps_scale_curve_full_half_low_hp(self):
        """
        PS: def_down值随目标当前HP比例线性缩放（3点曲线）
        公式: final_value = base_value(30) × (current_hp / max_hp)
        验证: HP=100% → 30, HP=50% → 15, HP=10% → 3
        HP比例越高，def_down数值越大（描述：「対象のHPが多いほど高い効果を発揮する」）
        """
        # 单敌方场景：避免HP比例变化导致索敌切换
        bf = BattlefieldState()
        bf.add_unit(self.caster)

        single_enemy = UnitState(
            unit_id='single_enemy', name='single_enemy', side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999010, level=10,
            element=1, character_type=1,
            max_hp=100000, current_hp=100000,
            attack=5000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        bf.add_unit(single_enemy)

        test_cases = [
            (1.0, 30.0),   # HP=100% → 30
            (0.5, 15.0),   # HP=50% → 15
            (0.1, 3.0),    # HP=10% → 3
        ]

        for hp_ratio, expected_value in test_cases:
            # 清除上一轮的def_down
            single_enemy.debuffs = []
            single_enemy.current_hp = int(single_enemy.max_hp * hp_ratio)

            # 重置PP和冷却
            self.caster.current_pp = 2
            self.caster.skill_cooldowns = {}

            trigger_actions = self.ts.trigger_turn_end(bf)
            ps_actions = [a for a in trigger_actions if a.skill_id == 130017]
            self.ss._execute_trigger_actions_inline(
                ps_actions, bf, trigger_timing="on_turn_end"
            )

            def_downs = [d for d in single_enemy.debuffs
                         if d.effect_type == STATUS_DEFENSE and d.is_debuff]
            self.assertTrue(len(def_downs) > 0,
                            f"HP={hp_ratio*100}%时应有def_down")
            actual_value = def_downs[0].value
            self.assertAlmostEqual(actual_value, expected_value, delta=0.5,
                                   msg=f"HP={hp_ratio*100}%时def_down值应为{expected_value}, 实际={actual_value}")

    # ============================================================
    # 补充测试 - PS(130017) stackable 叠加 buff_id 不同
    # ============================================================

    def test_ps_stackable_different_buff_ids(self):
        """
        PS: stackable=true 的def_down叠加时使用不同buff_id
        验证: 连续2回合触发PS，目标获得2个独立def_down，buff_id不同，is_stackable=True
        """
        self.caster.current_pp = 4
        self.caster.skill_cooldowns = {}

        # 第一次触发PS
        trigger_actions_1 = self.ts.trigger_turn_end(self.bf)
        ps_actions_1 = [a for a in trigger_actions_1 if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions_1, self.bf, trigger_timing="on_turn_end"
        )

        # 第二次触发PS
        self.caster.skill_cooldowns = {}
        trigger_actions_2 = self.ts.trigger_turn_end(self.bf)
        ps_actions_2 = [a for a in trigger_actions_2 if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions_2, self.bf, trigger_timing="on_turn_end"
        )

        # 验证有2个def_down，且buff_id不同
        def_downs = [d for d in self.enemy_full_hp.debuffs
                     if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertEqual(len(def_downs), 2,
                         f"应有2个独立def_down, 实际: {len(def_downs)}")
        buff_ids = [d.buff_id for d in def_downs]
        self.assertNotEqual(buff_ids[0], buff_ids[1],
                            f"2个def_down应有不同buff_id, 实际: {buff_ids}")
        # 验证is_stackable=True
        for d in def_downs:
            self.assertTrue(getattr(d, 'is_stackable', False),
                            f"def_down应is_stackable=True, buff_id={d.buff_id}")

    # ============================================================
    # 补充测试 - AS1(120008) poison 不受def_down影响
    # ============================================================

    def test_as1_poison_not_affected_by_def_down(self):
        """
        AS1: poison伤害不受def_down影响
        原因: poison是status ailment，伤害公式=当前HP×10%（capped by caster_attack），
              不经过DamageService.calculate_damage，因此def_down（降低DEF）不生效
        验证: 施加def_down后，poison伤害仍=当前HP×10%（与无def_down时公式一致）
        """
        # 施加AS1 poison
        self.ss.execute_skill(
            caster=self.caster, skill_id=120008,
            battlefield=self.bf, skip_cost=True,
        )

        # 验证poison已施加
        poison_debuffs = [d for d in self.enemy_full_hp.debuffs if d.effect_type == POISON]
        self.assertTrue(len(poison_debuffs) > 0, "应已施加poison")

        # 手动施加50% def_down（不造成伤害，仅验证def_down对poison公式无影响）
        test_def_down = BuffState(
            buff_id="test_def_down_for_poison_test",
            name=STATUS_DEFENSE,
            effect_type=STATUS_DEFENSE,
            value=50.0,  # 强力50% def_down
            duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=self.caster.unit_id,
            source_skill_id=120031,
            is_debuff=True,
        )
        self.enemy_full_hp.debuffs.append(test_def_down)

        # 计算预期poison伤害 = 当前HP × 10%
        hp_before_tick = self.enemy_full_hp.current_hp
        expected_damage = int(hp_before_tick * 0.1)

        # 触发poison tick
        actual_damage, _ = self.stsvc.apply_poison_damage(self.enemy_full_hp)

        # 验证poison伤害=10%当前HP，未受def_down影响
        self.assertAlmostEqual(actual_damage, expected_damage, delta=1,
                               msg=f"poison伤害应不受def_down影响: 预期={expected_damage}(10%HP={hp_before_tick}), 实际={actual_damage}")

    # ============================================================
    # 补充测试 - AS2(120031) def_down永续跨回合
    # ============================================================

    def test_as2_def_down_permanent_across_rounds(self):
        """
        AS2: def_down duration=-1（永续），跨多个回合后仍生效
        验证: 施加def_down后，调用多次process_maneuver_end+check_expiration，def_down仍存在且duration=-1
        """
        self.ss.execute_skill(
            caster=self.caster, skill_id=120031,
            battlefield=self.bf, skip_cost=True,
        )

        # 验证def_down已施加
        def_downs = [d for d in self.enemy_full_hp.debuffs
                     if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertEqual(len(def_downs), 1, "应已施加1个def_down")
        self.assertEqual(def_downs[0].duration, -1,
                         f"def_down应duration=-1(永续), 实际={def_downs[0].duration}")

        # 清除just_applied（模拟当次行动结束后进入下一行动）
        for d in self.enemy_full_hp.debuffs:
            d.just_applied = False

        # 模拟3次行动结束 + 过期清理
        for _ in range(3):
            self.ss.aura_service.process_maneuver_end(self.enemy_full_hp)
            self.ss.aura_service.check_expiration(self.enemy_full_hp)

        # 验证def_down仍存在且duration=-1
        def_downs_after = [d for d in self.enemy_full_hp.debuffs
                           if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertEqual(len(def_downs_after), 1,
                         f"3次行动后def_down应仍存在, 实际数量: {len(def_downs_after)}")
        self.assertEqual(def_downs_after[0].duration, -1,
                         f"3次行动后def_down应仍duration=-1, 实际={def_downs_after[0].duration}")

    def test_as2_def_down_value_type_percent(self):
        """
        AS2: def_down的value_type=percent
        验证: value_tag=0 (0=百分比, 1=固定值), value=30.0 (level 10 def tag)
        """
        self.ss.execute_skill(
            caster=self.caster, skill_id=120031,
            battlefield=self.bf, skip_cost=True,
        )

        def_downs = [d for d in self.enemy_full_hp.debuffs
                     if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertTrue(len(def_downs) > 0, "应已施加def_down")

        # value_tag=0 表示百分比, value_tag=1 表示固定值
        self.assertEqual(def_downs[0].value_tag, 0,
                         f"def_down value_tag应为0(percent), 实际={def_downs[0].value_tag}")
        # level 10 def值 = 30.0
        self.assertAlmostEqual(def_downs[0].value, 30.0, delta=0.5,
                               msg=f"def_down value应为30.0(level 10), 实际={def_downs[0].value}")

    # ============================================================
    # 补充测试 - PS与AS1索敌一致性
    # ============================================================

    def test_ps_as1_targeting_consistency(self):
        """
        PS和AS1都使用enemy_single_highest_hp_ratio索敌
        验证: 两者指向同一目标(enemy_full_hp, HP比例最高)
        """
        # AS1索敌: 应命中enemy_full_hp
        hp_before_as1 = {e.unit_id: e.current_hp for e in self.all_enemies}
        self.ss.execute_skill(
            caster=self.caster, skill_id=120008,
            battlefield=self.bf, skip_cost=True,
        )
        as1_damaged = [e.unit_id for e in self.all_enemies
                       if e.current_hp < hp_before_as1[e.unit_id]]
        self.assertEqual(len(as1_damaged), 1,
                         f"AS1应只伤害1个目标, 实际: {as1_damaged}")
        self.assertEqual(as1_damaged[0], 'enemy_full_hp',
                         f"AS1应指向enemy_full_hp(HP比例最高), 实际: {as1_damaged[0]}")

        # PS索敌: 应也指向enemy_full_hp
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}
        trigger_actions = self.ts.trigger_turn_end(self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 验证PS施加的def_down在enemy_full_hp上（不在其他敌方上）
        full_hp_has_def_down = any(d.effect_type == STATUS_DEFENSE and d.is_debuff
                                   for d in self.enemy_full_hp.debuffs)
        half_hp_has_def_down = any(d.effect_type == STATUS_DEFENSE and d.is_debuff
                                   for d in self.enemy_half_hp.debuffs)
        low_hp_has_def_down = any(d.effect_type == STATUS_DEFENSE and d.is_debuff
                                  for d in self.enemy_low_hp.debuffs)
        self.assertTrue(full_hp_has_def_down, "PS应向enemy_full_hp施加def_down")
        self.assertFalse(half_hp_has_def_down, "PS不应向enemy_half_hp施加def_down")
        self.assertFalse(low_hp_has_def_down, "PS不应向enemy_low_hp施加def_down")

    def test_ps_retargets_when_highest_hp_ratio_changes(self):
        """
        PS: 当最高HP比例敌方变更时，PS索敌切换
        验证: 初始PS指向enemy_full_hp(100%)，将enemy_full_hp打到10%后，PS改指向enemy_half_hp(50%)
        """
        # 第一次触发PS: 应指向enemy_full_hp (100%)
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}
        trigger_actions_1 = self.ts.trigger_turn_end(self.bf)
        ps_actions_1 = [a for a in trigger_actions_1 if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions_1, self.bf, trigger_timing="on_turn_end"
        )

        full_hp_def_downs_1 = [d for d in self.enemy_full_hp.debuffs
                               if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertTrue(len(full_hp_def_downs_1) > 0, "第一次PS应指向enemy_full_hp")

        # 改变HP比例: 将enemy_full_hp打到10%
        self.enemy_full_hp.current_hp = int(self.enemy_full_hp.max_hp * 0.1)  # 10%
        # 清除enemy_full_hp的def_down，避免干扰第二次判断
        self.enemy_full_hp.debuffs = [d for d in self.enemy_full_hp.debuffs
                                      if not (d.effect_type == STATUS_DEFENSE and d.is_debuff)]

        # 第二次触发PS: 此时enemy_half_hp(50%) > enemy_low_hp(25%) > enemy_full_hp(10%)
        # PS应改指向enemy_half_hp
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}
        trigger_actions_2 = self.ts.trigger_turn_end(self.bf)
        ps_actions_2 = [a for a in trigger_actions_2 if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions_2, self.bf, trigger_timing="on_turn_end"
        )

        half_hp_def_downs = [d for d in self.enemy_half_hp.debuffs
                             if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertTrue(len(half_hp_def_downs) > 0,
                        "第二次PS应改指向enemy_half_hp (现在HP比例最高50%)")
        full_hp_def_downs_2 = [d for d in self.enemy_full_hp.debuffs
                               if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertEqual(len(full_hp_def_downs_2), 0,
                         "第二次PS不应再指向enemy_full_hp (HP已降到10%)")

    # ============================================================
    # 补充测试 - AS1 poison的current_hp计算（动态HP，非快照）
    # ============================================================

    def test_as1_poison_damage_decreases_each_tick(self):
        """
        AS1: poison伤害=当前HP×10%，随HP减少而减少（动态计算，非快照）
        验证: 第1次poison tick伤害 > 第2次poison tick伤害（因HP下降）
        """
        self.ss.execute_skill(
            caster=self.caster, skill_id=120008,
            battlefield=self.bf, skip_cost=True,
        )

        # 第1次tick
        hp_before_tick_1 = self.enemy_full_hp.current_hp
        expected_damage_1 = int(hp_before_tick_1 * 0.1)
        damage_1, _ = self.stsvc.apply_poison_damage(self.enemy_full_hp)

        # 验证第1次伤害=10%当时HP
        self.assertAlmostEqual(damage_1, expected_damage_1, delta=1,
                               msg=f"第1次tick: 预期={expected_damage_1}(10% of HP={hp_before_tick_1}), 实际={damage_1}")

        # 第2次tick (HP已因第1次tick而下降)
        hp_before_tick_2 = self.enemy_full_hp.current_hp
        expected_damage_2 = int(hp_before_tick_2 * 0.1)
        damage_2, _ = self.stsvc.apply_poison_damage(self.enemy_full_hp)

        # 验证第2次伤害=10%当时HP
        self.assertAlmostEqual(damage_2, expected_damage_2, delta=1,
                               msg=f"第2次tick: 预期={expected_damage_2}(10% of HP={hp_before_tick_2}), 实际={damage_2}")

        # 验证第1次伤害 > 第2次伤害（因HP从tick_1下降到tick_2）
        self.assertGreater(damage_1, damage_2,
                           f"第1次tick伤害({damage_1})应大于第2次({damage_2}), 因HP从{hp_before_tick_1}降至{hp_before_tick_2}")

    # ============================================================
    # 补充测试 - PS持续时间边界
    # ============================================================

    def test_ps_duration_expires_after_target_action(self):
        """
        PS: def_down duration=1 action, 目标行动后消失
        验证: 施加PS def_down后，模拟目标行动结束(just_applied清空+process_maneuver_end+check_expiration)，
              def_down被递减到0并移除
        """
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}
        trigger_actions = self.ts.trigger_turn_end(self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 验证def_down已施加
        def_downs = [d for d in self.enemy_full_hp.debuffs
                     if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertEqual(len(def_downs), 1, "应已施加1个def_down")
        self.assertEqual(def_downs[0].duration, 1,
                         f"duration应为1, 实际={def_downs[0].duration}")

        # 清除just_applied（模拟当次行动结束后的下一行动）
        for d in self.enemy_full_hp.debuffs:
            d.just_applied = False

        # 模拟目标行动结束（递减duration）+ 清理过期buff（duration=0的buff被移除）
        self.ss.aura_service.process_maneuver_end(self.enemy_full_hp)
        self.ss.aura_service.check_expiration(self.enemy_full_hp)

        # 验证def_down已消失
        def_downs_after = [d for d in self.enemy_full_hp.debuffs
                           if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertEqual(len(def_downs_after), 0,
                         f"目标行动结束后def_down应消失, 实际剩余: {len(def_downs_after)}")

    def test_ps_duration_persists_without_target_action(self):
        """
        PS: def_down duration=1 action, 目标未行动时保留
        验证: 施加PS def_down后，不调用process_maneuver_end时，def_down仍存在
        """
        self.caster.current_pp = 2
        self.caster.skill_cooldowns = {}
        trigger_actions = self.ts.trigger_turn_end(self.bf)
        ps_actions = [a for a in trigger_actions if a.skill_id == 130017]
        self.ss._execute_trigger_actions_inline(
            ps_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 不模拟目标行动结束，直接验证def_down存在
        def_downs = [d for d in self.enemy_full_hp.debuffs
                     if d.effect_type == STATUS_DEFENSE and d.is_debuff]
        self.assertEqual(len(def_downs), 1, "目标未行动时def_down应保留")
        self.assertEqual(def_downs[0].duration, 1,
                         f"duration应仍为1, 实际={def_downs[0].duration}")


if __name__ == '__main__':
    unittest.main()
