"""Regression: on_crit block (modify_pp) must survive inline PS execution.

Bug: When an enemy caster uses skill 220369 (紫影の斬撃, on_crit -> modify_pp),
     and an ally has 130009 (アイギスランパード, before_any_attacked PS), the
     inline execute_skill call for 130009 cleared the outer skill's
     _on_crit_blocks / _deferred_on_crit_targets (reset at execute_skill entry).
     After the inline PS returned, those lists were empty, so the crit hit
     no longer appended to _deferred_on_crit_targets, and modify_pp never fired.

Fix: _execute_trigger_actions_inline now saves/restores all on_crit-related
     state around the inner execute_skill call.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.battle_flow_controller import BattleFlowController


class TestRegOnCritSurvivesInlinePs(unittest.TestCase):
    """Regression: on_crit modify_pp must fire even when before_any_attacked
    PS triggers an inline execute_skill that would otherwise clear on_crit state."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # Enemy caster: uses 220369 紫影の斬撃 (on_crit -> modify_pp +1)
        # PP=0 so we can verify +1 recovery; crit_rate=1.0 to guarantee crit
        self.caster = UnitState(
            unit_id="enemy_caster", name="霞光", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999999, level=10,
            element=6, character_type=2,
            max_hp=999999, current_hp=999999,
            attack=100000, defense=1000, speed=500,
            crit_rate=1.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=6, initial_passive_point=6, max_extra_point=10,
            current_ap=6, current_pp=0, current_ep=0,
            skills=[220369],
            skill_levels={220369: 10},
            skill_cooldowns={},
        )

        # Ally with 130009 アイギスランパード (before_any_attacked -> guard self)
        # This PS triggers inline execute_skill when enemy attacks, which was
        # clearing the outer skill's on_crit state.
        self.ally = UnitState(
            unit_id="ally_guard", name="ノーブル・グレイス", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=999998, level=10,
            element=5, character_type=1,
            max_hp=999999, current_hp=999999,
            attack=100, defense=1000, speed=100,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=10,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[130009],
            skill_levels={130009: 10},
            skill_cooldowns={},
        )

        self.bf.add_unit(self.caster)
        self.bf.add_unit(self.ally)

        self.controller = BattleFlowController(self.bf, data_loader=self.dl)
        self.controller._build_display_names()
        self.controller.skill_service.set_battlefield(self.bf)
        self.controller._deferred_crit_triggers = []

    def test_on_crit_modify_pp_fires_after_inline_ps(self):
        """220369 on_crit modify_pp should fire even when 130009 (before_any_attacked)
        triggers an inline execute_skill that would clear on_crit state.

        Bug: _execute_trigger_actions_inline did not save/restore on_crit state,
             so the inner execute_skill for 130009 cleared _on_crit_blocks and
             _deferred_on_crit_targets, causing modify_pp to be skipped.
        Fix: Save/restore all on_crit-related fields around the inner call.
        """
        pp_before = self.caster.current_pp
        self.assertEqual(pp_before, 0, "Caster should start with PP=0")
        ally_pp_before = self.ally.current_pp
        self.assertEqual(ally_pp_before, 4, "Ally should start with PP=4")

        result = self.controller.skill_service.execute_skill(
            caster=self.caster, skill_id=220369,
            battlefield=self.bf, skip_cost=True,
            defer_crit_triggers=True,
        )

        self.assertTrue(result.get("success"), "Skill should execute successfully")

        # Verify 130009 (before_any_attacked) actually triggered: ally should
        # have consumed 1 PP (130009 cost=1 PP). This confirms the inline
        # execute_skill path ran, which was clearing on_crit state before fix.
        self.assertEqual(self.ally.current_pp, 3,
                         "Ally PP should be 3 (was 4, -1 from 130009 PS cost). "
                         "If still 4, the 130009 PS did not trigger.")

        # Caster PP should have recovered by 1 (from on_crit modify_pp)
        self.assertEqual(self.caster.current_pp, 1,
                         "Caster PP should be 1 after on_crit modify_pp fires "
                         "(was 0, +1 from crit). If 0, the on_crit block was "
                         "cleared by the inline 130009 execute_skill.")

    def test_on_crit_modify_pp_fires_without_inline_ps(self):
        """Sanity check: with an ally that has NO before_any_attacked PS,
        on_crit modify_pp should also fire. (No inline PS interference.)"""
        # Replace ally's skills with empty list so no before_any_attacked PS triggers
        self.ally.skills = []
        self.ally.skill_levels = {}
        # Reset caster PP for this test
        self.caster.current_pp = 0

        result = self.controller.skill_service.execute_skill(
            caster=self.caster, skill_id=220369,
            battlefield=self.bf, skip_cost=True,
            defer_crit_triggers=True,
        )

        self.assertTrue(result.get("success"))
        self.assertEqual(self.caster.current_pp, 1,
                         "Caster PP should be 1 after on_crit modify_pp fires "
                         "(no inline PS interference)")


if __name__ == '__main__':
    unittest.main()
