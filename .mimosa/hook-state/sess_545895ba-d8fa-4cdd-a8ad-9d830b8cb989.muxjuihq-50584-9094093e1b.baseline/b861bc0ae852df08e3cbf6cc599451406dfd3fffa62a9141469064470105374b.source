"""Regression: damage_link 转送应能被多种伤害类型触发。

Bug: 早期 damage_link 转送仅在主 "damage" 效果中调用
     _apply_damage_process_damage_links，导致以下伤害类型不触发链接：
  - hp_ratio_damage (HP 比例伤害，如 210114 少しお行儀悪いですが……)
  - damage_special (特殊伤害，如 142301 風紀を守る一撃)
  - 附魔伤害 (ENCHANT_DAMAGE buff 触发的追加伤害)
  - 追加伤害 (ADD_DAMAGE buff 触发的追加伤害，如「あったかいの、どうぞ♪」)
  - 子单位伤害 (SUB_UNIT buff 触发的追加伤害)

Fix:
  1. _apply_hp_ratio_damage: 末尾调用 _apply_damage_process_damage_links，
     将 hp_ratio_damage 触发的链接转送给 linker。
  2. _apply_damage_special: 末尾调用 _apply_damage_process_damage_links，
     将 damage_special 触发的链接转送给 linker。
  3. _apply_block_enchant_damage: 处理附魔/追加/子单位伤害后，调用
     _apply_damage_process_damage_links，将这部分伤害也转送给 linker。
     主伤害和附魔/追加/子单位伤害各自独立触发链接，linker 会收到两次转送。

Requirements verified:
1. hp_ratio_damage 触发 damage_link 转送 (damage_link_transfers 非空 + linker HP 减少)
2. damage_special 触发 damage_link 转送 (damage_link_transfers 非空 + linker HP 减少)
3. ENCHANT_DAMAGE buff 触发的附魔伤害触发 damage_link 转送
4. ADD_DAMAGE buff 触发的追加伤害触发 damage_link 转送 (如「あったかいの、どうぞ♪」)
5. SUB_UNIT buff 触发的子单位追加伤害触发 damage_link 转送
"""
import unittest
import sys
import os
import uuid
from types import SimpleNamespace

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState, DamageLinkEntry
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

ENCHANT_DAMAGE = SkillEffectType.ENCHANT_DAMAGE.value
ADD_DAMAGE = SkillEffectType.ADD_DAMAGE.value
SUB_UNIT = SkillEffectType.SUB_UNIT.value


def _make_unit(unit_id, name, side, position, *, hp=200000, atk=10000,
               defense=3000, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ep=10):
    """构造测试用 UnitState"""
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=15, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=pp, current_ep=ep,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_outgoing_damage_link(source_unit, partner_unit, value=100.0,
                                is_sharing=True, source_skill_id=130108):
    """在 source_unit 上添加 outgoing damage_link，使其承受伤害时转送给 partner_unit(linker)。
    同时在 partner_unit 上添加 incoming 配对记录（仅作配对，不主动触发转送）。
    """
    link_id = str(uuid.uuid4())
    src_entry = DamageLinkEntry(
        link_id=link_id,
        partner_unit_id=partner_unit.unit_id,
        value=float(value),
        source_skill_id=source_skill_id,
        source_unit_id=source_unit.unit_id,
        direction="outgoing",
        is_unremovable=False,
        is_sharing=is_sharing,
        duration=-1,
        duration_type="",
        just_applied=False,
    )
    dst_entry = DamageLinkEntry(
        link_id=link_id,
        partner_unit_id=source_unit.unit_id,
        value=float(value),
        source_skill_id=source_skill_id,
        source_unit_id=source_unit.unit_id,
        direction="incoming",
        is_unremovable=False,
        is_sharing=is_sharing,
        duration=-1,
        duration_type="",
        just_applied=False,
    )
    source_unit.damage_links.append(src_entry)
    partner_unit.damage_links.append(dst_entry)
    return src_entry, dst_entry


def _make_enchant_damage_buff(owner_uid, value=100.0, caster_attack=10000,
                                source_unit_id=None, hit_limited=0):
    """生成 ENCHANT_DAMAGE buff (附魔伤害)。
    value=power%，ENCHANT_DAMAGE 优先使用 source_unit 实时 ATK，找不到时用 caster_attack 快照。
    """
    return BuffState(
        buff_id=f"{owner_uid}_enchant_test",
        name="附魔伤害",
        effect_type=ENCHANT_DAMAGE,
        value=value,
        duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=source_unit_id or owner_uid,
        source_skill_id=99999,
        caster_attack=caster_attack,
        is_debuff=False,
        hit_limited=hit_limited,
    )


def _make_add_damage_buff(owner_uid, value=100.0, caster_attack=10000,
                            source_unit_id=None, hit_limited=0):
    """生成 ADD_DAMAGE buff (追加伤害，如「あったかいの、どうぞ♪」)。
    value=power%，ADD_DAMAGE 使用 caster_attack 快照作为 source_atk。
    """
    return BuffState(
        buff_id=f"{owner_uid}_add_damage_test",
        name="追加伤害",
        effect_type=ADD_DAMAGE,
        value=value,
        duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=source_unit_id or owner_uid,
        source_skill_id=99999,
        caster_attack=caster_attack,
        is_debuff=False,
        hit_limited=hit_limited,
    )


def _make_sub_unit_buff(owner_uid, sub_hp=50000, value=100.0, caster_attack=10000):
    """生成 SUB_UNIT buff (子单位)。
    value=追加伤害 power%，sub_unit_hp=子单位 HP (可吸收伤害)。
    """
    return BuffState(
        buff_id=f"{owner_uid}_sub_unit_test",
        name="子機",
        effect_type=SUB_UNIT,
        value=value,
        duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=owner_uid,
        source_skill_id=99999,
        caster_attack=caster_attack,
        is_debuff=False,
        sub_unit_hp=sub_hp,
        sub_unit_max_hp=sub_hp,
    )


def _make_hp_ratio_damage_effect(value=50.0, target_type="enemy_single",
                                  value_source="caster_current_hp",
                                  ignore_shield=0):
    """构造 _apply_hp_ratio_damage 所需的 effect 参数"""
    return SimpleNamespace(
        effect_type="hp_ratio_damage",
        target_type=target_type,
        target_identifier=None,
        value=value,
        value_tag=None,
        value_source=value_source,
        duration=None,
        duration_type=None,
        duration_tag=None,
        hit_count=None,
        hit_count_tag=None,
        condition=None,
        flags={"ignore_shield": ignore_shield} if ignore_shield else {},
        ignore_shield=ignore_shield,
    )


def _make_damage_special_effect(value=50.0, target_type="enemy_single",
                                  value_source="self_max_hp"):
    """构造 _apply_damage_special 所需的 effect 参数"""
    return SimpleNamespace(
        effect_type="damage_special",
        target_type=target_type,
        target_identifier=None,
        value=value,
        value_tag=None,
        value_source=value_source,
        duration=None,
        duration_type=None,
        duration_tag=None,
        hit_count=None,
        hit_count_tag=None,
        condition=None,
        flags={"apply_guard": False, "can_evade": False, "apply_shield": True},
        ignore_defense=0,
        ignore_shield=0,
    )


def _make_damage_effect(value=100.0, hit_count=1):
    """构造 _apply_damage 所需的 effect 参数 (普通伤害)"""
    return SimpleNamespace(
        effect_type="damage",
        target_type="enemy_single",
        target_identifier=None,
        value=value,
        hit_count=hit_count,
        ignore_defense=0,
        ignore_shield=0,
        flags={},
        condition=None,
    )


def _init_ss_for_direct_apply(ss, bf):
    """初始化 _apply_damage / _apply_hp_ratio_damage / _apply_damage_special
    所需的全部内部状态。直接调用这些方法而不走 execute_skill 时必须先调用此函数。
    """
    ss._recursion_guard = True
    ss._before_attack_triggers_fired = True
    ss._current_skill_id = 99999
    ss._current_block_id = 1
    ss._current_skill_priority = 1
    ss._block_damage_targets = {}
    ss._block_damage_total = {}
    ss._last_damage_hp_before = {}
    ss._damaged_targets = []
    ss._current_attack_targets = []
    ss._pre_scanned_cover_candidates = None
    ss._pre_scanned_non_damage_enemy_targets = []
    ss._primary_target = None
    ss._trigger_attacker = None
    ss._target_char_type_filter = None
    ss._target_element_filter = None
    ss._original_primary_target = None
    ss._last_primary_target = None
    ss._most_recent_damage = 0
    ss._skill_all_attacked_targets = []
    ss._hp_consumed = 0
    ss._per_hit_hp_losses = {}
    ss._block_evaded_targets = set()
    ss._skill_evaded_targets = set()
    ss._debuff_immune_blocked_targets = set()
    ss._on_crit_blocks = []
    ss._on_crit_applied = False
    ss._on_crit_block_executed = {}
    ss._on_crit_target = None
    ss._on_crit_immediate_blocks = []
    ss._on_crit_immediate_applied = set()
    ss._on_crit_effects = []
    ss._deferred_on_crit_targets = []
    ss._pending_crit_triggers = []
    ss._per_target_enchant_cache = None
    ss._current_main_damage_power = None
    ss._marks_at_start = {}
    ss._marks_at_start_by_unit = {}
    ss._ps_received_targets = []
    ss._current_skill_is_ps = False
    ss._last_heal_targets = []
    ss._newly_created_sub_unit_ids = set()
    ss._pending_deaths = set()
    ss._caster_buffs_active_during_damage = set()


class TestRegDamageLinkHpRatioAndEnchant(unittest.TestCase):
    """damage_link 转送应能被 hp_ratio_damage、damage_special、附魔伤害、子单位伤害触发。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    def _make_setup(self, *, caster_atk=20000, target_hp=200000, linker_hp=500000,
                    link_pct=100.0, is_sharing=True):
        """构造标准测试场景: caster 攻击 target，target 持有 outgoing damage_link 转送给 linker。"""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=200000, atk=caster_atk, defense=1000)
        target = _make_unit("target", "目标", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                           hp=target_hp, atk=5000, defense=1000)
        linker = _make_unit("linker", "链接者", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                           hp=linker_hp, atk=5000, defense=1000)
        # target 持有 outgoing damage_link，承受伤害时 100% 转送给 linker
        _make_outgoing_damage_link(target, linker, value=link_pct, is_sharing=is_sharing)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [target, linker]
        ss, ts = self._make_services(bf)
        _init_ss_for_direct_apply(ss, bf)
        return caster, target, linker, bf, ss

    # ================================================================
    # 1. hp_ratio_damage 触发 damage_link
    # ================================================================
    def test_hp_ratio_damage_triggers_damage_link(self):
        """hp_ratio_damage 应触发 damage_link 转送给 linker。

        场景:
        - caster.current_hp = 200000, dmg_pct = 50
          → hp_ratio_damage = 200000 * 50% = 100000
        - target 有 outgoing damage_link 转 100% 给 linker
        - 验证: linker HP 减少 (承受了转送伤害)
        - 验证: result dict 中 damage_link_transfers 非空
        """
        caster, target, linker, bf, ss = self._make_setup(
            caster_atk=20000, target_hp=200000, linker_hp=500000, link_pct=100.0)

        linker_hp_before = linker.current_hp
        effect = _make_hp_ratio_damage_effect(
            value=50.0, target_type="enemy_single",
            value_source="caster_current_hp")
        result = ss._apply_hp_ratio_damage(caster, effect, bf)

        # 验证返回的 result 包含非空 damage_link_transfers
        self.assertIsNotNone(result, "_apply_hp_ratio_damage 应返回非 None 结果")
        transfers = result.get("damage_link_transfers", [])
        self.assertGreater(len(transfers), 0,
                          "hp_ratio_damage 应触发 damage_link 转送，damage_link_transfers 应非空")

        # 验证 linker HP 下降（承受了转送伤害）
        self.assertLess(linker.current_hp, linker_hp_before,
                       "linker 应承受 hp_ratio_damage 触发的 damage_link 转送伤害")

    # ================================================================
    # 2. damage_special 触发 damage_link
    # ================================================================
    def test_damage_special_triggers_damage_link(self):
        """damage_special 应触发 damage_link 转送给 linker。

        场景:
        - caster.max_hp = 200000, dmg_pct = 50
          → damage_special = 200000 * 50% = 100000
        - target 有 outgoing damage_link 转 100% 给 linker
        - 验证: linker HP 减少 (承受了转送伤害)
        - 验证: result dict 中 damage_link_transfers 非空
        """
        caster, target, linker, bf, ss = self._make_setup(
            caster_atk=20000, target_hp=200000, linker_hp=500000, link_pct=100.0)

        linker_hp_before = linker.current_hp
        effect = _make_damage_special_effect(
            value=50.0, target_type="enemy_single",
            value_source="self_max_hp")
        result = ss._apply_damage_special(caster, effect, bf)

        # 验证返回的 result 包含非空 damage_link_transfers
        self.assertIsNotNone(result, "_apply_damage_special 应返回非 None 结果")
        transfers = result.get("damage_link_transfers", [])
        self.assertGreater(len(transfers), 0,
                          "damage_special 应触发 damage_link 转送，damage_link_transfers 应非空")

        # 验证 linker HP 下降
        self.assertLess(linker.current_hp, linker_hp_before,
                       "linker 应承受 damage_special 触发的 damage_link 转送伤害")

    # ================================================================
    # 3. 附魔伤害 (ENCHANT_DAMAGE) 触发 damage_link
    # ================================================================
    def test_enchant_damage_triggers_damage_link(self):
        """附魔伤害应触发 damage_link 转送给 linker。

        场景:
        - caster 持有 ENCHANT_DAMAGE buff (value=100%, caster_attack=20000)
        - target 有 outgoing damage_link 转 100% 给 linker
        - caster 对 target 使用普通 damage 效果
        - 主伤害和附魔伤害都会独立触发 damage_link
        - 验证: 主伤害 result.damage_link_transfers 非空
        - 验证: 附魔伤害 result.damage_link_transfers 非空
        - 验证: linker HP 下降 (主伤害 + 附魔伤害两次转送)
        """
        caster, target, linker, bf, ss = self._make_setup(
            caster_atk=20000, target_hp=500000, linker_hp=1000000, link_pct=100.0)

        # 给 caster 添加 ENCHANT_DAMAGE buff (附魔伤害)
        # value=100% 表示附魔伤害 = max(0, snapshot_atk + min(0, a_atk - c_def)) * 100%
        # = max(0, 20000 + min(0, 20000-1000)) * 1.0 = 20000
        enchant_buff = _make_enchant_damage_buff(
            owner_uid=caster.unit_id, value=100.0, caster_attack=20000,
            source_unit_id=caster.unit_id, hit_limited=0)
        caster.buffs.append(enchant_buff)

        linker_hp_before = linker.current_hp

        # 执行主 damage 效果
        effect = _make_damage_effect(value=100.0, hit_count=1)
        main_result = ss._apply_damage(caster, effect, bf)

        # 验证主伤害触发了 damage_link
        self.assertIsNotNone(main_result, "_apply_damage 应返回非 None 结果")
        main_transfers = main_result.get("damage_link_transfers", [])
        self.assertGreater(len(main_transfers), 0,
                          "主伤害应触发 damage_link 转送")

        # 记录主伤害后 linker HP
        linker_hp_after_main = linker.current_hp
        self.assertLess(linker_hp_after_main, linker_hp_before,
                       "主伤害应让 linker HP 下降 (主伤害转送)")

        # 调用 _apply_block_enchant_damage 处理附魔伤害
        # execute_skill 中主伤害后会自动调用此方法，这里手动调用以模拟完整流程
        enchant_results = ss._apply_block_enchant_damage(
            caster, main_result.get("targets", []), bf,
            main_result.get("total_damage", 0))

        # 验证附魔伤害结果不为 None
        self.assertIsNotNone(enchant_results,
                            "附魔伤害结果不应为 None (caster 持有 ENCHANT_DAMAGE buff)")

        # 收集附魔伤害的 damage_link_transfers
        enchant_transfers = []
        for er in enchant_results:
            if er.get("effect_type") == "damage":
                enchant_transfers.extend(er.get("damage_link_transfers", []))
        self.assertGreater(len(enchant_transfers), 0,
                         "附魔伤害应触发 damage_link 转送 (damage_link_transfers 应非空)")

        # 验证附魔伤害后 linker HP 进一步下降
        self.assertLess(linker.current_hp, linker_hp_after_main,
                       "附魔伤害应让 linker HP 进一步下降 (附魔伤害转送)")

    # ================================================================
    # 4. 追加伤害 (ADD_DAMAGE, 如「あったかいの、どうぞ♪」) 触发 damage_link
    # ================================================================
    def test_add_damage_triggers_damage_link(self):
        """ADD_DAMAGE 追加伤害应触发 damage_link 转送给 linker。

        场景:
        - caster 持有 ADD_DAMAGE buff (value=100%, caster_attack=20000)
          (模拟「あったかいの、どうぞ♪」提供给队友的追加伤害 buff)
        - target 有 outgoing damage_link 转 100% 给 linker
        - caster 对 target 使用普通 damage 效果
        - 主伤害和追加伤害都会独立触发 damage_link
        - 验证: 主伤害 result.damage_link_transfers 非空
        - 验证: 追加伤害 result.damage_link_transfers 非空
        - 验证: linker HP 下降 (主伤害 + 追加伤害两次转送)
        """
        caster, target, linker, bf, ss = self._make_setup(
            caster_atk=20000, target_hp=500000, linker_hp=1000000, link_pct=100.0)

        # 给 caster 添加 ADD_DAMAGE buff (追加伤害)
        # value=100% 表示追加伤害 = max(0, source_atk + min(0, source_atk - c_def)) * 100%
        # = max(0, 20000 + min(0, 20000-1000)) * 1.0 = 20000
        add_dmg_buff = _make_add_damage_buff(
            owner_uid=caster.unit_id, value=100.0, caster_attack=20000,
            source_unit_id=caster.unit_id, hit_limited=0)
        caster.buffs.append(add_dmg_buff)

        linker_hp_before = linker.current_hp

        # 执行主 damage 效果
        effect = _make_damage_effect(value=100.0, hit_count=1)
        main_result = ss._apply_damage(caster, effect, bf)

        # 验证主伤害触发了 damage_link
        self.assertIsNotNone(main_result, "_apply_damage 应返回非 None 结果")
        main_transfers = main_result.get("damage_link_transfers", [])
        self.assertGreater(len(main_transfers), 0,
                          "主伤害应触发 damage_link 转送")

        # 记录主伤害后 linker HP
        linker_hp_after_main = linker.current_hp
        self.assertLess(linker_hp_after_main, linker_hp_before,
                       "主伤害应让 linker HP 下降 (主伤害转送)")

        # 调用 _apply_block_enchant_damage 处理追加伤害
        # (此方法同时处理 ENCHANT_DAMAGE / ADD_DAMAGE / SUB_UNIT 的追加伤害)
        enchant_results = ss._apply_block_enchant_damage(
            caster, main_result.get("targets", []), bf,
            main_result.get("total_damage", 0))

        # 验证追加伤害结果不为 None
        self.assertIsNotNone(enchant_results,
                            "追加伤害结果不应为 None (caster 持有 ADD_DAMAGE buff)")

        # 收集追加伤害的 damage_link_transfers
        add_dmg_transfers = []
        for er in enchant_results:
            if er.get("effect_type") == "damage":
                add_dmg_transfers.extend(er.get("damage_link_transfers", []))
        self.assertGreater(len(add_dmg_transfers), 0,
                         "ADD_DAMAGE 追加伤害应触发 damage_link 转送 (damage_link_transfers 应非空)")

        # 验证追加伤害后 linker HP 进一步下降
        self.assertLess(linker.current_hp, linker_hp_after_main,
                       "ADD_DAMAGE 追加伤害应让 linker HP 进一步下降 (追加伤害转送)")

    # ================================================================
    # 5. 子单位伤害 (SUB_UNIT) 触发 damage_link
    # ================================================================
    def test_sub_unit_damage_triggers_damage_link(self):
        """子单位追加伤害应触发 damage_link 转送给 linker。

        场景:
        - caster 持有 SUB_UNIT buff (value=100%, sub_unit_hp=50000)
        - target 有 outgoing damage_link 转 100% 给 linker
        - caster 对 target 使用普通 damage 效果
        - 主伤害和子单位追加伤害都会独立触发 damage_link
        - 验证: 主伤害 result.damage_link_transfers 非空
        - 验证: 子单位追加伤害 result.damage_link_transfers 非空
        - 验证: linker HP 下降 (主伤害 + 子单位伤害两次转送)
        """
        caster, target, linker, bf, ss = self._make_setup(
            caster_atk=20000, target_hp=500000, linker_hp=1000000, link_pct=100.0)

        # 给 caster 添加 SUB_UNIT buff (子单位追加伤害)
        # value=100% 表示追加伤害 = max(0, snapshot_atk + min(0, a_atk - c_def)) * 100%
        # = max(0, 20000 + min(0, 20000-1000)) * 1.0 = 20000
        sub_buff = _make_sub_unit_buff(
            owner_uid=caster.unit_id, sub_hp=50000, value=100.0,
            caster_attack=20000)
        caster.buffs.append(sub_buff)

        linker_hp_before = linker.current_hp

        # 执行主 damage 效果
        effect = _make_damage_effect(value=100.0, hit_count=1)
        main_result = ss._apply_damage(caster, effect, bf)

        # 验证主伤害触发了 damage_link
        self.assertIsNotNone(main_result, "_apply_damage 应返回非 None 结果")
        main_transfers = main_result.get("damage_link_transfers", [])
        self.assertGreater(len(main_transfers), 0,
                          "主伤害应触发 damage_link 转送")

        # 记录主伤害后 linker HP
        linker_hp_after_main = linker.current_hp
        self.assertLess(linker_hp_after_main, linker_hp_before,
                       "主伤害应让 linker HP 下降 (主伤害转送)")

        # 调用 _apply_block_enchant_damage 处理子单位追加伤害
        # (此方法同时处理 ENCHANT_DAMAGE / ADD_DAMAGE / SUB_UNIT 的追加伤害)
        enchant_results = ss._apply_block_enchant_damage(
            caster, main_result.get("targets", []), bf,
            main_result.get("total_damage", 0))

        # 验证子单位追加伤害结果不为 None
        self.assertIsNotNone(enchant_results,
                            "子单位追加伤害结果不应为 None (caster 持有 SUB_UNIT buff)")

        # 收集子单位追加伤害的 damage_link_transfers
        sub_unit_transfers = []
        for er in enchant_results:
            if er.get("effect_type") == "damage":
                sub_unit_transfers.extend(er.get("damage_link_transfers", []))
        self.assertGreater(len(sub_unit_transfers), 0,
                         "子单位追加伤害应触发 damage_link 转送 (damage_link_transfers 应非空)")

        # 验证子单位追加伤害后 linker HP 进一步下降
        self.assertLess(linker.current_hp, linker_hp_after_main,
                       "子单位追加伤害应让 linker HP 进一步下降 (子单位伤害转送)")


if __name__ == '__main__':
    unittest.main()
