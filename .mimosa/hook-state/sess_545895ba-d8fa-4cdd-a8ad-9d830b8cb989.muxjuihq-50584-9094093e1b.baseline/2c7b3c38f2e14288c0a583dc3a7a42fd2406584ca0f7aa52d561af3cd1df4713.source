        self.assertEqual(heal_downs[0].duration, 2, "heal_efficacy_down duration应为2")

    def test_ps2_allow_ex_trigger_ex_skill(self):
        """PS2(130104) allow_ex_trigger: EX技能也能触发PS2。

        allow_ex_trigger=true 使 after_as_attack 在 EX技能(skill_type=3)后也触发。
