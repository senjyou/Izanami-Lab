                           "AS技能应能触发PS2（标准场景）")

    def test_ps2_ps_skill_does_not_trigger(self):
        """PS2(130104) PS技能不触发PS2（after_as_attack 仅限AS/EX）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 触发PS1后，PS1作为PS技能，不应触发PS2
        # 模拟PS1执行后的after_as_attack调用
        result = {"total_damage": 0, "success": True}
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=130103, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130104]
        # PS技能(skill_type=2)不应触发PS2
        self.assertEqual(len(ps2_actions), 0,
                         "PS技能不应触发PS2（after_as_attack 仅限AS/EX）")

    def test_ps2_cooldown_blocks_retrigger(self):
        """PS2(130104) cooldown=2: 第一次触发后冷却中，第二次不应再被收集。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 第一次触发
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )
        actions1 = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120096, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps2_1 = [a for a in actions1 if a.skill_id == 130104]
        self.assertGreater(len(ps2_1), 0, "第一次应触发PS2")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_1, self.bf, trigger_timing="after_as_attack"
        )

        # 验证冷却已设置
        self.assertEqual(self.caster.skill_cooldowns.get(130104), 2,
                         "PS2执行后应设置cooldown=2")

        # 第二次触发（PS2在冷却中）
        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )
        actions2 = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120096, result=result2, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps2_2 = [a for a in actions2 if a.skill_id == 130104]
        self.assertEqual(len(ps2_2), 0, "PS2在冷却中 → 不应再次被收集")

    # ════════════════════════════════════════════════════════════════
    # perfect_evasion 专项
    # ════════════════════════════════════════════════════════════════

    def test_perfect_evasion_blocks_one_hit(self):
        """perfect_evasion: 被攻击时1次hit完全回避，hit_limited从1减到0后移除。

        场景：EX付与perfect_evasion → 敌方攻击caster → caster不受伤，buff被消耗。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # Step 1: 施放EX给caster付与perfect_evasion
        self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )
        evades = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertGreater(len(evades), 0, "应有perfect_evasion buff")
        self.assertEqual(evades[0].hit_limited, 1, "初始hit_limited=1")

        # Step 2: 让 enemy_cf 攻击 caster（用enemy_cf作为施法者执行简单damage技能）
        hp_before = self.caster.current_hp
        # 用 caster 的 AS2 反向模拟（enemy_cf 作施法者，攻击最近敌方=caster）
        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120096, battlefield=self.bf, skip_cost=True
        )

        # perfect_evasion 应使 caster 不受伤（或buff被消耗）
        evades_after = [b for b in self.caster.buffs if b.effect_type == EVADE]
        # buff应被消耗（hit_limited从1减到0后移除）
        self.assertEqual(len(evades_after), 0,
                         "1次攻击后perfect_evasion buff应被移除")

    def test_perfect_evasion_persists_until_hit(self):
        """perfect_evasion: 持续到被攻击，不会自动消失。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 施放EX给caster付与perfect_evasion
        self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )
        evades = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertGreater(len(evades), 0, "应有perfect_evasion buff")

        # 不进行攻击，buff应仍存在
        evades_still = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evades_still), 1, "未被攻击时perfect_evasion应保持")

    def test_perfect_evasion_consumed_only_once(self):
        """perfect_evasion: hit_limited=1 仅消耗1次，攻击后失效。

        场景：perfect_evasion → 第1次攻击闪避 → 第2次攻击受伤。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # Step 1: 施放EX给caster付与perfect_evasion
        self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )
        evades = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evades), 1, "应有1个perfect_evasion buff")

        # Step 2: 第1次攻击 → perfect_evasion消耗
        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120096, battlefield=self.bf, skip_cost=True
        )
        evades_after = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evades_after), 0, "第1次攻击后perfect_evasion应被消耗")

        # Step 3: 第2次攻击 → caster应受伤（无闪避）
        hp_before_2nd = self.caster.current_hp
        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120096, battlefield=self.bf, skip_cost=True
        )
        # caster 应受伤（HP下降）
        self.assertLess(self.caster.current_hp, hp_before_2nd,
                        "第2次攻击应造成伤害（perfect_evasion已消耗）")

    # ════════════════════════════════════════════════════════════════
    # debuff_immune 专项
    # ════════════════════════════════════════════════════════════════

    def test_debuff_immune_blocks_debuff(self):
        """debuff_immune: 免疫debuff施加。

        场景：EX付与debuff_immune → 敌方对caster施加debuff → debuff被阻挡。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # Step 1: 施放EX给caster付与debuff_immune
        self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )
        immunes = [b for b in self.caster.buffs if b.effect_type == DEBUFF_IMMUNE]
        self.assertGreater(len(immunes), 0, "应有debuff_immune buff")

        # Step 2: 让 enemy_cf 对caster施加debuff（用AS2的action_damage）
        # action_damage 是 debuff，应被 debuff_immune 阻挡
        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120096, battlefield=self.bf, skip_cost=True
        )

        # 验证 caster 没有获得 action_damage debuff（被debuff_immune阻挡）
        action_damages = [d for d in self.caster.debuffs if d.effect_type == ACTION_DAMAGE]
        self.assertEqual(len(action_damages), 0,
                         "debuff_immune应阻挡 action_damage debuff")

    def test_debuff_immune_duration_1_action(self):
        """debuff_immune: duration=1 action，行动结束后失效。

        场景：debuff_immune → caster行动结束（process_maneuver_end）→ debuff_immune被移除。
        注意：just_applied=True 会保护当次行动新施加的buff不被递减，需先清除该标志
        模拟"下一回合行动结束"的场景。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 施放EX给caster付与debuff_immune
        self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )
        immunes = [b for b in self.caster.buffs if b.effect_type == DEBUFF_IMMUNE]
        self.assertGreater(len(immunes), 0, "应有debuff_immune buff")
        self.assertEqual(immunes[0].duration, 1, "duration应为1")

        # 清除 just_applied 标志，模拟"下一回合行动结束"场景
        # （当次行动新施加的buff由just_applied保护，不会被递减）
        for b in self.caster.buffs + self.caster.debuffs:
            b.just_applied = False

        # 模拟下一回合行动结束：
        # 1. process_maneuver_end 递减 duration (1→0)
        # 2. check_expiration 移除 duration==0 的buff
        # （battle_flow_controller 中两步顺序调用，见 L3896/L3940）
        self.aus.process_maneuver_end(self.caster)
        self.aus.check_expiration(self.caster, self.bf.get_all_units())

        # 验证 debuff_immune 已被移除
        immunes_after = [b for b in self.caster.buffs if b.effect_type == DEBUFF_IMMUNE]
        self.assertEqual(len(immunes_after), 0,
                         "行动结束后debuff_immune应被移除（duration 1→0）")

    # ════════════════════════════════════════════════════════════════
    # allow_ex_trigger 专项（PS2 配置）
    # ════════════════════════════════════════════════════════════════

    def test_allow_ex_trigger_flag_set(self):
        """PS2(130104) 配置了 allow_ex_trigger=true。"""
        parsed = self.dl.get_parsed_skill_data(130104)
        self.assertIsNotNone(parsed, "PS2(130104) 应有 parsed 数据")
        self.assertTrue(parsed.get("allow_ex_trigger", False),
                        "PS2(130104) 应配置 allow_ex_trigger=true")

    def test_allow_ex_trigger_ex_applies_burn(self):
        """allow_ex_trigger: EX技能触发PS2后，对attacked_targets施加burn。

        完整链路：EX攻击 → PS2触发 → burn施加给被攻击目标。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # caster 执行EX攻击 enemy_cf
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )

        # 触发PS2（EX技能）
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=110042, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130104]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="after_as_attack"
        )

        # 验证 enemy_cf 获得 burn debuff
        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        self.assertGreater(len(burns), 0,
                           "EX触发PS2后enemy_cf应有burn debuff")

    # ════════════════════════════════════════════════════════════════
    # 集成测试
    # ════════════════════════════════════════════════════════════════

    def test_integration_ex_perfect_evasion_full_chain(self):
        """集成：EX触发 → perfect_evasion付与 → 敌方攻击 → 闪避 → buff消耗。

        完整流程：
        1. caster 施放EX → 获得 perfect_evasion + debuff_immune
        2. enemy_cf 攻击 caster
        3. caster 完全闪避（HP不变）
        4. perfect_evasion buff 被消耗
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # Step 1: 施放EX
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        evades = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertGreater(len(evades), 0, "Step1: 应有perfect_evasion")

        # Step 2: enemy_cf 攻击 caster
        hp_before_attack = self.caster.current_hp
        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120096, battlefield=self.bf, skip_cost=True
        )

        # Step 3: caster HP应不变（perfect_evasion闪避）
        # 注意：enemy_cf 的 AS2 也可能施加 action_damage，但 debuff_immune 应阻挡
        self.assertEqual(self.caster.current_hp, hp_before_attack,
                         "Step3: perfect_evasion应使caster不受伤")

        # Step 4: perfect_evasion buff 被消耗
        evades_after = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evades_after), 0,
                         "Step4: perfect_evasion应被消耗")

    def test_integration_ps2_burn_with_as_full_chain(self):
        """集成：AS攻击 → PS2触发 → burn+heal_efficacy_down施加 → burn DoT伤害。

        完整流程：
        1. caster 施放AS2攻击 enemy_cf
        2. PS2 触发，对 enemy_cf 施加 burn + heal_efficacy_down
        3. 调用 apply_burn_damage 验证 burn DoT 伤害
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: caster 施放AS2
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Step 2: 触发PS2
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120096, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130104]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="after_as_attack"
        )

        # 验证 burn + heal_efficacy_down 已施加
        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        heal_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == RECEIVED_HEALING]
        self.assertGreater(len(burns), 0, "Step2: 应有burn debuff")
        self.assertGreater(len(heal_downs), 0, "Step2: 应有heal_efficacy_down debuff")

        # Step 3: 调用 apply_burn_damage 验证 burn DoT
        hp_before_burn = self.enemy_cf.current_hp
        # apply_burn_damage 返回 (total_damage, count, calc_detail)
        burn_dmg, _, _ = self.sts.apply_burn_damage(self.enemy_cf)
        self.assertGreater(burn_dmg, 0, "Step3: burn应造成DoT伤害")
        self.assertLess(self.enemy_cf.current_hp, hp_before_burn,
                        "Step3: enemy_cf HP应因burn减少")

    def test_integration_ps1_attacker_ratio_full_chain(self):
        """集成：PS1触发 → 条件性dmg_taken_down → 攻击者HP>自身时减伤 → 攻击后buff消耗。

        完整流程：
        1. PS1 触发，caster 获得 dmg_taken_down(attacker_hp_ratio_gt_self)
        2. 攻击者HP=80% > caster HP=50% → 减伤生效
        3. attack_limited=1 → 1次攻击后buff消耗
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: 触发PS1
        actions = self.ts.trigger_turn_start(self.bf)
        ps1_actions = [a for a in actions if a.skill_id == 130103]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_turn_start"
        )
        dmg_downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(dmg_downs), 0, "Step1: PS1应给caster付与dmg_taken_down")

        # Step 2: 设置 HP 比例：caster=50%, enemy_cf=80%
        self.caster.current_hp = int(self.caster.max_hp * 0.50)
        self.enemy_cf.current_hp = int(self.enemy_cf.max_hp * 0.80)

        # 验证减伤生效
        mult_active = self.dms._get_damage_received_multiplier(
            self.caster, damage_element=0, attacker=self.enemy_cf
        )
        self.assertLess(mult_active, 1.0, "Step2: 攻击者HP>自身时减伤应生效")

        # Step 3: 让 enemy_cf 攻击 caster，验证buff被消耗（attack_limited=1）
        # 先记录buff数量
        buff_count_before = len([b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE])
        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120096, battlefield=self.bf, skip_cost=True
        )
        # attack_limited=1 → 1次攻击后buff应被消耗
        buff_count_after = len([b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE])
        self.assertLessEqual(buff_count_after, buff_count_before,
                             "Step3: attack_limited=1 攻击后buff应被消耗或减少")

    def test_integration_as2_action_damage_with_ps2_burn(self):
        """集成：AS2攻击 → action_damage + PS2(burn+heal_efficacy_down) 同时施加。

        验证 AS2 的 action_damage 和 PS2 的 burn 可共存于同一目标。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # caster 施放AS2
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )

        # 触发PS2
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120096, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130104]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="after_as_attack"
        )

        # 验证 enemy_cf 同时持有 action_damage + burn + heal_efficacy_down
        action_damages = [d for d in self.enemy_cf.debuffs if d.effect_type == ACTION_DAMAGE]
        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        heal_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == RECEIVED_HEALING]

        self.assertGreater(len(action_damages), 0, "应有action_damage debuff（来自AS2）")
        self.assertGreater(len(burns), 0, "应有burn debuff（来自PS2）")
        self.assertGreater(len(heal_downs), 0, "应有heal_efficacy_down debuff（来自PS2）")

        # 验证3种debuff可共存
        self.assertEqual(len(action_damages), 1, "action_damage应仅1个")
        self.assertEqual(len(burns), 1, "burn应仅1个")

    def test_integration_ps1_lv15_full_chain(self):
        """集成：Lv15 PS1 → dmg_taken_down + HP<35%时add_ep。

        完整流程：
        1. Lv15 PS1 触发，caster HP=20%（<35%）
        2. Block1: dmg_taken_down付与
        3. Block2: add_ep（HP<35%满足）
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10, ep=0)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 15
        self.caster.skill_levels[130103] = 15
        # 设置 caster HP=20%（<35%）
        self.caster.current_hp = int(self.caster.max_hp * 0.20)

        ep_before = self.caster.current_ep

        # 触发PS1
        actions = self.ts.trigger_turn_start(self.bf)
        ps1_actions = [a for a in actions if a.skill_id == 130103]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证 Block1: dmg_taken_down付与
        dmg_downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(dmg_downs), 0, "Block1应给caster付与dmg_taken_down")
        self.assertTrue(getattr(dmg_downs[0], 'attacker_hp_ratio_gt_self', False),
                        "dmg_taken_down应有attacker_hp_ratio_gt_self标记")

        # 验证 Block2: add_ep
        self.assertGreater(self.caster.current_ep, ep_before,
                           "Block2应add_ep（Lv15+HP<35%）")


if __name__ == "__main__":
    unittest.main()
