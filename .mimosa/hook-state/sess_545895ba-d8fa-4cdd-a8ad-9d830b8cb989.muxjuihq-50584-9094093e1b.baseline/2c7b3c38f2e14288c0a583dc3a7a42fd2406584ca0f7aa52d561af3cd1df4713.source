"""角色125301 雪山もこもこ少女 专项E2E测试

技能列表：
- EX: 110042 雪山とジュリーだるま？（敵単体EN攻撃[威力, 3hits] + self perfect_evasion[hit_limited=1]
  + self debuff_immune[1 action]；Lv11+ any_target_survived -> 追加ダメージ[威力2]）
- AS1: 120095 みんなで雪遊び！（敵一列EN攻撃[威力] + self dmg_taken_down[stackable, attack_limited=1, 永续]；
  Lv11+ self lifesteal[20%]）
- AS2: 120096 雪合戦開始！（敵単体EN攻撃[威力] + 敵単体 action_damage[atk*10%, 3 actions]；
  target_hp_below 35% -> 追加ダメージ[威力2]）
- PS1: 130103 いちばんのりー！（on_turn_start；self dmg_taken_down[attacker_hp_ratio_gt_self, stackable,
  attack_limited=1, 永续]；Lv11+ self_hp_below 35% -> self add_ep[1]）
- PS2: 130104 防寒はバッチリ！（after_as_attack+allow_ex_trigger；attacked_targets burn[atk*30%, 2 actions]
  + attacked_targets heal_efficacy_down[2 actions]）

覆盖维度：
1. EX EN攻击 + perfect_evasion付与 + debuff_immune付与 + any_target_survived L11+追加伤害
2. AS1 列攻击 + dmg_taken_down(stackable, attack_limited, 永续) + L11+ lifesteal
3. AS2 单体攻击 + action_damage DoT付与 + target_hp_below 35%追加伤害
4. PS1 on_turn_start + attacker_hp_ratio_gt_self 条件性减伤 + L11+ self_hp_below add_ep
5. PS2 after_as_attack+allow_ex_trigger + burn + heal_efficacy_down 对attacked_targets
6. perfect_evasion 专项：hit_limited=1消耗、1次攻击后失效
7. debuff_immune 专项：1 action内免疫、duration递减
8. attacker_hp_ratio_gt_self 专项：攻击者HP比例>自身生效 / <=自身不生效
9. allow_ex_trigger 专项：EX/AS触发PS2、PS不触发PS2
10. 集成测试：完整链路验证
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# perfect_evasion -> EVADE 枚举
# debuff_immune -> "debuff_immune" 字符串（无独立枚举，存为 buff effect_type="debuff_immune"）
# action_damage -> ACTION_DAMAGE 枚举
# burn -> CONFLAGRATION 枚举
# heal_efficacy_down -> RECEIVED_HEALING 枚举
# dmg_taken_down -> RECEIVED_DAMAGE 枚举（与 dmg_taken_up 共用，正负值区分）
EVADE = SkillEffectType.EVADE.value
ACTION_DAMAGE = SkillEffectType.ACTION_DAMAGE.value
CONFLAGRATION = SkillEffectType.CONFLAGRATION.value
RECEIVED_HEALING = SkillEffectType.RECEIVED_HEALING.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
DEBUFF_IMMUNE = "debuff_immune"  # debuff_immune 直接以字符串形式存为 buff.effect_type


class TestActor125301(unittest.TestCase):
    """角色125301 雪山もこもこ少女 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 125301 雪山もこもこ少女 (属性3, EN型character_type=2, 前排position_type=1, role_type=2)
        # AP=2, PP=2。默认Lv10，部分测试用Lv15验证Lv11+分支
        # caster 放前排中央（角色为前排型）
        self.caster = UnitState(
            unit_id="caster", name="雪山もこもこ少女", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=125301, level=10,
            element=3, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110042, 120095, 120096, 130103, 130104],
            skill_levels={110042: 10, 120095: 10, 120096: 10,
                          130103: 10, 130104: 10},
            skill_cooldowns={},
        )

        # 友方后排中央（caster 正后方友方，用于部分测试）
        self.ally_back = UnitState(
            unit_id="ally_back", name="後方友方", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=999101, level=10,
            element=3, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央（最近敌，EN攻击主目标）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（多目标测试用）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（多目标测试用）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=4500, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方中后排（列攻击测试用，与 enemy_cf 同列）
        self.enemy_cb = UnitState(
            unit_id="enemy_cb", name="敵中後", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=999005, level=10,
            element=2, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=7500, defense=5500, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally_back]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf, self.enemy_cb]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.level = 10
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10

    def _reset_ally_back(self, hp=None, ap=10, pp=10, ep=0):
        """重置后方友方状态。"""
        self.ally_back.current_hp = hp if hp is not None else self.ally_back.max_hp
        self.ally_back.buffs = []
        self.ally_back.debuffs = []
        self.ally_back.is_alive = True
        self.ally_back.skill_cooldowns = {}
        self.ally_back.current_ap = ap
        self.ally_back.current_pp = pp
        self.ally_back.current_ep = ep

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ap = 4

    # ════════════════════════════════════════════════════════════════
    # EX: 110042 雪山とジュリーだるま？
    # ════════════════════════════════════════════════════════════════

    def test_ex_block1_damage_enemy_multi(self):
        """EX(110042) Block1: 敵3体EN攻撃（target_count=3, 3hits/目标）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证最近敌方(enemy_cf)受到EN伤害
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "enemy_cf应受到EX EN伤害")
        # EX flags.target_count=3 → 3体攻击，最近的3个敌方都应受伤
        # caster在ALLY_CENTER_FRONT，最近的3个敌方为 enemy_cf/enemy_lf/enemy_rf
        self.assertLess(self.enemy_lf.current_hp, self.enemy_lf.max_hp,
                        "enemy_lf应受到EX伤害（target_count=3的多体攻击）")
        self.assertLess(self.enemy_rf.current_hp, self.enemy_rf.max_hp,
                        "enemy_rf应受到EX伤害（target_count=3的多体攻击）")
        # enemy_cb 在中后排，距离较远，不在前3目标内
        self.assertEqual(self.enemy_cb.current_hp, self.enemy_cb.max_hp,
                         "enemy_cb不应受到EX伤害（距离较远，不在target_count=3内）")

    def test_ex_grants_perfect_evasion_to_self(self):
        """EX(110042) Block1: self perfect_evasion(hit_limited=1)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )

        # 验证 caster 自身获得 perfect_evasion buff
        evades = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertGreater(len(evades), 0, "EX执行后 caster 应有 perfect_evasion buff")
        self.assertEqual(getattr(evades[0], 'hit_limited', 0), 1,
                         "perfect_evasion hit_limited应为1")

    def test_ex_grants_debuff_immune_to_self(self):
        """EX(110042) Block1: self debuff_immune(duration=1 action)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )

        # 验证 caster 自身获得 debuff_immune buff
        immunes = [b for b in self.caster.buffs if b.effect_type == DEBUFF_IMMUNE]
        self.assertGreater(len(immunes), 0, "EX执行后 caster 应有 debuff_immune buff")
        self.assertEqual(immunes[0].duration, 1, "debuff_immune duration应为1")

    def test_ex_lv10_no_block2(self):
        """EX(110042) Lv10: 无Block2(any_target_survived未满足level_min=11)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[110042] = 10

        hp_before = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )
        hp_loss = hp_before - self.enemy_cf.current_hp

        # Lv10 时 Block2 跳过，仅有 Block1 的伤害（3hits）
        # 验证：伤害存在但不包含Block2追加伤害
        self.assertGreater(hp_loss, 0, "Lv10时应造成Block1伤害")

    def test_ex_lv11_block2_when_target_survived(self):
        """EX(110042) Lv11+: any_target_survived 满足时执行Block2追加伤害。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[110042] = 15

        hp_before = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )
        hp_loss = hp_before - self.enemy_cf.current_hp

        # Lv15 + enemy_cf存活 → Block2 执行，追加伤害
        self.assertGreater(hp_loss, 0, "Lv15+目标存活时应造成Block1+Block2伤害")
        # enemy_cf 仍存活（伤害未致死）
        self.assertGreater(self.enemy_cf.current_hp, 0, "enemy_cf应仍存活")

    def test_ex_lv11_block2_skipped_when_target_dead(self):
        """EX(110042) Lv11+: any_target_survived 不满足(目标阵亡)时跳过Block2。

        场景：设置 enemy_cf HP 极低，Block1伤害击杀后Block2应跳过。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[110042] = 15
        # 设置 enemy_cf HP 极低，确保Block1击杀
        self.enemy_cf.current_hp = 100

        # 执行EX（Block1击杀 enemy_cf，Block2因any_target_survived不满足而跳过）
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110042, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_cf 应被Block1击杀
        self.assertLessEqual(self.enemy_cf.current_hp, 0,
                             "enemy_cf应被Block1击杀")

    # ════════════════════════════════════════════════════════════════
    # AS1: 120095 みんなで雪遊び！
    # ════════════════════════════════════════════════════════════════

    def test_as1_block1_damage_enemy_column(self):
        """AS1(120095) Block1: 敵一列EN攻撃（威力tag）。

        enemy_column 应命中 enemy_cf（中前）和 enemy_cb（中后）。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120095, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证中列敌方（enemy_cf, enemy_cb）受到伤害
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "enemy_cf应受到AS1列攻击伤害")
        self.assertLess(self.enemy_cb.current_hp, self.enemy_cb.max_hp,
                        "enemy_cb应受到AS1列攻击伤害")
        # 验证非同列敌方不受伤害
        self.assertEqual(self.enemy_lf.current_hp, self.enemy_lf.max_hp,
                         "enemy_lf不应受到AS1伤害（非同列）")
        self.assertEqual(self.enemy_rf.current_hp, self.enemy_rf.max_hp,
                         "enemy_rf不应受到AS1伤害（非同列）")

    def test_as1_grants_dmg_taken_down_to_self(self):
        """AS1(120095) Block1: self dmg_taken_down(stackable, attack_limited=1, 永续duration=-1)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=120095, battlefield=self.bf, skip_cost=True
        )

        # 验证 caster 获得 dmg_taken_down buff
        dmg_downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(dmg_downs), 0, "AS1应给caster付与 dmg_taken_down buff")
        self.assertTrue(dmg_downs[0].is_stackable, "dmg_taken_down应可叠加")
        self.assertEqual(getattr(dmg_downs[0], 'attack_limited', 0), 1,
                         "dmg_taken_down attack_limited应为1")

    def test_as1_lv10_no_lifesteal(self):
        """AS1(120095) Lv10: 无lifesteal（Block2 level_min=11 未满足）。"""
        self._reset_caster(hp=self.caster.max_hp * 0.5)  # HP=50% 以便观察治疗
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[120095] = 10

        hp_before = self.caster.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=120095, battlefield=self.bf, skip_cost=True
        )

        # Lv10 时 Block2 跳过 → caster HP 不应因lifesteal增加
        # 注意：AS1本身无治疗，仅造成伤害，caster HP应保持不变
        self.assertEqual(self.caster.current_hp, hp_before,
                         "Lv10时无lifesteal，caster HP应不变")

    def test_as1_lv11_lifesteal_heals_self(self):
        """AS1(120095) Lv11+: Block2 lifesteal(value=20%) 治疗 caster 自身。"""
        self._reset_caster(hp=self.caster.max_hp * 0.5)  # HP=50% 以便观察治疗
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[120095] = 15

        hp_before = self.caster.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=120095, battlefield=self.bf, skip_cost=True
        )

        # Lv15 + 造成伤害 → lifesteal 治疗 caster
        self.assertGreater(self.caster.current_hp, hp_before,
                           "Lv15+lifesteal应治疗caster（HP应增加）")

    # ════════════════════════════════════════════════════════════════
    # AS2: 120096 雪合戦開始！
    # ════════════════════════════════════════════════════════════════

    def test_as2_block1_damage_enemy_single(self):
        """AS2(120096) Block1: 敵単体EN攻撃（威力tag）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证最近敌方(enemy_cf)受到EN伤害
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "enemy_cf应受到AS2 EN伤害")
        # 验证仅单体受伤
        self.assertEqual(self.enemy_lf.current_hp, self.enemy_lf.max_hp,
                         "enemy_lf不应受到AS2伤害（单体）")

    def test_as2_grants_action_damage_to_target(self):
        """AS2(120096) Block1: 敵単体 action_damage(value=10=atk*10%, duration=3 actions)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )

        # 验证 enemy_cf 获得 action_damage debuff
        action_damages = [d for d in self.enemy_cf.debuffs if d.effect_type == ACTION_DAMAGE]
        self.assertGreater(len(action_damages), 0, "AS2应给enemy_cf付与 action_damage debuff")
        self.assertEqual(action_damages[0].duration, 3, "action_damage duration应为3")
        # value=10 表示 atk*10%
        self.assertEqual(action_damages[0].value, 10, "action_damage value应为10")

    def test_as2_action_damage_dot_triggers_on_action(self):
        """AS2(120096) action_damage: 目标行动时受到施法者攻击力*10%的EN伤害。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # Step 1: 施放AS2，给 enemy_cf 付与 action_damage
        self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )
        action_damages = [d for d in self.enemy_cf.debuffs if d.effect_type == ACTION_DAMAGE]
        self.assertGreater(len(action_damages), 0, "应已付与 action_damage")

        # Step 2: 调用 status_service.apply_action_damage 模拟目标行动时的DoT
        hp_before = self.enemy_cf.current_hp
        total_dmg, _ = self.sts.apply_action_damage(self.enemy_cf)

        # 验证 enemy_cf 受到 action_damage 伤害
        self.assertGreater(total_dmg, 0, "action_damage应造成伤害")
        self.assertLess(self.enemy_cf.current_hp, hp_before,
                        "enemy_cf HP应因action_damage减少")

    def test_as2_block2_target_hp_below_35(self):
        """AS2(120096) Block2: target_hp_below 35% 满足时追加伤害。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 设置 enemy_cf HP=20%（<35%）
        self.enemy_cf.current_hp = int(self.enemy_cf.max_hp * 0.20)

        hp_before = self.enemy_cf.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block2 应执行 → enemy_cf 受到 Block1 + Block2 伤害
        hp_loss = hp_before - self.enemy_cf.current_hp
        self.assertGreater(hp_loss, 0, "HP<35%时应造成Block1+Block2伤害")

    def test_as2_block2_skipped_when_hp_above_35(self):
        """AS2(120096) Block2: target_hp_below 35% 不满足时跳过Block2。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 设置 enemy_cf HP=80%（>35%）
        self.enemy_cf.current_hp = int(self.enemy_cf.max_hp * 0.80)

        hp_before = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )

        # Block2 跳过 → 仅Block1伤害
        hp_loss = hp_before - self.enemy_cf.current_hp
        self.assertGreater(hp_loss, 0, "HP>35%时仍应有Block1伤害")
        # enemy_cf 仍存活
        self.assertGreater(self.enemy_cf.current_hp, 0, "enemy_cf应存活")

    # ════════════════════════════════════════════════════════════════
    # PS1: 130103 いちばんのりー！（on_turn_start + attacker_hp_ratio_gt_self）
    # ════════════════════════════════════════════════════════════════

    def test_ps1_triggers_on_turn_start(self):
        """PS1(130103) on_turn_start: 回合开始时触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_turn_start(self.bf)
        ps1_actions = [a for a in actions if a.skill_id == 130103]
        self.assertGreater(len(ps1_actions), 0,
                           "on_turn_start 应收集 PS1(130103)")

    def test_ps1_grants_dmg_taken_down_to_self(self):
        """PS1(130103) Block1: self dmg_taken_down(attacker_hp_ratio_gt_self, stackable, attack_limited=1)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_turn_start(self.bf)
        ps1_actions = [a for a in actions if a.skill_id == 130103]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证 caster 获得 dmg_taken_down buff
        dmg_downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(dmg_downs), 0, "PS1应给caster付与 dmg_taken_down buff")
        self.assertTrue(getattr(dmg_downs[0], 'attacker_hp_ratio_gt_self', False),
                        "dmg_taken_down应有 attacker_hp_ratio_gt_self 标记")
        self.assertTrue(dmg_downs[0].is_stackable, "dmg_taken_down应可叠加")
        self.assertEqual(getattr(dmg_downs[0], 'attack_limited', 0), 1,
                         "dmg_taken_down attack_limited应为1")

    def test_ps1_attacker_hp_ratio_gt_self_active(self):
        """PS1(130103) attacker_hp_ratio_gt_self: 攻击者HP比例>自身时减伤生效。

        场景：caster HP=50%, attacker HP=80% → 减伤生效。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: 触发PS1，给caster付与dmg_taken_down buff
        actions = self.ts.trigger_turn_start(self.bf)
        ps1_actions = [a for a in actions if a.skill_id == 130103]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_turn_start"
        )

        # Step 2: 设置 HP 比例：caster=50%, enemy_cf=80%
        self.caster.current_hp = int(self.caster.max_hp * 0.50)
        self.enemy_cf.current_hp = int(self.enemy_cf.max_hp * 0.80)

        # 验证 damage_service 的 received_damage_multiplier < 1.0（减伤生效）
        mult = self.dms._get_damage_received_multiplier(
            self.caster, damage_element=0, attacker=self.enemy_cf
        )
        self.assertLess(mult, 1.0,
                        f"攻击者HP(80%)>自身HP(50%)时减伤应生效，mult={mult}应<1.0")

    def test_ps1_attacker_hp_ratio_gt_self_inactive(self):
        """PS1(130103) attacker_hp_ratio_gt_self: 攻击者HP比例<=自身时减伤不生效。

        场景：caster HP=50%, attacker HP=30% → 减伤不生效。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: 触发PS1，给caster付与dmg_taken_down buff
        actions = self.ts.trigger_turn_start(self.bf)
        ps1_actions = [a for a in actions if a.skill_id == 130103]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_turn_start"
        )

        # Step 2: 设置 HP 比例：caster=50%, enemy_cf=30%
        self.caster.current_hp = int(self.caster.max_hp * 0.50)
        self.enemy_cf.current_hp = int(self.enemy_cf.max_hp * 0.30)

        # 验证 damage_service 的 received_damage_multiplier = 1.0（减伤不生效）
        mult = self.dms._get_damage_received_multiplier(
            self.caster, damage_element=0, attacker=self.enemy_cf
        )
        self.assertEqual(mult, 1.0,
                         f"攻击者HP(30%)<=自身HP(50%)时减伤不应生效，mult={mult}应=1.0")

    def test_ps1_lv11_self_hp_below_35_add_ep(self):
        """PS1(130103) Block2 Lv11+: self_hp_below 35% -> self add_ep(value=1)。

        PP消耗会自然产生1 EP（consume_pp→generate_ep），Block2 add_ep再+1，
        所以 Lv15+HP<35% 时 EP应增加2（1来自PP消耗 + 1来自Block2 add_ep）。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10, ep=0)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 15
        self.caster.skill_levels[130103] = 15
        # 设置 caster HP=20%（<35%）
        self.caster.current_hp = int(self.caster.max_hp * 0.20)

        ep_before = self.caster.current_ep
        actions = self.ts.trigger_turn_start(self.bf)
        ps1_actions = [a for a in actions if a.skill_id == 130103]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_turn_start"
        )

        # Lv15+HP<35%: EP 应增加2（PP消耗+1 + Block2 add_ep +1）
        ep_gain = self.caster.current_ep - ep_before
        self.assertEqual(ep_gain, 2,
                         f"Lv15+HP<35%时EP应增加2（PP消耗+Block2 add_ep），实际增加{ep_gain}")

    def test_ps1_lv10_no_ep_when_hp_below_35(self):
        """PS1(130103) Lv10: self_hp_below 35% 满足但 level_min=11 未满足 -> 无 Block2 add_ep。

        PP消耗会自然产生1 EP（consume_pp→generate_ep），这是PS执行的副产物，
        与Block2的add_ep无关。Lv10时Block2跳过，所以EP只增加1（仅来自PP消耗）。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10, ep=0)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130103] = 10
        # 设置 caster HP=20%（<35%）
        self.caster.current_hp = int(self.caster.max_hp * 0.20)

        ep_before = self.caster.current_ep
        actions = self.ts.trigger_turn_start(self.bf)
        ps1_actions = [a for a in actions if a.skill_id == 130103]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_turn_start"
        )

        # Lv10 时 Block2 跳过 → EP 仅增加1（来自PP消耗的generate_ep，非Block2 add_ep）
        ep_gain = self.caster.current_ep - ep_before
        self.assertEqual(ep_gain, 1,
                         f"Lv10时EP应仅增加1（PP消耗），无Block2 add_ep，实际增加{ep_gain}")

    # ════════════════════════════════════════════════════════════════
    # PS2: 130104 防寒はバッチリ！（after_as_attack+allow_ex_trigger）
    # ════════════════════════════════════════════════════════════════

    def test_ps2_triggers_after_as_attack(self):
        """PS2(130104) after_as_attack: AS攻击后触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # caster 执行AS2攻击 enemy_cf
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 触发 after_as_attack
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120096, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130104]
        self.assertGreater(len(ps2_actions), 0,
                           "after_as_attack 应收集 PS2(130104)")

    def test_ps2_grants_burn_to_attacked_targets(self):
        """PS2(130104) Block1: attacked_targets burn(atk*30%, 2 actions)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # caster 执行AS2攻击 enemy_cf
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120096, battlefield=self.bf, skip_cost=True
        )

        # 触发PS2
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120096, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130104]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="after_as_attack"
        )

        # 验证 enemy_cf 获得 burn debuff
        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        self.assertGreater(len(burns), 0, "PS2应给enemy_cf付与 burn debuff")
        self.assertEqual(burns[0].duration, 2, "burn duration应为2")
        # burn value = caster.attack * 30 / 100 = 10000 * 0.3 = 3000
        self.assertGreater(burns[0].value, 0, "burn value应>0（基于施法者攻击力）")

