"""分析解析失败的技能，找出需要补充的模式"""
import json
from collections import Counter

def analyze_failed():
    with open('data/skills.json', 'r', encoding='utf-8') as f:
        skills = json.load(f)
    with open('data/skill_effects_parsed.json', 'r', encoding='utf-8') as f:
        parsed = json.load(f)
    
    failed_ids = [k for k, v in parsed.items() if v['parse_status'] == 'failed']
    
    # 过滤出40XXXX和非30XXXX技能
    memory_card_ids = [fid for fid in failed_ids if fid.startswith('40')]
    other_ids = [fid for fid in failed_ids if not fid.startswith('30') and not fid.startswith('40')]
    
    print(f"失败技能总数: {len(failed_ids)}")
    print(f"  30XXXX(迷宫，跳过): {len([f for f in failed_ids if f.startswith('30')])}")
    print(f"  40XXXX(回忆卡): {len(memory_card_ids)}")
    print(f"  其他: {len(other_ids)}")
    
    
    # Write to file for better viewing
    with open('failed_40xxxx.txt', 'w', encoding='utf-8') as f:
        f.write(f"失败技能总数: {len(failed_ids)}\n")
        f.write(f"  30XXXX(迷宫，跳过): {len([fid for fid in failed_ids if fid.startswith('30')])}\n")
        f.write(f"  40XXXX(回忆卡): {len(memory_card_ids)}\n")
        f.write(f"  其他: {len(other_ids)}\n\n")
        
        f.write("=== 回忆卡技能(40XXXX) ===\n")
        for fid in memory_card_ids:
            skill = skills[fid]
            template = skill['descriptions'][0]['template'] if skill['descriptions'] else '(无模板)'
            f.write(f"\n[{fid}] {skill['name']}\n")
            f.write(f"  {template}\n")
        
        f.write("\n=== 其他失败技能 ===\n")
        for fid in other_ids:
            skill = skills[fid]
            template = skill['descriptions'][0]['template'] if skill['descriptions'] else '(无模板)'
            f.write(f"\n[{fid}] {skill['name']}\n")
            f.write(f"  {template}\n")
    
    print(f"失败技能总数: {len(failed_ids)}")
    print(f"  30XXXX(迷宫，跳过): {len([fid for fid in failed_ids if fid.startswith('30')])}")
    print(f"  40XXXX(回忆卡): {len(memory_card_ids)}")
    print(f"  其他: {len(other_ids)}")
    print("\n详细信息已写入 failed_40xxxx.txt")

if __name__ == '__main__':
    analyze_failed()
