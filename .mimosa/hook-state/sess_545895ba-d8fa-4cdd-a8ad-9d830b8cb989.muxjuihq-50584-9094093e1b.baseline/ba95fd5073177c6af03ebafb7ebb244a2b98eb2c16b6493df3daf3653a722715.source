    # PS1: 130101 お清め (on_pawn_died)
    # ════════════════════════════════════════════════════════════════

    def test_ps1_triggers_on_enemy_death(self):
        """PS1(130101) on_pawn_died: 敌方阵亡时触发（敵または他の味方が倒された際に発動）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 敌方阵亡
        self.enemy_cf.is_alive = False

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )

        ps1_actions = [a for a in actions if a.skill_id == 130101]
        self.assertGreater(len(ps1_actions), 0, "敌方阵亡时PS1应触发")

    def test_ps1_triggers_on_ally_death(self):
        """PS1(130101) on_pawn_died: 友方（非自身）阵亡时也触发。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally2()
        # 友方阵亡
        self.ally2.is_alive = False

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally2], battlefield=self.bf
        )

        ps1_actions = [a for a in actions if a.skill_id == 130101]
        self.assertGreater(len(ps1_actions), 0, "友方阵亡时PS1应触发")

    def test_ps1_not_triggers_on_self_death(self):
        """PS1(130101) on_pawn_died: 自身阵亡时不触发（owner.unit_id in dead_units → 排除）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 施法者自身阵亡
        self.caster.is_alive = False

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.caster], battlefield=self.bf
        )

        ps1_actions = [a for a in actions if a.skill_id == 130101]
        self.assertEqual(len(ps1_actions), 0, "自身阵亡时PS1不应触发")

    def test_ps1_heals_self_max_hp_pct(self):
        """PS1(130101) 触发后: 自身heal[max_hp×cure%](Lv10: cure=10% → 2000HP回复)。"""
        self._reset_caster(hp=10000, pp=10)  # HP降低以观察回复
        self._reset_enemies()
        self.enemy_cf.is_alive = False

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )
        ps1_actions = [a for a in actions if a.skill_id == 130101]
        self.assertGreater(len(ps1_actions), 0)

        hp_before = self.caster.current_hp
        self._execute_ps_via_inline(ps1_actions, "on_pawn_died")

        # cure Lv10=10%, max_hp=20000 → heal=2000
        # caster HP应增加（约2000，受max_hp上限）
        self.assertGreater(self.caster.current_hp, hp_before,
                           "PS1应治疗自身（max_hp×cure%）")

    def test_ps1_max_hp_up_5pct_stacking(self):
        """PS1(130101) max_hp_up 5%(永続, stackable) → max_hp增加 5% of base_max_hp。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.enemy_cf.is_alive = False

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )
        ps1_actions = [a for a in actions if a.skill_id == 130101]

        max_hp_before = self.caster.max_hp
        self._execute_ps_via_inline(ps1_actions, "on_pawn_died")

        # max_hp_up 5% of base_max_hp(20000) = 1000
        # max_hp 应增加约 1000
        hp_increase = self.caster.max_hp - max_hp_before
        self.assertGreater(hp_increase, 0, "PS1应增加max_hp")
        self.assertAlmostEqual(hp_increase, 1000, delta=50,
                               msg=f"max_hp_up 5% of 20000 = 1000，实际: {hp_increase}")

    def test_ps1_max_hp_up_unremovable(self):
        """PS1(130101) max_hp_up unremovable=true（解除不可）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.enemy_cf.is_alive = False

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )
        ps1_actions = [a for a in actions if a.skill_id == 130101]
        self._execute_ps_via_inline(ps1_actions, "on_pawn_died")

        # max_hp_up 直接修改 max_hp，不创建buff。验证max_hp确实增加即可。
        self.assertGreater(self.caster.max_hp, 20000,
                           "PS1 max_hp_up应使max_hp增加（unremovable标记不创建buff，直接修改max_hp）")

    def test_ps1_resets_as1_cooldown(self):
        """PS1(130101) reset_cooldown AS1(120093) - 重置AS1的99回合冷却。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 预设AS1在冷却中
        self.caster.skill_cooldowns[120093] = 99
        self.enemy_cf.is_alive = False

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )
        ps1_actions = [a for a in actions if a.skill_id == 130101]
        self._execute_ps_via_inline(ps1_actions, "on_pawn_died")

        # AS1的冷却应被重置
        self.assertNotIn(120093, self.caster.skill_cooldowns,
                         "PS1应reset_cooldown AS1(120093)")

    def test_ps1_grants_omochi_mark(self):
        """PS1(130101) 触发后: 自身付与「お餅」mark(永続, stackable, is_buff_mark)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.enemy_cf.is_alive = False

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )
        ps1_actions = [a for a in actions if a.skill_id == 130101]
        self._execute_ps_via_inline(ps1_actions, "on_pawn_died")

        # 验证お餅 mark
        marks = [b for b in self.caster.buffs
                 if b.effect_type == MARK and b.name == "お餅"]
        self.assertEqual(len(marks), 1, "PS1应施加1个お餅mark到自身")
        self.assertFalse(marks[0].is_debuff, "お餅mark应为buff")
        self.assertEqual(marks[0].duration, -1, "お餅mark duration应为-1(永続)")
        self.assertTrue(marks[0].is_stackable, "お餅mark应可叠加")

    def test_ps1_max_hp_up_stacks_multiple_triggers(self):
        """PS1(130101) max_hp_up 永続stacking: 多次触发max_hp持续叠加。

        注：PS1 cooldown=1，第一次触发后冷却会被设置为1。本测试关注的是max_hp_up
        永続stacking行为（不关注cooldown机制），故在两次触发之间手动清除冷却。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        max_hp_initial = self.caster.max_hp

        # 第一次触发
        self.enemy_cf.is_alive = False
        actions1 = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )
        ps1_actions1 = [a for a in actions1 if a.skill_id == 130101]
        self._execute_ps_via_inline(ps1_actions1, "on_pawn_died")
        max_hp_after_1 = self.caster.max_hp

        # 清除PS1冷却（本测试关注max_hp_up stacking，不关注cooldown机制）
        self.caster.skill_cooldowns.pop(130101, None)

        # 第二次触发（另一个敌方阵亡）
        self.enemy_lf.is_alive = False
        actions2 = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_lf], battlefield=self.bf, killer=self.caster
        )
        ps1_actions2 = [a for a in actions2 if a.skill_id == 130101]
        self._execute_ps_via_inline(ps1_actions2, "on_pawn_died")
        max_hp_after_2 = self.caster.max_hp

        # 验证max_hp持续增加（永続stacking）
        self.assertGreater(max_hp_after_1, max_hp_initial, "第一次触发应增加max_hp")
        self.assertGreater(max_hp_after_2, max_hp_after_1, "第二次触发应继续叠加max_hp")
        # 每次增加约1000（5% of 20000）
        increase_1 = max_hp_after_1 - max_hp_initial
        increase_2 = max_hp_after_2 - max_hp_after_1
        self.assertAlmostEqual(increase_1, 1000, delta=50,
                               msg=f"第一次max_hp增加应≈1000，实际: {increase_1}")
        self.assertAlmostEqual(increase_2, 1000, delta=50,
                               msg=f"第二次max_hp增加应≈1000，实际: {increase_2}")

