    def test_as1_block1_value_scales_with_omochi_count_8_capped_at_6(self):
        """AS1(120093) Block1 Lv11+: 8个お餅mark时 value×min(8,6)=6（max_count=6封顶）。"""
        self._reset_caster(hp=self.caster.max_hp)
