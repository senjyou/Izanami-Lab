    # ════════════════════════════════════════════════════════════════
    # AS2: 120094 お祓い
    # ════════════════════════════════════════════════════════════════

    def test_as2_damage_to_enemy_single(self):
        """AS2(120094) Block1: enemy_single 索敌对最近的敌方单体造成伤害。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120094, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 至少一个敌方应受到伤害（enemy_single 索敌最近敌方）
        total_dmg = (hp_cf_before - self.enemy_cf.current_hp +
                     hp_lf_before - self.enemy_lf.current_hp +
                     hp_rf_before - self.enemy_rf.current_hp)
        self.assertGreater(total_dmg, 0, "AS2应造成伤害")

    def test_as2_applies_atk_down_5pct_stackable(self):
        """AS2(120094) Block1: 对attacked_targets施加 atk_down 5%(1action, stackable)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120094, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 被攻击的敌方应有 atk_down debuff
        any_atk_down = False
        for e in self.bf.enemy_team:
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            if len(atk_downs) > 0:
                any_atk_down = True
                self.assertEqual(atk_downs[0].value, 5, "atk_down value应为5(5%)")
                self.assertEqual(atk_downs[0].duration, 1, "atk_down duration应为1(1action)")
                self.assertTrue(atk_downs[0].is_stackable, "atk_down应可叠加(stackable=true)")
                break
        self.assertTrue(any_atk_down, "至少一个敌方应有atk_down debuff")

    def test_as2_atk_down_stacks_multiple(self):
        """AS2(120094) atk_down stackable=true → 多次施放可叠加。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 第一次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=120094, battlefield=self.bf, skip_cost=True
        )
        atk_downs_after_1 = []
        for e in self.bf.enemy_team:
            atk_downs_after_1.extend([d for d in e.debuffs if d.effect_type == STATUS_ATTACK])

        # 第二次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=120094, battlefield=self.bf, skip_cost=True
        )
        atk_downs_after_2 = []
        for e in self.bf.enemy_team:
            atk_downs_after_2.extend([d for d in e.debuffs if d.effect_type == STATUS_ATTACK])

        # 第二次后应有更多atk_down实例（叠加）
        self.assertGreaterEqual(len(atk_downs_after_2), len(atk_downs_after_1),
                                "多次施放AS2应使atk_down叠加（数量不减少）")

