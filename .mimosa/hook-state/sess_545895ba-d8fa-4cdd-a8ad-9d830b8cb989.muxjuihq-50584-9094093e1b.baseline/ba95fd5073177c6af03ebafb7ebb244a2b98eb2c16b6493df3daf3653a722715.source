    # ════════════════════════════════════════════════════════════════
    # お餅mark 全链专项验证
    # ════════════════════════════════════════════════════════════════

    def test_omochi_mark_granted_by_ex_and_ps1(self):
        """お餅mark 由 EX/PS1 付与自身(buffs列表, stackable) → 可叠加共存。"""
        # EX 付与
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.ss.execute_skill(
            caster=self.caster, skill_id=110041, battlefield=self.bf, skip_cost=True
        )
        omochi_after_ex = [b for b in self.caster.buffs
                           if b.effect_type == MARK and b.name == "お餅"]
        self.assertEqual(len(omochi_after_ex), 1, "EX应付与1个お餅mark")

        # PS1 触发也付与（再+1）
        self.enemy_cf.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )
        ps1_actions = [a for a in actions if a.skill_id == 130101]
        self._execute_ps_via_inline(ps1_actions, "on_pawn_died")

        omochi_after_ps1 = [b for b in self.caster.buffs
                            if b.effect_type == MARK and b.name == "お餅"]
        self.assertEqual(len(omochi_after_ps1), 2,
                         "EX+PS1后应有2个お餅mark(stackable共存)")

    def test_omochi_full_chain_ex_as1_ps1(self):
        """お餅mark全链: EX付与→AS1消费(Lv11+ scaling)→PS1再付与+max_hp_up→reset_cooldown循环。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[110041] = 11
        self.caster.skill_levels[120093] = 11
        self.caster.skill_levels[130101] = 11

        # 1. EX付与お餅mark + reset_cooldown AS1
        self.caster.skill_cooldowns[120093] = 99  # AS1在冷却
        result_ex = self.ss.execute_skill(
            caster=self.caster, skill_id=110041, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_ex["success"])

        # 验证EX后: お餅mark 1个, AS1冷却被重置
        omochi_after_ex = [b for b in self.caster.buffs
                          if b.effect_type == MARK and b.name == "お餅"]
        self.assertEqual(len(omochi_after_ex), 1, "EX后应有1个お餅mark")
        self.assertNotIn(120093, self.caster.skill_cooldowns,
                         "EX应reset AS1冷却")

        # 2. AS1消费お餅mark scaling (1個お餅 → atk=1.5×1=1.5, def=3×1=3)
        result_as1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as1["success"])

        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "AS1 Block1应执行（お餅1個）")
        self.assertAlmostEqual(atk_ups[0].value, 1.5, delta=0.1,
                               msg="1個お餅→atk_up=1.5×1=1.5")

        # 3. PS1再付与お餅mark + max_hp_up
        self.enemy_cf.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )
        ps1_actions = [a for a in actions if a.skill_id == 130101]
        max_hp_before_ps1 = self.caster.max_hp
        self._execute_ps_via_inline(ps1_actions, "on_pawn_died")

        # 验证PS1后: お餅mark增加, max_hp增加, AS1冷却被重置
        omochi_after_ps1 = [b for b in self.caster.buffs
                            if b.effect_type == MARK and b.name == "お餅"]
        self.assertGreater(len(omochi_after_ps1), len(omochi_after_ex),
                           "PS1应再付与お餅mark（数量增加）")
        self.assertGreater(self.caster.max_hp, max_hp_before_ps1,
                           "PS1应增加max_hp(max_hp_up)")

    def test_omochi_max_count_6_cap(self):
        """AS1 Block1 value_scales_with_self_mark_count max_count=6 → 超过6个mark时封顶。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[120093] = 11
        # 预设10个お餅mark（超过max_count=6）
        self._apply_omochi_mark(self.caster, count=10)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # atk_up value = atk(Lv11=1.5) × min(10,6) = 1.5 × 6 = 9.0（封顶在6）
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0)
        self.assertAlmostEqual(atk_ups[0].value, 9.0, delta=0.1,
                               msg="10個お餅→max_count=6封顶→atk_up=1.5×6=9.0")

    # ════════════════════════════════════════════════════════════════
    # reset_cooldown 链专项验证
    # ════════════════════════════════════════════════════════════════

    def test_reset_cooldown_chain_ex_to_as1(self):
        """reset_cooldown链: EX(110041) → AS1(120093)。AS1 cooldown=99 → EX后可再用。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 第一次AS1 - 执行后设置cooldown=99
        result_as1_1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as1_1["success"])
        # 手动设置cooldown（模拟update_cooldown_after_skill_use）
        self.ss.update_cooldown_after_skill_use(self.caster, 120093)
        self.assertEqual(self.caster.skill_cooldowns.get(120093, 0), 99,
                         "AS1使用后应设置cooldown=99")

        # 尝试再次AS1 - 应因cooldown被跳过
        result_as1_2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertFalse(result_as1_2.get("success", False),
                         "AS1 cooldown=99时不应再次使用")

        # 执行EX - reset_cooldown AS1
        result_ex = self.ss.execute_skill(
            caster=self.caster, skill_id=110041, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_ex["success"])
        self.assertNotIn(120093, self.caster.skill_cooldowns,
                         "EX后AS1冷却应被reset")

        # 再次AS1 - 应可使用
        result_as1_3 = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as1_3["success"],
                       "EX reset cooldown后AS1应可再次使用")

    def test_reset_cooldown_chain_ps1_to_as1(self):
        """reset_cooldown链: PS1(130101) → AS1(120093)。PS1触发后reset AS1 cooldown。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 设置AS1在冷却中
        self.caster.skill_cooldowns[120093] = 99

        # 触发PS1（敌方阵亡）
        self.enemy_cf.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )
        ps1_actions = [a for a in actions if a.skill_id == 130101]
        self.assertGreater(len(ps1_actions), 0, "PS1应触发")

        self._execute_ps_via_inline(ps1_actions, "on_pawn_died")

        # AS1冷却应被reset
        self.assertNotIn(120093, self.caster.skill_cooldowns,
                         "PS1应reset AS1冷却")

        # AS1应可使用
        result_as1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as1["success"],
                       "PS1 reset cooldown后AS1应可使用")

    def test_reset_cooldown_no_op_when_not_on_cooldown(self):
        """reset_cooldown: AS1不在冷却时，EX的reset_cooldown是no-op（不报错）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # AS1不在冷却中（skill_cooldowns为空）
        self.assertNotIn(120093, self.caster.skill_cooldowns)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110041, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # AS1仍不在冷却中（reset是no-op）
        self.assertNotIn(120093, self.caster.skill_cooldowns,
                         "AS1不在冷却时reset是no-op")


if __name__ == "__main__":
    unittest.main(verbosity=2)
