"""角色102302 新春のメイズ研究者 专项E2E测试（お餅mark全链 + reset_cooldown链 + on_pawn_died/on_cumulative_damage触发）

技能列表：
- EX: 110041 餅つき、よいしょ～！（敵全体攻撃[威力] + 2行動毒(10%当前HP)
  + reset_cooldown AS1(120093) + 自身お餅mark[永続, stackable, is_buff_mark]）
- AS1: 120093 除災招福（Block1 Lv11+: 自身atk_up/def_up[value_scales_with_self_mark_countお餅, max_count=6, 1action]
  ; Block2: 敵横一列3hit攻撃[威力] + lifesteal[25%] + heal_efficacy_down[100%, 2actions, attacked_targets]
  ; cooldown=99 (1度のみ, EX/PS1でreset)）
- AS2: 120094 お祓い（敵単体攻撃[威力] + atk_down[5%, 1action, stackable, attacked_targets]）
- PS1: 130101 お清め（on_pawn_died: 敵または他の味方が倒された際に発動
  ; 自身heal[max_hp×cure%] + max_hp_up[5%, 永続, stackable, unremovable]
  + reset_cooldown AS1(120093) + 自身お餅mark[永続, stackable]）
- PS2: 130102 災難除け（on_cumulative_damage + cumulative_damage_percent>=40%
  ; 自身shield[max_hp×shield%, 2actions] ; 触発後cumulative_hp_damage=0）

覆盖维度：
1. EX 敵全体攻撃 + 毒付与 + reset_cooldown AS1 + お餅mark付与
2. AS1 敵横一列3hit + lifesteal + heal_efficacy_down + value_scales_with_self_mark_count(0/3/6/cap)
3. AS2 敵単体攻撃 + atk_down(stackable)
4. PS1 on_pawn_died(敵/味方/自身) + heal + max_hp_up(stacking/unremovable) + reset_cooldown + お餅mark
5. PS2 on_cumulative_damage(>=40% max_hp) + shield + 边界(39/40/41%)
6. お餅mark全链专项: EX付与→AS1消費(scaling)→PS1再付与+max_hp_up→reset_cooldown循环
7. reset_cooldown链: EX→AS1, PS1→AS1
8. max_hp_up永続stacking: 多次触发叠加, unremovable
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction, TriggerTiming
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# atk_up/atk_down 共用 STATUS_ATTACK 枚举
# def_up/def_down 共用 STATUS_DEFENSE 枚举
# mark 用 MARK 枚举（buff mark 进 buffs 列表）
# poison 用 POISON 枚举（毒状態異常，进 debuffs 列表）
# shield 用 SHIELD 枚举（护盾，进 buffs 列表，盾值也累加到 unit.shield）
# max_hp_up 用 STATUS_MAX_HP 枚举（直接修改 max_hp，不创建buff）
# heal_efficacy_down 用 RECEIVED_HEALING 枚举（进 debuffs 列表）
MARK = SkillEffectType.MARK.value
POISON = SkillEffectType.POISON.value
SHIELD = SkillEffectType.SHIELD.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value
STATUS_MAX_HP = SkillEffectType.STATUS_MAX_HP.value
RECEIVED_HEALING = SkillEffectType.RECEIVED_HEALING.value

# AuraUpdateTiming 数值（用于断言 duration_type 映射）
# EPHEMERAL_SKILL_END=1, EPHEMERAL_MANEUVER_END=2,
# DURABLE_SOURCE_MANEUVER_END=3, DURABLE_TARGET_MANEUVER_END=4,
# DURABLE_WHEN_USED_ONCE_PER_SKILL=5, DURABLE_WHEN_USED=6
DURABLE_TARGET_MANEUVER_END = AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value   # 4: duration_type="action" 映射


class TestActor102302(unittest.TestCase):
    """角色102302 新春のメイズ研究者 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 102302 新春のメイズ研究者 (水属性attr=2, 物理型character_type=1, 前排position_type=1, 坦克role_type=3)
        # 默认Lv10，部分测试用Lv11/Lv15验证Lv11+分支
        # caster 放前排中央（坦克位）
        self.caster = UnitState(
            unit_id="caster", name="新春のメイズ研究者", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=102302, level=10,
            element=2, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110041, 120093, 120094, 130101, 130102],
            skill_levels={110041: 10, 120093: 10, 120094: 10,
                          130101: 10, 130102: 10},
            skill_cooldowns={},
        )

        # 敌方前排中央（enemy_row 候选）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（enemy_row 候选）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=12000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（enemy_row 候选）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=4500, speed=600,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方（非caster，用于on_pawn_died ally测试）
        self.ally2 = UnitState(
            unit_id="ally2", name="味方二号", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999010, level=10,
            element=1, character_type=1,
            max_hp=10000, current_hp=10000,
            attack=5000, defense=3000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=2, current_pp=2, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally2]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.is_stunned = False
        self.caster.is_frozen = False
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.skill_use_count = {}
        self.caster.cumulative_hp_damage = 0
        self.caster.shield = 0
        self.caster.level = 10
        # 重置 max_hp 到原始值（max_hp_up 可能修改了它）
        self.caster.max_hp = 20000
        self.caster._base_max_hp_for_calc = 20000
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.is_stunned = False
            e.is_frozen = False
            e.current_ap = 4
            e.shield = 0

    def _reset_ally2(self):
        """重置友方2号状态。"""
        self.ally2.current_hp = self.ally2.max_hp
        self.ally2.buffs = []
        self.ally2.debuffs = []
        self.ally2.is_alive = True
        self.ally2.is_stunned = False
        self.ally2.is_frozen = False

    def _apply_omochi_mark(self, target=None, count=1):
        """为指定目标附加「お餅」mark buff（is_buff_mark=true → buffs 列表，is_debuff=False）。

        102302 的核心 buff mark：お餅 驱动 AS1 Block1 的 value_scales_with_self_mark_count。
        通常由 EX/PS1 付与自身。
        """
        if target is None:
            target = self.caster
        for i in range(count):
            target.buffs.append(BuffState(
                buff_id=f"test_omochi_{id(target)}_{i}",
                name="お餅", effect_type=MARK, value=0,
                duration=-1, timing_type=2, is_debuff=False,
                is_stackable=True, unremovable=False,
            ))

    def _execute_ps_via_inline(self, actions, timing_name):
        """通过 _execute_trigger_actions_inline 执行PS trigger actions（公共辅助）。"""
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            actions, self.bf, trigger_timing=timing_name
        )

    # ════════════════════════════════════════════════════════════════
    # EX: 110041 餅つき、よいしょ～！
    # ════════════════════════════════════════════════════════════════

    def test_ex_damage_to_all_enemies(self):
        """EX(110041) Block1: enemy_all 索敌对所有敌方造成伤害。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110041, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 所有敌方都应受到伤害
        self.assertLess(self.enemy_cf.current_hp, hp_cf_before, "enemy_cf应受到EX伤害")
        self.assertLess(self.enemy_lf.current_hp, hp_lf_before, "enemy_lf应受到EX伤害")
        self.assertLess(self.enemy_rf.current_hp, hp_rf_before, "enemy_rf应受到EX伤害")

    def test_ex_applies_poison_2_actions(self):
        """EX(110041) Block1: 对所有敌方施加 2行動 poison(毒)debuff。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110041, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 所有敌方应被赋予 poison debuff
        for e in self.bf.enemy_team:
            poisons = [d for d in e.debuffs if d.effect_type == POISON]
            self.assertGreater(len(poisons), 0, f"{e.name}应有poison debuff")
            self.assertEqual(poisons[0].duration, 2, "poison duration应为2(2行動)")

    def test_ex_resets_as1_cooldown(self):
        """EX(110041) Block1: reset_cooldown AS1(120093) - 重置AS1的99回合冷却。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 预设AS1在冷却中（cooldown=99）
        self.caster.skill_cooldowns[120093] = 99

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110041, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # AS1的冷却应被重置（从skill_cooldowns中移除）
        self.assertNotIn(120093, self.caster.skill_cooldowns,
                         "EX应reset_cooldown AS1(120093)，冷却应被清除")

    def test_ex_grants_omochi_mark_to_self(self):
        """EX(110041) Block1: 自身付与「お餅」mark(is_buff_mark=true, stackable, 永続)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110041, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证お餅 mark 在 buffs 列表（is_buff_mark=true → is_debuff=False）
        marks = [b for b in self.caster.buffs
                 if b.effect_type == MARK and b.name == "お餅"]
        self.assertEqual(len(marks), 1, "应施加1个お餅mark")
        self.assertFalse(marks[0].is_debuff, "お餅mark应为buff（is_debuff=False）")
        self.assertTrue(marks[0].is_stackable, "お餅mark应可叠加(stackable=true)")
        self.assertEqual(marks[0].duration, -1, "お餅mark duration应为-1(永続)")

    def test_ex_omochi_mark_in_buffs_not_debuffs(self):
        """EX(110041) お餅mark is_buff_mark=true → 进 buffs 列表（不是 debuffs）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110041, battlefield=self.bf, skip_cost=True
        )

        marks_in_buffs = [b for b in self.caster.buffs
                          if b.effect_type == MARK and b.name == "お餅"]
        marks_in_debuffs = [d for d in self.caster.debuffs
                            if d.effect_type == MARK and d.name == "お餅"]
        self.assertEqual(len(marks_in_buffs), 1, "お餅mark应在buffs列表")
        self.assertEqual(len(marks_in_debuffs), 0, "お餅mark不应在debuffs列表")

    # ════════════════════════════════════════════════════════════════
    # AS1: 120093 除災招福
    # ════════════════════════════════════════════════════════════════

    def test_as1_block2_targets_enemy_row_3hits(self):
        """AS1(120093) Block2: enemy_row 索敌对敌方横一列3hit伤害。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 敌方横一列（前排3单位）都应受到伤害
        self.assertLess(self.enemy_cf.current_hp, hp_cf_before, "enemy_cf应受到AS1伤害")
        self.assertLess(self.enemy_lf.current_hp, hp_lf_before, "enemy_lf应受到AS1伤害")
        self.assertLess(self.enemy_rf.current_hp, hp_rf_before, "enemy_rf应受到AS1伤害")

    def test_as1_block2_lifesteal_25pct(self):
        """AS1(120093) Block2: lifesteal 25% - 回复造成伤害的25%。"""
        self._reset_caster(hp=10000, pp=10)  # caster HP降低以观察吸血效果
        self._reset_enemies()

        hp_before = self.caster.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # caster应通过吸血回复HP（造成伤害的25%）
        self.assertGreater(self.caster.current_hp, hp_before,
                           "AS1 lifesteal 25%应使caster回复HP")

    def test_as1_block2_heal_efficacy_down_on_attacked_targets(self):
        """AS1(120093) Block2: heal_efficacy_down 100% on attacked_targets (2actions)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 所有被攻击的敌方应被赋予 heal_efficacy_down debuff
        for e in self.bf.enemy_team:
            heal_downs = [d for d in e.debuffs if d.effect_type == RECEIVED_HEALING]
            self.assertGreater(len(heal_downs), 0, f"{e.name}应有heal_efficacy_down debuff")
            self.assertEqual(heal_downs[0].value, 100, "heal_efficacy_down value应为100(100%)")
            self.assertEqual(heal_downs[0].duration, 2, "heal_efficacy_down duration应为2(2actions)")

    def test_as1_block1_lv10_skipped(self):
        """AS1(120093) Block1: Lv10时跳过（active_level_min=11 未满足）→ 无atk_up/def_up。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 不施加お餅mark（即使有mark，Lv10也应跳过Block1）
        self._apply_omochi_mark(self.caster, count=3)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block1 atk_up/def_up 不应被施加（Lv10 < 11）
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        def_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertEqual(len(atk_ups), 0, "Lv10时Block1应跳过，无atk_up buff")
        self.assertEqual(len(def_ups), 0, "Lv10时Block1应跳过，无def_up buff")

    def test_as1_block1_lv11_atk_up_def_up_with_omochi(self):
        """AS1(120093) Block1 Lv11+: お餅mark存在时执行 atk_up/def_up(value_scales_with_self_mark_count)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[120093] = 11
        # 预设3个お餅mark
        self._apply_omochi_mark(self.caster, count=3)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block1 应执行：atk_up + def_up
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        def_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertGreater(len(atk_ups), 0, "Lv11+且有お餅mark时应有atk_up buff")
        self.assertGreater(len(def_ups), 0, "Lv11+且有お餅mark时应有def_up buff")
        # 验证可叠加
        self.assertTrue(atk_ups[0].is_stackable, "atk_up应可叠加(stackable=true)")
        self.assertTrue(def_ups[0].is_stackable, "def_up应可叠加(stackable=true)")
        # 验证duration=1 (1action)
        self.assertEqual(atk_ups[0].duration, 1, "atk_up duration应为1(1action)")

    def test_as1_block1_value_scales_with_omochi_count_0(self):
        """AS1(120093) Block1 Lv11+: 0个お餅mark时 value×0=0（buff仍创建但value=0）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[120093] = 11
        # 不施加お餅mark（0个）

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block1 应执行但 value=0（0个mark → value×0=0）
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        # buff可能被创建（value=0）或被跳过；至少Block1条件满足（Lv11+）
        if len(atk_ups) > 0:
            self.assertEqual(atk_ups[0].value, 0,
                             "0个お餅mark时atk_up value应为0(value×0=0)")

    def test_as1_block1_value_scales_with_omochi_count_3(self):
        """AS1(120093) Block1 Lv11+: 3个お餅mark时 value×3（atk=1.5×3=4.5, def=3×3=9）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[120093] = 11
        self._apply_omochi_mark(self.caster, count=3)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120093, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # atk_up value = atk(Lv11=1.5) × 3 = 4.5
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "应有atk_up buff")
        self.assertAlmostEqual(atk_ups[0].value, 4.5, delta=0.1,
                               msg=f"3个お餅→atk_up value应为1.5×3=4.5，实际: {atk_ups[0].value}")

        # def_up value = def(Lv11=3.0) × 3 = 9.0
        def_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertGreater(len(def_ups), 0, "应有def_up buff")
        self.assertAlmostEqual(def_ups[0].value, 9.0, delta=0.1,
                               msg=f"3个お餅→def_up value应为3.0×3=9.0，实际: {def_ups[0].value}")

