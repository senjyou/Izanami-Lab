    # 集成测试
    # ════════════════════════════════════════════════════════════════

    def test_integration_ex_kill_add_ap_full_chain(self):
        """集成: EX撃殺 → target_killed条件满足 → add_ap 自身AP+1 完整链路。"""
        self._reset_caster(hp=self.caster.max_hp, ap=3)
        self._reset_enemies()
        # 设置 enemy_cf HP 极低
        self.enemy_cf.current_hp = 50

        ap_before = self.caster.current_ap
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110001, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 完整链路验证
        self.assertFalse(self.enemy_cf.is_alive, "enemy_cf应被撃殺")
        self.assertEqual(self.caster.current_ap, ap_before + 1,
                         "撃殺時 caster AP应+1（target_killed → add_ap）")

    def test_integration_ps1_guard_then_attack_full_chain(self):
        """集成: PS1触发guard → 敌方攻击 → 伤害减少 → guard buff消耗 完整链路。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: 触发PS1 → guard buff付与
        actions = self.ts.trigger_before_any_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130009]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_any_attacked"
        )

        guard_buffs = [b for b in self.caster.buffs if b.effect_type == GUARD]
        self.assertGreater(len(guard_buffs), 0, "Step1: 应有guard buff")

        # Step 2: 记录caster HP，然后让enemy_cf攻击caster
        hp_before = self.caster.current_hp
        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120013, battlefield=self.bf, skip_cost=True
        )

        # Step 3: 验证caster受伤（但伤害被guard减少）
        self.assertLess(self.caster.current_hp, hp_before,
                        "Step3: caster应受到伤害（被guard减少后）")

        # Step 4: 验证guard buff被消耗
        guard_buffs_after = [b for b in self.caster.buffs if b.effect_type == GUARD]
        self.assertEqual(len(guard_buffs_after), 0,
                         "Step4: guard buff应被消耗（attack_limited=1）")

    def test_integration_ps3_ally_killed_buff_permanent(self):
        """集成: PS3触发 → ally_all atk_up+def_up 永続(duration=null) 不随行動消失。"""
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        self.ally_front3.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_front3], battlefield=self.bf, killer=self.enemy_cf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130038]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_ally_killed"
        )

        # 验证 buff 存在
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "应有 atk_up buff")
        def_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertGreater(len(def_ups), 0, "应有 def_up buff")

        # 验证永続性：duration=null（None或-1表示永続）
        self.assertTrue(atk_ups[0].duration is None or atk_ups[0].duration < 0,
                        "atk_up应为永続（PS3描述无持続時間限制）")
        self.assertTrue(def_ups[0].duration is None or def_ups[0].duration < 0,
                        "def_up应为永続（PS3描述无持続時間限制）")

