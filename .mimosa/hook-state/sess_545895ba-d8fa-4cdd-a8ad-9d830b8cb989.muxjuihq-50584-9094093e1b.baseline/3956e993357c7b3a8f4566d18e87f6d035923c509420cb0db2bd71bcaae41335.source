            ps3_actions, self.bf, trigger_timing="on_ally_killed"
        )

        # 验证存活友方 EP 增加（self_and_friends 包括自身）
        self.assertGreater(self.caster.current_ep, 0, "Lv11+ caster EP应增加")
        self.assertGreater(self.ally_back_light.current_ep, 0, "Lv11+ ally_back_light EP应增加")

    def test_ps3_lv10_no_add_ep(self):
        """PS3(130038) Lv10: 无 add_ep（Block2 active_level_min=11 未满足）。

        注意：PS3 cost=1 PP，PP消耗会自动 generate_ep(+1) 给 caster。
        因此 Lv10 时 caster EP=1（来自PP消耗），但其他友方 EP 应不变（Block2 跳过）。
        本测试通过验证 ally_back_light EP=0 来确认 Block2 add_ep 未执行。
        """
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130038] = 10
        for ally in self.bf.friend_team:
            ally.current_ep = 0

        self.ally_front3.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_front3], battlefield=self.bf, killer=self.enemy_cf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130038]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_ally_killed"
        )

        # Lv10 时 Block2 跳过 → 其他友方 EP 不变（无 add_ep effect）
        # caster EP=1 来自 PP 消耗（generate_ep），与 add_ep effect 无关
        self.assertEqual(self.ally_back_light.current_ep, 0,
                         "Lv10时无add_ep effect，ally_back_light EP不应增加")
        self.assertEqual(self.ally_back_fire.current_ep, 0,
                         "Lv10时无add_ep effect，ally_back_fire EP不应增加")
        self.assertEqual(self.ally_front2.current_ep, 0,
                         "Lv10时无add_ep effect，ally_front2 EP不应增加")
        # 但 Block1 仍执行 → 有 atk_up
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "Lv10时Block1仍执行，应有 atk_up buff")

