    def test_ps3_block1_atk_up_def_up_ally_all(self):
        """PS3(130038) Block1: ally_all atk_up+def_up(stackable, 永続 duration=null)。"""
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        self.ally_front3.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_front3], battlefield=self.bf, killer=self.enemy_cf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130038]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_ally_killed"
        )

        # 验证存活友方有 atk_up buff（ally_all包括自身）
        atk_ups_caster = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups_caster), 0, "caster 应有 atk_up buff")
        self.assertTrue(atk_ups_caster[0].is_stackable, "atk_up应可叠加")
        # duration=null → 永続（duration=None 或 duration=-1）
        self.assertTrue(atk_ups_caster[0].duration is None or atk_ups_caster[0].duration < 0,
                        "atk_up应为永続(duration=null)")

        # 验证存活友方有 def_up buff
        def_ups_caster = [b for b in self.caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertGreater(len(def_ups_caster), 0, "caster 应有 def_up buff")
        self.assertTrue(def_ups_caster[0].is_stackable, "def_up应可叠加")

        # 验证其他存活友方也有 buff
        atk_ups_light = [b for b in self.ally_back_light.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups_light), 0, "ally_back_light 应有 atk_up buff")

