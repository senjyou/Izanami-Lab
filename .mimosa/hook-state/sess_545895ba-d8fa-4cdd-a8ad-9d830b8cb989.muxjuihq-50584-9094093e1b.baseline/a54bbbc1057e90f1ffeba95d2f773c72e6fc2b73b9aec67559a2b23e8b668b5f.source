"""Regression: 若ノ再生(230383) must NOT trigger when attacked ally is dead.

Bug: When the attacked ally was killed (HP 0, knocked out), 若ノ再生 still
triggered and healed an unrelated ally (via select_targets fallback) instead
of skipping. The skill should heal the attacked ally; if that ally is dead,
the PS should not trigger at all.

Root cause:
1. AFTER_ALLY_ATTACKED trigger matching did not check if the primary_target
   (attacked ally) was alive.
2. _apply_heal trigger_attacker fallback: when _damaged_targets existed but
   all were dead, `targets` was not updated and kept the select_targets
   result (an unrelated alive ally like 鳴雷).

Fix:
1. Added global_condition={"type": "target_is_alive"} to 230383 in
   data/skill_effects_hybrid.json — PS does not trigger when primary_target
   (attacked ally) is dead. Does not affect counter-attack PS like
   リベンジシュート (130062) which lacks this condition.
2. Added target_is_alive condition type in trigger_service._check_condition.
3. Fixed _apply_heal trigger_attacker fallback: when all damaged allies are
   dead, return None instead of falling back to unrelated allies.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute
from src.entities_v2.skill_data import EffectData
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.WATER.value,
               character_type=2, skills=None, skill_levels=None, pp=4):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=pp, current_ep=0,
        is_alive=hp > 0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class TestRegWakanoseiDeadAlly(unittest.TestCase):
    """若ノ再生(230383) must not trigger when the attacked ally is dead."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    def test_230383_has_target_is_alive_condition(self):
        """230383 must have global_condition target_is_alive."""
        parsed = self.dl.get_parsed_skill_data(230383)
        self.assertIsNotNone(parsed, "230383 parsed data missing")
        gc = parsed.get('global_condition')
        self.assertIsNotNone(gc, "230383 should have global_condition")
        self.assertEqual(gc.get('type'), 'target_is_alive',
                         "230383 global_condition should be target_is_alive")

    def test_does_not_trigger_when_attacked_ally_is_dead(self):
        """若ノ再生 should NOT trigger when the attacked ally is dead (killed).

        Scenario: 大雷 is attacked and killed (HP 0). 若ノ再生 should not fire.
        鳴雷 (unrelated alive ally) should not be healed.
        """
        wakana = _make_unit(
            "wakana", "若雷", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=200000, atk=10000, defense=4000, speed=500,
            skills=[230383], skill_levels={230383: 10}, pp=4,
        )
        # 大雷 — the attacked ally, now DEAD (HP 0)
        oorai = _make_unit(
            "oorai", "大雷", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=140791, atk=8000, defense=3000, speed=400,
        )
        oorai.current_hp = 0
        oorai.is_alive = False
        # 鳴雷 — unrelated alive ally (should NOT be healed)
        narukami = _make_unit(
            "narukami", "鳴雷", Side.ALLY, Position.ALLY_LEFT_FRONT,
            hp=50000, atk=8000, defense=3000, speed=400,
        )
        # ノーブル・グレイス — the enemy attacker
        attacker = _make_unit(
            "noble", "ノーブル・グレイス", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=50000, defense=4000, speed=500,
            element=Attribute.FIRE.value, character_type=1,
        )
        bf = _make_bf(wakana, oorai, narukami, attacker)
        _, ts = self._make_services(bf)

        pp_before = wakana.current_pp
        actions = ts.trigger_after_ally_attacked(
            targets=[oorai], battlefield=bf, actor=attacker, primary_target=oorai
        )
        ps_actions = [a for a in actions if a.skill_id == 230383]
        self.assertEqual(
            len(ps_actions), 0,
            "若ノ再生 should NOT trigger when attacked ally (大雷) is dead"
        )
        # PP should not be consumed (PS didn't trigger)
        self.assertEqual(
            wakana.current_pp, pp_before,
            "若ノ再生 should not consume PP when attacked ally is dead"
        )
        # 鳴雷 should not be healed
        self.assertEqual(
            narukami.current_hp, 50000,
            "鳴雷 (unrelated ally) should NOT be healed"
        )

    def test_triggers_when_attacked_ally_is_alive(self):
        """若ノ再生 should trigger and heal the attacked ally when alive (normal case)."""
        wakana = _make_unit(
            "wakana", "若雷", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=200000, atk=10000, defense=4000, speed=500,
            skills=[230383], skill_levels={230383: 10}, pp=4,
        )
        # 大雷 — alive, damaged but not dead
        oorai = _make_unit(
            "oorai", "大雷", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=140791, atk=8000, defense=3000, speed=400,
        )
        oorai.current_hp = 50000  # damaged
        attacker = _make_unit(
            "noble", "ノーブル・グレイス", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=50000, defense=4000, speed=500,
            element=Attribute.FIRE.value, character_type=1,
        )
        bf = _make_bf(wakana, oorai, attacker)
        ss, ts = self._make_services(bf)

        actions = ts.trigger_after_ally_attacked(
            targets=[oorai], battlefield=bf, actor=attacker, primary_target=oorai
        )
        ps_actions = [a for a in actions if a.skill_id == 230383]
        self.assertGreater(
            len(ps_actions), 0,
            "若ノ再生 should trigger when attacked ally (大雷) is alive"
        )

        # Execute and verify heal applied to 大雷
        pp_before = wakana.current_pp
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="after_ally_attacked"
        )
        self.assertEqual(
            wakana.current_pp, pp_before - 1,
            "若ノ再生 should consume 1 PP when triggered"
        )
        self.assertGreater(
            oorai.current_hp, 50000,
            "大雷 should be healed by 若ノ再生"
        )

    def test_heal_returns_none_when_attacked_ally_dead(self):
        """Defensive: even if PS somehow executes with dead ally, _apply_heal
        must return None and not heal unrelated allies.

        This bypasses the trigger-level target_is_alive check to verify the
        _apply_heal fallback defense directly.
        """
        wakana = _make_unit(
            "wakana", "若雷", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=200000, atk=10000, defense=4000, speed=500,
            skills=[230383], skill_levels={230383: 10}, pp=4,
        )
        oorai = _make_unit(
            "oorai", "大雷", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=140791, atk=8000, defense=3000, speed=400,
        )
        oorai.current_hp = 0
        oorai.is_alive = False
        narukami = _make_unit(
            "narukami", "鳴雷", Side.ALLY, Position.ALLY_LEFT_FRONT,
            hp=50000, atk=8000, defense=3000, speed=400,
        )
        attacker = _make_unit(
            "noble", "ノーブル・グレイス", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=50000, defense=4000, speed=500,
            element=Attribute.FIRE.value, character_type=1,
        )
        bf = _make_bf(wakana, oorai, narukami, attacker)
        ss, _ = self._make_services(bf)

        # Simulate trigger context: enemy attacker + dead damaged ally
        ss._trigger_attacker = attacker
        ss._damaged_targets = [oorai]
        ss._primary_target = oorai

        hp_narukami_before = narukami.current_hp
        hp_oorai_before = oorai.current_hp

        heal_effect = EffectData(
            effect_type="heal",
            target_type="ally_single",
            target_identifier="trigger_attacker",
            value=35.0,
            hit_count=1,
        )

        result = ss._apply_heal(wakana, heal_effect, bf)
        self.assertIsNone(
            result,
            "_apply_heal should return None when attacked ally is dead"
        )
        self.assertEqual(
            narukami.current_hp, hp_narukami_before,
            "鳴雷 (unrelated ally) should NOT be healed"
        )
        self.assertEqual(
            oorai.current_hp, hp_oorai_before,
            "大雷 (dead) should NOT be healed"
        )


if __name__ == '__main__':
    unittest.main(verbosity=2)
