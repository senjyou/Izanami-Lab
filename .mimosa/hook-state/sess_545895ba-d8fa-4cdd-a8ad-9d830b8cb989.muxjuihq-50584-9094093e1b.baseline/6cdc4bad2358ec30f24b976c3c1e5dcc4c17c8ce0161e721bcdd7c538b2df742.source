"""
分析角色基础ID、角色名和队伍归属的映射关系

从CharacterBaseMaster.json和CharacterTeamMaster.json提取信息，
与characters.json中的character_base_id建立映射关系。
"""

import json
from collections import defaultdict

def analyze_character_mappings():
    # 读取CharacterBaseMaster
    with open('split_data/CharacterBaseMaster.json', 'r', encoding='utf-8') as f:
        character_base_data = json.load(f)
    
    # 读取CharacterTeamMaster
    with open('split_data/CharacterTeamMaster.json', 'r', encoding='utf-8') as f:
        team_data = json.load(f)
    
    # 读取characters.json
    with open('data/characters.json', 'r', encoding='utf-8') as f:
        characters_data = json.load(f)
    
    # 建立队伍ID到队伍名的映射
    team_id_to_name = {}
    for team in team_data:
        team_id_to_name[team['Id']] = team['Name']
    
    print("=== 队伍列表 ===")
    for team_id, team_name in sorted(team_id_to_name.items()):
        print(f"{team_id}: {team_name}")
    
    # 建立base_id到角色信息的映射
    base_id_to_info = {}
    for char_base in character_base_data:
        base_id = char_base['Id']
        base_id_to_info[base_id] = {
            'name': char_base['Name'],
            'name_ruby': char_base.get('NameRuby', ''),
            'team_id': char_base.get('CharacterTeamMasterId'),
            'team_name': team_id_to_name.get(char_base.get('CharacterTeamMasterId'), 'Unknown')
        }
    
    print("\n=== 角色基础ID映射 ===")
    for base_id, info in sorted(base_id_to_info.items()):
        print(f"{base_id}: {info['name']} ({info['name_ruby']}) - {info['team_name']}")
    
    # 分析characters.json中的character_base_id使用情况
    base_id_usage = defaultdict(list)
    for char_id, char_data in characters_data.items():
        base_id = char_data.get('character_base_id')
        if base_id:
            base_id_usage[base_id].append({
                'character_id': char_data['character_id'],
                'rarity': char_data.get('rarity', 'N/A')  # 使用.get()避免KeyError
            })
    
    print("\n=== 角色形态统计 ===")
    for base_id in sorted(base_id_usage.keys()):
        if base_id in base_id_to_info:
            char_name = base_id_to_info[base_id]['name']
            variants = base_id_usage[base_id]
            print(f"\n{base_id}: {char_name} - {len(variants)}个形态")
            for variant in sorted(variants, key=lambda x: x['character_id']):
                print(f"  - {variant['character_id']} (稀有度: {variant['rarity']})")
    
    # 生成映射数据
    mapping_data = {
        'teams': team_id_to_name,
        'character_base': base_id_to_info,
        'character_variants': {k: v for k, v in base_id_usage.items()}
    }
    
    # 保存映射数据
    with open('data/character_team_mapping.json', 'w', encoding='utf-8') as f:
        json.dump(mapping_data, f, ensure_ascii=False, indent=2)
    
    print("\n=== 映射数据已保存到 data/character_team_mapping.json ===")
    
    # 生成Markdown文档
    generate_markdown_doc(team_id_to_name, base_id_to_info, base_id_usage)

def generate_markdown_doc(teams, base_info, variants):
    """生成Markdown格式的映射文档"""
    
    lines = []
    lines.append("# 角色与队伍映射关系\n")
    lines.append("## 队伍列表\n")
    lines.append("| 队伍ID | 队伍名 |")
    lines.append("|--------|--------|")
    for team_id, team_name in sorted(teams.items()):
        lines.append(f"| {team_id} | {team_name} |")
    
    lines.append("\n## 角色基础ID映射\n")
    lines.append("| Base ID | 角色名 | 读音 | 队伍 | 形态数量 |")
    lines.append("|---------|--------|------|------|----------|")
    for base_id, info in sorted(base_info.items()):
        variant_count = len(variants.get(base_id, []))
        lines.append(f"| {base_id} | {info['name']} | {info['name_ruby']} | {info['team_name']} | {variant_count} |")
    
    lines.append("\n## 按队伍分组\n")
    # 按队伍分组角色
    team_characters = defaultdict(list)
    for base_id, info in base_info.items():
        team_name = info['team_name']
        team_characters[team_name].append((base_id, info['name']))
    
    for team_name in sorted(team_characters.keys()):
        lines.append(f"\n### {team_name}\n")
        for base_id, char_name in sorted(team_characters[team_name]):
            variant_count = len(variants.get(base_id, []))
            lines.append(f"- **{char_name}** (Base ID: {base_id}, {variant_count}个形态)")
    
    # 写入文件
    with open('docs/character_team_mapping.md', 'w', encoding='utf-8') as f:
        f.write('\n'.join(lines))
    
    print("=== Markdown文档已保存到 docs/character_team_mapping.md ===")

if __name__ == '__main__':
    analyze_character_mappings()
