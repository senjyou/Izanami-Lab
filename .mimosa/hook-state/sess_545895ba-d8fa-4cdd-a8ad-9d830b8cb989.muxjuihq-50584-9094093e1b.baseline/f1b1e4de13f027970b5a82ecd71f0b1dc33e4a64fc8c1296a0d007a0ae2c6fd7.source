#!/usr/bin/env python
# -*- coding: utf-8 -*-

import unittest
from unittest.mock import MagicMock
import sys
from pathlib import Path

# 添加项目根目录到路径
sys.path.insert(0, str(Path(__file__).parent.parent))

from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.enums import SkillEffectType
from src.combat_v2.services.status_service import StatusService

class TestStatusService(unittest.TestCase):
    
    def setUp(self):
        self.service = StatusService()
        self.unit = MagicMock(spec=UnitState)
        self.unit.name = "TestUnit"
        self.unit.buffs = []
        self.unit.debuffs = []
        self.unit.current_hp = 100
        self.unit.max_hp = 100
        self.unit.is_alive = True
        
    def test_is_stunned(self):
        # 无状态
        self.assertFalse(self.service.is_stunned(self.unit))
        
        # 添加眩晕
        debuff = BuffState(
            buff_id="1", name="Stun", effect_type=SkillEffectType.KNOCKOUT.value,
            value=0, duration=1, timing_type=1
        )
        self.unit.debuffs.append(debuff)
        
        self.assertTrue(self.service.is_stunned(self.unit))
        
    def test_apply_poison_damage(self):
        # 50 HP (0.1 poison of CURRENT HP = 5 dmg)
        self.unit.max_hp = 100
        self.unit.current_hp = 50
        
        debuff = BuffState(
            buff_id="2", name="Poison", effect_type=SkillEffectType.POISON.value,
            value=0.1, duration=2, timing_type=1
        )
        self.unit.debuffs.append(debuff)
        
        damage, _calc = self.service.apply_poison_damage(self.unit)
        
        self.assertEqual(damage, 5) # 50 * 0.1
        self.assertEqual(self.unit.current_hp, 45)
        
    def test_apply_burn_damage(self):
        # Case 1: < 3 layers (Normal damage)
        self.unit.current_hp = 100
        debuff1 = BuffState(buff_id="3a", name="Burn", effect_type=SkillEffectType.CONFLAGRATION.value, value=10, duration=2, timing_type=1)
        debuff2 = BuffState(buff_id="3b", name="Burn", effect_type=SkillEffectType.CONFLAGRATION.value, value=10, duration=2, timing_type=1)
        self.unit.debuffs = [debuff1, debuff2]
        
        damage, _, _calc = self.service.apply_burn_damage(self.unit)
        self.assertEqual(damage, 20) # 10 + 10
        self.assertEqual(self.unit.current_hp, 80)
        
    def test_apply_burn_damage_stacking(self):
        # Case 2: >= 3 layers (Double damage)
        self.unit.current_hp = 100
        debuff1 = BuffState(buff_id="3a", name="Burn", effect_type=SkillEffectType.CONFLAGRATION.value, value=10, duration=2, timing_type=1)
        debuff2 = BuffState(buff_id="3b", name="Burn", effect_type=SkillEffectType.CONFLAGRATION.value, value=10, duration=2, timing_type=1)
        debuff3 = BuffState(buff_id="3c", name="Burn", effect_type=SkillEffectType.CONFLAGRATION.value, value=10, duration=2, timing_type=1)
        self.unit.debuffs = [debuff1, debuff2, debuff3]
        
        damage, _, _calc = self.service.apply_burn_damage(self.unit)
        # (10 * 2) + (10 * 2) + (10 * 2) = 60
        self.assertEqual(damage, 60)
        self.assertEqual(self.unit.current_hp, 40)
        
    def test_apply_regen(self):
        self.unit.max_hp = 100
        self.unit.current_hp = 50
        
        buff = BuffState(
            buff_id="4", name="Regen", effect_type=SkillEffectType.HEAL_OVER_TIME.value,
            value=10, duration=2, timing_type=1, caster_attack=100
        )
        self.unit.buffs.append(buff)
        
        heal, details = self.service.apply_regen(self.unit)

        self.assertEqual(heal, 10)
        self.assertEqual(self.unit.current_hp, 60)
        self.assertEqual(len(details), 1)
        self.assertEqual(details[0]['amount'], 10)
        
    def test_lethal_damage(self):
        self.unit.current_hp = 5
        self.unit.is_alive = True
        
        debuff = BuffState(
            buff_id="5", name="Burn", effect_type=SkillEffectType.CONFLAGRATION.value,
            value=10, duration=1, timing_type=1
        )
        self.unit.debuffs.append(debuff)
        
        self.service.apply_burn_damage(self.unit)
        
        self.assertEqual(self.unit.current_hp, 0)
        self.assertFalse(self.unit.is_alive)

if __name__ == '__main__':
    unittest.main()
