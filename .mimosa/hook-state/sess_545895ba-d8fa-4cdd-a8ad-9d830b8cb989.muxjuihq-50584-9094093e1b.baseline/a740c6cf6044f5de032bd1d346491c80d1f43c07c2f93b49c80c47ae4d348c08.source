#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
BattleFlowController单元测试
tests/test_battle_flow_v2.py
"""

import sys
import unittest
from unittest.mock import MagicMock, call, patch
from pathlib import Path

# 添加项目根目录到路径
sys.path.insert(0, str(Path(__file__).parent.parent))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.enums import Side, Position, UnitActionPhase, Attribute, CharacterType
from src.entities_v2.battlefield_state import BattlefieldState
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig

class TestBattleFlowController(unittest.TestCase):

    def setUp(self):
        self.battlefield = BattlefieldState()
        self.config = BattleConfig()
        self.config.max_turns = 2

        # 创建控制器
        self.controller = BattleFlowController(self.battlefield, self.config)

        # Mock所有服务
        self.controller.resource_service = MagicMock()
        self.controller.skill_service = MagicMock()
        self.controller.damage_service = MagicMock()
        self.controller.buff_service = MagicMock()
        self.controller.status_service = MagicMock()
        self.controller.target_service = MagicMock()
        self.controller.trigger_service = MagicMock()
        self.controller.action_axis = MagicMock()

        # Mock data_loader
        self.controller.data_loader = MagicMock()

        # 设置StatusService默认返回
        self.controller.status_service.is_stunned.return_value = False
        self.controller.status_service.is_frozen.return_value = False
        self.controller.status_service.apply_burn_damage.return_value = (0, 0, {})
        self.controller.status_service.apply_poison_damage.return_value = (0, {})
        self.controller.status_service.apply_action_damage.return_value = (0, 0)
        self.controller.status_service.apply_regen.return_value = (0, [])

        # 设置SkillService默认返回
        self.controller.skill_service.select_skill.return_value = 101
        self.controller.skill_service.check_skill_cost.return_value = True
        self.controller.skill_service.deduct_skill_cost.return_value = True
        self.controller.skill_service.execute_skill.return_value = {"success": True, "effects_applied": []}

        # 设置data_loader默认返回
        mock_meta = MagicMock()
        mock_meta.name = "TestSkill"
        mock_meta.skill_type = 1
        mock_meta.features = 0
        mock_meta.skill_kind = 0
        mock_meta.resource_cost = 1
        self.controller.data_loader.get_skill_by_id.return_value = mock_meta
        self.controller.data_loader.get_parsed_skill_data.return_value = None

        # 设置SkillService._resolver
        mock_resolved = MagicMock()
        mock_resolved.skill_type = 1
        self.controller.skill_service._resolver = MagicMock()
        self.controller.skill_service._resolver.resolve.return_value = mock_resolved

        # 设置TriggerService默认返回
        self.controller.trigger_service.trigger_before_skill_use.return_value = []
        self.controller.trigger_service.trigger_before_ally_as_attack.return_value = []
        self.controller.trigger_service.trigger_after_ally_attacked.return_value = []
        self.controller.trigger_service.trigger_after_self_attacked.return_value = []
        self.controller.trigger_service.trigger_after_as_attacked.return_value = []
        self.controller.trigger_service.trigger_after_as_attacked_ally.return_value = []
        self.controller.trigger_service.trigger_after_ally_as_attack.return_value = []
        self.controller.trigger_service.trigger_after_skill_use.return_value = []
        self.controller.trigger_service.trigger_after_own_action.return_value = []
        self.controller.trigger_service.trigger_after_as_attack.return_value = []
        self.controller.trigger_service.trigger_hp_below.return_value = []
        self.controller.trigger_service.trigger_cumulative_damage.return_value = []
        self.controller.trigger_service.trigger_pawn_died.return_value = []
        self.controller.trigger_service.trigger_pawn_killed.return_value = []
        self.controller.trigger_service.trigger_pawn_any_kill.return_value = []
        self.controller.trigger_service.trigger_unit_count_below.return_value = []
        self.controller.trigger_service.trigger_skill_use_count.return_value = []
        self.controller.trigger_service.trigger_ally_charge_use.return_value = []
        self.controller.trigger_service.trigger_pawn_caused_critical.return_value = []
        self.controller.trigger_service.trigger_pawn_received_aura.return_value = []
        self.controller.trigger_service.calculate_priority.return_value = 0

        # 设置DamageService默认返回
        self.controller.damage_service._calculate_final_stat.return_value = 100

    def _create_unit(self, unit_id, speed, position) -> UnitState:
        """创建测试单位"""
        return UnitState(
            unit_id=unit_id,
            name=f"Unit_{unit_id}",
            side=Side.ALLY,
            position=position,
            character_id=1,
            level=1,
            element=Attribute.FIRE,
            character_type=CharacterType.PHYSICAL,
            max_hp=100,
            attack=10,
            defense=10,
            speed=speed,
            crit_rate=0,
            crit_damage=1.5,
            advantage_damage=1.5,
            initial_active_point=100,
            initial_passive_point=100,
            max_extra_point=100,
            current_hp=100,
            current_ap=100,
            current_pp=100,
            current_ep=0
        )

    def test_execute_battle_flow(self):
        """测试完整战斗流程调用顺序"""
        u1 = self._create_unit("u1", 100, Position.ALLY_CENTER_FRONT)
        u1.skills = [101]

        # 添加敌方单位，防止战斗立即结束
        u2 = self._create_unit("u2", 100, Position.ENEMY_CENTER_FRONT)

        self.battlefield.friend_team = [u1]
        self.battlefield.enemy_team = [u2]

        # 模拟行动轴行为
        # 每回合1轮: False(外层进入), False(内层进入), True(内层退出), True(外层退出)
        # 2回合共8次is_empty调用
        self.controller.action_axis.is_empty.side_effect = [
            False, False, True, True,   # Turn 1
            False, False, True, True,   # Turn 2
        ]
        self.controller.action_axis.get_next_unit.side_effect = [u1, u1]
        self.controller.action_axis.action_axis = [u1]

        # 执行战斗
        result = self.controller.execute_battle()

        # 验证结果
        self.assertEqual(result['total_turns'], 2)

        # 1. 战斗开始触发器
        self.controller.trigger_service.trigger_battle_start.assert_called_once()

        # 2. 行动轴生成 (每回合2次: 1次进入+1次退出)
        self.assertEqual(self.controller.action_axis.generate_action_axis.call_count, 4)

        # 3. 技能执行流程 (u1行动2次)
        self.assertEqual(u1.action_phase, UnitActionPhase.IDLE)

        # 触发器调用
        self.assertEqual(self.controller.trigger_service.trigger_before_skill_use.call_count, 2)
        # after_skill_use已拆分为after_own_action(Phase1)和after_as_attack(Phase3)
        # 非伤害型AS技能走trigger_after_own_action和trigger_after_as_attack
        self.assertEqual(self.controller.trigger_service.trigger_after_own_action.call_count, 2)
        self.assertEqual(self.controller.trigger_service.trigger_after_as_attack.call_count, 2)

        # 技能执行
        self.assertEqual(self.controller.skill_service.execute_skill.call_count, 2)

        # 冷却更新
        self.assertEqual(self.controller.skill_service.update_cooldown_after_skill_use.call_count, 2)
        self.assertEqual(self.controller.skill_service.update_action_cooldowns.call_count, 2)

    def test_stunned_unit_skips_turn(self):
        """测试单位被眩晕跳过回合"""
        u1 = self._create_unit("u1", 100, Position.ALLY_CENTER_FRONT)
        self.controller.status_service.is_stunned.return_value = True

        # 模拟行动轴: False(外层进入), False(内层进入), True(内层退出), True(外层退出)
        self.controller.action_axis.is_empty.side_effect = [False, False, True, True]
        self.controller.action_axis.get_next_unit.side_effect = [u1]
        self.controller.action_axis.action_axis = [u1]

        self.controller._execute_turn(1)

        # 验证没有执行技能
        self.controller.skill_service.execute_skill.assert_not_called()
        self.controller.trigger_service.trigger_before_skill_use.assert_not_called()

    def test_battle_end_condition(self):
        """测试战斗结束条件"""
        u1 = self._create_unit("u1", 100, Position.ALLY_CENTER_FRONT)
        u1.is_alive = False
        self.battlefield.friend_team = [u1]
        self.battlefield.enemy_team = []

        self.controller.action_axis.is_empty.return_value = True

        self.assertTrue(self.controller._check_battle_end())

        # 修改为有人存活
        u1.is_alive = True
        u2 = self._create_unit("u2", 100, Position.ENEMY_CENTER_FRONT)
        self.battlefield.enemy_team = [u2]

        self.assertFalse(self.controller._check_battle_end())

if __name__ == "__main__":
    unittest.main()
