    def test_ps3_grants_dmg_invulnerable(self):
        """PS3(130113) Block1: self dmg_invulnerable(1行動, hit_limited=999)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.85)

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps3_actions = [a for a in actions if a.skill_id == 130113]
        self.assertGreater(len(ps3_actions), 0)
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_cumulative_damage"
        )

        # 验证 dmg_invulnerable buff
        invulns = [b for b in self.caster.buffs if b.effect_type == DMG_INVULNERABLE]
        self.assertGreater(len(invulns), 0,
                           "PS3执行后应有 dmg_invulnerable buff")
        self.assertEqual(invulns[0].duration, 1,
                         "dmg_invulnerable duration应为1")
        self.assertEqual(getattr(invulns[0], 'hit_limited', 0), 999,
                         "dmg_invulnerable hit_limited应为999")

    def test_ps3_grants_juryoku_mark_buff(self):
        """PS3(130113) Block1: self mark 反重力おさげ(is_buff_mark=true → buffs列表)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.85)

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps3_actions = [a for a in actions if a.skill_id == 130113]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_cumulative_damage"
        )

        # 验证 反重力おさげ mark buff（is_buff_mark=true → buffs列表，is_debuff=False）
        marks = [b for b in self.caster.buffs
                 if b.effect_type == MARK and b.name == "反重力おさげ"]
        self.assertGreater(len(marks), 0,
                           "PS3应施加 反重力おさげ mark buff")
        self.assertFalse(marks[0].is_debuff,
                         "反重力おさげ mark 应为 buff（is_debuff=False）")
        self.assertEqual(marks[0].duration, 1,
                         "反重力おさげ mark duration应为1")

    def test_ps3_dmg_dealt_down_on_nearest_enemy(self):
        """PS3(130113) Block1: enemy_single nearest dmg_dealt_down(dmg%, attack_limited=1)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.85)

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps3_actions = [a for a in actions if a.skill_id == 130113]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_cumulative_damage"
        )

        # 验证最近敌方(enemy_cf，距离caster最近)有 dmg_dealt_down debuff
        cf_dealt_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(cf_dealt_downs), 0,
                           "enemy_cf(最近敌)应有 dmg_dealt_down debuff")
        self.assertEqual(cf_dealt_downs[0].duration, 1,
                         "dmg_dealt_down duration应为1")
        self.assertEqual(getattr(cf_dealt_downs[0], 'attack_limited', 0), 1,
                         "dmg_dealt_down attack_limited应为1")

        # 验证其他敌方无 dmg_dealt_down
        lf_dealt_downs = [d for d in self.enemy_lf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(lf_dealt_downs), 0,
                         "enemy_lf(非最近)不应有 dmg_dealt_down")

