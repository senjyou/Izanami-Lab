        self.assertEqual(self.caster.max_hp, max_hp_before,
                         "Lv10时Block2跳过，max_hp应保持不变")

    def test_ps2_cheat_death_prevents_lethal_damage(self):
        """PS2(130112) cheat_death: 致死伤害时HP保留1点（不阵亡）。

        cheat_death 机制：致死伤害时HP不会降到0以下。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 触发PS2获得cheat_death
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130112]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 验证 cheat_death buff 存在
        cheat_deaths = [b for b in self.caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertGreater(len(cheat_deaths), 0, "应有 cheat_death buff")

        # 设置 caster 低血量
        self.caster.current_hp = 100

        # 让一个高攻击力敌方攻击caster（足以致死）
        self.enemy_cf.attack = 50000  # 远超 caster HP
        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120103, battlefield=self.bf, skip_cost=True
        )

        # cheat_death 应保留HP（不会降到0）
        # 注意：cheat_death 触发后 HP=1，buff 被消耗
        self.assertGreater(self.caster.current_hp, 0,
                           "cheat_death应防止caster阵亡（HP>0）")
        self.assertTrue(self.caster.is_alive,
                        "caster应存活（cheat_death生效）")

    # ════════════════════════════════════════════════════════════════
    # PS3: 130113 怒らせすぎ注意
    # ════════════════════════════════════════════════════════════════

    def test_ps3_no_trigger_below_threshold(self):
        """PS3(130113) on_cumulative_damage: 累计伤害<85% max_hp 时不触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 设置累计伤害为50% max_hp（<85%）
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.50)

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps3_actions = [a for a in actions if a.skill_id == 130113]
        self.assertEqual(len(ps3_actions), 0,
                         "累计伤害<85%时PS3不应触发")

