    def test_ps3_lv10_no_knockout(self):
        """PS3(130113) Lv10: 无 knockout（Block2 active_level_min=11 未满足）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130113] = 10
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.85)

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps3_actions = [a for a in actions if a.skill_id == 130113]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_cumulative_damage"
        )

        # Lv10 时 Block2 跳过 → 敌方无 knockout
        for e in self.bf.enemy_team:
            knockouts = [d for d in e.debuffs if d.effect_type == KNOCKOUT]
            self.assertEqual(len(knockouts), 0,
                             f"Lv10时{e.name}不应有knockout debuff")

    def test_ps3_dmg_invulnerable_reduces_incoming_damage(self):
        """PS3(130113) dmg_invulnerable: 受伤害时伤害减免为1。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.85)

        # 触发PS3获得dmg_invulnerable
        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps3_actions = [a for a in actions if a.skill_id == 130113]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_cumulative_damage"
        )

        # 验证 dmg_invulnerable buff 存在
        invulns = [b for b in self.caster.buffs if b.effect_type == DMG_INVULNERABLE]
        self.assertGreater(len(invulns), 0, "应有 dmg_invulnerable buff")

        # 让敌方攻击caster
        hp_before = self.caster.current_hp
        self.enemy_cf.attack = 50000  # 高攻击力
        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120103, battlefield=self.bf, skip_cost=True
        )

        # dmg_invulnerable 应使caster HP几乎不减（伤害=1）
        hp_loss = hp_before - self.caster.current_hp
        self.assertLessEqual(hp_loss, 10,
                             f"dmg_invulnerable应使伤害减免为1，实际HP损失: {hp_loss}")

    # ════════════════════════════════════════════════════════════════
    # 集成测试：PS3 mark → AS1 knockout 联动
    # ════════════════════════════════════════════════════════════════

    def test_integration_ps3_mark_enables_as1_knockout(self):
        """集成：PS3 付与 反重力おさげ mark → AS1 Block2 knockout 生效。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10, ap=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.85)

        # Step 1: 触发PS3获得mark
        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps3_actions = [a for a in actions if a.skill_id == 130113]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_cumulative_damage"
        )

        # 验证mark已施加
        marks = [b for b in self.caster.buffs
                 if b.effect_type == MARK and b.name == "反重力おさげ"]
        self.assertGreater(len(marks), 0,
                           "PS3应已付与 反重力おさげ mark")

        # Step 2: 执行AS1，应触发Block2 knockout
        result_as1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120103, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as1["success"])

        # 验证受伤害的敌方有 knockout debuff
        damaged = [e for e in self.bf.enemy_team if e.current_hp < e.max_hp]
        self.assertGreater(len(damaged), 0, "AS1应命中至少1体敌方")
        knockout_count = sum(
            1 for e in damaged
            for d in e.debuffs if d.effect_type == KNOCKOUT
        )
        self.assertGreater(knockout_count, 0,
                           "AS1应因mark触发Block2，对敌方付knockout")

    def test_integration_ps1_damage_link_then_attack_transfers(self):
        """集成：PS1建立damage_link → 后续caster受攻击时伤害转送给link partner。

        完整流程：
        1. PS1执行：建立 caster(outgoing) → enemy_rf(incoming) 的link
        2. enemy_cf攻击caster
        3. enemy_rf承受25%转送伤害，caster承受75%
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10, ap=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: 执行PS1
        result_ps1 = self.ss.execute_skill(
            caster=self.caster, skill_id=130111, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_ps1["success"])

        # 验证damage_link已建立
        outgoing = [dl for dl in self.caster.damage_links if dl.direction == "outgoing"]
        self.assertGreater(len(outgoing), 0, "PS1应建立damage_link")

        # Step 2: 让enemy_cf攻击caster
        caster_hp_before = self.caster.current_hp
        enemy_rf_hp_before = self.enemy_rf.current_hp

        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120103, battlefield=self.bf, skip_cost=True
        )

        caster_hp_loss = caster_hp_before - self.caster.current_hp
        enemy_rf_hp_loss = enemy_rf_hp_before - self.enemy_rf.current_hp

        # 双方都应承受伤害（caster承受75%，enemy_rf承受25%转送）
        self.assertGreater(caster_hp_loss, 0,
                           "caster应承受剩余伤害（75%）")
        self.assertGreater(enemy_rf_hp_loss, 0,
                           "enemy_rf应承受转送伤害（25%）")

    def test_integration_full_skill_chain(self):
        """集成：完整技能链 - PS1 link + PS2 cheat_death + PS3 mark + AS1 knockout。

        验证多个PS共存时的交互：
        1. PS1建立damage_link
        2. PS2触发cheat_death（防止致死）
        3. PS3触发mark + dmg_invulnerable
        4. AS1利用mark付knockout
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10, ap=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: PS1建立damage_link
        result_ps1 = self.ss.execute_skill(
            caster=self.caster, skill_id=130111, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_ps1["success"])
        self.assertGreater(len(self.caster.damage_links), 0,
                           "PS1应建立damage_link")

        # Step 2: PS2触发cheat_death（caster被攻击前）
        actions_ps2 = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps2_actions = [a for a in actions_ps2 if a.skill_id == 130112]
        self.ss._pending_crit_triggers = []
        if ps2_actions:
            self.ss._execute_trigger_actions_inline(
                ps2_actions, self.bf, trigger_timing="before_as_attacked"
            )
        cheat_deaths = [b for b in self.caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertGreater(len(cheat_deaths), 0,
                           "PS2应已付与 cheat_death buff")

        # Step 3: 模拟累计伤害达85%触发PS3
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.85)
        actions_ps3 = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        ps3_actions = [a for a in actions_ps3 if a.skill_id == 130113]
        self.ss._pending_crit_triggers = []
        if ps3_actions:
            self.ss._execute_trigger_actions_inline(
                ps3_actions, self.bf, trigger_timing="on_cumulative_damage"
            )
        marks = [b for b in self.caster.buffs
                 if b.effect_type == MARK and b.name == "反重力おさげ"]
        self.assertGreater(len(marks), 0,
                           "PS3应已付与 反重力おさげ mark")

        # Step 4: AS1利用mark付knockout
        result_as1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120103, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as1["success"])

        # 验证至少1个敌方有knockout
        knockout_count = sum(
            1 for e in self.bf.enemy_team
            for d in e.debuffs if d.effect_type == KNOCKOUT
        )
        self.assertGreater(knockout_count, 0,
                           "AS1应利用PS3的mark对敌方付knockout")


if __name__ == "__main__":
    unittest.main()
