    def test_ps1_scale_by_alive_allies_more_allies_higher_value(self):
        """PS1(130098) scale_by_alive_allies: 存活友方数越多，dmg_taken_down value越高。

        场景：4存活友方 vs 1存活友方，4友方时value应更高。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()

        # 场景1：4存活友方（caster + ally_front + ally_lb + ally_rb）
        self._reset_all_allies()
        self.caster.skill_cooldowns = {}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
        )
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120089, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130098]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="after_as_attack"
        )

        buffs_4 = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(buffs_4), 0, "4友方场景应有 buff")
        value_4 = buffs_4[0].value

        # 场景2：仅1存活友方（caster自身），其他友方阵亡
        self.caster.buffs = []
        self.ally_front.is_alive = False
        self.ally_lb.is_alive = False
        self.ally_rb.is_alive = False
        self.caster.skill_cooldowns = {}

        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
        )
        actions2 = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120089, result=result2, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps1_actions2 = [a for a in actions2 if a.skill_id == 130098]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions2, self.bf, trigger_timing="after_as_attack"
        )

        buffs_1 = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(buffs_1), 0, "1友方场景应有 buff")
        value_1 = buffs_1[0].value

        # scale_by_alive_allies: 4友方时value > 1友方时value
        self.assertGreater(value_4, value_1,
                           f"4友方时value({value_4})应 > 1友方时value({value_1})")

    # ════════════════════════════════════════════════════════════════
    # PS2: 130099 がんばるね、おにいちゃん（on_turn_start + is_preemptive）
    # ════════════════════════════════════════════════════════════════

    def test_ps2_triggers_on_turn_start(self):
        """PS2(130099) on_turn_start: 回合开始时触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # on_turn_start 先制技能收集
        actions = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130099]
        self.assertGreater(len(ps2_actions), 0,
                           "回合开始应触发 PS2(130099) 先制")

    def test_ps2_is_preemptive_collected_in_preemptive_phase(self):
        """PS2(130099) is_preemptive=true: 在先制阶段被收集。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 先制阶段
        preemptive_actions = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2_pre = [a for a in preemptive_actions if a.skill_id == 130099]
        self.assertGreater(len(ps2_pre), 0,
                           "PS2 is_preemptive=true 应在先制阶段被收集")

        # 非先制阶段不应包含 PS2
        non_preemptive_actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2_non = [a for a in non_preemptive_actions if a.skill_id == 130099]
        self.assertEqual(len(ps2_non), 0,
                         "PS2 is_preemptive=true 不应在非先制阶段被收集")

    def test_ps2_damage_enemy_single_furthest(self):
        """PS2(130099) Block1: enemy_single_furthest 伤害。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130099]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证最远敌方受到伤害（caster 在 ALLY_CENTER_BACK，最远敌方是前排某单位）
        # 至少有一个敌方受伤
        any_damaged = any(e.current_hp < e.max_hp for e in self.bf.enemy_team if e.is_alive)
        self.assertTrue(any_damaged, "PS2 应对最远敌方造成伤害")

    def test_ps2_remove_pp_2(self):
        """PS2(130099) Block1: remove_pp value=2 削减最远敌方PP。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 记录所有敌方初始PP
        pp_before = {e.unit_id: e.current_pp for e in self.bf.enemy_team if e.is_alive}

        actions = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130099]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证最远敌方PP被削减2点
        # 找出PP变化的敌方
        pp_reduced = [e for e in self.bf.enemy_team
                      if e.is_alive and e.current_pp < pp_before.get(e.unit_id, 0)]
        self.assertGreater(len(pp_reduced), 0, "应有敌方PP被削减")

        # 验证削减量=2
        for e in pp_reduced:
            reduction = pp_before[e.unit_id] - e.current_pp
            self.assertEqual(reduction, 2,
                             f"{e.name} PP应被削减2点，实际削减{reduction}")

    def test_ps2_lv11_heal_efficacy_down(self):
        """PS2(130099) Block2 (active_level_min=11): attacked_targets heal_efficacy_down(2actions)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 15
        self.caster.skill_levels[130099] = 15

        actions = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130099]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证被攻击目标(最远敌方)有 heal_efficacy_down debuff
        heal_downs = [d for e in self.bf.enemy_team if e.is_alive
                      for d in e.debuffs if d.effect_type == RECEIVED_HEALING]
        self.assertGreater(len(heal_downs), 0,
                           "Lv15 应对被攻击目标付与 heal_efficacy_down debuff")
        self.assertEqual(heal_downs[0].duration, 2,
                         "heal_efficacy_down duration 应为2")

    def test_ps2_lv10_no_heal_efficacy_down(self):
        """PS2(130099) Lv10: 无 heal_efficacy_down（Block2 active_level_min=11 未满足）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130099] = 10

        actions = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130099]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # Lv10 时 Block2 跳过 → 无 heal_efficacy_down
        heal_downs = [d for e in self.bf.enemy_team if e.is_alive
                      for d in e.debuffs if d.effect_type == RECEIVED_HEALING]
        self.assertEqual(len(heal_downs), 0,
                         "Lv10 时不应有 heal_efficacy_down debuff")

    def test_ps2_cooldown_99_once_only(self):
        """PS2(130099) cooldown=99: 1度のみ発動，第二次回合开始不再触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 第一次触发
        actions1 = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2_1 = [a for a in actions1 if a.skill_id == 130099]
        self.assertGreater(len(ps2_1), 0, "第一次应触发PS2")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_1, self.bf, trigger_timing="on_turn_start"
        )

        # 验证冷却已设置为99
        self.assertEqual(self.caster.skill_cooldowns.get(130099), 99,
                         "PS2执行后应设置cooldown=99")

        # 第二次触发（PS2在冷却中）
        actions2 = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2_2 = [a for a in actions2 if a.skill_id == 130099]
        self.assertEqual(len(ps2_2), 0, "PS2 cooldown=99 → 不应再次被收集")

    # ════════════════════════════════════════════════════════════════
    # scale_by_alive_allies 专项
    # ════════════════════════════════════════════════════════════════

    def test_scale_by_alive_allies_scales_with_count(self):
        """scale_by_alive_allies: value 随存活友方数线性缩放。

        场景对比：1友方 vs 4友方，value 应递增。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()

        values = []
        for alive_count in [1, 2, 4]:
            self._reset_all_allies()
            # 设置存活友方数
            allies = [self.ally_front, self.ally_lb, self.ally_rb]
            for i, ally in enumerate(allies):
                ally.is_alive = (i < alive_count - 1)  # -1 因为 caster 自身始终算

            self.caster.buffs = []
            self.caster.skill_cooldowns = {}
            result = self.ss.execute_skill(
                caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
            )
            actions = self.ts.trigger_after_as_attack(
                actor=self.caster, skill_id=120089, result=result, battlefield=self.bf,
                primary_target=self.enemy_cf
            )
            ps1_actions = [a for a in actions if a.skill_id == 130098]
            self.ss._pending_crit_triggers = []
            self.ss._execute_trigger_actions_inline(
                ps1_actions, self.bf, trigger_timing="after_as_attack"
            )

            buffs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
            self.assertGreater(len(buffs), 0,
                               f"{alive_count}友方时应有 buff")
            values.append(buffs[0].value)

        # value 应递增（1 < 2 < 4 友方）
        self.assertLess(values[0], values[1],
                        f"1友方value({values[0]})应 < 2友方value({values[1]})")
        self.assertLess(values[1], values[2],
                        f"2友方value({values[1]})应 < 4友方value({values[2]})")

    def test_scale_by_alive_allies_max_at_full(self):
        """scale_by_alive_allies: 全员存活时value达到max_value（dmg tag Lv10=20%）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[130098] = 10
        self.caster.skill_cooldowns = {}

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
        )
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120089, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130098]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="after_as_attack"
        )

        buffs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(buffs), 0, "应有 dmg_taken_down buff")
        # 全员存活时 value = max_value = 20 (Lv10 dmg tag)
        self.assertAlmostEqual(buffs[0].value, 20.0, places=1,
                               msg=f"全员存活时 value 应为20(Lv10 max)，实际: {buffs[0].value}")

    # ════════════════════════════════════════════════════════════════
    # 集成测试
    # ════════════════════════════════════════════════════════════════

    def test_integration_ex_full_chain(self):
        """集成测试：EX 完整链路（side_columns + back_row + Lv11+ force_crit）。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[110039] = 15
        self.caster.crit_rate = 0.0

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block1: side_columns (lf, lb, rf, rb)
        self.assertLess(self.enemy_lf.current_hp, self.enemy_lf.max_hp,
                        "enemy_lf 应受 Block1 伤害")
        self.assertLess(self.enemy_rf.current_hp, self.enemy_rf.max_hp,
                        "enemy_rf 应受 Block1 伤害")
        # Block3: back_row force_crit (lb, rb)
        self.assertLess(self.enemy_lb.current_hp, self.enemy_lb.max_hp,
                        "enemy_lb 应受 Block3 暴击伤害")
        self.assertLess(self.enemy_rb.current_hp, self.enemy_rb.max_hp,
                        "enemy_rb 应受 Block3 暴击伤害")

    def test_integration_ps2_then_ps1_chain(self):
        """集成测试：PS2先制攻击 → AS攻击 → PS1触发链。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: 回合开始触发 PS2 先制攻击
        actions = self.ts.trigger_turn_start_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130099]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )
        # 验证最远敌方受伤
        any_damaged = any(e.current_hp < e.max_hp for e in self.bf.enemy_team if e.is_alive)
        self.assertTrue(any_damaged, "PS2 先制攻击应造成伤害")

        # Step 2: caster 执行 AS2 攻击
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Step 3: AS攻击后触发 PS1
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120089, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130098]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="after_as_attack"
        )

        # 验证 self_and_friends 获得 dmg_taken_down
        caster_buffs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(caster_buffs), 0, "PS1 应给 caster 付与 dmg_taken_down")


if __name__ == "__main__":
    unittest.main(verbosity=2)
