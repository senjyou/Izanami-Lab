    # ════════════════════════════════════════════════════════════════
    # 重置辅助方法
    # ════════════════════════════════════════════════════════════════

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=10):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.level = 10
        self.caster.crit_rate = 0.0
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10

    def _reset_ally_front(self, hp=None, ap=10, pp=10, ep=0):
        """重置前方友方状态。"""
        self.ally_front.current_hp = hp if hp is not None else self.ally_front.max_hp
        self.ally_front.buffs = []
        self.ally_front.debuffs = []
        self.ally_front.is_alive = True
        self.ally_front.skill_cooldowns = {}
        self.ally_front.current_ap = ap
        self.ally_front.current_pp = pp
        self.ally_front.current_ep = ep

    def _reset_all_allies(self):
        """重置所有友方状态。"""
        self._reset_caster()
        self._reset_ally_front()
        for ally in [self.ally_lb, self.ally_rb]:
            ally.current_hp = ally.max_hp
            ally.buffs = []
            ally.debuffs = []
            ally.is_alive = True
            ally.skill_cooldowns = {}

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ap = 4
            e.current_pp = 4
            e.current_ep = 2

    def _set_only_center_enemies(self):
        """仅保留中前敌（用于 fallback_when_no_targets 测试）。"""
        for e in [self.enemy_lf, self.enemy_lb, self.enemy_rf, self.enemy_rb]:
            e.is_alive = False
        self.bf.enemy_team = [self.enemy_cf]

    # ════════════════════════════════════════════════════════════════
    # 配置校验
    # ════════════════════════════════════════════════════════════════

    def test_config_skill_ids(self):
        """配置校验：140301 应有5个技能ID [110039, 120088, 120089, 130098, 130099]。"""
        char_skills_map = self.dl.load_character_skills()
        char_skills = char_skills_map.get(140301)
        self.assertIsNotNone(char_skills, "character_skills 应包含 140301")
        if isinstance(char_skills, dict):
            skill_ids = char_skills.get('skill_ids', [])
        else:
            skill_ids = char_skills
        self.assertEqual(skill_ids, [110039, 120088, 120089, 130098, 130099],
                         f"技能ID列表应为 [110039, 120088, 120089, 130098, 130099]，实际: {skill_ids}")

    def test_config_ex_force_crit_flag(self):
        """配置校验：EX(110039) Block3 应有 force_crit=true flag。"""
        parsed = self.dl.get_parsed_skill_data(110039)
        self.assertIsNotNone(parsed, "EX 应有 parsed 数据")
        block3 = None
        for blk in parsed['effect_blocks']:
            if blk.get('condition', {}) and blk['condition'].get('type') == 'active_level_min':
                block3 = blk
                break
        self.assertIsNotNone(block3, "应有 Block3 (active_level_min=11)")
        has_force_crit = any(
            eff.get('flags', {}).get('force_crit') is True
            for eff in block3['effects']
        )
        self.assertTrue(has_force_crit, "Block3 Lv11+ damage 应有 force_crit=true")

    def test_config_as1_targets_exist(self):
        """配置校验：AS1(120088) 应有 targets_exist global_condition。"""
        parsed = self.dl.get_parsed_skill_data(120088)
        self.assertIsNotNone(parsed, "AS1 应有 parsed 数据")
        gc = parsed.get('global_condition')
        self.assertIsNotNone(gc, "AS1 应有 global_condition")
        self.assertEqual(gc.get('type'), 'targets_exist',
                         "AS1 global_condition 应为 targets_exist")

    def test_config_ps2_cooldown_99(self):
        """配置校验：PS2(130099) cooldown=99（1度のみ発動）。"""
        parsed = self.dl.get_parsed_skill_data(130099)
        self.assertIsNotNone(parsed, "PS2 应有 parsed 数据")
        self.assertEqual(parsed.get('cooldown'), 99,
                         "PS2 cooldown 应为 99（1度のみ発動）")

    def test_config_no_simultaneous_limit(self):
        """配置校验：140301 的5个技能均无 simultaneous_limit。"""
        for sid in [110039, 120088, 120089, 130098, 130099]:
            parsed = self.dl.get_parsed_skill_data(sid)
            self.assertFalse(parsed.get('simultaneous_limit', False),
                             f"技能 {sid} 不应有 simultaneous_limit")

    # ════════════════════════════════════════════════════════════════
    # EX: 110039 リディアたいちょうのめいれい
    # ════════════════════════════════════════════════════════════════

    def test_ex_block1_enemy_side_columns_damage(self):
        """EX(110039) Block1: enemy_side_columns(4単位) 范围伤害。"""
        self._reset_caster()
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # side_columns = 左列(lf+lb) + 右列(rf+rb) = 4单位，不含中列(cf)
        self.assertLess(self.enemy_lf.current_hp, self.enemy_lf.max_hp,
                        "enemy_lf 应受到EX side_columns伤害")
        self.assertLess(self.enemy_lb.current_hp, self.enemy_lb.max_hp,
                        "enemy_lb 应受到EX side_columns伤害")
        self.assertLess(self.enemy_rf.current_hp, self.enemy_rf.max_hp,
                        "enemy_rf 应受到EX side_columns伤害")
        self.assertLess(self.enemy_rb.current_hp, self.enemy_rb.max_hp,
                        "enemy_rb 应受到EX side_columns伤害")
        # 中列不在 side_columns 范围（但 Block2/3 会打 back_row 含 cb，此处 cb 不存在）
        # 注意：enemy_cf 是中前，不在 side_columns，也不在 back_row（除非有中后）

    def test_ex_block2_lv10_back_row_damage(self):
        """EX(110039) Block2 (active_level_max=10): enemy_back_row 伤害。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[110039] = 10

        self.ss.execute_skill(
            caster=self.caster, skill_id=110039, battlefield=self.bf, skip_cost=True
        )

        # Block2 active_level_max=10 → Lv<=10 时执行 → back_row 受伤
        # back_row = lb, rb（中后不存在）
        self.assertLess(self.enemy_lb.current_hp, self.enemy_lb.max_hp,
                        "Lv10时 enemy_lb 应受到 Block2 back_row 伤害")
        self.assertLess(self.enemy_rb.current_hp, self.enemy_rb.max_hp,
                        "Lv10时 enemy_rb 应受到 Block2 back_row 伤害")

    def test_ex_block2_lv11_skipped(self):
        """EX(110039) Block2 (active_level_max=10): Lv11+ 时跳过Block2。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[110039] = 11

        # 记录 back_row 初始HP
        lb_hp_before = self.enemy_lb.max_hp
        rb_hp_before = self.enemy_rb.max_hp

        self.ss.execute_skill(
            caster=self.caster, skill_id=110039, battlefield=self.bf, skip_cost=True
        )

        # Lv11+ 时 Block2(active_level_max=10) 跳过，但 Block3(active_level_min=11) 执行
        # Block3 也是 enemy_back_row + force_crit，所以 back_row 仍受伤
        # 此测试主要验证不报错且 back_row 受伤（来自 Block3）
        self.assertLess(self.enemy_lb.current_hp, lb_hp_before,
                        "Lv11+ enemy_lb 应受到 Block3 back_row 伤害")
        self.assertLess(self.enemy_rb.current_hp, rb_hp_before,
                        "Lv11+ enemy_rb 应受到 Block3 back_row 伤害")

    def test_ex_block3_lv11_force_crit_back_row(self):
        """EX(110039) Block3 (active_level_min=11): Lv11+ back_row force_crit强制暴击。

        force_crit=true 使 back_row 敌人必定暴击。验证：crit_rate=0 时 back_row 仍暴击。
        """
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[110039] = 15
        self.caster.crit_rate = 0.0  # 强制0暴击率

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block3 force_crit → back_row 必定暴击
        # 验证 back_row 受伤（暴击伤害 = 基础 * 1.5）
        self.assertLess(self.enemy_lb.current_hp, self.enemy_lb.max_hp,
                        "Lv15 enemy_lb 应受到 Block3 force_crit 暴击伤害")
        self.assertLess(self.enemy_rb.current_hp, self.enemy_rb.max_hp,
                        "Lv15 enemy_rb 应受到 Block3 force_crit 暴击伤害")

    def test_ex_block3_lv10_no_force_crit(self):
        """EX(110039) Lv10: Block3 跳过，无 force_crit（Block2 走 active_level_max=10）。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[110039] = 10
        self.caster.crit_rate = 0.0

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Lv10 时 Block3 跳过（active_level_min=11 未满足），仅 Block2 执行
        # Block2 无 force_crit，crit_rate=0 → back_row 不暴击
        # 验证 back_row 仍受伤（来自 Block2，非暴击）
        self.assertLess(self.enemy_lb.current_hp, self.enemy_lb.max_hp,
                        "Lv10 enemy_lb 应受到 Block2 back_row 伤害（无force_crit）")

    def test_ex_block4_fallback_when_no_targets(self):
        """EX(110039) Block4 (fallback_when_no_targets): 无side_columns目标时fallback最近敌方。

        场景：仅保留中前敌（enemy_cf），side_columns(左+右列)无目标 → fallback 到 enemy_single 威力100。
        """
        self._reset_caster()
        self._reset_enemies()
        # 移除 side_columns 范围的敌人（左列+右列），仅保留中前
        for e in [self.enemy_lf, self.enemy_lb, self.enemy_rf, self.enemy_rb]:
            e.is_alive = False
        self.bf.enemy_team = [self.enemy_cf]

        cf_hp_before = self.enemy_cf.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # fallback → enemy_cf（最近敌方）受到威力100伤害
        self.assertLess(self.enemy_cf.current_hp, cf_hp_before,
                        "fallback 时 enemy_cf 应受到威力100伤害")

    def test_ex_block4_no_fallback_when_targets_exist(self):
        """EX(110039) 有side_columns目标时不fallback：Block4 跳过。"""
        self._reset_caster()
        self._reset_enemies()

        cf_hp_before = self.enemy_cf.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # side_columns 有目标 → Block4 fallback 跳过 → enemy_cf 不应被 fallback 打到
        # 注意：enemy_cf 是中前，不在 side_columns 范围，也不在 back_row
        # 但 Block2/3 的 back_row 不含中前（仅 lb, rb, cb）
        # 所以 enemy_cf HP 应不变（除非 fallback 触发）
        # 验证：有目标时 enemy_cf 不受 fallback 伤害
        # 注意：若 enemy_cf 受到伤害，说明 fallback 误触发
        # 但需注意 back_row 在 Lv10 时会执行 Block2，enemy_cf 不在 back_row
        self.assertEqual(self.enemy_cf.current_hp, cf_hp_before,
                         "有side_columns目标时 enemy_cf 不应受 fallback 伤害")

    def test_ex_active_level_pair_lv10(self):
        """EX(110039) active_level_max=10 + active_level_min=11 成对条件：Lv10分支。

        Lv10: Block2(active_level_max=10)执行，Block3(active_level_min=11)跳过。
        """
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[110039] = 10
        self.caster.crit_rate = 0.0

        self.ss.execute_skill(
            caster=self.caster, skill_id=110039, battlefield=self.bf, skip_cost=True
        )

        # Lv10: Block2 执行（无 force_crit），Block3 跳过
        # back_row 受伤但非暴击
        self.assertLess(self.enemy_lb.current_hp, self.enemy_lb.max_hp,
                        "Lv10 Block2 应对 enemy_lb 造成伤害")

    def test_ex_active_level_pair_lv15(self):
        """EX(110039) active_level_max=10 + active_level_min=11 成对条件：Lv15分支。

        Lv15: Block2(active_level_max=10)跳过，Block3(active_level_min=11)执行(force_crit)。
        """
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[110039] = 15
        self.caster.crit_rate = 0.0

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110039, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Lv15: Block3 执行（force_crit），back_row 受暴击伤害
        self.assertLess(self.enemy_lb.current_hp, self.enemy_lb.max_hp,
                        "Lv15 Block3 应对 enemy_lb 造成暴击伤害")
        self.assertLess(self.enemy_rb.current_hp, self.enemy_rb.max_hp,
                        "Lv15 Block3 应对 enemy_rb 造成暴击伤害")

