    def test_as1_block1_enemy_side_columns_damage(self):
        """AS1(120088) Block1: enemy_side_columns(4単位) 范围伤害。"""
        self._reset_caster()
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120088, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # side_columns = 左列+右列 = 4单位
        self.assertLess(self.enemy_lf.current_hp, self.enemy_lf.max_hp,
                        "enemy_lf 应受到AS1 side_columns伤害")
        self.assertLess(self.enemy_lb.current_hp, self.enemy_lb.max_hp,
                        "enemy_lb 应受到AS1 side_columns伤害")
        self.assertLess(self.enemy_rf.current_hp, self.enemy_rf.max_hp,
                        "enemy_rf 应受到AS1 side_columns伤害")
        self.assertLess(self.enemy_rb.current_hp, self.enemy_rb.max_hp,
                        "enemy_rb 应受到AS1 side_columns伤害")

    def test_as1_lv11_dmg_dealt_up(self):
        """AS1(120088) Block2 (active_level_min=11): self dmg_dealt_up(永続, stackable)。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[120088] = 15

        self.ss.execute_skill(
            caster=self.caster, skill_id=120088, battlefield=self.bf, skip_cost=True
        )

        # 验证 caster 自身有 dmg_dealt_up buff
        dmg_ups = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_ups), 0, "Lv15 应有 dmg_dealt_up buff")
        self.assertTrue(dmg_ups[0].is_stackable, "dmg_dealt_up 应可叠加")
        # duration=-1 表示永续
        self.assertEqual(dmg_ups[0].duration, -1, "dmg_dealt_up 应为永续(duration=-1)")

    def test_as1_lv10_no_dmg_dealt_up(self):
        """AS1(120088) Lv10: 无 dmg_dealt_up（Block2 active_level_min=11 未满足）。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[120088] = 10

        self.ss.execute_skill(
            caster=self.caster, skill_id=120088, battlefield=self.bf, skip_cost=True
        )

        dmg_ups = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_ups), 0, "Lv10 时不应有 dmg_dealt_up buff")

    def test_as1_dmg_dealt_up_stackable(self):
        """AS1(120088) dmg_dealt_up stackable=true：每次施放生成唯一 buff_id。

        stackable=true → 多次施放叠加多个 buff（而非 refresh）。
        """
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[120088] = 15

        # 第一次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=120088, battlefield=self.bf, skip_cost=True
        )
        buffs_after_first = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(buffs_after_first), 0, "第一次施放应施加 dmg_dealt_up")
        first_count = len(buffs_after_first)

        # 第二次施放（skip_cost 且清除冷却）
        self.caster.skill_cooldowns = {}
        self.ss.execute_skill(
            caster=self.caster, skill_id=120088, battlefield=self.bf, skip_cost=True
        )
        buffs_after_second = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        # stackable=true → buff 数量增加
        self.assertGreater(len(buffs_after_second), first_count,
                           "stackable=true 第二次施放后 buff 数量应增加")

    def test_as1_targets_exist_blocks_when_no_targets(self):
        """AS1(120088) targets_exist: 无side_columns目标时技能被global_condition阻断。

        场景：仅保留中前敌，side_columns 无目标 → targets_exist 条件不满足。
        """
        self._reset_caster()
        self._reset_enemies()
        # 仅保留中前敌
        for e in [self.enemy_lf, self.enemy_lb, self.enemy_rf, self.enemy_rb]:
            e.is_alive = False
        self.bf.enemy_team = [self.enemy_cf]

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120088, battlefield=self.bf, skip_cost=True
        )

        # targets_exist 条件不满足 → execute_skill 返回 error
        # 注意：global_condition 不满足时 execute_skill 应返回 success=False 或 error
        self.assertFalse(result.get("success", False),
                         "无side_columns目标时 AS1(targets_exist) 应被阻断")

    def test_as1_targets_exist_allows_when_targets_exist(self):
        """AS1(120088) targets_exist: 有side_columns目标时条件满足，技能正常执行。"""
        self._reset_caster()
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120088, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"], "有side_columns目标时 AS1 应正常执行")

