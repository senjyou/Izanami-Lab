"""角色140301 純真無垢なるジーニアス 专项E2E测试

技能列表：
- EX: 110039 リディアたいちょうのめいれい（敵右列・左列[威力] + 後列横一列[威力]；
  Lv11+ 後列会心攻撃(force_crit)；対象範囲に敵が存在しない場合、最近敵単体に威力100）
- AS1: 120088 ジャマしちゃ、めっ……だよ？（敵右列・左列[威力]；
  Lv11+ self dmg_dealt_up[永続, stackable]；targets_exist global_condition）
- AS2: 120089 わるいこはおしおき（敵単体2hit[威力20固定]；
  target_survived -> 追撃[威力] + dmg_dealt_down[20%, attack_limited=1, stackable]）
- PS1: 130098 みんなをおたすけ（after_as_attack；self_and_friends dmg_taken_down
  [scale_by_alive_allies, attack_limited=1, stackable, 1hit]）
- PS2: 130099 がんばるね、おにいちゃん（on_turn_start, is_preemptive；
  enemy_single_furthest[威力] + remove_pp[2]；Lv11+ attacked_targets heal_efficacy_down
  [2actions]；cooldown=99, 1度のみ発動）

覆盖维度：
1. EX enemy_side_columns(4単位) + active_level_max/min成对条件 + force_crit(Lv11+) + fallback_when_no_targets
2. AS1 enemy_side_columns + targets_exist global_condition + Lv11+ dmg_dealt_up(stackable, 永続)
3. AS2 2hit固定威力 + target_survived条件 + 追撃 + dmg_dealt_down(attack_limited=1)
4. PS1 after_as_attack + self_and_friends dmg_taken_down + scale_by_alive_allies + attack_limited=1
5. PS2 on_turn_start + is_preemptive + enemy_single_furthest + remove_pp + Lv11+ heal_efficacy_down + cooldown=99
6. force_crit 专项：Lv11+ back_row强制暴击 / Lv10不强制 / 前排不强制
7. fallback_when_no_targets 专项：无目标时fallback最近敌方 / 有目标时不fallback
8. target_survived 专项：目标存活追加伤害 / 阵亡不追加
9. scale_by_alive_allies 专项：0/1/3/5存活队友数下scaling
10. active_level_min/max 专项：Lv1-10/Lv11-14/Lv15分支
11. 配置校验：5技能ID/force_crit/targets_exist/simultaneous_limit
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# dmg_taken_down -> RECEIVED_DAMAGE 枚举（与 dmg_taken_up 共用，正负值区分）
# dmg_dealt_up / dmg_dealt_down -> DEALT_DAMAGE 枚举
# heal_efficacy_down -> RECEIVED_HEALING 枚举
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
RECEIVED_HEALING = SkillEffectType.RECEIVED_HEALING.value


class TestActor140301(unittest.TestCase):
    """角色140301 純真無垢なるジーニアス 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

