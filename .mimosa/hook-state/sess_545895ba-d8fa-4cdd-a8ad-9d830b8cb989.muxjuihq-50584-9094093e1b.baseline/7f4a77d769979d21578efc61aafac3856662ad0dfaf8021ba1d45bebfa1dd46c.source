    def test_as2_block1_2hit_damage(self):
        """AS2(120089) Block1: enemy_single 2hit 威力20固定。"""
        self._reset_caster()
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 最近敌方(enemy_cf)受到2hit伤害
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "enemy_cf 应受到AS2 2hit伤害")

    def test_as2_block2_target_survived_additional_damage(self):
        """AS2(120089) Block2 (target_survived): 目标存活时追加伤害+debuff。

        场景：enemy_cf HP足够高，Block1 2hit后仍存活 → Block2 追撃+ dmg_dealt_down。
        """
        self._reset_caster()
        self._reset_enemies()
        # enemy_cf HP 设为很高，确保 Block1 后仍存活
        self.enemy_cf.max_hp = 999999
        self.enemy_cf.current_hp = 999999

        hp_before = self.enemy_cf.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 目标存活 → Block2 执行：追加伤害 + dmg_dealt_down
        self.assertLess(self.enemy_cf.current_hp, hp_before,
                        "目标存活时 Block2 应追加伤害")

        # 验证 dmg_dealt_down debuff
        dmg_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_downs), 0, "目标存活时应有 dmg_dealt_down debuff")
        self.assertTrue(dmg_downs[0].is_stackable, "dmg_dealt_down 应可叠加")
        self.assertEqual(getattr(dmg_downs[0], 'attack_limited', 0), 1,
                         "dmg_dealt_down attack_limited 应为1")

    def test_as2_block2_target_dead_no_additional(self):
        """AS2(120089) Block2 (target_survived): 目标阵亡时不追加。

        场景：enemy_cf HP很低，Block1 2hit后阵亡 → Block2 跳过。
        """
        self._reset_caster()
        self._reset_enemies()
        # enemy_cf HP 设为很低，确保 Block1 后阵亡
        self.enemy_cf.current_hp = 100

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 目标阵亡 → Block2 跳过
        self.assertFalse(self.enemy_cf.is_alive, "enemy_cf 应在 Block1 后阵亡")

        # 验证无 dmg_dealt_down debuff（Block2 跳过）
        # 注意：即使目标阵亡，debuffs 列表仍可检查（阵亡单位的 debuffs 不会被清除）
        dmg_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_downs), 0, "目标阵亡时不应有 dmg_dealt_down debuff")

    def test_as2_dmg_dealt_down_value_20_percent(self):
        """AS2(120089) Block2: dmg_dealt_down value=20 percent。"""
        self._reset_caster()
        self._reset_enemies()
        self.enemy_cf.max_hp = 999999
        self.enemy_cf.current_hp = 999999

        self.ss.execute_skill(
            caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
        )

        dmg_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_downs), 0, "应有 dmg_dealt_down debuff")
        # value=20, value_type=percent
        self.assertEqual(dmg_downs[0].value, 20.0, "dmg_dealt_down value 应为20")

