    # PS1: 130098 みんなをおたすけ（after_as_attack + scale_by_alive_allies）
    # ════════════════════════════════════════════════════════════════

    def test_ps1_triggers_after_as_attack(self):
        """PS1(130098) after_as_attack: AS攻击后触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # caster 执行AS2攻击（120089 无冷却，便于测试）
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 触发 after_as_attack
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120089, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130098]
        self.assertGreater(len(ps1_actions), 0,
                           "after_as_attack 应收集 PS1(130098)")

    def test_ps1_dmg_taken_down_self_and_friends(self):
        """PS1(130098) Block1: self_and_friends dmg_taken_down（含自身）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120089, battlefield=self.bf, skip_cost=True
        )

        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120089, result=result, battlefield=self.bf,
            primary_target=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130098]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="after_as_attack"
        )

        # self_and_friends 包含 caster 自身 + 所有友方
        caster_buffs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(caster_buffs), 0, "caster 自身应有 dmg_taken_down buff")

        for ally in [self.ally_front, self.ally_lb, self.ally_rb]:
            ally_buffs = [b for b in ally.buffs if b.effect_type == RECEIVED_DAMAGE]
            self.assertGreater(len(ally_buffs), 0,
                               f"{ally.name} 应有 dmg_taken_down buff")

