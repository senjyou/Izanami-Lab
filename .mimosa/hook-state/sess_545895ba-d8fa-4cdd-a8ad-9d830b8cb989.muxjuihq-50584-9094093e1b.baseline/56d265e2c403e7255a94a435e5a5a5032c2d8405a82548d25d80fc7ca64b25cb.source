#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
迁移技能数据从character_stats.db到skill_data.db

功能:
1. 从character_stats.db导出所有技能表数据
2. 导入到skill_data.db
3. 验证数据完整性
"""

import sys
import sqlite3
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()

PROJECT_ROOT = Path(__file__).parent.parent
SOURCE_DB = PROJECT_ROOT / "db" / "character_stats.db"
TARGET_DB = PROJECT_ROOT / "db" / "skill_data.db"

# 需要迁移的表（按依赖顺序）
TABLES_TO_MIGRATE = [
    # 基础表
    'skills',
    'skill_kind_changes',
    'skill_tag_values',
    
    # 效果表
    'skill_effect_groups',
    'group_conditions',
    'skill_effects',
    'effect_conditions',
    'effect_params',
    
    # 被动触发表
    'passive_triggers',
    'trigger_conditions',
    'trigger_action_groups',
    'trigger_effects',
    'trigger_effect_conditions',
    'trigger_effect_params',
    
    # 映射表
    'character_skills',
]


def get_table_count(conn, table_name):
    """获取表的记录数"""
    cursor = conn.cursor()
    cursor.execute(f"SELECT COUNT(*) FROM {table_name}")
    return cursor.fetchone()[0]


def migrate_table(source_conn, target_conn, table_name):
    """迁移单个表的数据"""
    safe_print(f"\nMigrating table: {table_name}")
    
    source_cursor = source_conn.cursor()
    target_cursor = target_conn.cursor()
    
    # 检查源表是否存在
    source_cursor.execute(f"SELECT name FROM sqlite_master WHERE type='table' AND name='{table_name}'")
    if not source_cursor.fetchone():
        safe_print(f"  Source table not found, skipping")
        return 0
    
    # 获取源表数据
    source_cursor.execute(f"SELECT * FROM {table_name}")
    rows = source_cursor.fetchall()
    
    if not rows:
        safe_print(f"  No data to migrate")
        return 0
    
    # 获取列名
    source_cursor.execute(f"PRAGMA table_info({table_name})")
    columns = [col[1] for col in source_cursor.fetchall()]
    
    # 构建INSERT语句
    placeholders = ','.join(['?' for _ in columns])
    insert_sql = f"INSERT OR REPLACE INTO {table_name} VALUES ({placeholders})"
    
    # 插入数据
    count = 0
    for row in rows:
        try:
            target_cursor.execute(insert_sql, row)
            count += 1
        except Exception as e:
            safe_print(f"  Error inserting row: {e}")
    
    target_conn.commit()
    safe_print(f"  Migrated {count} rows")
    return count


def main():
    """主函数"""
    safe_print("="*80)
    safe_print("Migrating Skill Data to Separate Database")
    safe_print("="*80)
    
    safe_print(f"\nSource: {SOURCE_DB}")
    safe_print(f"Target: {TARGET_DB}")
    
    # 连接数据库
    safe_print("\nConnecting to databases...")
    source_conn = sqlite3.connect(SOURCE_DB)
    target_conn = sqlite3.connect(TARGET_DB)
    
    # 迁移数据
    safe_print("\nMigrating tables...")
    total_rows = 0
    
    for table in TABLES_TO_MIGRATE:
        count = migrate_table(source_conn, target_conn, table)
        total_rows += count
    
    # 验证
    safe_print("\n" + "="*80)
    safe_print("Verification")
    safe_print("="*80)
    
    for table in TABLES_TO_MIGRATE:
        try:
            source_count = get_table_count(source_conn, table)
            target_count = get_table_count(target_conn, table)
            
            status = "OK" if source_count == target_count else "MISMATCH"
            safe_print(f"{table:30s} Source: {source_count:6d}  Target: {target_count:6d}  [{status}]")
        except Exception as e:
            safe_print(f"{table:30s} Error: {e}")
    
    source_conn.close()
    target_conn.close()
    
    safe_print("\n" + "="*80)
    safe_print(f"Migration Complete! Total rows: {total_rows}")
    safe_print("="*80)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        safe_print(f"\nERROR: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)
