"""Regression: 130019 ホワイト・セットアップ (104201 ミステリアスガール).

Validates:
1. Config: trigger_type=on_turn_start, global_condition=and[self_hp_percent>=20, round_number>1]
2. Config: consume_hp effect with value=10, hp_base='current_hp'
3. Config: heal_over_time effect with value_tag='cure', duration=2, heal_base='atk'
4. Trigger: does NOT fire on turn 1 (round_number > 1 condition)
5. Trigger: does NOT fire when caster HP < 20%
6. Trigger: fires on turn 2+ with caster HP >= 20%
7. After execution: caster HP reduced by 10% of current HP (consume_hp)
8. After execution: caster gains HEAL_OVER_TIME buff (duration=2, value=25.0 at Lv10)
9. apply_regen heals: caster_attack * 25 / 100 = 2500 per action

Spec (docs/103201_104201_skill_implementation.md):
- PS on_turn_start: (self_hp>=20% AND round>1) -> consume_hp 10% current_hp
  + heal_over_time (atk x cure%, 2 actions)
- Lv10: cure=25.0
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'src'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

SKILL_ID = 130019  # ホワイト・セットアップ
HEAL_OVER_TIME = SkillEffectType.HEAL_OVER_TIME.value


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=0, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ap=10,
               crit_rate=0.0, crit_damage=0.5, current_hp=None):
    u = UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )
    return u


class TestReg104201WhiteSetup(unittest.TestCase):
    """130019: on_turn_start (HP>=20% AND round>1) -> consume_hp 10% + HOT."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _build_battlefield(self, caster_current_hp=None, turn_number=2):
        bf = BattlefieldState()
        bf.turn_number = turn_number
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=0, speed=500,
            skills=[SKILL_ID], skill_levels={SKILL_ID: 10},
            current_hp=caster_current_hp,
        )
        enemy = _make_unit(
            "enemy", "Enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=1000000, atk=1000, defense=0, speed=800,
        )
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]

        ss = SkillService(
            self.dl, ResourceService(),
            target_service=TargetService(), damage_service=DamageService(),
            aura_service=AuraService(), trigger_service=TriggerService(),
            status_service=StatusService(),
        )
        ss.set_battlefield(bf)

        ts = TriggerService()
        ts.set_data_loader(self.dl)
        ts.set_skill_service(ss)
        ts.set_damage_service(DamageService())

        return bf, ss, ts, caster, enemy

    # ── Config checks ────────────────────────────────────────

    def test_config_trigger_type_and_global_condition(self):
        """130019 should have trigger_type=on_turn_start with and-condition."""
        parsed = self.dl.get_parsed_skill_data(SKILL_ID)
        self.assertEqual(parsed.get('trigger_type'), 'on_turn_start')
        cond = parsed.get('global_condition')
        self.assertIsNotNone(cond)
        self.assertEqual(cond.get('type'), 'and')
        conditions = cond.get('conditions', [])
        self.assertEqual(len(conditions), 2)
        cond_types = {c.get('type') for c in conditions}
        self.assertEqual(cond_types, {'self_hp_percent', 'round_number'})
        # self_hp_percent >= 20
        shp = next(c for c in conditions if c.get('type') == 'self_hp_percent')
        self.assertEqual(shp.get('operator'), '>=')
        self.assertEqual(shp.get('value'), 20)
        # round_number > 1
        rn = next(c for c in conditions if c.get('type') == 'round_number')
        self.assertEqual(rn.get('operator'), '>')
        self.assertEqual(rn.get('value'), 1)

    def test_config_consume_hp_effect(self):
        """130019 should have consume_hp effect with value=10, hp_base=current_hp."""
        parsed = self.dl.get_parsed_skill_data(SKILL_ID)
        consume_hp_effects = []
        for block in parsed.get('effect_blocks', []):
            for eff in block.get('effects', []):
                if eff.get('effect_type') == 'consume_hp':
                    consume_hp_effects.append(eff)
        self.assertEqual(len(consume_hp_effects), 1)
        eff = consume_hp_effects[0]
        self.assertEqual(eff.get('value'), 10, "consume_hp value should be 10 (10%)")
        self.assertEqual(eff.get('target_type'), 'self')
        self.assertEqual(eff.get('flags', {}).get('hp_base'), 'current_hp')

    def test_config_hot_effect(self):
        """130019 should have heal_over_time effect with duration=2, heal_base='atk'."""
        parsed = self.dl.get_parsed_skill_data(SKILL_ID)
        hot_effects = []
        for block in parsed.get('effect_blocks', []):
            for eff in block.get('effects', []):
                if eff.get('effect_type') == 'heal_over_time':
                    hot_effects.append(eff)
        self.assertEqual(len(hot_effects), 1)
        eff = hot_effects[0]
        self.assertEqual(eff.get('target_type'), 'self')
        self.assertEqual(eff.get('value_tag'), 'cure')
        self.assertEqual(eff.get('duration'), 2, "HOT duration should be 2 actions")
        self.assertEqual(eff.get('duration_type'), 'action')
        self.assertEqual(eff.get('flags', {}).get('heal_base'), 'atk')

    # ── Trigger checks ───────────────────────────────────────

    def test_does_not_fire_on_turn_1(self):
        """130019 must NOT fire on turn 1 (round_number > 1 condition)."""
        bf, ss, ts, caster, enemy = self._build_battlefield(
            caster_current_hp=100000, turn_number=1)
        actions = ts.trigger_turn_start(bf)
        ps_actions = [a for a in actions if a.skill_id == SKILL_ID]
        self.assertEqual(len(ps_actions), 0,
                         "130019 must NOT fire on turn 1")

    def test_does_not_fire_when_hp_below_20_percent(self):
        """130019 must NOT fire when caster HP < 20%."""
        bf, ss, ts, caster, enemy = self._build_battlefield(
            caster_current_hp=19000, turn_number=2)  # 19% < 20%
        actions = ts.trigger_turn_start(bf)
        ps_actions = [a for a in actions if a.skill_id == SKILL_ID]
        self.assertEqual(len(ps_actions), 0,
                         "130019 must NOT fire when HP < 20%")

    def test_fires_when_hp_at_20_percent_boundary(self):
        """130019 should fire when HP = 20% (>= condition)."""
        bf, ss, ts, caster, enemy = self._build_battlefield(
            caster_current_hp=20000, turn_number=2)  # exactly 20%
        actions = ts.trigger_turn_start(bf)
        ps_actions = [a for a in actions if a.skill_id == SKILL_ID]
        self.assertEqual(len(ps_actions), 1,
                         "130019 should fire when HP = 20% (boundary)")

    def test_fires_on_turn_2_with_sufficient_hp(self):
        """130019 should fire on turn 2 when HP >= 20%."""
        bf, ss, ts, caster, enemy = self._build_battlefield(
            caster_current_hp=100000, turn_number=2)
        actions = ts.trigger_turn_start(bf)
        ps_actions = [a for a in actions if a.skill_id == SKILL_ID]
        self.assertEqual(len(ps_actions), 1,
                         "130019 should fire on turn 2 with HP >= 20%")

    # ── Execution checks ─────────────────────────────────────

    def test_consume_hp_reduces_caster_hp_by_10_percent(self):
        """consume_hp should reduce caster's HP by 10% of current HP."""
        bf, ss, ts, caster, enemy = self._build_battlefield(
            caster_current_hp=100000, turn_number=2)
        hp_before = caster.current_hp
        # Direct execute (bypass trigger) for unit-level check
        ss.execute_skill(caster, SKILL_ID, bf, skip_cost=True)
        expected_consumed = int(100000 * 0.10)  # 10000
        self.assertEqual(caster.current_hp, hp_before - expected_consumed,
                         f"caster HP should be reduced by 10% (={expected_consumed}), "
                         f"got reduction {hp_before - caster.current_hp}")

    def test_hot_buff_applied_with_correct_value(self):
        """After execution, caster gains HEAL_OVER_TIME buff with value=25.0 (Lv10 cure)."""
        bf, ss, ts, caster, enemy = self._build_battlefield(
            caster_current_hp=100000, turn_number=2)
        ss.execute_skill(caster, SKILL_ID, bf, skip_cost=True)
        hot_buffs = [b for b in caster.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hot_buffs), 1,
                         f"Should have 1 HEAL_OVER_TIME buff, got {len(hot_buffs)}")
        # Lv10 cure = 25.0
        self.assertAlmostEqual(hot_buffs[0].value, 25.0, delta=0.01,
                               msg=f"HOT value should be 25.0 (Lv10 cure), got {hot_buffs[0].value}")
        # duration=2 actions
        self.assertEqual(hot_buffs[0].duration, 2,
                         f"HOT duration should be 2 actions, got {hot_buffs[0].duration}")
        self.assertEqual(hot_buffs[0].heal_base, 'atk',
                         f"HOT heal_base should be 'atk', got {getattr(hot_buffs[0], 'heal_base', None)}")

    def test_apply_regen_heals_based_on_atk(self):
        """apply_regen should heal caster_attack * cure% per action.

        Lv10: caster_attack=10000, cure=25.0 => heal = 2500 per action.
        """
        bf, ss, ts, caster, enemy = self._build_battlefield(
            caster_current_hp=100000, turn_number=2)
        # Apply PS: consumes 10% HP then applies HOT
        ss.execute_skill(caster, SKILL_ID, bf, skip_cost=True)
        # After PS: caster.current_hp = 100000 - 10000 = 90000
        hp_after_ps = caster.current_hp
        # Verify HOT buff present
        hot_buffs = [b for b in caster.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hot_buffs), 1)

        # Simulate action start: apply_regen heals
        status_svc = StatusService()
        # Set caster.current_hp below max to allow heal
        # (already below max after consume_hp)
        total_heal, regen_details = status_svc.apply_regen(
            caster, damage_service=ss.damage_service, battlefield=bf)
        # Expected heal: caster_attack (snapshot at buff creation) * 25 / 100 = 2500
        expected_heal = int(10000 * 25.0 / 100)  # 2500
        self.assertGreater(total_heal, 0, "apply_regen should heal")
        self.assertAlmostEqual(total_heal, expected_heal, delta=expected_heal * 0.05,
                               msg=f"apply_regen heal should be ~{expected_heal} "
                                   f"(atk * cure%), got {total_heal}")


if __name__ == '__main__':
    unittest.main()
