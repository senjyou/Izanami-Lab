"""回忆卡debuff方向验证测试

Bug: _apply_structured_effect_to_unit对debuff取负值(final_value=-abs(value))，
但_aggregate_buff_value_signed已通过buff_val-debuff_val处理符号，导致双重取反。
debuff效果全部反向：atk_down变atk_up, def_down变def_up, spd_down变spd_up, 易伤变减伤。

修复: final_value=abs(value)，value保持正值，符号由buff/debuff池分离处理。
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.battle_flow_controller import BattleFlowController


class TestMemoryCardDebuffs(unittest.TestCase):
    """回忆卡debuff方向验证"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.enemy = UnitState(
            unit_id="enemy_front", name="敌方前排", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.bf.enemy_team = [self.enemy]
        self.bf.friend_team = []
        self.dms = DamageService()
        self.aus = AuraService()
        self.controller = BattleFlowController(self.bf, self.dl)
        self.controller.damage_service = self.dms
        self.controller.aura_service = self.aus

    def _apply_structured_effect(self, skill_id, skill_name, effect_type, value,
                                  value_tag=0, is_buff=True, duration=-1):
        """辅助: 调用_apply_structured_effect_to_unit施加一个结构化效果"""
        effect = {
            "effect_type": effect_type,
            "value": value,
            "value_tag": value_tag,
            "is_buff": is_buff,
            "duration": duration,
            "timing_type": 3,
        }
        self.controller._apply_structured_effect_to_unit(
            "测试回忆卡", self.enemy, skill_id, skill_name, effect
        )

    def test_received_damage_debuff_increases_damage(self):
        """ReceivedDamage debuff(is_buff=false)应让敌方受到更多伤害(rcvd>1.0, 易伤)

        400204: 被ダメージ上昇【敵前衛】value=7.5%
        修复前: final_value=-7.5 → rcvd=0.925(减伤, bug)
        修复后: final_value=7.5 → rcvd=1.075(易伤, correct)
        """
        self._apply_structured_effect(
            skill_id=400204, skill_name="被ダメージ上昇",
            effect_type="ReceivedDamage", value=7.5,
            value_tag=0, is_buff=False
        )
        rcvd = self.dms._get_damage_received_multiplier(self.enemy)
        self.assertGreater(rcvd, 1.0,
                           f"ReceivedDamage debuff应增伤 rcvd>1.0, 实际={rcvd}")
        self.assertAlmostEqual(rcvd, 1.075, places=3,
                               msg=f"7.5%易伤应使rcvd=1.075, 实际={rcvd}")

    def test_received_damage_buff_decreases_damage(self):
        """ReceivedDamage buff(is_buff=true)应让友方受到更少伤害(rcvd<1.0, 减伤)

        对比测试: 确保buff方向未被破坏
        """
        self._apply_structured_effect(
            skill_id=400199, skill_name="被ダメージ軽減",
            effect_type="ReceivedDamage", value=7.5,
            value_tag=0, is_buff=True
        )
        rcvd = self.dms._get_damage_received_multiplier(self.enemy)
        self.assertLess(rcvd, 1.0,
                        f"ReceivedDamage buff应减伤 rcvd<1.0, 实际={rcvd}")
        self.assertAlmostEqual(rcvd, 0.925, places=3,
                               msg=f"7.5%减伤应使rcvd=0.925, 实际={rcvd}")

    def test_status_attack_debuff_decreases_attack(self):
        """StatusAttack debuff(is_buff=false)应降低敌方攻击力

        400024: 攻撃減少【最高速度】value=525(固定值)
        修复前: final_value=-525 → atk增加525(bug)
        修复后: final_value=525 → atk降低525(correct)
        """
        base_atk = self.enemy.attack  # 10000
        self._apply_structured_effect(
            skill_id=400024, skill_name="攻撃減少",
            effect_type="StatusAttack", value=525,
            value_tag=1, is_buff=False
        )
        final_atk = self.dms._calculate_final_stat(self.enemy, "attack")
        self.assertLess(final_atk, base_atk,
                        f"StatusAttack debuff应降低攻击 {final_atk}<{base_atk}")
        self.assertEqual(final_atk, base_atk - 525,
                         f"atk_down 525应使攻击={base_atk}-525={base_atk-525}, 实际={final_atk}")

    def test_status_defense_debuff_decreases_defense(self):
        """StatusDefense debuff(is_buff=false)应降低敌方防御力

        400025: 防御減少【最高攻撃】value=210(固定值)
        """
        base_def = self.enemy.defense  # 5000
        self._apply_structured_effect(
            skill_id=400025, skill_name="防御減少",
            effect_type="StatusDefense", value=210,
            value_tag=1, is_buff=False
        )
        final_def = self.dms._calculate_final_stat(self.enemy, "defense")
        self.assertLess(final_def, base_def,
                        f"StatusDefense debuff应降低防御 {final_def}<{base_def}")
        self.assertEqual(final_def, base_def - 210,
                         f"def_down 210应使防御={base_def}-210={base_def-210}, 实际={final_def}")

    def test_status_speed_debuff_decreases_speed(self):
        """StatusSpeed debuff(is_buff=false)应降低敌方速度

        400023: 攻撃減少・速度減少【前衛】value=7(固定值)
        """
        base_spd = self.enemy.speed  # 500
        self._apply_structured_effect(
            skill_id=400023, skill_name="速度減少",
            effect_type="StatusSpeed", value=7,
            value_tag=1, is_buff=False
        )
        final_spd = self.dms._calculate_final_stat(self.enemy, "speed")
        self.assertLess(final_spd, base_spd,
                        f"StatusSpeed debuff应降低速度 {final_spd}<{base_spd}")
        self.assertEqual(final_spd, base_spd - 7,
                         f"spd_down 7应使速度={base_spd}-7={base_spd-7}, 实际={final_spd}")

    def test_status_attack_buff_increases_attack(self):
        """StatusAttack buff(is_buff=true)应增加攻击力(对比测试)"""
        base_atk = self.enemy.attack
        self._apply_structured_effect(
            skill_id=400099, skill_name="攻撃上昇",
            effect_type="StatusAttack", value=500,
            value_tag=1, is_buff=True
        )
        final_atk = self.dms._calculate_final_stat(self.enemy, "attack")
        self.assertGreater(final_atk, base_atk,
                           f"StatusAttack buff应增加攻击 {final_atk}>{base_atk}")
        self.assertEqual(final_atk, base_atk + 500,
                         f"atk_up 500应使攻击={base_atk}+500={base_atk+500}, 实际={final_atk}")


if __name__ == "__main__":
    unittest.main()
