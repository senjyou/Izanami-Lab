class TestActor114302DamageTakenDownThreshold:
    """dmg_taken_down_threshold 阈值减伤机制测试"""

    def test_threshold_buff_reduces_whole_damage_above_threshold(self):
        """超过阈值的伤害整体按 value% 减免

        描述「自身の現在HPの20%を超えるダメージのみ{dmg}%減少させる」:
        若 dmg > threshold, 整个伤害按 value% 减免 (非仅超过部分).
        公式: actual = dmg × (1 - value/100) if dmg > threshold else dmg
        """
        # threshold = current_hp × 20 / 100
        # 例: current_hp=10000, threshold=2000, dmg=5000, value=50%
        # actual = 5000 × 0.5 = 2500
        threshold = 2000
        dmg = 5000
        value = 50
        expected = dmg * (1 - value / 100) if dmg > threshold else dmg
        assert expected == 2500

    def test_threshold_buff_no_effect_below_threshold(self):
        """伤害未超过阈值时不减免"""
        threshold = 2000
        dmg = 1500
        value = 50
        actual = dmg * (1 - value / 100) if dmg > threshold else dmg
        assert actual == 1500  # 无减免


