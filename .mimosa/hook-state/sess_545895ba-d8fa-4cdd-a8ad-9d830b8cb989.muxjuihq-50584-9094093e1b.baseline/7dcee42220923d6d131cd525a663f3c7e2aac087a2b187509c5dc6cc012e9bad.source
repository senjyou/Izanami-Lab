"""渚のスイートデビル (114302) 技能集成测试

验证5个技能的核心场景:
- 110072 ミッドサマー・ラブ (EX): 3次随机抽取敌/友目标
- 120160 サマー・スプラッシュ (AS): 4hit EN攻击 + EX窃取
- 130158 ヒートアップ・ラブ (PS1): 被击后按EX消费比例回血
- 130159 アクア・セービング (PS2): 友方累计伤害触发, 需消费EX
- 130160 サマータイム・ロマンス (PS): 战斗中一次先制, 赋予「汐風」mark
"""
import pytest
import json
from pathlib import Path


class TestActor114302Config:
    """配置正确性测试"""

    @pytest.fixture
    def hybrid_data(self):
        path = Path(__file__).parent.parent / "data" / "skill_effects_hybrid.json"
        with open(path, encoding='utf-8') as f:
            return json.load(f)

    def test_110072_config_exists(self, hybrid_data):
        """110072 ミッドサマー・ラブ 配置存在且含 random_draw"""
        skill = hybrid_data.get("110072")
        assert skill is not None
        assert skill["parse_status"] == "manual"
        # Block 1 应含 random_draw effect
        block1 = skill["effect_blocks"][0]
        random_draw_effects = [e for e in block1["effects"] if e["effect_type"] == "random_draw"]
        assert len(random_draw_effects) == 1
        assert random_draw_effects[0]["hit_count"] == 3
        assert "ally_single_exclude_self" in random_draw_effects[0]["flags"]["candidate_types"]
        assert "enemy_single_nearest" in random_draw_effects[0]["flags"]["candidate_types"]

    def test_120160_config_4hit(self, hybrid_data):
        """120160 サマー・スプラッシュ 4hit EN攻击"""
        skill = hybrid_data.get("120160")
        assert skill is not None
        assert skill["parse_status"] == "manual"
        damage_effects = [e for e in skill["effect_blocks"][0]["effects"]
                          if e["effect_type"] == "damage"]
        assert len(damage_effects) == 1  # 单个damage effect
        assert damage_effects[0]["hit_count"] == 4
        assert damage_effects[0]["flags"]["is_en_attack"] is True

    def test_120160_ex_steal_effects(self, hybrid_data):
        """120160 含 remove_ep + add_ep 条件效果"""
        effects = hybrid_data["120160"]["effect_blocks"][0]["effects"]
        remove_ep = [e for e in effects if e["effect_type"] == "remove_ep"]
        add_ep = [e for e in effects if e["effect_type"] == "add_ep"]
        assert len(remove_ep) == 1
        assert len(add_ep) == 1
        assert remove_ep[0]["condition"]["type"] == "target_ep_above_or_equal"
        assert remove_ep[0]["condition"]["value"] == 1

    def test_130158_config_after_as_attacked(self, hybrid_data):
        """130158 ヒートアップ・ラブ trigger_type=after_as_attacked"""
        skill = hybrid_data.get("130158")
        assert skill is not None
        assert skill["trigger_type"] == "after_as_attacked"
        assert skill["parse_status"] == "manual"
        # global_condition 含 damage_taken_in_action_percent
        gc = skill["global_condition"]
        assert gc["type"] == "and"
        cond_types = [c["type"] for c in gc["conditions"]]
        assert "damage_taken_in_action_percent" in cond_types
        assert "self_ep_above_or_equal" in cond_types
        # allow_ex_trigger: 描述未限定アクティブスキル, EX技能也可触发
        assert skill.get("allow_ex_trigger") is True

    def test_130158_two_ex_tiers(self, hybrid_data):
        """130158 含 EX>=3 (Block1) 和 EX<3且EX>=2 (Block2) 两档"""
        blocks = hybrid_data["130158"]["effect_blocks"]
        # Block1: EX>=3 消费2EX
        b1_cond = blocks[0]["condition"]
        assert b1_cond["type"] == "self_ep_above_or_equal"
        assert b1_cond["value"] == 3
        b1_remove = [e for e in blocks[0]["effects"] if e["effect_type"] == "remove_ep"]
        assert b1_remove[0]["value"] == 2
        # Block2: EX<3 且 EX>=2 消费1EX
        b2_cond = blocks[1]["condition"]
        assert b2_cond["type"] == "and"

    def test_130158_heal_value_source(self, hybrid_data):
        """130158 heal 使用 value_source=damage_taken_in_action"""
        for block in hybrid_data["130158"]["effect_blocks"]:
            for e in block["effects"]:
                if e["effect_type"] == "heal":
                    assert e["value_source"] == "damage_taken_in_action"

    def test_130159_config_on_cumulative_damage(self, hybrid_data):
        """130159 アクア・セービング trigger_type=on_cumulative_damage"""
        skill = hybrid_data.get("130159")
        assert skill is not None
        assert skill["trigger_type"] == "on_cumulative_damage"
        gc = skill["global_condition"]
        cond_types = [c["type"] for c in gc["conditions"]]
        assert "check_other_allies_with_mark" in cond_types
        assert "ally_cumulative_damage_percent" in cond_types
        assert "self_ps_lower_priority_than" in cond_types

    def test_130159_heal_uses_max_hp(self, hybrid_data):
        """130159 heal 使用 value_source=max_hp"""
        heal_eff = hybrid_data["130159"]["effect_blocks"][0]["effects"][0]
        assert heal_eff["effect_type"] == "heal"
        assert heal_eff["value_source"] == "max_hp"

    def test_130160_config_once_per_battle(self, hybrid_data):
        """130160 サマータイム・ロマンス cooldown=99"""
        skill = hybrid_data.get("130160")
        assert skill is not None
        assert skill["trigger_type"] == "on_turn_start"
        assert skill["cooldown"] == 99  # 一次触发近似

    def test_130160_mark_value_3(self, hybrid_data):
        """130160 mark value=3 一次性赋3层"""
        effects = hybrid_data["130160"]["effect_blocks"][0]["effects"]
        mark_eff = [e for e in effects if e["effect_type"] == "mark"][0]
        assert mark_eff["value"] == 3
        assert mark_eff["flags"]["mark_name"] == "汐風"
        assert mark_eff["flags"]["is_buff_mark"] is True
        assert mark_eff["flags"]["stackable"] is True

    def test_130160_dmg_taken_down_threshold(self, hybrid_data):
        """130160 含 dmg_taken_down_threshold effect"""
        effects = hybrid_data["130160"]["effect_blocks"][0]["effects"]
        threshold_effs = [e for e in effects if e["effect_type"] == "dmg_taken_down_threshold"]
        assert len(threshold_effs) >= 1
        # Lv1-10: hit_count=1
        assert threshold_effs[0]["hit_count"] == 1
        assert threshold_effs[0]["flags"]["threshold_pct"] == 20
        assert threshold_effs[0]["flags"]["threshold_base"] == "current_hp"

    def test_130160_level_gating(self, hybrid_data):
        """130160 dmg_taken_down_threshold 按 Lv 分级"""
        effects = hybrid_data["130160"]["effect_blocks"][0]["effects"]
        threshold_effs = [e for e in effects if e["effect_type"] == "dmg_taken_down_threshold"]
        # Lv11: hit_count=2
        lv11 = [e for e in threshold_effs if e.get("flags", {}).get("level_min") == 11]
        assert len(lv11) == 1
        assert lv11[0]["hit_count"] == 2
        # Lv12+: hit_count=3
        lv12 = [e for e in threshold_effs if e.get("flags", {}).get("level_min") == 12]
        assert len(lv12) == 1
        assert lv12[0]["hit_count"] == 3


