"""角色110303 自由に煌めくジョーカーカード 专项E2E测试（呼応mark全链 + 临时降防 + 特殊索敌）

技能列表（5个）:
- EX:  110078 自由な未来へ！（敵全体EN攻撃 + 呼応1つにつき一時的にdef%低下させて攻撃）
- AS1: 120167 ネクサスエッジオーバーロード（呼応最少敵優先EN攻撃 + 対象と自身に呼応+1 + 自身呼応>=10不发动）
- AS2: 120168 トリプルカオスキャノン（呼応最少敵優先3hit EN攻撃 + 呼応降防）
- PS1: 130175 アブセンストリガー（ASを3回使用するたび発動 + 最低防御敵EN攻撃 + Lv11+被伤debuff + 呼応>=10 AP+1/atk_up）
- PS2: 130176 ジョーカーカード（累計受傷害>=maxHP*10%発動 + 自解2buff + 1行動atk_up + 可解除buff<2不发动）

覆盖维度:
1. EX: 敵全体攻撃 + 各目標按呼応数量临时降防（Lv10:3.5%/個, Lv15:7.5%/個, 最大10個）
2. AS1: enemy_single_lowest_mark_count索敌（多目标不同呼応数→选最少；相同→最近）
3. AS1: 攻击后目标与自身各+1呼応（unremovable, stackable, 永続）
4. AS1: 自身呼応>=10时不发动（global_condition self_mark_count <10）
5. AS2: 3hit攻撃 + 呼応最少优先索敌 + 呼応降防
6. PS1: on_skill_use_count + skill_use_count_modulo=3触发
7. PS1: enemy_single_lowest_def索敌（选防御最低）
8. PS1: Lv11+ dmg_taken_up attack_limited=1（1次被攻击消耗, stackable）
9. PS1: 自身呼応>=10时 AP+1 + atk_up（重複可, 永続）
10. PS2: on_cumulative_damage触发 + 自解2buff + 1行動atk_up + 可解除buff<2不触发
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

MARK = SkillEffectType.MARK.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value

KOYO = "呼応"  # mark name 常量


def _make_koyo_marks(source_id="pre", count=1, is_buff=False):
    """生成 count 个「呼応」mark BuffState（debuff/buff, stackable, 永続, unremovable）。"""
    return [
        BuffState(
            buff_id=f"{source_id}_koyo_{i}_{id(source_id)}",
            name=KOYO,
            effect_type=MARK,
            value=0,
            duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=source_id,
            source_skill_id=0,
            is_debuff=not is_buff,
            is_stackable=True,
            unremovable=True,
        )
        for i in range(count)
    ]


class TestActor110303(unittest.TestCase):
    """角色110303 自由に煌めくジョーカーカード 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 110303 (暗属性attr=6, EN型character_type=2, position_type=3灵活)
        self.caster = UnitState(
            unit_id="caster", name="自由に煌めくジョーカーカード", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=110303, level=10,
            element=6, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110078, 120167, 120168, 130175, 130176],
            skill_levels={110078: 10, 120167: 10, 120168: 10,
                          130175: 10, 130176: 10},
            skill_cooldowns={},
        )

        # 敌方前排中央（最近敌）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=8000, defense=8000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（多目标测试用）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=7000, defense=6000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（防御最低，用于130175最低防御索敌测试）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=6500, defense=4000, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    # ════════════════════════════════════════════════════════════════
    # 辅助方法
    # ════════════════════════════════════════════════════════════════

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0, level=10, crit_rate=0.0):
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.level = level
        self.caster.crit_rate = crit_rate
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = level

    def _reset_enemy(self, enemy, hp=None):
        enemy.current_hp = hp if hp is not None else enemy.max_hp
        enemy.buffs = []
        enemy.debuffs = []
        enemy.is_alive = True

    def _reset_enemies(self):
        for e in self.bf.enemy_team:
            self._reset_enemy(e)

    def _count_koyo(self, unit, is_buff=False):
        """返回单位持有的「呼応」mark 数量。"""
        pool = unit.buffs if is_buff else unit.debuffs
        return sum(1 for b in pool
                   if b.effect_type == MARK and getattr(b, 'name', '') == KOYO)

    def _pre_apply_koyo(self, unit, count, source_id="pre", is_buff=False):
        """给单位预先施加 count 个「呼応」mark。"""
        for m in _make_koyo_marks(source_id, count, is_buff=is_buff):
            (unit.buffs if is_buff else unit.debuffs).append(m)

    def _get_temp_def_down(self, unit):
        """获取单位身上的呼応降防临时 def_down debuff。"""
        for d in unit.debuffs:
            if d.buff_id and d.buff_id.startswith("mark_count_def_penetrate"):
                return d
        return None

    # ════════════════════════════════════════════════════════════════
    # AS1: 120167 ネクサスエッジオーバーロード
    # ════════════════════════════════════════════════════════════════

    def test_as1_targets_lowest_mark_count(self):
        """AS1(120167): 呼応最少の敵を優先（e_cf=2, e_lf=0, e_rf=1 → 选 e_lf）。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        self._pre_apply_koyo(self.enemy_cf, 2, "pre_cf")
        self._pre_apply_koyo(self.enemy_lf, 0, "pre_lf")
        self._pre_apply_koyo(self.enemy_rf, 1, "pre_rf")

        hp_before = {u.unit_id: u.current_hp for u in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=120167,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_lf.current_hp, hp_before['enemy_lf'],
                        "AS1 应优先选呼応最少(0)的 enemy_lf")
        self.assertEqual(self.enemy_cf.current_hp, hp_before['enemy_cf'],
                         "AS1 不应攻击 enemy_cf(呼応=2)")
        self.assertEqual(self.enemy_rf.current_hp, hp_before['enemy_rf'],
                         "AS1 不应攻击 enemy_rf(呼応=1)")

    def test_as1_tiebreak_nearest(self):
        """AS1(120167): 呼応数量相同（都为0）→ 按距离最近优先。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        hp_before = self.enemy_cf.current_hp  # 中前 = 最近
        self.ss.execute_skill(caster=self.caster, skill_id=120167,
                              battlefield=self.bf, skip_cost=True)
        self.assertLess(self.enemy_cf.current_hp, hp_before,
                        "呼応相同(0)时应选距离最近的 enemy_cf")

    def test_as1_applies_koyo_to_target_and_self(self):
        """AS1(120167): 攻击后目标与自身各+1呼応（unremovable）。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        self.ss.execute_skill(caster=self.caster, skill_id=120167,
                              battlefield=self.bf, skip_cost=True)
        # 目标 = 最近 (enemy_cf)
        self.assertEqual(self._count_koyo(self.enemy_cf), 1)
        self.assertEqual(self._count_koyo(self.caster, is_buff=True), 1,
                         "自身也应获得1个呼応(buff mark)")
        # unremovable 校验
        self.assertTrue(all(getattr(b, 'unremovable', False) or getattr(b, 'is_unremovable', False)
                            for b in self.enemy_cf.debuffs if b.effect_type == MARK))
        self.assertTrue(all(getattr(b, 'unremovable', False) or getattr(b, 'is_unremovable', False)
                            for b in self.caster.buffs if b.effect_type == MARK))

    def test_as1_def_penetrate_per_mark(self):
        """AS1(120167): 目标呼応1個 → 临时降防3.5%。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        # 所有敌人等量呼応 → 平局选最近(enemy_cf)
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            self._pre_apply_koyo(e, 1, f"pre_{e.unit_id}")
        self.ss.execute_skill(caster=self.caster, skill_id=120167,
                              battlefield=self.bf, skip_cost=True)
        temp = self._get_temp_def_down(self.enemy_cf)
        self.assertIsNotNone(temp, "应创建呼応临时降防 debuff")
        self.assertAlmostEqual(temp.value, 3.5, places=2)

    def test_as1_def_penetrate_10_marks_capped(self):
        """AS1(120167): 目标呼応20個 → 临时降防封顶35% (3.5% × max10)。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        # 所有敌人等量呼応20 → 平局选最近(enemy_cf)
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            self._pre_apply_koyo(e, 20, f"pre_{e.unit_id}")
        self.ss.execute_skill(caster=self.caster, skill_id=120167,
                              battlefield=self.bf, skip_cost=True)
        temp = self._get_temp_def_down(self.enemy_cf)
        self.assertIsNotNone(temp)
        self.assertAlmostEqual(temp.value, 35.0, places=2)

    def test_as1_blocked_when_self_koyo_ge_10(self):
        """AS1(120167): 自身呼応>=10时技能不发动（global_condition self_mark_count <10）。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        self._pre_apply_koyo(self.caster, 10, "pre_self", is_buff=True)
        hp_before = {u.unit_id: u.current_hp for u in self.bf.enemy_team}
        result = self.ss.execute_skill(caster=self.caster, skill_id=120167,
                                       battlefield=self.bf, skip_cost=True)
        self.assertFalse(result["success"])
        for e in self.bf.enemy_team:
            self.assertEqual(e.current_hp, hp_before[e.unit_id],
                             "自身呼応>=10时AS1不应发动")

    # ════════════════════════════════════════════════════════════════
    # AS2: 120168 トリプルカオスキャノン
    # ════════════════════════════════════════════════════════════════

    def test_as2_three_hits_and_lowest_mark(self):
        """AS2(120168): 3ヒット攻撃 + 呼応最少索敌。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        self._pre_apply_koyo(self.enemy_cf, 3, "pre_cf")
        hp_before_lf = self.enemy_lf.current_hp
        result = self.ss.execute_skill(caster=self.caster, skill_id=120168,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_lf.current_hp, hp_before_lf,
                        "AS2 应优先选呼応最少(0)的 enemy_lf")
        # 3 hit 验证：单hit伤害约2807，3hit合计约8421（total_damage包含全部hit）
        self.assertGreaterEqual(result.get("total_damage", 0), 8000,
                                f"AS2 应为3ヒット攻击（实际total_damage={result.get('total_damage')}）")

    def test_as2_def_penetrate(self):
        """AS2(120168): 呼応1個 → 临时降防3.5%。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        # 所有敌人等量呼応 → 平局选最近(enemy_cf)
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            self._pre_apply_koyo(e, 1, f"pre_{e.unit_id}")
        self.ss.execute_skill(caster=self.caster, skill_id=120168,
                              battlefield=self.bf, skip_cost=True)
        temp = self._get_temp_def_down(self.enemy_cf)
        self.assertIsNotNone(temp)
        self.assertAlmostEqual(temp.value, 3.5, places=2)

    # ════════════════════════════════════════════════════════════════
    # EX: 110078 自由な未来へ！
    # ════════════════════════════════════════════════════════════════

    def test_ex_enemy_all_with_per_target_def_penetrate(self):
        """EX(110078): 敵全体攻撃，各目标独立按呼応数量降防(Lv10: 3.5%/個)。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        self._pre_apply_koyo(self.enemy_cf, 2, "pre_cf")
        self._pre_apply_koyo(self.enemy_lf, 0, "pre_lf")
        self._pre_apply_koyo(self.enemy_rf, 4, "pre_rf")

        hps = {u.unit_id: u.current_hp for u in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=110078,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            self.assertLess(e.current_hp, hps[e.unit_id], "敵全体攻击应命中所有目标")
        # per-target 降防
        self.assertAlmostEqual(self._get_temp_def_down(self.enemy_cf).value, 7.0, places=2)
        self.assertAlmostEqual(self._get_temp_def_down(self.enemy_rf).value, 14.0, places=2)
        # 呼応=0的目标不创建降防buff（def_down<=0时跳过）
        self.assertIsNone(self._get_temp_def_down(self.enemy_lf),
                          "呼応=0的目标不应创建临时降防buff")

    def test_ex_def_tag_lv15(self):
        """EX(110078): Lv15 时 def tag=7.5%/個。"""
        self._reset_caster(level=15)
        self._reset_enemies()
        self._pre_apply_koyo(self.enemy_cf, 1, "pre_cf")
        self.ss.execute_skill(caster=self.caster, skill_id=110078,
                              battlefield=self.bf, skip_cost=True)
        temp = self._get_temp_def_down(self.enemy_cf)
        self.assertIsNotNone(temp)
        self.assertAlmostEqual(temp.value, 7.5, places=2)

    # ════════════════════════════════════════════════════════════════
    # PS1: 130175 アブセンストリガー
    # ════════════════════════════════════════════════════════════════

    def test_ps1_trigger_skill_use_count(self):
        """PS1(130175): 配置校验 on_skill_use_count + skill_use_count_modulo=3。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        parsed = self.dl.get_parsed_skill_data(130175)
        self.assertEqual(parsed["trigger_type"], "on_skill_use_count")
        gc = parsed["global_condition"]
        self.assertEqual(gc.get("type"), "skill_use_count_modulo")
        self.assertEqual(gc.get("value"), 3)

    def test_ps1_targets_lowest_def(self):
        """PS1(130175): 最低防御敌单体（e_rf def=4000 最低）。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        hp_before = {u.unit_id: u.current_hp for u in self.bf.enemy_team}
        self.ss.execute_skill(caster=self.caster, skill_id=130175,
                              battlefield=self.bf, skip_cost=True)
        self.assertLess(self.enemy_rf.current_hp, hp_before['enemy_rf'],
                        "PS1 应选防御最低(4000)的 enemy_rf")
        self.assertEqual(self.enemy_cf.current_hp, hp_before['enemy_cf'],
                         "PS1 不应攻击 enemy_cf(def=8000)")
        self.assertEqual(self.enemy_lf.current_hp, hp_before['enemy_lf'],
                         "PS1 不应攻击 enemy_lf(def=6000)")

    def test_ps1_lv15_dmg_debuff_applied(self):
        """PS1(130175): Lv15 时对目标施加被伤+20% debuff（attack_limited=1）。"""
        self._reset_caster(level=15)
        self._reset_enemies()
        self.ss.execute_skill(caster=self.caster, skill_id=130175,
                              battlefield=self.bf, skip_cost=True)
        debuffs = [d for d in self.enemy_rf.debuffs
                   if d.effect_type == RECEIVED_DAMAGE]
        self.assertTrue(debuffs, "Lv15时应对目标施加 dmg_taken_up debuff")
        self.assertAlmostEqual(debuffs[0].value, 20.0, places=2)

    def test_ps1_lv10_no_dmg_debuff(self):
        """PS1(130175): Lv10 时不施加被伤debuff（active_level_min=11条件）。"""
        self._reset_caster(level=10)
        self._reset_enemies()
        self.ss.execute_skill(caster=self.caster, skill_id=130175,
                              battlefield=self.bf, skip_cost=True)
        debuffs = [d for d in self.enemy_rf.debuffs
                   if d.effect_type == RECEIVED_DAMAGE]
        self.assertFalse(debuffs, "Lv10时不应施加 dmg_taken_up debuff")

    def test_ps1_koyo_ge10_ap_and_atk(self):
        """PS1(130175): 自身呼応>=10时 AP+1 且 atk_up(5%) 永続stackable。"""
        self._reset_caster(level=15)
        self._reset_enemies()
        self._pre_apply_koyo(self.caster, 10, "pre_self", is_buff=True)
        self.caster.current_ap = 1  # AP未满，验证add_ap+1生效
        self.ss.execute_skill(caster=self.caster, skill_id=130175,
                              battlefield=self.bf, skip_cost=True)
        self.assertGreaterEqual(self.caster.current_ap, 2,
                                "呼応>=10時AP应+1（当前ap=1 -> >=2）")
        atk_buffs = [b for b in self.caster.buffs
                     if b.effect_type == STATUS_ATTACK]
        self.assertTrue(atk_buffs, "呼応>=10時应获得 atk_up buff")
        self.assertAlmostEqual(atk_buffs[0].value, 5.0, places=2)
        self.assertTrue(atk_buffs[0].is_stackable, "atk_up应可叠加")
        self.assertEqual(atk_buffs[0].duration, -1, "atk_up应永続")

    def test_ps1_koyo_lt10_no_ap(self):
        """PS1(130175): 自身呼応<10时 AP不加。"""
        self._reset_caster(level=15)
        self._reset_enemies()
        self._pre_apply_koyo(self.caster, 5, "pre_self", is_buff=True)
        ap_before = self.caster.current_ap
        self.ss.execute_skill(caster=self.caster, skill_id=130175,
                              battlefield=self.bf, skip_cost=True)
        self.assertEqual(self.caster.current_ap, ap_before, "呼応<10時AP不应+1")

    # ════════════════════════════════════════════════════════════════
    # PS2: 130176 ジョーカーカード
    # ════════════════════════════════════════════════════════════════

    def test_ps2_removes_two_buffs_and_atk_up(self):
        """PS2(130176): 解除2个buff + 1行動atk_up(stackable)。"""
        self._reset_caster(level=15)
        self._reset_enemies()
        # 给自身3个可解除buff
        self.caster.buffs.append(BuffState(
            buff_id="b1", name="buffA", effect_type=STATUS_ATTACK, value=10,
            duration=10, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="x", is_debuff=False))
        self.caster.buffs.append(BuffState(
            buff_id="b2", name="buffB", effect_type=STATUS_ATTACK, value=10,
            duration=10, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="x", is_debuff=False))
        self.caster.buffs.append(BuffState(
            buff_id="b3", name="buffC", effect_type=STATUS_ATTACK, value=10,
            duration=10, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="x", is_debuff=False))
        before = len(self.caster.buffs)
        result = self.ss.execute_skill(caster=self.caster, skill_id=130176,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 3个buff中移除2个（LIFO）→ 剩1个 + 新增1个atk_up = 2
        self.assertEqual(len(self.caster.buffs), before - 2 + 1, "应解除2个buff并新增1个atk_up")
        # 原有3个buff中只剩最初施加的1个（未被移除）
        self.assertIn("buffA", [b.name for b in self.caster.buffs], "应保留最先的buff")
        self.assertNotIn("buffB", [b.name for b in self.caster.buffs], "LIFO应移除后施加的buff")
        atk_buffs = [b for b in self.caster.buffs
                     if b.effect_type == STATUS_ATTACK and b.value == 25.0]
        self.assertTrue(atk_buffs, "应获得 atk_up(25%) buff")

    def test_ps2_cumulative_damage_trigger(self):
        """PS2(130176): 累计受伤>=10% max_hp 触发（on_cumulative_damage）。"""
        self._reset_caster(level=15)
        self._reset_enemies()
        self._pre_apply_koyo(self.caster, 0, "none")
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.10)
        # 施放2个可解除buff，满足 self_removable_buff_count>=2 条件
        self.caster.buffs.append(BuffState(
            buff_id="b1", name="buffA", effect_type=STATUS_ATTACK, value=10,
            duration=10, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="x", is_debuff=False))
        self.caster.buffs.append(BuffState(
            buff_id="b2", name="buffB", effect_type=STATUS_ATTACK, value=10,
            duration=10, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="x", is_debuff=False))
        # trigger_cumulative_damage 返回匹配的TriggerAction列表（实际PS执行由battle_flow_controller处理）
        triggered = self.ts.trigger_cumulative_damage(
            self.bf, damaged_units=[self.caster])
        # 匹配成功时应返回非空action列表
        self.assertTrue(triggered, "累计受伤10%+可解除buff>=2时PS2应匹配触发")
        action_ids = {a.skill_id for a in triggered}
        self.assertIn(130176, action_ids, "返回的action应包含PS2(130176)")

    def test_ps2_not_trigger_when_removable_lt2(self):
        """PS2(130176): 可解除buff<2时不触发（self_removable_buff_count>=2条件）。"""
        self._reset_caster(level=15)
        self._reset_enemies()
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.10)
        self.caster.buffs.append(BuffState(
            buff_id="b1", name="buffA", effect_type=STATUS_ATTACK, value=10,
            duration=10, timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="x", is_debuff=False))
        triggered = self.ts.trigger_cumulative_damage(
            self.bf, damaged_units=[self.caster])
        action_ids = {a.skill_id for a in (triggered or [])}
        self.assertNotIn(130176, action_ids, "可解除buff<2时PS2不应匹配触发")

    # ════════════════════════════════════════════════════════════════
    # 配置校验
    # ════════════════════════════════════════════════════════════════

    def test_config_validation(self):
        """配置校验：5个技能的 effect_blocks 结构与关键字段。"""
        for sid in (110078, 120167, 120168, 130175, 130176):
            parsed = self.dl.get_parsed_skill_data(sid)
            self.assertIsNotNone(parsed, f"技能{sid}应有hybrid配置")
            self.assertEqual(parsed.get("parse_status"), "manual",
                             f"技能{sid}应为manual配置")
        # 120167 发动限制条件
        p120167 = self.dl.get_parsed_skill_data(120167)
        self.assertEqual(p120167["global_condition"]["type"], "self_mark_count")
        # 120168 3hit
        p120168 = self.dl.get_parsed_skill_data(120168)
        self.assertEqual(p120168["effect_blocks"][0]["effects"][0]["hit_count"], 3)
        # 130175 B2 条件
        p130175 = self.dl.get_parsed_skill_data(130175)
        self.assertEqual(p130175["effect_blocks"][1]["condition"]["type"], "self_mark_count")
        # 130176 trigger
        p130176 = self.dl.get_parsed_skill_data(130176)
        self.assertEqual(p130176["trigger_type"], "on_cumulative_damage")


if __name__ == "__main__":
    unittest.main()