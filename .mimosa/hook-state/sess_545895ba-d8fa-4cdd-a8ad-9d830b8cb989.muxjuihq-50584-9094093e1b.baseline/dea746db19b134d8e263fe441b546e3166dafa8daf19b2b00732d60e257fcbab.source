#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""角色117302 キョンシーハッカー 技能效果集成测试

测试场景：
- 角色: キョンシーハッカー (character_id=117302, 风属性, EN型, 后排)
- EX: 110029 ナイトメア・キョンシー
- AS1: 120068 ゴーストハザード
- AS2: 120069 ウォーキング・スペクター
- PS1: 130078 アンデッドリベンジ (on_critical触发)
- PS2: 130079 ハロウィン・オブ・ザ・デッド (after_as_attack触发)
"""

import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService


class TestKyonshiHacker117302(unittest.TestCase):
    """角色117302 キョンシーハッカー 技能效果集成测试"""

    @classmethod
    def setUpClass(cls):
        """加载游戏数据（所有测试共享）"""
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        """每个测试前创建战场和服务"""
        self.bf = BattlefieldState()

        # キョンシーハッカー (风属性, EN型, 后排)
        self.caster = UnitState(
            unit_id="ally_kyonshi", name="キョンシーハッカー", side=Side.ALLY,
            position=Position.ALLY_LEFT_BACK, character_id=117302, level=200,
            element=3, character_type=2,  # 风属性, EN型
            max_hp=120000, current_hp=120000,
            attack=150000, defense=50000, speed=1000,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=100,
            skills=[110029, 120068, 120069, 130078, 130079],
            skill_levels={110029: 15, 120068: 15, 120069: 15, 130078: 15, 130079: 15},
            skill_cooldowns={},
        )

        # 3个敌方目标 (用于测试多目标技能)
        self.enemy1 = UnitState(
            unit_id="enemy_1", name="敵A", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999001, level=200,
            element=1, character_type=1,  # 火属性, 物理型
            max_hp=500000, current_hp=500000,
            attack=50000, defense=30000, speed=500,
            crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.enemy2 = UnitState(
            unit_id="enemy_2", name="敵B", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999002, level=200,
            element=1, character_type=1,
            max_hp=500000, current_hp=500000,
            attack=50000, defense=30000, speed=400,
            crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.enemy3 = UnitState(
            unit_id="enemy_3", name="敵C", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999003, level=200,
            element=1, character_type=1,
            max_hp=500000, current_hp=500000,
            attack=50000, defense=30000, speed=300,
            crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.add_unit(self.caster)
        self.bf.add_unit(self.enemy1)
        self.bf.add_unit(self.enemy2)
        self.bf.add_unit(self.enemy3)

        # 创建服务
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.asvc = AuraService()
        self.dmgsvc = DamageService()
        self.tgtsvc = TargetService()
        self.stsvc = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgtsvc,
            damage_service=self.dmgsvc,
            aura_service=self.asvc,
            status_service=self.stsvc,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

    def test_ps2_triggers_after_as_attack(self):
        """
        测试1: AS技能(120069)攻击后，PS2(130079)触发，自身获得永久crit_rate_up buff

        流程:
        1. 执行AS技能120069 (ウォーキング・スペクター)
        2. 手动触发after_as_attack触发器
        3. 执行PS2技能130079
        4. 验证caster获得了crit_rate_up buff
        """
        # 执行AS技能120069
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120069,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 手动触发after_as_attack (对应PS2的trigger_type)
        trigger_actions = self.ts.trigger_after_skill_use(
            self.caster, 120069, result, self.bf
        )

        # 验证PS2(130079)被触发
        ps2_triggered = any(a.skill_id == 130079 for a in trigger_actions)
        self.assertTrue(
            ps2_triggered,
            f"PS2(130079)应在AS攻击后触发, 实际触发的技能: {[a.skill_id for a in trigger_actions]}"
        )

        # 执行PS2触发动作
        for action in trigger_actions:
            if action.skill_id == 130079:
                self.ss._execute_trigger_actions_inline([action], self.bf, trigger_timing="after_as_attack")

        # 验证caster获得了crit_rate_up buff
        crit_buffs = [b for b in self.caster.buffs
                      if b.effect_type == SkillEffectType.STATUS_CRITICAL_CHANCE.value]
        self.assertTrue(
            len(crit_buffs) > 0,
            f"caster应获得crit_rate_up buff, 实际buffs: {[(b.name, b.effect_type) for b in self.caster.buffs]}"
        )

    def test_ps1_triggers_on_critical(self):
        """
        测试2: 暴击发生时，PS1(130078)触发，对2体敌人造成EN伤害

        流程:
        1. 设置caster暴击率为100%确保暴击
        2. 执行AS技能120069 (必定暴击)
        3. 暴击触发器自动在execute_skill内部处理
        4. 验证PS1对2体敌人造成了EN伤害
        """
        # 保存原始暴击率
        original_crit_rate = self.caster.crit_rate
        # 设置100%暴击率
        self.caster.crit_rate = 1.0

        # 重置冷却
        self.caster.skill_cooldowns = {}

        # 记录敌人初始HP
        initial_hp_1 = self.enemy1.current_hp
        initial_hp_2 = self.enemy2.current_hp
        initial_hp_3 = self.enemy3.current_hp

        # 执行AS技能120069
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120069,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 验证暴击发生 (通过inline_ps_results检查)
        inline_ps = result.get("inline_ps_results", [])
        ps1_triggered = any(ps["skill_id"] == 130078 for ps in inline_ps)

        self.assertTrue(
            ps1_triggered,
            f"PS1(130078)应在暴击时触发, inline_ps_results: {[(ps.get('skill_id'), ps.get('skill_name')) for ps in inline_ps]}"
        )

        # 验证PS1对2体敌人造成了伤害
        ps1_result = None
        for ps in inline_ps:
            if ps["skill_id"] == 130078:
                ps1_result = ps["result"]
                break

        if ps1_result:
            damage_effects = [e for e in ps1_result.get("effects_applied", [])
                              if e.get("effect_type") == "damage"]
            if damage_effects:
                targets_hit = damage_effects[0].get("targets", [])
                self.assertEqual(
                    len(targets_hit), 2,
                    f"PS1应命中2体敌人, 实际命中: {len(targets_hit)}"
                )

        # 恢复暴击率
        self.caster.crit_rate = original_crit_rate

    def test_ps2_crit_rate_up_permanent_and_stackable(self):
        """
        测试3: PS2的crit_rate_up是永久的(duration=-1)且可叠加(stackable)

        流程:
        1. 第一次触发PS2，获得crit_rate_up buff
        2. 验证duration=-1 (永久)
        3. 验证is_stackable=True
        4. 第二次触发PS2，验证buff叠加（stack_count增加或新增buff）
        """
        # 第一次触发PS2
        result1 = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120069,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result1["success"])

        # 手动触发after_as_attack
        trigger_actions1 = self.ts.trigger_after_skill_use(
            self.caster, 120069, result1, self.bf
        )
        for action in trigger_actions1:
            if action.skill_id == 130079:
                self.ss._execute_trigger_actions_inline([action], self.bf, trigger_timing="after_as_attack")

        # 验证第一次crit_rate_up buff
        crit_buffs_1 = [b for b in self.caster.buffs
                        if b.effect_type == SkillEffectType.STATUS_CRITICAL_CHANCE.value]
        self.assertEqual(
            len(crit_buffs_1), 1,
            f"第一次触发后应有1个crit_rate_up buff, 实际: {len(crit_buffs_1)}"
        )

        # 验证duration=-1 (永久)
        self.assertEqual(
            crit_buffs_1[0].duration, -1,
            f"crit_rate_up应为永久(duration=-1), 实际duration={crit_buffs_1[0].duration}"
        )

        # 验证is_stackable=True
        self.assertTrue(
            crit_buffs_1[0].is_stackable,
            f"crit_rate_up应为可叠加(is_stackable=True)"
        )

        # 重置冷却以允许第二次触发
        self.caster.skill_cooldowns = {}

        # 第二次触发PS2
        result2 = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120069,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result2["success"])

        # 手动触发after_as_attack
        trigger_actions2 = self.ts.trigger_after_skill_use(
            self.caster, 120069, result2, self.bf
        )
        for action in trigger_actions2:
            if action.skill_id == 130079:
                self.ss._execute_trigger_actions_inline([action], self.bf, trigger_timing="after_as_attack")

        # 验证buff叠加
        crit_buffs_2 = [b for b in self.caster.buffs
                        if b.effect_type == SkillEffectType.STATUS_CRITICAL_CHANCE.value]
        self.assertGreaterEqual(
            len(crit_buffs_2), 2,
            f"第二次触发后应至少有2个crit_rate_up buff(可叠加), 实际: {len(crit_buffs_2)}"
        )

    def test_ex_skill_5hit_en_damage_and_debuff(self):
        """
        测试4: EX技能(110029)对敌方全体造成5hit EN伤害并施加dmg_dealt_down debuff

        验证:
        1. EX技能执行成功
        2. 对敌方全体造成伤害
        3. 伤害包含5hit
        4. 敌方获得dmg_dealt_down debuff
        """
        # 执行EX技能110029
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110029,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证对敌方全体造成伤害
        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(
            len(damage_effects) > 0,
            "EX技能应造成伤害"
        )

        # 验证命中了所有3个敌人
        all_target_ids = set()
        for dmg_effect in damage_effects:
            for t in dmg_effect.get("targets", []):
                all_target_ids.add(t.get("target_id"))
        self.assertEqual(
            len(all_target_ids), 3,
            f"EX技能应命中所有3个敌人, 实际命中: {len(all_target_ids)}"
        )

        # 验证5hit (检查hit_count)
        first_damage = damage_effects[0]
        first_target = first_damage["targets"][0]
        hit_count = len(first_target.get("hits", [])) if first_target.get("hits") else 1
        # 如果没有hits详情，检查总伤害是否合理（5hit应比1hit高）
        total_damage = result.get("total_damage", 0)
        self.assertGreater(
            total_damage, 0,
            "EX技能应造成正数总伤害"
        )

        # 验证敌方获得dmg_dealt_down debuff
        for enemy in [self.enemy1, self.enemy2, self.enemy3]:
            has_debuff = any(
                d.effect_type == SkillEffectType.DEALT_DAMAGE.value
                for d in enemy.debuffs
            )
            self.assertTrue(
                has_debuff,
                f"{enemy.name}应有dmg_dealt_down debuff, "
                f"实际debuffs: {[(d.effect_type, d.value) for d in enemy.debuffs]}"
            )

    def test_as_skill_targets_3_enemies(self):
        """
        测试5: AS技能(120068)选择3个敌方目标

        验证:
        1. AS技能执行成功
        2. 伤害命中了3个敌方目标
        """
        # 执行AS技能120068 (ゴーストハザード)
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120068,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 验证伤害效果
        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(
            len(damage_effects) > 0,
            "AS技能应造成伤害"
        )

        # 验证命中了3个敌方目标
        all_target_ids = set()
        for dmg_effect in damage_effects:
            for t in dmg_effect.get("targets", []):
                all_target_ids.add(t.get("target_id"))

        self.assertEqual(
            len(all_target_ids), 3,
            f"AS技能120068应命中3个敌方目标, 实际命中: {len(all_target_ids)}, "
            f"target_ids: {all_target_ids}"
        )


if __name__ == '__main__':
    unittest.main()
