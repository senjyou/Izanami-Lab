"""Regression: 叙事日志存在重复输出。

Bug: battle_flow_controller._log_narrative_effects 中存在重复的代码块，
     导致每个 effect 的叙事日志被输出两次。
     症状示例（起死回生 130122）：
       [获得增益] «cheat_death» (来源:...)
       [获得增益] «DealtDamage» 与ダメージ:+8%→+18% (来源:...)
       [获得增益] «cheat_death» (来源:...)      <- 重复
       [获得增益] «DealtDamage» 与ダメージ:+8%→+18% (来源:...)  <- 重复
     症状示例（たまには羽を伸ばして+ 230425）：
       [HP消耗] ... -117253 HP (自傷:当前HP的30%)
       [获得增益] «ReceivedDamage» 被ダメージ:+0%→-40% (来源:...)
       [获得增益] «DealtDamage» 与ダメージ:+0%→+10% (来源:...)
       [HP消耗] ... -117253 HP (自傷:当前HP的30%)  <- 重复
       [获得增益] «ReceivedDamage» 被ダメージ:+0%→-40% (来源:...)  <- 重复
       [获得增益] «DealtDamage» 与ダメージ:+0%→+10% (来源:...)  <- 重复

Fix: 删除 _log_narrative_effects 中重复的 before_* inline PS 循环和
     重复的 effects_applied 主循环。保留正确的三段式结构：
       1. before_* inline PS（在主效果前输出）
       2. 主 effects_applied 循环
       3. 非 before_* inline PS（在主效果后输出）
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig
from src.combat_v2.battle_narrative import BattleNarrativeWriter


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.WIND.value,
               character_type=2, skills=None, skill_levels=None,
               current_hp=None, char_id=146301):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=char_id, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


class TestRegNarrativeNoDuplicate(unittest.TestCase):
    """叙事日志的每个 effect 应只输出一次，不得重复。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss

    def _count_line(self, text: str, substring: str) -> int:
        return sum(1 for line in text.splitlines() if substring in line)

    def test_kishikaisei_buff_applied_once(self):
        """起死回生(130122)的 cheat_death 和 dmg_dealt_up 各应只输出一次。"""
        caster = _make_unit(
            "caster", "世界への反逆者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
            element=Attribute.WIND.value, character_type=2,
            skills=[130122], skill_levels={130122: 15},  # Lv11+ 才触发 dmg_dealt_up block
            current_hp=10000,  # 低HP以确保 cheat_death 触发条件
        )
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = []

        ss = self._make_services(bf)
        writer = BattleNarrativeWriter(data_loader=self.dl)
        ctrl = BattleFlowController(bf, BattleConfig(max_turns=1),
                                    data_loader=self.dl, narrative=writer)
        ctrl.skill_service.set_battlefield(bf)
        ctrl._build_display_names()

        result = ss.execute_skill(caster, 130122, bf, skip_cost=True)
        self.assertTrue(result.get("success"),
                        f"技能执行失败: {result.get('error', '')}")

        ctrl._log_narrative_effects(caster, result, "起死回生", 2, 130122)
        narrative_text = "\n".join(writer._lines)

        # cheat_death 应只出现一次
        cheat_count = self._count_line(narrative_text, "cheat_death")
        self.assertEqual(cheat_count, 1,
                         f"cheat_death 应只输出一次，实际 {cheat_count} 次\n{narrative_text}")

        # DealtDamage 应只出现一次
        dealt_count = self._count_line(narrative_text, "DealtDamage")
        self.assertEqual(dealt_count, 1,
                         f"DealtDamage 应只输出一次，实际 {dealt_count} 次\n{narrative_text}")

    def test_tamaniba_consume_hp_and_buffs_once(self):
        """たまには羽を伸ばして+(230425)的 HP消耗/ReceivedDamage/DealtDamage 各应只输出一次。"""
        caster = _make_unit(
            "caster", "大賀真桜", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=390844, atk=10000, defense=4000, speed=500,
            element=Attribute.WIND.value, character_type=2,
            skills=[230425], skill_levels={230425: 10},
        )
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = []

        ss = self._make_services(bf)
        writer = BattleNarrativeWriter(data_loader=self.dl)
        ctrl = BattleFlowController(bf, BattleConfig(max_turns=1),
                                    data_loader=self.dl, narrative=writer)
        ctrl.skill_service.set_battlefield(bf)
        ctrl._build_display_names()

        result = ss.execute_skill(caster, 230425, bf, skip_cost=True)
        self.assertTrue(result.get("success"),
                        f"技能执行失败: {result.get('error', '')}")

        ctrl._log_narrative_effects(caster, result, "たまには羽を伸ばして+", 2, 230425)
        narrative_text = "\n".join(writer._lines)

        # [HP消耗] 应只出现一次
        hp_cost_count = self._count_line(narrative_text, "[HP消耗]")
        self.assertEqual(hp_cost_count, 1,
                         f"[HP消耗] 应只输出一次，实际 {hp_cost_count} 次\n{narrative_text}")

        # ReceivedDamage 应只出现一次
        rcvd_count = self._count_line(narrative_text, "ReceivedDamage")
        self.assertEqual(rcvd_count, 1,
                         f"ReceivedDamage 应只输出一次，实际 {rcvd_count} 次\n{narrative_text}")

        # DealtDamage 应只出现一次
        dealt_count = self._count_line(narrative_text, "DealtDamage")
        self.assertEqual(dealt_count, 1,
                         f"DealtDamage 应只输出一次，实际 {dealt_count} 次\n{narrative_text}")


if __name__ == '__main__':
    unittest.main()
