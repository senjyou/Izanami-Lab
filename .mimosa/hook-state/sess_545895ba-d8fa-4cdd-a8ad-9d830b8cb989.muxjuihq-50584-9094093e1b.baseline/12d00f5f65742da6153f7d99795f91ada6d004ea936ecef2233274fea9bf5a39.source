"""
角色108302 聖夜のサンタシンガー 专项测试
- EX: 110038 サンタクイーンズ・ケーキ（EP最高の敵単体攻撃 + EP削除2）
- AS1: 120085 届け、マイソング！（後列優先HP割合最高の敵単体攻撃 + サンタタグ标记 + Lv11+ 最低HP割合の敵単体攻撃）
- AS2: 120086 アンコール！（サンタタグ優先列攻撃 + Lv11+ dmg_dealt_down）
- AS3: 120087 メリ～クリスマ～ス！（最遠列攻撃）
- PS: 130097 クララ・オン・ステージ（AS3回使用後, Lv11+ EP最高の敵単体攻撃 + 永続atk_up[可叠加]）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
MARK = SkillEffectType.MARK.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value


class TestActor108302(unittest.TestCase):
    """角色108302 聖夜のサンタシンガー 专项测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 108302 聖夜のサンタシンガー (水属性=2, EN型=2, 後排)
        self.caster = UnitState(
            unit_id="ally_caster", name="聖夜のサンタシンガー", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=108302, level=15,
            element=2, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=12000, defense=5000, speed=600,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=100,
            skills=[110038, 120085, 120086, 120087, 130097],
            skill_levels={110038: 15, 120085: 15, 120086: 15, 120087: 15, 130097: 15},
            skill_cooldowns={},
        )

        # 创建服务
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.asvc = AuraService()
        self.dmgsvc = DamageService()
        self.tgtsvc = TargetService()
        self.stsvc = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgtsvc,
            damage_service=self.dmgsvc,
            aura_service=self.asvc,
            status_service=self.stsvc,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

    def _make_enemy(self, unit_id, name, position, ep=0, max_hp=50000,
                    current_hp=None, attack=8000):
        """创建敌方单位的辅助方法"""
        if current_hp is None:
            current_hp = max_hp
        return UnitState(
            unit_id=unit_id, name=name, side=Side.ENEMY,
            position=position, character_id=999001, level=15,
            element=2, character_type=1,
            max_hp=max_hp, current_hp=current_hp,
            attack=attack, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=100,
            current_ap=4, current_pp=4, current_ep=ep,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    def _add_santa_tag(self, unit):
        """手动添加サンタタグ标记到单位（debuff形式）"""
        mark = BuffState(
            buff_id=f"{unit.unit_id}_santa_tag_manual",
            name="サンタタグ",
            effect_type=MARK,
            value=1,
            duration=3,
            timing_type=AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
            source_unit_id=self.caster.unit_id,
            source_skill_id=120085,
            caster_attack=0,
            is_debuff=True,
        )
        unit.debuffs.append(mark)
        return mark

    # ==================== EX 110038 サンタクイーンズ・ケーキ ====================

    def test_ex_targets_highest_ep_and_remove_ep(self):
        """
        测试EX(110038): EP最高の敵単体に攻撃 + EP削除2
        - 设置3个敌方单位，EP值不同（5, 10, 15）
        - 验证技能命中EP最高的敌方（EP=15）
        - 验证被命中敌方的EP减少2点
        """
        enemy_a = self._make_enemy("enemy_a", "敵A(EP=5)", Position.ENEMY_LEFT_FRONT, ep=5)
        enemy_b = self._make_enemy("enemy_b", "敵B(EP=10)", Position.ENEMY_CENTER_FRONT, ep=10)
        enemy_c = self._make_enemy("enemy_c", "敵C(EP=15)", Position.ENEMY_RIGHT_FRONT, ep=15)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy_a)
        self.bf.add_unit(enemy_b)
        self.bf.add_unit(enemy_c)

        ep_before = {e.unit_id: e.current_ep for e in [enemy_a, enemy_b, enemy_c]}
        hp_before = {e.unit_id: e.current_hp for e in [enemy_a, enemy_b, enemy_c]}

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110038,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证EP最高的enemy_c受到了伤害
        self.assertLess(
            enemy_c.current_hp, hp_before[enemy_c.unit_id],
            f"EP最高的敵C应受到伤害, HP: {hp_before[enemy_c.unit_id]} -> {enemy_c.current_hp}"
        )
        # 验证其他敌人没有受到伤害
        self.assertEqual(
            enemy_a.current_hp, hp_before[enemy_a.unit_id],
            f"敵A不应受到伤害, HP: {hp_before[enemy_a.unit_id]} -> {enemy_a.current_hp}"
        )
        self.assertEqual(
            enemy_b.current_hp, hp_before[enemy_b.unit_id],
            f"敵B不应受到伤害, HP: {hp_before[enemy_b.unit_id]} -> {enemy_b.current_hp}"
        )

        # 验证enemy_c的EP减少了2点
        self.assertEqual(
            enemy_c.current_ep, ep_before[enemy_c.unit_id] - 2,
            f"敵C的EP应减少2点, EP: {ep_before[enemy_c.unit_id]} -> {enemy_c.current_ep}"
        )
        # 验证其他敌人的EP没有变化
        self.assertEqual(
            enemy_a.current_ep, ep_before[enemy_a.unit_id],
            f"敵A的EP不应变化, EP: {ep_before[enemy_a.unit_id]} -> {enemy_a.current_ep}"
        )
        self.assertEqual(
            enemy_b.current_ep, ep_before[enemy_b.unit_id],
            f"敵B的EP不应变化, EP: {ep_before[enemy_b.unit_id]} -> {enemy_b.current_ep}"
        )

    # ==================== AS1 120085 届け、マイソング！ ====================

    def test_as1_back_priority_highest_hp_ratio(self):
        """
        测试AS1(120085): 後列優先HP割合最高の敵単体に攻撃
        - 后排2个单位（HP 80%, 60%）+ 前排1个单位（HP 100%）
        - 验证技能命中后排HP百分比最高的单位（80%）
        - 使用Lv10避免Block2(Lv11+)干扰索敌测试
        """
        self.caster.skill_levels[120085] = 10
        # 前排HP 100%（最高），但后排优先
        enemy_front = self._make_enemy("enemy_front", "敵前排(HP100%)", Position.ENEMY_CENTER_FRONT,
                                        max_hp=50000, current_hp=50000)
        # 后排HP 80%
        enemy_back_high = self._make_enemy("enemy_back_high", "敵後排高HP(80%)", Position.ENEMY_CENTER_BACK,
                                            max_hp=50000, current_hp=40000)
        # 后排HP 60%
        enemy_back_low = self._make_enemy("enemy_back_low", "敵後排低HP(60%)", Position.ENEMY_LEFT_BACK,
                                           max_hp=50000, current_hp=30000)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy_front)
        self.bf.add_unit(enemy_back_high)
        self.bf.add_unit(enemy_back_low)

        hp_before = {e.unit_id: e.current_hp for e in [enemy_front, enemy_back_high, enemy_back_low]}

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120085,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # 验证后排HP百分比最高的enemy_back_high受到了伤害
        self.assertLess(
            enemy_back_high.current_hp, hp_before[enemy_back_high.unit_id],
            f"後排HP%最高的敵应受到伤害, HP: {hp_before[enemy_back_high.unit_id]} -> {enemy_back_high.current_hp}"
        )
        # 验证前排HP 100%的敌人没有受到伤害（后排优先）
        self.assertEqual(
            enemy_front.current_hp, hp_before[enemy_front.unit_id],
            f"前排敵不应受到伤害（後列優先）, HP: {hp_before[enemy_front.unit_id]} -> {enemy_front.current_hp}"
        )
        # 验证后排HP 60%的敌人没有受到伤害
        self.assertEqual(
            enemy_back_low.current_hp, hp_before[enemy_back_low.unit_id],
            f"後排低HP敵不应受到伤害, HP: {hp_before[enemy_back_low.unit_id]} -> {enemy_back_low.current_hp}"
        )

    def test_as1_fallback_front_when_no_back(self):
        """
        测试AS1(120085): 後列がいない場合、前列のHP割合最高の敵に攻撃
        - 只有前排单位，HP百分比不同
        - 验证技能命中前排HP百分比最高的单位
        - 使用Lv10避免Block2(Lv11+)干扰索敌测试
        """
        self.caster.skill_levels[120085] = 10
        enemy_front_low = self._make_enemy("enemy_front_low", "敵前排低HP(50%)", Position.ENEMY_LEFT_FRONT,
                                            max_hp=50000, current_hp=25000)
        enemy_front_high = self._make_enemy("enemy_front_high", "敵前排高HP(90%)", Position.ENEMY_CENTER_FRONT,
                                             max_hp=50000, current_hp=45000)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy_front_low)
        self.bf.add_unit(enemy_front_high)

        hp_before = {e.unit_id: e.current_hp for e in [enemy_front_low, enemy_front_high]}

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120085,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # 验证前排HP百分比最高的enemy_front_high受到了伤害
        self.assertLess(
            enemy_front_high.current_hp, hp_before[enemy_front_high.unit_id],
            f"前排HP%最高的敵应受到伤害, HP: {hp_before[enemy_front_high.unit_id]} -> {enemy_front_high.current_hp}"
        )
        # 验证HP百分比低的敌人没有受到伤害
        self.assertEqual(
            enemy_front_low.current_hp, hp_before[enemy_front_low.unit_id],
            f"低HP%敵不应受到伤害, HP: {hp_before[enemy_front_low.unit_id]} -> {enemy_front_low.current_hp}"
        )

    def test_as1_applies_santa_tag_mark(self):
        """
        测试AS1(120085): サンタタグ标记付与
        - AS1后验证目标身上有"サンタタグ"mark
        - 标记存储在debuffs中（is_buff_mark=false）
        - duration=3, timing=DURABLE_SOURCE_MANEUVER_END（duration_owner=caster）
        """
        enemy = self._make_enemy("enemy", "敵A", Position.ENEMY_CENTER_BACK,
                                  max_hp=50000, current_hp=40000)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy)

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120085,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # 验证目标获得了サンタタグ mark（在debuffs中）
        santa_tags = [
            d for d in enemy.debuffs
            if d.name == "サンタタグ" and d.effect_type == MARK
        ]
        self.assertTrue(
            len(santa_tags) > 0,
            f"目标应获得サンタタグmark(debuff), "
            f"实际debuffs: {[(d.name, d.effect_type) for d in enemy.debuffs]}"
        )

        # 验证duration=3（配置为3，just_applied保护当次行动不递减，3次递减后消失=3次行动后消失）
        self.assertEqual(
            santa_tags[0].duration, 3,
            f"サンタタグduration应为3, 实际: {santa_tags[0].duration}"
        )

        # 验证timing=DURABLE_SOURCE_MANEUVER_END（duration_owner=caster）
        self.assertEqual(
            santa_tags[0].timing_type, AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
            f"サンタタグtiming应为DURABLE_SOURCE_MANEUVER_END(duration_owner=caster), "
            f"实际: {santa_tags[0].timing_type}"
        )

    def test_as1_lv11_block2_lowest_hp_ratio(self):
        """
        测试AS1(120085) Lv15: Block2 最低HP割合の敵単体に攻撃
        - Lv11+ Block2: enemy_single_lowest_hp_ratio
        - 设置多个敌方单位HP百分比不同
        - 验证第二段攻击命中HP百分比最低的单位
        """
        # 所有敌方都在后排（确保Block1的后排优先逻辑能选到目标）
        # HP 80%（后排HP%最高 → Block1目标）
        enemy_high = self._make_enemy("enemy_high", "敵高HP(80%)", Position.ENEMY_CENTER_BACK,
                                       max_hp=50000, current_hp=40000)
        # HP 30%（HP%最低 → Block2目标）
        enemy_low = self._make_enemy("enemy_low", "敵低HP(30%)", Position.ENEMY_LEFT_BACK,
                                      max_hp=50000, current_hp=15000)
        # HP 60%
        enemy_mid = self._make_enemy("enemy_mid", "敵中HP(60%)", Position.ENEMY_RIGHT_BACK,
                                      max_hp=50000, current_hp=30000)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy_high)
        self.bf.add_unit(enemy_low)
        self.bf.add_unit(enemy_mid)

        hp_before = {e.unit_id: e.current_hp for e in [enemy_high, enemy_low, enemy_mid]}

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120085,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS1技能执行应成功: {result.get('error', '')}")

        # Block1: 后排HP%最高 = enemy_high (80%)
        self.assertLess(
            enemy_high.current_hp, hp_before[enemy_high.unit_id],
            f"Block1应命中後排HP%最高的敵(80%), HP: {hp_before[enemy_high.unit_id]} -> {enemy_high.current_hp}"
        )

        # Block2: HP%最低 = enemy_low (30%)
        # enemy_low应受到额外伤害（Block2的伤害）
        self.assertLess(
            enemy_low.current_hp, hp_before[enemy_low.unit_id],
            f"Block2应命中HP%最低的敵(30%), HP: {hp_before[enemy_low.unit_id]} -> {enemy_low.current_hp}"
        )

    # ==================== AS2 120086 アンコール！ ====================

    def test_as2_mark_priority_column(self):
        """
        测试AS2(120086): サンタタグ優先列攻撃
        - 标记在左列，验证AS2攻击左列（前后列）
        """
        # 左列前后
        enemy_left_front = self._make_enemy("enemy_left_front", "敵左前", Position.ENEMY_LEFT_FRONT,
                                             max_hp=50000, current_hp=50000)
        enemy_left_back = self._make_enemy("enemy_left_back", "敵左后", Position.ENEMY_LEFT_BACK,
                                            max_hp=50000, current_hp=50000)
        # 右列前后
        enemy_right_front = self._make_enemy("enemy_right_front", "敵右前", Position.ENEMY_RIGHT_FRONT,
                                              max_hp=50000, current_hp=50000)
        enemy_right_back = self._make_enemy("enemy_right_back", "敵右后", Position.ENEMY_RIGHT_BACK,
                                             max_hp=50000, current_hp=50000)

        # 在左列敌人身上添加サンタタグ
        self._add_santa_tag(enemy_left_front)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy_left_front)
        self.bf.add_unit(enemy_left_back)
        self.bf.add_unit(enemy_right_front)
        self.bf.add_unit(enemy_right_back)

        hp_before = {
            e.unit_id: e.current_hp
            for e in [enemy_left_front, enemy_left_back, enemy_right_front, enemy_right_back]
        }

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120086,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS2技能执行应成功: {result.get('error', '')}")

        # 验证左列（标记所在列）的敌人都受到了伤害
        self.assertLess(
            enemy_left_front.current_hp, hp_before[enemy_left_front.unit_id],
            f"左前（标记列）应受到伤害, HP: {hp_before[enemy_left_front.unit_id]} -> {enemy_left_front.current_hp}"
        )
        self.assertLess(
            enemy_left_back.current_hp, hp_before[enemy_left_back.unit_id],
            f"左后（标记列）应受到伤害, HP: {hp_before[enemy_left_back.unit_id]} -> {enemy_left_back.current_hp}"
        )
        # 验证右列敌人没有受到伤害
        self.assertEqual(
            enemy_right_front.current_hp, hp_before[enemy_right_front.unit_id],
            f"右前不应受到伤害, HP: {hp_before[enemy_right_front.unit_id]} -> {enemy_right_front.current_hp}"
        )
        self.assertEqual(
            enemy_right_back.current_hp, hp_before[enemy_right_back.unit_id],
            f"右后不应受到伤害, HP: {hp_before[enemy_right_back.unit_id]} -> {enemy_right_back.current_hp}"
        )

    def test_as2_no_mark_normal_attack(self):
        """
        测试AS2(120086): 无サンタタグ标记时正常攻击
        - 无标记时，AS2应正常选择列攻击
        """
        enemy_left_front = self._make_enemy("enemy_left_front", "敵左前", Position.ENEMY_LEFT_FRONT,
                                             max_hp=50000, current_hp=50000)
        enemy_right_front = self._make_enemy("enemy_right_front", "敵右前", Position.ENEMY_RIGHT_FRONT,
                                              max_hp=50000, current_hp=50000)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy_left_front)
        self.bf.add_unit(enemy_right_front)

        hp_before = {e.unit_id: e.current_hp for e in [enemy_left_front, enemy_right_front]}

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120086,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS2技能执行应成功: {result.get('error', '')}")

        # 无标记时，至少应有一个敌人受到伤害
        damaged = [
            e for e in [enemy_left_front, enemy_right_front]
            if e.current_hp < hp_before[e.unit_id]
        ]
        self.assertTrue(
            len(damaged) > 0,
            f"无标记时AS2应至少伤害1个敌人, "
            f"HP变化: {[(e.name, hp_before[e.unit_id], e.current_hp) for e in [enemy_left_front, enemy_right_front]]}"
        )

    # ==================== AS3 120087 メリ～クリスマ～ス！ ====================

    def test_as3_furthest_column(self):
        """
        测试AS3(120087): 最遠列攻撃
        - 设置施法者在后排左列
        - 验证AS3攻击最远列（右列前后列）
        """
        # 将施法者移到后排左列
        self.caster.position = Position.ALLY_LEFT_BACK

        # 右列前后（最远列）
        enemy_right_front = self._make_enemy("enemy_right_front", "敵右前", Position.ENEMY_RIGHT_FRONT,
                                              max_hp=50000, current_hp=50000)
        enemy_right_back = self._make_enemy("enemy_right_back", "敵右后", Position.ENEMY_RIGHT_BACK,
                                             max_hp=50000, current_hp=50000)
        # 左列前后（最近列）
        enemy_left_front = self._make_enemy("enemy_left_front", "敵左前", Position.ENEMY_LEFT_FRONT,
                                             max_hp=50000, current_hp=50000)
        enemy_left_back = self._make_enemy("enemy_left_back", "敵左后", Position.ENEMY_LEFT_BACK,
                                            max_hp=50000, current_hp=50000)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy_right_front)
        self.bf.add_unit(enemy_right_back)
        self.bf.add_unit(enemy_left_front)
        self.bf.add_unit(enemy_left_back)

        hp_before = {
            e.unit_id: e.current_hp
            for e in [enemy_right_front, enemy_right_back, enemy_left_front, enemy_left_back]
        }

        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120087,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS3技能执行应成功: {result.get('error', '')}")

        # 验证右列（最远列）的敌人都受到了伤害
        self.assertLess(
            enemy_right_front.current_hp, hp_before[enemy_right_front.unit_id],
            f"右前（最远列）应受到伤害, HP: {hp_before[enemy_right_front.unit_id]} -> {enemy_right_front.current_hp}"
        )
        self.assertLess(
            enemy_right_back.current_hp, hp_before[enemy_right_back.unit_id],
            f"右后（最远列）应受到伤害, HP: {hp_before[enemy_right_back.unit_id]} -> {enemy_right_back.current_hp}"
        )
        # 验证左列敌人没有受到伤害
        self.assertEqual(
            enemy_left_front.current_hp, hp_before[enemy_left_front.unit_id],
            f"左前不应受到伤害, HP: {hp_before[enemy_left_front.unit_id]} -> {enemy_left_front.current_hp}"
        )
        self.assertEqual(
            enemy_left_back.current_hp, hp_before[enemy_left_back.unit_id],
            f"左后不应受到伤害, HP: {hp_before[enemy_left_back.unit_id]} -> {enemy_left_back.current_hp}"
        )

    # ==================== PS 130097 クララ・オン・ステージ ====================

    def test_ps_triggers_after_3_as_uses(self):
        """
        测试PS(130097): AS3回使用後触发
        - on_skill_use_count(3): 3次AS使用后触发PS
        - 验证PS触发后施法者获得atk_up buff（永続, 可叠加）
        """
        enemy = self._make_enemy("enemy", "敵A", Position.ENEMY_CENTER_FRONT,
                                  max_hp=100000, current_hp=100000)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy)

        # 确保 caster 有足够 PP
        self.caster.current_pp = 10

        # 模拟3次AS使用
        self.caster.skill_use_count[120085] = 3

        # 触发 on_skill_use_count
        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)

        # 验证PS(130097)触发了
        ps_triggered = any(a.skill_id == 130097 for a in trigger_actions)
        self.assertTrue(
            ps_triggered,
            f"PS(130097)在3次AS使用后应触发, trigger_actions: {[a.skill_id for a in trigger_actions]}"
        )

        # 执行触发动作
        if ps_triggered:
            self.ss._execute_trigger_actions_inline(
                [a for a in trigger_actions if a.skill_id == 130097],
                self.bf, trigger_timing="on_skill_use_count"
            )

        # 验证caster获得了atk_up buff（永続, 可叠加）
        atk_up_buffs = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertTrue(
            len(atk_up_buffs) > 0,
            f"caster应获得atk_up buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.caster.buffs]}"
        )
        # 验证atk_up duration=-1（永続）
        self.assertEqual(
            atk_up_buffs[0].duration, -1,
            f"atk_up应为永続(duration=-1), 实际: {atk_up_buffs[0].duration}"
        )

    def test_ps_atk_up_stacks(self):
        """
        测试PS(130097): atk_up叠加效果
        - 多次触发PS后，atk_up应可叠加（stackable=true）
        """
        enemy = self._make_enemy("enemy", "敵A", Position.ENEMY_CENTER_FRONT,
                                  max_hp=100000, current_hp=100000)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy)

        # 确保 caster 有足够 PP
        self.caster.current_pp = 10

        # 第一次触发：3次AS使用
        self.caster.skill_use_count[120085] = 3
        trigger_actions_1 = self.ts.trigger_skill_use_count(self.caster, self.bf)
        ps_triggered_1 = any(a.skill_id == 130097 for a in trigger_actions_1)
        self.assertTrue(ps_triggered_1, "第一次PS应触发")
        self.ss._execute_trigger_actions_inline(
            [a for a in trigger_actions_1 if a.skill_id == 130097],
            self.bf, trigger_timing="on_skill_use_count"
        )

        atk_up_count_1 = len([b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK])
        self.assertGreaterEqual(atk_up_count_1, 1,
                                f"第一次触发后应有至少1个atk_up, 实际: {atk_up_count_1}")

        # 第二次触发：6次AS使用
        self.caster.skill_use_count[120085] = 6
        # 重置PS冷却（如有）
        self.caster.skill_cooldowns.pop(130097, None)
        trigger_actions_2 = self.ts.trigger_skill_use_count(self.caster, self.bf)
        ps_triggered_2 = any(a.skill_id == 130097 for a in trigger_actions_2)
        self.assertTrue(ps_triggered_2, "第二次PS应触发")
        self.ss._execute_trigger_actions_inline(
            [a for a in trigger_actions_2 if a.skill_id == 130097],
            self.bf, trigger_timing="on_skill_use_count"
        )

        atk_up_count_2 = len([b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK])
        self.assertGreater(
            atk_up_count_2, atk_up_count_1,
            f"第二次触发后atk_up应叠加({atk_up_count_1} -> {atk_up_count_2})"
        )

    # ==================== 补充测试 ====================

    def test_as2_lv11_dmg_dealt_down(self):
        """测试AS2(120086) Lv11+: 列攻撃 + dmg_dealt_down(1action, stackable)"""
        # 在左列敌人身上添加サンタタグ以触发mark_priority列攻击
        enemy_left_front = self._make_enemy("enemy_left_front", "敵左前", Position.ENEMY_LEFT_FRONT,
                                             max_hp=50000, current_hp=50000)
        enemy_left_back = self._make_enemy("enemy_left_back", "敵左后", Position.ENEMY_LEFT_BACK,
                                            max_hp=50000, current_hp=50000)
        self._add_santa_tag(enemy_left_front)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy_left_front)
        self.bf.add_unit(enemy_left_back)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120086, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Lv15应施加dmg_dealt_down（DEALT_DAMAGE effect_type, is_debuff=True）
        dealt_down_debuffs = [
            d for d in enemy_left_front.debuffs + enemy_left_back.debuffs
            if d.effect_type == DEALT_DAMAGE
        ]
        self.assertGreater(
            len(dealt_down_debuffs), 0,
            f"AS2 Lv11+应施加dmg_dealt_down, "
            f"实际debuffs: {[(d.name, d.effect_type) for d in enemy_left_front.debuffs]}"
        )
        # 验证duration=1
        self.assertEqual(dealt_down_debuffs[0].duration, 1,
                         f"dmg_dealt_down duration应为1, 实际: {dealt_down_debuffs[0].duration}")

    def test_as2_lv11_dmg_dealt_down_stackable(self):
        """测试AS2(120086) Lv11+: dmg_dealt_down 可叠加（stackable=true）"""
        enemy_left_front = self._make_enemy("enemy_left_front", "敵左前", Position.ENEMY_LEFT_FRONT,
                                             max_hp=50000, current_hp=50000)
        self._add_santa_tag(enemy_left_front)

        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy_left_front)

        # 第一次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=120086, battlefield=self.bf, skip_cost=True
        )
        debuffs_1 = [d for d in enemy_left_front.debuffs if d.effect_type == DEALT_DAMAGE]

        # 第二次施放（重置冷却）
        self.caster.skill_cooldowns.pop(120086, None)
        self.ss.execute_skill(
            caster=self.caster, skill_id=120086, battlefield=self.bf, skip_cost=True
        )
        debuffs_2 = [d for d in enemy_left_front.debuffs if d.effect_type == DEALT_DAMAGE]

        self.assertGreater(
            len(debuffs_2), len(debuffs_1),
            f"dmg_dealt_down应可叠加, 第一次={len(debuffs_1)}, 第二次={len(debuffs_2)}"
        )

    def test_ps_not_triggered_below_3_uses(self):
        """测试PS(130097): AS使用次数<3时不触发"""
        enemy = self._make_enemy("enemy", "敵A", Position.ENEMY_CENTER_FRONT,
                                  max_hp=100000, current_hp=100000)
        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy)
        self.caster.current_pp = 10

        # 2次AS使用（<3）
        self.caster.skill_use_count[120085] = 2
        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)
        ps_triggered = any(a.skill_id == 130097 for a in trigger_actions)
        self.assertFalse(ps_triggered, "AS使用次数<3时PS不应触发")

    def test_ps_lv11_extra_damage_to_highest_ep(self):
        """测试PS(130097) Lv11+: EP最高の敵単体EN攻撃追加伤害"""
        enemy_a = self._make_enemy("enemy_a", "敵A(EP=2)", Position.ENEMY_LEFT_FRONT, ep=2,
                                    max_hp=100000, current_hp=100000)
        enemy_b = self._make_enemy("enemy_b", "敵B(EP=15)", Position.ENEMY_CENTER_FRONT, ep=15,
                                    max_hp=100000, current_hp=100000)
        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy_a)
        self.bf.add_unit(enemy_b)
        self.caster.current_pp = 10

        # 模拟3次AS使用触发PS
        self.caster.skill_use_count[120085] = 3
        trigger_actions = self.ts.trigger_skill_use_count(self.caster, self.bf)
        ps_triggered = any(a.skill_id == 130097 for a in trigger_actions)
        self.assertTrue(ps_triggered, "PS Lv11+应在3次AS使用后触发")

        # 执行PS
        self.ss._execute_trigger_actions_inline(
            [a for a in trigger_actions if a.skill_id == 130097],
            self.bf, trigger_timing="on_skill_use_count"
        )

        # Lv11+应额外对EP最高的enemy_b造成EN伤害
        self.assertLess(
            enemy_b.current_hp, enemy_b.max_hp,
            f"PS Lv11+应命中EP最高的enemy_b, HP: {enemy_b.max_hp} -> {enemy_b.current_hp}"
        )
        # EP较低的enemy_a不应受到PS的额外伤害
        self.assertEqual(
            enemy_a.current_hp, enemy_a.max_hp,
            f"EP较低的enemy_a不应受到PS额外伤害, HP: {enemy_a.current_hp}"
        )

    def test_ps_ex_skill_does_not_advance_count(self):
        """测试PS(130097): EX技能不计入AS使用次数（仅AS skill_type=1计数）"""
        enemy = self._make_enemy("enemy", "敵A", Position.ENEMY_CENTER_FRONT,
                                  max_hp=100000, current_hp=100000)
        self.bf.add_unit(self.caster)
        self.bf.add_unit(enemy)
        self.caster.current_pp = 10

        # 重置计数
        self.caster.skill_use_count = {}

        # 执行EX技能（skill_type=3）
        self.ss.execute_skill(
            caster=self.caster, skill_id=110038, battlefield=self.bf, skip_cost=True
        )

        # 验证EX不计入AS(120085)使用次数
        as_count = self.caster.skill_use_count.get(120085, 0)
        self.assertEqual(
            as_count, 0,
            f"EX技能不应计入AS(120085)使用次数, 实际: {as_count}"
        )


if __name__ == "__main__":
    unittest.main(verbosity=2)
