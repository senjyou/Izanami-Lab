"""Regression: クイックブースト(130043/230077/230316) must NOT apply spd_up to self.

Bug: クイックブースト used target_type="ally_all" which includes the caster.
The skill description states "自身を除く味方全体" (all allies except self).

Root cause:
- skill_effects_hybrid.json configured target_type="ally_all" instead of "friends"
- display_target_type was set to 2 (SELF_AND_FRIENDS) instead of 4 (FRIENDS)

Fix:
1. Changed target_type from "ally_all" to "friends" for skills 130043, 230077, 230316
2. Changed display_target_type from 2 to 4 for these skills
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.WATER.value,
               character_type=2, skills=None, skill_levels=None, pp=4):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=pp, current_ep=0,
        is_alive=hp > 0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class TestRegQuickBoostExcludeSelf(unittest.TestCase):
    """クイックブースト must NOT apply spd_up to self."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    def test_130043_target_type_is_friends(self):
        """130043 must have target_type="friends" (not ally_all)."""
        parsed = self.dl.get_parsed_skill_data(130043)
        self.assertIsNotNone(parsed, "130043 parsed data missing")
        blocks = parsed.get('effect_blocks', [])
        self.assertGreater(len(blocks), 0, "130043 should have effect_blocks")
        block1 = blocks[0]
        effects = block1.get('effects', [])
        self.assertGreater(len(effects), 0, "Block1 should have effects")
        effect = effects[0]
        self.assertEqual(effect.get('target_type'), 'friends',
                         "130043 spd_up effect should use target_type='friends'")

    def test_230077_target_type_is_friends(self):
        """230077 must have target_type="friends" (not ally_all)."""
        parsed = self.dl.get_parsed_skill_data(230077)
        self.assertIsNotNone(parsed, "230077 parsed data missing")
        blocks = parsed.get('effect_blocks', [])
        self.assertGreater(len(blocks), 0, "230077 should have effect_blocks")
        block1 = blocks[0]
        effects = block1.get('effects', [])
        self.assertGreater(len(effects), 0, "Block1 should have effects")
        effect = effects[0]
        self.assertEqual(effect.get('target_type'), 'friends',
                         "230077 spd_up effect should use target_type='friends'")

    def test_230316_target_type_is_friends(self):
        """230316 (クイックブースト+) must have target_type="friends"."""
        parsed = self.dl.get_parsed_skill_data(230316)
        self.assertIsNotNone(parsed, "230316 parsed data missing")
        blocks = parsed.get('effect_blocks', [])
        self.assertGreater(len(blocks), 0, "230316 should have effect_blocks")
        block1 = blocks[0]
        effects = block1.get('effects', [])
        self.assertGreater(len(effects), 0, "Block1 should have effects")
        effect = effects[0]
        self.assertEqual(effect.get('target_type'), 'friends',
                         "230316 spd_up effect should use target_type='friends'")

    def test_quick_boost_130043_excludes_self(self):
        """クイックブースト(130043) should NOT apply spd_up to caster, only to other allies."""
        caster = _make_unit(
            "caster", "クイックブースト使用者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[130043], skill_levels={130043: 1}, pp=1,
        )
        ally1 = _make_unit(
            "ally1", "友方A", Side.ALLY, Position.ALLY_LEFT_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
        )
        ally2 = _make_unit(
            "ally2", "友方B", Side.ALLY, Position.ALLY_RIGHT_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
        )
        bf = _make_bf(caster, ally1, ally2)
        ss, _ = self._make_services(bf)

        result = ss.execute_skill(caster, 130043, bf)
        self.assertTrue(result['success'], "Skill should execute successfully")

        caster_has_spd_up = any(b.effect_type == 'StatusSpeed' for b in caster.buffs)
        ally1_has_spd_up = any(b.effect_type == 'StatusSpeed' for b in ally1.buffs)
        ally2_has_spd_up = any(b.effect_type == 'StatusSpeed' for b in ally2.buffs)

        self.assertFalse(
            caster_has_spd_up,
            "クイックブースト should NOT apply spd_up to self"
        )
        self.assertTrue(
            ally1_has_spd_up,
            "クイックブースト should apply spd_up to ally1"
        )
        self.assertTrue(
            ally2_has_spd_up,
            "クイックブースト should apply spd_up to ally2"
        )

    def test_quick_boost_230077_excludes_self(self):
        """クイックブースト(230077) should NOT apply spd_up to caster."""
        caster = _make_unit(
            "caster", "クイックブースト使用者2", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[230077], skill_levels={230077: 1}, pp=1,
        )
        ally1 = _make_unit(
            "ally1", "友方C", Side.ALLY, Position.ALLY_LEFT_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
        )
        bf = _make_bf(caster, ally1)
        ss, _ = self._make_services(bf)

        result = ss.execute_skill(caster, 230077, bf)
        self.assertTrue(result['success'], "Skill should execute successfully")

        caster_has_spd_up = any(b.effect_type == 'StatusSpeed' for b in caster.buffs)
        ally1_has_spd_up = any(b.effect_type == 'StatusSpeed' for b in ally1.buffs)

        self.assertFalse(
            caster_has_spd_up,
            "クイックブースト(230077) should NOT apply spd_up to self"
        )
        self.assertTrue(
            ally1_has_spd_up,
            "クイックブースト(230077) should apply spd_up to ally"
        )

    def test_quick_boost_plus_230316_excludes_self(self):
        """クイックブースト+(230316) should NOT apply spd_up to caster."""
        caster = _make_unit(
            "caster", "クイックブースト+使用者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[230316], skill_levels={230316: 1}, pp=1,
        )
        ally1 = _make_unit(
            "ally1", "友方D", Side.ALLY, Position.ALLY_LEFT_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
        )
        bf = _make_bf(caster, ally1)
        ss, _ = self._make_services(bf)

        result = ss.execute_skill(caster, 230316, bf)
        self.assertTrue(result['success'], "Skill should execute successfully")

        caster_has_spd_up = any(b.effect_type == 'StatusSpeed' for b in caster.buffs)
        ally1_has_spd_up = any(b.effect_type == 'StatusSpeed' for b in ally1.buffs)

        self.assertFalse(
            caster_has_spd_up,
            "クイックブースト+(230316) should NOT apply spd_up to self"
        )
        self.assertTrue(
            ally1_has_spd_up,
            "クイックブースト+(230316) should apply spd_up to ally"
        )


if __name__ == '__main__':
    unittest.main(verbosity=2)