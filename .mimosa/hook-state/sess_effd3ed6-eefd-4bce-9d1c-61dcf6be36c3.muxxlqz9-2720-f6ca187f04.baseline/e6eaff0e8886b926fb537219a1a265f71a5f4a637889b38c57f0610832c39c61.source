"""Regression: 自己に揺れる白湯気 (113302) 技能效果実装の回帰テスト。

本テストは以下の5技能の実装を検証する:
  - 110035 (EX) あわあわふー: 最も「ほてり」多く持つ敵に攻撃 + 4+気絶 + 7+增伤+全解除
  - 120079 (AS1) かぶり湯: 最遠敵に3hit攻撃 + 「ほてり」x2付与
  - 120080 (AS2) 背中流そうか？: 敵単体3hit攻撃 + 「ほてり」x1 + on_crit「ほてり」x1追加 + Lv11+ほてり数増伤(max5)
  - 130091 (PS1) すべすべお肌: 被AS攻撃後、攻撃者ATK下降(target_identifier=trigger_attacker)
  - 130092 (PS2) のぼせた？: ターン終了時、最HP少敵に「ほてり」+dmg_taken_up(1次被攻撃消耗)

新規実装要素:
  - enemy_single_highest_mark_count 索敵类型 (4 code paths in skill_service.py)
  - conditional_power_bonus の multiplier_per_count 拡張
    (bonus_pct = value_tag值 × min(mark_count, max_multiplier_count))
  - on_crit block (once_per_skill=true, crit_target) による追加mark付与
  - duration_type="hit" + attack_limited=1 による「次の攻撃で受ける」消耗语义
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


MARK = SkillEffectType.MARK.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
KNOCKOUT = SkillEffectType.KNOCKOUT.value
HOTERI = "ほてり"


def _make_hoteri_mark(source_id="pre"):
    """生成1个「ほてり」mark BuffState (debuff, stackable, 永续)。"""
    return BuffState(
        buff_id=f"{source_id}_hoteri_{id(source_id)}",
        name=HOTERI,
        effect_type=MARK,
        value=0,
        duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=source_id,
        source_skill_id=0,
        is_debuff=True,
        is_stackable=True,
    )


def _make_hoteri_marks(source_id="pre", count=1):
    """生成 count 个「ほてり」mark BuffState。"""
    return [
        BuffState(
            buff_id=f"{source_id}_hoteri_{i}_{id(source_id)}",
            name=HOTERI,
            effect_type=MARK,
            value=0,
            duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=source_id,
            source_skill_id=0,
            is_debuff=True,
            is_stackable=True,
        )
        for i in range(count)
    ]


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.FIRE.value,
               character_type=3, skills=None, skill_levels=None, pp=10, ap=10,
               crit_rate=0.0, crit_damage=0.5):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=113302, level=15, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


class TestReg113302Hoteri(unittest.TestCase):
    """自己に揺れる白湯気 (113302) 全技能回帰テスト。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    def _count_hoteri(self, unit):
        """返回单位持有的「ほてり」mark 数量。"""
        return sum(1 for d in unit.debuffs
                   if d.effect_type == MARK and getattr(d, 'name', '') == HOTERI) \
               + sum(1 for b in unit.buffs
                     if b.effect_type == MARK and getattr(b, 'name', '') == HOTERI)

    # ── EX 110035: あわあわふー ─────────────────────────────────────

    def test_ex_targets_highest_hoteri_count(self):
        """EX索敵: 优先选「ほてり」最多的敌人。"""
        caster = _make_unit("caster", " caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[110035], skill_levels={110035: 10})
        # e1: 3个ほてり, e2: 5个ほてり, e3: 1个ほてり
        e1 = _make_unit("e1", "e1", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999)
        e2 = _make_unit("e2", "e2", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        e3 = _make_unit("e3", "e3", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=999999)
        for m in _make_hoteri_marks("pre_e1", 3):
            e1.debuffs.append(m)
        for m in _make_hoteri_marks("pre_e2", 5):
            e2.debuffs.append(m)
        for m in _make_hoteri_marks("pre_e3", 1):
            e3.debuffs.append(m)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [e1, e2, e3]
        ss, _ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in [e1, e2, e3]}
        result = ss.execute_skill(caster=caster, skill_id=110035, battlefield=bf, skip_cost=True)
        self.assertTrue(result.get('success'), "EX execution should succeed")

        # e2(ほてり5個) 受击，e1/e3 不受击
        self.assertLess(e2.current_hp, hp_before['e2'],
                        "EX should target e2 (most ほてり=5)")
        self.assertEqual(e1.current_hp, hp_before['e1'],
                         "EX should NOT target e1 (ほてり=3)")
        self.assertEqual(e3.current_hp, hp_before['e3'],
                         "EX should NOT target e3 (ほてり=1)")

    def test_ex_targets_highest_mark_count_when_marked_is_not_nearest(self):
        """EX索敵: 当mark最多的敌人不是最近敌人时，仍应正确选mark最多的敌人。

        反面案例: 初版实现damage路径OR链(L1927)遗漏 enemy_single_highest_mark_count，
        导致select_targets只返回1个最近敌，post-filter在单元素列表上无效，
        误选mark=0的最近敌而非mark=5的远敌。
        注: test_ex_targets_highest_hoteri_count 因e2恰为最近敌而误打误撞通过。
        """
        caster = _make_unit("caster", " caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[110035], skill_levels={110035: 10})
        # nearest: CENTER_FRONT (0 marks), farther: LEFT/RIGHT FRONT (5 / 3 marks)
        nearest = _make_unit("nearest", "nearest", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        marked_far = _make_unit("marked_far", "marked_far", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999)
        other_far = _make_unit("other_far", "other_far", Side.ENEMY, Position.ENEMY_RIGHT_FRONT, hp=999999)
        # 把5个mark加到远敌(marked_far)上，最近敌(nearest)无mark
        for m in _make_hoteri_marks("pre_marked_far", 5):
            marked_far.debuffs.append(m)
        for m in _make_hoteri_marks("pre_other_far", 3):
            other_far.debuffs.append(m)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [nearest, marked_far, other_far]
        ss, _ = self._make_services(bf)

        hp_before = {u.unit_id: u.current_hp for u in [nearest, marked_far, other_far]}
        result = ss.execute_skill(caster=caster, skill_id=110035, battlefield=bf, skip_cost=True)
        self.assertTrue(result.get('success'))

        # marked_far(ほてり5個、非最近) 受击；最近敌 nearest(ほてり0) 不受击
        self.assertLess(marked_far.current_hp, hp_before['marked_far'],
                        "EX 应选mark最多的 marked_far(5)，即使它不是最近敌")
        self.assertEqual(nearest.current_hp, hp_before['nearest'],
                         "EX 不应误选最近敌 nearest(ほてり=0)")
        self.assertEqual(other_far.current_hp, hp_before['other_far'],
                         "EX 不应选 other_far(ほてり=3)")

    def test_ex_4_hoteri_applies_stun(self):
        """EX: 4个「ほてり」时附加1行动气绝。"""
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[110035], skill_levels={110035: 10})
        enemy = _make_unit("enemy", "enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        for m in _make_hoteri_marks("pre", 4):
            enemy.debuffs.append(m)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster=caster, skill_id=110035, battlefield=bf, skip_cost=True)

        stun_debuffs = [d for d in enemy.debuffs if d.effect_type == KNOCKOUT]
        self.assertGreater(len(stun_debuffs), 0,
                           "EX should apply stun when ほてり count >= 4")

    def test_ex_7_hoteri_applies_bonus_and_removes_marks(self):
        """EX: 7个「ほてり」时增伤(delt_damage乘区) + 清除全部「ほてり」mark。"""
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[110035], skill_levels={110035: 15})
        enemy = _make_unit("enemy", "enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        for m in _make_hoteri_marks("pre", 7):
            enemy.debuffs.append(m)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster=caster, skill_id=110035, battlefield=bf, skip_cost=True)

        # 攻撃後、全ての「ほてり」mark が解除されている
        hoteri_after = self._count_hoteri(enemy)
        self.assertEqual(hoteri_after, 0,
                         "EX should remove all ほてり marks when count >= 7")

    def test_ex_no_hoteri_no_extra_effects(self):
        """EX: 无「ほてり」时正常伤害无附加效果（无气绝、无增伤buff残留）。"""
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[110035], skill_levels={110035: 10})
        enemy = _make_unit("enemy", "enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        hp_before = enemy.current_hp
        ss.execute_skill(caster=caster, skill_id=110035, battlefield=bf, skip_cost=True)

        # 应受到伤害
        self.assertLess(enemy.current_hp, hp_before, "EX should deal damage")
        # 不应附加气绝
        stun_debuffs = [d for d in enemy.debuffs if d.effect_type == KNOCKOUT]
        self.assertEqual(len(stun_debuffs), 0,
                         "EX should NOT apply stun when ほてり count < 4")

    # ── AS1 120079: かぶり湯 ───────────────────────────────────────

    def test_as1_applies_3hit_and_2_hoteri_marks(self):
        """AS1: 3hit攻撃 + 施加2个「ほてり」mark。"""
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            skills=[120079], skill_levels={120079: 10})
        enemy = _make_unit("enemy", "enemy", Side.ENEMY, Position.ENEMY_RIGHT_BACK, hp=999999)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        hp_before = enemy.current_hp
        result = ss.execute_skill(caster=caster, skill_id=120079, battlefield=bf, skip_cost=True)
        self.assertTrue(result.get('success'))

        # 受到伤害 (3hit)
        self.assertLess(enemy.current_hp, hp_before, "AS1 should deal damage")

        # 施加2个「ほてり」mark
        hoteri_count = self._count_hoteri(enemy)
        self.assertEqual(hoteri_count, 2,
                         "AS1 should apply exactly 2 ほてり marks")

    def test_as1_targets_furthest_enemy(self):
        """AS1: 索敵選最遠敵。"""
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            skills=[120079], skill_levels={120079: 10})
        # near敵と遠敵を設置
        near = _make_unit("near", "near", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999)
        far = _make_unit("far", "far", Side.ENEMY, Position.ENEMY_RIGHT_BACK, hp=999999)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [near, far]
        ss, _ = self._make_services(bf)

        hp_near_before = near.current_hp
        hp_far_before = far.current_hp

        ss.execute_skill(caster=caster, skill_id=120079, battlefield=bf, skip_cost=True)

        # 遠敵(far)受击，近敵(near)不受击
        self.assertLess(far.current_hp, hp_far_before,
                        "AS1 should target furthest enemy (far)")
        self.assertEqual(near.current_hp, hp_near_before,
                         "AS1 should NOT target nearest enemy (near)")

    # ── AS2 120080: 背中流そうか？ ─────────────────────────────────

    def test_as2_applies_3hit_and_1_hoteri_mark(self):
        """AS2: 3hit攻撃 + 施加1个「ほてり」mark（无暴击时）。"""
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[120080], skill_levels={120080: 10},
                            crit_rate=0.0)  # 暴撃率0%
        enemy = _make_unit("enemy", "enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        hp_before = enemy.current_hp
        ss.execute_skill(caster=caster, skill_id=120080, battlefield=bf, skip_cost=True)

        self.assertLess(enemy.current_hp, hp_before, "AS2 should deal damage")

        # 无暴击时只施加1个mark (Block1)
        hoteri_count = self._count_hoteri(enemy)
        self.assertEqual(hoteri_count, 1,
                         "AS2 should apply exactly 1 ほてり mark (no crit)")

    def test_as2_crit_applies_extra_hoteri_mark(self):
        """AS2: 暴撃時追加1個「ほてり」mark（once_per_skill=true）。"""
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[120080], skill_levels={120080: 10},
                            crit_rate=1.0)  # 暴撃率100%
        enemy = _make_unit("enemy", "enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster=caster, skill_id=120080, battlefield=bf, skip_cost=True)

        # 暴击时应施加2个mark (Block1基础1 + Block2 on_crit追加1)
        hoteri_count = self._count_hoteri(enemy)
        self.assertEqual(hoteri_count, 2,
                         "AS2 on crit should apply extra ほてり mark (1 base + 1 crit = 2)")

    def test_as2_lv15_multiplies_dmg_by_mark_count(self):
        """AS2 Lv15: ほてり1つにつきdmg%増加(max5つ)。
        検証: dmg_taken_up buff が caster に付与される (dealt_damage乘区)。
        """
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[120080], skill_levels={120080: 15},
                            crit_rate=0.0)
        enemy = _make_unit("enemy", "enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        # ほてり3個を事前付与
        for m in _make_hoteri_marks("pre", 3):
            enemy.debuffs.append(m)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster=caster, skill_id=120080, battlefield=bf, skip_cost=True)

        # multiplier_per_countモードで caster にDealtDamage buff が付与される (dmg tag=20% at Lv15)
        dealt_buffs = [b for b in caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dealt_buffs), 0,
                           "AS2 Lv15 with ほてり should apply DealtDamage buff to caster (multiplier_per_count)")

    def test_as2_lv10_no_bonus_when_dmg_tag_zero(self):
        """AS2 Lv10: dmg tag=0% なので增伤なし。"""
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[120080], skill_levels={120080: 10},
                            crit_rate=0.0)
        enemy = _make_unit("enemy", "enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999)
        for m in _make_hoteri_marks("pre", 3):
            enemy.debuffs.append(m)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster=caster, skill_id=120080, battlefield=bf, skip_cost=True)

        # dmg tag=0% なので multiplier_per_count 計算後も 0%、DealtDamage buff は付与されない
        dealt_buffs = [b for b in caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dealt_buffs), 0,
                         "AS2 Lv10 should NOT apply DealtDamage buff (dmg tag=0%)")

    # ── PS1 130091: すべすべお肌 ───────────────────────────────────

    def test_ps1_config_has_trigger_attacker(self):
        """PS1: target_identifier="trigger_attacker" が設定されていること。"""
        parsed = self.dl.get_parsed_skill_data(130091)
        self.assertIsNotNone(parsed, "130091 parsed data missing")
        for block in parsed.get('effect_blocks', []):
            for eff in block.get('effects', []):
                self.assertEqual(
                    eff.get('target_identifier'), 'trigger_attacker',
                    "130091 atk_down effect must have target_identifier='trigger_attacker'"
                )

    def test_ps1_applies_atk_down_to_trigger_attacker(self):
        """PS1: 被AS攻撃後、攻撃者(trigger_attacker)のATK下降。"""
        # holder(PS1所持) at ALLY_CENTER_FRONT
        holder = _make_unit("holder", "holder", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=200000, atk=5000, defense=50000,
                            skills=[130091], skill_levels={130091: 10})
        # attacker at ENEMY_LEFT_FRONT (最近ではない)
        attacker = _make_unit("attacker", "attacker", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                              hp=200000, atk=10000, defense=5000)
        # nearest_enemy at ENEMY_CENTER_FRONT (最近)
        nearest = _make_unit("nearest", "nearest", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                             hp=200000, atk=10000, defense=5000)

        bf = BattlefieldState()
        bf.friend_team = [holder]
        bf.enemy_team = [attacker, nearest]
        ss, _ = self._make_services(bf)

        # _trigger_attacker を明示的に設定 (battle_flow_controller が通常行う)
        ss._trigger_attacker = attacker
        ss._trigger_total_damage = 5000

        atk_before_attacker = attacker.attack
        atk_before_nearest = nearest.attack

        result = ss.execute_skill(caster=holder, skill_id=130091, battlefield=bf, skip_cost=True)
        self.assertTrue(result.get('success'))

        # attacker 側に atk_down debuff (STATUS_ATTACK) が付与される
        atk_downs_attacker = [d for d in attacker.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_downs_attacker), 0,
                           "PS1 should apply atk_down to trigger_attacker")
        # nearest 側には付与されない
        atk_downs_nearest = [d for d in nearest.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_downs_nearest), 0,
                         "PS1 should NOT apply atk_down to nearest enemy")

    def test_ps1_stackable_multiple_applications(self):
        """PS1: 重複可 (stackable=true)。複数回発動でatc_down debuff が複数存在。"""
        holder = _make_unit("holder", "holder", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=200000, atk=5000, defense=50000,
                            skills=[130091], skill_levels={130091: 10})
        attacker = _make_unit("attacker", "attacker", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                              hp=200000, atk=10000, defense=5000)

        bf = BattlefieldState()
        bf.friend_team = [holder]
        bf.enemy_team = [attacker]
        ss, _ = self._make_services(bf)

        ss._trigger_attacker = attacker
        ss._trigger_total_damage = 5000

        # 1回目
        ss.execute_skill(caster=holder, skill_id=130091, battlefield=bf, skip_cost=True)
        atk_downs_after_1 = [d for d in attacker.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_downs_after_1), 1, "First application: 1 atk_down debuff")

        # 2回目 (trigger_attacker再設定)
        ss._trigger_attacker = attacker
        ss._trigger_total_damage = 5000
        ss.execute_skill(caster=holder, skill_id=130091, battlefield=bf, skip_cost=True)
        atk_downs_after_2 = [d for d in attacker.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_downs_after_2), 2,
                         "Second application: 2 atk_down debuffs (stackable)")

    # ── PS2 130092: のぼせた？ ─────────────────────────────────────

    def test_ps2_applies_hoteri_and_dmg_taken_up_to_lowest_hp(self):
        """PS2: 最HP少敵に「ほてり」x1 + dmg_taken_up付与。"""
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[130092], skill_levels={130092: 10})
        # e_high: HP満, e_low: HP低割合 (current_hp < max_hp)
        e_high = _make_unit("e_high", "e_high", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                            hp=100000, defense=5000)
        e_low = _make_unit("e_low", "e_low", Side.ENEMY, Position.ENEMY_RIGHT_FRONT,
                           hp=100000, defense=5000)  # max_hp 同じ
        e_low.current_hp = 30000  # current_hp を減らす → HP割合 30% (lowest)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [e_high, e_low]
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster=caster, skill_id=130092, battlefield=bf, skip_cost=True)

        # e_low (最HP少) に「ほてり」と dmg_taken_up 付与
        hoteri_low = self._count_hoteri(e_low)
        self.assertEqual(hoteri_low, 1, "PS2 should apply ほてり mark to lowest HP enemy")

        dmg_taken_up_low = [d for d in e_low.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(dmg_taken_up_low), 0,
                           "PS2 should apply dmg_taken_up to lowest HP enemy")

        # e_high には付与されない
        hoteri_high = self._count_hoteri(e_high)
        self.assertEqual(hoteri_high, 0, "PS2 should NOT apply ほてり to high HP enemy")
        dmg_taken_up_high = [d for d in e_high.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_taken_up_high), 0,
                         "PS2 should NOT apply dmg_taken_up to high HP enemy")

    def test_ps2_dmg_taken_up_has_attack_limited_1(self):
        """PS2: dmg_taken_up の attack_limited=1 (1次被攻撃消耗) が設定されていること。"""
        parsed = self.dl.get_parsed_skill_data(130092)
        self.assertIsNotNone(parsed, "130092 parsed data missing")
        blocks = parsed.get('effect_blocks', [])
        self.assertGreater(len(blocks), 0)
        effects = blocks[0].get('effects', [])
        dmg_taken_up_eff = next(
            (e for e in effects if e.get('effect_type') == 'dmg_taken_up'), None
        )
        self.assertIsNotNone(dmg_taken_up_eff, "130092 should have dmg_taken_up effect")
        flags = dmg_taken_up_eff.get('flags', {})
        self.assertEqual(flags.get('attack_limited'), 1,
                         "PS2 dmg_taken_up must have attack_limited=1 (consumed by 1 attack)")
        self.assertEqual(dmg_taken_up_eff.get('duration_type'), 'hit',
                         "PS2 dmg_taken_up must have duration_type='hit'")

    def test_ps2_mark_not_consumed_by_attack(self):
        """PS2: 「ほてり」mark は被攻撃で消耗せず永続する (dmg_taken_up のみ消耗)。"""
        caster = _make_unit("caster", "caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            skills=[130092, 120080], skill_levels={130092: 10, 120080: 10},
                            crit_rate=0.0)
        enemy = _make_unit("enemy", "enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                           hp=999999, defense=5000)

        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        ss, _ = self._make_services(bf)

        # PS2発動 → 「ほてり」とdmg_taken_up付与
        ss.execute_skill(caster=caster, skill_id=130092, battlefield=bf, skip_cost=True)
        hoteri_after_ps2 = self._count_hoteri(enemy)
        dmg_taken_up_after_ps2 = [d for d in enemy.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(hoteri_after_ps2, 1, "PS2 should apply 1 ほてり")
        self.assertEqual(len(dmg_taken_up_after_ps2), 1, "PS2 should apply 1 dmg_taken_up")

        # AS2(120080)で攻撃 → dmg_taken_up は消耗されるが「ほてり」は残る + AS2の「ほてり」追加で2個
        ss.execute_skill(caster=caster, skill_id=120080, battlefield=bf, skip_cost=True)
        hoteri_after_attack = self._count_hoteri(enemy)
        dmg_taken_up_after_attack = [d for d in enemy.debuffs if d.effect_type == RECEIVED_DAMAGE]

        # ほてり: 1 (PS2) + 1 (AS2) = 2 (markは消耗しない)
        self.assertEqual(hoteri_after_attack, 2,
                         "ほてり mark should NOT be consumed by attack (1 from PS2 + 1 from AS2 = 2)")
        # dmg_taken_up: 1回の被攻撃で消耗
        self.assertEqual(len(dmg_taken_up_after_attack), 0,
                         "dmg_taken_up should be consumed by 1 attack (attack_limited=1)")


if __name__ == '__main__':
    unittest.main()
