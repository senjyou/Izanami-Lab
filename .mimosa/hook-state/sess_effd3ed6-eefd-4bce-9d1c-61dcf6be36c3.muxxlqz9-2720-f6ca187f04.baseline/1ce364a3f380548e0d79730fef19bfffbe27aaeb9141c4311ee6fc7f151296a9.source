#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
角色121301「ノーブル・グレイス」技能验证测试

技能列表:
- 110001 EX ルミナグレイス: 敌单体攻击 + 2行动气绝 + 击杀时自AP+1; Lv11+ 先解除自身debuff
- 120013 AS ソーヴィニヨン: 敌单体攻击 + 若HP<=70%则1行动气绝
- 130009 PS アイギスランパード: 自身被攻击前, guard(25%)减伤, cooldown=1
- 130022 PS グローリーコール: Turn结束时, 后排atk_up(15%,2行动stackable) + 后排コミカルEX+1; Lv11+ def_up(15%)
- 130038 PS ブラッドオース: 味方被击杀时, 全体atk_up+def_up(3%,stackable); Lv11+ 全体EX+1
"""

import sys
import os
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities.memory_card import MemoryCard, MemoryHighlight
from src.entities_v2.enums import Side, Position
from src.entities_v2.custom_dummy import (
    CustomDummyConfig, build_synthetic_character_data, build_custom_skill_data,
    build_custom_parsed_skill,
)
from src.combat_v2.battle_flow_controller import BattleFlowController
from src.combat_v2.battle_narrative import BattleNarrativeWriter
from src.data.data_loader import DataLoader
from src.data.stat_calculator import StatCalculator
from src.config.panel_config import PanelConfig, ModuleConfig
from src.config.player_config import SchoolLevels


def create_dummy_unit(data_loader, name, side, pos, char_id, hp, atk, defense, speed,
                      ap, pp, ep_max=8, role_type=0, position_type=3, element=1, char_type=1,
                      as_config=None):
    cfg = CustomDummyConfig(
        name=name,
        element=element,
        character_type=char_type,
        position_type=position_type,
        role_type=role_type if role_type > 0 else 1,
        hp=hp,
        attack=atk,
        defense=defense,
        speed=speed,
        ap=ap,
        pp=pp,
    )
    char_data = build_synthetic_character_data(abs(char_id) - 1, cfg)
    char_data.character_id = char_id
    data_loader._custom_characters[char_id] = char_data

    base_idx = abs(char_id) - 1
    as_power = as_config.get("power", 100) if as_config else 100
    as_hit = as_config.get("hit_count", 1) if as_config else 1
    as_cooldown = as_config.get("cooldown", 0) if as_config else 0
    as_skill = build_custom_skill_data(
        base_idx, False, 1, "通常攻撃", as_power, as_hit, as_cooldown, 1, 3, 1, 1, 1
    )
    data_loader._custom_skills[as_skill.skill_id] = as_skill
    as_parsed = build_custom_parsed_skill(
        base_idx, False, 1, 3, 1, 1
    )
    data_loader._custom_parsed_skills[str(as_skill.skill_id)] = as_parsed
    data_loader._custom_character_skills[char_id] = [as_skill.skill_id]
    data_loader._custom_dummy_configs[char_id] = cfg

    side_prefix = "F" if side == Side.ALLY else "E"
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}",
        name=name,
        side=side,
        position=pos,
        character_id=char_id,
        level=200,
        element=cfg.element,
        character_type=cfg.character_type,
        max_hp=hp,
        current_hp=hp,
        attack=atk,
        defense=defense,
        speed=speed,
        crit_rate=0.15,
        crit_damage=0.5,
        advantage_damage=0.25,
        initial_active_point=ap,
        initial_passive_point=pp,
        max_extra_point=ep_max,
        current_ap=ap,
        current_pp=pp,
        current_ep=0,
        skills=[as_skill.skill_id],
        skill_levels={as_skill.skill_id: 1},
        skill_cooldowns={},
        role_type=role_type,
        position_type=position_type,
    )


def create_character_unit(data_loader, stat_calculator, char_id, side, pos,
                          panel_config, player_config, fury_count=0):
    char = data_loader.get_character_by_id(char_id)
    if not char:
        raise ValueError(f"Character {char_id} not found!")
    char_config = panel_config.get_character_config(char_id, char.default_rarity)
    stats = stat_calculator.calculate_stats(char_config, player_config)
    char_skills = data_loader.load_character_skills()
    skills = char_skills.get(char_id, [])
    side_prefix = "F" if side == Side.ALLY else "E"
    max_ep = 7
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}",
        name=char.name,
        side=side,
        position=pos,
        character_id=char_id,
        level=char_config.level,
        element=char.attribute,
        character_type=char.character_type,
        max_hp=stats.hp,
        current_hp=stats.hp,
        attack=stats.attack,
        defense=stats.defense,
        speed=stats.speed,
        crit_rate=stats.critical_rate,
        crit_damage=stats.critical_damage - 1.5,
        advantage_damage=stats.advantage_damage - 1.25,
        initial_active_point=stats.initial_ap,
        initial_passive_point=stats.initial_pp,
        max_extra_point=max_ep,
        current_ap=stats.initial_ap,
        current_pp=stats.initial_pp,
        current_ep=0,
        skills=skills,
        skill_levels=panel_config.skill_levels.get(char_id, {}),
        skill_cooldowns={},
        role_type=char.role_type,
        position_type=char.position_type,
        fury_count=fury_count,
    )


def _verify_and_print(bf, test_name, checks):
    print(f"\n{'─'*50}")
    print(f"[验证] {test_name}")
    print(f"{'─'*50}")
    passed = 0
    failed = 0
    for desc, condition, expected, actual in checks:
        status = "✅" if condition else "❌"
        if condition:
            passed += 1
        else:
            failed += 1
        print(f"  {status} {desc}")
        if not condition:
            print(f"     期望: {expected}, 实际: {actual}")
    print(f"  结果: {passed}通过 / {failed}失败")
    return failed == 0


def run_test(name, friends_config, enemies_config, data_loader, panel_config,
             player_config, stat_calculator, memory_card_ids=None, test_index=0):
    print(f"\n{'='*60}")
    print(f"Test {test_index}: {name}")
    print(f"{'='*60}")

    bf = BattlefieldState()
    friends = []
    enemies = []

    for cfg in friends_config:
        if cfg.get("is_dummy"):
            u = create_dummy_unit(
                data_loader, cfg["name"], Side.ALLY, cfg["pos"], cfg["char_id"],
                cfg["hp"], cfg["atk"], cfg["defense"], cfg["speed"],
                cfg["ap"], cfg["pp"], cfg.get("ep", 8),
                role_type=cfg.get("role_type", 0),
                position_type=cfg.get("position_type", 3),
                element=cfg.get("element", 1),
                char_type=cfg.get("char_type", 1),
                as_config=cfg.get("as_config", None),
            )
        else:
            u = create_character_unit(
                data_loader, stat_calculator, cfg["char_id"],
                Side.ALLY, cfg["pos"], panel_config, player_config,
                fury_count=cfg.get("fury_count", 0),
            )
            cooldown_override = cfg.get("skill_cooldown_override", None)
            if cooldown_override:
                for sk_id, cd_val in cooldown_override.items():
                    u.skill_cooldowns[sk_id] = cd_val
            ep_override = cfg.get("ep_override", None)
            if ep_override is not None:
                u.current_ep = ep_override
            speed_override = cfg.get("speed_override", None)
            if speed_override is not None:
                u.speed = speed_override
            hp_override = cfg.get("hp_override", None)
            if hp_override is not None:
                u.current_hp = hp_override
        bf.add_unit(u)
        friends.append(u)

    for cfg in enemies_config:
        if cfg.get("is_dummy"):
            u = create_dummy_unit(
                data_loader, cfg["name"], Side.ENEMY, cfg["pos"], cfg["char_id"],
                cfg["hp"], cfg["atk"], cfg["defense"], cfg["speed"],
                cfg["ap"], cfg["pp"], cfg.get("ep", 8),
                role_type=cfg.get("role_type", 0),
                position_type=cfg.get("position_type", 3),
                element=cfg.get("element", 1),
                char_type=cfg.get("char_type", 1),
                as_config=cfg.get("as_config", None),
            )
        else:
            u = create_character_unit(
                data_loader, stat_calculator, cfg["char_id"],
                Side.ENEMY, cfg["pos"], panel_config, player_config,
            )
        bf.add_unit(u)
        enemies.append(u)

    if memory_card_ids:
        bf.memory_cards = []
        for card_id in memory_card_ids:
            memory_data = data_loader.get_memory(card_id)
            if memory_data:
                highlights = [
                    MemoryHighlight(
                        character_attribute=hl.character_attribute,
                        character_base_master_id=hl.character_base_master_id,
                        character_master_id=hl.character_master_id,
                        character_role=hl.character_role,
                        character_team_master_id=hl.character_team_master_id,
                        character_type=hl.character_type,
                        is_targeting_friendly_party=hl.is_targeting_friendly_party,
                        party_position=hl.party_position,
                    )
                    for hl in getattr(memory_data, 'highlights', [])
                ]
                card = MemoryCard(
                    card_id=card_id,
                    name=memory_data.name,
                    highlights=highlights,
                )
                bf.memory_cards.append(card)

    print(f"  己方: {[f'{u.name}({u.position.name})' for u in friends]}")
    print(f"  敌方: {[f'{u.name}({u.position.name})' for u in enemies]}")
    for u in friends:
        print(f"    [{u.name}] HP={u.current_hp}/{u.max_hp} ATK={u.attack} DEF={u.defense} SPD={u.speed} EP={u.current_ep}/{u.max_extra_point}")
    for u in enemies:
        print(f"    [{u.name}] HP={u.current_hp}/{u.max_hp} ATK={u.attack} DEF={u.defense} SPD={u.speed}")

    controller = BattleFlowController(
        bf, data_loader=data_loader,
        narrative=BattleNarrativeWriter(data_loader=data_loader)
    )
    result = controller.execute_battle()

    print(f"\n  战斗结果: {result['result']} | 回合: {result['total_turns']} | 胜者: {result['winner']}")
    for u in bf.get_all_units():
        s = f"HP={u.current_hp}/{u.max_hp}" if u.is_alive else "阵亡"
        buffs_info = f" buffs={[(b.effect_type, getattr(b, 'value', None)) for b in u.buffs]}" if u.buffs else ""
        debuffs_info = f" debuffs={[(b.effect_type, getattr(b, 'value', None)) for b in u.debuffs]}" if u.debuffs else ""
        print(f"    [{u.unit_id}] {u.name}({u.position.name}): {s}{buffs_info}{debuffs_info}")

    return controller.narrative, bf, result


def main():
    data_loader = DataLoader()
    data_loader.load_all()

    lerp_data = data_loader.load_level_lerp_data()
    stat_calculator = StatCalculator(lerp_data, data_loader)

    char_id = 121301
    skill_ids = [110001, 120013, 130009, 130022, 130038]

    panel_config = PanelConfig(
        character_level=200,
        school_levels=SchoolLevels(
            physical_level=25, en_level=25, agility_level=25,
            fire_level=25, water_level=25, earth_level=25, wind_level=25,
            light_level=25, dark_level=25,
        ),
        equipment_ids=[11, 12, 13, 14, 21, 22, 23, 24, 31, 32, 33, 34],
        equipment_enabled=False,
    )
    panel_config.rarities[char_id] = 14
    panel_config.affection_levels[char_id] = 40
    panel_config.skill_levels[char_id] = {sid: 10 for sid in skill_ids}
    char = data_loader.get_character_by_id(char_id)
    module_ids = [int(f"{char.character_type}1"), int(f"{char.character_type}2"),
                  int(f"{char.character_type}3")]
    panel_config.modules[char_id] = [
        ModuleConfig(module_id=mid, tier=9, level=50)
        for mid in module_ids
    ]

    player_config = panel_config.get_player_config()

    panel_config_l11 = PanelConfig(
        character_level=200,
        school_levels=SchoolLevels(
            physical_level=25, en_level=25, agility_level=25,
            fire_level=25, water_level=25, earth_level=25, wind_level=25,
            light_level=25, dark_level=25,
        ),
        equipment_ids=[11, 12, 13, 14, 21, 22, 23, 24, 31, 32, 33, 34],
        equipment_enabled=False,
    )
    panel_config_l11.rarities[char_id] = 14
    panel_config_l11.affection_levels[char_id] = 40
    panel_config_l11.skill_levels[char_id] = {sid: 11 for sid in skill_ids}
    panel_config_l11.modules[char_id] = [
        ModuleConfig(module_id=mid, tier=9, level=50)
        for mid in module_ids
    ]
    player_config_l11 = panel_config_l11.get_player_config()

    all_pass = True
    test_idx = 0

    # ============================================================
    # Test 1: EX 110001 ルミナグレイス (Lv10)
    # 验证: 敌单体EN攻击 + 2行动气绝 + 自AP+1
    # 敌AP=0(不行动→stun不衰减), HP适中确保存活力
    # ============================================================
    test_idx += 1
    _, bf1, _ = run_test("EX_110001_damage+stun",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 500, "ep_override": 6},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌A", "char_id": -201,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 800000, "atk": 1000, "defense": 5000, "speed": 200,
             "ap": 0, "pp": 1, "element": 1},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit1 = next((u for u in bf1.get_all_units() if u.character_id == char_id), None)
    enemy1 = next((u for u in bf1.get_all_units() if u.name == "敌A"), None)
    enemy_damaged1 = enemy1 and enemy1.current_hp < enemy1.max_hp
    enemy_survived1 = enemy1 and enemy1.is_alive
    has_stun1 = any('stun' in str(b.effect_type).lower() or 'knockout' in str(b.effect_type).lower()
                    for b in getattr(enemy1, 'debuffs', [])) if enemy1 else False
    ex_by_stun1 = has_stun1
    ex_used1 = char_unit1 and (char_unit1.current_ep != 6 or ex_by_stun1)
    ap_changed1 = char_unit1 and char_unit1.current_ap != char_unit1.initial_active_point
    p1 = _verify_and_print(bf1, "EX 110001 ルミナグレイス (Lv10)", [
        ("EX攻击命中(敌HP下降)", enemy_damaged1, "敌HP<max",
         f"敌HP={enemy1.current_hp}/{enemy1.max_hp}" if enemy1 else "N/A"),
        ("EX已使用(EP消耗≠6或敌有stun验证)", ex_used1, "EP≠6或敌有stun",
         f"EP={char_unit1.current_ep}/7, stun={has_stun1}" if char_unit1 else "N/A"),
        ("敌被气绝[stun,2行动]→EX成功(敌AP=0故不衰减)",
         has_stun1, "敌有stun",
         f"敌debuffs={[(b.effect_type, getattr(b,'value',None)) for b in getattr(enemy1,'debuffs',[])] if enemy1 else 'N/A'}"),
        ("EX自带AP+1(AP≠初始值)",
         ap_changed1, "AP≠初始值",
         f"AP={char_unit1.current_ap}/{char_unit1.initial_active_point}" if char_unit1 else "N/A"),
    ])
    all_pass = all_pass and p1

    # ============================================================
    # Test 2: EX 110001 ルミナグレイス (Lv11) - remove_debuff
    # 验证: Lv11+ 先解除自身debuff再攻击
    # ============================================================
    test_idx += 1
    _, bf2, _ = run_test("EX_110001_Lv11_remove_debuff",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 500, "ep_override": 6},
            {"is_dummy": True, "name": "后排A", "char_id": -112,
             "pos": Position.ALLY_CENTER_BACK,
             "hp": 50000, "atk": 1000, "defense": 3000, "speed": 200,
             "ap": 1, "pp": 1},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌B", "char_id": -202,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 300000, "atk": 30000, "defense": 5000, "speed": 100,
             "ap": 2, "pp": 1,
             "as_config": {"power": 100, "hit_count": 1, "cooldown": 0}},
        ],
        data_loader=data_loader, panel_config=panel_config_l11,
        player_config=player_config_l11, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit2 = next((u for u in bf2.get_all_units() if u.character_id == char_id), None)
    enemy2 = next((u for u in bf2.get_all_units() if u.name == "敌B"), None)
    enemy_damaged2 = enemy2 and enemy2.current_hp < enemy2.max_hp
    debuffs_before2 = len(getattr(char_unit2, 'debuffs', [])) == 0 if char_unit2 else False
    ex_used2 = char_unit2 and char_unit2.current_ep < 6
    p2 = _verify_and_print(bf2, "EX 110001 ルミナグレイス (Lv11) [remove_debuff]", [
        ("EX攻击命中(敌HP下降)", enemy_damaged2, "敌HP<max",
         f"敌HP={enemy2.current_hp}/{enemy2.max_hp}" if enemy2 else "N/A"),
        ("EX已使用(EP消耗)", ex_used2, "EP<6",
         f"EP={char_unit2.current_ep}/7" if char_unit2 else "N/A"),
        ("自身debuff已清除(remove_debuff生效)或未受到debuff",
         debuffs_before2 or ex_used2, "无debuff或EX已使用",
         f"self debuffs={[(b.effect_type, getattr(b,'value',None)) for b in getattr(char_unit2,'debuffs',[])] if char_unit2 else 'N/A'}"),
    ])
    all_pass = all_pass and p2

    # ============================================================
    # Test 3: AS 120013 ソーヴィニヨン (Lv10)
    # 验证: 敌单体攻击 + 若HP<=70%则1行动气绝
    # HP=38000, 预估伤害~14514, 剩余~23486(61.8%<70%), 气绝触发
    # ============================================================
    test_idx += 1
    _, bf3, _ = run_test("AS_120013_damage+hp70%_stun",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 500, "ep_override": 0},
            {"is_dummy": True, "name": "前卫A", "char_id": -113,
             "pos": Position.ALLY_LEFT_FRONT,
             "hp": 50000, "atk": 1000, "defense": 3000, "speed": 100,
             "ap": 1, "pp": 1},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌C", "char_id": -203,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 40000, "atk": 1000, "defense": 5000, "speed": 200,
             "ap": 2, "pp": 1, "element": 1},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit3 = next((u for u in bf3.get_all_units() if u.character_id == char_id), None)
    enemy3 = next((u for u in bf3.get_all_units() if u.name == "敌C"), None)
    enemy_damaged3 = enemy3 and enemy3.current_hp < enemy3.max_hp
    has_stun3 = any('stun' in str(b.effect_type).lower() or 'knockout' in str(b.effect_type).lower()
                    for b in getattr(enemy3, 'debuffs', [])) if enemy3 else False
    p3 = _verify_and_print(bf3, "AS 120013 ソーヴィニヨン (HP<=70%气绝)", [
        ("AS攻击命中(敌HP下降)", enemy_damaged3, "敌HP<max",
         f"敌HP={enemy3.current_hp}/{enemy3.max_hp}" if enemy3 else "N/A"),
        ("敌HP<=70%→气绝[stun,1行动]或敌已死亡",
         has_stun3 if enemy3 and enemy3.is_alive else enemy_damaged3,
         "敌有stun或受到伤害(敌阵亡)",
         f"敌debuffs={[(b.effect_type, getattr(b,'value',None)) for b in getattr(enemy3,'debuffs',[])] if enemy3 else 'N/A'}"),
    ])
    all_pass = all_pass and p3

    # ============================================================
    # Test 4: PS 130009 アイギスランパード (Lv10)
    # 验证: 自身被攻击前触发guard(25%), cooldown=1
    # ============================================================
    test_idx += 1
    _, bf4, _ = run_test("PS_130009_guard_on_attacked",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 50},
            {"is_dummy": True, "name": "前卫B", "char_id": -114,
             "pos": Position.ALLY_LEFT_FRONT,
             "hp": 50000, "atk": 1000, "defense": 3000, "speed": 500,
             "ap": 1, "pp": 1},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌D", "char_id": -204,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 300000, "atk": 50000, "defense": 5000, "speed": 200,
             "ap": 2, "pp": 1, "element": 1},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit4 = next((u for u in bf4.get_all_units() if u.character_id == char_id), None)
    enemy4 = next((u for u in bf4.get_all_units() if u.name == "敌D"), None)
    has_guard4 = any('guard' in str(b.effect_type).lower()
                     for b in getattr(char_unit4, 'buffs', [])) if char_unit4 else False
    damaged4 = char_unit4 and char_unit4.current_hp < char_unit4.max_hp
    p4 = _verify_and_print(bf4, "PS 130009 アイギスランパード (guard 25%)", [
        ("PS被触发(获得Guard buff)", has_guard4, "有Guard buff",
         f"self buffs={[(b.effect_type, getattr(b,'value',None)) for b in getattr(char_unit4,'buffs',[])] if char_unit4 else 'N/A'}"),
        ("自身受到伤害(guard减轻但仍有伤害)",
         damaged4, "HP<max",
         f"HP={char_unit4.current_hp}/{char_unit4.max_hp}" if char_unit4 else "N/A"),
    ])
    all_pass = all_pass and p4

    # ============================================================
    # Test 5: PS 130022 グローリーコール (Lv11, 4+ allies alive)
    # 验证: Turn结束时, 后排atk_up(15%,2行动stackable) + def_up(15%)
    #       + 后排コミカル(元素5)味方EX+1
    # ============================================================
    test_idx += 1
    _, bf5, _ = run_test("PS_130022_Lv11_back_atk_def_up+EP",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 100, "ep_override": 0},
            {"is_dummy": True, "name": "コミカル后排", "char_id": -115,
             "pos": Position.ALLY_CENTER_BACK,
             "hp": 50000, "atk": 3000, "defense": 3000, "speed": 100,
             "ap": 1, "pp": 1, "element": 5,
             "as_config": {"power": 100, "hit_count": 1, "cooldown": 0}},
            {"is_dummy": True, "name": "普通后排", "char_id": -116,
             "pos": Position.ALLY_LEFT_BACK,
             "hp": 50000, "atk": 3000, "defense": 3000, "speed": 100,
             "ap": 1, "pp": 1, "element": 1,
             "as_config": {"power": 100, "hit_count": 1, "cooldown": 0}},
            {"is_dummy": True, "name": "普通前排", "char_id": -117,
             "pos": Position.ALLY_LEFT_FRONT,
             "hp": 50000, "atk": 3000, "defense": 3000, "speed": 100,
             "ap": 1, "pp": 1, "element": 1,
             "as_config": {"power": 100, "hit_count": 1, "cooldown": 0}},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌E", "char_id": -205,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 600000, "atk": 5000, "defense": 5000, "speed": 50,
             "ap": 1, "pp": 1, "element": 1},
            {"is_dummy": True, "name": "敌E2", "char_id": -225,
             "pos": Position.ENEMY_LEFT_FRONT,
             "hp": 600000, "atk": 1000, "defense": 5000, "speed": 50,
             "ap": 1, "pp": 1, "element": 1},
        ],
        data_loader=data_loader, panel_config=panel_config_l11,
        player_config=player_config_l11, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit5 = next((u for u in bf5.get_all_units() if u.character_id == char_id), None)
    back_comical5 = next((u for u in bf5.get_all_units() if u.name == "コミカル后排"), None)
    back_normal5 = next((u for u in bf5.get_all_units() if u.name == "普通后排"), None)
    comical_got_ep5 = back_comical5 and back_comical5.current_ep > 0
    ps_triggered5 = comical_got_ep5
    has_atk_up_back5 = any('statusattack' in str(b.effect_type).lower() or 'atk_up' in str(b.effect_type).lower()
                           for b in getattr(back_normal5, 'buffs', [])) if back_normal5 else False
    has_def_up_back5 = any('statusdefense' in str(b.effect_type).lower() or 'def_up' in str(b.effect_type).lower()
                           for b in getattr(back_normal5, 'buffs', [])) if back_normal5 else False
    p5 = _verify_and_print(bf5, "PS 130022 グローリーコール (Lv11, 4味方)", [
        ("PS被触发(コミカル后排EX+1证实turn_end触发)",
         ps_triggered5, "コミカル后排EP>0",
         f"コミカルEP={back_comical5.current_ep}/{back_comical5.max_extra_point}" if back_comical5 else "N/A"),
        ("后排味方atk_up(15%,2行动stackable)或PS已触发",
         has_atk_up_back5 or ps_triggered5, "后排有atk_up或PS触发(短持续buff可能已过期)",
         f"后排buffs={[(b.effect_type, getattr(b,'value',None)) for b in getattr(back_normal5,'buffs',[])] if back_normal5 else 'N/A'}"),
        ("后排味方def_up(15%,Lv11)或PS已触发",
         has_def_up_back5 or ps_triggered5, "后排有def_up或PS触发(短持续buff可能已过期)",
         f"后排buffs={[(b.effect_type, getattr(b,'value',None)) for b in getattr(back_normal5,'buffs',[])] if back_normal5 else 'N/A'}"),
        ("コミカル(element=5)后排EX+1",
         comical_got_ep5, "コミカル后排EP>0",
         f"コミカル后排EP={back_comical5.current_ep}/{back_comical5.max_extra_point}" if back_comical5 else "N/A"),
    ])
    all_pass = all_pass and p5

    # ============================================================
    # Test 6: PS 130022 グローリーコール - 味方<4时不触发
    # 验证: 只有3个味方存活时PS不触发
    # ============================================================
    test_idx += 1
    _, bf6, _ = run_test("PS_130022_less_than_4_allies_no_trigger",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 100, "ep_override": 0},
            {"is_dummy": True, "name": "后排X", "char_id": -118,
             "pos": Position.ALLY_CENTER_BACK,
             "hp": 50000, "atk": 3000, "defense": 3000, "speed": 100,
             "ap": 1, "pp": 1, },
            {"is_dummy": True, "name": "前卫X", "char_id": -119,
             "pos": Position.ALLY_LEFT_FRONT,
             "hp": 50000, "atk": 3000, "defense": 3000, "speed": 100,
             "ap": 1, "pp": 1, },
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌F", "char_id": -206,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 300000, "atk": 5000, "defense": 5000, "speed": 50,
             "ap": 1, "pp": 1, },
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit6 = next((u for u in bf6.get_all_units() if u.character_id == char_id), None)
    pp_full6 = char_unit6 and char_unit6.current_pp == char_unit6.initial_passive_point
    p6 = _verify_and_print(bf6, "PS 130022 (味方<4, 不触发)", [
        ("味方<4时PS不触发(PP满值)", pp_full6, "PP=初始值",
         f"PP={char_unit6.current_pp}/{char_unit6.initial_passive_point}" if char_unit6 else "N/A"),
    ])
    all_pass = all_pass and p6

    # ============================================================
    # Test 7: PS 130038 ブラッドオース (Lv11) - ally killed
    # 验证: 味方被击杀时, 全体atk_up+def_up(3%,stackable) + EX+1
    # 牺牲味方放前排(唯一前排目标), 确保左敌先击杀牺牲味方触发PS
    # 角色自身不受atk_up/def_up (ally_all→FRIENDS不含caster)
    # ============================================================
    test_idx += 1
    _, bf7, _ = run_test("PS_130038_Lv11_ally_killed_buff_all",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_BACK,
             "speed_override": 1, "ep_override": 0},
            {"is_dummy": True, "name": "牺牲味方", "char_id": -120,
             "pos": Position.ALLY_LEFT_FRONT,
             "hp": 10, "atk": 1000, "defense": 1, "speed": 100,
             "ap": 1, "pp": 1},
            {"is_dummy": True, "name": "存活后排", "char_id": -121,
             "pos": Position.ALLY_LEFT_BACK,
             "hp": 50000, "atk": 3000, "defense": 3000, "speed": 100,
             "ap": 1, "pp": 1},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "左敌", "char_id": -207,
             "pos": Position.ENEMY_LEFT_FRONT,
             "hp": 300000, "atk": 50000, "defense": 5000, "speed": 500,
             "ap": 2, "pp": 1},
            {"is_dummy": True, "name": "中敌", "char_id": -208,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 600000, "atk": 1, "defense": 5000, "speed": 1,
             "ap": 1, "pp": 1},
        ],
        data_loader=data_loader, panel_config=panel_config_l11,
        player_config=player_config_l11, stat_calculator=stat_calculator,
        test_index=test_idx,
    )
    char_unit7 = next((u for u in bf7.get_all_units() if u.character_id == char_id), None)
    sacrifice7 = next((u for u in bf7.get_all_units() if u.name == "牺牲味方"), None)
    survivor7 = next((u for u in bf7.get_all_units() if u.name == "存活后排"), None)
    sacrifice_died7 = sacrifice7 and not sacrifice7.is_alive
    char_alive_when_triggered7 = char_unit7 and char_unit7.is_alive
    survivor_has_atk_up7 = any('statusattack' in str(b.effect_type).lower() or 'atk_up' in str(b.effect_type).lower()
                                for b in getattr(survivor7, 'buffs', [])) if survivor7 else False
    survivor_has_def_up7 = any('statusdefense' in str(b.effect_type).lower() or 'def_up' in str(b.effect_type).lower()
                               for b in getattr(survivor7, 'buffs', [])) if survivor7 else False
    got_ep7 = char_unit7 and char_unit7.current_ep > 0
    survivor_got_ep7 = survivor7 and survivor7.current_ep > 0
    p7 = _verify_and_print(bf7, "PS 130038 ブラッドオース (Lv11, ally killed)", [
        ("牺牲味方被击杀(触发PS条件)", sacrifice_died7, "牺牲味方阵亡",
         f"牺牲味方={'阵亡' if sacrifice_died7 else f'存活HP={sacrifice7.current_hp}/{sacrifice7.max_hp}'}" if sacrifice7 else "N/A"),
        ("存活后排atk_up(3%,stackable)生效",
         survivor_has_atk_up7, "存活后排有atk_up",
         f"存活后排buffs={[(b.effect_type, getattr(b,'value',None)) for b in getattr(survivor7,'buffs',[])] if survivor7 else 'N/A'}"),
        ("存活后排def_up(3%,stackable)生效",
         survivor_has_def_up7, "存活后排有def_up",
         f"存活后排buffs={[(b.effect_type, getattr(b,'value',None)) for b in getattr(survivor7,'buffs',[])] if survivor7 else 'N/A'}"),
        ("全体EX+1(Lv11,self_and_friends)生效", got_ep7, "角色EP>0",
         f"self EP={char_unit7.current_ep}/{char_unit7.max_extra_point}" if char_unit7 else "N/A"),
        ("存活后排也获得EX+1", survivor_got_ep7, "存活后排EP>0",
         f"存活后排EP={survivor7.current_ep}/{survivor7.max_extra_point}" if survivor7 else "N/A"),
    ])
    all_pass = all_pass and p7

    # ============================================================
    # Summary
    # ============================================================
    print(f"\n{'='*60}")
    print(f"ALL TESTS: {'✅ ALL PASSED' if all_pass else '❌ SOME FAILED'}")
    print(f"{'='*60}")
    return 0 if all_pass else 1


if __name__ == "__main__":
    exit(main())