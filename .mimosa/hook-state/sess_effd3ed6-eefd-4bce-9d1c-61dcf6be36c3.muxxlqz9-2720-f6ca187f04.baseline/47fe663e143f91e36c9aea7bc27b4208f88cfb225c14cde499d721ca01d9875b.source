import json
from pathlib import Path
from typing import Dict, Optional, Any, List

from ..entities_v2.skill_data import SkillData, EffectBlock, EffectData
from ..entities_v2.unit_state import UnitState
from ..entities_v2.enums import Attribute, CharacterType, Side, Position

class DataLoaderV2:
    """
    数据加载器 V2
    负责加载角色缓存数据、技能效果和技能Tag数值
    """
    
    def __init__(self, data_dir: str):
        self.data_dir = Path(data_dir)
        self.char_cache: Dict[str, Any] = {}
        self.skill_data: Dict[str, Any] = {}
        self.skill_tags: Dict[str, Any] = {}
        self.parsed_skills: Dict[int, SkillData] = {}
        
        self._load_files()

    def _load_files(self):
        """加载所有必要的 JSON 文件"""
        # Load Character Cache
        with open(self.data_dir / "character_stats_cache.json", "r", encoding="utf-8") as f:
            self.char_cache = json.load(f)["characters"]
            
        # Load Skill Effects
        with open(self.data_dir / "skill_effects_hybrid.json", "r", encoding="utf-8") as f:
            self.skill_data = json.load(f)
            
        # Load Skill Tags
        with open(self.data_dir / "skill_tag_values.json", "r", encoding="utf-8") as f:
            self.skill_tags = json.load(f)

    def get_unit_state(self, character_id: int, unit_id: str) -> Optional[UnitState]:
        """从缓存创建 UnitState"""
        cid_str = str(character_id)
        if cid_str not in self.char_cache:
            print(f"Character ID {character_id} not found in cache.")
            return None
            
        data = self.char_cache[cid_str]
        stats = data["stats"]
        config = data["config"]
        
        # Mapping Skill Levels needs to be handled by the caller or stored in unit
        # UnitState doesn't store skill levels directly usually, or does it?
        # UnitState has `skills` list (of IDs).
        
        # Skill List (Active + Passive + EX)
        skill_ids = [int(sid) for sid in config["skill_levels"].keys()]

        max_extra_point = 100
        for sid in skill_ids:
            sid_str = str(sid)
            if sid_str in self.skill_data:
                sd = self.skill_data[sid_str]
                if sd.get("skill_type") == 3:
                    max_extra_point = sd.get("resource_cost", 100)
                    break

        unit = UnitState(
            unit_id=unit_id,
            name=data["name"],
            side=Side.ALLY, # Placeholder, will be overwritten
            position=Position.ALLY_CENTER_FRONT, # Placeholder
            character_id=character_id,
            level=config["level"],
            element=Attribute(data["attribute"]),
            character_type=CharacterType(data["character_type"]),
            
            max_hp=int(stats["hp"]),
            attack=int(stats["attack"]),
            defense=int(stats["defense"]),
            speed=int(stats["speed"]),
            crit_rate=float(stats.get("critical_rate", 0.0)),
            crit_damage=float(stats.get("critical_damage", 1.5)),
            advantage_damage=float(stats.get("advantage_damage", 1.25)),
            
            initial_active_point=stats.get("initial_ap", 3),
            initial_passive_point=stats.get("initial_pp", 3),
            max_extra_point=max_extra_point,
            
            current_hp=int(stats["hp"]),
            current_ap=stats.get("initial_ap", 3),
            current_pp=stats.get("initial_pp", 3),
            current_ep=0,
            
            skills=skill_ids
        )
        
        # Store skill levels in a separate map if needed? 
        # For now, we trust the skill tag calculator to use the provided level.
        # But where do we store the level? 
        # UnitState doesn't have skill_level map.
        # We might need to attach it dynamically or update UnitState.
        unit.skill_levels = {int(k): v for k, v in config["skill_levels"].items()}
        
        return unit

    def get_skill_data(self, skill_id: int) -> Optional[SkillData]:
        """获取并解析技能数据"""
        sid_str = str(skill_id)
        if skill_id in self.parsed_skills:
            return self.parsed_skills[skill_id]
            
        if sid_str not in self.skill_data:
            return None
            
        raw = self.skill_data[sid_str]
        
        # Parse Effect Blocks
        blocks = []
        for b in raw.get("effect_blocks", []):
            effects = []
            for e in b.get("effects", []):
                effects.append(EffectData(
                    effect_type=e.get("effect_type"),
                    target_type=e.get("target_type"),
                    target_identifier=e.get("target_identifier"),
                    value=e.get("value"),
                    value_tag=e.get("value_tag"),
                    value_source=e.get("value_source"),
                    duration=e.get("duration"),
                    duration_type=e.get("duration_type"),
                    duration_tag=e.get("duration_tag"),
                    hit_count=e.get("hit_count"),
                    hit_count_tag=e.get("hit_count_tag"),
                    condition=e.get("condition"),
                    flags=e.get("flags", {}),
                    ignore_defense=e.get("ignore_defense", 0),
                    ignore_shield=e.get("ignore_shield", 0)
                ))
            blocks.append(EffectBlock(
                block_id=b.get("block_id"),
                effects=effects,
                condition=b.get("condition")
            ))
            
        skill = SkillData(
            skill_id=skill_id,
            name=raw.get("name"),
            skill_type=raw.get("skill_type"),
            resource_cost=raw.get("resource_cost"),
            effect_blocks=blocks,
            cooldown=raw.get("cooldown") or 0,
            display_target_type=raw.get("display_target_type"),
            display_target_range=raw.get("display_target_range"),
            display_target_priority=raw.get("display_target_priority"),
            features=raw.get("features", 0),
        )
        
        self.parsed_skills[skill_id] = skill
        return skill
    
    def get_skill_by_id(self, skill_id: int) -> Optional[SkillData]:
        """Alias for SkillService compatibility"""
        return self.get_skill_data(skill_id)

    def get_skill_tag_value(self, skill_id: int, tag: str, level: int) -> float:
        """计算技能Tag数值 (插值)"""
        sid_str = str(skill_id)
        if sid_str not in self.skill_tags:
            return 0.0
            
        tags_data = self.skill_tags[sid_str]
        if tag not in tags_data:
            return 0.0
            
        tag_info = tags_data[tag]
        values = tag_info.get("values", [])
        
        if not values:
            return 0.0
            
        # Find exact match or interpolate
        # Sort by level just in case
        values.sort(key=lambda x: x["level"])
        
        # 1. Exact match / Out of bounds
        if level <= values[0]["level"]:
            return float(values[0]["value"])
        if level >= values[-1]["level"]:
            return float(values[-1]["value"])
            
        # 2. Linear Interpolation
        lower = None
        upper = None
        
        for v in values:
            if v["level"] == level:
                return float(v["value"])
            if v["level"] < level:
                lower = v
            if v["level"] > level and upper is None:
                upper = v
                break
        
        if lower and upper:
            # y = y1 + (x - x1) * (y2 - y1) / (x2 - x1)
            x1, y1 = lower["level"], float(lower["value"])
            x2, y2 = upper["level"], float(upper["value"])
            return y1 + (level - x1) * (y2 - y1) / (x2 - x1)
            
        return 0.0

