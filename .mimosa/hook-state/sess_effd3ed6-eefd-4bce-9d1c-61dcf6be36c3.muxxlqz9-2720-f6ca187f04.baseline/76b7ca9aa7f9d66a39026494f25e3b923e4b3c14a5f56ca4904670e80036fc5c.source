"""
回归测试: global_condition在select_skill阶段提前过滤AS技能

Bug: 技能「逆転の方策」(120152)和「起死回生の一手」(130151)在持有单位拥有「深慮」标记时
会错误触发。AS技能120152被select_skill选中后，在execute_skill中才检查global_condition并跳过，
导致浪费行动（AP被消耗但无效果）。

修复: 在select_skill的AS选择循环中添加global_condition检查，跳过不满足条件的AS技能，
继续查找下一个可用AS技能。PS技能130151的trigger检查已在trigger_service中正确处理。

覆盖场景:
1. AS 120152 持有深慮时被跳过，选择下一个可用AS (120153)
2. AS 120152 无深慮时正常被选择
3. AS 120152 持有深慮且其他AS都在冷却时返回None (standby)
4. PS 130151 持有深慮时trigger_cumulative_damage不触发
5. PS 130151 无深慮时trigger_cumulative_damage正常触发
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join('..', '..', 'src'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

MARK = SkillEffectType.MARK.value


def _make_shinrui_mark() -> BuffState:
    """创建一个「深慮」mark buff"""
    return BuffState(
        buff_id="test_shinrui", name="深慮",
        effect_type=MARK, value=0,
        duration=-1, timing_type=1,
    )


class TestGlobalConditionSelectSkill(unittest.TestCase):
    """global_condition在select_skill阶段的提前过滤测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 146301 タチアナ (风属性, EN型, 后排)
        # 技能列表: [110068(EX), 120151(AS1), 120152(AS2), 120153(AS3), 130151(PS)]
        self.caster = UnitState(
            unit_id="ally_back", name="タチアナ", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=146301, level=10,
            element=3, character_type=2,
            max_hp=15000, current_hp=15000,
            attack=10000, defense=4000, speed=480,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=8,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110068, 120151, 120152, 120153, 130151],
            skill_levels={110068: 10, 120151: 10, 120152: 10, 120153: 10, 130151: 10},
            skill_cooldowns={},
        )

        # 敌方前排 (确保有存活敌方)
        self.enemy = UnitState(
            unit_id="enemy_front", name="敌方前排", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=9000, defense=5000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    # ─── AS select_skill 测试 ───

    def test_as_120152_skipped_when_deep_thought_mark_present(self):
        """持有深慮mark时select_skill跳过120152，选择下一个可用AS(120153)"""
        # 给caster施加深慮mark
        self.caster.buffs.append(_make_shinrui_mark())
        # 120151设为冷却（使select_skill跳过120151，到达120152）
        self.caster.skill_cooldowns = {120151: 1}
        # EP=0确保不选EX
        self.caster.current_ep = 0

        selected = self.ss.select_skill(self.caster)
        # 应跳过120152(global_condition不满足)，选择120153
        self.assertEqual(selected, 120153,
                         "持有深慮时应跳过120152，选择下一个可用AS 120153")

    def test_as_120152_selected_when_no_deep_thought_mark(self):
        """无深慮mark时select_skill正常选择120152"""
        # 确保无深慮mark
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]
        # 120151设为冷却
        self.caster.skill_cooldowns = {120151: 1}
        self.caster.current_ep = 0

        selected = self.ss.select_skill(self.caster)
        # 无深慮时120152的global_condition满足，应被选择
        self.assertEqual(selected, 120152,
                         "无深慮时120152应被正常选择")

    def test_as_all_skipped_returns_none_when_deep_thought_mark(self):
        """持有深慮mark且其他AS都在冷却时select_skill返回None(standby)"""
        self.caster.buffs.append(_make_shinrui_mark())
        # 120151和120153都设为冷却，仅120152可用但被global_condition阻止
        self.caster.skill_cooldowns = {120151: 1, 120153: 1}
        self.caster.current_ep = 0

        selected = self.ss.select_skill(self.caster)
        # 120152被global_condition阻止，其他AS冷却中，应返回None
        self.assertIsNone(selected,
                          "持有深慮且其他AS冷却中时应返回None(standby)，而非浪费行动选120152")

    def test_as_120152_first_when_no_mark_no_cooldown(self):
        """无深慮mark且无冷却时select_skill选择第一个AS(120151)"""
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]
        self.caster.skill_cooldowns = {}
        self.caster.current_ep = 0

        selected = self.ss.select_skill(self.caster)
        # 120151是第一个AS，应被选择
        self.assertEqual(selected, 120151,
                         "无深慮无冷却时第一个AS 120151应被选择")

    # ─── PS trigger_cumulative_damage 测试 ───

    def test_ps_130151_not_triggered_when_deep_thought_mark_present(self):
        """持有深慮mark时PS 130151的trigger检查阻止触发"""
        self.caster.buffs.append(_make_shinrui_mark())
        # 累计伤害 >= 20% max_hp（阈值已超过，靠深慮mark阻止触发）
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.25)
        # 确保PS不在冷却
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        # 持有深慮时self_lacks_mark条件不满足，不应触发130151
        triggered_130151 = [a for a in actions if a.skill_id == 130151]
        self.assertEqual(len(triggered_130151), 0,
                         "持有深慮时PS 130151不应被触发")

    def test_ps_130151_triggered_when_no_deep_thought_mark(self):
        """无深慮mark时PS 130151正常触发"""
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]
        # 累计伤害 >= 20% max_hp
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.25)
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        # 无深慮时self_lacks_mark条件满足，应触发130151
        triggered_130151 = [a for a in actions if a.skill_id == 130151]
        self.assertGreater(len(triggered_130151), 0,
                           "无深慮时PS 130151应被触发")

    def test_ps_130151_not_triggered_below_threshold(self):
        """累计伤害未达阈值时不触发PS 130151"""
        self.caster.buffs = [b for b in self.caster.buffs
                             if not (b.effect_type == MARK and getattr(b, 'name', '') == "深慮")]
        # 累计伤害 < 20% max_hp
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.05)
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.caster])
        triggered_130151 = [a for a in actions if a.skill_id == 130151]
        self.assertEqual(len(triggered_130151), 0,
                         "累计伤害未达阈值时PS 130151不应被触发")


if __name__ == '__main__':
    unittest.main()
