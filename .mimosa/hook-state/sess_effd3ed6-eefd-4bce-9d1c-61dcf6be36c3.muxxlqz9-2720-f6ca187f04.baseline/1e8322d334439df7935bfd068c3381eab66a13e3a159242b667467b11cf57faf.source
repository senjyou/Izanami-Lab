#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""复现脚本：代助一避+アイギスランパード同时触发时，代助一避结果丢失"""

import sys, os
sys.path.insert(0, os.path.dirname(__file__))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.enums import Position, Side, SkillType
from src.entities_v2.battlefield_state import BattlefieldState
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.skill_data_resolver import SkillDataResolver

import logging
logging.basicConfig(level=logging.INFO, format="[%(levelname)-5s] %(message)s", stream=sys.stdout)

def main():
    data_loader = DataLoader()
    data_loader.load_all()

    bf = BattlefieldState()

    # ノーブル・グレイス - character_id=111201 (有アイギスランパード)
    noble = UnitState(
        unit_id="ally_1", name="ノーブル・グレイス", side=Side.ALLY,
        position=Position.ALLY_LEFT_FRONT, character_id=111201, level=80,
        element=0, character_type=1,
        max_hp=112464, current_hp=112464,
        attack=101521, defense=55688, speed=1261, crit_rate=0.2, crit_damage=1.5,
        advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=6,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[],  # 由character_id自动加载
        skill_levels={},
        skill_cooldowns={}, role_type=1, position_type=1,
    )

    # 混沌の立役者 - character_id=111301 (有代助一避)
    chaos = UnitState(
        unit_id="ally_3", name="混沌の立役者", side=Side.ALLY,
        position=Position.ALLY_LEFT_BACK, character_id=111301, level=80,
        element=2, character_type=1,
        max_hp=132990, current_hp=132990,
        attack=82869, defense=79872, speed=999, crit_rate=0.2, crit_damage=1.5,
        advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=8,
        current_ap=4, current_pp=2, current_ep=2,
        skills=[],
        skill_levels={},
        skill_cooldowns={}, role_type=1, position_type=3,
    )

    # フィー・ドレーゼ
    fee = UnitState(
        unit_id="enemy_1", name="フィー・ドレーゼ", side=Side.ENEMY,
        position=Position.ENEMY_CENTER_BACK, character_id=220105, level=1,
        element=3, character_type=1,
        max_hp=474374, current_hp=474374,
        attack=17260, defense=8408, speed=649, crit_rate=0.21, crit_damage=1.5,
        advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=7,
        current_ap=4, current_pp=2, current_ep=2,
        skills=[220105],
        skill_levels={220105: 15},
        skill_cooldowns={}, role_type=1, position_type=3,
    )

    bf.add_unit(noble)
    bf.add_unit(chaos)
    bf.add_unit(fee)

    # 创建服务
    resource_svc = ResourceService()
    damage_svc = DamageService()
    target_svc = TargetService()
    aura_svc = AuraService()
    trigger_svc = TriggerService()
    trigger_svc.set_data_loader(data_loader)

    skill_svc = SkillService(data_loader, resource_svc,
                             target_service=target_svc,
                             damage_service=damage_svc,
                             aura_service=aura_svc,
                             trigger_service=trigger_svc)
    trigger_svc.set_skill_service(skill_svc)

    # 测试 trigger_before_enemy_as_attack
    print("\n" + "="*60)
    print("测试1: trigger_before_enemy_as_attack")
    print("="*60)
    targets = [noble]
    actions = trigger_svc.trigger_before_enemy_as_attack(fee, 220105, targets, bf)
    print(f"返回 {len(actions)} 个action")
    for a in actions:
        owner = a.instance.owner
        print(f"  skill_id={a.skill_id} owner={owner.name}")

    # 测试 trigger_before_any_attacked
    print("\n" + "="*60)
    print("测试2: trigger_before_any_attacked")
    print("="*60)
    actions2 = trigger_svc.trigger_before_any_attacked(targets, bf)
    print(f"返回 {len(actions2)} 个action")
    for a in actions2:
        owner = a.instance.owner
        print(f"  skill_id={a.skill_id} owner={owner.name}")

    # 完整技能执行
    print("\n" + "="*60)
    print("测试3: 完整技能执行 - カーテンショット")
    print("="*60)
    result = skill_svc.execute_skill(fee, 220105, bf)
    print(f"\nexecute_skill 结果: success={result.get('success')}")
    print(f"inline_ps_results: {len(result.get('inline_ps_results', []))}")
    for ps in result.get('inline_ps_results', []):
        print(f"  PS: owner={ps['owner'].name} skill={ps['skill_name']} timing={ps.get('trigger_timing')}")
    
    # 检查ノーブル・グレイス是否有Evade buff
    print(f"\nノーブル・グレイス buffs: {[b.effect_type for b in noble.buffs]}")
    print(f"フィー・ドレーゼ buffs: {[b.effect_type for b in fee.buffs]}")

if __name__ == "__main__":
    main()
