#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
分析未解析的敌方技能 (ID 以 2 开头)
"""

import sys
import json
from pathlib import Path

# 添加项目根目录到Python路径
sys.path.insert(0, str(Path(__file__).parent.parent.parent))

from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()

def main():
    safe_print("开始分析敌方技能解析失败情况...")
    
    # 1. 加载所有 parsed 数据
    parsed_path = Path("data/skill_effects_hybrid.json")
    if not parsed_path.exists():
        safe_print(f"Error: {parsed_path} not found")
        return
        
    with open(parsed_path, 'r', encoding='utf-8') as f:
        parsed_data = json.load(f)
        
    # 2. 加载原始 SkillMaster 数据
    master_path = Path("split_data/SkillMaster.json")
    if not master_path.exists():
        safe_print(f"Error: {master_path} not found")
        return
        
    with open(master_path, 'r', encoding='utf-8') as f:
        skill_master = json.load(f)
    
    # 3. 筛选敌方技能 (2xxxxx)
    target_skills = {}
    for skill in skill_master:
        sid = str(skill.get("Id"))
        if sid.startswith("2"):
            target_skills[sid] = skill
    
    safe_print(f"Total Enemy Skills: {len(target_skills)}")
    
    failed_skills = []
    
    # 4. 检查解析情况并输出
    with open("analysis_results.txt", "w", encoding='utf-8') as f:
        f.write(f"Total Enemy Skills: {len(target_skills)}\n\n")
        f.write("--- Failed Enemy Skills ---\n\n")
        
        for sid, data in target_skills.items():
            # Check if parsing failed
            # Note: parsed_data keys are strings
            if sid not in parsed_data:
                failed_skills.append((sid, data))
                
                name = data.get("Name", "Unknown")
                desc_templates = data.get("DescriptionTemplates", [])
                description = desc_templates[0].get("Template", "No Description") if desc_templates else "No Description"
                
                f.write(f"ID: {sid}\n")
                f.write(f"Name: {name}\n")
                f.write(f"Desc: {description}\n")
                f.write("-" * 40 + "\n")
        
        f.write(f"\nTotal Failed: {len(failed_skills)}\n")
        
    safe_print(f"Analysis complete. Found {len(failed_skills)} failures.")
    safe_print("Results written to analysis_results.txt")

if __name__ == "__main__":
    main()
