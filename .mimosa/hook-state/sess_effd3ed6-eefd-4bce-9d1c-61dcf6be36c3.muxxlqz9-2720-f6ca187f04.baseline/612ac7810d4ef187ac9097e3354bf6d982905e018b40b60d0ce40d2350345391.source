"""
角色148301 譜代武家・篁家次期当主（唯依）专项测试
- EX: 110063 天崩（移除目标护盾 + HP比例穿甲(最高50%)攻击）
- AS1: 120140 貪狼（3hit攻击 + 30%吸血 + PP≥3时削减2PP）
- AS2: 120141 破衝（暴击时赋予dmg_dealt_down(25%)+剣気，有剣気时威力切换，攻击后解除剣気，Lv11+暴击率提升）
- PS1: 130142 掩撃（己方被后排敌方AS/PS攻击后反击 + 与伤害降低10%(可叠加)）
- PS2: 130143 反魂（累计伤害≥30%最大HP时触发，攻击HP最低敌方，击杀时回复，Lv11+1block盾）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
