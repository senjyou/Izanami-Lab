SHIELD = SkillEffectType.SHIELD.value
MARK = SkillEffectType.MARK.value
CRIT_RATE_UP = SkillEffectType.STATUS_CRITICAL_CHANCE.value
PENETRATE_DEFENSE = SkillEffectType.PENETRATE_DEFENSE.value


