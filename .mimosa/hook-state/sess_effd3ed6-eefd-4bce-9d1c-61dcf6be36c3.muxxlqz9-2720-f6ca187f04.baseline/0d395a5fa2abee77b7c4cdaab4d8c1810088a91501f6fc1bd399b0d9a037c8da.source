#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
迁移CharacterSkillMaster.json到数据库

功能:
- 迁移character_skills表（角色-技能映射）
"""

import sys
import json
import sqlite3
from pathlib import Path
from collections import defaultdict

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()

PROJECT_ROOT = Path(__file__).parent.parent
DB_FILE = PROJECT_ROOT / "db" / "skill_data.db"
CHARACTER_SKILL_FILE = PROJECT_ROOT / "split_data" / "CharacterSkillMaster.json"


def main():
    """主函数"""
    safe_print("="*80)
    safe_print("Migrating CharacterSkillMaster.json to Database")
    safe_print("="*80)
    
    # 加载JSON数据
    safe_print(f"\nLoading data from: {CHARACTER_SKILL_FILE}")
    with open(CHARACTER_SKILL_FILE, 'r', encoding='utf-8') as f:
        data = json.load(f)
    
    safe_print(f"Loaded {len(data)} records")
    
    # 组织数据：按角色分组
    char_skills = defaultdict(list)
    for record in data:
        char_id = record['CharacterMasterId']
        skill_id = record['SkillMasterId']
        char_skills[char_id].append(skill_id)
    
    safe_print(f"Found {len(char_skills)} characters with skills")
    
    # 连接数据库
    safe_print(f"\nConnecting to database: {DB_FILE}")
    conn = sqlite3.connect(DB_FILE)
    cursor = conn.cursor()
    
    # 迁移数据
    safe_print("\nMigrating character_skills table...")
    count = 0
    skipped = 0
    
    for char_id, skill_ids in char_skills.items():
        # Skip character existence check - characters table is in character_stats.db
        # We only validate skills exist in this database
        # cursor.execute("SELECT character_id FROM characters WHERE character_id = ?", (char_id,))
        # if not cursor.fetchone():
        #     safe_print(f"  Warning: Character {char_id} not found, skipping")
        #     skipped += 1
        #     continue
        
        # 为技能排序（按skill_id）
        skill_ids.sort()
        
        for skill_id in skill_ids:
            # 检查技能是否存在
            cursor.execute("SELECT skill_id FROM skills WHERE skill_id = ?", (skill_id,))
            if not cursor.fetchone():
                safe_print(f"  Warning: Skill {skill_id} not found for character {char_id}")
                continue
            
            try:
                # character_skills表有id, character_id, skill_id, skill_order四个字段
                # skill_order表示技能在角色技能列表中的顺序
                cursor.execute("""
                    INSERT OR REPLACE INTO character_skills
                    (character_id, skill_id, skill_order)
                    VALUES (?, ?, ?)
                """, (char_id, skill_id, skill_ids.index(skill_id) + 1))
                count += 1
            except Exception as e:
                safe_print(f"  Error: {e}")
        
        if count % 50 == 0:
            safe_print(f"  Processed {len([k for k in char_skills.keys() if k <= char_id])} characters...")
            conn.commit()
    
    conn.commit()
    
    # 验证
    safe_print("\n" + "="*80)
    safe_print("Migration Summary")
    safe_print("="*80)
    
    cursor.execute("SELECT COUNT(*) FROM character_skills")
    db_count = cursor.fetchone()[0]
    
    cursor.execute("SELECT COUNT(DISTINCT character_id) FROM character_skills")
    char_count = cursor.fetchone()[0]
    
    safe_print(f"Character-Skill Mappings: {db_count}")
    safe_print(f"Characters with Skills:   {char_count}")
    safe_print(f"Skipped Characters:       {skipped}")
    
    # 示例查询
    safe_print("\n" + "-"*80)
    safe_print("Sample: Character 110301 Skills")
    safe_print("-"*80)
    
    cursor.execute("""
        SELECT s.skill_id, s.name, est.code
        FROM character_skills cs
        JOIN skills s ON cs.skill_id = s.skill_id
        JOIN enum_skill_types est ON s.skill_type_id = est.skill_type_id
        WHERE cs.character_id = 110301
        ORDER BY cs.id
    """)
    
    rows = cursor.fetchall()
    for i, (skill_id, name, skill_type) in enumerate(rows, 1):
        safe_print(f"  {i}. [{skill_type}] {skill_id} - {name}")
    
    conn.close()
    
    safe_print("\n" + "="*80)
    safe_print("Migration complete!")
    safe_print("="*80)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        safe_print(f"\nERROR: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)
