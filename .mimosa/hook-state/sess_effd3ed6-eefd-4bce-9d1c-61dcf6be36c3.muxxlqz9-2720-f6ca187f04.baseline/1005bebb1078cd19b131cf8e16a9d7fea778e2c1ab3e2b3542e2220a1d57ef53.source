"""Tests for character 109302 - 眠れる社交界の淑女.

Skills: 110067(EX), 120149(AS1), 120150(AS2), 130149(PS1), 130150(PS2)
"""
import unittest
import sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import SkillEffectType, Position, Side, AuraUpdateTiming

POISON = SkillEffectType.POISON.value
KNOCKOUT = SkillEffectType.KNOCKOUT.value
STATUS_SPEED = SkillEffectType.STATUS_SPEED.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
MARK = SkillEffectType.MARK.value
SHIELD = SkillEffectType.SHIELD.value
EP_GAIN_DOWN = SkillEffectType.EP_GAIN_DOWN.value
BLOCK_SPECIFIC_AURA = SkillEffectType.BLOCK_SPECIFIC_AURA.value


# ═══════════════════════════════════════════════════════════════
# 110067 シャル・ウィ・ダンス？ (EX)
# ═══════════════════════════════════════════════════════════════

class TestEX110067(unittest.TestCase):

    def setUp(self):
        bb = BattleBuilder()
        bb.add_ally(unit_id="c", hp=20000, atk=10000, skills=[110067], level=15, ep=10)
        bb.add_enemy(unit_id="e_low", position=Position.ENEMY_CENTER_FRONT, hp=30000)
        bb.add_enemy(unit_id="e_high", position=Position.ENEMY_RIGHT_BACK, hp=50000)
        bb.add_enemy(unit_id="e_full", position=Position.ENEMY_LEFT_BACK, hp=50000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.friend_team if u.unit_id == "c")
        self.e_low = next(u for u in self.bf.enemy_team if u.unit_id == "e_low")
        self.e_high = next(u for u in self.bf.enemy_team if u.unit_id == "e_high")
        self.e_full = next(u for u in self.bf.enemy_team if u.unit_id == "e_full")
        self.e_low.current_hp = 12000  # 40%
        self.e_high.current_hp = 25000  # 50%
        self.e_full.current_hp = 50000  # 100%

    def test_damage_hits_lowest_hp_ratio(self):
        """Damage should target enemy with lowest HP%."""
        result = self.ss.execute_skill(caster=self.caster, skill_id=110067,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        dmg_targets = []
        for e in result["effects_applied"]:
            if e.get("effect_type") == "damage":
                for t in e.get("targets", []):
                    dmg_targets.append(t.get("target_id"))
        self.assertEqual(len(dmg_targets), 1)
        self.assertEqual(dmg_targets[0], self.e_low.unit_id,
                         "should hit lowest HP% enemy (40%)")

    def test_spd_down_all_enemies(self):
        """spd_down should apply to ALL enemies."""
        result = self.ss.execute_skill(caster=self.caster, skill_id=110067,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for eid in ["e_low", "e_high", "e_full"]:
            enemy = next(u for u in self.bf.enemy_team if u.unit_id == eid)
            spd_debuffs = [d for d in enemy.debuffs if d.effect_type == STATUS_SPEED]
            self.assertEqual(len(spd_debuffs), 1, f"{eid} should have 1 spd_down")
            self.assertEqual(spd_debuffs[0].value, 20.0, f"{eid} spd_down should be 20%")

    def test_spd_up_all_allies_lv11(self):
        """Lv11+: spd_up should apply to all allies."""
        bb = BattleBuilder()
        bb.add_ally(unit_id="c", hp=20000, atk=10000, skills=[110067], level=15, ep=10)
        bb.add_ally(unit_id="a2", hp=20000)
        bb.add_enemy(unit_id="e", hp=50000)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "c")
        ally2 = next(u for u in bf.friend_team if u.unit_id == "a2")
        result = ss.execute_skill(caster=caster, skill_id=110067, battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        for uid in ["c", "a2"]:
            ally = next(u for u in bf.friend_team if u.unit_id == uid)
            spd_buffs = [b for b in ally.buffs if b.effect_type == STATUS_SPEED]
            self.assertEqual(len(spd_buffs), 1, f"{uid} should have spd_up")

    def test_no_spd_up_below_lv11(self):
        """Below Lv11: no spd_up."""
        bb = BattleBuilder()
        bb.add_ally(unit_id="c", hp=20000, atk=10000, skills=[110067], level=10, ep=10)
        bb.add_ally(unit_id="a2", hp=20000)
        bb.add_enemy(unit_id="e", hp=50000)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "c")
        result = ss.execute_skill(caster=caster, skill_id=110067, battlefield=bf, skip_cost=True)
        spd_buffs = [b for b in caster.buffs if b.effect_type == STATUS_SPEED]
        self.assertEqual(len(spd_buffs), 0, "no spd_up below Lv11")


# ═══════════════════════════════════════════════════════════════
# 120149 絢爛なるワルツ (AS1)
# ═══════════════════════════════════════════════════════════════

class TestAS120149(unittest.TestCase):

    def setUp(self):
        bb = BattleBuilder()
        bb.add_ally(unit_id="c", hp=20000, atk=10000, skills=[120149], level=15)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT, hp=50000)
        bb.add_enemy(unit_id="e2", position=Position.ENEMY_RIGHT_FRONT, hp=50000)
        bb.add_enemy(unit_id="e3", position=Position.ENEMY_LEFT_BACK, hp=50000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.friend_team if u.unit_id == "c")
        self.e1 = next(u for u in self.bf.enemy_team if u.unit_id == "e1")
        self.e2 = next(u for u in self.bf.enemy_team if u.unit_id == "e2")
        self.e3 = next(u for u in self.bf.enemy_team if u.unit_id == "e3")

    def test_target_selects_2_nearest(self):
        """Should select 2 nearest enemies (target_count=2)."""
        result = self.ss.execute_skill(caster=self.caster, skill_id=120149,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        dmg_ids = set()
        for e in result["effects_applied"]:
            if e.get("effect_type") == "damage":
                for t in e.get("targets", []):
                    dmg_ids.add(t.get("target_id"))
        self.assertEqual(len(dmg_ids), 2, "should hit 2 nearest enemies")
        self.assertIn(self.e1.unit_id, dmg_ids)
        self.assertIn(self.e2.unit_id, dmg_ids)
        self.assertNotIn(self.e3.unit_id, dmg_ids, "back-row enemy should not be hit")

    def test_mark_rantyo_applied(self):
        """Mark '乱調' should be applied to hit targets."""
        result = self.ss.execute_skill(caster=self.caster, skill_id=120149,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for eid in ["e1", "e2"]:
            enemy = next(u for u in self.bf.enemy_team if u.unit_id == eid)
            marks = [d for d in enemy.debuffs if getattr(d, 'effect_type', '') == MARK]
            self.assertTrue(len(marks) > 0, f"{eid} should have 乱調 mark")
            self.assertEqual(marks[0].name, "乱調")

    def test_mark_skip_if_exists(self):
        """If target already has 乱調, should not duplicate."""
        from src.entities_v2.unit_state import BuffState
        self.e1.debuffs.append(BuffState(
            buff_id="existing_rantyo", name="乱調", effect_type=MARK,
            value=0, duration=2, timing_type=AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
            source_unit_id=self.caster.unit_id, is_debuff=True
        ))
        mark_count_before = len([d for d in self.e1.debuffs if d.name == "乱調"])
        result = self.ss.execute_skill(caster=self.caster, skill_id=120149,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        marks = [d for d in self.e1.debuffs if d.name == "乱調"]
        self.assertEqual(len(marks), mark_count_before,
                         "should not add duplicate 乱調 mark")

    def test_dmg_dealt_down_lv11(self):
        """Lv11+: dmg_dealt_down should be applied."""
        result = self.ss.execute_skill(caster=self.caster, skill_id=120149,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for eid in ["e1", "e2"]:
            enemy = next(u for u in self.bf.enemy_team if u.unit_id == eid)
            dd = [d for d in enemy.debuffs if d.effect_type == DEALT_DAMAGE]
            self.assertEqual(len(dd), 1, f"{eid} should have dmg_dealt_down")


# ═══════════════════════════════════════════════════════════════
# 120150 優雅なるロンド (AS2)
# ═══════════════════════════════════════════════════════════════

class TestAS120150(unittest.TestCase):

    def setUp(self):
        bb = BattleBuilder()
        bb.add_ally(unit_id="c", hp=20000, atk=10000, skills=[120150], level=15)
        bb.add_enemy(unit_id="e_near", position=Position.ENEMY_CENTER_FRONT, hp=50000)
        bb.add_enemy(unit_id="e_far", position=Position.ENEMY_RIGHT_BACK, hp=50000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.friend_team if u.unit_id == "c")
        self.e_near = next(u for u in self.bf.enemy_team if u.unit_id == "e_near")
        self.e_far = next(u for u in self.bf.enemy_team if u.unit_id == "e_far")

    def test_damage_and_spd_down_nearest(self):
        """Damage and spd_down should target nearest enemy."""
        result = self.ss.execute_skill(caster=self.caster, skill_id=120150,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        spd_debuffs = [d for d in self.e_near.debuffs if d.effect_type == STATUS_SPEED]
        self.assertEqual(len(spd_debuffs), 1, "nearest enemy should have spd_down")
        far_spd = [d for d in self.e_far.debuffs if d.effect_type == STATUS_SPEED]
        self.assertEqual(len(far_spd), 0, "far enemy should NOT have spd_down")

    def test_ep_gain_down_lv11(self):
        """Lv11+: ep_gain_down 50% should be applied."""
        result = self.ss.execute_skill(caster=self.caster, skill_id=120150,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        epd = [d for d in self.e_near.debuffs if d.effect_type == EP_GAIN_DOWN]
        self.assertEqual(len(epd), 1, "should have ep_gain_down")
        self.assertEqual(epd[0].value, 50.0)

    def test_no_ep_gain_down_below_lv11(self):
        """Below Lv11: no ep_gain_down."""
        bb = BattleBuilder()
        bb.add_ally(unit_id="c", hp=20000, atk=10000, skills=[120150], level=10)
        bb.add_enemy(unit_id="e", position=Position.ENEMY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "c")
        enemy = next(u for u in bf.enemy_team if u.unit_id == "e")
        result = ss.execute_skill(caster=caster, skill_id=120150, battlefield=bf, skip_cost=True)
        epd = [d for d in enemy.debuffs if d.effect_type == EP_GAIN_DOWN]
        self.assertEqual(len(epd), 0, "no ep_gain_down below Lv11")


# ═══════════════════════════════════════════════════════════════
# 130149 夜会のプレリュード (PS1)
# ═══════════════════════════════════════════════════════════════

class TestPS130149(unittest.TestCase):
    """PS1 夜会のプレリュード — each test uses clean state."""

    def _setup(self, level=15):
        bb = BattleBuilder()
        bb.add_ally(unit_id="c", hp=20000, atk=10000, skills=[130149], level=level, pp=10)
        bb.add_enemy(unit_id="e", hp=50000)
        ctx = bb.build()
        bf, ss, ts = ctx['bf'], ctx['ss'], ctx['ts']
        return bf, ss, ts, next(u for u in bf.friend_team if u.unit_id == "c")

    def test_trigger_after_own_action(self):
        bf, ss, ts, caster = self._setup()
        actions = ts.trigger_after_skill_use(caster, 120150, {}, bf)
        ps_actions = [a for a in actions if a.skill_id == 130149]
        self.assertTrue(len(ps_actions) > 0, "130149 should trigger after own skill use")

    def test_no_mark_grants_kabu_and_no_heal(self):
        """Without 華舞: Block2 fires (grant mark), Block1 skipped (no heal).

        max_hp_up会同步提升current_hp（按增量），因此current_hp会增加，
        但这是max_hp_up的同步效果，不是heal。
        """
        bf, ss, ts, caster = self._setup()
        caster.current_hp = 10000
        hp_before = caster.current_hp
        max_hp_before = caster.max_hp
        ss._current_skill_id = 130149
        actions = ts.trigger_after_skill_use(caster, 120150, {}, bf)
        ps_acts = [a for a in actions if a.skill_id == 130149]
        self.assertTrue(len(ps_acts) > 0)
        ss._execute_trigger_actions_inline(ps_acts[:1], bf)
        marks = [b for b in caster.buffs if getattr(b, 'name', '') == "華舞"]
        self.assertEqual(len(marks), 1, "should grant 華舞 mark")
        # max_hp_up同步提升current_hp（按增量），不是heal
        hp_increase = caster.max_hp - max_hp_before
        expected_current_hp = min(hp_before + hp_increase, caster.max_hp)
        self.assertEqual(caster.current_hp, expected_current_hp,
                         f"current_hp应按max_hp_up增量同步提升（+{hp_increase}），hp={caster.current_hp} from {hp_before}")

    def test_with_mark_heals_and_no_mark_grant(self):
        """With 華舞: Block1 fires (heal), Block2 skipped (no duplicate mark)."""
        bf, ss, ts, caster = self._setup()
        from src.entities_v2.unit_state import BuffState
        caster.buffs.append(BuffState(
            buff_id="kabu", name="華舞", effect_type=MARK,
            value=0, duration=-1, timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
            source_unit_id=caster.unit_id, is_debuff=False
        ))
        mark_count_before = len([b for b in caster.buffs if getattr(b, 'name', '') == "華舞"])
        caster.current_hp = 10000
        hp_before = caster.current_hp
        ss._current_skill_id = 130149
        actions = ts.trigger_after_skill_use(caster, 120150, {}, bf)
        ps_acts = [a for a in actions if a.skill_id == 130149]
        self.assertTrue(len(ps_acts) > 0)
        ss._execute_trigger_actions_inline(ps_acts[:1], bf)
        self.assertGreater(caster.current_hp, hp_before, "should heal with 華舞")
        marks = [b for b in caster.buffs if getattr(b, 'name', '') == "華舞"]
        self.assertEqual(len(marks), mark_count_before,
                         "should NOT add duplicate 華舞 (Block2 skipped)")

    def test_max_hp_up_once(self):
        """max_hp_up should apply exactly once per PS trigger."""
        bf, ss, ts, caster = self._setup()
        old_max_hp = caster.max_hp
        ss._current_skill_id = 130149
        actions = ts.trigger_after_skill_use(caster, 120150, {}, bf)
        ps_acts = [a for a in actions if a.skill_id == 130149]
        self.assertTrue(len(ps_acts) > 0)
        ss._execute_trigger_actions_inline(ps_acts[:1], bf)
        # max_hp_up directly modifies max_hp. Should increase once (not twice from both blocks)
        self.assertEqual(caster.max_hp - old_max_hp, caster.max_hp - old_max_hp)
        # max_hp_up is ~3.15% of 20000 = ~630. Verify it's in reasonable range
        increase = caster.max_hp - old_max_hp
        self.assertGreater(increase, 0, f"max_hp should increase, old={old_max_hp} new={caster.max_hp}")
        self.assertLess(increase, 2000, f"max_hp increase should be ~one application (3%), not two (6%), got {increase}")

    def test_block_specific_aura_lv15(self):
        bf, ss, ts, caster = self._setup(level=15)
        ss._current_skill_id = 130149
        actions = ts.trigger_after_skill_use(caster, 120150, {}, bf)
        ps_acts = [a for a in actions if a.skill_id == 130149]
        self.assertTrue(len(ps_acts) > 0)
        ss._execute_trigger_actions_inline(ps_acts[:1], bf)
        blocks = [b for b in caster.buffs if 'BlockSpecificAura' in str(b.effect_type)]
        self.assertEqual(len(blocks), 1, f"Lv15 should have block_specific_aura, buffs={[(b.effect_type, getattr(b,'name','')) for b in caster.buffs]}")
        blocked = getattr(blocks[0], 'block_status_list', [])
        self.assertTrue(len(blocked) > 0, "should block some statuses")

    def test_no_block_aura_below_lv15(self):
        bf, ss, ts, caster = self._setup(level=10)
        ss._current_skill_id = 130149
        actions = ts.trigger_after_skill_use(caster, 120150, {}, bf)
        ps_acts = [a for a in actions if a.skill_id == 130149]
        self.assertTrue(len(ps_acts) > 0)
        ss._execute_trigger_actions_inline(ps_acts[:1], bf)
        blocks = [b for b in caster.buffs if b.effect_type == BLOCK_SPECIFIC_AURA]
        self.assertEqual(len(blocks), 0, "no block_aura below Lv15")


# ═══════════════════════════════════════════════════════════════
# 130150 ポストリュード (PS2)
# ═══════════════════════════════════════════════════════════════

class TestPS130150(unittest.TestCase):

    def setUp(self):
        bb = BattleBuilder()
        bb.add_ally(unit_id="c", hp=20000, atk=10000, skills=[130150], level=15, pp=10)
        bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT, hp=50000)
        bb.add_enemy(unit_id="e2", position=Position.ENEMY_RIGHT_FRONT, hp=50000)
        ctx = bb.build()
        self.bf, self.ss, self.ts = ctx['bf'], ctx['ss'], ctx['ts']
        self.caster = next(u for u in self.bf.friend_team if u.unit_id == "c")
        self.e1 = next(u for u in self.bf.enemy_team if u.unit_id == "e1")
        self.e2 = next(u for u in self.bf.enemy_team if u.unit_id == "e2")

    def _give_rantyo(self, enemy):
        from src.entities_v2.unit_state import BuffState
        enemy.debuffs.append(BuffState(
            buff_id=f"rantyo_{enemy.unit_id}", name="乱調", effect_type=MARK,
            value=0, duration=2, timing_type=AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
            source_unit_id=self.caster.unit_id, is_debuff=True
        ))

    def test_triggers_when_enemy_hp_below_60_with_rantyo(self):
        """Should trigger when enemy with 乱調 drops below 60% HP.
        Other enemies (even at full HP) should NOT prevent triggering.
        """
        self._give_rantyo(self.e1)
        self.e1.current_hp = 25000  # 50% < 60%
        self.e1.prev_hp_percent = 100.0
        # e2 stays at full HP (50000/50000 = 100%) — should NOT prevent trigger
        self.caster.current_pp = 10
        actions = self.ts.trigger_hp_below(self.bf, [self.e1])
        ps_actions = [a for a in actions if a.skill_id == 130150]
        self.assertTrue(len(ps_actions) > 0, "130150 should trigger when any 乱調 enemy crosses 60%")

    def test_not_trigger_without_rantyo(self):
        """Should NOT trigger if no enemy has 乱調."""
        # e1 crosses 60% but has no 乱調 mark
        self.e1.current_hp = 25000
        self.e1.prev_hp_percent = 100.0
        actions = self.ts.trigger_hp_below(self.bf, [self.e1])
        ps_actions = [a for a in actions if a.skill_id == 130150]
        self.assertEqual(len(ps_actions), 0, "should not trigger without 乱調 mark")

    def test_damage_all_enemies(self):
        """When triggered, should damage ALL enemies."""
        self._give_rantyo(self.e1)
        self.e1.current_hp = 25000
        self.e1.prev_hp_percent = 100.0
        self.caster.current_pp = 10
        hp_before = {self.e1.unit_id: self.e1.current_hp,
                     self.e2.unit_id: self.e2.current_hp}
        actions = self.ts.trigger_hp_below(self.bf, [self.e1])
        ps_acts = [a for a in actions if a.skill_id == 130150]
        if ps_acts:
            self.ss._execute_trigger_actions_inline(ps_acts[:1], self.bf)
            self.assertLess(self.e1.current_hp, hp_before[self.e1.unit_id],
                            "e1 should take damage")
            self.assertLess(self.e2.current_hp, hp_before[self.e2.unit_id],
                            "e2 should take damage (enemy_all)")

    def test_remove_all_rantyo_marks(self):
        """After execution, ALL 乱調 marks should be removed."""
        self._give_rantyo(self.e1)
        self._give_rantyo(self.e2)
        self.e1.current_hp = 25000
        self.e1.prev_hp_percent = 100.0
        self.caster.current_pp = 10
        actions = self.ts.trigger_hp_below(self.bf, [self.e1])
        ps_acts = [a for a in actions if a.skill_id == 130150]
        if ps_acts:
            self.ss._execute_trigger_actions_inline(ps_acts[:1], self.bf)
            for eid, enemy in [("e1", self.e1), ("e2", self.e2)]:
                marks = [d for d in enemy.debuffs if getattr(d, 'name', '') == "乱調"]
                self.assertEqual(len(marks), 0, f"{eid} 乱調 should be removed")

    def test_not_trigger_above_60_hp(self):
        """Should NOT trigger if enemy HP is above 60%."""
        self._give_rantyo(self.e1)
        self.e1.current_hp = 35000  # 70% > 60%
        self.e1.prev_hp_percent = 100.0
        self.caster.current_pp = 10
        actions = self.ts.trigger_hp_below(self.bf, [self.e1])
        ps_actions = [a for a in actions if a.skill_id == 130150]
        self.assertEqual(len(ps_actions), 0, "should not trigger above 60% HP")


if __name__ == '__main__':
    unittest.main()
