"""Regression: オールラウンダーな統率者 (101301) 技能效果验证.

Tests new mechanisms introduced for this character:
1. 110016 七彩の庭園 (EX): 敵全体3行動凍結 + 被ダメージ増加
2. 120053 イグナイト (AS1): 最近敵5行動炎上 + ally_adjacent回復 (新規target_type)
3. 120054 スタンサプレッション (AS2):
   - enemy_row_highest_atk (新規target_type): 最高ATK敵含む横一列EN攻撃
   - HP90%以上気絶
   - Lv11+ enemy_row_others (新規target_type): 同一横列他敵にatk_down
4. 130061 セントリストア (PS1):
   - on_turn_end: ally_columnにEN被ダメージ減少
   - self_has_status_ailment (新規block条件): 状態異常時全debuff解除
   - Lv11+ heal_over_time
5. 130062 リベンジシュート (PS2): after_ally_attacked → 最高ATK敵にEN反撃

Code changes:
- target_service.py: 新規 ally_adjacent / enemy_row_highest_atk target_type処理
- skill_service.py _resolve_target_type: ally_adjacent→SELF_AND_FRIENDS,
  enemy_row_highest_atk / enemy_row_others → ENEMIES
- skill_service.py _resolve_target_range: ally_adjacent→ALL_PAWNS,
  enemy_row_highest_atk / enemy_row_others → LINE
- skill_service.py: enemy_row_others処理（damage/aura path）
- skill_service.py: self_has_status_ailment block条件
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


# Skill IDs
EX_FREEZE = 110016      # 七彩の庭園
AS_IGNITE = 120053      # イグナイト
AS_STUN_SUP = 120054    # スタンサプレッション
PS_SENTRY = 130061      # セントリストア
PS_REVENGE = 130062     # リベンジシュート


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.EARTH.value,
               character_type=2, skills=None, skill_levels=None, pp=4, ap=10,
               current_hp=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=0,
        is_alive=hp > 0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class TestReg101301AllRoundLeader(unittest.TestCase):
    """オールラウンダーな統率者 (101301) 技能效果検証."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    # ── 110016 七彩の庭園 (EX) 配置検証 ──

    def test_ex_config_freeze_status(self):
        """110016 must apply freeze (add_status with status_type=freeze) to enemy_all."""
        parsed = self.dl.get_parsed_skill_data(EX_FREEZE)
        self.assertIsNotNone(parsed)
        effects = [eff for blk in parsed.get('effect_blocks', [])
                   for eff in blk.get('effects', [])]
        freeze_effs = [e for e in effects
                       if e.get('effect_type') == 'add_status'
                       and e.get('flags', {}).get('status_type') == 'freeze']
        self.assertGreater(len(freeze_effs), 0, "110016 must have freeze effect")
        self.assertEqual(freeze_effs[0].get('target_type'), 'enemy_all')
        self.assertEqual(freeze_effs[0].get('duration'), 3)
        self.assertEqual(freeze_effs[0].get('duration_type'), 'action')

    def test_ex_freeze_applied_to_all_enemies(self):
        """EX must apply freeze to all alive enemies."""
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, skills=[EX_FREEZE],
            skill_levels={EX_FREEZE: 10}, ap=10,
        )
        e1 = _make_unit("e1", "敵1", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=50000)
        e2 = _make_unit("e2", "敵2", Side.ENEMY, Position.ENEMY_CENTER_BACK, hp=50000)
        bf = _make_bf(caster, e1, e2)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, EX_FREEZE, bf, skip_cost=True)

        FREEZE = SkillEffectType.FREEZE.value
        for enemy in (e1, e2):
            freeze_debuffs = [d for d in enemy.debuffs if d.effect_type == FREEZE]
            self.assertEqual(len(freeze_debuffs), 1,
                             f"{enemy.name} should have 1 freeze debuff")

    # ── 120053 イグナイト (AS1) ally_adjacent 検証 ──

    def test_ignite_config_ally_adjacent(self):
        """120053 heal effect must use target_type='ally_adjacent'."""
        parsed = self.dl.get_parsed_skill_data(AS_IGNITE)
        effects = [eff for blk in parsed.get('effect_blocks', [])
                   for eff in blk.get('effects', [])]
        heal_effs = [e for e in effects if e.get('effect_type') == 'heal']
        self.assertGreater(len(heal_effs), 0)
        self.assertEqual(heal_effs[0].get('target_type'), 'ally_adjacent')

    def test_ally_adjacent_selects_only_adjacent_allies(self):
        """ally_adjacent must select only allies in adjacent positions (not self).

        Setup: caster at ALLY_CENTER_FRONT (front center)
        - ally_front_left at ALLY_LEFT_FRONT: adjacent (same row, left)
        - ally_front_right at ALLY_RIGHT_FRONT: adjacent (same row, right)
        - ally_back_center at ALLY_CENTER_BACK: adjacent (same column, back)
        - ally_back_left at ALLY_LEFT_BACK: NOT adjacent (diagonal)
        - ally_back_right at ALLY_RIGHT_BACK: NOT adjacent (diagonal)
        """
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, skills=[AS_IGNITE],
            skill_levels={AS_IGNITE: 10}, ap=10,
        )
        # Adjacent allies (should be healed) - HP below max to allow healing
        ally_left = _make_unit("ally_left", "左前", Side.ALLY,
                               Position.ALLY_LEFT_FRONT, hp=100000,
                               current_hp=50000)
        ally_right = _make_unit("ally_right", "右前", Side.ALLY,
                                Position.ALLY_RIGHT_FRONT, hp=100000,
                                current_hp=50000)
        ally_back = _make_unit("ally_back", "中後", Side.ALLY,
                               Position.ALLY_CENTER_BACK, hp=100000,
                               current_hp=50000)
        # Non-adjacent allies (should NOT be healed)
        ally_bl = _make_unit("ally_bl", "左後", Side.ALLY,
                             Position.ALLY_LEFT_BACK, hp=100000,
                             current_hp=50000)
        ally_br = _make_unit("ally_br", "右後", Side.ALLY,
                             Position.ALLY_RIGHT_BACK, hp=100000,
                             current_hp=50000)
        # Enemy (target for burn, not heal)
        enemy = _make_unit("enemy", "敵", Side.ENEMY,
                           Position.ENEMY_CENTER_FRONT, hp=100000)

        bf = _make_bf(caster, ally_left, ally_right, ally_back,
                      ally_bl, ally_br, enemy)
        ss, _ = self._make_services(bf)

        # Record HP before
        adjacent_allies = [ally_left, ally_right, ally_back]
        non_adjacent_allies = [ally_bl, ally_br]
        for a in adjacent_allies + non_adjacent_allies:
            a._hp_before = a.current_hp

        ss.execute_skill(caster, AS_IGNITE, bf, skip_cost=True)

        # Adjacent allies should be healed
        for a in adjacent_allies:
            self.assertGreater(a.current_hp, a._hp_before,
                               f"{a.name} (adjacent) should be healed")
        # Non-adjacent allies should NOT be healed
        for a in non_adjacent_allies:
            self.assertEqual(a.current_hp, a._hp_before,
                             f"{a.name} (non-adjacent) should NOT be healed")

    # ── 120054 スタンサプレッション (AS2) ──

    def test_stun_sup_config_enemy_row_highest_atk(self):
        """120054 damage must use target_type='enemy_row_highest_atk'."""
        parsed = self.dl.get_parsed_skill_data(AS_STUN_SUP)
        effects = [eff for blk in parsed.get('effect_blocks', [])
                   for eff in blk.get('effects', [])]
        dmg_effs = [e for e in effects if e.get('effect_type') == 'damage']
        self.assertGreater(len(dmg_effs), 0)
        self.assertEqual(dmg_effs[0].get('target_type'), 'enemy_row_highest_atk')

    def test_enemy_row_highest_atk_selects_correct_row(self):
        """enemy_row_highest_atk must select the row containing the highest ATK enemy.

        Setup:
        - Front row enemies: e_fl (ATK=5000), e_fc (ATK=3000), e_fr (ATK=4000)
        - Back row enemies: e_bl (ATK=9000), e_bc (ATK=8000), e_br (ATK=7000)
        Highest ATK is e_bl (back row). Damage should hit all 3 back row enemies.
        """
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, skills=[AS_STUN_SUP],
            skill_levels={AS_STUN_SUP: 10}, ap=10,
        )
        e_fl = _make_unit("e_fl", "前左", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                          hp=100000, atk=5000)
        e_fc = _make_unit("e_fc", "前中", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                          hp=100000, atk=3000)
        e_fr = _make_unit("e_fr", "前右", Side.ENEMY, Position.ENEMY_RIGHT_FRONT,
                          hp=100000, atk=4000)
        e_bl = _make_unit("e_bl", "後左", Side.ENEMY, Position.ENEMY_LEFT_BACK,
                          hp=100000, atk=9000)
        e_bc = _make_unit("e_bc", "後中", Side.ENEMY, Position.ENEMY_CENTER_BACK,
                          hp=100000, atk=8000)
        e_br = _make_unit("e_br", "後右", Side.ENEMY, Position.ENEMY_RIGHT_BACK,
                          hp=100000, atk=7000)

        bf = _make_bf(caster, e_fl, e_fc, e_fr, e_bl, e_bc, e_br)
        ss, _ = self._make_services(bf)

        for e in (e_fl, e_fc, e_fr, e_bl, e_bc, e_br):
            e._hp_before = e.current_hp

        ss.execute_skill(caster, AS_STUN_SUP, bf, skip_cost=True)

        # Back row (highest ATK row) should take damage
        for e in (e_bl, e_bc, e_br):
            self.assertLess(e.current_hp, e._hp_before,
                            f"{e.name} (back row, highest ATK row) should take damage")
        # Front row should NOT take damage
        for e in (e_fl, e_fc, e_fr):
            self.assertEqual(e.current_hp, e._hp_before,
                             f"{e.name} (front row) should NOT take damage")

    def test_stun_applied_when_target_hp_above_90(self):
        """Stun must be applied to highest ATK enemy when HP >= 90%."""
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, skills=[AS_STUN_SUP],
            skill_levels={AS_STUN_SUP: 10}, ap=10,
        )
        # Single enemy with 100% HP (above 90%)
        enemy = _make_unit("enemy", "敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                           hp=100000, atk=5000)
        bf = _make_bf(caster, enemy)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, AS_STUN_SUP, bf, skip_cost=True)

        KNOCKOUT = SkillEffectType.KNOCKOUT.value
        stun_debuffs = [d for d in enemy.debuffs if d.effect_type == KNOCKOUT]
        self.assertEqual(len(stun_debuffs), 1,
                         "Enemy with HP>=90% should be stunned")

    def test_stun_not_applied_when_target_hp_below_90(self):
        """Stun must NOT be applied when HP < 90%."""
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, skills=[AS_STUN_SUP],
            skill_levels={AS_STUN_SUP: 10}, ap=10,
        )
        # Single enemy with 80% HP (below 90%)
        enemy = _make_unit("enemy", "敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                           hp=100000, atk=5000, current_hp=80000)
        bf = _make_bf(caster, enemy)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, AS_STUN_SUP, bf, skip_cost=True)

        KNOCKOUT = SkillEffectType.KNOCKOUT.value
        stun_debuffs = [d for d in enemy.debuffs if d.effect_type == KNOCKOUT]
        self.assertEqual(len(stun_debuffs), 0,
                         "Enemy with HP<90% should NOT be stunned")

    def test_enemy_row_others_atk_down_at_lv11(self):
        """Lv11+ Block2 atk_down must be applied to enemy_row_others (excluding main target).

        Setup:
        - Back row: e_bl (ATK=9000, highest), e_bc (ATK=8000), e_br (ATK=7000)
        - e_bl is the highest ATK enemy (main target, NOT affected by atk_down)
        - e_bc and e_br are in the same row (should get atk_down)
        """
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, skills=[AS_STUN_SUP],
            skill_levels={AS_STUN_SUP: 11}, ap=10,
        )
        e_fl = _make_unit("e_fl", "前左", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                          hp=100000, atk=5000)
        e_fc = _make_unit("e_fc", "前中", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                          hp=100000, atk=3000)
        e_fr = _make_unit("e_fr", "前右", Side.ENEMY, Position.ENEMY_RIGHT_FRONT,
                          hp=100000, atk=4000)
        e_bl = _make_unit("e_bl", "後左", Side.ENEMY, Position.ENEMY_LEFT_BACK,
                          hp=100000, atk=9000)
        e_bc = _make_unit("e_bc", "後中", Side.ENEMY, Position.ENEMY_CENTER_BACK,
                          hp=100000, atk=8000)
        e_br = _make_unit("e_br", "後右", Side.ENEMY, Position.ENEMY_RIGHT_BACK,
                          hp=100000, atk=7000)

        bf = _make_bf(caster, e_fl, e_fc, e_fr, e_bl, e_bc, e_br)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, AS_STUN_SUP, bf, skip_cost=True)

        # atk_down maps to SkillEffectType.STATUS_ATTACK ("StatusAttack")
        STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
        # Main target (e_bl) should NOT have atk_down
        e_bl_atk_downs = [d for d in e_bl.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(e_bl_atk_downs), 0,
                         "Main target (highest ATK) should NOT get atk_down")
        # Other back row enemies should have atk_down
        for e in (e_bc, e_br):
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            self.assertGreater(len(atk_downs), 0,
                               f"{e.name} (same row, not main target) should get atk_down")
        # Front row enemies should NOT have atk_down
        for e in (e_fl, e_fc, e_fr):
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            self.assertEqual(len(atk_downs), 0,
                             f"{e.name} (different row) should NOT get atk_down")

    def test_enemy_row_others_not_affected_by_stale_primary_target(self):
        """Regression: enemy_row_others must NOT use stale _last_primary_target from a previous skill.

        Bug: _last_primary_target was never reset at the start of execute_skill.
        If a previous skill set _last_primary_target to a front-row enemy,
        enemy_row_others would incorrectly target the front row instead of
        the back row (where the current skill's highest ATK enemy is).

        Fix: Reset _last_primary_target to None at execute_skill start, and
        capture it for enemy_row_highest_atk (using the highest ATK enemy in the row).
        """
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, skills=[AS_STUN_SUP],
            skill_levels={AS_STUN_SUP: 11}, ap=10,
        )
        # Front row enemies
        e_fl = _make_unit("e_fl", "前左", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                          hp=100000, atk=5000)
        e_fc = _make_unit("e_fc", "前中", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
                          hp=100000, atk=3000)
        # Back row enemies (highest ATK is e_bl)
        e_bl = _make_unit("e_bl", "後左", Side.ENEMY, Position.ENEMY_LEFT_BACK,
                          hp=100000, atk=9000)
        e_bc = _make_unit("e_bc", "後中", Side.ENEMY, Position.ENEMY_CENTER_BACK,
                          hp=100000, atk=8000)

        bf = _make_bf(caster, e_fl, e_fc, e_bl, e_bc)
        ss, _ = self._make_services(bf)

        # Simulate a stale _last_primary_target pointing to a FRONT row enemy
        # (as if a previous skill had set it)
        ss._last_primary_target = e_fl

        ss.execute_skill(caster, AS_STUN_SUP, bf, skip_cost=True)

        STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
        # Back row enemies (same row as highest ATK) should get atk_down (except main target e_bl)
        e_bc_atk_downs = [d for d in e_bc.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertGreater(len(e_bc_atk_downs), 0,
                           "e_bc (same row as highest ATK, not main target) should get atk_down")
        # Front row enemies should NOT get atk_down
        for e, label in [(e_fl, "e_fl"), (e_fc, "e_fc")]:
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            self.assertEqual(len(atk_downs), 0,
                             f"{label} (front row) should NOT get atk_down even with stale _last_primary_target")

    def test_enemy_row_others_excludes_highest_atk_not_first_in_list(self):
        """enemy_row_others must exclude the highest ATK enemy, not just the first in the list.

        This verifies that _last_primary_target is captured as the highest ATK enemy
        in the row (via max(row_list, key=attack)), not just the first element.
        """
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, skills=[AS_STUN_SUP],
            skill_levels={AS_STUN_SUP: 11}, ap=10,
        )
        # Back row: e_bl (ATK=7000), e_bc (ATK=9000, highest), e_br (ATK=8000)
        # e_bc is the highest ATK enemy and should be excluded from atk_down
        e_bl = _make_unit("e_bl", "後左", Side.ENEMY, Position.ENEMY_LEFT_BACK,
                          hp=100000, atk=7000)
        e_bc = _make_unit("e_bc", "後中", Side.ENEMY, Position.ENEMY_CENTER_BACK,
                          hp=100000, atk=9000)
        e_br = _make_unit("e_br", "後右", Side.ENEMY, Position.ENEMY_RIGHT_BACK,
                          hp=100000, atk=8000)

        bf = _make_bf(caster, e_bl, e_bc, e_br)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, AS_STUN_SUP, bf, skip_cost=True)

        STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
        # Main target (e_bc, highest ATK=9000) should NOT have atk_down
        e_bc_atk_downs = [d for d in e_bc.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(e_bc_atk_downs), 0,
                         "e_bc (highest ATK, main target) should NOT get atk_down")
        # Other back row enemies should have atk_down
        for e, label in [(e_bl, "e_bl"), (e_br, "e_br")]:
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            self.assertGreater(len(atk_downs), 0,
                               f"{label} (same row, not main target) should get atk_down")

    def test_enemy_row_others_not_applied_below_lv11(self):
        """Below Lv11, atk_down (Block2) must NOT be applied."""
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, skills=[AS_STUN_SUP],
            skill_levels={AS_STUN_SUP: 10}, ap=10,
        )
        e_bl = _make_unit("e_bl", "後左", Side.ENEMY, Position.ENEMY_LEFT_BACK,
                          hp=100000, atk=9000)
        e_bc = _make_unit("e_bc", "後中", Side.ENEMY, Position.ENEMY_CENTER_BACK,
                          hp=100000, atk=8000)
        e_br = _make_unit("e_br", "後右", Side.ENEMY, Position.ENEMY_RIGHT_BACK,
                          hp=100000, atk=7000)

        bf = _make_bf(caster, e_bl, e_bc, e_br)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, AS_STUN_SUP, bf, skip_cost=True)

        # atk_down maps to SkillEffectType.STATUS_ATTACK ("StatusAttack")
        STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
        for e in (e_bc, e_br):
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            self.assertEqual(len(atk_downs), 0,
                             f"{e.name} should NOT get atk_down at Lv10")

    # ── 130061 セントリストア (PS1) ──

    def test_sentry_config_trigger_on_turn_end(self):
        """130061 trigger_type must be 'on_turn_end'."""
        parsed = self.dl.get_parsed_skill_data(PS_SENTRY)
        self.assertEqual(parsed.get('trigger_type'), 'on_turn_end')

    def test_sentry_config_self_has_status_ailment(self):
        """130061 Block2 condition must be self_has_status_ailment."""
        parsed = self.dl.get_parsed_skill_data(PS_SENTRY)
        blocks = parsed.get('effect_blocks', [])
        block2 = next((b for b in blocks if b.get('block_id') == 2), None)
        self.assertIsNotNone(block2)
        cond = block2.get('condition')
        self.assertEqual(cond.get('type'), 'self_has_status_ailment')

    def test_sentry_dmg_taken_down_applied_to_ally_column(self):
        """Block1 dmg_taken_down must be applied to ally_column (self + front/back ally)."""
        # Caster at ALLY_CENTER_BACK (back row), ally at ALLY_CENTER_FRONT (front row)
        # ally_column = these 2 units (same column, front+back)
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=100000, atk=10000, skills=[PS_SENTRY],
            skill_levels={PS_SENTRY: 10}, pp=4,
        )
        ally_front = _make_unit("ally_front", "前中", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=100000)
        # Different column allies (should NOT get buff)
        ally_left = _make_unit("ally_left", "左前", Side.ALLY,
                               Position.ALLY_LEFT_FRONT, hp=100000)
        bf = _make_bf(caster, ally_front, ally_left,
                      _make_unit("e", "敵", Side.ENEMY,
                                 Position.ENEMY_CENTER_FRONT, hp=100000))
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, PS_SENTRY, bf, skip_cost=True)

        # dmg_taken_down maps to SkillEffectType.RECEIVED_DAMAGE ("ReceivedDamage")
        RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
        # Caster (self, in column) should have buff
        caster_buffs = [b for b in caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(caster_buffs), 0, "Caster should get dmg_taken_down")
        # ally_front (same column) should have buff
        front_buffs = [b for b in ally_front.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(front_buffs), 0, "Front ally (same column) should get dmg_taken_down")
        # ally_left (different column) should NOT have buff
        left_buffs = [b for b in ally_left.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(left_buffs), 0, "Left ally (different column) should NOT get dmg_taken_down")

    def test_sentry_remove_debuff_when_has_status_ailment(self):
        """Block2 remove_debuff must fire when caster has a status ailment."""
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=100000, atk=10000, skills=[PS_SENTRY],
            skill_levels={PS_SENTRY: 10}, pp=4,
        )
        # Apply a status ailment (poison) and a non-ailment debuff (atk_down)
        from src.entities_v2.unit_state import BuffState
        from src.entities_v2.enums import SkillEffectType as SET
        poison_debuff = BuffState(
            buff_id='poison1', name='poison', effect_type=SET.POISON.value,
            value=1000, duration=3, timing_type=2, is_debuff=True,
        )
        atk_down_debuff = BuffState(
            buff_id='atkdown1', name='atk_down', effect_type=SET.STATUS_ATTACK.value,
            value=30, duration=3, timing_type=2, is_debuff=True,
        )
        caster.debuffs = [poison_debuff, atk_down_debuff]

        bf = _make_bf(caster, _make_unit("e", "敵", Side.ENEMY,
                                         Position.ENEMY_CENTER_FRONT, hp=100000))
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, PS_SENTRY, bf, skip_cost=True)

        # All debuffs should be removed (remove_debuff value=-1 means all)
        self.assertEqual(len(caster.debuffs), 0,
                         "All debuffs should be removed when caster has status ailment")

    def test_sentry_no_remove_debuff_when_no_status_ailment(self):
        """Block2 remove_debuff must NOT fire when caster has no status ailment."""
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=100000, atk=10000, skills=[PS_SENTRY],
            skill_levels={PS_SENTRY: 10}, pp=4,
        )
        # Only a non-ailment debuff (atk_down)
        from src.entities_v2.unit_state import BuffState
        from src.entities_v2.enums import SkillEffectType as SET
        atk_down_debuff = BuffState(
            buff_id='atkdown1', name='atk_down', effect_type=SET.STATUS_ATTACK.value,
            value=30, duration=3, timing_type=2, is_debuff=True,
        )
        caster.debuffs = [atk_down_debuff]

        bf = _make_bf(caster, _make_unit("e", "敵", Side.ENEMY,
                                         Position.ENEMY_CENTER_FRONT, hp=100000))
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, PS_SENTRY, bf, skip_cost=True)

        # atk_down should still be present (no status ailment → Block2 skipped)
        atk_downs = [d for d in caster.debuffs if d.effect_type == SET.STATUS_ATTACK.value]
        self.assertEqual(len(atk_downs), 1,
                         "Non-ailment debuff should NOT be removed without status ailment")

    def test_sentry_heal_over_time_at_lv11(self):
        """Lv11+ Block3 heal_over_time must be applied to ally_column."""
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=100000, atk=10000, skills=[PS_SENTRY],
            skill_levels={PS_SENTRY: 11}, pp=4,
        )
        ally_front = _make_unit("ally_front", "前中", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=100000)
        ally_left = _make_unit("ally_left", "左前", Side.ALLY,
                               Position.ALLY_LEFT_FRONT, hp=100000)
        bf = _make_bf(caster, ally_front, ally_left,
                      _make_unit("e", "敵", Side.ENEMY,
                                 Position.ENEMY_CENTER_FRONT, hp=100000))
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, PS_SENTRY, bf, skip_cost=True)

        HOT = SkillEffectType.HEAL_OVER_TIME.value
        # Caster and ally_front (same column) should have HOT
        for u, label in [(caster, "Caster"), (ally_front, "Front ally")]:
            hots = [b for b in u.buffs if b.effect_type == HOT]
            self.assertGreater(len(hots), 0,
                               f"{label} (same column) should get heal_over_time at Lv11")
        # ally_left (different column) should NOT have HOT
        left_hots = [b for b in ally_left.buffs if b.effect_type == HOT]
        self.assertEqual(len(left_hots), 0,
                         "Left ally (different column) should NOT get heal_over_time")

    def test_sentry_no_heal_over_time_below_lv11(self):
        """Below Lv11, heal_over_time (Block3) must NOT be applied."""
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=100000, atk=10000, skills=[PS_SENTRY],
            skill_levels={PS_SENTRY: 10}, pp=4,
        )
        ally_front = _make_unit("ally_front", "前中", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=100000)
        bf = _make_bf(caster, ally_front,
                      _make_unit("e", "敵", Side.ENEMY,
                                 Position.ENEMY_CENTER_FRONT, hp=100000))
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, PS_SENTRY, bf, skip_cost=True)

        HOT = SkillEffectType.HEAL_OVER_TIME.value
        for u in (caster, ally_front):
            hots = [b for b in u.buffs if b.effect_type == HOT]
            self.assertEqual(len(hots), 0,
                             f"{u.name} should NOT get heal_over_time at Lv10")

    # ── 130062 リベンジシュート (PS2) ──

    def test_revenge_config_trigger_after_ally_attacked(self):
        """130062 trigger_type must be 'after_ally_attacked'."""
        parsed = self.dl.get_parsed_skill_data(PS_REVENGE)
        self.assertEqual(parsed.get('trigger_type'), 'after_ally_attacked')

    def test_revenge_config_target_highest_atk(self):
        """130062 damage must target enemy_single_highest_atk."""
        parsed = self.dl.get_parsed_skill_data(PS_REVENGE)
        effects = [eff for blk in parsed.get('effect_blocks', [])
                   for eff in blk.get('effects', [])]
        dmg_effs = [e for e in effects if e.get('effect_type') == 'damage']
        self.assertGreater(len(dmg_effs), 0)
        self.assertEqual(dmg_effs[0].get('target_type'), 'enemy_single_highest_atk')
        self.assertTrue(dmg_effs[0].get('flags', {}).get('is_en_attack'),
                        "130062 damage must be EN attack")

    def test_revenge_triggers_when_ally_attacked(self):
        """130062 must trigger when an ally is attacked (target_is_ally condition passes).

        Bug: global_condition target_is_ally (no value field) defaulted to val=0,
        causing condition to check (is_ally == False). When ally was attacked
        (is_ally=True), result was (True == False) = False, so PS never fired.

        Fix: target_is_ally defaults to val=1 (True) when no value specified.
        """
        # PS holder (リベンジシュート) at back row
        holder = _make_unit(
            "holder", "Holder(リベンジシュート)", Side.ALLY,
            Position.ALLY_CENTER_BACK, hp=100000, atk=10000,
            skills=[PS_REVENGE], skill_levels={PS_REVENGE: 10}, pp=10, ap=10,
        )
        # Ally who will be attacked
        ally = _make_unit("ally", "友方", Side.ALLY, Position.ALLY_CENTER_FRONT,
                          hp=100000, atk=100, current_hp=100000)
        # Enemy attacker (highest ATK among enemies)
        enemy_attacker = _make_unit(
            "enemy_atk", "敵攻撃者", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=500000, atk=5000,
        )
        # Another enemy (lower ATK, to verify highest_atk targeting)
        enemy_other = _make_unit("enemy_other", "敵他", Side.ENEMY,
                                 Position.ENEMY_LEFT_FRONT, hp=100000, atk=1000)

        bf = _make_bf(holder, ally, enemy_attacker, enemy_other)
        ss, ts = self._make_services(bf)

        enemy_hp_before = enemy_attacker.current_hp
        holder_pp_before = holder.current_pp

        # Simulate: ally was attacked by enemy_attacker → trigger after_ally_attacked
        after_ally_actions = ts.trigger_after_ally_attacked(
            targets=[ally], battlefield=bf,
            actor=enemy_attacker, primary_target=ally,
        )

        # リベンジシュート (130062) should be in the triggered actions
        revenge_actions = [a for a in after_ally_actions if a.skill_id == PS_REVENGE]
        self.assertGreater(len(revenge_actions), 0,
                           "リベンジシュート should trigger when ally is attacked "
                           "(target_is_ally condition must pass)")

        # Execute the triggered PS action
        from src.combat_v2.battle_flow_controller import BattleFlowController
        controller = BattleFlowController(bf, data_loader=self.dl)
        controller._build_display_names()
        controller.skill_service.set_battlefield(bf)
        controller._deferred_crit_triggers = []
        controller._execute_trigger_actions(revenge_actions, enemy_attacker)

        # リベンジシュート (cost=1) should consume holder's PP
        self.assertEqual(holder.current_pp, holder_pp_before - 1,
                         "Holder PP should be consumed by リベンジシュート "
                         "(triggered when ally was attacked). "
                         "Before=%d, After=%d" % (holder_pp_before, holder.current_pp))
        # The highest ATK enemy (enemy_attacker, atk=5000) should take damage
        self.assertLess(enemy_attacker.current_hp, enemy_hp_before,
                        "enemy_attacker (highest ATK) should be damaged by リベンジシュート")


if __name__ == '__main__':
    unittest.main()
