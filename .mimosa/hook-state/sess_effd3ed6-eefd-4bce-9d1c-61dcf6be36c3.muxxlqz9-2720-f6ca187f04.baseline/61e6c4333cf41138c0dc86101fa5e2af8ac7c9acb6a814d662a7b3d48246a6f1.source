"""Regression tests for 【みんなを見守る山ガール】 (126301) skill implementations.

Covers 5 skills:
- 110043 ラウラＳＯＳ！ (EX): enemy_all damage + atk_down(1 action)
- 120097 落雪注意 (AS): enemy_single damage
- 130105 整いサウナ (PS1): before_skill_use, atk_up(scale_by_alive_allies, 1attack)
  + 60% burn enchant + 60% splash_to_adjacent enchant (independent probability)
  + Lv11+ burn adds heal_efficacy_down(carried_debuff, duration_owner=caster)
  + Lv11+ splash adds dmg_dealt_down(carried_debuff, 1action, stackable) to all targets
- 130106 みんなと一緒！ (PS2): on_turn_start, crit_rate_up(1action, stackable)
  + Lv11+ crit_dmg_up(1action, stackable), ally_alive_count >= 2
- 130107 私も混ぜて～！ (PS3): after_ally_as_attack, follow-up damage on attacked_targets

New mechanisms:
- splash_to_adjacent enchant flag (PS1 130105): splash damage to adjacent enemies using main attack power
- carried_debuff extended to splash targets (PS1 130105 Lv11+): dmg_dealt_down applied to main + splash
- carried_debuff_duration_owner="caster" (PS1 130105 Lv11+): heal_efficacy_down expires on caster's action end
- value=0 enchant buff as status-only carrier (burn without enchant damage)
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig

# Skill IDs
EX_LAURA_SOS = 110043
AS_RAKUYUKI = 120097
PS_TONOI_SAUNA = 130105
PS_MINNA_TO_ISSHO = 130106
PS_WATASHI_MO_MAZETE = 130107

# Effect type constants
ATK_UP = SkillEffectType.STATUS_ATTACK.value
DMG_DEALT_DOWN = SkillEffectType.DEALT_DAMAGE.value
HEAL_EFFICACY_DOWN = SkillEffectType.RECEIVED_HEALING.value
BURN = SkillEffectType.CONFLAGRATION.value


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.FIRE.value,
               character_type=1, skills=None, skill_levels=None,
               pp=10, ep=10, ap=10, level=10):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=126301, level=level, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=ep,
        is_alive=True,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class _BaseTest(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.dl = None

    def _get_dl(self):
        if self.dl is None:
            from src.data.data_loader import DataLoader
            self.dl = DataLoader()
            self.dl.load_all()
        return self.dl

    def _make_services(self, bf):
        dl = self._get_dl()
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(dl, rs, target_service=tgs, damage_service=dms,
                          aura_service=aus, trigger_service=ts, status_service=sts)
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts, dms


# ════════════════════════════════════════════════════════════════════
# EX 110043 ラウラＳＯＳ！
# ════════════════════════════════════════════════════════════════════
class TestRegYamagirlEX110043(_BaseTest):
    """110043 ラウラＳＯＳ！ (EX): enemy_all damage + atk_down"""

    def test_config_has_damage_and_atk_down(self):
        """EX should have damage + atk_down in Block1."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(EX_LAURA_SOS)
        self.assertIsNotNone(parsed)
        effects = parsed['effect_blocks'][0]['effects']
        dmg = [e for e in effects if e['effect_type'] == 'damage']
        self.assertEqual(len(dmg), 1)
        self.assertEqual(dmg[0]['target_type'], 'enemy_all')
        self.assertEqual(dmg[0]['value_tag'], '威力')

        atk_down = [e for e in effects if e['effect_type'] == 'atk_down']
        self.assertEqual(len(atk_down), 1)
        self.assertEqual(atk_down[0]['target_type'], 'enemy_all')
        self.assertEqual(atk_down[0]['duration'], 1)
        self.assertEqual(atk_down[0]['duration_type'], 'action')
        self.assertTrue(atk_down[0]['flags'].get('value_type') == 'percent')


