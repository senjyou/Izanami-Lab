# AS 120097 落雪注意
# ════════════════════════════════════════════════════════════════════
class TestRegYamagirlAS120097(_BaseTest):
    """120097 落雪注意 (AS): enemy_single damage"""

    def test_config_damage_enemy_single(self):
        """AS should be enemy_single damage with 威力 tag."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(AS_RAKUYUKI)
        self.assertIsNotNone(parsed)
        effects = parsed['effect_blocks'][0]['effects']
        dmg = [e for e in effects if e['effect_type'] == 'damage']
        self.assertEqual(len(dmg), 1)
        self.assertEqual(dmg[0]['target_type'], 'enemy_single')
        self.assertEqual(dmg[0]['value_tag'], '威力')
        self.assertEqual(dmg[0]['hit_count'], 1)


# ════════════════════════════════════════════════════════════════════
# PS1 130105 整いサウナ
# ════════════════════════════════════════════════════════════════════
class TestRegYamagirlPS1_130105(_BaseTest):
    """130105 整いサウナ (PS1): before_skill_use + atk_up + 60% burn + 60% splash + Lv11+ carried_debuff"""

    def test_config_trigger_before_skill_use(self):
        """PS1 trigger_type should be before_skill_use."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_TONOI_SAUNA)
        self.assertEqual(parsed['trigger_type'], 'before_skill_use')
        self.assertEqual(parsed['cooldown'], 1)

    def test_config_block1_atk_up_scale_by_alive_allies(self):
        """Block1 should be atk_up with scale_by_alive_allies flag."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_TONOI_SAUNA)
        block1 = parsed['effect_blocks'][0]
        self.assertIsNone(block1['condition'])
        effects = block1['effects']
        self.assertEqual(len(effects), 1)
        self.assertEqual(effects[0]['effect_type'], 'atk_up')
        self.assertEqual(effects[0]['target_type'], 'self')
        self.assertEqual(effects[0]['duration_type'], 'attack')
        self.assertTrue(effects[0]['flags'].get('scale_by_alive_allies'))
        self.assertTrue(effects[0]['flags'].get('attack_limited'))

    def test_config_burn_block_level_max_10(self):
        """Lv1-10 burn block should have random_choice group_id=1 weight=60 level_max=10."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_TONOI_SAUNA)
        # Block2: burn (Lv1-10, group_id=1, weight=60)
        block2 = parsed['effect_blocks'][1]
        cond = block2['condition']
        self.assertEqual(cond['type'], 'random_choice')
        self.assertEqual(cond['group_id'], 1)
        self.assertEqual(cond['weight'], 60)
        self.assertEqual(cond['level_max'], 10)
        effects = block2['effects']
        self.assertEqual(len(effects), 1)
        self.assertEqual(effects[0]['effect_type'], 'add_damage_to_attack')
        self.assertEqual(effects[0]['flags'].get('add_status'), 'burn')
        self.assertEqual(effects[0]['flags'].get('burn_damage_pct'), 30)

    def test_config_splash_block_level_max_10(self):
        """Lv1-10 splash block should have random_choice group_id=2 weight=60 level_max=10."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_TONOI_SAUNA)
        # Block4: splash (Lv1-10, group_id=2, weight=60)
        block4 = parsed['effect_blocks'][3]
        cond = block4['condition']
        self.assertEqual(cond['type'], 'random_choice')
        self.assertEqual(cond['group_id'], 2)
        self.assertEqual(cond['weight'], 60)
        self.assertEqual(cond['level_max'], 10)
        effects = block4['effects']
        self.assertEqual(len(effects), 1)
        self.assertEqual(effects[0]['effect_type'], 'add_damage_to_attack')
        self.assertTrue(effects[0]['flags'].get('splash_to_adjacent'))

    def test_config_lv11_burn_adds_heal_efficacy_down(self):
        """Lv11+ burn block should also have heal_efficacy_down carried_debuff with duration_owner=caster."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_TONOI_SAUNA)
        # Block6: burn + heal_efficacy_down (Lv11+, group_id=1, weight=60)
        block6 = parsed['effect_blocks'][5]
        cond = block6['condition']
        self.assertEqual(cond['level_min'], 11)
        effects = block6['effects']
        self.assertEqual(len(effects), 2)
        # burn effect
        self.assertEqual(effects[0]['effect_type'], 'add_damage_to_attack')
        # heal_efficacy_down carried_debuff
        hed = effects[1]
        self.assertEqual(hed['effect_type'], 'heal_efficacy_down')
        self.assertTrue(hed['flags'].get('carried_debuff'))
        self.assertEqual(hed['flags'].get('duration_owner'), 'caster')
        self.assertTrue(hed['flags'].get('stackable'))

    def test_config_lv11_splash_adds_dmg_dealt_down(self):
        """Lv11+ splash block should also have dmg_dealt_down carried_debuff."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_TONOI_SAUNA)
        # Block8: splash + dmg_dealt_down (Lv11+, group_id=2, weight=60)
        block8 = parsed['effect_blocks'][7]
        cond = block8['condition']
        self.assertEqual(cond['level_min'], 11)
        effects = block8['effects']
        self.assertEqual(len(effects), 2)
        # splash effect
        self.assertEqual(effects[0]['effect_type'], 'add_damage_to_attack')
        self.assertTrue(effects[0]['flags'].get('splash_to_adjacent'))
        # dmg_dealt_down carried_debuff
        ddd = effects[1]
        self.assertEqual(ddd['effect_type'], 'dmg_dealt_down')
        self.assertTrue(ddd['flags'].get('carried_debuff'))
        self.assertTrue(ddd['flags'].get('stackable'))

    def test_config_independent_probability_groups(self):
        """Burn (group_id=1) and splash (group_id=2) should be independent."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_TONOI_SAUNA)
        # Collect all random_choice group_ids for Lv1-10 blocks
        group_ids = set()
        for block in parsed['effect_blocks']:
            cond = block.get('condition')
            if cond and isinstance(cond, dict) and cond.get('type') == 'random_choice':
                if cond.get('level_max') == 10:
                    group_ids.add(cond.get('group_id'))
        self.assertIn(1, group_ids, "should have group_id=1 for burn")
        self.assertIn(2, group_ids, "should have group_id=2 for splash")

    def test_atk_up_scale_by_alive_allies(self):
        """ATK buff value should scale with alive allies count."""
        bf = _make_bf(
            _make_unit("ally1", "山ガール", Side.ALLY, Position.ALLY_LEFT_BACK,
                       skills=[AS_RAKUYUKI, PS_TONOI_SAUNA],
                       skill_levels={AS_RAKUYUKI: 10, PS_TONOI_SAUNA: 10}),
            _make_unit("ally2", "友方A", Side.ALLY, Position.ALLY_LEFT_FRONT, pp=0),
            _make_unit("ally3", "友方B", Side.ALLY, Position.ALLY_CENTER_FRONT, pp=0),
            _make_unit("enemy1", "敵A", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999),
        )
        ss, ts, dms = self._make_services(bf)

        # Set branch override to select burn (block_id=2) and splash (block_id=4)
        selected_blocks = {2, 4}
        def branch_override(ctx):
            candidates = ctx['candidates']
            for c in candidates:
                if c['block_id'] in selected_blocks:
                    return c['block_id']
            return candidates[0]['block_id']
        ss._branch_override_func = branch_override

        # Execute PS1 (before_skill_use)
        caster = bf.get_unit_by_id("ally1")
        ss.execute_skill(caster=caster, skill_id=PS_TONOI_SAUNA,
                         battlefield=bf, skip_cost=True)

        # Check atk_up buff on caster
        atk_buffs = [b for b in caster.buffs if b.effect_type == ATK_UP]
        self.assertEqual(len(atk_buffs), 1, "should have 1 atk_up buff")
        # With 3 alive allies out of 3 initial, scale = 3/3 = 1.0
        # atk tag value at Lv10 = 5.0
        # actual = 5.0 * (3/3) = 5.0
        self.assertGreater(atk_buffs[0].value, 0, "atk_up value should be > 0")

    def test_burn_enchant_no_extra_damage(self):
        """Burn enchant with value=0 should NOT deal enchant damage (only apply burn status)."""
        bf = _make_bf(
            _make_unit("ally1", "山ガール", Side.ALLY, Position.ALLY_LEFT_BACK,
                       skills=[AS_RAKUYUKI, PS_TONOI_SAUNA],
                       skill_levels={AS_RAKUYUKI: 10, PS_TONOI_SAUNA: 10}),
            _make_unit("enemy1", "敵A", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999),
        )
        ss, ts, dms = self._make_services(bf)

        # Select burn block (block_id=2) and no-effect for splash (block_id=5)
        selected_blocks = {2, 5}
        def branch_override(ctx):
            for c in ctx['candidates']:
                if c['block_id'] in selected_blocks:
                    return c['block_id']
            return ctx['candidates'][0]['block_id']
        ss._branch_override_func = branch_override

        caster = bf.get_unit_by_id("ally1")
        enemy = bf.get_unit_by_id("enemy1")

        # Execute PS1 first (applies enchant buffs to caster)
        ss.execute_skill(caster=caster, skill_id=PS_TONOI_SAUNA,
                         battlefield=bf, skip_cost=True)

        # Execute AS (should trigger enchant: burn on enemy, but NO enchant damage)
        hp_before = enemy.current_hp
        ss.execute_skill(caster=caster, skill_id=AS_RAKUYUKI,
                         battlefield=bf, skip_cost=True)

        # Enemy should have burn debuff
        burn_debuffs = [d for d in enemy.debuffs if d.effect_type == BURN]
        self.assertEqual(len(burn_debuffs), 1, "enemy should have burn debuff")

        # Enchant damage should be 0 (value=0 buff only carries status, not damage)
        # Main AS damage is separate from enchant damage
        # We verify by checking that no "附魔" enchant_targets were recorded
        # (the enchant damage section is skipped for value=0 buffs)

    def test_splash_to_adjacent_damage(self):
        """Splash enchant should deal damage to adjacent enemies using main attack power."""
        bf = _make_bf(
            _make_unit("ally1", "山ガール", Side.ALLY, Position.ALLY_LEFT_BACK,
                       skills=[AS_RAKUYUKI, PS_TONOI_SAUNA],
                       skill_levels={AS_RAKUYUKI: 10, PS_TONOI_SAUNA: 10}),
            _make_unit("enemy1", "主目標", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999),
            _make_unit("enemy2", "隣接敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999),
        )
        ss, ts, dms = self._make_services(bf)

        # Select no-effect for burn (block_id=3) and splash (block_id=4)
        selected_blocks = {3, 4}
        def branch_override(ctx):
            for c in ctx['candidates']:
                if c['block_id'] in selected_blocks:
                    return c['block_id']
            return ctx['candidates'][0]['block_id']
        ss._branch_override_func = branch_override

        caster = bf.get_unit_by_id("ally1")
        main_enemy = bf.get_unit_by_id("enemy1")
        adj_enemy = bf.get_unit_by_id("enemy2")

        # Execute PS1 first
        ss.execute_skill(caster=caster, skill_id=PS_TONOI_SAUNA,
                         battlefield=bf, skip_cost=True)

        # Execute AS (main target = enemy1, splash should hit enemy2)
        adj_hp_before = adj_enemy.current_hp
        ss.execute_skill(caster=caster, skill_id=AS_RAKUYUKI,
                         battlefield=bf, skip_cost=True)

        # Adjacent enemy should have taken splash damage
        self.assertLess(adj_enemy.current_hp, adj_hp_before,
                        "adjacent enemy should take splash damage")

    def test_lv11_carried_debuff_applied_to_splash_targets(self):
        """Lv11+ dmg_dealt_down carried_debuff should be applied to both main and splash targets."""
        bf = _make_bf(
            _make_unit("ally1", "山ガール", Side.ALLY, Position.ALLY_LEFT_BACK,
                       skills=[AS_RAKUYUKI, PS_TONOI_SAUNA],
                       skill_levels={AS_RAKUYUKI: 15, PS_TONOI_SAUNA: 15}),
            _make_unit("enemy1", "主目標", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999),
            _make_unit("enemy2", "隣接敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=999999),
        )
        ss, ts, dms = self._make_services(bf)

        # Select no-effect for burn (block_id=7) and splash+dmg_dealt_down (block_id=8)
        selected_blocks = {7, 8}
        def branch_override(ctx):
            for c in ctx['candidates']:
                if c['block_id'] in selected_blocks:
                    return c['block_id']
            return ctx['candidates'][0]['block_id']
        ss._branch_override_func = branch_override

        caster = bf.get_unit_by_id("ally1")
        main_enemy = bf.get_unit_by_id("enemy1")
        adj_enemy = bf.get_unit_by_id("enemy2")

        # Execute PS1 first
        ss.execute_skill(caster=caster, skill_id=PS_TONOI_SAUNA,
                         battlefield=bf, skip_cost=True)

        # Execute AS (should trigger splash + dmg_dealt_down on both enemies)
        ss.execute_skill(caster=caster, skill_id=AS_RAKUYUKI,
                         battlefield=bf, skip_cost=True)

        # Both enemies should have dmg_dealt_down debuff
        main_ddd = [d for d in main_enemy.debuffs if d.effect_type == DMG_DEALT_DOWN]
        adj_ddd = [d for d in adj_enemy.debuffs if d.effect_type == DMG_DEALT_DOWN]
        self.assertGreaterEqual(len(main_ddd), 1, "main target should have dmg_dealt_down")
        self.assertGreaterEqual(len(adj_ddd), 1, "splash target should have dmg_dealt_down")

    def test_lv11_heal_efficacy_down_on_burn_target(self):
        """Lv11+ heal_efficacy_down should be applied to the burn target with duration_owner=caster."""
        bf = _make_bf(
            _make_unit("ally1", "山ガール", Side.ALLY, Position.ALLY_LEFT_BACK,
                       skills=[AS_RAKUYUKI, PS_TONOI_SAUNA],
                       skill_levels={AS_RAKUYUKI: 15, PS_TONOI_SAUNA: 15}),
            _make_unit("enemy1", "主目標", Side.ENEMY, Position.ENEMY_LEFT_FRONT, hp=999999),
        )
        ss, ts, dms = self._make_services(bf)

        # Select burn+heal_efficacy_down (block_id=6) and no-effect for splash (block_id=9)
        selected_blocks = {6, 9}
        def branch_override(ctx):
            for c in ctx['candidates']:
                if c['block_id'] in selected_blocks:
                    return c['block_id']
            return ctx['candidates'][0]['block_id']
        ss._branch_override_func = branch_override

        caster = bf.get_unit_by_id("ally1")
        enemy = bf.get_unit_by_id("enemy1")

        # Execute PS1 first
        ss.execute_skill(caster=caster, skill_id=PS_TONOI_SAUNA,
                         battlefield=bf, skip_cost=True)

        # Execute AS (should trigger burn + heal_efficacy_down)
        ss.execute_skill(caster=caster, skill_id=AS_RAKUYUKI,
                         battlefield=bf, skip_cost=True)

        # Enemy should have both burn and heal_efficacy_down
        burn_debuffs = [d for d in enemy.debuffs if d.effect_type == BURN]
        hed_debuffs = [d for d in enemy.debuffs if d.effect_type == HEAL_EFFICACY_DOWN]
        self.assertGreaterEqual(len(burn_debuffs), 1, "enemy should have burn")
        self.assertGreaterEqual(len(hed_debuffs), 1, "enemy should have heal_efficacy_down")
        # heal_efficacy_down should use DURABLE_SOURCE_MANEUVER_END timing (duration_owner=caster)
        from src.entities_v2.enums import AuraUpdateTiming
        self.assertEqual(hed_debuffs[0].timing_type,
                         AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
                         "heal_efficacy_down should expire on caster's action end")


# ════════════════════════════════════════════════════════════════════
# PS2 130106 みんなと一緒！
# ════════════════════════════════════════════════════════════════════
class TestRegYamagirlPS2_130106(_BaseTest):
    """130106 みんなと一緒！ (PS2): on_turn_start, crit_rate_up + Lv11+ crit_dmg_up"""

    def test_config_trigger_on_turn_start(self):
        """PS2 trigger_type should be on_turn_start with ally_alive_count >= 2."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_MINNA_TO_ISSHO)
        self.assertEqual(parsed['trigger_type'], 'on_turn_start')
        gc = parsed['global_condition']
        self.assertEqual(gc['type'], 'ally_alive_count')
        self.assertEqual(gc['operator'], '>=')
        self.assertEqual(gc['value'], 2)

    def test_config_block1_crit_rate_up(self):
        """Block1 should be crit_rate_up with stackable."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_MINNA_TO_ISSHO)
        block1 = parsed['effect_blocks'][0]
        effects = block1['effects']
        self.assertEqual(len(effects), 1)
        self.assertEqual(effects[0]['effect_type'], 'crit_rate_up')
        self.assertEqual(effects[0]['value_tag'], 'crt')
        self.assertEqual(effects[0]['duration'], 1)
        self.assertEqual(effects[0]['duration_type'], 'action')
        self.assertTrue(effects[0]['flags'].get('stackable'))

    def test_config_lv11_crit_dmg_up(self):
        """Lv11+ should add crit_dmg_up block."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_MINNA_TO_ISSHO)
        block2 = parsed['effect_blocks'][1]
        self.assertEqual(block2.get('level_min'), 11)
        effects = block2['effects']
        self.assertEqual(len(effects), 1)
        self.assertEqual(effects[0]['effect_type'], 'crit_dmg_up')
        self.assertEqual(effects[0]['value_tag'], 'crtdmg')
        self.assertTrue(effects[0]['flags'].get('stackable'))


# ════════════════════════════════════════════════════════════════════
# PS3 130107 私も混ぜて～！
# ════════════════════════════════════════════════════════════════════
class TestRegYamagirlPS3_130107(_BaseTest):
    """130107 私も混ぜて～！ (PS3): after_ally_as_attack follow-up damage"""

    def test_config_trigger_after_ally_as_attack(self):
        """PS3 trigger_type should be after_ally_as_attack."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_WATASHI_MO_MAZETE)
        self.assertEqual(parsed['trigger_type'], 'after_ally_as_attack')
        self.assertEqual(parsed['cooldown'], 2)

    def test_config_damage_is_follow_up(self):
        """Block1 should be damage with is_follow_up=true on attacked_targets."""
        dl = self._get_dl()
        parsed = dl.get_parsed_skill_data(PS_WATASHI_MO_MAZETE)
        block1 = parsed['effect_blocks'][0]
        effects = block1['effects']
        self.assertEqual(len(effects), 1)
        self.assertEqual(effects[0]['effect_type'], 'damage')
        self.assertEqual(effects[0]['target_identifier'], 'attacked_targets')
        self.assertEqual(effects[0]['value_tag'], '威力')
        self.assertTrue(effects[0]['flags'].get('is_follow_up'))


if __name__ == '__main__':
    unittest.main()
