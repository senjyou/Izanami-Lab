# Part 5: _apply_guard new mechanism (attacker_action)
# ═══════════════════════════════════════════════════════════════════════

class TestApplyGuardNewMechanism(_BaseCoverGuardTest):
    """_apply_guard: new mechanism (duration_type='attacker_action')."""

    def test_new_mechanism_sets_guard_rate_and_active(self):
        """duration_type='attacker_action' → sets guard_rate and guard_active, no buff."""
        caster = _make_unit("guarder", "守護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130034
        effect = _make_effect(effect_type='guard', value_tag='guard', value=None,
                              duration_type='attacker_action')

        ss._resolver = MagicMock()
        ss._resolver._resolve_template_tags.return_value = {'guard': 50.0}

        result = ss._apply_guard(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['effect_type'], 'guard')
        self.assertEqual(result['guard_rate'], 50.0)
        self.assertEqual(result['caster_id'], caster.unit_id)
        # New mechanism: state set on caster, NO buff added
        self.assertEqual(caster.guard_rate, 50.0)
        self.assertTrue(caster.guard_active)
        guard_buffs = [b for b in caster.buffs if b.effect_type == GUARD]
        self.assertEqual(len(guard_buffs), 0,
                         "new mechanism should NOT add a buff")

    def test_new_mechanism_overwrites_previous_rate(self):
        """Setting guard_rate twice overwrites previous value."""
        caster = _make_unit("guarder", "守護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130034

        # First call: guard_rate=30
        effect1 = _make_effect(effect_type='guard', value_tag='guard', value=None,
                               duration_type='attacker_action')
        ss._resolver = MagicMock()
        ss._resolver._resolve_template_tags.return_value = {'guard': 30.0}
        ss._apply_guard(caster, effect1, bf)
        self.assertEqual(caster.guard_rate, 30.0)

        # Second call: guard_rate=70 (overwrite)
        effect2 = _make_effect(effect_type='guard', value_tag='guard', value=None,
                               duration_type='attacker_action')
        ss._resolver._resolve_template_tags.return_value = {'guard': 70.0}
        ss._apply_guard(caster, effect2, bf)
        self.assertEqual(caster.guard_rate, 70.0)
        self.assertTrue(caster.guard_active)


# ═══════════════════════════════════════════════════════════════════════
# Part 6: _apply_guard legacy buff mechanism
# ═══════════════════════════════════════════════════════════════════════

class TestApplyGuardLegacyBuff(_BaseCoverGuardTest):
    """_apply_guard: legacy buff mechanism (no duration_type='attacker_action')."""

    def test_legacy_mechanism_adds_guard_buff(self):
        """Legacy mechanism (no duration_type) → adds a GUARD buff via _apply_aura."""
        caster = _make_unit("guarder", "守護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130009
        # target_type='self' required for _apply_aura to find the caster as target
        effect = _make_effect(effect_type='guard', value_tag='guard', value=None,
                              duration_type=None, target_type='self')

        ss._resolver = MagicMock()
        ss._resolver._resolve_template_tags.return_value = {'guard': 40.0}

        result = ss._apply_guard(caster, effect, bf)

        # Legacy mechanism adds a buff to caster.buffs
        guard_buffs = [b for b in caster.buffs if b.effect_type == GUARD]
        self.assertGreaterEqual(len(guard_buffs), 1,
                                "legacy mechanism should add a GUARD buff")
        self.assertEqual(guard_buffs[0].value, 40.0,
                         "buff value should be the resolved guard_value")
        # Caster state should NOT be set by legacy mechanism
        self.assertFalse(caster.guard_active,
                         "legacy mechanism should NOT set guard_active")
        self.assertEqual(caster.guard_rate, 0.0,
                         "legacy mechanism should NOT set guard_rate")

    def test_legacy_mechanism_does_not_set_guard_active(self):
        """Legacy mechanism does not modify caster.guard_active / guard_rate."""
        caster = _make_unit("guarder", "守護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130009
        effect = _make_effect(effect_type='guard', value_tag='guard', value=None,
                              duration_type=None, target_type='self')

        ss._resolver = MagicMock()
        ss._resolver._resolve_template_tags.return_value = {'guard': 60.0}

        ss._apply_guard(caster, effect, bf)

        self.assertFalse(caster.guard_active)
        self.assertEqual(caster.guard_rate, 0.0)


# ═══════════════════════════════════════════════════════════════════════
# Part 7: _apply_cover_to_targets
# ═══════════════════════════════════════════════════════════════════════

class TestApplyCoverToTargets(_BaseCoverGuardTest):
    """_apply_cover_to_targets: target replacement and state recording."""

    def test_no_active_cover_no_change(self):
        """No active cover (no unit has cover_target) → targets unchanged."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        coverer = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(attacker, target, coverer)
        ss, *_ = self._make_services(bf)
        # No cover_target set anywhere
        targets = [target]

        ss._apply_cover_to_targets(attacker, targets, bf)

        # targets unchanged
        self.assertEqual(len(targets), 1)
        self.assertEqual(targets[0].unit_id, target.unit_id)

    def test_cover_replaces_target_with_coverer(self):
        """When cover_target matches a target, replace it with the coverer."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        coverer = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        coverer.cover_target = target.unit_id
        coverer.guard_active = True
        coverer.guard_rate = 30.0
        bf = _make_bf(attacker, target, coverer)
        ss, *_ = self._make_services(bf)
        targets = [target]

        ss._apply_cover_to_targets(attacker, targets, bf)

        # targets[0] should now be coverer
        self.assertEqual(targets[0].unit_id, coverer.unit_id)
        # _cover_replaced_indices should record index 0
        self.assertIn(0, ss._cover_replaced_indices)
        # _cover_info should record original target and guard_rate
        self.assertIn(coverer.unit_id, ss._cover_info)
        info = ss._cover_info[coverer.unit_id]
        self.assertEqual(info['original_target'].unit_id, target.unit_id)
        self.assertEqual(info['covered_unit_id'], target.unit_id)
        self.assertEqual(info['guard_rate'], 30.0)
        self.assertFalse(info['is_self_also_target'])

    def test_cover_not_triggered_when_target_not_in_list(self):
        """cover_target is set but original target is not in current attack targets → no replacement."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target_a = _make_unit("a", "A", Side.ALLY, Position.ALLY_LEFT_FRONT)
        target_b = _make_unit("b", "B", Side.ALLY, Position.ALLY_CENTER_FRONT)
        coverer = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        coverer.cover_target = target_b.unit_id  # covers B, but only A is attacked
        bf = _make_bf(attacker, target_a, target_b, coverer)
        ss, *_ = self._make_services(bf)
        targets = [target_a]

        ss._apply_cover_to_targets(attacker, targets, bf)

        # No replacement: targets unchanged
        self.assertEqual(targets[0].unit_id, target_a.unit_id)

    def test_coverer_also_in_targets_is_self_also_target_true(self):
        """When coverer is also in target list, is_self_also_target=True."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        coverer = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        coverer.cover_target = target.unit_id
        bf = _make_bf(attacker, target, coverer)
        ss, *_ = self._make_services(bf)
        # Both target and coverer are in attack targets (e.g., AoE attack)
        targets = [target, coverer]

        ss._apply_cover_to_targets(attacker, targets, bf)

        # targets[0] replaced with coverer
        self.assertEqual(targets[0].unit_id, coverer.unit_id)
        # targets[1] remains coverer (coverer was already there)
        self.assertEqual(targets[1].unit_id, coverer.unit_id)
        # is_self_also_target=True
        info = ss._cover_info[coverer.unit_id]
        self.assertTrue(info['is_self_also_target'])

    def test_multiple_coverers_each_replace_their_target(self):
        """Multiple coverers, each covering a different target → all replaced."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target_a = _make_unit("a", "A", Side.ALLY, Position.ALLY_LEFT_FRONT)
        target_b = _make_unit("b", "B", Side.ALLY, Position.ALLY_CENTER_FRONT)
        coverer_a = _make_unit("ca", "援護A", Side.ALLY, Position.ALLY_LEFT_BACK)
        coverer_b = _make_unit("cb", "援護B", Side.ALLY, Position.ALLY_RIGHT_BACK)
        coverer_a.cover_target = target_a.unit_id
        coverer_b.cover_target = target_b.unit_id
        bf = _make_bf(attacker, target_a, target_b, coverer_a, coverer_b)
        ss, *_ = self._make_services(bf)
        targets = [target_a, target_b]

        ss._apply_cover_to_targets(attacker, targets, bf)

        # Both replaced
        self.assertEqual(targets[0].unit_id, coverer_a.unit_id)
        self.assertEqual(targets[1].unit_id, coverer_b.unit_id)
        self.assertIn(0, ss._cover_replaced_indices)
        self.assertIn(1, ss._cover_replaced_indices)

    def test_cover_replaced_indices_reset_each_call(self):
        """_cover_replaced_indices is reset on each call (no stale state)."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        coverer = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        coverer.cover_target = target.unit_id
        bf = _make_bf(attacker, target, coverer)
        ss, *_ = self._make_services(bf)

        # First call: index 0 is replaced
        ss._apply_cover_to_targets(attacker, [target], bf)
        self.assertIn(0, ss._cover_replaced_indices)

        # Second call: no active cover (cover_target cleared), targets unchanged
        coverer.cover_target = None
        ss._apply_cover_to_targets(attacker, [target], bf)
        self.assertEqual(len(ss._cover_replaced_indices), 0,
                         "indices should be reset when no cover active")


# ═══════════════════════════════════════════════════════════════════════
# Part 8: Guard rate application in damage calculation
# ═══════════════════════════════════════════════════════════════════════

class TestGuardRateInDamage(_BaseCoverGuardTest):
    """Guard rate application in damage calculation."""

    def test_guard_buff_reduces_regular_damage(self):
        """Legacy GUARD buff reduces regular damage by (1 - guard_rate)."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                              atk=20000, defense=0)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=100000, atk=100, defense=0)
        # Add guard buff: 50% reduction
        target.buffs.append(BuffState(
            buff_id="guard_buff_1", name="Guard", effect_type=GUARD,
            value=50.0, duration=-1, timing_type=2,
            value_tag=0, source_unit_id=target.unit_id, source_skill_id=130009,
            is_debuff=False, attack_limited=1, triggered_by_attacker=attacker.unit_id,
        ))
        bf = _make_bf(attacker, target)
        ss, *_ = self._make_services(bf)
        ss.set_battlefield(bf)
        # Initialize internal state normally set by execute_skill
        ss._most_recent_damage = 0
        ss._hp_consumed = 0
        ss._per_hit_hp_losses = {}
        ss._block_damage_targets = {}
        ss._block_evaded_targets = set()
        ss._current_attack_targets = []
        ss._original_primary_target = None
        ss._cover_replaced_indices = set()

        # Force no crit for deterministic test
        ss.damage_service.clear_crit_override()

        effect = _make_effect(
            effect_type='damage', value=100.0, target_type='enemy_single',
            flags={}, value_tag=None, hit_count=1,
        )
        effect.target_type = 'enemy_single'
        ss._current_skill_id = 110001

        hp_before = target.current_hp
        ss._apply_damage(attacker, effect, bf)

        # Damage formula: atk=20000, def=0, power=100% → base=20000
        # Without guard: 20000 dmg, hp_loss=20000
        # With 50% guard: dmg=20000*0.5=10000
        hp_loss = hp_before - target.current_hp
        self.assertLess(hp_loss, 20000, "guard should reduce damage")
        self.assertGreater(hp_loss, 0, "should still take some damage")
        # Approximate: ~10000 (may differ slightly due to attribute factor and rounding)
        self.assertLess(abs(hp_loss - 10000), 2000,
                        f"damage should be ~10000 (50% guard), got {hp_loss}")

    def test_guard_active_state_reduces_cover_damage(self):
        """guard_active=True (new mechanism) reduces damage on cover replacement targets.

        Note: This tests that the new mechanism's guard_rate is applied when cover_target
        is active. The actual application happens in _apply_cover_to_targets which sets
        guard_rate in _cover_info, but the damage reduction for new mechanism is done
        via the state on the coverer (guard_active=True).
        """
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                              atk=20000, defense=0)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=100000, atk=100, defense=0)
        coverer = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK,
                             hp=100000, atk=100, defense=0)
        # Set cover state on coverer
        coverer.cover_target = target.unit_id
        coverer.guard_active = True
        coverer.guard_rate = 50.0
        bf = _make_bf(attacker, target, coverer)
        ss, *_ = self._make_services(bf)
        ss.set_battlefield(bf)

        # Verify state is set
        self.assertTrue(coverer.guard_active)
        self.assertEqual(coverer.guard_rate, 50.0)

        # Apply cover replacement
        targets = [target]
        ss._apply_cover_to_targets(attacker, targets, bf)

        # target replaced with coverer
        self.assertEqual(targets[0].unit_id, coverer.unit_id)
        # _cover_info should record guard_rate from coverer.guard_active state
        info = ss._cover_info[coverer.unit_id]
        self.assertEqual(info['guard_rate'], 50.0,
                         "guard_rate should come from coverer.guard_rate when guard_active=True")

    def test_guard_zero_when_guard_active_false(self):
        """guard_active=False → guard_rate in _cover_info should be 0 even if guard_rate>0."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        coverer = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        coverer.cover_target = target.unit_id
        coverer.guard_active = False  # not active
        coverer.guard_rate = 50.0  # but rate set (legacy state)
        bf = _make_bf(attacker, target, coverer)
        ss, *_ = self._make_services(bf)

        targets = [target]
        ss._apply_cover_to_targets(attacker, targets, bf)

        info = ss._cover_info[coverer.unit_id]
        self.assertEqual(info['guard_rate'], 0.0,
                         "guard_rate in _cover_info should be 0 when guard_active=False")


# ═══════════════════════════════════════════════════════════════════════
# Part 9: _cleanup_guard_buffs
# ═══════════════════════════════════════════════════════════════════════

class TestCleanupGuardBuffs(_BaseCoverGuardTest):
    """_cleanup_guard_buffs: state cleanup at attacker action end."""

    def _make_controller(self, bf):
        return BattleFlowController(bf, BattleConfig(max_turns=5), data_loader=self.dl)

    def test_cleanup_clears_cover_state(self):
        """_cleanup_guard_buffs clears cover_target, guard_active, guard_rate, reflect_rate."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        coverer = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        coverer.cover_target = "some_target"
        coverer.cover_skill_id = 130034
        coverer.guard_rate = 50.0
        coverer.guard_active = True
        coverer.reflect_rate = 30.0
        bf = _make_bf(attacker, coverer)
        ctrl = self._make_controller(bf)

        ctrl._cleanup_guard_buffs(attacker)

        self.assertIsNone(coverer.cover_target)
        self.assertEqual(coverer.cover_skill_id, 0)
        self.assertEqual(coverer.guard_rate, 0.0)
        self.assertFalse(coverer.guard_active)
        self.assertEqual(coverer.reflect_rate, 0.0)

    def test_cleanup_removes_guard_buff_triggered_by_attacker(self):
        """Legacy GUARD buff with triggered_by_attacker matching attacker is removed."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        guard_buff = BuffState(
            buff_id="gb1", name="Guard", effect_type=GUARD,
            value=50.0, duration=-1, timing_type=2,
            source_unit_id=target.unit_id, source_skill_id=130009,
            is_debuff=False, attack_limited=1,
            triggered_by_attacker=attacker.unit_id,
        )
        target.buffs.append(guard_buff)
        bf = _make_bf(attacker, target)
        ctrl = self._make_controller(bf)

        ctrl._cleanup_guard_buffs(attacker)

        guard_buffs = [b for b in target.buffs if b.effect_type == GUARD]
        self.assertEqual(len(guard_buffs), 0,
                         "guard buff triggered by attacker should be removed")

    def test_cleanup_does_not_remove_guard_buff_from_other_attacker(self):
        """GUARD buff with triggered_by_attacker != this attacker is NOT removed."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        other_attacker = _make_unit("other", "他攻撃者", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        # Guard buff triggered by OTHER attacker
        guard_buff = BuffState(
            buff_id="gb1", name="Guard", effect_type=GUARD,
            value=50.0, duration=-1, timing_type=2,
            source_unit_id=target.unit_id, source_skill_id=130009,
            is_debuff=False, attack_limited=1,
            triggered_by_attacker=other_attacker.unit_id,
        )
        target.buffs.append(guard_buff)
        bf = _make_bf(attacker, other_attacker, target)
        ctrl = self._make_controller(bf)

        ctrl._cleanup_guard_buffs(attacker)

        guard_buffs = [b for b in target.buffs if b.effect_type == GUARD]
        self.assertEqual(len(guard_buffs), 1,
                         "guard buff from OTHER attacker should NOT be removed")

    def test_cleanup_keeps_attacker_action_buff_with_just_applied_and_duration_gt_0(self):
        """attacker_action buff with just_applied=True and duration>0 is protected (not removed)."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        protected_buff = BuffState(
            buff_id="hb1", name="heal_link", effect_type="HealLink",
            value=100.0, duration=1, timing_type=2,
            source_unit_id=attacker.unit_id, source_skill_id=120154,
            is_debuff=False, original_duration_type='attacker_action',
            just_applied=True,
        )
        target.buffs.append(protected_buff)
        bf = _make_bf(attacker, target)
        ctrl = self._make_controller(bf)

        ctrl._cleanup_guard_buffs(attacker)

        retained = [b for b in target.buffs if b.buff_id == "hb1"]
        self.assertEqual(len(retained), 1,
                         "just_applied + duration>0 attacker_action buff should be retained")

    def test_cleanup_removes_attacker_action_buff_when_not_just_applied(self):
        """attacker_action buff with just_applied=False (next action end) is removed."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        expired_buff = BuffState(
            buff_id="hb1", name="heal_link", effect_type="HealLink",
            value=100.0, duration=1, timing_type=2,
            source_unit_id=attacker.unit_id, source_skill_id=120154,
            is_debuff=False, original_duration_type='attacker_action',
            just_applied=False,
        )
        target.buffs.append(expired_buff)
        bf = _make_bf(attacker, target)
        ctrl = self._make_controller(bf)

        ctrl._cleanup_guard_buffs(attacker)

        retained = [b for b in target.buffs if b.buff_id == "hb1"]
        self.assertEqual(len(retained), 0,
                         "just_applied=False attacker_action buff should be removed")

    def test_cleanup_skips_dead_units(self):
        """_cleanup_guard_buffs skips dead units (no crash)."""
        attacker = _make_unit("attacker", "攻撃者", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        dead_coverer = _make_unit("dead", "死者", Side.ALLY, Position.ALLY_LEFT_BACK)
        dead_coverer.is_alive = False
        dead_coverer.cover_target = "some_target"
        dead_coverer.guard_active = True
        bf = _make_bf(attacker, dead_coverer)
        ctrl = self._make_controller(bf)

        # Should not crash; dead unit skipped
        ctrl._cleanup_guard_buffs(attacker)

        # Dead unit's state may or may not be cleared (skipped in loop),
        # but the function should not crash
        # Per the code: `if not unit.is_alive: continue` so dead unit NOT cleaned
        self.assertEqual(dead_coverer.cover_target, "some_target",
                         "dead unit should be skipped (state unchanged)")


# ═══════════════════════════════════════════════════════════════════════
# Part 10: _has_active_cover
# ═══════════════════════════════════════════════════════════════════════

class TestHasActiveCover(_BaseCoverGuardTest):
    """_has_active_cover: detect any unit with cover_target set."""

    def test_no_active_cover_returns_false(self):
        """No unit has cover_target → False."""
        attacker = _make_unit("a", "A", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target = _make_unit("t", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(attacker, target)
        ss, *_ = self._make_services(bf)

        self.assertFalse(ss._has_active_cover(bf))

    def test_active_cover_returns_true(self):
        """At least one alive unit has cover_target → True."""
        attacker = _make_unit("a", "A", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        target = _make_unit("t", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        coverer = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        coverer.cover_target = target.unit_id
        bf = _make_bf(attacker, target, coverer)
        ss, *_ = self._make_services(bf)

        self.assertTrue(ss._has_active_cover(bf))

    def test_dead_unit_with_cover_target_returns_false(self):
        """Dead unit with cover_target is not counted (is_alive check)."""
        attacker = _make_unit("a", "A", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        dead_coverer = _make_unit("c", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        dead_coverer.is_alive = False
        dead_coverer.cover_target = "someone"
        bf = _make_bf(attacker, dead_coverer)
        ss, *_ = self._make_services(bf)

        self.assertFalse(ss._has_active_cover(bf),
                         "dead unit with cover_target should not count as active cover")


if __name__ == '__main__':
    unittest.main()
