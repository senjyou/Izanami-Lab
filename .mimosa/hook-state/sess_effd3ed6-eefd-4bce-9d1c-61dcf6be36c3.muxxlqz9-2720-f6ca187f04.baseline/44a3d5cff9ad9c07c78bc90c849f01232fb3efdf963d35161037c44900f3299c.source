"""Unit tests for _apply_cover / _apply_guard / _apply_cover_to_targets.

Tests cover:
- _apply_cover: cover target selection (true AoE vs non-true AoE),
  position priority, side handling, state setting, return structure
- _apply_guard: new mechanism (attacker_action) vs legacy buff mechanism,
  value_tag resolution, entry checks
- _apply_cover_to_targets: target replacement, _cover_replaced_indices,
  _cover_info recording, multiple coverers
- Guard rate application in damage calc (regular/ADD_DAMAGE/ENCHANT_DAMAGE/sub_unit)
- _cleanup_guard_buffs: state cleanup at attacker action end
"""
import sys
import os
import unittest
from unittest.mock import MagicMock

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig


GUARD = SkillEffectType.GUARD.value


def _make_unit(unit_id, name, side, position, *, hp=50000, atk=10000,
               defense=4000, speed=500, current_hp=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=2, character_type=1,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


def _make_effect(**kwargs):
    """Create a mock effect object with attributes."""
    defaults = {
        'effect_type': 'cover',
        'value': None,
        'value_tag': None,
        'target_type': None,
        'flags': {},
        'target_identifier': None,
        'hit_count': None,
        'condition': None,
        'duration_type': None,
        'ignore_defense': False,
        'ignore_shield': False,
    }
    defaults.update(kwargs)
    obj = type('obj', (object,), defaults)()
    return obj


class _BaseCoverGuardTest(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts, aus, dms, sts


# ═══════════════════════════════════════════════════════════════════════
# Part 1: _apply_cover entry checks
# ═══════════════════════════════════════════════════════════════════════

class TestApplyCoverEntry(_BaseCoverGuardTest):
    """_apply_cover: entry checks (no candidates / no ally / all dead)."""

    def test_no_pre_scanned_candidates_and_no_attack_targets_returns_none(self):
        """No _pre_scanned_cover_candidates and no _current_attack_targets → None."""
        caster = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._pre_scanned_cover_candidates = []
        ss._current_attack_targets = []

        result = ss._apply_cover(caster, _make_effect(), bf)

        self.assertIsNone(result)
        self.assertIsNone(caster.cover_target)

    def test_only_caster_in_candidates_returns_none(self):
        """When candidates only contain the caster (PS holder), no ally to cover → None."""
        caster = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._pre_scanned_cover_candidates = [caster]  # only caster
        ss._current_attack_targets = []

        result = ss._apply_cover(caster, _make_effect(), bf)

        self.assertIsNone(result)
        self.assertIsNone(caster.cover_target)

    def test_all_candidates_dead_returns_none(self):
        """When all candidates are dead → None."""
        caster = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        target.is_alive = False
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._pre_scanned_cover_candidates = [target]
        ss._current_attack_targets = []

        result = ss._apply_cover(caster, _make_effect(), bf)

        self.assertIsNone(result)
        self.assertIsNone(caster.cover_target)

    def test_fallback_to_current_attack_targets_when_no_pre_scanned(self):
        """When _pre_scanned_cover_candidates is empty, fall back to _current_attack_targets."""
        caster = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._pre_scanned_cover_candidates = []
        ss._current_attack_targets = [target]
        ss._current_skill_id = 130013

        result = ss._apply_cover(caster, _make_effect(), bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['effect_type'], 'cover')
        self.assertEqual(result['target_id'], target.unit_id)
        self.assertEqual(caster.cover_target, target.unit_id)


# ═══════════════════════════════════════════════════════════════════════
# Part 2: _apply_cover target selection
# ═══════════════════════════════════════════════════════════════════════

class TestApplyCoverTargetSelection(_BaseCoverGuardTest):
    """_apply_cover: cover target selection logic."""

    def test_non_true_aoe_selects_nearest_ally(self):
        """Non-true AoE: select the nearest ally from attack targets.
        Caster at ALLY_LEFT_BACK, candidates at LEFT_FRONT (dist=1) and CENTER_FRONT (dist=2).
        Select LEFT_FRONT (nearest).
        """
        caster = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        ally_left = _make_unit("ally_left", "左前", Side.ALLY, Position.ALLY_LEFT_FRONT)
        ally_center = _make_unit("ally_center", "中前", Side.ALLY, Position.ALLY_CENTER_FRONT)
        enemy = _make_unit("enemy", "敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        bf = _make_bf(caster, ally_left, ally_center, enemy)
        ss, *_ = self._make_services(bf)
        ss._pre_scanned_cover_candidates = [ally_left, ally_center]
        ss._current_skill_id = 130013

        result = ss._apply_cover(caster, _make_effect(), bf)

        # ally_left (LEFT_FRONT) is distance 1 from LEFT_BACK → nearest
        self.assertEqual(result['target_id'], ally_left.unit_id)
        self.assertEqual(caster.cover_target, ally_left.unit_id)

    def test_non_true_aoe_same_distance_prefers_front_row(self):
        """Same distance → prefer front row.
        Caster at LEFT_BACK, both candidates at distance 1: LEFT_FRONT (front) and CENTER_BACK (back).
        Both distance=1 from LEFT_BACK, but LEFT_FRONT is front row.
        """
        caster = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        ally_left_front = _make_unit("ally_lf", "左前", Side.ALLY, Position.ALLY_LEFT_FRONT)
        ally_center_back = _make_unit("ally_cb", "中後", Side.ALLY, Position.ALLY_CENTER_BACK)
        enemy = _make_unit("enemy", "敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        bf = _make_bf(caster, ally_left_front, ally_center_back, enemy)
        ss, *_ = self._make_services(bf)
        # Same distance: LEFT_BACK → LEFT_FRONT = (0,0)-(1,0) = 1
        #                LEFT_BACK → CENTER_BACK = (1,1)-(1,0) = 1
        # Tiebreaker: front row (is_front=0 for LEFT_FRONT, is_front=1 for CENTER_BACK)
        ss._pre_scanned_cover_candidates = [ally_left_front, ally_center_back]
        ss._current_skill_id = 130013

        result = ss._apply_cover(caster, _make_effect(), bf)

        self.assertEqual(result['target_id'], ally_left_front.unit_id,
                         "front row should be preferred at same distance")

    def test_true_aoe_selects_by_position_number_left_front(self):
        """True AoE: select by position number priority (left_front > center_front > right_front > ...).
        Set up: caster at LEFT_BACK, all 3 front allies + caster in attack targets.
        Expected: LEFT_FRONT (position number=1) selected.
        """
        caster = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        ally_left = _make_unit("ally_left", "左前", Side.ALLY, Position.ALLY_LEFT_FRONT)
        ally_center = _make_unit("ally_center", "中前", Side.ALLY, Position.ALLY_CENTER_FRONT)
        ally_right = _make_unit("ally_right", "右前", Side.ALLY, Position.ALLY_RIGHT_FRONT)
        enemy = _make_unit("enemy", "敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        bf = _make_bf(caster, ally_left, ally_center, ally_right, enemy)
        ss, *_ = self._make_services(bf)
        # True AoE: all alive allies except caster are in attack targets
        ss._pre_scanned_cover_candidates = [ally_left, ally_center, ally_right]
        ss._current_skill_id = 130013

        result = ss._apply_cover(caster, _make_effect(), bf)

        # Position numbers: LEFT_FRONT=1, CENTER_FRONT=2, RIGHT_FRONT=3
        # Expected: LEFT_FRONT (num=1)
        self.assertEqual(result['target_id'], ally_left.unit_id,
                         "true AoE should select LEFT_FRONT (position number=1)")

    def test_true_aoe_prefers_front_over_back_when_front_present(self):
        """True AoE: front row always preferred over back row.
        Set up: caster at LEFT_BACK, all 4 allies (2 front + 2 back) in attack targets.
        Expected: LEFT_FRONT selected (front=1 beats back=4).
        """
        caster = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        ally_center_front = _make_unit("ally_cf", "中前", Side.ALLY, Position.ALLY_CENTER_FRONT)
        ally_right_front = _make_unit("ally_rf", "右前", Side.ALLY, Position.ALLY_RIGHT_FRONT)
        ally_left_back = _make_unit("ally_lb", "左後", Side.ALLY, Position.ALLY_LEFT_BACK)
        ally_center_back = _make_unit("ally_cb", "中後", Side.ALLY, Position.ALLY_CENTER_BACK)
        bf = _make_bf(caster, ally_center_front, ally_right_front, ally_left_back, ally_center_back)
        ss, *_ = self._make_services(bf)
        # True AoE: 4 allies (excl caster) in attack targets
        ss._pre_scanned_cover_candidates = [ally_center_front, ally_right_front,
                                            ally_left_back, ally_center_back]
        ss._current_skill_id = 130013

        result = ss._apply_cover(caster, _make_effect(), bf)

        # Position numbers: CENTER_FRONT=2 (smallest among 2,3,4,5)
        self.assertEqual(result['target_id'], ally_center_front.unit_id,
                         "true AoE should select CENTER_FRONT (position number=2, smallest)")


