# Part 4: _apply_guard entry checks & value resolution
# ═══════════════════════════════════════════════════════════════════════

class TestApplyGuardEntry(_BaseCoverGuardTest):
    """_apply_guard: entry checks (value resolution, skip conditions)."""

    def test_guard_value_zero_skip(self):
        """When guard value_tag resolves to 0 → skip, return None."""
        caster = _make_unit("guarder", "守護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130009
        effect = _make_effect(effect_type='guard', value_tag='guard', value=None,
                              duration_type=None)

        # Mock _resolver._resolve_template_tags to return guard=0
        ss._resolver = MagicMock()
        ss._resolver._resolve_template_tags.return_value = {'guard': 0.0}

        result = ss._apply_guard(caster, effect, bf)

        self.assertIsNone(result)
        self.assertEqual(caster.guard_rate, 0.0)
        self.assertFalse(caster.guard_active)

    def test_no_value_tag_skip(self):
        """When value_tag is None → guard_value stays 0 → skip."""
        caster = _make_unit("guarder", "守護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._current_skill_id = 130009
        effect = _make_effect(effect_type='guard', value_tag=None, value=None,
                              duration_type=None)

        result = ss._apply_guard(caster, effect, bf)

        self.assertIsNone(result)


