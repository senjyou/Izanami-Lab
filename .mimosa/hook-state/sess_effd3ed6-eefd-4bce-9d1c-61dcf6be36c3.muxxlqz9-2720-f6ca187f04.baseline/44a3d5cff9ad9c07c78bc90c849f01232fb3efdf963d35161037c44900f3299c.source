class TestApplyCoverSideAndReturn(_BaseCoverGuardTest):
    """_apply_cover: side handling (enemy caster) and return structure."""

    def test_enemy_caster_covers_enemy_target(self):
        """Enemy caster covers enemy target (uses enemy_team)."""
        caster = _make_unit("enemy_coverer", "敵援護", Side.ENEMY, Position.ENEMY_LEFT_BACK)
        target = _make_unit("enemy_target", "敵目標", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        ally = _make_unit("ally", "味方", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target, ally)
        ss, *_ = self._make_services(bf)
        ss._pre_scanned_cover_candidates = [target]
        ss._current_skill_id = 130013

        result = ss._apply_cover(caster, _make_effect(), bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['target_id'], target.unit_id)
        self.assertEqual(caster.cover_target, target.unit_id)

    def test_return_structure_has_required_fields(self):
        """Return dict contains effect_type, target_id, caster_id."""
        caster = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._pre_scanned_cover_candidates = [target]
        ss._current_skill_id = 130013

        result = ss._apply_cover(caster, _make_effect(), bf)

        self.assertEqual(result['effect_type'], 'cover')
        self.assertEqual(result['target_id'], target.unit_id)
        self.assertEqual(result['caster_id'], caster.unit_id)

    def test_cover_skill_id_set_on_caster(self):
        """cover_skill_id is set to _current_skill_id on caster."""
        caster = _make_unit("coverer", "援護者", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._pre_scanned_cover_candidates = [target]
        ss._current_skill_id = 130034

        ss._apply_cover(caster, _make_effect(), bf)

        self.assertEqual(caster.cover_skill_id, 130034)


