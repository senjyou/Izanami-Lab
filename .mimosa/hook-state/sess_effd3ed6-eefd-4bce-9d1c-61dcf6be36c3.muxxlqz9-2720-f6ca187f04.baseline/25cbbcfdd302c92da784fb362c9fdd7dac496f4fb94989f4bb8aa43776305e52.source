#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
角色106301技能验证测试

技能列表:
  - 110002 一日一不憫 (EX): 敌全体5hit EN攻击(威力)
    会心攻击发生时: 一時的dmg_taken_up 100%(hit_limited:1, stackable) + 1hit EN追击(威力)
  - 120014 エクスペクトボーダー (AS): 敌横一列EN攻击(威力)
    会心攻击发生时: 战斗结束前dmg_taken_up 5%(stackable)
    Lv11+: 额外crit_rate_down {crt}%(stackable)
  - 130010 アフターライズ (PS): 自身AS攻击后 → 自身crit_rate_up{crt}% 1行动(stackable)
    Lv11+: 额外最高ATK友方crit_rate_up{add}% 1行动(stackable)
  - 130023 ハイサポート (PS): 回合开始时(非1回合目) → 最高ATK友方atk_up{atk}% + crit_rate_up{crt}% 1行动(stackable)
  - 130039 スキルリレイティブ (PS): 自身被上debuff时 → 自身crit_rate_up{crt}% 2行动
    Lv11+: 额外对debuff来源施加dmg_taken_up{dmg}%(hit_limited:1, stackable)
"""

import sys
import os
import time
import logging
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))

from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.entities_v2.custom_dummy import (
    CustomDummyConfig, build_synthetic_character_data, build_custom_skill_data,
    build_custom_parsed_skill, collect_custom_skill_ids,
)
from src.combat_v2.battle_flow_controller import BattleFlowController
from src.combat_v2.battle_narrative import BattleNarrativeWriter
from src.data.data_loader import DataLoader
from src.data.stat_calculator import StatCalculator
from src.config.panel_config import PanelConfig, ModuleConfig
from src.config.player_config import SchoolLevels


class LogCaptureHandler(logging.Handler):
    def __init__(self):
        super().__init__()
        self.records = []

    def emit(self, record):
        self.records.append(record.getMessage())


def create_dummy_unit(data_loader, name, side, pos, char_id, hp, atk, defense, speed,
                      ap, pp, ep_max=8, role_type=0, position_type=3, element=1, char_type=1):
    cfg = CustomDummyConfig(
        name=name,
        element=element,
        character_type=char_type,
        position_type=position_type,
        role_type=role_type if role_type > 0 else 1,
        hp=hp,
        attack=atk,
        defense=defense,
        speed=speed,
        ap=ap,
        pp=pp,
    )
    char_data = build_synthetic_character_data(abs(char_id) - 1, cfg)
    char_data.character_id = char_id
    data_loader._custom_characters[char_id] = char_data

    base_idx = abs(char_id) - 1
    as_skill = build_custom_skill_data(
        base_idx, False, 1, "通常攻撃", 100, 1, 0, 1, 3, 1, 1, 1
    )
    data_loader._custom_skills[as_skill.skill_id] = as_skill
    as_parsed = build_custom_parsed_skill(
        base_idx, False, 1, 3, 1, 1
    )
    data_loader._custom_parsed_skills[str(as_skill.skill_id)] = as_parsed
    data_loader._custom_character_skills[char_id] = [as_skill.skill_id]
    data_loader._custom_dummy_configs[char_id] = cfg

    side_prefix = "F" if side == Side.ALLY else "E"
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}",
        name=name,
        side=side,
        position=pos,
        character_id=char_id,
        level=200,
        element=cfg.element,
        character_type=cfg.character_type,
        max_hp=hp,
        current_hp=hp,
        attack=atk,
        defense=defense,
        speed=speed,
        crit_rate=0.15,
        crit_damage=0.5,
        advantage_damage=0.25,
        initial_active_point=ap,
        initial_passive_point=pp,
        max_extra_point=ep_max,
        current_ap=ap,
        current_pp=pp,
        current_ep=0,
        skills=[as_skill.skill_id],
        skill_levels={as_skill.skill_id: 1},
        skill_cooldowns={},
        role_type=role_type,
        position_type=position_type,
    )


def create_character_unit(data_loader, stat_calculator, char_id, side, pos,
                          panel_config, player_config, fury_count=0):
    char = data_loader.get_character_by_id(char_id)
    if not char:
        raise ValueError(f"Character {char_id} not found!")
    char_config = panel_config.get_character_config(char_id, char.default_rarity)
    stats = stat_calculator.calculate_stats(char_config, player_config)
    char_skills = data_loader.load_character_skills()
    skills = char_skills.get(char_id, [])
    side_prefix = "F" if side == Side.ALLY else "E"
    max_ep = 8
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}",
        name=char.name,
        side=side,
        position=pos,
        character_id=char_id,
        level=char_config.level,
        element=char.attribute,
        character_type=char.character_type,
        max_hp=stats.hp,
        current_hp=stats.hp,
        attack=stats.attack,
        defense=stats.defense,
        speed=stats.speed,
        crit_rate=stats.critical_rate,
        crit_damage=stats.critical_damage - 1.5,
        advantage_damage=stats.advantage_damage - 1.25,
        initial_active_point=stats.initial_ap,
        initial_passive_point=stats.initial_pp,
        max_extra_point=max_ep,
        current_ap=stats.initial_ap,
        current_pp=stats.initial_pp,
        current_ep=0,
        skills=skills,
        skill_levels=panel_config.skill_levels.get(char_id, {}),
        skill_cooldowns={},
        role_type=char.role_type,
        position_type=char.position_type,
        fury_count=fury_count,
    )


def _verify_and_print(bf, test_name, checks):
    print(f"\n{'─'*50}")
    print(f"[验证] {test_name}")
    print(f"{'─'*50}")
    passed = 0
    failed = 0
    for desc, condition, expected, actual in checks:
        status = "PASS" if condition else "FAIL"
        if condition:
            passed += 1
        else:
            failed += 1
        print(f"  [{status}] {desc}")
        if not condition:
            print(f"     期望: {expected}, 实际: {actual}")
    print(f"  结果: {passed}通过 / {failed}失败")
    return failed == 0


def run_test(name, friends_config, enemies_config, data_loader, panel_config,
             player_config, stat_calculator, memory_card_ids=None, test_index=0,
             capture_logs=False):
    print(f"\n{'='*60}")
    print(f"Test {test_index}: {name}")
    print(f"{'='*60}")

    bf = BattlefieldState()
    friends = []
    enemies = []

    for cfg in friends_config:
        if cfg.get("is_dummy"):
            u = create_dummy_unit(
                data_loader, cfg["name"], Side.ALLY, cfg["pos"], cfg["char_id"],
                cfg["hp"], cfg["atk"], cfg["defense"], cfg["speed"],
                cfg["ap"], cfg["pp"], cfg.get("ep", 8),
                cfg.get("role_type", 0),
                cfg.get("position_type", 3),
                cfg.get("element", 1),
                cfg.get("char_type", 1),
            )
        else:
            u = create_character_unit(
                data_loader, stat_calculator, cfg["char_id"],
                Side.ALLY, cfg["pos"], panel_config, player_config,
                fury_count=cfg.get("fury_count", 0),
            )
            cooldown_override = cfg.get("skill_cooldown_override", None)
            if cooldown_override:
                for sk_id, cd_val in cooldown_override.items():
                    u.skill_cooldowns[sk_id] = cd_val
            ep_override = cfg.get("ep_override", None)
            if ep_override is not None:
                u.current_ep = ep_override
            speed_override = cfg.get("speed_override", None)
            if speed_override is not None:
                u.speed = speed_override
            hp_override = cfg.get("hp_override", None)
            if hp_override is not None:
                u.current_hp = hp_override
            ap_override = cfg.get("ap_override", None)
            if ap_override is not None:
                u.current_ap = ap_override
            crit_override = cfg.get("crit_rate_override", None)
            if crit_override is not None:
                u.crit_rate = crit_override
            pre_buffs = cfg.get("pre_buffs", None)
            if pre_buffs:
                for b_data in pre_buffs:
                    bf_buff = BuffState(
                        buff_id=b_data.get("buff_id", "pre_buff"),
                        name=b_data.get("name", "PreBuff"),
                        effect_type=b_data.get("effect_type", "PreBuff"),
                        value=b_data.get("value", 0),
                        duration=b_data.get("duration", -1),
                        timing_type=b_data.get("timing_type", AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value),
                        source_unit_id=u.unit_id,
                        caster_attack=u.attack,
                        is_debuff=b_data.get("is_debuff", False),
                    )
                    if b_data.get("is_debuff"):
                        u.debuffs.append(bf_buff)
                    else:
                        u.buffs.append(bf_buff)
            pre_debuffs = cfg.get("pre_debuffs", None)
            if pre_debuffs:
                for b_data in pre_debuffs:
                    bf_debuff = BuffState(
                        buff_id=b_data.get("buff_id", "pre_debuff"),
                        name=b_data.get("name", "PreDebuff"),
                        effect_type=b_data.get("effect_type", "PreDebuff"),
                        value=b_data.get("value", 0),
                        duration=b_data.get("duration", -1),
                        timing_type=b_data.get("timing_type", AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value),
                        source_unit_id=u.unit_id,
                        caster_attack=u.attack,
                        is_debuff=True,
                    )
                    u.debuffs.append(bf_debuff)
        bf.add_unit(u)
        friends.append(u)

    for cfg in enemies_config:
        if cfg.get("is_dummy"):
            u = create_dummy_unit(
                data_loader, cfg["name"], Side.ENEMY, cfg["pos"], cfg["char_id"],
                cfg["hp"], cfg["atk"], cfg["defense"], cfg["speed"],
                cfg["ap"], cfg["pp"], cfg.get("ep", 8),
                cfg.get("role_type", 0),
                cfg.get("position_type", 3),
                cfg.get("element", 1),
                cfg.get("char_type", 1),
            )
        else:
            u = create_character_unit(
                data_loader, stat_calculator, cfg["char_id"],
                Side.ENEMY, cfg["pos"], panel_config, player_config,
            )
        hp_override = cfg.get("hp_override", None)
        if hp_override is not None:
            u.current_hp = hp_override
        pre_debuffs = cfg.get("pre_debuffs", None)
        if pre_debuffs:
            for b_data in pre_debuffs:
                bf_debuff = BuffState(
                    buff_id=b_data.get("buff_id", "pre_debuff"),
                    name=b_data.get("name", "PreDebuff"),
                    effect_type=b_data.get("effect_type", "PreDebuff"),
                    value=b_data.get("value", 0),
                    duration=b_data.get("duration", -1),
                    timing_type=b_data.get("timing_type", AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value),
                    source_unit_id=u.unit_id,
                    caster_attack=u.attack,
                    is_debuff=True,
                )
                u.debuffs.append(bf_debuff)
        bf.add_unit(u)
        enemies.append(u)

        if cfg.get("add_debuff_ps"):
            add_debuff_ps_to_enemy_dummy(data_loader, u, cfg["char_id"])

    print(f"  己方: {[f'{u.name}({u.position.name})' for u in friends]}")
    print(f"  敌方: {[f'{u.name}({u.position.name})' for u in enemies]}")
    for u in friends:
        print(f"    [{u.name}] HP={u.current_hp}/{u.max_hp} ATK={u.attack} DEF={u.defense} SPD={u.speed} EP={u.current_ep}/{u.max_extra_point} AP={u.current_ap} CRIT={u.crit_rate}")
    for u in enemies:
        print(f"    [{u.name}] HP={u.current_hp}/{u.max_hp} ATK={u.attack} DEF={u.defense} SPD={u.speed}")

    controller = BattleFlowController(
        bf, data_loader=data_loader,
        narrative=BattleNarrativeWriter(data_loader=data_loader)
    )

    log_records = []
    if capture_logs:
        capture_handler = LogCaptureHandler()
        battle_logger = logging.getLogger('MGGBattleSim')
        battle_logger.addHandler(capture_handler)
        old_level = battle_logger.level
        battle_logger.setLevel(logging.INFO)

    result = controller.execute_battle()

    if capture_logs:
        battle_logger.removeHandler(capture_handler)
        battle_logger.setLevel(old_level)
        log_records = capture_handler.records

    print(f"\n  战斗结果: {result['result']} | 回合: {result['total_turns']} | 胜者: {result['winner']}")
    for u in bf.get_all_units():
        s = f"HP={u.current_hp}/{u.max_hp}" if u.is_alive else "阵亡"
        shield_s = f" shield={u.shield}" if u.shield > 0 else ""
        buffs_info = f" buffs={[(b.effect_type, b.value) for b in u.buffs]}" if u.buffs else ""
        debuffs_info = f" debuffs={[(b.effect_type, b.value, getattr(b, 'hit_limited', 0)) for b in u.debuffs]}" if u.debuffs else ""
        cd_info = ""
        if u.skill_cooldowns:
            cd_info = f" CDs={dict(u.skill_cooldowns)}"
        print(f"    [{u.unit_id}] {u.name}({u.position.name}): {s}{shield_s}{buffs_info}{debuffs_info}{cd_info}")

    if controller.narrative:
        log_dir = os.path.join(os.path.dirname(__file__), "data", "battle_logs")
        os.makedirs(log_dir, exist_ok=True)
        safe_name = name.replace(" ", "_").replace("/", "_").replace(":", "")[:40]
        timestamp = time.strftime("%Y%m%d_%H%M%S")
        log_path = os.path.join(log_dir, f"test106301_{test_index:02d}_{safe_name}_{timestamp}.txt")
        controller.narrative.write(log_path)
        print(f"\n  日志: {log_path}")
        return log_path, bf, result, log_records

    return None, bf, result, []


def add_debuff_ps_to_enemy_dummy(data_loader, unit, char_id):
    base_idx = abs(char_id) - 1
    ps_skill = build_custom_skill_data(
        base_idx, True, 1, "デバフ付与", 0, 1, 0, 1, 3, 1, 1, 1
    )
    data_loader._custom_skills[ps_skill.skill_id] = ps_skill

    ps_parsed = {
        "skill_id": ps_skill.skill_id,
        "display_target_type": 3,
        "display_target_range": 1,
        "display_target_priority": 1,
        "trigger_type": "on_turn_start",
        "effect_blocks": [
            {
                "block_id": 0,
                "effects": [
                    {
                        "effect_type": "atk_down",
                        "target_type": "enemy_single",
                        "value": 10.0,
                        "duration": 1,
                        "flags": {"value_type": "percent"},
                    }
                ],
            }
        ],
    }
    data_loader._custom_parsed_skills[str(ps_skill.skill_id)] = ps_parsed

    existing_skills = data_loader._custom_character_skills.get(char_id, [])
    data_loader._custom_character_skills[char_id] = existing_skills + [ps_skill.skill_id]

    unit.skills.append(ps_skill.skill_id)
    unit.skill_levels[ps_skill.skill_id] = 1
    unit.skill_cooldowns[ps_skill.skill_id] = 0


def main():
    char_id = 106301
    data_loader = DataLoader()
    data_loader.load_all()

    panel_config = PanelConfig(
        character_level=200,
        school_levels=SchoolLevels(
            physical_level=25, en_level=25, agility_level=25,
            fire_level=25, water_level=25, earth_level=25, wind_level=25,
            light_level=25, dark_level=25,
        ),
        equipment_ids=[11, 12, 13, 14, 21, 22, 23, 24, 31, 32, 33, 34],
        equipment_enabled=False,
    )

    char = data_loader.get_character_by_id(char_id)
    panel_config.rarities[char_id] = 14
    panel_config.affection_levels[char_id] = 40
    skill_ids = data_loader.load_character_skills().get(char_id, [])
    panel_config.skill_levels[char_id] = {sid: 10 for sid in skill_ids}
    module_ids = [int(f"{char.character_type}1"), int(f"{char.character_type}2"),
                  int(f"{char.character_type}3")]
    panel_config.modules[char_id] = [
        ModuleConfig(module_id=mid, tier=9, level=50)
        for mid in module_ids
    ]

    lerp_data = data_loader.load_level_lerp_data()
    stat_calculator = StatCalculator(lerp_data)
    player_config = panel_config.get_player_config()

    test_idx = 0
    all_passed = True

    # ============================================================
    # Test 1: 110002 一日一不憫 (EX) Lv10 — 敌全体5hit EN攻击 + 会心时追击
    # ============================================================
    test_idx += 1
    _, bf1, _, logs1 = run_test("EX_110002_Lv10_5hit_crit_pursuit",
        friends_config=[
            {"is_dummy": False, "char_id": char_id, "pos": Position.ALLY_CENTER_FRONT,
             "ep_override": 8, "speed_override": 999,
             "crit_rate_override": 1.0}
        ],
        enemies_config=[
            {"name": "敌A", "hp": 5000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100001, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_FRONT},
            {"name": "敌B", "hp": 5000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100002, "is_dummy": True,
             "pos": Position.ENEMY_CENTER_FRONT},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True
    )

    enemy_a = next((u for u in bf1.enemy_team if "敌A" in u.name), None)
    enemy_b = next((u for u in bf1.enemy_team if "敌B" in u.name), None)

    dmg_taken_up_a_in_logs = any("敌A add ReceivedDamage" in l for l in logs1)
    dmg_taken_up_b_in_logs = any("敌B add ReceivedDamage" in l for l in logs1)

    on_crit_logs = [l for l in logs1 if "ON_CRIT" in l]
    print(f"  [ON_CRIT日志数]: {len(on_crit_logs)}")
    for l in on_crit_logs[:5]:
        print(f"    {l}")

    all_passed &= _verify_and_print(bf1, "EX 110002 一日一不憫 (Lv10, 100%会心 → 追击)", [
        ("敌A有dmg_taken_up(会心触发)", dmg_taken_up_a_in_logs, "有dmg_taken_up", "无"),
        ("敌B有dmg_taken_up(会心触发)", dmg_taken_up_b_in_logs, "有dmg_taken_up", "无"),
        ("ON_CRIT日志非空", len(on_crit_logs) > 0, ">0", str(len(on_crit_logs))),
    ])

    # ============================================================
    # Test 2: 110002 一日一不憫 (EX) — 无会心时无追击
    # ============================================================
    test_idx += 1
    _, bf2, _, logs2 = run_test("EX_110002_no_crit_no_pursuit",
        friends_config=[
            {"is_dummy": False, "char_id": char_id, "pos": Position.ALLY_CENTER_FRONT,
             "ep_override": 8, "speed_override": 999,
             "crit_rate_override": 0.0}
        ],
        enemies_config=[
            {"name": "敌X", "hp": 5000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100003, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_FRONT},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True
    )

    enemy_x = next((u for u in bf2.enemy_team if "敌X" in u.name), None)
    has_dmg_taken_up_x = any(b.effect_type in ("dmg_taken_up", "DmgTakenUp", "ReceivedDamage") for b in (enemy_x.debuffs if enemy_x else []))
    on_crit_logs2 = [l for l in logs2 if "ON_CRIT" in l]

    all_passed &= _verify_and_print(bf2, "EX 110002 一日一不憫 (无会心→无追击)", [
        ("敌X无dmg_taken_up(无会心)", not has_dmg_taken_up_x, "无dmg_taken_up", "有"),
        ("ON_CRIT日志为空", len(on_crit_logs2) == 0, "0", str(len(on_crit_logs2))),
    ])

    # ============================================================
    # Test 3: 120014 エクスペクトボーダー (AS) Lv10 — 敌横一列EN攻击 + 会心时dmg_taken_up 5%
    # ============================================================
    test_idx += 1
    _, bf3, _, logs3 = run_test("AS_120014_Lv10_crit_dmg_taken_up",
        friends_config=[
            {"is_dummy": False, "char_id": char_id, "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 999,
             "crit_rate_override": 1.0, "ap_override": 5}
        ],
        enemies_config=[
            {"name": "敌前", "hp": 5000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100001, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_FRONT},
            {"name": "敌前2", "hp": 5000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100002, "is_dummy": True,
             "pos": Position.ENEMY_CENTER_FRONT},
            {"name": "敌后", "hp": 5000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100003, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_BACK},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True
    )

    enemy_front = next((u for u in bf3.enemy_team if "敌前" in u.name and "敌前2" not in u.name), None)
    enemy_front2 = next((u for u in bf3.enemy_team if "敌前2" in u.name), None)
    enemy_back = next((u for u in bf3.enemy_team if "敌后" in u.name), None)

    dtu_front_logs = [l for l in logs3 if "敌前 add ReceivedDamage" in l and "敌前2" not in l]
    dtu_front2_logs = [l for l in logs3 if "敌前2 add ReceivedDamage" in l]

    on_crit_aura_logs = [l for l in logs3 if "dmg_taken_up" in l and "mapped=ReceivedDamage" in l and "targets=" in l]
    first_on_crit_correct = any("targets=2" in l for l in on_crit_aura_logs)

    has_dtu_front = len(dtu_front_logs) > 0
    has_dtu_front2 = len(dtu_front2_logs) > 0

    all_passed &= _verify_and_print(bf3, "AS 120014 エクスペクトボーダー (Lv10, 100%会心)", [
        ("敌前(同列)有dmg_taken_up 5%", has_dtu_front, "有", "无"),
        ("敌前2(同列)有dmg_taken_up 5%", has_dtu_front2, "有", "无"),
        ("首次on_crit: 正确过滤至2目标(targets=2, 非全部3目标)", first_on_crit_correct, "targets=2", "无此模式"),
    ])

    # ============================================================
    # Test 4: 120014 エクスペクトボーダー (AS) Lv11+ — 额外crit_rate_down
    # ============================================================
    panel_config.skill_levels[char_id] = {
        110002: 11,
        120014: 11,
        130010: 11,
        130023: 11,
        130039: 11,
    }

    test_idx += 1
    _, bf4, _, logs4 = run_test("AS_120014_Lv11_crit_rate_down",
        friends_config=[
            {"is_dummy": False, "char_id": char_id, "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 999, "crit_rate_override": 1.0, "ap_override": 5}
        ],
        enemies_config=[
            {"name": "敌C", "hp": 5000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100004, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_FRONT},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True
    )

    enemy_c = next((u for u in bf4.enemy_team if "敌C" in u.name), None)
    has_dtu_c = any(b.effect_type in ("dmg_taken_up", "DmgTakenUp", "ReceivedDamage") and abs(b.value - 5.0) < 1 for b in (enemy_c.debuffs if enemy_c else []))
    has_crd_c = any(b.effect_type in ("crit_rate_down", "CritRateDown", "StatusCriticalChance") for b in (enemy_c.debuffs if enemy_c else []))

    all_passed &= _verify_and_print(bf4, "AS 120014 エクスペクトボーダー (Lv11+, 100%会心)", [
        ("敌C有dmg_taken_up 5%", has_dtu_c, "有", "无"),
        ("敌C有crit_rate_down(Lv11+追加)", has_crd_c, "有", "无"),
    ])

    # ============================================================
    # Test 5: 130010 アフターライズ (PS) Lv10 — 自身AS攻击后 crit_rate_up
    # ============================================================
    panel_config.skill_levels[char_id] = {
        110002: 10,
        120014: 10,
        130010: 10,
        130023: 10,
        130039: 10,
    }

    test_idx += 1
    _, bf5, _, logs5 = run_test("PS_130010_Lv10_self_crit_rate_up",
        friends_config=[
            {"is_dummy": False, "char_id": char_id, "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 999, "ap_override": 5}
        ],
        enemies_config=[
            {"name": "敌D", "hp": 5000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100005, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_FRONT},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True
    )

    char = next((u for u in bf5.friend_team if u.character_id == char_id), None)
    has_crt_self = any(b.effect_type in ("crit_rate_up", "CritRateUp", "StatusCriticalChance") for b in (char.buffs if char else []))

    all_passed &= _verify_and_print(bf5, "PS 130010 アフターライズ (Lv10, AS攻击后)", [
        ("角色自身有crit_rate_up", has_crt_self, "有", "无"),
    ])

    # ============================================================
    # Test 6: 130010 アフターライズ (PS) Lv11+ — 额外最高ATK友方crit_rate_up
    # ============================================================
    panel_config.skill_levels[char_id] = {
        110002: 11,
        120014: 11,
        130010: 11,
        130023: 11,
        130039: 11,
    }

    test_idx += 1
    _, bf6, _, logs6 = run_test("PS_130010_Lv11_highest_atk_ally",
        friends_config=[
            {"is_dummy": False, "char_id": char_id, "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 999, "ap_override": 5},
            {"name": "友方高ATK", "hp": 5000, "atk": 500, "defense": 100, "speed": 100,
             "ap": 5, "pp": 3, "char_id": -200001, "is_dummy": True,
             "pos": Position.ALLY_CENTER_FRONT},
            {"name": "友方低ATK", "hp": 5000, "atk": 200, "defense": 100, "speed": 100,
             "ap": 5, "pp": 3, "char_id": -200002, "is_dummy": True,
             "pos": Position.ALLY_RIGHT_FRONT},
        ],
        enemies_config=[
            {"name": "敌E", "hp": 5000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100006, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_FRONT},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True
    )

    high_atk_ally = next((u for u in bf6.friend_team if "友方高ATK" in u.name), None)
    low_atk_ally = next((u for u in bf6.friend_team if "友方低ATK" in u.name), None)

    has_crt_high = any(b.effect_type in ("crit_rate_up", "CritRateUp", "StatusCriticalChance") for b in (high_atk_ally.buffs if high_atk_ally else []))
    has_crt_low = any(b.effect_type in ("crit_rate_up", "CritRateUp", "StatusCriticalChance") for b in (low_atk_ally.buffs if low_atk_ally else []))

    all_passed &= _verify_and_print(bf6, "PS 130010 アフターライズ (Lv11+, 最高ATK友方)", [
        ("友方高ATK(500)有crit_rate_up", has_crt_high, "有", "无"),
        ("友方低ATK(200)无crit_rate_up(非最高ATK)", not has_crt_low, "无", "有"),
    ])

    # ============================================================
    # Test 7: 130023 ハイサポート (PS) — 回合开始时最高ATK友方atk_up + crit_rate_up
    # 注意: 此技能第1回合不触发, 需要至少2回合才能验证
    # ============================================================
    panel_config.skill_levels[char_id] = {
        110002: 10,
        120014: 10,
        130010: 10,
        130023: 10,
        130039: 10,
    }

    test_idx += 1
    _, bf7, _, logs7 = run_test("PS_130023_turn_start_highest_atk_ally",
        friends_config=[
            {"is_dummy": False, "char_id": char_id, "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 999, "ap_override": 10,
             "skill_cooldown_override": {130023: 0}},
            {"name": "友方高ATK", "hp": 5000, "atk": 500, "defense": 100, "speed": 100,
             "ap": 5, "pp": 3, "char_id": -200003, "is_dummy": True,
             "pos": Position.ALLY_CENTER_FRONT},
            {"name": "友方低ATK", "hp": 5000, "atk": 200, "defense": 100, "speed": 100,
             "ap": 5, "pp": 3, "char_id": -200004, "is_dummy": True,
             "pos": Position.ALLY_RIGHT_FRONT},
        ],
        enemies_config=[
            {"name": "敌F", "hp": 999999, "atk": 200, "defense": 99999, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100007, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_FRONT},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True
    )

    high_atk_ally2 = next((u for u in bf7.friend_team if "友方高ATK" in u.name), None)
    low_atk_ally2 = next((u for u in bf7.friend_team if "友方低ATK" in u.name), None)

    atk_high_logs = [l for l in logs7 if "友方高ATK add StatusAttack" in l]
    crt_high_logs = [l for l in logs7 if "友方高ATK add StatusCriticalChance" in l]
    atk_low_logs = [l for l in logs7 if "友方低ATK add StatusAttack" in l]

    has_atk_high = len(atk_high_logs) > 0
    has_crt_high2 = len(crt_high_logs) > 0
    has_atk_low = len(atk_low_logs) > 0

    print(f"  [友方高ATK atk_up日志]: {len(atk_high_logs)}")
    for l in atk_high_logs[:3]:
        print(f"    {l}")
    print(f"  [友方高ATK crit_rate_up日志]: {len(crt_high_logs)}")
    for l in crt_high_logs[:3]:
        print(f"    {l}")

    all_passed &= _verify_and_print(bf7, "PS 130023 ハイサポート (回合开始, 最高ATK友方)", [
        ("友方高ATK(500)有atk_up", has_atk_high, "有", "无"),
        ("友方高ATK(500)有crit_rate_up", has_crt_high2, "有", "无"),
        ("友方低ATK(200)无atk_up(非最高ATK)", not has_atk_low, "无", "有"),
    ])

    # ============================================================
    # Test 8: 130039 スキルリレイティブ (PS) Lv10 — 自身被上debuff时 crit_rate_up
    # ============================================================
    panel_config.skill_levels[char_id] = {
        110002: 10,
        120014: 10,
        130010: 10,
        130023: 10,
        130039: 10,
    }

    test_idx += 1
    _, bf8, _, logs8 = run_test("PS_130039_Lv10_on_debuff_crit_up",
        friends_config=[
            {"is_dummy": False, "char_id": char_id, "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 999, "ap_override": 10}
        ],
        enemies_config=[
            {"name": "敌G(会上debuff)", "hp": 10000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100008, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_FRONT, "add_debuff_ps": True},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True
    )

    char8 = next((u for u in bf8.friend_team if u.character_id == char_id), None)
    has_crt_self8 = any(b.effect_type in ("crit_rate_up", "CritRateUp", "StatusCriticalChance") for b in (char8.buffs if char8 else []))

    trigger_logs8 = [l for l in logs8 if "130039" in l or "スキルリレイティブ" in l]
    print(f"  [130039触发日志]: {len(trigger_logs8)}")
    for l in trigger_logs8[:5]:
        print(f"    {l}")

    all_passed &= _verify_and_print(bf8, "PS 130039 スキルリレイティブ (Lv10, 被上debuff时)", [
        ("角色自身有crit_rate_up", has_crt_self8, "有", "无"),
    ])

    # ============================================================
    # Test 9: 130039 スキルリレイティブ (PS) Lv11+ — 额外对debuff来源施加dmg_taken_up
    # ============================================================
    panel_config.skill_levels[char_id] = {
        110002: 11,
        120014: 11,
        130010: 11,
        130023: 11,
        130039: 11,
    }

    test_idx += 1
    _, bf9, _, logs9 = run_test("PS_130039_Lv11_debuffer_dmg_taken_up",
        friends_config=[
            {"is_dummy": False, "char_id": char_id, "pos": Position.ALLY_CENTER_FRONT,
             "speed_override": 999, "ap_override": 10}
        ],
        enemies_config=[
            {"name": "敌H(会上debuff)", "hp": 10000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100009, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_FRONT, "add_debuff_ps": True},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True
    )

    char9 = next((u for u in bf9.friend_team if u.character_id == char_id), None)
    enemy_h = next((u for u in bf9.enemy_team if "敌H" in u.name), None)

    has_crt_self9 = any(b.effect_type in ("crit_rate_up", "CritRateUp", "StatusCriticalChance") for b in (char9.buffs if char9 else []))
    has_dtu_h = any(b.effect_type in ("dmg_taken_up", "DmgTakenUp", "ReceivedDamage") for b in (enemy_h.debuffs if enemy_h else []))

    all_passed &= _verify_and_print(bf9, "PS 130039 スキルリレイティブ (Lv11+, debuffer目标)", [
        ("角色自身有crit_rate_up", has_crt_self9, "有", "无"),
        ("敌H(debuffer)有dmg_taken_up(Lv11+追加)", has_dtu_h, "有", "无"),
    ])

    # ============================================================
    # Test 10: 110002 一日一不憫 dmg_taken_up hit_limited 验证
    # ============================================================
    panel_config.skill_levels[char_id] = {
        110002: 10,
        120014: 10,
        130010: 10,
        130023: 10,
        130039: 10,
    }

    test_idx += 1
    _, bf10, _, logs10 = run_test("EX_110002_hit_limited_dmg_taken_up",
        friends_config=[
            {"is_dummy": False, "char_id": char_id, "pos": Position.ALLY_CENTER_FRONT,
             "ep_override": 8, "speed_override": 999,
             "crit_rate_override": 1.0}
        ],
        enemies_config=[
            {"name": "敌J", "hp": 10000, "atk": 200, "defense": 100, "speed": 50,
             "ap": 3, "pp": 3, "char_id": -100010, "is_dummy": True,
             "pos": Position.ENEMY_LEFT_FRONT},
        ],
        data_loader=data_loader, panel_config=panel_config,
        player_config=player_config, stat_calculator=stat_calculator,
        test_index=test_idx, capture_logs=True
    )

    enemy_j = next((u for u in bf10.enemy_team if "敌J" in u.name), None)
    dtu_debuffs = [b for b in (enemy_j.debuffs if enemy_j else []) if b.effect_type in ("dmg_taken_up", "DmgTakenUp", "ReceivedDamage")]
    has_hit_limited = any(getattr(b, 'hit_limited', 0) > 0 for b in dtu_debuffs) if dtu_debuffs else False
    dtu_expired = len(dtu_debuffs) == 0

    all_passed &= _verify_and_print(bf10, "EX 110002 dmg_taken_up hit_limited验证", [
        ("dmg_taken_up已消耗(hit_limited=1, 被追击消耗)", dtu_expired or not has_hit_limited,
         "已消耗或无hit_limited", "hit_limited仍>0"),
    ])

    # ============================================================
    print(f"\n{'='*60}")
    print(f"所有测试结果: {'全部通过' if all_passed else '有失败'}")
    print(f"{'='*60}")
    return 0 if all_passed else 1


if __name__ == "__main__":
    exit(main())