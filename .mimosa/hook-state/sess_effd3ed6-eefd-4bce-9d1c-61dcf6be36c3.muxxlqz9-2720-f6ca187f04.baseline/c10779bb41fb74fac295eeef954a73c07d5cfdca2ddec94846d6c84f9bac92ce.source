"""识别没有 test_actor_<id>.py 的己方角色。

通过 characters.json + character_skills.json 找出所有实装的己方角色，
然后对比 tests/test_actor_*.py 列出缺测试的角色。
"""
import json
import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))
from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()


def main():
    base = os.path.join(os.path.dirname(__file__), '..', '..')
    data_dir = os.path.join(base, 'data')
    tests_dir = os.path.join(base, 'tests')

    # 加载 characters.json
    with open(os.path.join(data_dir, 'characters.json'), 'r', encoding='utf-8') as f:
        chars_raw = json.load(f)
    # characters.json 是 dict，key 为角色ID字符串
    if isinstance(chars_raw, dict):
        chars = chars_raw
    else:
        chars = {str(c.get('character_id') or c.get('Id') or c.get('id')): c for c in chars_raw}

    # 收集己方角色 ID（characters.json key 以 1 开头，如 100301/107302）
    ally_ids = set()
    for cid_str, c in chars.items():
        try:
            cid_int = int(cid_str)
        except (ValueError, TypeError):
            continue
        # 己方角色 ID 通常以 1 开头（如 100301, 107302），敌方以 2 开头
        if 100000 <= cid_int < 200000:
            ally_ids.add(cid_int)

    safe_print(f"己方角色总数（characters.json）: {len(ally_ids)}")

    # 扫描 tests/test_actor_*.py 收集已测试角色 ID
    tested_ids = set()
    pattern = re.compile(r'test_actor_(\d+)\.py$')
    for fname in os.listdir(tests_dir):
        m = pattern.match(fname)
        if m:
            tested_ids.add(int(m.group(1)))

    safe_print(f"已有 test_actor 文件的角色数: {len(tested_ids)}")

    # 缺测试的角色
    missing = sorted(ally_ids - tested_ids)
    safe_print(f"\n=== 缺 test_actor 的角色（{len(missing)}个）===")
    for cid in missing:
        # 从 characters.json 找名称
        c = chars.get(str(cid), {})
        name = c.get('name') or c.get('Name') or c.get('Nickname') or '?'
        safe_print(f"  {cid}: {name}")

    # 额外：测试文件中存在但 characters.json 没有的（可能是历史遗留）
    extra = sorted(tested_ids - ally_ids)
    if extra:
        safe_print(f"\n=== test_actor 文件中存在但 characters.json 中没有的角色（{len(extra)}个）===")
        for cid in extra:
            safe_print(f"  {cid}")


if __name__ == '__main__':
    main()
