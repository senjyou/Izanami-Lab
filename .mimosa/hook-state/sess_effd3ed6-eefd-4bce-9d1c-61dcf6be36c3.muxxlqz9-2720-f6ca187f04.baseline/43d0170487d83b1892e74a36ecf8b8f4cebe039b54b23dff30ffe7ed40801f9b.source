"""Regression: スキュア(120058) cross-block aura targeting.

Bug: Block 2 atk_down/def_up went to nearest enemy instead of highest ATK enemy.
Fix: Merged into single block with level_min=11 on aura effects.
Test: Damage + auras all target the same highest-ATK enemy.
"""
import unittest, sys, os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value


class TestRegSkiaCrossBlock(unittest.TestCase):

    def test_all_effects_hit_highest_atk(self):
        bb = BattleBuilder()
        bb.add_ally(unit_id="caster", hp=20000, atk=10000, skills=[120058], level=15)
        bb.add_enemy(unit_id="near", position=Position.ENEMY_CENTER_FRONT, hp=50000, atk=5000)
        bb.add_enemy(unit_id="far_high", position=Position.ENEMY_RIGHT_BACK, hp=50000, atk=15000)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")
        far = next(u for u in bf.enemy_team if u.unit_id == "far_high")
        near = next(u for u in bf.enemy_team if u.unit_id == "near")

        result = ss.execute_skill(caster=caster, skill_id=120058, battlefield=bf, skip_cost=True)

        # Damage should hit highest ATK
        dmg_targets = set()
        for e in result["effects_applied"]:
            if e.get("effect_type") == "damage":
                for t in e.get("targets", []):
                    dmg_targets.add(t.get("target_id"))
        self.assertIn(far.unit_id, dmg_targets)
        self.assertNotIn(near.unit_id, dmg_targets)

        # Auras should also be on highest ATK
        atk_down = [d for d in far.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertTrue(len(atk_down) > 0, "atk_down should be on highest ATK enemy")
        def_up = [b for b in far.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertTrue(len(def_up) > 0, "def_up should be on highest ATK enemy (self buff)")
