#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""Regression: after_self_attacked (被攻撃後発動) must trigger for ANY skill type
and ANY target position, not just AS primary target.

重要概念:
  - after_as_attacked (被AS技能攻撃後発動): 仅AS主目标触发, 参考 フレンジーキャノン(130049)
  - after_self_attacked (被攻撃後発動): 被任何技能攻击都算(AS/PS/EX/全局PS),
    且不限于主目标, 参考 ブレイブリフト(130037)

Bug: _match_trigger_timing for AFTER_SELF_ATTACKED checked primary_target only
     (same as AFTER_AS_ATTACKED). When a global PS (on_cumulative_damage) does AoE
     damage to 5 allies, only the first target's after_self_attacked PS triggered;
     non-primary targets' PS were silently skipped.

Scenario: Enemy PS「それはやりすぎ！+」(230400, on_cumulative_damage) deals AoE damage
          to ALL 5 allies. 自称腹黒の深謀策士 (107301) holds ブレイブリフト (130037,
          after_self_attacked) but is the 3rd target in the damage list.
          The PS should trigger because the holder was attacked (by a PS, as a
          non-primary target).
"""

import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'src'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.services.trigger_service import TriggerService


class TestRegAfterSelfAttackedAnySkill(unittest.TestCase):
    """Regression: after_self_attacked fires for any skill type, any target position."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)

        # 唯一無二の幼なじみ (primary target - first in damage list)
        self.ally_a = UnitState(
            unit_id="ally_a", name="味方A", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999101, level=200,
            element=4, character_type=1,
            max_hp=100000, current_hp=100000,
            attack=50000, defense=40000, speed=800,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=100,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 味方B (2nd target)
        self.ally_b = UnitState(
            unit_id="ally_b", name="味方B", side=Side.ALLY,
            position=Position.ALLY_RIGHT_FRONT, character_id=999102, level=200,
            element=4, character_type=1,
            max_hp=100000, current_hp=100000,
            attack=50000, defense=40000, speed=750,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=100,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 自称腹黒の深謀策士 (3rd target - NON-primary), holds ブレイブリフト (130037)
        self.strategist = UnitState(
            unit_id="ally_strategist", name="自称腹黒の深謀策士", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=107301, level=15,
            element=3, character_type=3,
            max_hp=89103, current_hp=89103,
            attack=67219, defense=41726, speed=848,
            crit_rate=0.13, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=7,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[110022, 120029, 120045, 130037, 130053],
            skill_levels={110022: 15, 120029: 15, 120045: 15,
                          130037: 15, 130053: 15},
            skill_cooldowns={},
        )

        # Enemy attacker (global PS that does AoE damage to all allies)
        self.enemy = UnitState(
            unit_id="enemy", name="エレーナ・パステルコワ", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=713405, level=200,
            element=4, character_type=2,
            max_hp=505594, current_hp=505594,
            attack=10101, defense=7841, speed=528,
            crit_rate=0.13, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=6,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[210102, 220378, 220379, 230399, 230400],
            skill_levels={210102: 15, 220378: 15, 220379: 15,
                          230399: 15, 230400: 15},
            skill_cooldowns={},
        )

        for u in (self.ally_a, self.ally_b, self.strategist, self.enemy):
            self.bf.add_unit(u)

    def test_aoe_non_primary_target_triggers(self):
        """ブレイブリフト (130037) must trigger when holder is a NON-primary
        target of an AoE attack (3rd in damage list).

        被攻撃後発動 = 被任何技能攻击都算, 不限于主目标.
        """
        # AoE damage to all 3 allies; strategist is 3rd (non-primary)
        damaged_targets = [self.ally_a, self.ally_b, self.strategist]
        primary_target = damaged_targets[0]  # ally_a (first)

        actions = self.ts.trigger_after_self_attacked(
            targets=damaged_targets,
            battlefield=self.bf,
            actor=self.enemy,
            primary_target=primary_target,
        )

        strategist_actions = [a for a in actions
                              if a.instance.owner.unit_id == self.strategist.unit_id]
        self.assertGreater(
            len(strategist_actions), 0,
            "ブレイブリフト should trigger: 被攻撃後発動 means any target of any skill. "
            f"Actions found: {[(a.skill_id, a.instance.owner.name) for a in actions]}"
        )
        self.assertEqual(strategist_actions[0].skill_id, 130037)

    def test_non_damaged_ally_does_not_trigger(self):
        """after_self_attacked should NOT trigger for an ally NOT in damaged targets."""
        damaged_targets = [self.ally_a, self.ally_b]

        actions = self.ts.trigger_after_self_attacked(
            targets=damaged_targets,
            battlefield=self.bf,
            actor=self.enemy,
            primary_target=damaged_targets[0],
        )

        strategist_actions = [a for a in actions
                              if a.instance.owner.unit_id == self.strategist.unit_id]
        self.assertEqual(
            len(strategist_actions), 0,
            "ブレイブリフト should NOT trigger when holder was not attacked"
        )

    def test_same_side_attacker_does_not_trigger(self):
        """after_self_attacked should NOT trigger when attacker is same side."""
        damaged_targets = [self.ally_a, self.ally_b, self.strategist]

        actions = self.ts.trigger_after_self_attacked(
            targets=damaged_targets,
            battlefield=self.bf,
            actor=self.ally_a,  # same side as strategist
            primary_target=damaged_targets[0],
        )

        strategist_actions = [a for a in actions
                              if a.instance.owner.unit_id == self.strategist.unit_id]
        self.assertEqual(
            len(strategist_actions), 0,
            "ブレイブリフト should NOT trigger when attacker is same side (ally)"
        )

    def test_primary_target_still_triggers(self):
        """ブレイブリフト should also trigger when holder IS the primary target
        (backward compatibility with single-target attacks).
        """
        damaged_targets = [self.strategist]  # strategist is primary

        actions = self.ts.trigger_after_self_attacked(
            targets=damaged_targets,
            battlefield=self.bf,
            actor=self.enemy,
            primary_target=damaged_targets[0],
        )

        strategist_actions = [a for a in actions
                              if a.instance.owner.unit_id == self.strategist.unit_id]
        self.assertGreater(len(strategist_actions), 0,
                           "ブレイブリフト should trigger when holder is primary target")
        self.assertEqual(strategist_actions[0].skill_id, 130037)


if __name__ == '__main__':
    unittest.main()
