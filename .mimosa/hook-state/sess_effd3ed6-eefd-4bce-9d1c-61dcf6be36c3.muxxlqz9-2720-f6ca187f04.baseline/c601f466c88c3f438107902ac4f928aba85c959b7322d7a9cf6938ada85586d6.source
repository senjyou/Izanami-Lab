"""
角色116302 #激カワ吸血鬼配信者♪ 专项测试
- EX:  110028 #ぽよ・オア・トリート（敵前後列damage + target_survived追加攻撃 + L11+ lifesteal）
- AS:  120067 かぷっとファンサ（敵単体damage + 極限時consume_hp）
- PS1: 130075 イモータル・ヴァンパイア（on_hp_below 10%: heal(max_hp%) + add_max_ap + mark(極限,unremovable) + L11+ dmg_dealt_up）
- PS2: 130076 アウェイキング・ヴァンパイア（after_as_attacked: damage(trigger_attacker) + perfect_evasion; self_lacks_mark(極限) gate）
- PS3: 130077 あなたにマーキング♡（on_turn_start: dmg_taken_up(enemy_single_furthest, attack_limited=1, stackable) + cheat_death(self, permanent)）

角色信息:
- 角色: #激カワ吸血鬼配信者♪
- 属性: 2 (水), 类型: 3 (敏捷), 站位: 灵活, 定位: 控制
- 技能: 110028, 120067, 130075, 130076, 130077
- 核心机制: 「極限」状态 (mark with is_buff_mark=true, unremovable=true)
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
MARK = SkillEffectType.MARK.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value  # dmg_taken_up/down
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value  # dmg_dealt_up/down
EVADE = SkillEffectType.EVADE.value
CHEAT_DEATH = SkillEffectType.CHEAT_DEATH.value
STATUS_MAX_AP = SkillEffectType.STATUS_MAX_AP.value


class TestActor116302(unittest.TestCase):
    """角色116302 #激カワ吸血鬼配信者♪ 专项测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 116302 #激カワ吸血鬼配信者♪ (水属性, 敏捷, 灵活)
        # 站在后排中央以便enemy_column索敌到中列(ENEMY_CENTER_FRONT + ENEMY_CENTER_BACK)
        self.caster = UnitState(
            unit_id="caster", name="#激カワ吸血鬼配信者♪", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=116302, level=10,
            element=2, character_type=3,
            max_hp=12000, current_hp=12000,
            attack=8000, defense=4000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110028, 120067, 130075, 130076, 130077],
            skill_levels={110028: 10, 120067: 10, 130075: 10, 130076: 10, 130077: 10},
            skill_cooldowns={},
        )

        # 友方前排
        self.ally_front = UnitState(
            unit_id="ally_front", name="友方前排", side=Side.ALLY,
