"""角色451305 惨禍：リディア・エルドリッジ 专项E2E测试

同名己方参考: 140302 おたすけさんぽ・イン・サマー（110074/120162/120163/130164/130165）

技能列表（敌方版）:
- EX: 210120 リディアのおしろだいさくせん（自身にサブユニット「うみのともだちⅡ」×3付与；
  HP=最大HP×2.5%(己方50%), 追傷ATK×atk%; atk_down 7.5% + dmg_taken_up dmg%）
- AS1: 220417 にげちゃ、めっ……だよ？（最も最大HPが高い敵単体 + 隣接2体[威力]攻撃(回避不可)；
  後列追加: 現在HP×7.5%ダメージ, ATK×15%上限）
- AS2: 220418 いっぱいおしおき（後列中央[威力] + その他全ての敵[威力2]）
- PS1: 230440 おたすけもとむ（on_debuff_applied; exclude_timing；remove_debuff(1) +
  サブユニット「うみのともだちⅠ」×1付与；子HP=最大HP×2.5%）
- PS2: 230441 いっしょにがんばる+（on_turn_start; 敵方無once_per_battle；僅自身、
  子HP=最大HP×0.75%、atk_down 2.5%）

敌方差异（vs 己方140302）:
- 子单元HP: EX/PS1 2.5%（己方50%）；PS2 0.75%（己方15%）
- PS2 无 once_per_battle（可每回合触发）；仅自身（无 Lv11+ 同排友方扩展）
- 数值 tags 按敌方原始数据（210120 dmg Lv10=0 → 无dmg_taken_up）

角色信息:
- 角色: 惨禍：リディア・エルドリッジ（敌方）/ おたすけさんぽ・イン・サマー（己方）
- 属性: 3 (风), 类型: 1 (物理), 站位: 2 (中前), 定位: 物理攻击手
- 技能: 210120, 220417, 220418, 230440, 230441
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming, TriggerTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value       # atk_down
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value  # dmg_taken_up
SUB_UNIT = SkillEffectType.SUB_UNIT.value

ENEMY_ID = 451305
SKILLS = [210120, 220417, 220418, 230440, 230441]


class TestActor451305(unittest.TestCase):
    """角色451305 惨禍：リディア・エルドリッジ 专项E2E测试（敌方版）"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _mk(self, uid, name, side, pos, *, hp=30000, atk=8000, defense=4000,
            speed=500, element=3, ctype=1, skills=None, max_hp=None):
        if max_hp is None:
            max_hp = hp
        return UnitState(
            unit_id=uid, name=name, side=side, position=pos,
            character_id=0, level=10, element=element, character_type=ctype,
            max_hp=max_hp, current_hp=hp, attack=atk, defense=defense, speed=speed,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=10,
            skills=skills or [], skill_levels={s: 10 for s in (skills or [])},
            skill_cooldowns={},
        )

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 451305 惨禍：リディア・エルドリッジ (风3, 物理) 中前
        self.caster = self._mk(
            "caster", "惨禍：リディア", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=20000, atk=10000, defense=5000, speed=500, skills=SKILLS,
        )

        # 己方前排（AS1/AS2 目标）
        self.ally_cf = self._mk("ally_cf", "友中前", Side.ALLY, Position.ALLY_CENTER_FRONT,
                                hp=50000, max_hp=50000, atk=8000, defense=6000)
        self.ally_lf = self._mk("ally_lf", "友左前", Side.ALLY, Position.ALLY_LEFT_FRONT,
                                hp=30000, max_hp=30000, atk=7000, defense=5000)
        self.ally_rf = self._mk("ally_rf", "友右前", Side.ALLY, Position.ALLY_RIGHT_FRONT,
                                hp=28000, max_hp=28000, atk=6500, defense=4800)
        # 己方后排
        self.ally_cb = self._mk("ally_cb", "友中後", Side.ALLY, Position.ALLY_CENTER_BACK,
                                hp=40000, max_hp=40000, atk=6000, defense=4500)
        self.ally_lb = self._mk("ally_lb", "友左後", Side.ALLY, Position.ALLY_LEFT_BACK,
                                hp=25000, max_hp=25000, atk=6000, defense=4500)
        self.ally_rb = self._mk("ally_rb", "友右後", Side.ALLY, Position.ALLY_RIGHT_BACK,
                                hp=22000, max_hp=22000, atk=5500, defense=4200)

        self.bf.friend_team = [self.ally_cf, self.ally_lf, self.ally_rf,
                               self.ally_cb, self.ally_lb, self.ally_rb]
        self.bf.enemy_team = [self.caster]

        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    # ════════════════════════════════════════════════════════════════
    # 辅助
    # ════════════════════════════════════════════════════════════════

    def _reset_all(self):
        self.caster.current_hp = self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = 10
        self.caster.current_pp = 10
        self.caster.current_ep = 10
        self.caster.level = 10
        self.caster.crit_rate = 0.0
        self.caster.once_per_battle_triggered = set()
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10
        for a in self.bf.friend_team:
            a.current_hp = a.max_hp
            a.buffs = []
            a.debuffs = []
            a.is_alive = True
            a.current_ap = 10
            a.current_pp = 10
            a.current_ep = 10

    # ════════════════════════════════════════════════════════════════
    # 配置校验
    # ════════════════════════════════════════════════════════════════

    def test_config_skill_ids_present(self):
        """配置校验：5个技能均在 skills.json / hybrid 中。"""
        for sid in SKILLS:
            self.assertIsNotNone(self.dl.get_skill_by_id(sid), f"skills.json 缺 {sid}")
            self.assertIsNotNone(self.dl.get_parsed_skill_data(sid), f"hybrid 缺 {sid}")

    def test_config_sub_unit_hp_enemy_values(self):
        """配置校验：EX/PS1 子单元HP=2.5%、PS2 子单元HP=0.75%。"""
        for sid, hp in [(210120, 2.5), (230440, 2.5), (230441, 0.75)]:
            parsed = self.dl.get_parsed_skill_data(sid)
            effs = [e for b in parsed['effect_blocks'] for e in b['effects']
                    if e['effect_type'] == 'sub_unit']
            self.assertGreater(len(effs), 0, f"{sid} 应有 sub_unit")
            for e in effs:
                self.assertEqual(e['flags']['sub_unit_hp_pct'], hp,
                                 f"{sid} 子单元HP应为{hp}%")

    def test_config_ps2_no_once_per_battle(self):
        """配置校验：PS2(230441) 敌方版无 once_per_battle。"""
        parsed = self.dl.get_parsed_skill_data(230441)
        self.assertFalse(parsed.get('once_per_battle'),
                         "敌方PS2 无 once_per_battle（可每回合触发）")
        self.assertEqual(parsed['trigger_type'], 'on_turn_start')
        # 仅自身（无 Lv11+ 同排扩展）
        self.assertEqual([b['block_id'] for b in parsed['effect_blocks']], [1],
                         "敌方PS2 应仅1个block（无Lv11+扩展）")
        eff = parsed['effect_blocks'][0]['effects'][0]
        self.assertEqual(eff['target_type'], 'self')

    def test_config_ps1_trigger(self):
        """配置校验：PS1(230440) trigger_type=on_debuff_applied + exclude_timing。"""
        parsed = self.dl.get_parsed_skill_data(230440)
        self.assertEqual(parsed['trigger_type'], 'on_debuff_applied')
        gc = parsed.get('global_condition') or {}
        conds = gc.get('conditions', []) if gc.get('type') == 'and' else [gc]
        self.assertTrue(any(c.get('type') == 'exclude_timing' for c in conds),
                        "PS1 应含 exclude_timing")

    # ════════════════════════════════════════════════════════════════
    # EX: 210120 リディアのおしろだいさくせん
    # ════════════════════════════════════════════════════════════════

    def test_ex_creates_3_sub_units(self):
        """EX(210120): 创建3个「うみのともだちⅡ」子单位，HP=maxHP×2.5%。"""
        self._reset_all()
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=210120, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        subs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(subs), 3, "应创建3个子单位")
        for sb in subs:
            self.assertEqual(sb.name, "うみのともだちⅡ")
            self.assertEqual(sb.sub_unit_max_hp, int(20000 * 0.025),
                             "子单位HP应为 maxHP×2.5%=500")

    def test_ex_applies_atk_down(self):
        """EX(210120): 施加3个atk_down(7.5%)给caster（stackable）。"""
        self._reset_all()
        self.ss.execute_skill(
            caster=self.caster, skill_id=210120, battlefield=self.bf, skip_cost=True
        )
        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_downs), 3, "应施加3个atk_down")
        for d in atk_downs:
            self.assertAlmostEqual(d.value, 7.5, places=1)
            self.assertTrue(d.is_stackable)
            self.assertEqual(d.duration, -1)

    def test_ex_lv10_no_dmg_taken_up(self):
        """EX(210120) Lv10: dmg%=0（敌方原始tag Lv10=0）→ dmg_taken_up不施加。"""
        self._reset_all()
        self.ss.execute_skill(
            caster=self.caster, skill_id=210120, battlefield=self.bf, skip_cost=True
        )
        dmg_ups = [d for d in self.caster.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_ups), 0, "Lv10 dmg%=0 → 无dmg_taken_up")
        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_downs), 3, "Lv10 atk_down仍应施加3个")

    def test_ex_sub_unit_snapshot_before_debuff(self):
        """EX(210120): 子单位快照攻击力=减攻前攻击力（10000）。"""
        self._reset_all()
        self.ss.execute_skill(
            caster=self.caster, skill_id=210120, battlefield=self.bf, skip_cost=True
        )
        subs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        for sb in subs:
            self.assertEqual(sb.caster_attack, 10000,
                             "子单位快照攻击力应为减攻前的10000")
        final_atk = self.dms._calculate_final_stat(self.caster, "attack")
        self.assertAlmostEqual(final_atk, 7750, delta=1,
                               msg="3层7.5%减攻后攻击力应为7750")

    # ════════════════════════════════════════════════════════════════
    # AS1: 220417 にげちゃ、めっ……だよ？
    # ════════════════════════════════════════════════════════════════

    def test_as1_targets_highest_max_hp(self):
        """AS1(220417): 主目标为最大HP最高的己方单体。"""
        self._reset_all()
        cf_hp = self.ally_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=220417, battlefield=self.bf, skip_cost=True
        )
        self.assertLess(self.ally_cf.current_hp, cf_hp,
                        "ally_cf(max_hp=50000最高)应受AS1主伤害")

    def test_as1_adjacent_allies_hit(self):
        """AS1(220417): 邻接主目标的2个己方受伤害。"""
        self._reset_all()
        lf_hp = self.ally_lf.current_hp
        rf_hp = self.ally_rf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=220417, battlefield=self.bf, skip_cost=True
        )
        self.assertLess(self.ally_lf.current_hp, lf_hp, "邻接lf应受伤")
        self.assertLess(self.ally_rf.current_hp, rf_hp, "邻接rf应受伤")

    def test_as1_back_row_hp_ratio_damage(self):
        """AS1(220417): 後列主目标追加HP比例伤害（target_is_back_row）。"""
        self._reset_all()
        for a in [self.ally_cf, self.ally_lf, self.ally_rf]:
            a.is_alive = False
        self.bf.friend_team = [self.ally_cb, self.ally_lb, self.ally_rb]
        cb_hp = self.ally_cb.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=220417, battlefield=self.bf, skip_cost=True
        )
        self.assertLess(self.ally_cb.current_hp, cb_hp,
                        "後列主目标ally_cb应受威力+HP比例追加伤害")

    def test_as1_ignores_defense_off(self):
        """AS1(220417): 前列主目标无HP比例追加（target_is_back_row过滤不报错）。"""
        self._reset_all()
        cf_hp = self.ally_cf.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=220417, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertLess(self.ally_cf.current_hp, cf_hp, "前列主目标仍受威力伤害")

    # ════════════════════════════════════════════════════════════════
    # AS2: 220418 いっぱいおしおき
    # ════════════════════════════════════════════════════════════════

    def test_as2_back_center_single_target(self):
        """AS2(220418): 後列中央己方单体受威力伤害。"""
        self._reset_all()
        cb_hp = self.ally_cb.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=220418, battlefield=self.bf, skip_cost=True
        )
        self.assertLess(self.ally_cb.current_hp, cb_hp, "後列中央ally_cb应受威力伤害")

    def test_as2_all_exclude_primary(self):
        """AS2(220418): その他の全ての己方受威力2伤害（主目标除外）。"""
        self._reset_all()
        hp_before = {a.unit_id: a.current_hp for a in self.bf.friend_team}
        self.ss.execute_skill(
            caster=self.caster, skill_id=220418, battlefield=self.bf, skip_cost=True
        )
        for uid in ["ally_cf", "ally_lf", "ally_rf", "ally_lb", "ally_rb"]:
            self.assertLess(getattr(self, uid).current_hp, hp_before[uid],
                            f"{uid} 应受威力2伤害")

    # ════════════════════════════════════════════════════════════════
    # PS1: 230440 おたすけもとむ
    # ════════════════════════════════════════════════════════════════

    def _apply_debuff_to_caster(self):
        db = BuffState(
            buff_id="test_db", name="test_atk_down",
            effect_type=STATUS_ATTACK, value=10.0, duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="ally_cf", source_skill_id=999999,
            caster_attack=0, is_debuff=True,
        )
        self.aus.add_aura(self.caster, db)

    def _trigger_ps1(self, phase=None):
        self._reset_all()
        self.caster.skill_cooldowns = {}
        if phase:
            self.bf.current_trigger_phase = phase
        self._apply_debuff_to_caster()
        actions = self.ts.trigger_pawn_received_aura(
            self.bf, affected_unit_ids=[self.caster.unit_id],
            actor=self.ally_cf, applied_debuff_types={STATUS_ATTACK},
        )
        ps1 = [a for a in actions if a.skill_id == 230440]
        if ps1:
            self.ss._pending_crit_triggers = []
            self.ss._execute_trigger_actions_inline(ps1, self.bf,
                                                    trigger_timing="on_debuff_applied")
        self.bf.current_trigger_phase = None
        return ps1

    def test_ps1_triggers_on_debuff_applied(self):
        """PS1(230440) on_debuff_applied: 敌方caster被施加debuff时触发。"""
        ps1 = self._trigger_ps1()
        self.assertGreater(len(ps1), 0, "被施加debuff应触发PS1")

    def test_ps1_exclude_timing(self):
        """PS1(230440) exclude_timing: 戦闘開始/ターン開始/終了时不触发。"""
        for phase in [TriggerTiming.BATTLE_START, TriggerTiming.TURN_START,
                      TriggerTiming.TURN_END]:
            ps1 = self._trigger_ps1(phase)
            self.assertEqual(len(ps1), 0,
                             f"{phase} 时 exclude_timing 应阻止PS1触发")

    def test_ps1_removes_debuff_and_creates_sub_unit(self):
        """PS1(230440): remove_debuff(1) + 创建1个子单位（HP=maxHP×2.5%）+ atk_down。"""
        self._reset_all()
        self.caster.skill_cooldowns = {}
        # 施加2个原始debuff
        for i in range(2):
            db = BuffState(
                buff_id=f"test_db_{i}", name=f"test_atk_down_{i}",
                effect_type=STATUS_ATTACK, value=10.0, duration=3,
                timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
                source_unit_id="ally_cf", source_skill_id=999999,
                caster_attack=0, is_debuff=True,
            )
            self.aus.add_aura(self.caster, db)
        orig_before = len([d for d in self.caster.debuffs if d.buff_id.startswith("test_db_")])
        self.assertEqual(orig_before, 2)

        actions = self.ts.trigger_pawn_received_aura(
            self.bf, affected_unit_ids=[self.caster.unit_id],
            actor=self.ally_cf, applied_debuff_types={STATUS_ATTACK},
        )
        ps1 = [a for a in actions if a.skill_id == 230440]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(ps1, self.bf,
                                                trigger_timing="on_debuff_applied")

        # 应移除至少1个原始debuff
        orig_after = len([d for d in self.caster.debuffs if d.buff_id.startswith("test_db_")])
        self.assertLess(orig_after, 2, "PS1应移除至少1个原始debuff")
        # 创建1个子单位
        subs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(subs), 1, "PS1应创建1个子单位")
        self.assertEqual(subs[0].name, "うみのともだちⅠ")
        self.assertEqual(subs[0].sub_unit_max_hp, int(20000 * 0.025),
                         "PS1子单位HP应为 maxHP×2.5%=500")
        # atk_down(7.5%)
        ps1_atks = [d for d in self.caster.debuffs
                    if d.effect_type == STATUS_ATTACK and abs(d.value - 7.5) < 0.01]
        self.assertGreater(len(ps1_atks), 0, "PS1应施加减攻7.5%")

    # ════════════════════════════════════════════════════════════════
    # PS2: 230441 いっしょにがんばる+
    # ════════════════════════════════════════════════════════════════

    def _trigger_ps2(self):
        self._reset_all()
        self.caster.skill_cooldowns = {}
        actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2 = [a for a in actions if a.skill_id == 230441]
        if ps2:
            self.ss._pending_crit_triggers = []
            self.ss._execute_trigger_actions_inline(ps2, self.bf,
                                                    trigger_timing="on_turn_start")
        return ps2

    def test_ps2_triggers_on_turn_start(self):
        """PS2(230441) on_turn_start: 回合开始触发，自身创建1个子单位。"""
        ps2 = self._trigger_ps2()
        self.assertGreater(len(ps2), 0, "回合开始应触发PS2")
        subs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(subs), 1, "PS2应为自身创建1个子单位")
        self.assertEqual(subs[0].name, "うみのともだちⅢ")
        self.assertEqual(subs[0].sub_unit_max_hp, int(20000 * 0.0075),
                         "PS2子单位HP应为 maxHP×0.75%=150")
        # atk_down(2.5%)
        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertGreaterEqual(len(atk_downs), 1, "PS2应施加减攻2.5%")
        self.assertAlmostEqual(atk_downs[0].value, 2.5, places=1)

    def test_ps2_no_once_per_battle(self):
        """PS2(230441) 敌方版无 once_per_battle：后续回合仍可触发。"""
        self._trigger_ps2()
        self.assertNotIn(230441, self.caster.once_per_battle_triggered,
                         "敌方PS2不应记录 once_per_battle_triggered")
        # 第二次触发
        self.bf.turn_number = 2
        self.caster.current_pp = 10
        actions2 = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2_2 = [a for a in actions2 if a.skill_id == 230441]
        self.assertGreater(len(ps2_2), 0, "无once_per_battle：第二次仍应触发")
        self.ss._execute_trigger_actions_inline(ps2_2, self.bf,
                                                trigger_timing="on_turn_start")
        subs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(subs), 2, "两次触发应累积2个子单位")

    def test_ps2_self_only_no_ally_extension(self):
        """PS2(230441) 仅自身（无己方Lv11+同排扩展）。"""
        ps2 = self._trigger_ps2()
        self.assertGreater(len(ps2), 0)
        for a in self.bf.friend_team:
            self.assertEqual([b for b in a.buffs if b.effect_type == SUB_UNIT], [],
                             f"PS2不应为友方{a.name}创建子单位")


if __name__ == '__main__':
    unittest.main()