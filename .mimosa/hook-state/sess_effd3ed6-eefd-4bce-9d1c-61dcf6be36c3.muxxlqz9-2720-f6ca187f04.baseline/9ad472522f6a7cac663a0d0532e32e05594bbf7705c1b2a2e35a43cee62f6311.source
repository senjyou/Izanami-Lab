"""Batch import S7 circle battle skills (21 skill_ids) from split_data/SkillMaster.json
into data/skills.json. Preserves existing entries; only adds missing ones.

Usage:
    python scripts/_import_s7_skills_to_skills_json.py
"""
from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SPLIT_DATA = ROOT / "split_data" / "SkillMaster.json"
SKILLS_JSON = ROOT / "data" / "skills.json"

S7_SKILL_IDS: list[int] = [
    # サーヴェント (boss)
    210133, 220461, 220462, 220463, 230493,
    # スウォング
    220455, 230487, 230488, 230489,
    # ヴィーヴル (tactical exercise 共用，已在 skills.json)
    220172, 220173, 230163, 230164,
    # シェラッグ
    220458, 220459, 220460, 230492,
    # フロニュート
    220456, 220457, 230490, 230491,
]


def load_skill_master(path: Path) -> dict[int, dict]:
    with path.open("r", encoding="utf-8") as fh:
        raw = json.load(fh)
    items = raw if isinstance(raw, list) else raw.get("items", raw.get("Skills", []))
    out: dict[int, dict] = {}
    for entry in items:
        if not isinstance(entry, dict):
            continue
        eid = entry.get("Id") or entry.get("SkillId")
        if eid is None:
            continue
        out[int(eid)] = entry
    return out


def convert(master: dict) -> dict:
    """Convert a SkillMaster entry to the skills.json schema."""
    skill_id = int(master["Id"])
    name = master.get("Name", "")
    skill_type = master.get("Type")  # 1=AS, 2=PS, 3=EX
    skill_kind = master.get("Kind")  # 1=攻撃, 2=防御 etc.
    resource_cost = master.get("ResourceCost")
    cooldown = master.get("CoolTime")
    cooldown_update_timing = master.get("CoolTimeUpdateTiming")
    default_max_level = master.get("DefaultMaxLevel", 1)

    descriptions = []
    for tpl in master.get("DescriptionTemplates", []):
        descriptions.append({
            "min_level": tpl.get("Level", 1),
            "template": tpl.get("Template", ""),
        })
    if not descriptions:
        descriptions.append({"min_level": 1, "template": ""})

    template_tags: dict[str, dict] = {}
    for tag in master.get("TemplateTags", []):
        tag_name = tag.get("TagName")
        if not tag_name:
            continue
        values = []
        for v in tag.get("Values", []):
            values.append({
                "level": int(v["Level"]),
                "value": float(v["Value"]),
            })
        template_tags[tag_name] = {
            "interpolation_mode": int(tag.get("InterpolationMode", 1)),
            "values": values,
        }

    return {
        "skill_id": skill_id,
        "name": name,
        "skill_type": skill_type,
        "skill_kind": skill_kind,
        "resource_cost": resource_cost,
        "cooldown": cooldown,
        "cooldown_update_timing": cooldown_update_timing,
        "default_max_level": default_max_level,
        "descriptions": descriptions,
        "template_tags": template_tags,
    }


def main() -> None:
    if not SPLIT_DATA.exists():
        raise SystemExit(f"SkillMaster not found: {SPLIT_DATA}")
    master_map = load_skill_master(SPLIT_DATA)
    print(f"[INFO] Loaded {len(master_map)} SkillMaster entries")

    with SKILLS_JSON.open("r", encoding="utf-8") as fh:
        skills_data = json.load(fh)
    print(f"[INFO] Loaded {len(skills_data)} existing skills.json entries")

    added: list[int] = []
    skipped: list[int] = []
    missing: list[int] = []
    for sid in S7_SKILL_IDS:
        if str(sid) in skills_data:
            skipped.append(sid)
            continue
        master = master_map.get(sid)
        if master is None:
            missing.append(sid)
            continue
        skills_data[str(sid)] = convert(master)
        added.append(sid)

    print(f"[INFO] Added: {len(added)} ({added})")
    print(f"[INFO] Skipped (already present): {len(skipped)} ({skipped})")
    if missing:
        print(f"[WARN] Missing in SkillMaster: {missing}")

    with SKILLS_JSON.open("w", encoding="utf-8") as fh:
        json.dump(skills_data, fh, ensure_ascii=False, indent=2)
    print(f"[OK] Wrote {SKILLS_JSON}")


if __name__ == "__main__":
    main()
