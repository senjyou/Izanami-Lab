"""惨禍：アニス・ベネット (242305) 技能集成测试

验证5个技能的核心场景:
- 210116 ミッドサマー・ラブ (EX): 3次随机抽取敌/友目标, Lv5+追加EX加算
- 220411 サマー・スプラッシュ (AS): 4hit EN攻击 + EX窃取
- 230426 ヒートアップ・ラブ+ (PS1): 被击后0.75%阈值触发, 按EX消费比例回血, Lv10+追加ep_gain_up
- 230427 アクア・セービング+ (PS2): 自身(持汐風)累计伤害1.5%触发, 互斥230426
- 230428 サマータイム・ロマンス+ (PS3): 战斗中一次先制, 赋予自身「汐風」3层 + HP阈值减伤

与己方114302关键差异:
- 230428 mark目标: self (己方ally_adjacent)
- 230428 threshold_pct: 2 (己方20)
- 230426 trigger阈值: 0.75% (己方15%)
- 230427累计阈值: 1.5% (己方30%)
- 230427 mark检查: check_allies_with_mark含自身 (己方check_other_allies排除自身)
- 230427 PS互斥引用: 230426 (己方130158)
"""
import pytest
import json
import sys
import os
import unittest
from pathlib import Path

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import SkillEffectType, Position, Side
from src.entities_v2.unit_state import BuffState

MARK = SkillEffectType.MARK.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value
EP_GAIN_UP = SkillEffectType.EP_GAIN_UP.value
DMG_TAKEN_DOWN_THRESHOLD = "dmg_taken_down_threshold"


# ═══════════════════════════════════════════════════════════════
# 配置正确性测试
# ═══════════════════════════════════════════════════════════════

class TestActor242305Config:
    """配置正确性测试"""

    @pytest.fixture
    def hybrid_data(self):
        path = Path(__file__).parent.parent / "data" / "skill_effects_hybrid.json"
        with open(path, encoding='utf-8') as f:
            return json.load(f)

    def test_210116_config_exists(self, hybrid_data):
        """210116 ミッドサマー・ラブ 配置存在且含 random_draw, 名称无+后缀"""
        skill = hybrid_data.get("210116")
        assert skill is not None
        assert skill["name"] == "ミッドサマー・ラブ"
        assert skill["parse_status"] == "manual"
        block1 = skill["effect_blocks"][0]
        random_draw_effects = [e for e in block1["effects"] if e["effect_type"] == "random_draw"]
        assert len(random_draw_effects) == 1
        assert random_draw_effects[0]["hit_count"] == 3
        assert "ally_single_exclude_self" in random_draw_effects[0]["flags"]["candidate_types"]
        assert "enemy_single_nearest" in random_draw_effects[0]["flags"]["candidate_types"]

    def test_210116_add_ep_level_min_5(self, hybrid_data):
        """210116 add_ep level_min=5 (敌方Lv5+, 非通用映射的Lv10)"""
        effects = hybrid_data["210116"]["effect_blocks"][2]["effects"]
        add_ep_effects = [e for e in effects if e["effect_type"] == "add_ep"]
        assert len(add_ep_effects) == 2  # drawn_target + self
        for ep_eff in add_ep_effects:
            assert ep_eff["flags"]["level_min"] == 5

    def test_220411_config_4hit(self, hybrid_data):
        """220411 サマー・スプラッシュ 4hit EN攻击, 名称无+后缀"""
        skill = hybrid_data.get("220411")
        assert skill is not None
        assert skill["name"] == "サマー・スプラッシュ"
        damage_effects = [e for e in skill["effect_blocks"][0]["effects"]
                          if e["effect_type"] == "damage"]
        assert len(damage_effects) == 1
        assert damage_effects[0]["hit_count"] == 4
        assert damage_effects[0]["flags"]["is_en_attack"] is True

    def test_220411_ex_steal_effects(self, hybrid_data):
        """220411 含 remove_ep + add_ep 条件效果"""
        effects = hybrid_data["220411"]["effect_blocks"][0]["effects"]
        remove_ep = [e for e in effects if e["effect_type"] == "remove_ep"]
        add_ep = [e for e in effects if e["effect_type"] == "add_ep"]
        assert len(remove_ep) == 1
        assert len(add_ep) == 1
        assert remove_ep[0]["condition"]["type"] == "target_ep_above_or_equal"
        assert remove_ep[0]["condition"]["value"] == 1

    def test_230426_config_after_as_attacked(self, hybrid_data):
        """230426 ヒートアップ・ラブ+ trigger_type=after_as_attacked, 名称有+后缀"""
        skill = hybrid_data.get("230426")
        assert skill is not None
        assert skill["name"] == "ヒートアップ・ラブ+"
        assert skill["trigger_type"] == "after_as_attacked"
        gc = skill["global_condition"]
        assert gc["type"] == "and"
        cond_types = [c["type"] for c in gc["conditions"]]
        assert "damage_taken_in_action_percent" in cond_types
        assert "self_ep_above_or_equal" in cond_types
        # allow_ex_trigger: 描述未限定アクティブスキル, EX技能也可触发
        assert skill.get("allow_ex_trigger") is True

    def test_230426_trigger_threshold_075(self, hybrid_data):
        """230426 触发阈值=0.75% (敌方削弱版, 己方15%)"""
        gc = hybrid_data["230426"]["global_condition"]
        dmg_cond = next(c for c in gc["conditions"] if c["type"] == "damage_taken_in_action_percent")
        assert dmg_cond["value"] == 0.75

    def test_230426_ep_gain_up_level_min_10(self, hybrid_data):
        """230426 ep_gain_up level_min=10 (敌方Lv10+, 非通用映射的Lv5)"""
        blocks = hybrid_data["230426"]["effect_blocks"]
        ep_gain_eff = None
        for block in blocks:
            for e in block["effects"]:
                if e["effect_type"] == "ep_gain_up":
                    ep_gain_eff = e
                    break
        assert ep_gain_eff is not None
        assert ep_gain_eff["flags"]["level_min"] == 10

    def test_230427_config_on_cumulative_damage(self, hybrid_data):
        """230427 アクア・セービング+ trigger_type=on_cumulative_damage, 名称有+后缀"""
        skill = hybrid_data.get("230427")
        assert skill is not None
        assert skill["name"] == "アクア・セービング+"
        assert skill["trigger_type"] == "on_cumulative_damage"

    def test_230427_uses_check_allies_with_mark(self, hybrid_data):
        """230427 使用 check_allies_with_mark (含自身), 非 check_other_allies_with_mark (排除自身)"""
        gc = hybrid_data["230427"]["global_condition"]
        cond_types = [c["type"] for c in gc["conditions"]]
        assert "check_allies_with_mark" in cond_types
        assert "check_other_allies_with_mark" not in cond_types

    def test_230427_cumulative_threshold_15(self, hybrid_data):
        """230427 累计伤害阈值=1.5% (敌方削弱版, 己方30%)"""
        gc = hybrid_data["230427"]["global_condition"]
        cumul_cond = next(c for c in gc["conditions"] if c["type"] == "ally_cumulative_damage_percent")
        assert cumul_cond["value"] == 1.5

    def test_230427_ps_mutex_references_230426(self, hybrid_data):
        """230427 self_ps_lower_priority_than=230426 (敌方PS ID, 非130158)"""
        gc = hybrid_data["230427"]["global_condition"]
        mutex_cond = next(c for c in gc["conditions"] if c["type"] == "self_ps_lower_priority_than")
        assert mutex_cond["value"] == 230426

    def test_230428_config_once_per_battle(self, hybrid_data):
        """230428 サマータイム・ロマンス+ cooldown=99, 名称有+后缀"""
        skill = hybrid_data.get("230428")
        assert skill is not None
        assert skill["name"] == "サマータイム・ロマンス+"
        assert skill["trigger_type"] == "on_turn_start"
        assert skill["cooldown"] == 99

    def test_230428_mark_target_self(self, hybrid_data):
        """230428 mark target_type=self (敌方赋予自身, 己方ally_adjacent)"""
        effects = hybrid_data["230428"]["effect_blocks"][0]["effects"]
        mark_eff = [e for e in effects if e["effect_type"] == "mark"][0]
        assert mark_eff["target_type"] == "self"
        assert mark_eff["value"] == 3
        assert mark_eff["flags"]["mark_name"] == "汐風"
        assert mark_eff["flags"]["is_buff_mark"] is True
        assert mark_eff["flags"]["stackable"] is True

    def test_230428_threshold_pct_2(self, hybrid_data):
        """230428 dmg_taken_down_threshold threshold_pct=2 (敌方削弱版, 己方20)"""
        effects = hybrid_data["230428"]["effect_blocks"][0]["effects"]
        threshold_effs = [e for e in effects if e["effect_type"] == "dmg_taken_down_threshold"]
        assert len(threshold_effs) >= 1
        for eff in threshold_effs:
            assert eff["flags"]["threshold_pct"] == 2
            assert eff["flags"]["threshold_base"] == "current_hp"

    def test_230428_hit_count_tiers(self, hybrid_data):
        """230428 hit_count分级: 1[Lv1+] / 3[Lv5+] (跳过2, 己方1/2/3)"""
        effects = hybrid_data["230428"]["effect_blocks"][0]["effects"]
        threshold_effs = [e for e in effects if e["effect_type"] == "dmg_taken_down_threshold"]
        # Lv1+: hit_count=1
        base_eff = [e for e in threshold_effs if "level_min" not in e.get("flags", {})]
        assert len(base_eff) == 1
        assert base_eff[0]["hit_count"] == 1
        # Lv5+: hit_count=3
        lv5_eff = [e for e in threshold_effs if e.get("flags", {}).get("level_min") == 5]
        assert len(lv5_eff) == 1
        assert lv5_eff[0]["hit_count"] == 3

    def test_230428_add_ep_level_min_10(self, hybrid_data):
        """230428 add_ep level_min=10 (敌方Lv10+, 己方Lv13+)"""
        effects = hybrid_data["230428"]["effect_blocks"][0]["effects"]
        add_ep_eff = [e for e in effects if e["effect_type"] == "add_ep"]
        assert len(add_ep_eff) == 1
        assert add_ep_eff[0]["flags"]["level_min"] == 10


# ═══════════════════════════════════════════════════════════════
# EX技能功能测试
# ═══════════════════════════════════════════════════════════════

class TestEX210116(unittest.TestCase):
    """EX：3次随机抽取敌/友目标, def_down/atk_up, Lv5+追加EX加算"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=341719, atk=9831, defense=6806, speed=529,
                     skills=[210116], level=10, ep=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        bb.add_ally(unit_id="a2", position=Position.ALLY_RIGHT_FRONT, hp=50000)
        bb.add_ally(unit_id="a3", position=Position.ALLY_LEFT_BACK, hp=50000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")

    def test_ex_executes_successfully(self):
        """EX技能应成功执行"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210116,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])

    def test_ex_lv5_adds_ep(self):
        """Lv5+: 抽到友方时应加EP (drawn_target + self)"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=210116,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 验证至少有add_ep效果被尝试执行（可能抽到友方也可能抽到敌方）
        ep_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "add_ep"]
        # 如果有抽到友方，应该有add_ep效果
        # 由于随机性，不强制断言数量，但验证不报错

    def test_ex_block3_executes_when_ally_drawn(self):
        """Block3 (drawn_target_is_ally) 每次抽取独立执行, add_ep按次数叠加

        Bug1: Block2 (drawn_target_is_enemy) 过滤后更新了 _current_drawn_targets,
              导致 Block3 (drawn_target_is_ally) 读取时已无 ally, 被错误跳过.
        Bug2: Block3 对所有 matched 执行1次, atk_up对每个matched执行但add_ep只执行1次.
              用户期望: 每次抽取独立执行block, 3次抽到友方(自己)则 add_ep 恢复 (1+1)*3=6 EP.
        Fix: drawn_target_is_ally/drawn_target_is_enemy 条件检查时, 对每个 matched 独立执行
              block effects, 每次设置 _current_drawn_targets 为单个 matched.
        """
        self.caster.current_ep = 0  # 确保有add_ep空间 (max=10)
        # 使用override强制抽选序列: ally, ally, ally (caster是唯一敌方, ally候选=自己)
        draw_sequence = ['ally', 'ally', 'ally']
        draw_idx = [0]
        def override_func(ctx):
            target_type = draw_sequence[draw_idx[0] % len(draw_sequence)]
            draw_idx[0] += 1
            for c in ctx['candidates']:
                if c['type'] == target_type:
                    return c['index']
            return 0
        self.ss.set_random_draw_override(override_func)
        ep_before = self.caster.current_ep
        result = self.ss.execute_skill(caster=self.caster, skill_id=210116,
                                        battlefield=self.bf, skip_cost=True)
        self.ss.clear_random_draw_override()
        self.assertTrue(result["success"])
        # Block3 add_ep 每次抽取独立执行: 3次 * (drawn_target+1, self+1) = 6 EP
        # caster level=10 >= level_min=5, add_ep生效
        # caster是唯一敌方(无其他友方), ally候选=自己, drawn_target=self
        self.assertEqual(
            self.caster.current_ep, ep_before + 6,
            f"Block3 add_ep should give +6 EP (3 draws * (drawn_target+1, self+1)), "
            f"got EP {ep_before}->{self.caster.current_ep}"
        )


# ═══════════════════════════════════════════════════════════════
# AS技能功能测试
# ═══════════════════════════════════════════════════════════════

class TestAS220411(unittest.TestCase):
    """AS：4hit EN攻击 + EX窃取"""

    def setUp(self):
        bb = BattleBuilder()
        # caster ep=5 (低于上限10)，确保 add_ep 窃取后有提升空间
        bb.add_enemy(unit_id="c", hp=341719, atk=9831, defense=6806, speed=529,
                     skills=[220411], level=10, ep=5)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000, ep=3)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")
        self.target = next(u for u in self.bf.friend_team if u.unit_id == "a1")

    def test_as_deals_4hit_damage(self):
        """AS应造成4hit伤害"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=220411,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "should have damage effects")

    def test_as_steals_ep_when_target_has_ep(self):
        """目标EP>=1时应窃取1 EP"""
        ep_before_caster = self.caster.current_ep
        ep_before_target = self.target.current_ep
        result = self.ss.execute_skill(caster=self.caster, skill_id=220411,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 目标EP应减少（至少1点）
        self.assertLess(self.target.current_ep, ep_before_target,
                        "target EP should decrease")
        # 施法者EP应增加
        self.assertGreater(self.caster.current_ep, ep_before_caster,
                           "caster EP should increase")

    def test_as_no_steal_when_target_ep_zero(self):
        """目标EP=0时不应削减EP, 自身也不应回复EP

        Bug: remove_ep/add_ep 的 condition (target_ep_above_or_equal>=1) 未被检查,
             目标EP=0时仍执行 consume_ep (EP变负) 和 generate_ep (自身+1).
        Fix: 在 _apply_resource 的 remove_ep 单/多目标分支和 add_ep self 分支中
             添加 _check_target_condition 检查.
        """
        # 设置目标EP=0
        self.target.current_ep = 0
        ep_before_caster = self.caster.current_ep
        result = self.ss.execute_skill(caster=self.caster, skill_id=220411,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 目标EP应保持0（不削减）
        self.assertEqual(self.target.current_ep, 0,
                         "target EP should remain 0 (no remove_ep when target EP=0)")
        # 施法者EP不应增加（condition失败, add_ep不执行）
        self.assertEqual(self.caster.current_ep, ep_before_caster,
                         "caster EP should not increase (add_ep skipped when target EP=0)")


# ═══════════════════════════════════════════════════════════════
# PS3 (230428) 汐風mark系统测试
# ═══════════════════════════════════════════════════════════════

class TestPS3_230428ShiokazeMark(unittest.TestCase):
    """PS3：赋予自身「汐風」3层 + HP阈值减伤"""

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=341719, atk=9831, defense=6806, speed=529,
                     skills=[230428], level=10, ep=0, pp=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.ts = ctx['ts']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")

    def test_mark_applied_to_self(self):
        """230428 mark应赋予自身（非相邻友方）"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=230428,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        marks = [b for b in self.caster.buffs if getattr(b, 'effect_type', '') == MARK]
        self.assertTrue(len(marks) > 0, "caster should have 汐風 mark on self")
        for m in marks:
            self.assertEqual(m.name, "汐風")

    def test_mark_3_layers(self):
        """230428 应一次性赋予3层「汐風」"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=230428,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        marks = [b for b in self.caster.buffs if getattr(b, 'effect_type', '') == MARK
                 and getattr(b, 'name', '') == "汐風"]
        self.assertEqual(len(marks), 3, "should have 3 汐風 marks")

    def test_dmg_taken_down_threshold_applied(self):
        """230428 应赋予dmg_taken_down_threshold buff"""
        result = self.ss.execute_skill(caster=self.caster, skill_id=230428,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        threshold_buffs = [b for b in self.caster.buffs
                          if getattr(b, 'effect_type', '') == DMG_TAKEN_DOWN_THRESHOLD]
        self.assertTrue(len(threshold_buffs) > 0, "should have dmg_taken_down_threshold buff")

    def test_add_ep_at_lv10(self):
        """Lv10+: 应加EX"""
        ep_before = self.caster.current_ep
        result = self.ss.execute_skill(caster=self.caster, skill_id=230428,
                                        battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertGreater(self.caster.current_ep, ep_before,
                           "Lv10+ should add EP")

    def test_no_add_ep_below_lv10(self):
        """Lv9以下: 不应加EX"""
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=341719, atk=9831, defense=6806, speed=529,
                     skills=[230428], level=9, ep=0, pp=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.enemy_team if u.unit_id == "c")
        ep_before = caster.current_ep
        result = ss.execute_skill(caster=caster, skill_id=230428, battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertEqual(caster.current_ep, ep_before, "below Lv10 should not add EP")


# ═══════════════════════════════════════════════════════════════
# PS3 (230428) 阈值减伤机制测试
# ═══════════════════════════════════════════════════════════════

class TestPS3_230428ThresholdReduction(unittest.TestCase):
    """dmg_taken_down_threshold 阈值减伤（threshold_pct=2, current_hp基准）"""

    def test_threshold_formula(self):
        """阈值减伤公式: 超过阈值的伤害整体按 value% 减免
        描述「自身の現在HPの2%を超えるダメージのみ{dmg}%減少させる」:
        若 dmg > threshold, 整个伤害按 value% 减免 (非仅超过部分).
        公式: actual = dmg × (1 - value/100) if dmg > threshold else dmg
        threshold = current_hp × 2 / 100"""
        current_hp = 100000
        threshold = current_hp * 2 / 100  # 2000
        dmg = 10000
        value = 50  # 50%减免
        expected = dmg * (1 - value / 100)  # 10000 × 0.5 = 5000
        self.assertEqual(expected, 5000)

    def test_no_reduction_below_threshold(self):
        """伤害未超过阈值时不减免"""
        current_hp = 100000
        threshold = current_hp * 2 / 100  # 2000
        dmg = 1500
        value = 50
        actual = dmg * (1 - value / 100) if dmg > threshold else dmg
        self.assertEqual(actual, 1500)


# ═══════════════════════════════════════════════════════════════
# PS互斥机制测试
# ═══════════════════════════════════════════════════════════════

class TestPSMutex230426vs230427(unittest.TestCase):
    """PS1 (230426) vs PS2 (230427) 互斥机制

    230427 配置了 self_ps_lower_priority_than: 230426
    当 230426 在本phase已触发时, 230427 不触发
    """

    def test_mutex_config_correct(self):
        """230427 的 self_ps_lower_priority_than 引用 230426"""
        path = Path(__file__).parent.parent / "data" / "skill_effects_hybrid.json"
        with open(path, encoding='utf-8') as f:
            hybrid = json.load(f)
        gc = hybrid["230427"]["global_condition"]
        mutex_cond = next(c for c in gc["conditions"] if c["type"] == "self_ps_lower_priority_than")
        assert mutex_cond["value"] == 230426


# ═══════════════════════════════════════════════════════════════
# 等级阈值测试
# ═══════════════════════════════════════════════════════════════

class TestLevelThresholds(unittest.TestCase):
    """验证level_min阈值配置与敌方描述一致"""

    @pytest.fixture(autouse=True)
    def _load_hybrid(self):
        path = Path(__file__).parent.parent / "data" / "skill_effects_hybrid.json"
        with open(path, encoding='utf-8') as f:
            self.hybrid = json.load(f)

    def test_210116_add_ep_at_lv5(self):
        """210116 add_ep level_min=5 (敌方Lv5+, 对应己方Lv11+)"""
        effects = self.hybrid["210116"]["effect_blocks"][2]["effects"]
        add_ep = [e for e in effects if e["effect_type"] == "add_ep"]
        for ep in add_ep:
            self.assertEqual(ep["flags"]["level_min"], 5)

    def test_230426_ep_gain_up_at_lv10(self):
        """230426 ep_gain_up level_min=10 (敌方Lv10+, 对应己方Lv11+)"""
        blocks = self.hybrid["230426"]["effect_blocks"]
        for block in blocks:
            for e in block["effects"]:
                if e["effect_type"] == "ep_gain_up":
                    self.assertEqual(e["flags"]["level_min"], 10)
                    return
        self.fail("ep_gain_up effect not found")

    def test_230428_hit_count_3_at_lv5(self):
        """230428 hit_count=3 level_min=5 (敌方Lv5+)"""
        effects = self.hybrid["230428"]["effect_blocks"][0]["effects"]
        threshold_effs = [e for e in effects if e["effect_type"] == "dmg_taken_down_threshold"]
        lv5 = [e for e in threshold_effs if e.get("flags", {}).get("level_min") == 5]
        self.assertEqual(len(lv5), 1)
        self.assertEqual(lv5[0]["hit_count"], 3)

    def test_230428_add_ep_at_lv10(self):
        """230428 add_ep level_min=10 (敌方Lv10+)"""
        effects = self.hybrid["230428"]["effect_blocks"][0]["effects"]
        add_ep = [e for e in effects if e["effect_type"] == "add_ep"]
        self.assertEqual(len(add_ep), 1)
        self.assertEqual(add_ep[0]["flags"]["level_min"], 10)


# ═══════════════════════════════════════════════════════════════
# PS1 (230426) 互斥block回归测试
# ═══════════════════════════════════════════════════════════════

class TestPS1_230426MutexBlocks(unittest.TestCase):
    """230426 ヒートアップ・ラブ+ block互斥: block1(ep>=3) 与 block2(2<=ep<3) 互斥

    Bug: block条件评估使用实时EP, block1的remove_ep降低EP后,
         block2条件在新EP下又满足, 导致两个block同时执行 (effects=5而非3).
    Fix: 在block循环前快照EP, self_ep_above_or_equal/self_ep_below
         条件评估使用快照值, 确保互斥block基于初始EP判断.
    """

    def setUp(self):
        bb = BattleBuilder()
        bb.add_enemy(unit_id="c", hp=100000, atk=5000, defense=3000, speed=529,
                     skills=[230426], level=10, ep=4, pp=10)
        bb.add_ally(unit_id="a1", position=Position.ALLY_CENTER_FRONT, hp=50000)
        ctx = bb.build()
        self.bf, self.ss = ctx['bf'], ctx['ss']
        self.caster = next(u for u in self.bf.enemy_team if u.unit_id == "c")

    def _exec_with_ep(self, ep):
        self.caster.current_ep = ep
        return self.ss.execute_skill(caster=self.caster, skill_id=230426,
                                     battlefield=self.bf, skip_cost=True)

    def test_block1_only_when_ep_ge_3(self):
        """EP>=3时只执行block1 (remove_ep 2), block2应跳过"""
        result = self._exec_with_ep(4)
        self.assertTrue(result["success"])
        # 只应消耗2 EP (block1), 不应额外消耗1 EP (block2)
        self.assertEqual(self.caster.current_ep, 2,
                         f"EP should be 4-2=2 (block1 only), got {self.caster.current_ep}")
        # remove_ep效果应只有1个 (block1的value=2)
        remove_ep_effects = [e for e in result["effects_applied"]
                             if e.get("effect_type") == "remove_ep"]
        self.assertEqual(len(remove_ep_effects), 1,
                         f"should have 1 remove_ep (block1 only), got {len(remove_ep_effects)}")

    def test_block2_only_when_ep_eq_2(self):
        """EP=2时只执行block2 (remove_ep 1), block1应跳过"""
        result = self._exec_with_ep(2)
        self.assertTrue(result["success"])
        self.assertEqual(self.caster.current_ep, 1,
                         f"EP should be 2-1=1 (block2 only), got {self.caster.current_ep}")
        remove_ep_effects = [e for e in result["effects_applied"]
                             if e.get("effect_type") == "remove_ep"]
        self.assertEqual(len(remove_ep_effects), 1,
                         f"should have 1 remove_ep (block2 only), got {len(remove_ep_effects)}")

    def test_no_ep_block_when_ep_eq_1(self):
        """EP=1时block1和block2都跳过, 只有block3 (ep_gain_up)执行"""
        result = self._exec_with_ep(1)
        self.assertTrue(result["success"])
        self.assertEqual(self.caster.current_ep, 1,
                         f"EP should remain 1 (no remove_ep), got {self.caster.current_ep}")
        remove_ep_effects = [e for e in result["effects_applied"]
                             if e.get("effect_type") == "remove_ep"]
        self.assertEqual(len(remove_ep_effects), 0,
                         "should have 0 remove_ep when EP=1")

