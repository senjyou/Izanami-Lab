    def test_trigger_before_as_attacked_ps1(self):
        """trigger 时机1: PS1 before_as_attacked - 被攻击前触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # trigger_before_as_attacked 应收集 PS1
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130013]
        self.assertGreater(len(ps1_actions), 0,
                           "before_as_attacked 应收集 PS1(130013)")

    def test_trigger_on_hp_below_ps2(self):
        """trigger 时机2: PS2 on_hp_below - HP低于阈值时触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 设置 ally_front HP 跨越50%阈值
        self.ally_front.prev_hp_percent = 60.0
        self.ally_front.current_hp = int(self.ally_front.max_hp * 0.40)

        actions = self.ts.trigger_hp_below(self.bf, [self.ally_front])
        ps2_actions = [a for a in actions if a.skill_id == 130035]
        self.assertGreater(len(ps2_actions), 0,
                           "on_hp_below (HP<=50%) 应收集 PS2(130035)")

    def test_trigger_before_ally_as_attack_ps3(self):
        """trigger 时机3: PS3 before_ally_as_attack - 友方AS攻击前触发。"""
