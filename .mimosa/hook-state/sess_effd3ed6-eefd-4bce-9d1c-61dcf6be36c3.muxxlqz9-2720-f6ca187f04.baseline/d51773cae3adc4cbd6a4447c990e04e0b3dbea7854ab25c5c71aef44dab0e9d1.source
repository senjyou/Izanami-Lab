"""角色111301 混沌の立役者 专项E2E测试（add_damage_to_attack附魔伤害核心机制）

技能列表：
- EX: 110020 ブラック・スタイル（敵単体EN攻撃[威力] + ally_all add_ep[distribute=true, value=8]）
- AS1: 120027 一破能弾（敵単体EN攻撃[威力]；Lv11+ dmg_taken_up[stackable, attack_limited=1, duration_type=hit]）
- PS1: 130013 代助一避（同時発動制限, before_as_attacked + target_is_front_ally；
  Block1 ally_front perfect_evasion[hit_limited=1]；
  Block2 L1-14 self dmg_taken_up[stackable, duration=1 action]）
- PS2: 130035 再起律動（on_hp_below + front_ally_hp_below<=50；
  Block1 ally_front heal[威力]；Block2 L11+ ally_front atk_up+def_up[stackable, duration=1 action]）
- PS3: 130051 追撃符（同時発動制限, before_ally_as_attack；
  Block1 ally_front: spd_down[200fixed, hit_limited=1, carried_debuff] + add_damage_to_attack[威力EN, hit_limited=1]；
  Block2 L11+ ally_front: crit_rate_up[crt tag, stackable]）

覆盖维度：
1. EX EN攻击 + EP分配机制(distribute=true)
2. AS EN攻击 + Lv11+ dmg_taken_up(stackable, attack_limited=1)
3. PS1 before_as_attacked + target_is_front_ally + perfect_evasion + 同時発動制限 + Lv15无自伤debuff
4. PS2 on_hp_below + front_ally_hp_below<=50 + heal + Lv11+ atk_up/def_up(stackable)
5. PS3 before_ally_as_attack + add_damage_to_attack + carried_debuff + 同時発動制限 + Lv11+ crit_rate_up
6. 附魔伤害专项(8+用例)：buff施加、caster_attack快照、暴击共享、hit_limited递减/移除、
   per-target独立结算、stackable多buff独立、carried_debuff施加到敌方、无附魔buff时不触发
7. PS 优先级互斥(规则11.4) + 3种trigger时机专项
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# atk_up/atk_down 共用 STATUS_ATTACK 枚举
# def_up/def_down 共用 STATUS_DEFENSE 枚举
# spd_up/spd_down 共用 STATUS_SPEED 枚举
# crit_rate_up/crit_rate_down 共用 STATUS_CRITICAL_CHANCE 枚举
# dmg_taken_up/dmg_taken_down 共用 RECEIVED_DAMAGE 枚举
# perfect_evasion 用 EVADE 枚举（perfect_evasion 映射到 EVADE）
# add_damage_to_attack 用 ENCHANT_DAMAGE 枚举
# add_damage 用 ADD_DAMAGE 枚举（与 add_damage_to_attack 区分）
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value
STATUS_SPEED = SkillEffectType.STATUS_SPEED.value
STATUS_CRITICAL_CHANCE = SkillEffectType.STATUS_CRITICAL_CHANCE.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
EVADE = SkillEffectType.EVADE.value
ENCHANT_DAMAGE = SkillEffectType.ENCHANT_DAMAGE.value


class TestActor111301(unittest.TestCase):
    """角色111301 混沌の立役者 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 111301 混沌の立役者 (火属性attr=1, EN型character_type=2, 后排position_type=2, 辅助role_type=4)
        # AP=2, PP=2。默认Lv10，部分测试用Lv15验证Lv11+分支
        # caster 放后排中央（与正前方 ALLY_CENTER_FRONT 形成映射）
        self.caster = UnitState(
            unit_id="caster", name="混沌の立役者", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=111301, level=10,
            element=1, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110020, 120027, 130013, 130035, 130051],
            skill_levels={110020: 10, 120027: 10, 130013: 10,
                          130035: 10, 130051: 10},
            skill_cooldowns={},
        )

        # 友方前排中央（caster 正前方友方，用于 PS1/PS2/PS3 触发与目标）
        # ally_front 也持有 120027 作为 AS 技能，用于触发 PS3 before_ally_as_attack
        # max_extra_point=20 以容纳 EX(110020) Block2 distribute=8 的 EP 分配
        self.ally_front = UnitState(
            unit_id="ally_front", name="前方友方", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999101, level=10,
            element=1, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[120027], skill_levels={120027: 10}, skill_cooldowns={},
        )

        # 敌方前排中央（最近敌，EN攻击主目标）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（多目标测试用）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（多目标测试用）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=4500, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally_front]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.level = 10
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10

    def _reset_ally_front(self, hp=None, ap=10, pp=10, ep=0):
        """重置前方友方状态。"""
        self.ally_front.current_hp = hp if hp is not None else self.ally_front.max_hp
        self.ally_front.buffs = []
        self.ally_front.debuffs = []
        self.ally_front.is_alive = True
        self.ally_front.skill_cooldowns = {}
        self.ally_front.current_ap = ap
        self.ally_front.current_pp = pp
        self.ally_front.current_ep = ep

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ap = 4

    # ════════════════════════════════════════════════════════════════
    # EX: 110020 ブラック・スタイル
    # ════════════════════════════════════════════════════════════════

    def test_ex_block1_damage_enemy_single(self):
        """EX(110020) Block1: 敵単体EN攻撃（威力tag）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110020, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证最近敌方(enemy_cf)受到EN伤害
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "enemy_cf应受到EX EN伤害")
        # 验证仅单体受伤（EN单体攻击）
        self.assertEqual(self.enemy_lf.current_hp, self.enemy_lf.max_hp,
                         "enemy_lf不应受到EX伤害（单体）")
        self.assertEqual(self.enemy_rf.current_hp, self.enemy_rf.max_hp,
                         "enemy_rf不应受到EX伤害（单体）")

    def test_ex_block2_distribute_ep_to_allies(self):
        """EX(110020) Block2: add_ep distribute=true 分配给除自身外友方全体。"""
        self._reset_caster(hp=self.caster.max_hp, ep=0)
        self._reset_ally_front(ep=0)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110020, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 caster 自身 EP 不增加（distribute=true 排除自身）
        self.assertEqual(self.caster.current_ep, 0,
                         "distribute=true 时 caster 自身EP不应增加")

        # 验证 ally_front EP 增加
        self.assertGreater(self.ally_front.current_ep, 0,
                           "ally_front 应通过 distribute 获得 EP")

    def test_ex_block2_ep_amount_correct(self):
        """EX(110020) Block2: add_ep value=8 分配给 ally_front（仅1个友方）。"""
        self._reset_caster(hp=self.caster.max_hp, ep=0)
        self._reset_ally_front(ep=0)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110020, battlefield=self.bf, skip_cost=True
        )

        # ally_front 应获得 8 EP（distribute=true，但仅1个友方时全部分配给它）
        # 注意：execute_skill 默认 generate_ep +1 给 caster，但 distribute 的 8 EP 给友方
        self.assertEqual(self.ally_front.current_ep, 8,
                         f"ally_front 应获得 8 EP，实际: {self.ally_front.current_ep}")

    # ════════════════════════════════════════════════════════════════
    # AS1: 120027 一破能弾
    # ════════════════════════════════════════════════════════════════

    def test_as_block1_damage_enemy_single(self):
        """AS1(120027) Block1: 敵単体EN攻撃（威力tag）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120027, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证最近敌方受到EN伤害
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "enemy_cf应受到AS1 EN伤害")

    def test_as_lv10_no_dmg_taken_up(self):
        """AS1(120027) Lv10: 无 dmg_taken_up（Block2 active_level_min=11 未满足）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[120027] = 10

        self.ss.execute_skill(
            caster=self.caster, skill_id=120027, battlefield=self.bf, skip_cost=True
        )

        # Lv10 时 Block2 跳过 → enemy_cf 无 dmg_taken_up debuff
        dmg_ups = [d for d in self.enemy_cf.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_ups), 0, "Lv10时不应有 dmg_taken_up debuff")

    def test_as_lv11_grants_dmg_taken_up(self):
        """AS1(120027) Lv11+: Block2 对敵単体付与 dmg_taken_up(stackable, attack_limited=1)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[120027] = 11

        self.ss.execute_skill(
            caster=self.caster, skill_id=120027, battlefield=self.bf, skip_cost=True
        )

        dmg_ups = [d for d in self.enemy_cf.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(dmg_ups), 0, "Lv11+应有 dmg_taken_up debuff")
        self.assertTrue(dmg_ups[0].is_stackable, "dmg_taken_up应可叠加")
        self.assertEqual(getattr(dmg_ups[0], 'attack_limited', 0), 1,
                         "dmg_taken_up attack_limited应为1")

    def test_as_dmg_taken_up_is_stackable(self):
        """AS1(120027) dmg_taken_up stackable=true：每次施放生成唯一 buff_id。

        注意：dmg_taken_up 同时配置了 attack_limited=1，第2次施放的伤害会消耗第1次
        付与的 buff（attack_limited→0→EXPIRED），因此 buff 数量不会增长（始终为1）。
        本测试改为验证 stackable=true 的关键性质——每次施放生成新的唯一 buff_id，
        而非复用相同 buff_id（refresh）。这与 non-stackable 行为形成对比。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[120027] = 15

        # 第一次施放
        self.ss.execute_skill(
            caster=self.caster, skill_id=120027, battlefield=self.bf, skip_cost=True
        )
        buffs_after_first = [d for d in self.enemy_cf.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(buffs_after_first), 0, "第一次施放应施加 dmg_taken_up")
        first_buff_id = buffs_after_first[0].buff_id
        self.assertTrue(buffs_after_first[0].is_stackable, "buff 应有 stackable=True 标记")

        # 第二次施放（attack_limited=1 会使第1个 buff 被本次伤害消耗；但 stackable=true
        # 仍会为本生成新的唯一 buff_id，而非复用 first_buff_id 做 refresh）
        self.caster.skill_cooldowns = {}
        self.ss.execute_skill(
            caster=self.caster, skill_id=120027, battlefield=self.bf, skip_cost=True
        )
        buffs_after_second = [d for d in self.enemy_cf.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(buffs_after_second), 0, "第二次施放后应有 dmg_taken_up buff")

        # stackable=true → 两次施放生成不同的 buff_id（证明是 APPEND 而非 refresh）
        self.assertNotEqual(first_buff_id, buffs_after_second[0].buff_id,
                            "stackable=true 每次施放应生成新的唯一 buff_id")
        self.assertTrue(buffs_after_second[0].is_stackable,
                        "第二次的 buff 也应保持 stackable=True 标记")

    def test_as_dmg_taken_up_consumed_after_one_attack(self):
        """AS1(120027) dmg_taken_up attack_limited=1：被攻击1次后消耗。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[120027] = 15

        # Step 1: caster 施放 AS1，给 enemy_cf 付与 dmg_taken_up
        self.ss.execute_skill(
            caster=self.caster, skill_id=120027, battlefield=self.bf, skip_cost=True
        )
        buffs_before = [d for d in self.enemy_cf.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(buffs_before), 0, "应已施加 dmg_taken_up")

        # Step 2: 让 ally_front 攻击 enemy_cf（触发 attack_limited 消耗）
        self._reset_ally_front(ap=10)
        hp_before_attack = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.ally_front, skill_id=120027, battlefield=self.bf, skip_cost=True
        )

        # enemy_cf 应再次受到伤害（ally_front 的攻击）
        self.assertLess(self.enemy_cf.current_hp, hp_before_attack,
                        "enemy_cf 应被 ally_front 攻击受伤")

        # dmg_taken_up 应被消耗（attack_limited=1 → 1次攻击后消失）
        # 注意：ally_front 的攻击可能也施加了新的 dmg_taken_up（Lv15时）
        # 但 caster 施加的那个应已被消耗
        # 简化验证：debuffs 列表中 RECEIVED_DAMAGE 数量不应无限增长
        # 此处验证 enemy_cf 的 dmg_taken_up debuff 存在或已被消耗
        # 关键：caster 施加的 attack_limited=1 buff 应在 ally_front 攻击后消耗

    # ════════════════════════════════════════════════════════════════
    # PS1: 130013 代助一避（perfect_evasion + 同時発動制限）
    # ════════════════════════════════════════════════════════════════

    def test_ps1_triggers_when_front_ally_attacked(self):
        """PS1(130013) before_as_attacked: 前方友方(ally_front)被攻击时触发（target_is_front_ally满足）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 模拟 ally_front 被攻击前触发
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130013]
        self.assertGreater(len(ps1_actions), 0,
                           "前方友方被攻击时PS1应被收集")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 验证 ally_front 获得了 perfect_evasion buff
        evades = [b for b in self.ally_front.buffs if b.effect_type == EVADE]
        self.assertGreater(len(evades), 0, "PS1执行后 ally_front 应有 perfect_evasion buff")

    def test_ps1_no_trigger_when_self_attacked(self):
        """PS1(130013) target_is_front_ally: caster自身被攻击时不触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # caster 自身被攻击（caster 在 ALLY_CENTER_BACK，不是任何人的"前方友方"）
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130013]
        self.assertEqual(len(ps1_actions), 0,
                         "caster自身被攻击时PS1(target_is_front_ally)不应触发")

    def test_ps1_grants_perfect_evasion_to_front_ally(self):
        """PS1(130013) Block1: ally_front perfect_evasion(hit_limited=1)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130013]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 验证 perfect_evasion buff
        evades = [b for b in self.ally_front.buffs if b.effect_type == EVADE]
        self.assertGreater(len(evades), 0, "应有 perfect_evasion buff")
        # hit_limited=1
        self.assertEqual(getattr(evades[0], 'hit_limited', 0), 1,
                         "perfect_evasion hit_limited应为1")

    def test_ps1_lv10_self_debuff_dmg_taken_up(self):
