        self.assertGreater(getattr(enchants[0], 'caster_attack', 0), 0,
                           "add_damage_to_attack 应记录 caster_attack 快照")

    def test_ps3_grants_carried_debuff_spd_down(self):
        """PS3(130051) Block1: ally_front spd_down(200fixed, hit_limited=1, carried_debuff=true)。

        carried_debuff=true 意味着 spd_down 不是直接施加给目标，
        而是作为附魔 debuff 跟随 ally_front 的攻击，在攻击命中敌方时施加给敌方。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130051]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_ally_as_attack"
        )

        # carried_debuff=true → spd_down 不会直接施加给 ally_front 或 caster
        # 而是作为 carried_debuff buff 存在于 ally_front 的 buffs 中（待攻击时施加给敌方）
        # 验证：ally_front 不应有 spd_down debuff（carried_debuff 是 buff 而非 debuff）
        spd_downs_as_debuff = [d for d in self.ally_front.debuffs
                               if d.effect_type == STATUS_SPEED]
        self.assertEqual(len(spd_downs_as_debuff), 0,
                         "carried_debuff spd_down 不应直接作为 debuff 施加给 ally_front")

        # 验证：ally_front buffs 中应有 carried_debuff 载荷（标记为 spd_down 类型）
        # carried_debuff 通过 hit_limited_flags 携带信息，buff effect_type 为 STATUS_SPEED
        # 实际载体 buff 可能以 STATUS_SPEED 形式存在
        carried_buffs = [b for b in self.ally_front.buffs
                         if b.effect_type == STATUS_SPEED
                         and getattr(b, 'hit_limited_flags', None)]
        # 注意：carried_debuff 的具体存储形式可能因实现而异
        # 关键验证：ally_front 持有某种 spd_down 类型的载荷 buff

