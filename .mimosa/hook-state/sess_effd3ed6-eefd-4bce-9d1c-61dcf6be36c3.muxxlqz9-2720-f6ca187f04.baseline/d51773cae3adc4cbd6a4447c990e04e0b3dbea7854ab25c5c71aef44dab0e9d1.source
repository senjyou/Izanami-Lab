    def test_ps2_triggers_when_front_ally_hp_below_50(self):
        """PS2(130035) on_hp_below + front_ally_hp_below<=50: 前方友方HP降至50%以下触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 设置 ally_front HP 从 60% 降到 40%（跨越50%阈值）
        self.ally_front.prev_hp_percent = 60.0
        self.ally_front.current_hp = int(self.ally_front.max_hp * 0.40)

        actions = self.ts.trigger_hp_below(self.bf, [self.ally_front])
        ps2_actions = [a for a in actions if a.skill_id == 130035]
        self.assertGreater(len(ps2_actions), 0,
                           "前方友方HP<=50%时PS2应被收集")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_hp_below"
        )

        # 验证 ally_front HP 已回复（heal效果）
        self.assertGreater(self.ally_front.current_hp, int(self.ally_front.max_hp * 0.40),
                           "PS2 Block1 应已治疗 ally_front")

