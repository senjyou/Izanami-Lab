        self.assertGreater(len(evades), 0, "Lv15时Block1仍执行，ally_front应有 perfect_evasion")

    def test_ps1_perfect_evasion_blocks_one_hit(self):
        """PS1(130013) perfect_evasion: ally_front 被攻击时1次hit完全回避。

        perfect_evasion 机制：被攻击时跳过伤害结算（hit_limited-=1后消失）。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: 触发PS1给 ally_front 付与 perfect_evasion
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.ally_front], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130013]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_as_attacked"
        )

        evades = [b for b in self.ally_front.buffs if b.effect_type == EVADE]
        self.assertGreater(len(evades), 0, "应有 perfect_evasion buff")

        # Step 2: 让 enemy_cf 攻击 ally_front
        # 反转：让 enemy_cf 作为施法者，使用一个简单damage技能攻击
        # 用 caster 的 120027 反向模拟（enemy_cf 作施法者）
        hp_before = self.ally_front.current_hp
        self.ss.execute_skill(
            caster=self.enemy_cf, skill_id=120027, battlefield=self.bf, skip_cost=True
        )

        # perfect_evasion 应使 ally_front 不受伤（或受伤大幅减少）
        # 注意：enemy_cf 使用 120027 会攻击最近敌方（caster 在 ALLY_CENTER_BACK，ally_front 在 ALLY_CENTER_FRONT）
        # 实际可能命中 ally_front 或 caster，取决于索敌
        # 简化验证：perfect_evasion buff 应被消耗（hit_limited 从 1 减到 0 后移除）
        # 或者 ally_front HP 不变（如果命中了 ally_front）

    def test_ps1_triggers_on_pure_effect_as_skill(self):
        """PS1(130013) 纯效果AS技能也应触发 before_as_attacked。

        Bug: 原逻辑仅在 _apply_damage 中调用 _apply_damage_fire_before_attack_triggers，
        纯效果技能（无damage，如「夏のせいです」Block1: shield+dmg_dealt_down）不执行 damage，
        因此不会触发 before_as_attacked，导致代助一避未触发。

        场景: 敌方施放纯效果AS技能(120159 夏のせいです Block1)，dmg_dealt_down target_type=enemy_front
        即友方前排(ally_front)。代助一避应在技能效果施加前触发，给 ally_front 附加 perfect_evasion。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 创建敌方施法者，持有 120159（夏のせいです 己方版，Block1 为纯效果）
        # 120159 Block1 condition=self_lacks_mark 暑気，无暑気时执行 shield+dmg_dealt_down
        enemy_caster = UnitState(
            unit_id="enemy_caster", name="敌方施法者", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=131302, level=10,
            element=2, character_type=2,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[120159], skill_levels={120159: 10}, skill_cooldowns={},
        )
        # 替换 enemy_cf 为 enemy_caster（保持 enemy_team 结构）
        self.bf.enemy_team = [enemy_caster, self.enemy_lf, self.enemy_rf]

        # 执行纯效果AS技能（无暑気 mark，走 Block1: shield+self, dmg_dealt_down+enemy_front）
        result = self.ss.execute_skill(
            caster=enemy_caster, skill_id=120159, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证代助一避被触发：perfect_evasion 闪避了 debuff
        # perfect_evasion 是 hit_limited=1，闪避一次后 buff 被消耗移除
        # 所以验证 dmg_dealt_down debuff 未被施加到 ally_front
        dmg_dealt_downs = [d for d in self.ally_front.debuffs
                           if d.effect_type == SkillEffectType.DEALT_DAMAGE.value]
        self.assertEqual(len(dmg_dealt_downs), 0,
                         "代助一避的perfect_evasion应闪避dmg_dealt_down debuff，"
                         "ally_front 不应有 DealtDamage debuff")

