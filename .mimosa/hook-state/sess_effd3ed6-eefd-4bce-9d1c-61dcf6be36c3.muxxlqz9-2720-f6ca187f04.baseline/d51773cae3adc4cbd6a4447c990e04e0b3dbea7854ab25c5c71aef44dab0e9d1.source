    def test_ps3_cooldown_blocks_retrigger(self):
        """PS3(130051) cooldown=1: 第一次触发后冷却中，第二次不应再被收集。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 第一次触发
        actions1 = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_1 = [a for a in actions1 if a.skill_id == 130051]
        self.assertGreater(len(ps3_1), 0, "第一次应触发PS3")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_1, self.bf, trigger_timing="before_ally_as_attack"
        )
        # 验证冷却已设置
        self.assertEqual(self.caster.skill_cooldowns.get(130051), 1,
                         "PS3执行后应设置cooldown=1")

        # 第二次触发（PS3在冷却中）
        actions2 = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_2 = [a for a in actions2 if a.skill_id == 130051]
        self.assertEqual(len(ps3_2), 0, "PS3在冷却中 → 不应再次被收集")

    # ════════════════════════════════════════════════════════════════
    # 附魔伤害机制专项（8+ 用例）
    # ════════════════════════════════════════════════════════════════

    def test_enchant_damage_buff_granted_to_ally_front(self):
        """附魔伤害 buff 施加验证：PS3 给 ally_front 施加 add_damage_to_attack(ENCHANT_DAMAGE)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130051]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_ally_as_attack"
        )

        # 验证 ENCHANT_DAMAGE buff 存在
        enchants = [b for b in self.ally_front.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertGreater(len(enchants), 0,
                           "应有 add_damage_to_attack (ENCHANT_DAMAGE) buff")
        # 验证 caster_attack 快照（应大于0）
        self.assertGreater(getattr(enchants[0], 'caster_attack', 0), 0,
                           "ENCHANT_DAMAGE buff 应记录 caster_attack 快照")
        # 验证 source_unit_id 是 caster
        self.assertEqual(enchants[0].source_unit_id, self.caster.unit_id,
                         "ENCHANT_DAMAGE 来源应是 caster (111301)")

    def test_enchant_damage_uses_caster_attack_snapshot(self):
        """附魔伤害使用 buff 来源施法时的快照攻击力（caster_attack）。

        验证：即使 caster 后续攻击力变化，附魔伤害仍使用快照值。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: 触发 PS3 给 ally_front 附魔（记录 caster_attack 快照）
        original_atk = self.caster.attack
        actions = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130051]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_ally_as_attack"
        )

        enchants = [b for b in self.ally_front.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertGreater(len(enchants), 0, "应有附魔buff")
        snapshot_atk = enchants[0].caster_attack
        self.assertGreater(snapshot_atk, 0, "快照攻击力应>0")

        # Step 2: 改变 caster 的攻击力（模拟 caster 攻击力变化）
        self.caster.attack = original_atk * 10  # 攻击力变为10倍

        # Step 3: 让 ally_front 执行 AS 攻击，触发附魔伤害结算
        # 此时附魔伤害应基于 snapshot_atk（而非 caster 当前攻击力）
        enemy_hp_before = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.ally_front, skill_id=120027, battlefield=self.bf, skip_cost=True
        )

        # enemy_cf 应受到附魔伤害（基于快照攻击力）
        # 主要验证：附魔伤害确实触发了（enemy_cf HP 进一步下降）
        # 注意：ally_front 自身的 120027 也会造成伤害，所以总伤害是主攻击+附魔伤害
        self.assertLess(self.enemy_cf.current_hp, enemy_hp_before,
                        "enemy_cf 应受到主攻击+附魔伤害")

    def test_enchant_damage_crit_shared_with_main_attack(self):
        """附魔伤害的暴击共享主攻击的暴击结果。

        验证：主攻击暴击时，附魔伤害也暴击（force_crit=any(hit_crits)）。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 触发 PS3 给 ally_front 附魔
        actions = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130051]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_ally_as_attack"
        )

        # 设置 ally_front 暴击率为100%（确保主攻击暴击）
        self.ally_front.crit_rate = 1.0

        enemy_hp_before = self.enemy_cf.current_hp

        # 执行 AS 攻击
        result = self.ss.execute_skill(
            caster=self.ally_front, skill_id=120027, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 主攻击应暴击（crit_rate=1.0）
        # 附魔伤害应共享暴击（force_crit=True）
        # 验证：总伤害应高于无暴击情况（间接验证）
        hp_loss = enemy_hp_before - self.enemy_cf.current_hp
        self.assertGreater(hp_loss, 0, "应造成伤害（主攻击+附魔伤害，含暴击）")

    def test_enchant_damage_hit_limited_decrement_after_attack(self):
        """附魔伤害 hit_limited 递减：1次攻击后 hit_limited 从 1 减到 0 后移除。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 触发 PS3 给 ally_front 附魔
        actions = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130051]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_ally_as_attack"
        )

        enchants_before = [b for b in self.ally_front.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants_before), 1, "应仅有1个附魔buff")
        self.assertEqual(enchants_before[0].hit_limited, 1, "初始 hit_limited=1")

        # 执行 AS 攻击（消耗 hit_limited）
        self.ss.execute_skill(
            caster=self.ally_front, skill_id=120027, battlefield=self.bf, skip_cost=True
        )

        # 附魔buff 应被消耗（hit_limited 从 1 减到 0 后移除）
        enchants_after = [b for b in self.ally_front.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants_after), 0,
                         "1次攻击后附魔buff应被移除（hit_limited消耗完毕）")

    def test_enchant_damage_no_trigger_without_buff(self):
        """无附魔buff时 ally_front 攻击不触发附魔伤害结算。

        验证：未触发PS3时，ally_front 攻击仅造成主攻击伤害。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()

        # 不触发 PS3，ally_front 无附魔buff
        enchants = [b for b in self.ally_front.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants), 0, "未触发PS3时 ally_front 应无附魔buff")

        # 执行 AS 攻击
        enemy_hp_before = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.ally_front, skill_id=120027, battlefield=self.bf, skip_cost=True
        )

        # 应仅造成主攻击伤害（无附魔伤害）
        hp_loss = enemy_hp_before - self.enemy_cf.current_hp
        self.assertGreater(hp_loss, 0, "应造成主攻击伤害")

        # 验证：攻击后仍无附魔buff
        enchants_after = [b for b in self.ally_front.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants_after), 0, "攻击后仍应无附魔buff")

    def test_enchant_damage_consumed_after_one_attack(self):
        """附魔伤害一次攻击后消耗：第二次攻击不再触发附魔伤害。

        场景：触发PS3附魔 → 第1次攻击触发附魔伤害 → 第2次攻击无附魔伤害。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 触发 PS3 附魔
        actions = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130051]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_ally_as_attack"
        )

        # 第1次攻击：应触发附魔伤害
        enemy_hp_before_1 = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.ally_front, skill_id=120027, battlefield=self.bf, skip_cost=True
        )
        hp_loss_1 = enemy_hp_before_1 - self.enemy_cf.current_hp

        # 验证附魔buff已被消耗
        enchants = [b for b in self.ally_front.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants), 0, "第1次攻击后附魔buff应被消耗")

        # 第2次攻击：仅主攻击伤害，无附魔伤害
        self._reset_enemies()
        enemy_hp_before_2 = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.ally_front, skill_id=120027, battlefield=self.bf, skip_cost=True
        )
        hp_loss_2 = enemy_hp_before_2 - self.enemy_cf.current_hp

        # 第2次伤害应小于第1次（因第1次含附魔伤害）
        self.assertLess(hp_loss_2, hp_loss_1,
                        f"第2次伤害({hp_loss_2})应小于第1次({hp_loss_1})，因第1次含附魔伤害")

    def test_enchant_damage_per_target_independent(self):
        """附魔伤害 per-target 独立结算：多目标攻击时每个目标独立结算附魔伤害。

        场景：ally_front 的 120027 是单体攻击，但附魔伤害机制应支持多目标独立结算。
        通过对比单体攻击的伤害，验证附魔伤害确实作用于被攻击的目标。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 触发 PS3 附魔
        actions = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130051]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_ally_as_attack"
        )

        # 执行 AS 攻击（120027 是单体攻击，命中 enemy_cf）
        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp

        self.ss.execute_skill(
            caster=self.ally_front, skill_id=120027, battlefield=self.bf, skip_cost=True
        )

        # 验证仅 enemy_cf 受伤（单体攻击+附魔伤害）
        self.assertLess(self.enemy_cf.current_hp, hp_cf_before,
                        "enemy_cf 应受到主攻击+附魔伤害")
        # enemy_lf 和 enemy_rf 不应受伤（单体攻击）
        self.assertEqual(self.enemy_lf.current_hp, hp_lf_before,
                         "enemy_lf 不应受伤（单体攻击+附魔伤害）")
        self.assertEqual(self.enemy_rf.current_hp, hp_rf_before,
                         "enemy_rf 不应受伤（单体攻击+附魔伤害）")

    def test_enchant_damage_stackable_multiple_buffs(self):
        """附魔伤害多次触发行为：130051 未配置 stackable=true，第2次触发刷新而非叠加。

        与 110069「あったかいの、どうぞ♪」(stackable=true → 多 buff 共存) 不同，
        130051「追撃符」的 add_damage_to_attack 未配置 stackable=true，
        因此第2次触发不会叠加第2个 buff，而是 refresh（保持1个 buff）。
        本测试验证此 non-stackable 行为。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 第1次触发 PS3
        actions1 = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_1 = [a for a in actions1 if a.skill_id == 130051]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_1, self.bf, trigger_timing="before_ally_as_attack"
        )
        enchants_after_1 = [b for b in self.ally_front.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants_after_1), 1, "第1次触发应有1个附魔buff")

        # 重置冷却（模拟冷却结束）
        self.caster.skill_cooldowns = {}

        # 第2次触发 PS3
        actions2 = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_2 = [a for a in actions2 if a.skill_id == 130051]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_2, self.bf, trigger_timing="before_ally_as_attack"
        )

        # 130051 未配置 stackable=true → 第2次 refresh 而非叠加，仍为1个 buff
        enchants_after_2 = [b for b in self.ally_front.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants_after_2), 1,
                         "130051 未配置 stackable=true，第2次触发应 refresh 而非叠加（仍为1个）")
        # 验证 buff 仍存在且 effect_type 正确
        self.assertEqual(enchants_after_2[0].effect_type, ENCHANT_DAMAGE,
                         "refresh 后的 buff 仍应为 ENCHANT_DAMAGE 类型")

    def test_carried_debuff_applied_to_enemy_on_attack(self):
        """carried_debuff 在 ally_front 攻击命中敌方时施加给敌方。

        场景：PS3 触发后 ally_front 持有 spd_down carried_debuff，
        当 ally_front 攻击 enemy_cf 时，spd_down 应被施加给 enemy_cf。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 触发 PS3 给 ally_front 附魔（含 spd_down carried_debuff）
        actions = self.ts.trigger_before_ally_as_attack(
            actor=self.ally_front, skill_id=120027, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == 130051]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_ally_as_attack"
        )

        # 验证 ally_front 持有 carried_debuff 载荷（在 buffs 中，effect_type=STATUS_SPEED）
        # 注意：carried_debuff 通过 hit_limited_flags 携带信息
        # 验证 ally_front 攻击前，enemy_cf 无 spd_down debuff
        spd_downs_before = [d for d in self.enemy_cf.debuffs
                            if d.effect_type == STATUS_SPEED]
        self.assertEqual(len(spd_downs_before), 0,
                         "攻击前 enemy_cf 不应有 spd_down debuff")

        # 执行 AS 攻击
        self.ss.execute_skill(
            caster=self.ally_front, skill_id=120027, battlefield=self.bf, skip_cost=True
        )

        # 验证 enemy_cf 受到伤害
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "enemy_cf 应受到 ally_front 的攻击伤害")

        # 验证 carried_debuff (spd_down) 应被施加给 enemy_cf
        # 注意：spd_down value=200 fixed (value_tag=0 表示 fixed)
        spd_downs_after = [d for d in self.enemy_cf.debuffs
                           if d.effect_type == STATUS_SPEED]
        self.assertGreater(len(spd_downs_after), 0,
                           "攻击后 enemy_cf 应有 spd_down debuff（来自 carried_debuff）")

    # ════════════════════════════════════════════════════════════════
    # 3种 trigger 触发时机专项
