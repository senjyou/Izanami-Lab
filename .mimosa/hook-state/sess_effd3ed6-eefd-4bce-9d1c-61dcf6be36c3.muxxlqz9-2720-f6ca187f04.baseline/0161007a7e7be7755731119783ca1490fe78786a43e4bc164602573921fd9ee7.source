"""HP比例索敌精度单元测试。

验证int(ratio*10000)/10000截断精度（非round），以及同比例时的位置tiebreaker。
覆盖target_service.py和skill_service.py中的13处索敌路径。
"""
import sys
import os
import pytest
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..', 'src'))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.enums import Side, Position
from src.combat_v2.services.target_service import TargetService


def _make_unit(unit_id, side=Side.ENEMY, position=Position.ENEMY_LEFT_FRONT,
               hp=50000, max_hp=50000, speed=500):
    """创建测试用单位。"""
    return UnitState(
        unit_id=unit_id, name=unit_id, side=side, position=position,
        character_id=999001, level=10, element=2, character_type=1,
        max_hp=max_hp, attack=10000, defense=5000, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_hp=hp, current_ap=10, current_pp=10, current_ep=10,
    )


class TestHpRatioTruncation:
    """HP比例截断精度测试。"""

    def test_truncation_vs_round(self):
        """截断vs四舍五入：-1血单位应被识别为99.99%而非100%。"""
        # 49999/50000 = 0.99998
        # round(0.99998, 4) = 1.0（四舍五入进位）
        # int(0.99998 * 10000) / 10000 = 0.9999（截断）
        ratio = 49999 / 50000
        truncated = int(ratio * 10000) / 10000
        rounded = round(ratio, 4)
        assert truncated == 0.9999
        assert rounded == 1.0  # round会进位到100%
        assert truncated != rounded  # 两者不同

    def test_full_hp_vs_minus_one_hp(self):
        """满血单位和-1血单位应有不同的truncated比例。"""
        ratio_full = 50000 / 50000
        ratio_minus1 = 49999 / 50000
        trunc_full = int(ratio_full * 10000) / 10000
        trunc_minus1 = int(ratio_minus1 * 10000) / 10000
        assert trunc_full == 1.0
        assert trunc_minus1 == 0.9999
        assert trunc_full != trunc_minus1  # 可区分

    def test_truncation_precision(self):
        """万分位精度截断。"""
        # 12345/100000 = 0.12345 → 截断到0.1234
        ratio = 12345 / 100000
        truncated = int(ratio * 10000) / 10000
        assert truncated == 0.1234

        # 12346/100000 = 0.12346 → 截断到0.1234（不进位）
        ratio2 = 12346 / 100000
        truncated2 = int(ratio2 * 10000) / 10000
        assert truncated2 == 0.1234


class TestLowestHpRatioTargeting:
    """最低HP比例索敌测试（target_service路径）。"""

    def test_selects_lowest_hp_ratio(self):
        """选择HP比例最低的单位。"""
        from src.entities_v2.enums import DisplayTargetPriority
        tgs = TargetService()
        caster = _make_unit("caster", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        units = [
            _make_unit("e1", hp=30000, max_hp=50000, position=Position.ENEMY_LEFT_FRONT),    # 60%
            _make_unit("e2", hp=10000, max_hp=50000, position=Position.ENEMY_CENTER_FRONT),  # 20%
            _make_unit("e3", hp=40000, max_hp=50000, position=Position.ENEMY_RIGHT_FRONT),   # 80%
        ]
        # 模拟LOWEST_HP_PERCENT排序
        sorted_units = sorted(units, key=lambda u: (
            int(u.current_hp / u.max_hp * 10000) / 10000,
            tgs._get_sort_key(caster, u),
        ))
        assert sorted_units[0].unit_id == "e2"  # 20%最低

    def test_minus_one_hp_not_treated_as_full(self):
        """-1血单位不被当作满血（截断精度关键测试）。"""
        tgs = TargetService()
        caster = _make_unit("caster", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        units = [
            _make_unit("full", hp=50000, max_hp=50000, position=Position.ENEMY_LEFT_FRONT),     # 100%
            _make_unit("minus1", hp=49999, max_hp=50000, position=Position.ENEMY_CENTER_FRONT),  # 99.99%
        ]
        # lowest_hp_ratio应选minus1（99.99% < 100%）
        sorted_units = sorted(units, key=lambda u: (
            int(u.current_hp / u.max_hp * 10000) / 10000,
            tgs._get_sort_key(caster, u),
        ))
        assert sorted_units[0].unit_id == "minus1"

    def test_same_ratio_tiebreaker_by_position(self):
        """同HP比例时按位置距离选择最近目标。"""
        tgs = TargetService()
        caster = _make_unit("caster", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        # 两个单位都是50% HP，但e1更近
        units = [
            _make_unit("e_far", hp=25000, max_hp=50000, position=Position.ENEMY_RIGHT_FRONT),
            _make_unit("e_near", hp=25000, max_hp=50000, position=Position.ENEMY_LEFT_FRONT),
        ]
        sorted_units = sorted(units, key=lambda u: (
            int(u.current_hp / u.max_hp * 10000) / 10000,
            tgs._get_sort_key(caster, u),
        ))
        # 同比例时按位置距离，e_near更近应排第一
        assert sorted_units[0].unit_id == "e_near"

    def test_different_ratios_still_distinguishable(self):
        """不同HP比例仍可正常区分。"""
        tgs = TargetService()
        caster = _make_unit("caster", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        # 49998/50000=0.99996→0.9999, 49997/50000=0.99994→0.9999
        # 在万分位精度下相同，这是预期行为（精度损失）
        ratio1 = int(49998 / 50000 * 10000) / 10000
        ratio2 = int(49997 / 50000 * 10000) / 10000
        assert ratio1 == ratio2  # 万分位精度下相同

        # 但差距更大的不同比例可区分
        # 45000/50000=0.9→0.9, 40000/50000=0.8→0.8
        ratio3 = int(45000 / 50000 * 10000) / 10000
        ratio4 = int(40000 / 50000 * 10000) / 10000
        assert ratio3 != ratio4
        assert ratio3 == 0.9
        assert ratio4 == 0.8


class TestHighestHpRatioTargeting:
    """最高HP比例索敌测试。"""

    def test_selects_highest_hp_ratio(self):
        """选择HP比例最高的单位。"""
        tgs = TargetService()
        caster = _make_unit("caster", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        units = [
            _make_unit("e1", hp=30000, max_hp=50000, position=Position.ENEMY_LEFT_FRONT),    # 60%
            _make_unit("e2", hp=45000, max_hp=50000, position=Position.ENEMY_CENTER_FRONT),  # 90%
            _make_unit("e3", hp=20000, max_hp=50000, position=Position.ENEMY_RIGHT_FRONT),   # 40%
        ]
        # highest_hp_ratio: reverse=True, tiebreaker用-position_key
        sorted_units = sorted(units, key=lambda u: (
            int(u.current_hp / u.max_hp * 10000) / 10000,
            -tgs._get_sort_key(caster, u),
        ), reverse=True)
        assert sorted_units[0].unit_id == "e2"  # 90%最高

    def test_highest_ratio_tiebreaker_nearest(self):
        """同HP比例时最高比例索敌也按位置距离选最近。"""
        tgs = TargetService()
        caster = _make_unit("caster", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        units = [
            _make_unit("e_far", hp=30000, max_hp=50000, position=Position.ENEMY_RIGHT_FRONT),
            _make_unit("e_near", hp=30000, max_hp=50000, position=Position.ENEMY_LEFT_FRONT),
        ]
        # highest_hp_ratio: reverse=True, tiebreaker用-position_key保持最近优先
        sorted_units = sorted(units, key=lambda u: (
            int(u.current_hp / u.max_hp * 10000) / 10000,
            -tgs._get_sort_key(caster, u),
        ), reverse=True)
        assert sorted_units[0].unit_id == "e_near"  # 同比例时近的排前


class TestMultipleUnitsMinusOneHp:
    """多单位-1血场景测试。"""

    def test_multiple_minus_one_hp_all_distinguishable_from_full(self):
        """多个-1血单位都与满血单位可区分。"""
        tgs = TargetService()
        caster = _make_unit("caster", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        units = [
            _make_unit("full1", hp=50000, max_hp=50000, position=Position.ENEMY_LEFT_FRONT),
            _make_unit("minus1_a", hp=49999, max_hp=50000, position=Position.ENEMY_CENTER_FRONT),
            _make_unit("minus1_b", hp=49999, max_hp=50000, position=Position.ENEMY_RIGHT_FRONT),
        ]
        # lowest_hp_ratio应选minus1_a或minus1_b（都是99.99%），不选full1（100%）
        sorted_units = sorted(units, key=lambda u: (
            int(u.current_hp / u.max_hp * 10000) / 10000,
            tgs._get_sort_key(caster, u),
        ))
        assert sorted_units[0].unit_id in ("minus1_a", "minus1_b")
        assert sorted_units[-1].unit_id == "full1"  # 满血排最后

    def test_zero_hp_unit_ratio(self):
        """0血单位的比例为0（最低）。"""
        tgs = TargetService()
        caster = _make_unit("caster", side=Side.ALLY, position=Position.ALLY_LEFT_FRONT)
        units = [
            _make_unit("e1", hp=1, max_hp=50000, position=Position.ENEMY_LEFT_FRONT),
            _make_unit("e0", hp=0, max_hp=50000, position=Position.ENEMY_CENTER_FRONT),
        ]
        ratio_e1 = int(1 / 50000 * 10000) / 10000  # 0.0002 → 0
        ratio_e0 = int(0 / 50000 * 10000) / 10000  # 0
        # 在万分位精度下，1血和0血相同（都是0%）
        assert ratio_e1 == ratio_e0 == 0.0
