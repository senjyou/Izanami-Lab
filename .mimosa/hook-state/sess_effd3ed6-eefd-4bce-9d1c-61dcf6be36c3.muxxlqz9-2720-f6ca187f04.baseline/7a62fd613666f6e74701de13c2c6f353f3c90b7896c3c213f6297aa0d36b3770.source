# Block 1: shield all allies (ATK × shield%, duration_type=attacker_action - cleared at caster's action end)
# Block 2 (Lv11+): HOT all allies (ATK × 威力%, duration=2 action)
CONFIGS["110037"] = {
    "skill_id": 110037,
    "name": "クリスマス・デコレーション",
    "skill_type": 3,
    "resource_cost": 6,
    "cooldown": None,
    "cooldown_update_timing": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
    "trigger_type": None,
    "global_condition": None,
    "effect_blocks": [
        make_block(1, [
            make_effect(
                "shield",
                "ally_all",
                value=None,
                value_tag="shield",
                duration=1,
                duration_type="attacker_action",
                flags={"value_type": "percent", "heal_base": "atk"},
            ),
        ]),
        make_block(2, [
            make_effect(
                "heal_over_time",
                "ally_all",
                value=None,
                value_tag="威力",
                duration=2,
                duration_type="action",
                condition={"type": "active_level_min", "value": 11},
                flags={"heal_base": "atk"},
            ),
        ], condition={"type": "active_level_min", "value": 11}),
    ],
    "display_target_priority": None,
    "display_target_range": 5,
    "display_target_type": 2,
    "parse_status": "success",
    "parse_notes": [
        "EX: shield all allies (ATK × shield%, attacker_action end) + Lv11+ HOT (ATK × 威力%, 2 actions)"
    ],
}

