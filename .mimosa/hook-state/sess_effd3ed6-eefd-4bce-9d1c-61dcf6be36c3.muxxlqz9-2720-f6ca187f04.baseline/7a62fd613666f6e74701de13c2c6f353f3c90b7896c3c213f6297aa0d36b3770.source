# 130096 PS2 はらぐろさくしー
# trigger: on_critical
# Block 1 (Lv1-14): on_crit block + remove_buff (value_tag=buff, count from tag)
# Block 2 (Lv15): on_crit block + remove_buff (remove_all=true, removes all buffs)
CONFIGS["130096"] = {
    "skill_id": 130096,
    "name": "はらぐろさくしー",
    "skill_type": 2,
    "resource_cost": 1,
    "cooldown": None,
    "cooldown_update_timing": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
    "trigger_type": "on_critical",
    "global_condition": None,
    "effect_blocks": [
        make_block(1, [
            make_effect(
                "remove_buff",
                "crit_target",
                value=None,
                value_tag="buff",
                condition={"type": "on_crit"},
                flags={"once_per_skill": False, "active_level_max": 14},
            ),
        ], condition={"type": "active_level_max", "value": 14}),
        make_block(2, [
            make_effect(
                "remove_buff",
                "crit_target",
                value=None,
                value_tag=None,
                condition={"type": "on_crit"},
                flags={"once_per_skill": False, "remove_all": True},
            ),
        ], condition={"type": "active_level_min", "value": 15}),
    ],
    "display_target_priority": None,
    "display_target_range": 1,
    "display_target_type": 3,
    "parse_status": "success",
    "parse_notes": [
        "PS2: on_critical + on_crit block + remove_buff to crit_target. Lv1-14: count from buff tag. Lv15: remove_all=true (all removable buffs)"
    ],
}


def main():
    with open(HYBRID_PATH, 'r', encoding='utf-8') as f:
        data = json.load(f)

    added = []
    skipped = []
    for skill_id_str, config in CONFIGS.items():
        if skill_id_str in data:
            print(f"SKIP {skill_id_str} (already exists)")
            skipped.append(skill_id_str)
            continue
        data[skill_id_str] = config
        added.append(skill_id_str)

    with open(HYBRID_PATH, 'w', encoding='utf-8') as f:
        json.dump(data, f, ensure_ascii=False, indent=2)

    print(f"Added: {added}")
    print(f"Skipped: {skipped}")
    print(f"Total skills in hybrid: {len(data)}")


if __name__ == '__main__':
    main()
