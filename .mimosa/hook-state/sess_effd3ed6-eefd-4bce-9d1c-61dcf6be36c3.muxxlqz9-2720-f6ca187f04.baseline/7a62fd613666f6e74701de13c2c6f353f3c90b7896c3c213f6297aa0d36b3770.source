"""Add hybrid configs for character 107302 (クリスマスコーデの参謀) 5 skills.
Skills: 110037 (EX), 120083 (AS1), 120084 (AS2), 130095 (PS1), 130096 (PS2)
"""
import json
import os
import sys

HYBRID_PATH = os.path.join(os.path.dirname(__file__), '..', 'data', 'skill_effects_hybrid.json')

# Common effect template fields
def make_effect(effect_type, target_type, value=None, value_tag=None,
                duration=None, duration_type=None, hit_count=None,
                condition=None, flags=None, target_identifier=None,
                ignore_defense=0, ignore_shield=0, value_source=None,
                duration_tag=None, hit_count_tag=None,
                attack_limited=None):
    if attack_limited is not None:
        flags = dict(flags) if flags else {}
        flags["attack_limited"] = attack_limited
    return {
        "effect_type": effect_type,
        "target_type": target_type,
        "target_identifier": target_identifier,
        "value": value,
        "value_tag": value_tag,
        "value_source": value_source,
        "duration": duration,
        "duration_type": duration_type,
        "duration_tag": duration_tag,
        "hit_count": hit_count,
        "hit_count_tag": hit_count_tag,
        "condition": condition,
        "flags": flags or {},
        "ignore_defense": ignore_defense,
        "ignore_shield": ignore_shield,
    }

# Block template
def make_block(block_id, effects, condition=None):
    return {
        "block_id": block_id,
        "condition": condition,
        "effects": effects,
    }

# Skill configs
CONFIGS = {}

