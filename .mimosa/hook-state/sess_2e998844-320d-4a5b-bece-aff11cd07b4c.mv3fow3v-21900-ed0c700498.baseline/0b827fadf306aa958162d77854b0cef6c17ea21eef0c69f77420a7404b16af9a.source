"""Regression: guard未对附魔/追加/子单位伤害生效（新版特殊机制guard）。

Bug: skill_service的附魔(ENCHANT_DAMAGE)/追加(ADD_DAMAGE)/子单位(SUB_UNIT)
     三条伤害路径只读取旧版buff guard（_aggregate_buff_value_signed GUARD），
     不认识新版特殊机制guard（unit.guard_active/guard_rate/guard_standalone，
     如230500 ランパートシャッター+），导致guard对这三类伤害完全无效。
实例: 唯一無二の幼なじみ 附魔伤害40338（未减伤）vs 实测19814（≈×0.5），
     同一次攻击的主伤害84063已正确享受guard:0.5000。
Fix: 三条路径改用 damage_service._get_guard_multiplier(target)（与damage/
     HP比例伤害路径一致）；旧版buff guard语义不变，standalone guard对
     附魔/追加/子单位伤害一并生效（guard持续到该次行动结束）。
"""
import sys
import os
import unittest
from types import SimpleNamespace

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.enums import SkillEffectType, AuraUpdateTiming


def make_enchant_buff(name="enchant", value=100.0, caster_attack=10000,
                       source_unit_id="external_src", hit_limited=0):
    """创建ENCHANT_DAMAGE buff（value=power%）。"""
    return BuffState(
        buff_id=f"ench_{name}", name=name,
        effect_type=SkillEffectType.ENCHANT_DAMAGE.value,
        value=value, duration=-1, timing_type=2,
        caster_attack=caster_attack, source_unit_id=source_unit_id,
        source_skill_id=99999, hit_limited=hit_limited, is_debuff=False,
    )


def make_add_damage_buff(name="add_dmg", value=100.0, caster_attack=10000,
                          source_unit_id="src1", hit_limited=0):
    """创建ADD_DAMAGE buff（value=power%）。"""
    return BuffState(
        buff_id=f"add_{name}", name=name,
        effect_type=SkillEffectType.ADD_DAMAGE.value,
        value=value, duration=-1, timing_type=2,
        caster_attack=caster_attack, source_unit_id=source_unit_id,
        source_skill_id=99999, hit_limited=hit_limited, is_debuff=False,
    )


def make_sub_unit_buff(name="SubUnit", value=100.0, caster_attack=10000,
                        source_unit_id="caster", hp=10000):
    """创建SUB_UNIT buff（value=power%）。"""
    return BuffState(
        buff_id=f"sub_{name}", name=name,
        effect_type=SkillEffectType.SUB_UNIT.value,
        value=value, duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=source_unit_id, source_skill_id=130079,
        caster_attack=caster_attack, is_debuff=False, is_stackable=True,
        sub_unit_hp=hp, sub_unit_max_hp=hp,
        sub_unit_link_group="", just_applied=False,
    )


def make_guard_buff(value=75.0):
    """创建旧版buff guard（value=75 → 75%减伤，value_tag=0=百分比）。"""
    return BuffState(
        buff_id="guard_buff", name="guard",
        effect_type=SkillEffectType.GUARD.value,
        value=value, duration=-1, timing_type=2, value_tag=0, is_debuff=False,
    )


def make_main_effect(value=100.0, hit_count=1):
    """构造_apply_damage的主攻击effect参数（同 tests/unit/test_enchant_damage.py）。"""
    return SimpleNamespace(
        effect_type="damage",
        target_type="enemy_single",
        target_identifier=None,
        value=value,
        hit_count=hit_count,
        ignore_defense=0,
        ignore_shield=0,
        flags={},
        condition=None,
    )


def _init_ss_for_direct_apply(ss, bf):
    """初始化_apply_damage所需的全部内部状态。"""
    ss._recursion_guard = True
    ss._before_attack_triggers_fired = True
    ss._current_skill_id = 99999
    ss._current_block_id = 1
    ss._current_skill_priority = 1
    ss._block_damage_targets = {}
    ss._block_damage_total = {}
    ss._last_damage_hp_before = {}
    ss._damaged_targets = []
    ss._current_attack_targets = []
    ss._pre_scanned_cover_candidates = None
    ss._pre_scanned_non_damage_enemy_targets = []
    ss._primary_target = None
    ss._trigger_attacker = None
    ss._target_char_type_filter = None
    ss._target_element_filter = None
    ss._original_primary_target = None
    ss._last_primary_target = None
    ss._most_recent_damage = 0
    ss._skill_all_attacked_targets = []
    ss._hp_consumed = 0
    ss._per_hit_hp_losses = {}
    ss._block_evaded_targets = set()
    ss._skill_evaded_targets = set()
    ss._debuff_immune_blocked_targets = set()
    ss._on_crit_blocks = []
    ss._on_crit_applied = False
    ss._on_crit_block_executed = {}
    ss._on_crit_target = None
    ss._on_crit_immediate_blocks = []
    ss._on_crit_immediate_applied = set()
    ss._on_crit_effects = []
    ss._deferred_on_crit_targets = []
    ss._pending_crit_triggers = []
    ss._per_target_enchant_cache = None
    ss._current_main_damage_power = None
    ss._marks_at_start = {}
    ss._marks_at_start_by_unit = {}
    ss._ps_received_targets = []
    ss._current_skill_is_ps = False
    ss._last_heal_targets = []
    ss._newly_created_sub_unit_ids = set()
    ss._pending_deaths = set()


class TestRegGuardAppliesToEnchantDamage(unittest.TestCase):
    """standalone guard（230500等）应对附魔/追加/子单位伤害生效。"""

    def _build_context(self, extra_buff=None):
        bb = BattleBuilder()
        bb.add_ally(unit_id="ally", atk=10000, hp=100000, defense=0, skills=[])
        bb.add_enemy(unit_id="enemy", hp=100000, defense=5000)
        ctx = bb.build()
        if extra_buff is not None:
            ctx['allies'][0].buffs.append(extra_buff)
        return ctx

    def _apply(self, ctx, guard=None):
        """应用一次主攻击，返回敌方HP损失。guard: None/'standalone'/'legacy'"""
        ss = ctx['ss']
        ally = ctx['allies'][0]
        enemy = ctx['enemies'][0]
        if guard == 'standalone':
            enemy.guard_active = True
            enemy.guard_rate = 50.0
            enemy.guard_standalone = True
        elif guard == 'legacy':
            enemy.buffs.append(make_guard_buff(value=75.0))
        _init_ss_for_direct_apply(ss, ctx['bf'])
        hp_before = enemy.current_hp
        ss._apply_damage(ally, make_main_effect(), ctx['bf'])
        return hp_before - enemy.current_hp

    def test_enchant_damage_halved_by_standalone_guard(self):
        """附魔伤害应受standalone guard减伤50%（bug实例：40338→20169）"""
        base = self._apply(self._build_context(make_enchant_buff(value=100.0)))
        guarded = self._apply(self._build_context(make_enchant_buff(value=100.0)),
                              guard='standalone')
        self.assertEqual(base, 15000, f"基线: 主5000+附魔10000 (实际{base})")
        self.assertEqual(guarded, 7500,
                         f"guard50%应各减半: 主2500+附魔5000 (实际{guarded})")

    def test_add_damage_halved_by_standalone_guard(self):
        """追加伤害应受standalone guard减伤50%"""
        base = self._apply(self._build_context(make_add_damage_buff(value=100.0)))
        guarded = self._apply(self._build_context(make_add_damage_buff(value=100.0)),
                              guard='standalone')
        self.assertEqual(base, 15000, f"基线: 主5000+追加10000 (实际{base})")
        self.assertEqual(guarded, 7500,
                         f"guard50%应各减半: 主2500+追加5000 (实际{guarded})")

    def test_sub_unit_damage_halved_by_standalone_guard(self):
        """子单位伤害应受standalone guard减伤50%"""
        base = self._apply(self._build_context(make_sub_unit_buff(value=100.0)))
        guarded = self._apply(self._build_context(make_sub_unit_buff(value=100.0)),
                              guard='standalone')
        self.assertGreater(base, 5000, "基线应包含子单位伤害")
        self.assertAlmostEqual(guarded, base * 0.5, delta=2,
                               msg=f"guard50%应使总伤害减半: base={base} guarded={guarded}")

    def test_legacy_buff_guard_still_applies(self):
        """旧版buff guard（75%）对附魔伤害保持生效（语义不变）"""
        base = self._apply(self._build_context(make_enchant_buff(value=100.0)))
        guarded = self._apply(self._build_context(make_enchant_buff(value=100.0)),
                              guard='legacy')
        self.assertEqual(base, 15000)
        # 主5000×0.25=1250 + 附魔10000×0.25=2500 = 3750
        self.assertEqual(guarded, 3750,
                         f"buff guard75%应各减75% (实际{guarded})")

    def test_no_guard_unchanged(self):
        """无guard时数值不变（回归保护）"""
        base = self._apply(self._build_context(make_enchant_buff(value=100.0)))
        self.assertEqual(base, 15000)


if __name__ == '__main__':
    unittest.main(verbosity=2)
