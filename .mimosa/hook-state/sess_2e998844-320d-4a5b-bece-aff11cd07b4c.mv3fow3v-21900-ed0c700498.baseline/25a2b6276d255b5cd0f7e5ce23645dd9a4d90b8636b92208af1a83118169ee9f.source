    def test_ps1_ally_single_target_selection(self):
        """
        测试1: PS1(130012) ally_single目标选择
        当其他友方使用AS攻击时，PS1应仅对该友方（trigger_attacker）施加附魔buff，
        而非所有友方。

        流程:
        1. ally_front使用AS技能120024攻击
        2. 触发before_ally_as_attack触发器
        3. PS1(130012)应触发，仅对ally_front施加EnchantDamage buff
        4. 验证caster和ally_back没有获得附魔buff
        """
        # ally_front使用AS技能
        result = self.ss.execute_skill(
            caster=self.ally_front,
            skill_id=120024,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 检查inline_ps_results中是否有PS1触发
        inline_ps = result.get("inline_ps_results", [])
        ps1_triggered = any(ps["skill_id"] == 130012 for ps in inline_ps)

        if not ps1_triggered:
            # 如果没有inline触发，手动触发before_ally_as_attack
            trigger_actions = self.ts.trigger_before_ally_as_attack(
                self.ally_front, 120024, self.bf
            )
            ps1_triggered = any(a.skill_id == 130012 for a in trigger_actions)
            if ps1_triggered:
                for action in trigger_actions:
                    if action.skill_id == 130012:
                        self.ss._execute_trigger_actions_inline(
                            [action], self.bf, trigger_timing="before_ally_as_attack"
                        )

        self.assertTrue(
            ps1_triggered,
            f"PS1(130012)应在友方AS攻击前触发, "
            f"inline_ps: {[(ps.get('skill_id'), ps.get('skill_name')) for ps in inline_ps]}"
        )

        # 验证ally_front获得了附魔buff (EnchantDamage)
        enchant_buffs_on_front = [
            b for b in self.ally_front.buffs
            if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value
        ]
        self.assertTrue(
            len(enchant_buffs_on_front) > 0,
            f"ally_front应获得EnchantDamage buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.ally_front.buffs]}"
        )

        # 验证caster没有获得附魔buff (PS1目标应为ally_single=trigger_attacker)
        enchant_buffs_on_caster = [
            b for b in self.caster.buffs
            if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value
        ]
        self.assertEqual(
            len(enchant_buffs_on_caster), 0,
            f"caster不应获得EnchantDamage buff (PS1目标应为trigger_attacker), "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.caster.buffs]}"
        )

        # 验证ally_back没有获得附魔buff
        enchant_buffs_on_back = [
            b for b in self.ally_back.buffs
            if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value
        ]
        self.assertEqual(
            len(enchant_buffs_on_back), 0,
            f"ally_back不应获得EnchantDamage buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.ally_back.buffs]}"
        )

    def test_ps1_hit_limited_and_crit_duration(self):
        """
        测试2: PS1(130012) hit_limited=1 和 crit_rate_up 持续时间
        附魔伤害buff应仅生效1次攻击后消失(hit_limited=1)。
        crit_rate_up buff应持续2行动(duration=2, duration_type=action)，
        跨越当次行动和下一次行动。

        流程:
        1. ally_front使用AS技能，触发PS1
        2. PS1对ally_front施加EnchantDamage buff (hit_limited=1) 和 crit_rate_up buff (duration=2, action)
        3. 验证EnchantDamage buff的hit_limited=1
        4. 验证crit_rate_up buff的duration=2, timing_type=DURABLE_TARGET_MANEUVER_END
        """
        # ally_front使用AS技能，触发PS1
        result = self.ss.execute_skill(
            caster=self.ally_front,
            skill_id=120024,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 检查inline触发或手动触发PS1
        inline_ps = result.get("inline_ps_results", [])
        ps1_triggered = any(ps["skill_id"] == 130012 for ps in inline_ps)

        if not ps1_triggered:
            trigger_actions = self.ts.trigger_before_ally_as_attack(
                self.ally_front, 120024, self.bf
            )
            for action in trigger_actions:
                if action.skill_id == 130012:
                    self.ss._execute_trigger_actions_inline(
                        [action], self.bf, trigger_timing="before_ally_as_attack"
                    )

        # 验证附魔buff存在且hit_limited=1
        enchant_buffs = [
            b for b in self.ally_front.buffs
            if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value
        ]
        if enchant_buffs:
            self.assertEqual(
                enchant_buffs[0].hit_limited, 1,
                f"EnchantDamage buff的hit_limited应为1, "
                f"实际: {enchant_buffs[0].hit_limited}"
            )

        # 验证crit_rate_up buff (Lv15, シャイ属性友方=火属性=element 3)
        # ally_front的element=3(火), 满足target_element条件
        crit_buffs = [
            b for b in self.ally_front.buffs
            if b.effect_type == SkillEffectType.STATUS_CRITICAL_CHANCE.value
        ]
        self.assertTrue(
            len(crit_buffs) > 0,
            f"ally_front应获得crit_rate_up buff (シャイ属性满足条件), "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.ally_front.buffs]}"
        )
        # 验证duration=1, timing_type=DURABLE_TARGET_MANEUVER_END
        self.assertEqual(
            crit_buffs[0].duration, 1,
            f"crit_rate_up buff的duration应为1, "
            f"实际: {crit_buffs[0].duration}"
        )
        self.assertEqual(
            crit_buffs[0].timing_type, AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            f"crit_rate_up buff的timing_type应为DURABLE_TARGET_MANEUVER_END(行动制), "
            f"实际: {crit_buffs[0].timing_type}"
        )

    def test_ps1_crit_rate_up_spans_two_actions(self):
        """
        测试2b: PS1(130012) crit_rate_up 跨越两次行动
        游戏实际表现：被赋予单位在当轮行动与下一轮行动中，都享受到了暴击率加成效果。
        duration=2, duration_type=action → 当次行动结束duration 2→1，下次行动结束1→0消失。

        流程:
        1. 手动对ally_front施加crit_rate_up buff (duration=2, action制)
        2. 模拟当次行动结束 → duration 2→1, buff仍存在
        3. 模拟下次行动结束 → duration 1→0, buff消失
        """
        # 手动施加crit_rate_up buff (模拟PS1触发效果)
        from src.entities_v2.enums import SkillEffectType as SET
        crit_buff = BuffState(
            buff_id="test_crit_up",
            name="会心率上昇",
            effect_type=SET.STATUS_CRITICAL_CHANCE.value,
            value=30.0,
            duration=2,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=self.caster.unit_id,
            hit_limited=0,
        )
        self.ally_front.buffs.append(crit_buff)

        # 当次行动结束：duration 2→1
        self.asvc.process_maneuver_end(self.ally_front)
        # 清理expired buff
        self.ally_front.buffs = [b for b in self.ally_front.buffs if b.duration > 0]

        crit_buffs_after_first = [
            b for b in self.ally_front.buffs
            if b.effect_type == SET.STATUS_CRITICAL_CHANCE.value
        ]
        self.assertTrue(
            len(crit_buffs_after_first) > 0,
            "当次行动结束后crit_rate_up buff应仍存在 (duration 2→1)"
        )
        self.assertEqual(
            crit_buffs_after_first[0].duration, 1,
            f"当次行动结束后crit_rate_up duration应为1, "
            f"实际: {crit_buffs_after_first[0].duration}"
        )

        # 下次行动结束：duration 1→0
        self.asvc.process_maneuver_end(self.ally_front)
        self.ally_front.buffs = [b for b in self.ally_front.buffs if b.duration > 0]

        crit_buffs_after_second = [
            b for b in self.ally_front.buffs
            if b.effect_type == SET.STATUS_CRITICAL_CHANCE.value
        ]
        self.assertEqual(
            len(crit_buffs_after_second), 0,
            "下次行动结束后crit_rate_up buff应消失 (duration 1→0)"
        )

    def test_ps1_not_triggered_by_non_damage_as(self):
        """
        测试2c: PS1(130012) 不应在非伤害类AS技能上触发
        附魔伤害（add_damage_to_attack）只应给伤害类技能附魔。
        技能120057(ストライクリリース)是AS技能(skill_type=1)但只含atk_down效果，无damage效果。
        PS1不应触发，ally_front不应获得EnchantDamage buff。

        流程:
        1. ally_front使用非伤害AS技能120057
        2. 验证PS1(130012)未触发
        3. 验证ally_front未获得EnchantDamage buff
        """
        # ally_front使用非伤害AS技能120057
        result = self.ss.execute_skill(
            caster=self.ally_front,
            skill_id=120057,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 检查inline_ps_results中PS1是否触发
        inline_ps = result.get("inline_ps_results", [])
        ps1_triggered = any(ps["skill_id"] == 130012 for ps in inline_ps)
        self.assertFalse(
            ps1_triggered,
            f"PS1(130012)不应在非伤害AS技能上触发, "
            f"inline_ps: {[(ps.get('skill_id'), ps.get('skill_name')) for ps in inline_ps]}"
        )

        # 手动调用trigger_before_ally_as_attack验证也不触发
        trigger_actions = self.ts.trigger_before_ally_as_attack(
            self.ally_front, 120057, self.bf
        )
        ps1_in_trigger = any(a.skill_id == 130012 for a in trigger_actions)
        self.assertFalse(
            ps1_in_trigger,
            f"PS1(130012)不应通过trigger_before_ally_as_attack触发, "
            f"trigger_actions: {[(a.skill_id) for a in trigger_actions]}"
        )

        # 验证ally_front未获得EnchantDamage buff
        enchant_buffs_on_front = [
            b for b in self.ally_front.buffs
            if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value
        ]
        self.assertEqual(
            len(enchant_buffs_on_front), 0,
            f"ally_front不应获得EnchantDamage buff (非伤害AS技能不应触发附魔), "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.ally_front.buffs]}"
        )

    def test_ps2_only_once_per_battle(self):
        """
        测试3: PS2(130032) 战斗中仅1次触发
        cooldown=99确保只触发1次。

        流程:
        1. 触发on_turn_start，PS2应触发
        2. 执行PS2，验证友方后排获得atk_up buff
        3. PS2进入cooldown=99
        4. 再次触发on_turn_start，PS2不应再触发
        """
        # 第一次触发on_turn_start
        trigger_actions = self.ts.trigger_turn_start(self.bf)

        # 验证PS2(130032)被触发
        ps2_triggered = any(a.skill_id == 130032 for a in trigger_actions)
        self.assertTrue(
            ps2_triggered,
            f"PS2(130032)应在回合开始时触发, "
            f"实际触发的技能: {[a.skill_id for a in trigger_actions]}"
        )

        # 执行PS2触发动作（先初始化SkillService内部状态）
        self.ss._pending_crit_triggers = []
        for action in trigger_actions:
            if action.skill_id == 130032:
                self.ss._execute_trigger_actions_inline(
                    [action], self.bf, trigger_timing="on_turn_start"
                )

        # 验证友方后排获得atk_up buff
        back_allies = [self.caster, self.ally_back]  # 后排友方
        for ally in back_allies:
            atk_buffs = [
                b for b in ally.buffs
                if b.effect_type == SkillEffectType.STATUS_ATTACK.value
            ]
            self.assertTrue(
                len(atk_buffs) > 0,
                f"{ally.name}(后排)应获得atk_up buff, "
                f"实际buffs: {[(b.name, b.effect_type) for b in ally.buffs]}"
            )

        # 验证PS2进入cooldown
        self.assertEqual(
            self.caster.skill_cooldowns.get(130032, 0), 99,
            f"PS2(130032)触发后cooldown应为99, "
            f"实际: {self.caster.skill_cooldowns.get(130032, 0)}"
        )

        # 第二次触发on_turn_start
        trigger_actions_2 = self.ts.trigger_turn_start(self.bf)

        # 验证PS2不再触发
        ps2_triggered_2 = any(a.skill_id == 130032 for a in trigger_actions_2)
        self.assertFalse(
            ps2_triggered_2,
            f"PS2(130032)在cooldown期间不应再次触发, "
            f"实际触发的技能: {[a.skill_id for a in trigger_actions_2]}"
        )

    def test_ps3_back_row_condition(self):
        """
        测试4: PS3(130048) 后排条件
        仅后排友方被AS攻击时触发，前排友方被攻击不触发。

        说明：after_as_attacked_ally触发器不要求PS owner是primary_target，
        只要同阵营有友方被AS攻击且global_condition(target_is_back_row)满足即可。

        流程:
        1. 敌方AS攻击caster(后排友方，也是PS3的owner) → PS3应触发
        2. 验证友方后排获得atk_up buff
        3. 重置冷却
        4. 敌方AS攻击其他后排友方(ally_back) → PS3也应触发（owner不必是被攻击者）
        5. 重置冷却
        6. 敌方AS攻击前排友方(ally_front) → PS3不应触发（target_is_back_row不满足）
        """
        # 场景1: 敌方AS攻击caster（后排友方，也是PS3的owner）
        trigger_actions = self.ts.trigger_after_as_attacked_ally(
            targets=[self.caster],
            battlefield=self.bf,
            actor=self.enemy_back,
            primary_target=self.caster,
        )

        # 验证PS3(130048)被触发
        ps3_triggered = any(a.skill_id == 130048 for a in trigger_actions)
        self.assertTrue(
            ps3_triggered,
            f"PS3(130048)应在后排友方(caster)被AS攻击后触发, "
            f"实际触发的技能: {[a.skill_id for a in trigger_actions]}"
        )

        # 执行PS3触发动作
        self.ss._pending_crit_triggers = []
        for action in trigger_actions:
            if action.skill_id == 130048:
                self.ss._execute_trigger_actions_inline(
                    [action], self.bf, trigger_timing="after_as_attacked_ally"
                )

        # 验证友方后排获得atk_up buff
        atk_buffs_on_caster = [
            b for b in self.caster.buffs
            if b.effect_type == SkillEffectType.STATUS_ATTACK.value
        ]
        self.assertTrue(
            len(atk_buffs_on_caster) > 0,
            f"caster(后排)应获得atk_up buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.caster.buffs]}"
        )

        # 重置冷却
        self.caster.skill_cooldowns = {}

        # 清除已有buff以便区分
        self.caster.buffs = []
        self.ally_back.buffs = []

        # 场景2: 敌方AS攻击其他后排友方(ally_back) → PS3也应触发
        # owner(caster)不必是被攻击者，只要被攻击者是后排友方即可
        trigger_actions_2 = self.ts.trigger_after_as_attacked_ally(
            targets=[self.ally_back],
            battlefield=self.bf,
            actor=self.enemy_back,
            primary_target=self.ally_back,
        )

        ps3_triggered_2 = any(a.skill_id == 130048 for a in trigger_actions_2)
        self.assertTrue(
            ps3_triggered_2,
            f"PS3(130048)应在其他后排友方(ally_back)被AS攻击后触发, "
            f"owner不必是被攻击者, "
            f"实际触发的技能: {[a.skill_id for a in trigger_actions_2]}"
        )

        # 重置冷却
        self.caster.skill_cooldowns = {}
        self.caster.buffs = []
        self.ally_back.buffs = []

        # 场景3: 敌方AS攻击前排友方 → PS3不应触发（target_is_back_row条件不满足）
        trigger_actions_3 = self.ts.trigger_after_as_attacked_ally(
            targets=[self.ally_front],
            battlefield=self.bf,
            actor=self.enemy_back,
            primary_target=self.ally_front,
        )

        # 验证PS3不被触发
        ps3_triggered_3 = any(a.skill_id == 130048 for a in trigger_actions_3)
        self.assertFalse(
            ps3_triggered_3,
            f"PS3(130048)不应在前排友方被AS攻击时触发, "
            f"实际触发的技能: {[a.skill_id for a in trigger_actions_3]}"
        )

    def test_ex_burn_effect(self):
        """
        测试5: EX(110017) 灼烧效果
        横一列EN攻击 + 5行动灼烧(Conflagration)

        流程:
        1. 执行EX技能110017
        2. 验证对敌方横一列造成EN伤害
        3. 验证敌方获得5行动灼烧debuff
        """
        # 执行EX技能110017
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110017,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证对敌方造成伤害
        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(
            len(damage_effects) > 0,
            "EX技能应造成伤害"
        )

        # 验证命中了敌方横一列(前排3体)
        all_target_ids = set()
        for dmg_effect in damage_effects:
            for t in dmg_effect.get("targets", []):
                all_target_ids.add(t.get("target_id"))

        # 横一列应为前排3体
        front_enemy_ids = {self.enemy1.unit_id, self.enemy2.unit_id, self.enemy3.unit_id}
        self.assertTrue(
            front_enemy_ids.issubset(all_target_ids),
            f"EX技能应命中敌方前排3体, 期望包含: {front_enemy_ids}, 实际命中: {all_target_ids}"
        )

        # 验证敌方获得灼烧debuff (Conflagration, duration=5)
        for enemy in [self.enemy1, self.enemy2, self.enemy3]:
            burn_debuffs = [
                d for d in enemy.debuffs
                if d.effect_type == SkillEffectType.CONFLAGRATION.value
            ]
            self.assertTrue(
                len(burn_debuffs) > 0,
                f"{enemy.name}应有灼烧(Conflagration)debuff, "
                f"实际debuffs: {[(d.effect_type, d.duration) for d in enemy.debuffs]}"
            )
            self.assertEqual(
                burn_debuffs[0].duration, 5,
                f"{enemy.name}的灼烧debuff持续应为5行动, "
                f"实际: {burn_debuffs[0].duration}"
            )

    def test_as_adjacent_damage_and_ap_reduction(self):
        """
        测试6: AS(120024) 邻接伤害+削AP
        单体EN攻击 + 邻接2体EN攻击 + 削1AP

        流程:
        1. 执行AS技能120024
        2. 验证对主目标造成EN伤害
        3. 验证对邻接2体造成EN伤害
        4. 验证主目标AP减少1
        """
        # 记录敌人初始HP和AP
        initial_hp_1 = self.enemy1.current_hp
        initial_hp_2 = self.enemy2.current_hp
        initial_hp_3 = self.enemy3.current_hp
        initial_ap_2 = self.enemy2.current_ap  # 主目标(中列)的AP

        # 执行AS技能120024
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120024,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 验证伤害效果
        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertTrue(
            len(damage_effects) > 0,
            "AS技能应造成伤害"
        )

        # 验证命中了多个目标 (主目标+邻接2体)
        all_target_ids = set()
        for dmg_effect in damage_effects:
            for t in dmg_effect.get("targets", []):
                all_target_ids.add(t.get("target_id"))

        self.assertGreaterEqual(
            len(all_target_ids), 2,
            f"AS技能应至少命中2个目标(主目标+邻接), 实际命中: {len(all_target_ids)}, "
            f"target_ids: {all_target_ids}"
        )

        # 验证主目标AP减少1
        # 主目标应为中列敌人(enemy2)
        ap_change = initial_ap_2 - self.enemy2.current_ap
        self.assertGreaterEqual(
            ap_change, 1,
            f"主目标(enemy2)的AP应至少减少1, "
            f"初始AP={initial_ap_2}, 当前AP={self.enemy2.current_ap}"
        )

        # 验证伤害确实造成
        total_damage = result.get("total_damage", 0)
        self.assertGreater(
            total_damage, 0,
            "AS技能应造成正数总伤害"
        )

    def test_ps1_lv11_wind_ally_gets_crit_rate_up(self):
        """
        测试7: PS1(130012) L11+ target_element=3 条件 - 風属性友方获得crit_rate_up
        PS1 Block3 (level_min=11, condition target_element=3=風) 应对風属性AS攻击者施加crit_rate_up。

        流程:
        1. ally_front(element=3 風)使用AS技能120024
        2. 触发PS1(130012), Block3条件满足(風属性)
        3. 验证ally_front获得crit_rate_up buff
        """
        # ally_front(element=3 風)使用AS技能
        result = self.ss.execute_skill(
            caster=self.ally_front,
            skill_id=120024,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 触发PS1
        inline_ps = result.get("inline_ps_results", [])
        ps1_triggered = any(ps["skill_id"] == 130012 for ps in inline_ps)
        if not ps1_triggered:
            trigger_actions = self.ts.trigger_before_ally_as_attack(
                self.ally_front, 120024, self.bf
            )
            for action in trigger_actions:
                if action.skill_id == 130012:
                    self.ss._execute_trigger_actions_inline(
                        [action], self.bf, trigger_timing="before_ally_as_attack"
                    )
                    ps1_triggered = True

        self.assertTrue(ps1_triggered, "PS1(130012)应在友方AS攻击前触发")

        # 验证ally_front获得crit_rate_up buff (風属性满足target_element=3条件)
        crit_buffs = [
            b for b in self.ally_front.buffs
            if b.effect_type == SkillEffectType.STATUS_CRITICAL_CHANCE.value
        ]
        self.assertTrue(
            len(crit_buffs) > 0,
            f"ally_front(風属性)应获得crit_rate_up buff, "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.ally_front.buffs]}"
        )

    def test_ps1_lv11_non_wind_ally_no_crit_rate_up(self):
        """
        测试8: PS1(130012) L11+ target_element=3 条件 - 非風属性友方不获得crit_rate_up
        非風属性AS攻击者不应获得crit_rate_up(Block3条件不满足),
        但仍应获得add_damage_to_attack附魔(Block2无element条件)。

        流程:
        1. ally_back(element=1 火)使用AS技能120024
        2. 触发PS1(130012), Block3条件不满足(非風属性)
        3. 验证ally_back未获得crit_rate_up buff
        4. 验证ally_back仍获得EnchantDamage buff (Block2)
        """
        # 给ally_back添加AS技能
        self.ally_back.skills = [120024]
        self.ally_back.skill_levels = {120024: 15}

        # ally_back(element=1 火, 非風)使用AS技能
        result = self.ss.execute_skill(
            caster=self.ally_back,
            skill_id=120024,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 触发PS1
        inline_ps = result.get("inline_ps_results", [])
        ps1_triggered = any(ps["skill_id"] == 130012 for ps in inline_ps)
        if not ps1_triggered:
            trigger_actions = self.ts.trigger_before_ally_as_attack(
                self.ally_back, 120024, self.bf
            )
            for action in trigger_actions:
                if action.skill_id == 130012:
                    self.ss._execute_trigger_actions_inline(
                        [action], self.bf, trigger_timing="before_ally_as_attack"
                    )
                    ps1_triggered = True

        self.assertTrue(ps1_triggered, "PS1(130012)应在友方AS攻击前触发")

        # 验证ally_back未获得crit_rate_up buff (非風属性, target_element=3条件不满足)
        crit_buffs = [
            b for b in self.ally_back.buffs
            if b.effect_type == SkillEffectType.STATUS_CRITICAL_CHANCE.value
        ]
        self.assertEqual(
            len(crit_buffs), 0,
            f"ally_back(火属性)不应获得crit_rate_up buff (非風属性, 条件不满足), "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.ally_back.buffs]}"
        )

        # 验证ally_back仍获得EnchantDamage buff (Block2无element条件)
        enchant_buffs = [
            b for b in self.ally_back.buffs
            if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value
        ]
        self.assertTrue(
            len(enchant_buffs) > 0,
            f"ally_back应获得EnchantDamage buff (Block2无element条件), "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.ally_back.buffs]}"
        )

    def test_ps1_lv10_skips_crit_rate_up(self):
        """
        测试9: PS1(130012) Lv10时Block3跳过 (level_min=11)
        Lv10时Block3(level_min=11)被resolver过滤掉, 无crit_rate_up。
        Block1(level_max=10)仍执行, 有add_damage_to_attack附魔。

        流程:
        1. 设置caster的PS1等级为10
        2. ally_front(風属性)使用AS技能
        3. 触发PS1(130012), 仅Block1执行
        4. 验证ally_front未获得crit_rate_up buff
        5. 验证ally_front仍获得EnchantDamage buff (Block1)
        """
        # 设置caster的PS1等级为10
        self.caster.skill_levels[130012] = 10

        # ally_front(風属性)使用AS技能
        result = self.ss.execute_skill(
            caster=self.ally_front,
            skill_id=120024,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 触发PS1
        inline_ps = result.get("inline_ps_results", [])
        ps1_triggered = any(ps["skill_id"] == 130012 for ps in inline_ps)
        if not ps1_triggered:
            trigger_actions = self.ts.trigger_before_ally_as_attack(
                self.ally_front, 120024, self.bf
            )
            for action in trigger_actions:
                if action.skill_id == 130012:
                    self.ss._execute_trigger_actions_inline(
                        [action], self.bf, trigger_timing="before_ally_as_attack"
                    )
                    ps1_triggered = True

        self.assertTrue(ps1_triggered, "PS1(130012)应在友方AS攻击前触发")

        # 验证ally_front未获得crit_rate_up buff (Lv10, Block3被跳过)
        crit_buffs = [
            b for b in self.ally_front.buffs
            if b.effect_type == SkillEffectType.STATUS_CRITICAL_CHANCE.value
        ]
        self.assertEqual(
            len(crit_buffs), 0,
            f"ally_front在Lv10时不应获得crit_rate_up buff (Block3 level_min=11被跳过), "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.ally_front.buffs]}"
        )

        # 验证ally_front仍获得EnchantDamage buff (Block1 level_max=10执行)
        enchant_buffs = [
            b for b in self.ally_front.buffs
            if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value
        ]
        self.assertTrue(
            len(enchant_buffs) > 0,
            f"ally_front应获得EnchantDamage buff (Block1 level_max=10执行), "
            f"实际buffs: {[(b.name, b.effect_type) for b in self.ally_front.buffs]}"
        )

    def test_ps1_simultaneous_limit_picks_fastest(self):
        """
        测试10: PS1(130012) simultaneous_limit=True 互斥
        当多个同時発動制限PS同时触发时, 按速度优先只触发1个。

        流程:
        1. 创建第2个PS1持有者(ally_ps_holder, 速度较慢)
        2. ally_front使用AS技能
        3. trigger_before_ally_as_attack应只返回1个PS1 action (速度更快的caster)
        4. 验证较慢的ally_ps_holder的PS1未触发
        """
        # 创建第2个PS1持有者(速度=500, 慢于caster的1000)
        ally_ps_holder = UnitState(
            unit_id="ally_ps_holder", name="PS持有者B(慢)", side=Side.ALLY,
            position=Position.ALLY_RIGHT_BACK, character_id=999103, level=200,
            element=3, character_type=2,
            max_hp=100000, current_hp=100000,
            attack=100000, defense=40000, speed=500,
            crit_rate=0.10, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=100,
            skills=[130012], skill_levels={130012: 15}, skill_cooldowns={},
        )
        self.bf.add_unit(ally_ps_holder)

        # ally_front使用AS技能, 触发before_ally_as_attack
        trigger_actions = self.ts.trigger_before_ally_as_attack(
            self.ally_front, 120024, self.bf
        )

        # 收集所有PS1(130012)的action
        ps1_actions = [a for a in trigger_actions if a.skill_id == 130012]

        # 验证只触发1个PS1 (simultaneous_limit互斥)
        self.assertEqual(
            len(ps1_actions), 1,
            f"PS1(130012) simultaneous_limit=true, 应只触发1个(速度最快), "
            f"实际触发数: {len(ps1_actions)}, "
            f"owners: {[a.instance.owner.name for a in ps1_actions]}"
        )

        # 验证触发的是速度更快的caster(速度=1000)
        triggered_owner = ps1_actions[0].instance.owner
        self.assertEqual(
            triggered_owner.unit_id, self.caster.unit_id,
            f"应触发速度更快的caster(速度=1000), "
            f"实际触发owner: {triggered_owner.name}(速度={triggered_owner.speed})"
        )

    def test_ps2_lv11_enemy_front_atk_down(self):
        """
        测试11: PS2(130032) L11+ enemy_front atk_down
        L11+时PS2的Block2执行: ally_back atk_up + enemy_front atk_down。

        流程:
        1. 触发on_turn_start
        2. 执行PS2(130032)
        3. 验证ally_back获得atk_up buff
        4. 验证敌方前排(enemy1/enemy2/enemy3)获得atk_down debuff
        """
        # 触发on_turn_start
        trigger_actions = self.ts.trigger_turn_start(self.bf)

        # 执行PS2触发动作
        self.ss._pending_crit_triggers = []
        for action in trigger_actions:
            if action.skill_id == 130032:
                self.ss._execute_trigger_actions_inline(
                    [action], self.bf, trigger_timing="on_turn_start"
                )

        # 验证ally_back获得atk_up buff
        back_allies = [self.caster, self.ally_back]
        for ally in back_allies:
            atk_buffs = [
                b for b in ally.buffs
                if b.effect_type == SkillEffectType.STATUS_ATTACK.value
            ]
            self.assertTrue(
                len(atk_buffs) > 0,
                f"{ally.name}(后排)应获得atk_up buff, "
                f"实际buffs: {[(b.name, b.effect_type) for b in ally.buffs]}"
            )

        # 验证敌方前排获得atk_down debuff
        front_enemies = [self.enemy1, self.enemy2, self.enemy3]
        for enemy in front_enemies:
            atk_down_debuffs = [
                d for d in enemy.debuffs
                if d.effect_type == SkillEffectType.STATUS_ATTACK.value
            ]
            self.assertTrue(
                len(atk_down_debuffs) > 0,
                f"{enemy.name}(前排)应获得atk_down debuff (L11+ PS2 Block2), "
                f"实际debuffs: {[(d.name, d.effect_type) for d in enemy.debuffs]}"
            )

        # 验证敌方后排(enemy_back)未获得atk_down (target_type=enemy_front)
        atk_down_on_back = [
            d for d in self.enemy_back.debuffs
            if d.effect_type == SkillEffectType.STATUS_ATTACK.value
        ]
        self.assertEqual(
            len(atk_down_on_back), 0,
            f"enemy_back(后排)不应获得atk_down debuff (target_type=enemy_front), "
            f"实际debuffs: {[(d.name, d.effect_type) for d in self.enemy_back.debuffs]}"
        )

    def test_ps2_lv10_no_enemy_front_atk_down(self):
        """
        测试12: PS2(130032) Lv10时仅ally_back atk_up, 无enemy_front atk_down
        Lv10时Block2(level_min=11)被resolver过滤, 仅Block1(level_max=10)执行。

        流程:
        1. 设置caster的PS2等级为10
        2. 触发on_turn_start
        3. 执行PS2(130032)
        4. 验证ally_back获得atk_up buff
        5. 验证敌方前排未获得atk_down debuff
        """
        # 设置caster的PS2等级为10
        self.caster.skill_levels[130032] = 10

        # 触发on_turn_start
        trigger_actions = self.ts.trigger_turn_start(self.bf)

        # 执行PS2触发动作
        self.ss._pending_crit_triggers = []
        for action in trigger_actions:
            if action.skill_id == 130032:
                self.ss._execute_trigger_actions_inline(
                    [action], self.bf, trigger_timing="on_turn_start"
                )

        # 验证ally_back获得atk_up buff (Block1 level_max=10执行)
        back_allies = [self.caster, self.ally_back]
        for ally in back_allies:
            atk_buffs = [
                b for b in ally.buffs
                if b.effect_type == SkillEffectType.STATUS_ATTACK.value
            ]
            self.assertTrue(
                len(atk_buffs) > 0,
                f"{ally.name}(后排)应获得atk_up buff (Block1 Lv10执行), "
                f"实际buffs: {[(b.name, b.effect_type) for b in ally.buffs]}"
            )

        # 验证敌方前排未获得atk_down debuff (Block2 level_min=11被跳过)
        front_enemies = [self.enemy1, self.enemy2, self.enemy3]
        for enemy in front_enemies:
            atk_down_debuffs = [
                d for d in enemy.debuffs
                if d.effect_type == SkillEffectType.STATUS_ATTACK.value
            ]
            self.assertEqual(
                len(atk_down_debuffs), 0,
                f"{enemy.name}(前排)不应获得atk_down debuff (Lv10 Block2被跳过), "
                f"实际debuffs: {[(d.name, d.effect_type) for d in enemy.debuffs]}"
            )

    def test_ps3_lv11_attacker_gets_spd_down(self):
        """
        测试13: PS3(130048) L11+ spd_down
        L11+时PS3的Block2执行: ally_back atk_up + attacker spd_down。
        反击系PS的enemy_single目标会被trigger_attacker覆盖(攻击者)。

        流程:
        1. 敌方AS攻击caster(后排友方)
        2. 触发PS3(130048), Block2执行
        3. 验证ally_back获得atk_up buff
        4. 验证攻击者(enemy_back)获得spd_down debuff
        """
        # 重置冷却以确保PS3可触发
        self.caster.skill_cooldowns = {}

        # 敌方AS攻击caster(后排友方)
        trigger_actions = self.ts.trigger_after_as_attacked_ally(
            targets=[self.caster],
            battlefield=self.bf,
            actor=self.enemy_back,
            primary_target=self.caster,
        )

        # 执行PS3触发动作
        self.ss._pending_crit_triggers = []
        for action in trigger_actions:
            if action.skill_id == 130048:
                self.ss._execute_trigger_actions_inline(
                    [action], self.bf, trigger_timing="after_as_attacked_ally"
                )

        # 验证ally_back获得atk_up buff
        back_allies = [self.caster, self.ally_back]
        for ally in back_allies:
            atk_buffs = [
                b for b in ally.buffs
                if b.effect_type == SkillEffectType.STATUS_ATTACK.value
            ]
            self.assertTrue(
                len(atk_buffs) > 0,
                f"{ally.name}(后排)应获得atk_up buff, "
                f"实际buffs: {[(b.name, b.effect_type) for b in ally.buffs]}"
            )

        # 验证攻击者(enemy_back)获得spd_down debuff
        spd_down_debuffs = [
            d for d in self.enemy_back.debuffs
            if d.effect_type == SkillEffectType.STATUS_SPEED.value
        ]
        self.assertTrue(
            len(spd_down_debuffs) > 0,
            f"enemy_back(攻击者)应获得spd_down debuff (反击系PS trigger_attacker覆盖), "
            f"实际debuffs: {[(d.name, d.effect_type) for d in self.enemy_back.debuffs]}"
        )

    def test_ps3_lv10_no_spd_down(self):
        """
        测试14: PS3(130048) Lv10时无spd_down
        Lv10时Block2(level_min=11)被resolver过滤, 仅Block1(level_max=10)执行。

        流程:
        1. 设置caster的PS3等级为10
        2. 敌方AS攻击caster(后排友方)
        3. 触发PS3(130048), 仅Block1执行
        4. 验证ally_back获得atk_up buff
        5. 验证攻击者未获得spd_down debuff
        """
        # 设置caster的PS3等级为10
        self.caster.skill_levels[130048] = 10
        self.caster.skill_cooldowns = {}

        # 敌方AS攻击caster(后排友方)
        trigger_actions = self.ts.trigger_after_as_attacked_ally(
            targets=[self.caster],
            battlefield=self.bf,
            actor=self.enemy_back,
            primary_target=self.caster,
        )

        # 执行PS3触发动作
        self.ss._pending_crit_triggers = []
        for action in trigger_actions:
            if action.skill_id == 130048:
                self.ss._execute_trigger_actions_inline(
                    [action], self.bf, trigger_timing="after_as_attacked_ally"
                )

        # 验证ally_back获得atk_up buff (Block1 level_max=10执行)
        back_allies = [self.caster, self.ally_back]
        for ally in back_allies:
            atk_buffs = [
                b for b in ally.buffs
                if b.effect_type == SkillEffectType.STATUS_ATTACK.value
            ]
            self.assertTrue(
                len(atk_buffs) > 0,
                f"{ally.name}(后排)应获得atk_up buff (Block1 Lv10执行), "
                f"实际buffs: {[(b.name, b.effect_type) for b in ally.buffs]}"
            )

        # 验证攻击者未获得spd_down debuff (Block2 level_min=11被跳过)
        spd_down_debuffs = [
            d for d in self.enemy_back.debuffs
            if d.effect_type == SkillEffectType.STATUS_SPEED.value
        ]
        self.assertEqual(
            len(spd_down_debuffs), 0,
            f"enemy_back(攻击者)不应获得spd_down debuff (Lv10 Block2被跳过), "
            f"实际debuffs: {[(d.name, d.effect_type) for d in self.enemy_back.debuffs]}"
        )

    def test_as1_adjacent_enemies_target_selection(self):
        """
        测试15: AS1(120024) adjacent_enemies 索敌 - 主目标+邻接2体
        主目标为最近敌(enemy2/ENEMY_CENTER_FRONT), 邻接目标为主目标左右邻接的2个敌方。

        流程:
        1. caster(ALLY_CENTER_BACK)执行AS1
        2. Block1: 主目标=enemy2(ENEMY_CENTER_FRONT, 最近敌)
        3. Block2: 邻接目标=enemy2周围邻接的敌方(最多2体)
        4. 验证主目标enemy2受到伤害
        5. 验证至少2个邻接目标受到伤害
        """
        # 记录敌人初始HP
        initial_hp = {
            self.enemy1.unit_id: self.enemy1.current_hp,
            self.enemy2.unit_id: self.enemy2.current_hp,
            self.enemy3.unit_id: self.enemy3.current_hp,
            self.enemy_back.unit_id: self.enemy_back.current_hp,
        }

        # 执行AS技能120024
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120024,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 验证主目标enemy2受到伤害(ENEMY_CENTER_FRONT是caster的最近敌)
        self.assertLess(
            self.enemy2.current_hp, initial_hp[self.enemy2.unit_id],
            f"主目标enemy2(ENEMY_CENTER_FRONT)应受到伤害, "
            f"HP: {initial_hp[self.enemy2.unit_id]} -> {self.enemy2.current_hp}"
        )

        # 验证邻接目标受到伤害
        # 邻接enemy2(0,1)的位置: ENEMY_LEFT_FRONT(0,0)=enemy1, ENEMY_RIGHT_FRONT(0,2)=enemy3, ENEMY_CENTER_BACK(1,1)=enemy_back
        # target_count=2, 选其中2个
        adjacent_damaged = 0
        for enemy in [self.enemy1, self.enemy3, self.enemy_back]:
            if enemy.current_hp < initial_hp[enemy.unit_id]:
                adjacent_damaged += 1

        self.assertGreaterEqual(
            adjacent_damaged, 2,
            f"应至少有2个邻接目标受到伤害(target_count=2), "
            f"实际受伤邻接数: {adjacent_damaged}"
        )

    def test_as1_adjacent_enemies_edge_case(self):
        """
        测试16: AS1(120024) adjacent_enemies 边缘场景 - 主目标在边缘时邻接目标少于2个
        当主目标在边缘位置(ENEMY_LEFT_FRONT)时, 邻接目标只有1个(ENEMY_CENTER_FRONT)。

        流程:
        1. 将caster移到ALLY_LEFT_BACK, 使最近敌变为enemy1(ENEMY_LEFT_FRONT, 边缘)
        2. 执行AS1
        3. Block1: 主目标=enemy1(ENEMY_LEFT_FRONT)
        4. Block2: 邻接目标=enemy2(ENEMY_CENTER_FRONT)仅1个(ENEMY_LEFT_BACK无单位)
        5. 验证主目标enemy1受到伤害
        6. 验证邻接目标数<=2(边缘场景邻接不足)
        """
        # 将caster移到ALLY_LEFT_BACK, 使最近敌变为enemy1(ENEMY_LEFT_FRONT)
        self.caster.position = Position.ALLY_LEFT_BACK

        # 记录敌人初始HP
        initial_hp = {
            self.enemy1.unit_id: self.enemy1.current_hp,
            self.enemy2.unit_id: self.enemy2.current_hp,
            self.enemy3.unit_id: self.enemy3.current_hp,
            self.enemy_back.unit_id: self.enemy_back.current_hp,
        }

        # 执行AS技能120024
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=120024,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"AS技能执行应成功: {result.get('error', '')}")

        # 验证主目标enemy1受到伤害(ENEMY_LEFT_FRONT是caster在ALLY_LEFT_BACK时的最近敌)
        self.assertLess(
            self.enemy1.current_hp, initial_hp[self.enemy1.unit_id],
            f"主目标enemy1(ENEMY_LEFT_FRONT)应受到伤害, "
            f"HP: {initial_hp[self.enemy1.unit_id]} -> {self.enemy1.current_hp}"
        )

        # 邻接enemy1(0,0)的位置: ENEMY_CENTER_FRONT(0,1)=enemy2, ENEMY_LEFT_BACK(1,0)=无
        # 所以邻接目标最多1个(enemy2)
        # 验证enemy3(ENEMY_RIGHT_FRONT)和enemy_back(ENEMY_CENTER_BACK)未受到邻接伤害
        # (它们不在enemy1的邻接位置)
        enemy3_damaged = self.enemy3.current_hp < initial_hp[self.enemy3.unit_id]
        enemy_back_damaged = self.enemy_back.current_hp < initial_hp[self.enemy_back.unit_id]

        # enemy3不在enemy1邻接位置, 不应受到邻接伤害
        self.assertFalse(
            enemy3_damaged,
            f"enemy3(ENEMY_RIGHT_FRONT)不在enemy1的邻接位置, 不应受到邻接伤害, "
            f"HP: {initial_hp[self.enemy3.unit_id]} -> {self.enemy3.current_hp}"
        )

        # enemy_back不在enemy1邻接位置, 不应受到邻接伤害
        self.assertFalse(
            enemy_back_damaged,
            f"enemy_back(ENEMY_CENTER_BACK)不在enemy1的邻接位置, 不应受到邻接伤害, "
            f"HP: {initial_hp[self.enemy_back.unit_id]} -> {self.enemy_back.current_hp}"
        )

    def test_ex_burn_duration_and_damage_tick(self):
        """
        测试17: EX(110017) burn duration=5 和伤害tick
        EX施放后敌方获得burn debuff(duration=5), burn每回合扣血(攻击力×30%)。

        流程:
        1. 执行EX技能110017
        2. 验证敌方获得burn debuff, duration=5
        3. 验证burn debuff的value=caster.attack × 30%
        4. 应用burn伤害tick (status_service.apply_burn_damage)
        5. 验证敌方HP减少 (按value扣血)
        """
        # 记录caster攻击力
        caster_atk = self.caster.attack
        expected_burn_value = caster_atk * 30 / 100  # 30%默认

        # 执行EX技能110017
        result = self.ss.execute_skill(
            caster=self.caster,
            skill_id=110017,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"EX技能执行应成功: {result.get('error', '')}")

        # 验证敌方获得burn debuff (Conflagration, duration=5)
        for enemy in [self.enemy1, self.enemy2, self.enemy3]:
            burn_debuffs = [
                d for d in enemy.debuffs
                if d.effect_type == SkillEffectType.CONFLAGRATION.value
            ]
            self.assertTrue(
                len(burn_debuffs) > 0,
                f"{enemy.name}应有burn(Conflagration)debuff, "
                f"实际debuffs: {[(d.effect_type, d.duration) for d in enemy.debuffs]}"
            )
            self.assertEqual(
                burn_debuffs[0].duration, 5,
                f"{enemy.name}的burn debuff持续应为5行动, "
                f"实际: {burn_debuffs[0].duration}"
            )

        # 验证burn debuff的value (攻击力×30%)
        # 注意: value使用包含buff/debuff的即时攻击力(通过_calculate_final_stat)
        # caster无buff/debuff时, value=caster.attack × 30 / 100
        burn_debuff = next(
            d for d in self.enemy1.debuffs
            if d.effect_type == SkillEffectType.CONFLAGRATION.value
        )
        self.assertAlmostEqual(
            burn_debuff.value, expected_burn_value,
            delta=1,
            msg=f"burn debuff的value应为caster.attack×30%={expected_burn_value}, "
                f"实际: {burn_debuff.value}"
        )

        # 记录enemy1伤害前HP
        hp_before_tick = self.enemy1.current_hp

        # 应用burn伤害tick
        total_damage, count, _ = self.stsvc.apply_burn_damage(self.enemy1)

        # 验证burn伤害为正数
        self.assertGreater(
            total_damage, 0,
            "burn伤害tick应造成正数伤害"
        )

        # 验证HP减少量等于burn value (单层burn, multiplier=1)
        hp_after_tick = self.enemy1.current_hp
        actual_damage = hp_before_tick - hp_after_tick
        self.assertAlmostEqual(
            actual_damage, expected_burn_value,
            delta=1,
            msg=f"burn伤害tick应造成{expected_burn_value}伤害, "
                f"HP: {hp_before_tick} -> {hp_after_tick}, 实际伤害: {actual_damage}"
        )


if __name__ == '__main__':
    unittest.main()
