# Part 4: duration / timing
# ═══════════════════════════════════════════════════════════════════════

class TestApplySubUnitDuration(_BaseSubUnitTest):
    """_apply_sub_unit: duration / timing_type。"""

    def test_default_duration_type_action(self):
        """默认 duration_type='action' → DURABLE_TARGET_MANEUVER_END。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(duration=None, duration_type=None)

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.timing_type, AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value)
        self.assertEqual(sub_buff.duration, 1)  # 默认1

    def test_duration_type_turn(self):
        """duration_type='turn' → DURABLE_SOURCE_MANEUVER_END。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(duration=2, duration_type='turn')

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.timing_type, AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value)
        self.assertEqual(sub_buff.duration, 2)


# ═══════════════════════════════════════════════════════════════════════
# Part 5: apply_count
# ═══════════════════════════════════════════════════════════════════════

class TestApplySubUnitApplyCount(_BaseSubUnitTest):
    """_apply_sub_unit: apply_count 多实例。"""

    def test_apply_count_creates_multiple_instances(self):
        """apply_count=3 时为目标创建3个独立 sub_unit buff。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={'apply_count': 3})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(len(result["targets"]), 3)
        sub_buffs = [b for b in caster.buffs if b.effect_type == SkillEffectType.SUB_UNIT.value]
        self.assertEqual(len(sub_buffs), 3)
        # buff_id 唯一
        buff_ids = [b.buff_id for b in sub_buffs]
        self.assertEqual(len(set(buff_ids)), 3)

    def test_apply_count_default_1(self):
        """未指定 apply_count 时默认1。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(len(result["targets"]), 1)

    def test_apply_count_zero_clamped_to_1(self):
        """apply_count=0 被 clamp 为 1。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={'apply_count': 0})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(len(result["targets"]), 1)


# ═══════════════════════════════════════════════════════════════════════
# Part 6: linked_expiry
# ═══════════════════════════════════════════════════════════════════════

class TestApplySubUnitLinkedExpiry(_BaseSubUnitTest):
    """_apply_sub_unit: linked_expiry 联动失效。"""

    def test_linked_expiry_shares_link_group(self):
        """linked_expiry=True 时本次技能创建的所有 sub_unit 共享 link_group_id。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        a1 = _make_unit("a1", "A1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        a2 = _make_unit("a2", "A2", Side.ALLY, Position.ALLY_CENTER_FRONT)
        bf = _make_bf(caster, a1, a2)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(target_type='ally_all', flags={'linked_expiry': True})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        a1_subs = [b for b in a1.buffs if b.effect_type == SkillEffectType.SUB_UNIT.value]
        a2_subs = [b for b in a2.buffs if b.effect_type == SkillEffectType.SUB_UNIT.value]
        self.assertEqual(len(a1_subs), 1)
        self.assertEqual(len(a2_subs), 1)
        # 共享同一 link_group
        self.assertEqual(a1_subs[0].sub_unit_link_group, a2_subs[0].sub_unit_link_group)
        self.assertTrue(a1_subs[0].sub_unit_link_group)

    def test_no_linked_expiry_empty_link_group(self):
        """未启用 linked_expiry 时 sub_unit_link_group 为空字符串。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.sub_unit_link_group, "")

    def test_linked_expiry_default_off(self):
        """linked_expiry 默认关闭。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={})

        ss._apply_sub_unit(caster, effect, bf)

        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.sub_unit_link_group, "")


# ═══════════════════════════════════════════════════════════════════════
# Part 7: en_type_priority
# ═══════════════════════════════════════════════════════════════════════

class TestApplySubUnitEnTypePriority(_BaseSubUnitTest):
    """_apply_sub_unit: en_type_priority。"""

    def test_en_type_priority_prefers_en_ally(self):
        """优先 EN 类型友方（character_type=2）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK,
                            character_type=1)
        # 中前排是非EN（character_type=1），更近
        non_en = _make_unit("non_en", "NonEN", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            character_type=1)
        # 右前排是EN（character_type=2），更远
        en_ally = _make_unit("en_ally", "EN", Side.ALLY, Position.ALLY_RIGHT_FRONT,
                             character_type=2)
        bf = _make_bf(caster, non_en, en_ally)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(target_type='self',
                              flags={'en_type_priority': True})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["targets"][0]["target_id"], "en_ally")

    def test_en_type_priority_fallback_to_non_en(self):
        """无 EN 类型友方时 fallback 到非EN友方。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK,
                            character_type=1)
        non_en = _make_unit("non_en", "NonEN", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            character_type=1)
        bf = _make_bf(caster, non_en)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(target_type='self',
                              flags={'en_type_priority': True})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["targets"][0]["target_id"], "non_en")

    def test_en_type_priority_fallback_to_self_when_no_other_ally(self):
        """无其他友方时 fallback 到自身。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(target_type='self',
                              flags={'en_type_priority': True})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["targets"][0]["target_id"], "caster")


# ═══════════════════════════════════════════════════════════════════════
# Part 8: 返回值结构
# ═══════════════════════════════════════════════════════════════════════

class TestApplySubUnitReturnStructure(_BaseSubUnitTest):
    """_apply_sub_unit: 返回值结构。"""

    def test_return_value_fields_complete(self):
        """返回值包含所有字段。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK, hp=10000)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(value=80.0, flags={'sub_unit_hp_pct': 50.0, 'sub_unit_name': '子機Ⅰ'})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["effect_type"], "sub_unit")
        self.assertEqual(result["total_damage"], 0)
        target = result["targets"][0]
        self.assertEqual(target["target"], "C")
        self.assertEqual(target["target_id"], "caster")
        self.assertEqual(target["sub_unit_name"], "子機Ⅰ")
        self.assertEqual(target["sub_unit_hp"], 5000)
        self.assertEqual(target["sub_unit_max_hp"], 5000)
        self.assertEqual(target["atk_dmg_pct"], 80.0)
        self.assertEqual(target["duration"], 1)
        self.assertEqual(target["dur_type"], "action")

    def test_return_value_targets_count_matches_apply_count(self):
        """apply_count=3 时 targets 列表长度为3。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={'apply_count': 3})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(len(result["targets"]), 3)


# ═══════════════════════════════════════════════════════════════════════
# Part 9: value 处理
# ═══════════════════════════════════════════════════════════════════════

class TestApplySubUnitValueHandling(_BaseSubUnitTest):
    """_apply_sub_unit: value 字段处理。"""

    def test_value_none_defaults_to_zero(self):
        """effect.value=None 时 atk_pct=0。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(value=None)

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.value, 0)
        self.assertEqual(result["targets"][0]["atk_dmg_pct"], 0)

    def test_value_used_as_atk_pct(self):
        """effect.value 直接作为 atk_pct。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(value=120.0)

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.value, 120.0)


# ═══════════════════════════════════════════════════════════════════════
# Part 10: _apply_remove_sub_unit
# ═══════════════════════════════════════════════════════════════════════

class TestApplyRemoveSubUnit(_BaseSubUnitTest):
    """_apply_remove_sub_unit: 移除 sub_unit buff。"""

    def test_remove_all_sub_unit_buffs_from_self(self):
        """移除 caster 自身所有 sub_unit buff。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        caster.buffs.append(_make_sub_buff("sub1"))
        caster.buffs.append(_make_sub_buff("sub2"))
        caster.buffs.append(BuffState(
            buff_id="other", name="Other",
            effect_type=SkillEffectType.STATUS_ATTACK.value,
            value=50, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        ))
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(effect_type='remove_sub_unit', target_type='self')

        result = ss._apply_remove_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["targets"][0]["removed_count"], 2)
        # 非 sub_unit buff 保留
        remaining_subs = [b for b in caster.buffs
                          if b.effect_type == SkillEffectType.SUB_UNIT.value]
        self.assertEqual(len(remaining_subs), 0)
        other_buffs = [b for b in caster.buffs
                       if b.effect_type == SkillEffectType.STATUS_ATTACK.value]
        self.assertEqual(len(other_buffs), 1)

    def test_no_sub_unit_returns_zero_count(self):
        """无 sub_unit buff 时 removed_count=0。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(effect_type='remove_sub_unit', target_type='self')

        result = ss._apply_remove_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["targets"][0]["removed_count"], 0)

    def test_skip_dead_targets(self):
        """死亡目标被跳过。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        dead_ally = _make_unit("dead", "D", Side.ALLY, Position.ALLY_LEFT_FRONT)
        dead_ally.is_alive = False
        dead_ally.buffs.append(_make_sub_buff("sub1"))
        bf = _make_bf(caster, dead_ally)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(effect_type='remove_sub_unit', target_type='ally_single')

        result = ss._apply_remove_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        # 死亡目标不在结果中
        target_ids = [t["target_id"] for t in result["targets"]]
        self.assertNotIn("dead", target_ids)


# ═══════════════════════════════════════════════════════════════════════
# Part 11: _cascade_linked_sub_unit_expiry
# ═══════════════════════════════════════════════════════════════════════

class TestCascadeLinkedSubUnitExpiry(_BaseSubUnitTest):
    """_cascade_linked_sub_unit_expiry: 跨目标联动失效。"""

    def test_empty_link_group_returns_empty(self):
        """空 link_group 直接返回空列表。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, _, aus, *_ = self._make_services(bf)
        # 无 link_group 的 sub_unit buff
        expired = _make_sub_buff("expired_sub", link_group="")
        removed = aus._cascade_linked_sub_unit_expiry(expired, caster, bf.get_all_units())

        self.assertEqual(removed, [])

    def test_cascade_removes_linked_buffs_on_other_units(self):
        """同 link_group 的其他单位 sub_unit 被级联移除。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        a1 = _make_unit("a1", "A1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        a2 = _make_unit("a2", "A2", Side.ALLY, Position.ALLY_CENTER_FRONT)
        link_group = "linked_test_group"
        # a1 上的 sub_unit 失效
        a1_sub = _make_sub_buff("a1_sub", link_group=link_group, hp=0, duration=0)
        a1.buffs.append(a1_sub)
        # a2 上的 sub_unit 同组，duration>0 未过期才能被级联
        a2_sub = _make_sub_buff("a2_sub", link_group=link_group, hp=5000, duration=2)
        a2.buffs.append(a2_sub)
        bf = _make_bf(caster, a1, a2)
        ss, _, aus, *_ = self._make_services(bf)

        removed = aus._cascade_linked_sub_unit_expiry(a1_sub, a1, bf.get_all_units())

        # a2 上的 sub_unit 应被级联移除
        self.assertEqual(len(removed), 1)
        self.assertEqual(removed[0][0], "A2")
        a2_remaining = [b for b in a2.buffs
                        if b.effect_type == SkillEffectType.SUB_UNIT.value
                        and b.duration > 0]
        self.assertEqual(len(a2_remaining), 0)

    def test_skip_self_unit(self):
        """级联时跳过自身（持有 expired_buff 的单位）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        a1 = _make_unit("a1", "A1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        link_group = "linked_test_group"
        # a1 上同时有过期和未过期的同组 sub_unit
        a1_expired = _make_sub_buff("a1_expired", link_group=link_group, hp=0, duration=0)
        a1_alive = _make_sub_buff("a1_alive", link_group=link_group, hp=5000, duration=2)
        a1.buffs.extend([a1_expired, a1_alive])
        bf = _make_bf(caster, a1)
        ss, _, aus, *_ = self._make_services(bf)

        removed = aus._cascade_linked_sub_unit_expiry(a1_expired, a1, bf.get_all_units())

        # a1 自身的未过期 sub_unit 不被级联移除
        self.assertEqual(removed, [])
        # a1_alive 仍在
        self.assertIn(a1_alive, a1.buffs)

    def test_skip_dead_units(self):
        """级联时跳过死亡单位。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        a1 = _make_unit("a1", "A1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        a2 = _make_unit("a2", "A2", Side.ALLY, Position.ALLY_CENTER_FRONT)
        a2.is_alive = False
        link_group = "linked_test_group"
        a1_sub = _make_sub_buff("a1_sub", link_group=link_group, hp=0, duration=0)
        a1.buffs.append(a1_sub)
        a2_sub = _make_sub_buff("a2_sub", link_group=link_group, hp=5000, duration=2)
        a2.buffs.append(a2_sub)
        bf = _make_bf(caster, a1, a2)
        ss, _, aus, *_ = self._make_services(bf)

        removed = aus._cascade_linked_sub_unit_expiry(a1_sub, a1, bf.get_all_units())

        # a2 死亡，跳过
        self.assertEqual(removed, [])

    def test_only_affects_same_link_group(self):
        """只影响同 link_group 的 sub_unit。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        a1 = _make_unit("a1", "A1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        a2 = _make_unit("a2", "A2", Side.ALLY, Position.ALLY_CENTER_FRONT)
        group1 = "group_1"
        group2 = "group_2"
        a1_sub = _make_sub_buff("a1_sub", link_group=group1, hp=0, duration=0)
        a1.buffs.append(a1_sub)
        # a2 上是不同 link_group 的 sub_unit
        a2_sub_g2 = _make_sub_buff("a2_sub_g2", link_group=group2, hp=5000, duration=2)
        a2.buffs.append(a2_sub_g2)
        bf = _make_bf(caster, a1, a2)
        ss, _, aus, *_ = self._make_services(bf)

        removed = aus._cascade_linked_sub_unit_expiry(a1_sub, a1, bf.get_all_units())

        # 不同 link_group 不被级联
        self.assertEqual(removed, [])
        self.assertIn(a2_sub_g2, a2.buffs)


# ═══════════════════════════════════════════════════════════════════════
# Part 12: buff 属性
# ═══════════════════════════════════════════════════════════════════════

class TestSubUnitBuffProperties(_BaseSubUnitTest):
    """_apply_sub_unit: buff 属性。"""

    def test_is_stackable_true(self):
        """sub_unit buff 的 is_stackable=True。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect()

        ss._apply_sub_unit(caster, effect, bf)

        sub_buff = caster.buffs[-1]
        self.assertTrue(sub_buff.is_stackable)

    def test_is_not_debuff(self):
        """sub_unit buff 不是 debuff。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect()

        ss._apply_sub_unit(caster, effect, bf)

        sub_buff = caster.buffs[-1]
        self.assertFalse(sub_buff.is_debuff)
        # 在 buffs 列表而非 debuffs
        self.assertIn(sub_buff, caster.buffs)
        self.assertNotIn(sub_buff, caster.debuffs)

    def test_multiple_instances_coexist(self):
        """apply_count=3 时3个 sub_unit buff 共存于同一目标。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={'apply_count': 3})

        ss._apply_sub_unit(caster, effect, bf)

        sub_buffs = [b for b in caster.buffs
                     if b.effect_type == SkillEffectType.SUB_UNIT.value]
        self.assertEqual(len(sub_buffs), 3)

    def test_buff_id_unique(self):
        """每个 sub_unit buff 的 buff_id 唯一。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        a1 = _make_unit("a1", "A1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        a2 = _make_unit("a2", "A2", Side.ALLY, Position.ALLY_CENTER_FRONT)
        bf = _make_bf(caster, a1, a2)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(target_type='ally_all')

        ss._apply_sub_unit(caster, effect, bf)

        all_subs = ([b for b in a1.buffs if b.effect_type == SkillEffectType.SUB_UNIT.value]
                    + [b for b in a2.buffs if b.effect_type == SkillEffectType.SUB_UNIT.value])
        buff_ids = [b.buff_id for b in all_subs]
        self.assertEqual(len(buff_ids), len(set(buff_ids)))


# ═══════════════════════════════════════════════════════════════════════
# Part 13: add_status_to_attack
# ═══════════════════════════════════════════════════════════════════════

class TestSubUnitAddStatusToAttack(_BaseSubUnitTest):
    """_apply_sub_unit: add_status_to_attack 信息存储。"""

    def test_add_status_stored_in_hit_limited_flags(self):
        """add_status_to_attack 信息存储在 hit_limited_flags 字典。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={
            'add_status_to_attack': {'status': 'spd_down', 'value': 30.0}
        })

        ss._apply_sub_unit(caster, effect, bf)

        sub_buff = caster.buffs[-1]
        self.assertIn('add_status_to_attack', sub_buff.hit_limited_flags)
        self.assertEqual(sub_buff.hit_limited_flags['add_status_to_attack']['status'], 'spd_down')

    def test_no_add_status_empty_dict(self):
        """无 add_status_to_attack 时 hit_limited_flags 为空字典。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={})

        ss._apply_sub_unit(caster, effect, bf)

        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.hit_limited_flags, {})

    def test_sub_unit_name_from_flags(self):
        """sub_unit_name 从 flags.sub_unit_name 读取。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={'sub_unit_name': '子機Ⅱ'})

        ss._apply_sub_unit(caster, effect, bf)

        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.name, '子機Ⅱ')

    def test_sub_unit_name_default(self):
        """无 sub_unit_name 时默认 'SubUnit'。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(flags={})

        ss._apply_sub_unit(caster, effect, bf)

        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.name, 'SubUnit')


# ═══════════════════════════════════════════════════════════════════════
# Part 14: 内部状态管理
# ═══════════════════════════════════════════════════════════════════════

class TestSubUnitInternalStateManagement(_BaseSubUnitTest):
    """_apply_sub_unit: 内部状态管理。"""

    def test_newly_created_sub_unit_ids_tracked(self):
        """新创建的 sub_unit buff_id 被加入 _newly_created_sub_unit_ids。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._newly_created_sub_unit_ids = set()
        effect = _make_effect()

        ss._apply_sub_unit(caster, effect, bf)

        sub_buff = caster.buffs[-1]
        self.assertIn(sub_buff.buff_id, ss._newly_created_sub_unit_ids)

    def test_multiple_newly_created_tracked(self):
        """apply_count=3 时3个 buff_id 都被跟踪。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._newly_created_sub_unit_ids = set()
        effect = _make_effect(flags={'apply_count': 3})

        ss._apply_sub_unit(caster, effect, bf)

        sub_buffs = [b for b in caster.buffs
                     if b.effect_type == SkillEffectType.SUB_UNIT.value]
        self.assertEqual(len(sub_buffs), 3)
        for b in sub_buffs:
            self.assertIn(b.buff_id, ss._newly_created_sub_unit_ids)

    def test_skill_end_clears_newly_created_cache(self):
        """execute_skill 末尾清空 _newly_created_sub_unit_ids。"""
        # 这里仅验证 clear() 调用后的状态
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        ss._newly_created_sub_unit_ids = {"test_id_1", "test_id_2"}

        ss._newly_created_sub_unit_ids.clear()

        self.assertEqual(ss._newly_created_sub_unit_ids, set())


if __name__ == '__main__':
    unittest.main()
