"""_apply_sub_unit / _apply_remove_sub_unit / 联动失效 单元测试。

测试目标：
1. _apply_sub_unit 创建逻辑
   - HP计算: caster.max_hp × hp_pct / 100 (最低1)
   - 快照攻击力: caster 当前 final attack (含 buff)
   - 目标选择: self / ally_single / 缓存优先 / target_count截断 / 死亡过滤
   - duration/timing: 默认 action / turn 类型
   - apply_count: 多实例创建
   - linked_expiry: 共享 link_group_id
   - en_type_priority: EN 类型友方 > 非EN > 自身
   - 返回值结构

2. _apply_remove_sub_unit 移除逻辑
   - 移除自身所有 sub_unit buff
   - 无 sub_unit 时 removed_count=0
   - 跳过死亡目标

3. _cascade_linked_sub_unit_expiry 联动失效
   - 空 link_group 返回空
   - 跨单位级联移除
   - 跳过自身
   - 跳过死亡单位
   - 只影响同 link_group

4. buff 属性
   - is_stackable=True / 非debuff / buff_id 唯一
   - 多实例共存
"""
import sys
import os
import unittest
from types import SimpleNamespace

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


# ─── 工厂函数 ──────────────────────────────────────────────

def _make_unit(unit_id, name, side, position, *, hp=50000, atk=10000,
               defense=4000, speed=500, current_hp=None, character_type=1):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=2, character_type=character_type,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


def _make_effect(**kwargs):
    """Create a mock effect object with attributes."""
    defaults = {
        'effect_type': 'sub_unit',
        'value': 100.0,
        'value_tag': None,
        'target_type': 'self',
        'flags': {},
        'target_identifier': None,
        'hit_count': None,
        'condition': None,
        'duration': 1,
        'duration_type': None,
    }
    defaults.update(kwargs)
    obj = type('obj', (object,), defaults)()
    return obj


def _make_sub_buff(buff_id, *, name="SubUnit", value=100.0, duration=-1,
                   hp=10000, max_hp=None, link_group="", source_unit_id="caster",
                   just_applied=False):
    """手动构造 sub_unit buff（不通过 _apply_sub_unit）。"""
    return BuffState(
        buff_id=buff_id, name=name,
        effect_type=SkillEffectType.SUB_UNIT.value,
        value=value, duration=duration,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=source_unit_id,
        source_skill_id=130079,
        caster_attack=10000,
        is_debuff=False,
        is_stackable=True,
        sub_unit_hp=hp,
        sub_unit_max_hp=max_hp if max_hp is not None else hp,
        sub_unit_link_group=link_group,
        just_applied=just_applied,
    )


class _BaseSubUnitTest(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf, with_target=True):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService() if with_target else None
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        ss._current_skill_id = 130079
        # 初始化内部状态
        ss._newly_created_sub_unit_ids = set()
        ss._block_damage_targets = None
        ss._current_skill_priority = None
        ss._current_block_id = 0
        return ss, ts, aus, dms, sts


# ═══════════════════════════════════════════════════════════════════════
# Part 1: _apply_sub_unit HP 计算
# ═══════════════════════════════════════════════════════════════════════

class TestApplySubUnitHP(_BaseSubUnitTest):
    """_apply_sub_unit: HP 计算。"""

    def test_sub_unit_hp_based_on_caster_max_hp(self):
        """sub_unit_max_hp = caster.max_hp × hp_pct / 100。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK,
                            hp=100000, atk=10000)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(value=100.0, flags={'sub_unit_hp_pct': 25.0})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.sub_unit_max_hp, 25000)
        self.assertEqual(sub_buff.sub_unit_hp, 25000)

    def test_sub_unit_hp_minimum_1(self):
        """hp_pct=0 或 caster.max_hp=0 时 HP 最低为 1。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK,
                            hp=100, atk=10000)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(value=100.0, flags={'sub_unit_hp_pct': 0.0})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        sub_buff = caster.buffs[-1]
        self.assertEqual(sub_buff.sub_unit_max_hp, 1)
        self.assertEqual(sub_buff.sub_unit_hp, 1)

    def test_sub_unit_hp_default_25_pct(self):
        """未指定 hp_pct 时默认 25%。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK,
                            hp=40000, atk=10000)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(value=100.0, flags={})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        sub_buff = caster.buffs[-1]
        # 40000 × 25% = 10000
        self.assertEqual(sub_buff.sub_unit_max_hp, 10000)


# ═══════════════════════════════════════════════════════════════════════
# Part 2: 快照攻击力
# ═══════════════════════════════════════════════════════════════════════

class TestApplySubUnitSnapshotAttack(_BaseSubUnitTest):
    """_apply_sub_unit: 快照攻击力。"""

    def test_snapshot_atk_uses_caster_final_atk(self):
        """caster_attack 保存 caster 当时的 final attack（含 buff）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK,
                            hp=10000, atk=10000)
        # 加一个 atk_up buff (50% 加算)
        caster.buffs.append(BuffState(
            buff_id="atk_up_1", name="ATK_UP",
            effect_type=SkillEffectType.STATUS_ATTACK.value,
            value=50.0, duration=-1, value_tag=0,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="caster", is_debuff=False,
        ))
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(value=100.0, flags={'sub_unit_hp_pct': 25.0})

        ss._apply_sub_unit(caster, effect, bf)

        sub_buff = caster.buffs[-1]
        # final_atk = 10000 × (1 + 50%) = 15000
        self.assertEqual(sub_buff.caster_attack, 15000)


# ═══════════════════════════════════════════════════════════════════════
# Part 3: 目标选择
# ═══════════════════════════════════════════════════════════════════════

class TestApplySubUnitTargeting(_BaseSubUnitTest):
    """_apply_sub_unit: 目标选择。"""

    def test_target_type_self_returns_caster(self):
        """target_type='self' 时目标为 caster 自身。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(target_type='self')

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(len(result["targets"]), 1)
        self.assertEqual(result["targets"][0]["target_id"], "caster")

    def test_target_type_ally_single_selects_nearest(self):
        """ally_single 选择最近的友方。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        # 左前排友方比中前排更近
        ally_left = _make_unit("ally_left", "AL", Side.ALLY, Position.ALLY_LEFT_FRONT)
        ally_center = _make_unit("ally_center", "AC", Side.ALLY, Position.ALLY_CENTER_FRONT)
        bf = _make_bf(caster, ally_left, ally_center)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(target_type='ally_single')

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(len(result["targets"]), 1)
        # 左前排距离左后排最近
        self.assertEqual(result["targets"][0]["target_id"], "ally_left")

    def test_cached_targets_take_priority(self):
        """_block_damage_targets 缓存优先于 select_targets。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        cached_ally = _make_unit("cached", "Cached", Side.ALLY, Position.ALLY_RIGHT_FRONT)
        other_ally = _make_unit("other", "Other", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, cached_ally, other_ally)
        ss, *_ = self._make_services(bf)
        # 预填充缓存
        ss._block_damage_targets = {'ally_single': [cached_ally]}
        effect = _make_effect(target_type='ally_single')

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        # 应使用缓存目标（cached_ally），而非选最近的 other_ally
        self.assertEqual(result["targets"][0]["target_id"], "cached")

    def test_target_count_truncates_list(self):
        """target_count > 1 时截断到指定数量。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        a1 = _make_unit("a1", "A1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        a2 = _make_unit("a2", "A2", Side.ALLY, Position.ALLY_CENTER_FRONT)
        a3 = _make_unit("a3", "A3", Side.ALLY, Position.ALLY_RIGHT_FRONT)
        bf = _make_bf(caster, a1, a2, a3)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(target_type='ally_all', flags={'target_count': 2})

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(len(result["targets"]), 2)

    def test_dead_targets_filtered(self):
        """死亡目标被过滤。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        dead_ally = _make_unit("dead", "D", Side.ALLY, Position.ALLY_LEFT_FRONT)
        dead_ally.is_alive = False
        alive_ally = _make_unit("alive", "A", Side.ALLY, Position.ALLY_CENTER_FRONT)
        bf = _make_bf(caster, dead_ally, alive_ally)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(target_type='ally_all')

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNotNone(result)
        target_ids = [t["target_id"] for t in result["targets"]]
        self.assertIn("alive", target_ids)
        self.assertNotIn("dead", target_ids)

    def test_all_dead_returns_none(self):
        """所有目标都死亡时返回 None。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        dead_ally = _make_unit("dead", "D", Side.ALLY, Position.ALLY_LEFT_FRONT)
        dead_ally.is_alive = False
        bf = _make_bf(caster, dead_ally)
        ss, *_ = self._make_services(bf)
        effect = _make_effect(target_type='ally_single')

        result = ss._apply_sub_unit(caster, effect, bf)

        self.assertIsNone(result)


