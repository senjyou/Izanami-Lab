"""分析 skill_effects_hybrid.json 中剩余的 failed 技能。"""
import json
import sys
import os
from collections import Counter

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))

# 加载 hybrid 数据
with open('data/skill_effects_hybrid.json', encoding='utf-8') as f:
    data = json.load(f)

# 加载 skills.json 直接读取
with open('data/skills.json', encoding='utf-8') as f:
    skills_raw = json.load(f)

# skills.json 是 dict 格式
if isinstance(skills_raw, dict):
    skills_data = skills_raw
elif isinstance(skills_raw, list):
    skills_data = {s.get('skill_id') or s.get('id'): s for s in skills_raw}
else:
    skills_data = {}

# 统计 parse_status
status_counter = Counter()
failed_skills = []
manual_skills = []
for skill_id, skill_data in data.items():
    status = skill_data.get('parse_status', 'unknown')
    status_counter[status] += 1
    if status == 'failed':
        failed_skills.append(skill_id)
    elif status == 'manual':
        manual_skills.append(skill_id)

print('=== Parse Status 统计 ===')
for status, count in status_counter.most_common():
    print(f'  {status}: {count}')
print()

# 显示 failed 技能详细信息
print(f'=== Failed 技能列表 ({len(failed_skills)}个) ===')
for sid in failed_skills:
    skill = data[sid]
    name = skill.get('name', '')
    # 从 skills.json 获取技能类型
    skill_info = skills_data.get(sid, {})
    skill_type = skill_info.get('skill_type', '?')
    skill_type_name = {1: 'AS', 2: 'PS', 3: 'EX'}.get(skill_type, '?')
    parse_error = skill.get('parse_error', '') or skill.get('error', '')
    print(f'  {sid} ({skill_type_name}): {name}')
    if parse_error:
        print(f'    reason: {parse_error[:120]}')
