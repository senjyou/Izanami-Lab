#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""技能120013 ソーヴィニヨン hp_threshold_cross条件在附魔伤害后正确判断的测试

测试场景：
- 攻击者: ノーブル・グレイス (光属性, 物理型, ATK=398000)
- 附魔源: 混沌の立役者 (火属性, EN型, ATK=137000, 模拟追撃符附魔效果)
- 目标: フィー・ドレーゼ (风属性, HP=1936040, DEF=60000, 70%阈值=1355228)

伤害计算:
- 主伤害 = (398000-60000)*1.716 ≈ 580008, HP: 1936040→1356032 (>1355228, 不触发眩晕)
- 附魔伤害 = 137000*0.364 ≈ 49868, HP: 1356032→1306164 (<1355228, 触发眩晕)
- 最终目标应有knockout/stun debuff
"""

import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService


class TestSauvignonHPThresholdCross(unittest.TestCase):
    """测试技能120013 ソーヴィニヨン的hp_threshold_cross条件在附魔伤害后正确判断"""

    @classmethod
    def setUpClass(cls):
        """加载游戏数据（所有测试共享）"""
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        """每个测试前创建战场和服务"""
        self.bf = BattlefieldState()

        # 附魔源: 混沌の立役者 (火属性, EN型, 后排)
        # 模拟追撃符的附魔效果来源
        self.enchant_source = UnitState(
            unit_id="ally_chaos", name="混沌の立役者", side=Side.ALLY,
            position=Position.ALLY_LEFT_BACK, character_id=111301, level=200,
            element=1, character_type=2,  # 火属性, EN型
            max_hp=132990, current_hp=132990,
            attack=137000, defense=79872, speed=999,
            crit_rate=0.1, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[130051], skill_levels={130051: 15}, skill_cooldowns={},
        )

        # 攻击者: ノーブル・グレイス (光属性, 物理型, 前排)
        # 光(5)不克制风(3), attr_factor=1.0
        self.attacker = UnitState(
            unit_id="ally_noble", name="ノーブル・グレイス", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=121301, level=200,
            element=5, character_type=1,  # 光属性, 物理型
            max_hp=112464, current_hp=112464,
            attack=398000, defense=55688, speed=1261,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[120013], skill_levels={120013: 10}, skill_cooldowns={},
        )

        # 目标: フィー・ドレーゼ (风属性, 物理型)
        # HP=1936040, 70%阈值 = int(1936040 * 70 / 100) = 1355228
        self.target = UnitState(
            unit_id="enemy_fii", name="フィー・ドレーゼ", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999999, level=200,
            element=3, character_type=1,  # 风属性, 物理型
            max_hp=1936040, current_hp=1936040,
            attack=50000, defense=60000, speed=500,
            crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.add_unit(self.enchant_source)
        self.bf.add_unit(self.attacker)
        self.bf.add_unit(self.target)

        # 创建服务
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.asvc = AuraService()
        self.dmgsvc = DamageService()
        self.tgtsvc = TargetService()
        self.stsvc = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgtsvc,
            damage_service=self.dmgsvc,
            aura_service=self.asvc,
            status_service=self.stsvc,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

    def _add_enchant_damage_buff(self, power_pct=36.4):
        """给攻击者添加EnchantDamage buff (模拟追撃符的附魔效果)

        source_unit_id指向附魔源单位(混沌の立役者), 附魔伤害基于附魔源的攻击力计算
        """
        source_atk = self.dmgsvc._calculate_final_stat(self.enchant_source, "attack")
        enchant_buff = BuffState(
            buff_id=f"{self.attacker.unit_id}_enchant_damage_test",
            name="EnchantDamage",
            effect_type=SkillEffectType.ENCHANT_DAMAGE.value,
            value=power_pct,
            duration=1,
            timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
            caster_attack=source_atk,
            source_unit_id=self.enchant_source.unit_id,
            source_skill_id=130051,
            hit_limited=1,
        )
        self.attacker.buffs.append(enchant_buff)
        return enchant_buff

    def test_hp_threshold_cross_after_enchant_damage(self):
        """
        核心测试: 附魔伤害后hp_threshold_cross条件正确判断

        场景:
        - 目标HP=1936040, 70%阈值=1355228
        - 主伤害后目标HP≈1356032 (>1355228, 不触发眩晕)
        - 附魔伤害后目标HP≈1306164 (<1355228, 触发眩晕)
        - 最终目标应有knockout/stun debuff
        """
        # 添加EnchantDamage buff
        self._add_enchant_damage_buff(power_pct=36.4)

        # 记录初始HP
        initial_hp = self.target.current_hp
        threshold_hp = int(self.target.max_hp * 70 / 100)  # 1355228

        # 执行技能120013 (ソーヴィニヨン)
        result = self.ss.execute_skill(
            caster=self.attacker,
            skill_id=120013,
            battlefield=self.bf,
            skip_cost=True,
        )

        # 验证技能执行成功
        self.assertTrue(result["success"], f"技能执行应成功: {result.get('error', '')}")

        # 验证目标受到了伤害
        final_hp = self.target.current_hp
        self.assertLess(final_hp, initial_hp, "目标HP应下降")

        # 从result中提取主伤害和附魔伤害
        # 主伤害: damage效果中第一个; 附魔伤害: damage效果中第二个
        damage_effects = [e for e in result.get("effects_applied", [])
                         if e.get("effect_type") == "damage"]

        main_damage = 0
        enchant_damage = 0
        if len(damage_effects) >= 1:
            main_targets = damage_effects[0].get("targets", [])
            main_damage = sum(t.get("actual_damage", 0) for t in main_targets)
        if len(damage_effects) >= 2:
            enchant_targets = damage_effects[1].get("targets", [])
            enchant_damage = sum(t.get("actual_damage", 0) for t in enchant_targets)

        hp_after_main = initial_hp - main_damage
        hp_after_enchant = hp_after_main - enchant_damage

        # 关键验证1: 主伤害后HP > 70%阈值 (此时不应触发眩晕)
        self.assertGreater(
            hp_after_main, threshold_hp,
            f"主伤害后HP({hp_after_main})应大于70%阈值({threshold_hp}), "
            f"主伤害={main_damage}"
        )

        # 关键验证2: 附魔伤害后HP < 70%阈值 (此时应触发眩晕)
        self.assertLess(
            hp_after_enchant, threshold_hp,
            f"附魔伤害后HP({hp_after_enchant})应小于70%阈值({threshold_hp}), "
            f"附魔伤害={enchant_damage}"
        )

        # 关键验证3: 目标身上应有knockout/stun debuff
        has_stun = any(
            b.effect_type == SkillEffectType.KNOCKOUT.value
            for b in self.target.debuffs
        )
        self.assertTrue(
            has_stun,
            f"目标应有Knockout(stun) debuff, "
            f"实际debuffs: {[(b.effect_type, b.value) for b in self.target.debuffs]}"
        )

        # 验证眩晕标志位
        self.assertTrue(
            self.target.is_stunned,
            "目标is_stunned标志应为True"
        )

    def test_no_stun_without_enchant_when_hp_above_threshold(self):
        """
        对照测试: 没有附魔伤害时, 主伤害后HP仍>70%阈值, 不应触发眩晕

        场景:
        - 同样的攻击者和目标
        - 不添加EnchantDamage buff
        - 主伤害后HP > 70%阈值
        - 不应触发眩晕
        """
        # 不添加EnchantDamage buff
        initial_hp = self.target.current_hp
        threshold_hp = int(self.target.max_hp * 70 / 100)

        # 执行技能120013
        result = self.ss.execute_skill(
            caster=self.attacker,
            skill_id=120013,
            battlefield=self.bf,
            skip_cost=True,
        )

        self.assertTrue(result["success"], f"技能执行应成功: {result.get('error', '')}")

        final_hp = self.target.current_hp
        # 主伤害后HP应仍>70%阈值
        self.assertGreater(
            final_hp, threshold_hp,
            f"无附魔时, 主伤害后HP({final_hp})应大于70%阈值({threshold_hp})"
        )

        # 不应有knockout/stun debuff
        has_stun = any(
            b.effect_type == SkillEffectType.KNOCKOUT.value
            for b in self.target.debuffs
        )
        self.assertFalse(
            has_stun,
            f"无附魔且HP>70%阈值时, 不应有Knockout(stun) debuff, "
            f"实际debuffs: {[(b.effect_type, b.value) for b in self.target.debuffs]}"
        )

    def test_stun_without_enchant_when_hp_below_threshold(self):
        """
        基线测试: 没有附魔伤害, 但主伤害后HP已<70%阈值, 应触发眩晕

        场景:
        - 目标初始HP设为较低值, 使主伤害后HP < 70%阈值
        - 不添加EnchantDamage buff
        - 应触发眩晕
        """
        # 设置目标初始HP为较低值, 使主伤害后HP < 70%阈值
        # 70%阈值 = 1355228, 主伤害约580008
        # 设置初始HP = 1500000, 主伤害后约919992 < 1355228
        self.target.current_hp = 1500000

        # 不添加EnchantDamage buff
        threshold_hp = int(self.target.max_hp * 70 / 100)

        # 执行技能120013
        result = self.ss.execute_skill(
            caster=self.attacker,
            skill_id=120013,
            battlefield=self.bf,
            skip_cost=True,
        )

        self.assertTrue(result["success"], f"技能执行应成功: {result.get('error', '')}")

        final_hp = self.target.current_hp
        # 主伤害后HP应<70%阈值
        self.assertLess(
            final_hp, threshold_hp,
            f"主伤害后HP({final_hp})应小于70%阈值({threshold_hp})"
        )

        # 应有knockout/stun debuff
        has_stun = any(
            b.effect_type == SkillEffectType.KNOCKOUT.value
            for b in self.target.debuffs
        )
        self.assertTrue(
            has_stun,
            f"HP<70%阈值时, 应有Knockout(stun) debuff, "
            f"实际debuffs: {[(b.effect_type, b.value) for b in self.target.debuffs]}"
        )


if __name__ == '__main__':
    unittest.main()
