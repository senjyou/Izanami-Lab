"""在 SkillMaster.json 中直接查找 failed 技能的 Id。"""
import json

with open('split_data/SkillMaster.json', encoding='utf-8') as f:
    skills = json.load(f)

failed_ids = ['210032', '230045', '230053', '230113', '230200', '220329', '230019', '230001']

print(f'=== SkillMaster: {len(skills)} 条 ===')
if skills:
    print('First record keys:', list(skills[0].keys()))
    print()

# 直接查找
for skill in skills:
    sid = str(skill.get('Id') or skill.get('SkillMasterId') or skill.get('id', ''))
    if sid in failed_ids:
        print(f'Found {sid}:')
        print(json.dumps(skill, ensure_ascii=False, indent=2)[:2000])
        print()

# 显示前几条数据
print('=== First 5 records ===')
for skill in skills[:5]:
    print(json.dumps(skill, ensure_ascii=False, indent=2)[:600])
    print()
