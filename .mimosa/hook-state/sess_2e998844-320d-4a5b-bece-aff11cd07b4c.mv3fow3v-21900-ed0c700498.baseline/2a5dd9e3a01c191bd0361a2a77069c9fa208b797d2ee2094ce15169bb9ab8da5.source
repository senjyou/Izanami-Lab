"""快速检查缺测试角色的技能配置情况。"""
import json
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))
from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()

# 加载数据
with open('data/characters.json', 'r', encoding='utf-8') as f:
    chars = json.load(f)
with open('data/character_skills.json', 'r', encoding='utf-8') as f:
    char_skills = json.load(f)

# 缺测试的角色 ID 列表
missing_ids = [
    100201, 101201, 101301, 102201, 102301, 102302, 103201, 103301, 103302,
    104201, 105301, 105302, 107301, 111301, 112302, 113302, 114301, 115301,
    117302, 118301, 120301, 121301, 122201, 124201, 125101, 125301, 126101,
    126301, 127101, 128101, 129302, 130301, 130302, 131302, 132301, 134301,
    135301, 138301, 140301, 141301, 142301, 142302, 144301, 149301, 154301,
]

safe_print(f"=== 缺测试角色技能配置检查（{len(missing_ids)}个）===")
safe_print(f"{'ID':<8} {'name':<30} {'has_skills':<10} {'skill_count':<12}")
safe_print("-" * 70)
no_skill_count = 0
has_skill_count = 0
for cid in missing_ids:
    cid_str = str(cid)
    c = chars.get(cid_str, {})
    name = (c.get('name') or '?')[:28]
    skills_entry = char_skills.get(cid_str)
    if skills_entry is None:
        # 尝试 int key
        skills_entry = char_skills.get(cid)
    has_skills = skills_entry is not None
    skill_count = 0
    if has_skills:
        if isinstance(skills_entry, list):
            skill_count = len(skills_entry)
        elif isinstance(skills_entry, dict):
            skill_count = sum(len(v) if isinstance(v, list) else 1
                              for v in skills_entry.values())
    if has_skills:
        has_skill_count += 1
    else:
        no_skill_count += 1
    safe_print(f"{cid:<8} {name:<30} {str(has_skills):<10} {skill_count:<12}")

safe_print(f"\n有技能配置: {has_skill_count}, 无技能配置: {no_skill_count}")
