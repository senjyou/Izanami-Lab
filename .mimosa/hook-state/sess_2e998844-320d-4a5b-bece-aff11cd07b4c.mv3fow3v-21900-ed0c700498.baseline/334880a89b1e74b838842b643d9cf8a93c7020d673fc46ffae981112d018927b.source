    # ====================================================================
    # Behavior: お餅 mark applied by EX/PS1
    # ====================================================================

    def test_behavior_110041_applies_mochi_mark(self):
        """EX 110041 must apply 1 お餅 mark (buff) to self."""
        caster = _make_unit(
            "caster", "新春のメイズ研究者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[EX_SKILL], skill_levels={EX_SKILL: 10}, pp=4,
            character_type=1, ep=100,
        )
        enemy = _make_unit(
            "enemy", "敵A", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=5000, defense=4000, pp=4,
        )

        bf = _make_bf(caster, enemy)
        ss, _ = self._make_services(bf)

        result = ss.execute_skill(caster, EX_SKILL, bf)
        self.assertTrue(result.get('success', False))

        mochi_marks = [b for b in caster.buffs
                       if b.effect_type == SkillEffectType.MARK.value
                       and getattr(b, 'name', '') == 'お餅']
        self.assertEqual(len(mochi_marks), 1,
                         "EX must apply exactly 1 お餅 mark to self")

    def test_behavior_110041_mochi_mark_is_buff_not_debuff(self):
        """お餅 mark must be stored in buffs (not debuffs) due to is_buff_mark:true."""
        caster = _make_unit(
            "caster", "新春のメイズ研究者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[EX_SKILL], skill_levels={EX_SKILL: 10}, pp=4,
            character_type=1, ep=100,
        )
        enemy = _make_unit(
            "enemy", "敵A", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=5000, defense=4000, pp=4,
        )

        bf = _make_bf(caster, enemy)
        ss, _ = self._make_services(bf)

        result = ss.execute_skill(caster, EX_SKILL, bf)
        self.assertTrue(result.get('success', False))

        mochi_in_buffs = [b for b in caster.buffs
                          if b.effect_type == SkillEffectType.MARK.value
                          and getattr(b, 'name', '') == 'お餅']
        mochi_in_debuffs = [d for d in caster.debuffs
                            if d.effect_type == SkillEffectType.MARK.value
                            and getattr(d, 'name', '') == 'お餅']
        self.assertGreater(len(mochi_in_buffs), 0,
                           "お餅 mark must be in buffs (is_buff_mark=true)")
        self.assertEqual(len(mochi_in_debuffs), 0,
                         "お餅 mark must NOT be in debuffs")

    # ====================================================================
    # Behavior: PS2 130102 cumulative damage threshold trigger
    # ====================================================================

    def test_behavior_130102_triggers_at_40pct_cumulative_damage(self):
        """PS2 130102 must trigger when cumulative_hp_damage >= 40% max_hp."""
        caster = _make_unit(
            "caster", "新春のメイズ研究者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[PS2_SKILL], skill_levels={PS2_SKILL: 10}, pp=4,
        )
        # Set cumulative_hp_damage to exactly 40% threshold (40000)
        caster.cumulative_hp_damage = 40000

        enemy = _make_unit(
            "enemy", "敵A", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=5000, defense=4000, pp=4,
        )

        bf = _make_bf(caster, enemy)
        _, ts = self._make_services(bf)

        actions = ts.trigger_cumulative_damage(bf, damaged_units=[caster])
        ps_actions = [a for a in actions if a.skill_id == PS2_SKILL]
        self.assertEqual(len(ps_actions), 1,
                         "PS2 must trigger when cumulative_hp_damage = 40% max_hp")

    def test_behavior_130102_does_not_trigger_below_threshold(self):
        """PS2 130102 must NOT trigger when cumulative_hp_damage < 40% max_hp."""
        caster = _make_unit(
            "caster", "新春のメイズ研究者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[PS2_SKILL], skill_levels={PS2_SKILL: 10}, pp=4,
        )
        # Set cumulative_hp_damage to 39% (below 40% threshold)
        caster.cumulative_hp_damage = 39999

        enemy = _make_unit(
            "enemy", "敵A", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=5000, defense=4000, pp=4,
        )

        bf = _make_bf(caster, enemy)
        _, ts = self._make_services(bf)

        actions = ts.trigger_cumulative_damage(bf, damaged_units=[caster])
        ps_actions = [a for a in actions if a.skill_id == PS2_SKILL]
        self.assertEqual(len(ps_actions), 0,
                         "PS2 must NOT trigger when cumulative < 40% threshold")

    # ====================================================================
    # Behavior: EX 110041 applies poison to enemies
    # ====================================================================

    def test_behavior_110041_applies_poison_to_all_enemies(self):
        """EX 110041 must apply poison debuff to all enemies."""
        caster = _make_unit(
            "caster", "新春のメイズ研究者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[EX_SKILL], skill_levels={EX_SKILL: 10}, pp=4,
            character_type=1, ep=100,
        )
        enemy1 = _make_unit(
            "enemy1", "敵A", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=5000, defense=4000, pp=4,
        )
        enemy2 = _make_unit(
            "enemy2", "敵B", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
            hp=100000, atk=5000, defense=4000, pp=4,
        )

        bf = _make_bf(caster, enemy1, enemy2)
        ss, _ = self._make_services(bf)

        result = ss.execute_skill(caster, EX_SKILL, bf)
        self.assertTrue(result.get('success', False))

        for enemy in (enemy1, enemy2):
            poisons = [d for d in enemy.debuffs
                       if d.effect_type == SkillEffectType.POISON.value]
            self.assertGreater(len(poisons), 0,
                               f"{enemy.name} must have poison debuff")
            self.assertEqual(poisons[0].duration, 2,
                             "poison duration must be 2 actions")

    # ====================================================================
    # Behavior: AS2 120094 atk_down is stackable
    # ====================================================================

    def test_behavior_120094_atk_down_applied_to_attacked_target(self):
        """AS2 120094 atk_down must be applied to the attacked enemy."""
        caster = _make_unit(
            "caster", "新春のメイズ研究者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=4000, speed=500,
            skills=[AS2_SKILL], skill_levels={AS2_SKILL: 10}, pp=4,
            character_type=1,
        )
        enemy = _make_unit(
            "enemy", "敵A", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=100000, atk=5000, defense=4000, pp=4,
        )

        bf = _make_bf(caster, enemy)
        ss, _ = self._make_services(bf)

        result = ss.execute_skill(caster, AS2_SKILL, bf)
        self.assertTrue(result.get('success', False))

        atk_downs = [d for d in enemy.debuffs
                     if d.effect_type == SkillEffectType.STATUS_ATTACK.value
                     and getattr(d, 'is_debuff', False) is True]
        self.assertGreater(len(atk_downs), 0,
                           "atk_down debuff must be applied to attacked enemy")
        # value should be 5 (percent)
        self.assertAlmostEqual(atk_downs[0].value, 5, places=2,
                               msg="atk_down value should be 5%")


