#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""追撃符 (130051) 技能完整测试

验证目标：
1. 触发条件：仅正前方单位攻击前触发 (非正前方不触发)
2. 效果施加：EnchantDamage + carried_debuff spd_down + crit_rate_up(lv11+)
3. 附加伤害：EnchantDamage 在攻击时正确计算并造成额外伤害
4. 携带式减速：被攻击的敌方单位获得 StatusSpeed debuff
5. 日志：携带式载荷显示为 增益 而非 减益
"""
import sys
import os
import json

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, TriggerTiming, SkillEffectType
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig
from src.combat_v2.battle_narrative import BattleNarrativeWriter
from src.combat_v2.services.trigger_service import TriggerService, TriggerContext
from src.combat_v2.services.aura_service import AuraService

dl = DataLoader()
dl.load_all()

# 混沌の立役者 (character_id=111301) 已载入 character_skills.json，包含追撃符 130051
# 不需要手动注册

# 获取追撃符技能数据
sk = dl.get_skill_by_id(130051)
parsed = dl.get_parsed_skill_data(130051)
print("=" * 60)
print(f"追撃符 ({sk.skill_id}) 技能测试")
print("=" * 60)
print(f"技能名: {sk.name}")
print(f"触发类型: {parsed.get('trigger_type')}")
print(f"效果块数: {len(parsed.get('effect_blocks', []))}")
for block in parsed.get('effect_blocks', []):
    effects = [(e['effect_type'], e.get('target_type'), e.get('flags', {})) for e in block.get('effects', [])]
    print(f"  Block {block['block_id']}: {effects}")

# ============================================================
# 测试1: 触发条件验证 - 正前方 vs 非正前方
# ============================================================
print("\n" + "=" * 60)
print("[测试1] 触发条件验证：正前方单位触发 vs 非正前方不触发")
print("=" * 60)

ts = TriggerService()
ts.set_data_loader(dl)

# 创建3个测试场景
test_cases = [
    {
        "name": "正前方(左后→左前) - 应触发",
        "owner_pos": Position.ALLY_LEFT_BACK,
        "actor_pos": Position.ALLY_LEFT_FRONT,
        "expected": True,
    },
    {
        "name": "非正前方(左后→中前) - 不应触发",
        "owner_pos": Position.ALLY_LEFT_BACK,
        "actor_pos": Position.ALLY_CENTER_FRONT,
        "expected": False,
    },
    {
        "name": "非正前方(左后→右前) - 不应触发",
        "owner_pos": Position.ALLY_LEFT_BACK,
        "actor_pos": Position.ALLY_RIGHT_FRONT,
        "expected": False,
    },
    {
        "name": "非正前方(左后→左后/自身) - 不应触发",
        "owner_pos": Position.ALLY_LEFT_BACK,
        "actor_pos": Position.ALLY_LEFT_BACK,
        "expected": False,
    },
]

for tc in test_cases:
    bf = BattlefieldState()
    owner = UnitState(
        unit_id="owner_test", name="混沌の立役者", side=Side.ALLY,
        position=tc["owner_pos"], character_id=111301, level=200,
        element=1, character_type=2,
        max_hp=100000, current_hp=100000, attack=80000, defense=50000, speed=999,
        crit_rate=0.1, crit_damage=0.0, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[130051], skill_levels={130051: 15}, skill_cooldowns={},
    )
    actor = UnitState(
        unit_id="actor_test", name="触发源", side=Side.ALLY,
        position=tc["actor_pos"], character_id=999999, level=1,
        element=1, character_type=1,
        max_hp=50000, current_hp=50000, attack=5000, defense=3000, speed=800,
        crit_rate=0.1, crit_damage=0.0, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )
    bf.add_unit(owner)
    bf.add_unit(actor)

    ctx = TriggerContext(TriggerTiming.BEFORE_ALLY_AS_ATTACK, bf, actor=actor, skill=99999)
    actions = ts.check_triggers(TriggerTiming.BEFORE_ALLY_AS_ATTACK, ctx)
    triggered = len(actions) > 0
    status = "✓" if triggered == tc["expected"] else "✗ FAIL"
    print(f"  [{status}] {tc['name']}: triggered={triggered} (expected={tc['expected']})")

# ============================================================
# 测试2: 完整战斗流程 - 追撃符效果施加
# ============================================================
print("\n" + "=" * 60)
print("[测试2] 完整战斗流程：追撃符效果施加验证")
print("=" * 60)

bf = BattlefieldState()

# 混沌の立役者 - 左后位 (PS owner)
owner = UnitState(
    unit_id="chaos", name="混沌の立役者", side=Side.ALLY,
    position=Position.ALLY_LEFT_BACK, character_id=111301, level=200,
    element=1, character_type=2,
    max_hp=132990, current_hp=132990, attack=82869, defense=79872, speed=999,
    crit_rate=0.1, crit_damage=0.0, advantage_damage=0.0,
    initial_active_point=4, initial_passive_point=4, max_extra_point=0,
    current_ap=4, current_pp=4, current_ep=0,
    skills=[130051], skill_levels={130051: 15}, skill_cooldowns={},
)
# ノーブル・グレイス - 左前位 (正前方单位，触发源)
front_unit = UnitState(
    unit_id="noble", name="ノーブル・グレイス", side=Side.ALLY,
    position=Position.ALLY_LEFT_FRONT, character_id=121301, level=200,
    element=5, character_type=1,
    max_hp=112464, current_hp=112464, attack=101521, defense=55688, speed=1261,
    crit_rate=0.15, crit_damage=0.0, advantage_damage=0.0,
    initial_active_point=4, initial_passive_point=4, max_extra_point=0,
    current_ap=4, current_pp=4, current_ep=0,
    skills=[], skill_levels={}, skill_cooldowns={},
)
# 世界への反逆者 - 中后位 (非正前方，不应触发追撃符)
other_ally = UnitState(
    unit_id="rebel", name="世界への反逆者", side=Side.ALLY,
    position=Position.ALLY_CENTER_BACK, character_id=999998, level=200,
    element=4, character_type=1,
    max_hp=109160, current_hp=109160, attack=88994, defense=57195, speed=990,
    crit_rate=0.15, crit_damage=0.0, advantage_damage=0.0,
    initial_active_point=4, initial_passive_point=4, max_extra_point=0,
    current_ap=4, current_pp=4, current_ep=0,
    skills=[], skill_levels={}, skill_cooldowns={},
)
# 敌方单位 - 中后位
enemy = UnitState(
    unit_id="enemy", name="フィー・ドレーゼ", side=Side.ENEMY,
    position=Position.ENEMY_CENTER_BACK, character_id=999999, level=1,
    element=3, character_type=1,
    max_hp=300000, current_hp=300000, attack=10000, defense=10000, speed=500,
    crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
    initial_active_point=4, initial_passive_point=4, max_extra_point=0,
    current_ap=4, current_pp=4, current_ep=0,
    skills=[], skill_levels={}, skill_cooldowns={},
)

bf.add_unit(owner)
bf.add_unit(front_unit)
bf.add_unit(other_ally)
bf.add_unit(enemy)

print(f"\n战场布局:")
print(f"  己方: 左前={front_unit.name}, 左后={owner.name}, 中后={other_ally.name}")
print(f"  敌方: 中后={enemy.name}")

# 创建服务
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.skill_service import SkillService

rs = ResourceService()
ts = TriggerService()
ts.set_data_loader(dl)
asvc = AuraService()
dmgsvc = DamageService()
tgtsvc = TargetService()
ss = SkillService(dl, rs, target_service=tgtsvc, damage_service=dmgsvc,
                  aura_service=asvc, trigger_service=ts)
ts.set_skill_service(ss)

# 步骤1: 模拟正前方单位(ノーブル・グレイス)准备AS攻击
# 触发 before_ally_as_attack
ctx = TriggerContext(TriggerTiming.BEFORE_ALLY_AS_ATTACK, bf, actor=front_unit, skill=99999)
trigger_actions = ts.check_triggers(TriggerTiming.BEFORE_ALLY_AS_ATTACK, ctx)

print(f"\n[步骤1] BEFORE_ALLY_AS_ATTACK 触发检查")
print(f"  触发动作数: {len(trigger_actions)}")
assert len(trigger_actions) == 1, f"期望1个触发动作，实际{len(trigger_actions)}"
action = trigger_actions[0]
print(f"  触发技能: {action.skill_id}, 所属: {action.instance.owner.name}")

# 步骤2: 执行追撃符
print(f"\n[步骤2] 执行追撃符")
trigger_attacker = action.parameters.get('trigger_attacker')
ss._trigger_attacker = trigger_attacker
skill_result = ss.execute_skill(caster=owner, skill_id=130051, battlefield=bf, skip_cost=True)
ss._trigger_attacker = None

print(f"  执行结果: success={skill_result.get('success')}")
print(f"  效果数: {len(skill_result.get('effects_applied', []))}")

# 步骤3: 验证追撃符效果施加到正前方单位
print(f"\n[步骤3] 验证正前方单位获得的效果")
print(f"  ノーブル・グレイス buffs ({len(front_unit.buffs)}):")
for b in front_unit.buffs:
    carried = getattr(b, 'hit_limited_flags', {})
    info = f"    {b.effect_type}: value={b.value}, dur={b.duration}, hit_limited={b.hit_limited}"
    if carried.get('carried_debuff'):
        info += f", carried_debuff={carried}"
    print(info)

# 验证 EnchantDamage buff
enchant_buffs = [b for b in front_unit.buffs if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value]
assert len(enchant_buffs) > 0, "✗ 未找到 EnchantDamage buff!"
print(f"  ✓ EnchantDamage buff: {len(enchant_buffs)}个, hit_limited={enchant_buffs[0].hit_limited}")

# 验证 carried_debuff StatusSpeed (应作为buff存在，不是debuff)
carried_spd = [b for b in front_unit.buffs if b.effect_type == SkillEffectType.STATUS_SPEED.value
               and getattr(b, 'hit_limited_flags', {}).get('carried_debuff')]
assert len(carried_spd) > 0, "✗ 未找到携带式减速载荷!"
carried_flags = getattr(carried_spd[0], 'hit_limited_flags', {})
print(f"  ✓ 携带式减速载荷: type={carried_flags.get('carried_debuff_type')}, value={carried_flags.get('carried_debuff_value')}")

# 确认携带式载荷不在debuffs中
front_debuffs_with_spd = [d for d in front_unit.debuffs if d.effect_type == SkillEffectType.STATUS_SPEED.value]
assert len(front_debuffs_with_spd) == 0, f"✗ 正前方单位不应有 StatusSpeed debuff! 实际有{len(front_debuffs_with_spd)}个"
print(f"  ✓ 正前方单位无 StatusSpeed debuff (载荷以buff形式存储)")

# 验证 crit_rate_up (lv11+)
crit_buffs = [b for b in front_unit.buffs if b.effect_type == SkillEffectType.STATUS_CRITICAL_CHANCE.value]
assert len(crit_buffs) > 0, "✗ 未找到 crit_rate_up buff (lv11+)!"
print(f"  ✓ crit_rate_up buff: {len(crit_buffs)}个, stackable={crit_buffs[0].is_stackable}")

# ============================================================
# 测试3: 附加伤害和携带式减速验证
# ============================================================
print("\n" + "=" * 60)
print("[测试3] 附加伤害(EnchantDamage)和携带式减速(carried_debuff)验证")
print("=" * 60)

# 模拟正前方单位攻击敌方
print(f"\n[步骤4] 正前方单位攻击敌方")
print(f"  攻击前 敌方 HP: {enemy.current_hp}/{enemy.max_hp}")
print(f"  攻击前 敌方 debuffs: {len(enemy.debuffs)}")

# 使用 skill_service 的 _process_enchant_damage 直接测试
targets_hit = [{"target_id": enemy.unit_id, "crit": False}]
total_dmg, enchant_results, carried_debuff_results = ss._process_enchant_damage(front_unit, targets_hit, bf, 0)

print(f"\n[步骤5] 验证附加伤害")
print(f"  附加伤害结果数: {len(enchant_results)}")
assert len(enchant_results) > 0, "✗ 附加伤害未产生!"
for er in enchant_results:
    print(f"    target={er['target']}, damage={er['actual_damage']}, hp_before={er['hp_before']}, hp_after={er['hp_after']}")
    assert er['actual_damage'] > 0, "✗ 附加伤害为0!"
    print(f"  ✓ 附加伤害: {er['actual_damage']} 点")
print(f"  攻击后 敌方 HP: {enemy.current_hp}/{enemy.max_hp}")

print(f"\n[步骤6] 验证携带式减速")
# 检查敌方是否获得了 StatusSpeed debuff
enemy_spd_debuffs = [d for d in enemy.debuffs if d.effect_type == SkillEffectType.STATUS_SPEED.value]
assert len(enemy_spd_debuffs) > 0, "✗ 敌方未获得 StatusSpeed 减速 debuff!"
print(f"  ✓ 敌方 StatusSpeed debuff: value={enemy_spd_debuffs[0].value}, dur={enemy_spd_debuffs[0].duration}")

# 验证正前方单位的EnchantDamage buff已被消耗
enchant_after = [b for b in front_unit.buffs if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value]
assert len(enchant_after) == 0, f"✗ EnchantDamage buff 应已被消耗! 实际还有{len(enchant_after)}个"
print(f"  ✓ EnchantDamage buff 已消耗 (hit_limited=0)")

# 验证携带式减速载荷已被消耗
carried_after = [b for b in front_unit.buffs if b.effect_type == SkillEffectType.STATUS_SPEED.value
                 and getattr(b, 'hit_limited_flags', {}).get('carried_debuff')]
assert len(carried_after) == 0, f"✗ 携带式减速载荷应已被消耗! 实际还有{len(carried_after)}个"
print(f"  ✓ 携带式减速载荷已消耗 (hit_limited=0)")

# ============================================================
# 测试4: 非正前方单位不应触发追撃符
# ============================================================
print("\n" + "=" * 60)
print("[测试4] 非正前方单位(中后位)攻击前不应触发追撃符")
print("=" * 60)

# 重置条件
ctx = TriggerContext(TriggerTiming.BEFORE_ALLY_AS_ATTACK, bf, actor=other_ally, skill=99999)
trigger_actions = ts.check_triggers(TriggerTiming.BEFORE_ALLY_AS_ATTACK, ctx)
assert len(trigger_actions) == 0, f"✗ 非正前方单位不应触发追撃符! 实际触发了{len(trigger_actions)}个"
print(f"  ✓ 非正前方单位(中后位)攻击前未触发追撃符")

# ============================================================
# 测试5: 日志验证 - 携带式载荷应显示为增益
# ============================================================
print("\n" + "=" * 60)
print("[测试5] 日志验证：携带式载荷显示为增益")
print("=" * 60)

# 检查 skill_result 中 aura 的 is_debuff 字段
for applied in skill_result.get("effects_applied", []):
    if applied.get("effect_type") == "aura":
        for a in applied.get("auras", []):
            if a['effect'] == 'StatusSpeed':
                is_debuff = applied.get("is_debuff", None)
                print(f"  StatusSpeed aura: is_debuff={is_debuff}")
                assert is_debuff == False, f"✗ 携带式载荷 is_debuff 应为 False! 实际为 {is_debuff}"
                print(f"  ✓ 携带式载荷 is_debuff=False (日志将显示为增益)")

# ============================================================
# 测试6: 敌方被主伤害击杀时，附加伤害仍应生效
# ============================================================
print("\n" + "=" * 60)
print("[测试6] 敌方被主伤害击杀时，附加伤害仍应触发")
print("=" * 60)

# 重建战场
bf2 = BattlefieldState()
owner2 = UnitState(
    unit_id="chaos2", name="混沌の立役者", side=Side.ALLY,
    position=Position.ALLY_LEFT_BACK, character_id=111301, level=200,
    element=1, character_type=2,
    max_hp=132990, current_hp=132990, attack=82869, defense=79872, speed=999,
    crit_rate=0.1, crit_damage=0.0, advantage_damage=0.0,
    initial_active_point=4, initial_passive_point=4, max_extra_point=0,
    current_ap=4, current_pp=4, current_ep=0,
    skills=[130051], skill_levels={130051: 15}, skill_cooldowns={},
)
front2 = UnitState(
    unit_id="noble2", name="ノーブル・グレイス", side=Side.ALLY,
    position=Position.ALLY_LEFT_FRONT, character_id=121301, level=200,
    element=5, character_type=1,
    max_hp=112464, current_hp=112464, attack=101521, defense=55688, speed=1261,
    crit_rate=0.15, crit_damage=0.0, advantage_damage=0.0,
    initial_active_point=4, initial_passive_point=4, max_extra_point=0,
    current_ap=4, current_pp=4, current_ep=0,
    skills=[], skill_levels={}, skill_cooldowns={},
)
enemy2 = UnitState(
    unit_id="enemy2", name="フィー・ドレーゼ", side=Side.ENEMY,
    position=Position.ENEMY_CENTER_BACK, character_id=999999, level=1,
    element=3, character_type=1,
    max_hp=300000, current_hp=300000, attack=10000, defense=10000, speed=500,
    crit_rate=0.05, crit_damage=0.0, advantage_damage=0.0,
    initial_active_point=4, initial_passive_point=4, max_extra_point=0,
    current_ap=4, current_pp=4, current_ep=0,
    skills=[], skill_levels={}, skill_cooldowns={},
)
bf2.add_unit(owner2)
bf2.add_unit(front2)
bf2.add_unit(enemy2)

ss.set_battlefield(bf2)

# 应用追撃符
ctx2 = TriggerContext(TriggerTiming.BEFORE_ALLY_AS_ATTACK, bf2, actor=front2, skill=99999)
trigger_actions2 = ts.check_triggers(TriggerTiming.BEFORE_ALLY_AS_ATTACK, ctx2)
assert len(trigger_actions2) == 1, "应触发追撃符"
action2 = trigger_actions2[0]
ss._trigger_attacker = action2.parameters.get('trigger_attacker')
ss.execute_skill(caster=owner2, skill_id=130051, battlefield=bf2, skip_cost=True)
ss._trigger_attacker = None

# 验证 buff 存在
enchant_buffs_pre = [b for b in front2.buffs if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value]
assert len(enchant_buffs_pre) == 1, "应有 EnchantDamage buff"
print(f"  EnchantDamage buff 已施加: value={enchant_buffs_pre[0].value:.1f}")

# 模拟敌方已被主伤害击杀 (HP=0, is_alive=False)
hp_before_kill = enemy2.current_hp
enemy2.current_hp = 0
enemy2.is_alive = False
print(f"  模拟主伤害击杀: 敌方 HP {hp_before_kill} → 0 (is_alive=False)")

# 调用 _process_enchant_damage，target_info 中 hp_before 应为击杀前的HP
targets_hit = [{"target_id": enemy2.unit_id, "crit": False, "hp_before": hp_before_kill}]
total_dmg, enchant_results, carried_debuff_results = ss._process_enchant_damage(front2, targets_hit, bf2, 0)

print(f"\n[验证] 敌方死亡时附加伤害")
print(f"  附加伤害结果数: {len(enchant_results)}")
assert len(enchant_results) > 0, "✗ 敌方死亡时附加伤害应仍然产生!"
for er in enchant_results:
    print(f"    target={er['target']}, damage={er['actual_damage']}, hp_before={er['hp_before']}, hp_after={er['hp_after']}")
    assert er['actual_damage'] > 0, "✗ 附加伤害为0!"
    print(f"  ✓ 附加伤害: {er['actual_damage']} 点 (敌方已死亡，伤害计入总伤害统计)")

# 验证 EnchantDamage buff 已消耗
enchant_after = [b for b in front2.buffs if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value]
assert len(enchant_after) == 0, f"✗ EnchantDamage buff 应已被消耗!"
print(f"  ✓ EnchantDamage buff 已消耗")

# ============================================================
# 汇总
# ============================================================
print("\n" + "=" * 60)
print("所有测试通过! ✓")
print("=" * 60)
print("""
验证结果:
  [测试1] 触发条件: 仅正前方单位触发 ✓
  [测试2] 效果施加: EnchantDamage + carried_debuff + crit_rate_up ✓
  [测试3] 附加伤害: EnchantDamage 正确计算 ✓
  [测试3] 携带式减速: 敌方获得 StatusSpeed debuff ✓
  [测试4] 非正前方: 不触发追撃符 ✓
  [测试5] 日志: 携带式载荷显示为增益 ✓
  [测试6] 敌方死亡: 附加伤害仍触发并计入总伤害 ✓
""")