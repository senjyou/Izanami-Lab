"""
角色150301 スタチュービューティー（ステラ・ブレーメル）专项测试
- EX: 110065 極夜のマスカレード（味方全体回避buff + 敵全体惑光mark + Lv11+デバフ解除+無効）
- AS1: 120145 ブラックアウト・ラビリンス（敵横一列に暗闇付与 + Lv11+味方全体会心率上昇）
- AS2: 120146 オーロラとの戯れ（敵単体攻撃 + 惑光所持時增傷 + 自身回避buff）
- PS1: 130145 ベルセルクの洗礼（自身被攻撃後反撃 + 不足HP回復 + 氷結と同タイミング排斥）
- PS2: 130146 氷結のシンフォニー（惑光所持敵HP≤50%時触发 + HP比例傷害 + 攻撃後解除惑光）

新机制：
- 暗闇（Darkness）：ATTACKER侧debuff，per-skill判定，无视sure_hit，不消耗EVADE buff
- 惑光（Wakou）：角色专属mark，skip_if_exists付与，永続duration=-1
- exclusive_group="stella_ps"：130145/130146互相排斥
"""
import unittest
import sys
import os
import random

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
DARKNESS = SkillEffectType.DARKNESS.value
MARK = SkillEffectType.MARK.value
EVADE = SkillEffectType.EVADE.value
SURE_HIT = SkillEffectType.SURE_HIT.value
CRIT_RATE_UP = SkillEffectType.STATUS_CRITICAL_CHANCE.value
# debuff_immune直接使用字符串，不映射到SkillEffectType枚举
DEBUFF_IMMUNE = "debuff_immune"


class TestActor150301(unittest.TestCase):
    """角色150301 スタチュービューティー 专项测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 150301 ステラ (风属性, 敏捷型, 后排, 控制型)
        self.caster = UnitState(
            unit_id="ally_back", name="スタチュービューティー", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=150301, level=10,
            element=3, character_type=3,
            max_hp=18000, current_hp=12000,  # 不足HP用于测试130145回復
            attack=9000, defense=4000, speed=520,
            crit_rate=0.10, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=8,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110065, 120145, 120146, 130145, 130146],
            skill_levels={110065: 10, 120145: 10, 120146: 10, 130145: 10, 130146: 10},
            skill_cooldowns={},
        )

        # 友方前排
        self.ally_front = UnitState(
            unit_id="ally_front", name="友方前排", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999100, level=10,
            element=2, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=5000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央（主目标）
        self.enemy_front = UnitState(
            unit_id="enemy_front", name="敌方前排", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=5000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前
        self.enemy_left_front = UnitState(
            unit_id="enemy_left_front", name="敌方左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=4, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=4500, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前
        self.enemy_right_front = UnitState(
            unit_id="enemy_right_front", name="敌方右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=5, character_type=2,
            max_hp=12000, current_hp=12000,
            attack=5000, defense=3000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=1,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.ally_front, self.caster]
        self.bf.enemy_team = [
            self.enemy_front, self.enemy_left_front, self.enemy_right_front,
        ]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    # ─── EX: 極夜のマスカレード (110065) ───

    def test_ex_perfect_evasion_buff_granted(self):
        """EX(110065) 付与味方全体回避buff"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110065, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 味方前排应有EVADE buff
        evade_buffs = [b for b in self.ally_front.buffs if b.effect_type == EVADE]
        self.assertTrue(len(evade_buffs) > 0, "味方前排应获得回避buff")
        evade_buffs_caster = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertTrue(len(evade_buffs_caster) > 0, "施法者自身也应获得回避buff")

    def test_ex_wakou_mark_granted_to_all_enemies(self):
        """EX(110065) 对敵全体付与惑光mark"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110065, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        for enemy in [self.enemy_front, self.enemy_left_front, self.enemy_right_front]:
            marks = [b for b in enemy.debuffs + enemy.buffs
                     if b.effect_type == MARK and b.name == "惑光"]
            self.assertEqual(len(marks), 1, "%s 应持有一个惑光mark" % enemy.name)

    def test_ex_wakou_mark_skip_if_exists(self):
        """EX(110065) 惑光markのskip_if_exists：既有所持時不再付与"""
        # 预先付与惑光mark（使用timing_type=4 DURABLE_TARGET_MANEUVER_END，避免被EPHEMERAL_SKILL_END清除）
        existing_mark = BuffState(
            buff_id="existing_wakou", name="惑光",
            effect_type=MARK, value=0,
            duration=-1, timing_type=4,
        )
        self.enemy_front.debuffs.append(existing_mark)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110065, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 应仍只有1个惑光mark
        marks = [b for b in self.enemy_front.debuffs + self.enemy_front.buffs
                 if b.effect_type == MARK and b.name == "惑光"]
        self.assertEqual(len(marks), 1, "已持有惑光时应不再付与")

    # ─── AS1: ブラックアウト・ラビリンス (120145) ───

    def test_as1_darkness_debuff_granted(self):
        """AS1(120145) 敵横一列に暗闇付与"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120145, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 敵方前排（3体）应被付与暗闇
        for enemy in [self.enemy_front, self.enemy_left_front, self.enemy_right_front]:
            darkness_buffs = [d for d in enemy.debuffs if d.effect_type == DARKNESS]
            self.assertTrue(len(darkness_buffs) > 0, "%s 应被付与暗闇" % enemy.name)
            # 验证is_darkness标志位同步
            self.assertTrue(getattr(enemy, 'is_darkness', False),
                            "%s 的is_darkness标志位应同步为True" % enemy.name)

    def test_as1_darkness_miss_rate(self):
        """AS1(120145) 暗闇状態の攻撃者は指定確率でMISS"""
        # 给敌方前排付与暗闇（100% MISS率用于确定性测试）
        darkness_buff = BuffState(
            buff_id="test_darkness_100", name="暗闇",
            effect_type=DARKNESS, value=100.0,
            duration=2, timing_type=1,
        )
        self.enemy_front.debuffs.append(darkness_buff)
        self.enemy_front.is_darkness = True

        # 构造skill_data对象
        skill_data = type('obj', (object,), {
            'power': 100.0, 'hit_count': 1, 'element': 2,
            'ignore_defense': 0, 'ignore_shield': 0,
            'hp_scaling_bonus': 0, 'cannot_crit': False, 'force_crit': False,
            'bonus_crit_rate': 0.0, 'skill_id': 0, 'name': 'test_darkness',
            'base_value_source': None,
        })()

        random.seed(42)
        result = self.dms.calculate_damage(
            attacker=self.enemy_front,
            defender=self.ally_front,
            skill_data=skill_data,
        )
        # 100%暗闇 → 必定MISS → total_damage=0
        self.assertEqual(result.total_damage, 0, "100%暗闇时应造成0伤害")
        self.assertTrue(any(result.hit_evades), "暗闇MISS时hit_evades应为True")

    def test_as1_darkness_ignores_sure_hit(self):
        """AS1(120145) 暗闇無視必中buff"""
        # 给攻击者同时付与暗闇(100%)和必中
        darkness_buff = BuffState(
            buff_id="test_darkness_surehit", name="暗闇",
            effect_type=DARKNESS, value=100.0,
            duration=2, timing_type=1,
        )
        sure_hit_buff = BuffState(
            buff_id="test_sure_hit", name="必中",
            effect_type=SURE_HIT, value=0,
            duration=2, timing_type=1,
        )
        self.enemy_front.debuffs.append(darkness_buff)
        self.enemy_front.buffs.append(sure_hit_buff)
        self.enemy_front.is_darkness = True

        skill_data = type('obj', (object,), {
            'power': 100.0, 'hit_count': 1, 'element': 2,
            'ignore_defense': 0, 'ignore_shield': 0,
            'hp_scaling_bonus': 0, 'cannot_crit': False, 'force_crit': False,
            'bonus_crit_rate': 0.0, 'skill_id': 0, 'name': 'test_darkness_sh',
            'base_value_source': None,
        })()

        random.seed(123)
        result = self.dms.calculate_damage(
            attacker=self.enemy_front,
            defender=self.ally_front,
            skill_data=skill_data,
        )
        # 即使有必中，100%暗闇仍应MISS
        self.assertEqual(result.total_damage, 0,
                         "暗闇应无视必中，100%暗闇时伤害应为0")
        self.assertTrue(any(result.hit_evades),
                        "暗闇MISS时应标记hit_evades")

    def test_as1_darkness_does_not_consume_evade(self):
        """AS1(120145) 暗闇MISS不消耗防御者EVADE buff"""
        # 给攻击者付与100%暗闇
        darkness_buff = BuffState(
            buff_id="test_darkness_noevade", name="暗闇",
            effect_type=DARKNESS, value=100.0,
            duration=2, timing_type=1,
        )
        self.enemy_front.debuffs.append(darkness_buff)
        self.enemy_front.is_darkness = True

        # 给防御者付与EVADE buff (hit_limited=1)
        evade_buff = BuffState(
            buff_id="test_evade", name="回避",
            effect_type=EVADE, value=50.0,
            duration=1, timing_type=1, hit_limited=1,
        )
        self.ally_front.buffs.append(evade_buff)

        skill_data = type('obj', (object,), {
            'power': 100.0, 'hit_count': 1, 'element': 2,
            'ignore_defense': 0, 'ignore_shield': 0,
            'hp_scaling_bonus': 0, 'cannot_crit': False, 'force_crit': False,
            'bonus_crit_rate': 0.0, 'skill_id': 0, 'name': 'test_darkness_evade',
            'base_value_source': None,
        })()

        random.seed(456)
        result = self.dms.calculate_damage(
            attacker=self.enemy_front,
            defender=self.ally_front,
            skill_data=skill_data,
        )
        # 100%暗闇 → MISS
        self.assertEqual(result.total_damage, 0)
        # EVADE buff不应被消耗（仍存在于buffs列表）
        evade_after = [b for b in self.ally_front.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evade_after), 1, "暗闇MISS不应消耗EVADE buff")

    # ─── AS2: オーロラとの戯れ (120146) ───

    def test_as2_damage_and_self_evade(self):
        """AS2(120146) 造成伤害并赋予自身回避buff"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120146, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 应造成伤害
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "应造成伤害")
        # 自身应有EVADE buff
        evade_buffs = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertTrue(len(evade_buffs) > 0, "自身应获得回避buff")

    def test_as2_wakou_bonus_damage(self):
        """AS2(120146) 惑光所持目標への增傷"""
        # 先对enemy_front付与惑光mark（timing_type=4避免被EPHEMERAL_SKILL_END清除）
        wakou_mark = BuffState(
            buff_id="test_wakou_bonus", name="惑光",
            effect_type=MARK, value=0,
            duration=-1, timing_type=4,
        )
        self.enemy_front.debuffs.append(wakou_mark)

        # 带惑光的伤害
        random.seed(789)
        result_with_mark = self.ss.execute_skill(
            caster=self.caster, skill_id=120146, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_with_mark["success"])
        dmg_with = self.enemy_front.max_hp - self.enemy_front.current_hp

        # 重置敌方HP，移除mark
        self.enemy_front.current_hp = self.enemy_front.max_hp
        self.enemy_front.debuffs.remove(wakou_mark)

        # 不带惑光的伤害
        random.seed(789)
        result_without = self.ss.execute_skill(
            caster=self.caster, skill_id=120146, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_without["success"])
        dmg_without = self.enemy_front.max_hp - self.enemy_front.current_hp

        # 惑光所持時の傷害应更高（dmg_tag=25% at Lv10）
        self.assertGreater(dmg_with, dmg_without,
                           "惑光所持目標への傷害应高于無惑光時（增傷25%）")

    def test_as2_evade_buff_has_probability_value(self):
        """AS2(120146) 回避buff的value字段应从value_tag='buff'解析为60.0（Lv1固定值）"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120146, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        evade_buffs = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertTrue(len(evade_buffs) > 0, "应获得回避buff")
        # skills.json中120146的buff tag: interpolation_mode=1, level1=60.0
        # caster技能等级为10，但interpolation_mode=1（固定值）所以仍为60.0
        self.assertAlmostEqual(evade_buffs[0].value, 60.0, places=1,
                               msg="回避buff的value应为60.0（概率回避60%）")

    def test_as2_evade_success_consumes_hit_limited(self):
        """AS2(120146) 概率回避成功时消耗hit_limited，伤害为0"""
        # 执行120146获得回避buff
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120146, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        evade_buffs = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evade_buffs), 1)
        self.assertEqual(evade_buffs[0].hit_limited, 1)
        self.assertAlmostEqual(evade_buffs[0].value, 60.0, places=1)

        # 构造skill_data让敌方攻击caster（caster持回避buff）
        skill_data = type('obj', (object,), {
            'power': 100.0, 'hit_count': 1, 'element': 2,
            'ignore_defense': 0, 'ignore_shield': 0,
            'hp_scaling_bonus': 0, 'cannot_crit': False, 'force_crit': False,
            'bonus_crit_rate': 0.0, 'skill_id': 0, 'name': 'test_evade_prob',
            'base_value_source': None,
        })()

        # 通过控制random.seed使60%概率回避成功
        # random.random() * 100 < 60.0 → 需要 random.random() < 0.6
        # seed=1时 random.random()=0.134 < 0.6 → 回避成功
        hp_before = self.caster.current_hp
        random.seed(1)
        dmg_result = self.dms.calculate_damage(
            attacker=self.enemy_front,
            defender=self.caster,
            skill_data=skill_data,
        )
        # 回避成功：伤害为0
        self.assertEqual(dmg_result.total_damage, 0, "60%概率回避成功时应造成0伤害")
        self.assertTrue(any(dmg_result.hit_evades), "回避成功时hit_evades应为True")
        # caster HP不应减少
        self.assertEqual(self.caster.current_hp, hp_before, "回避成功时HP不应减少")
        # hit_limited应被消耗（1→0），buff应被移除
        evade_after = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evade_after), 0, "回避成功后hit_limited耗尽，buff应被移除")

    def test_as2_evade_fail_keeps_hit_limited(self):
        """AS2(120146) 概率回避失败时不消耗hit_limited，伤害正常"""
        # 执行120146获得回避buff
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120146, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        evade_buffs = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evade_buffs), 1)
        self.assertEqual(evade_buffs[0].hit_limited, 1)

        # 构造skill_data让敌方攻击caster
        skill_data = type('obj', (object,), {
            'power': 100.0, 'hit_count': 1, 'element': 2,
            'ignore_defense': 0, 'ignore_shield': 0,
            'hp_scaling_bonus': 0, 'cannot_crit': False, 'force_crit': False,
            'bonus_crit_rate': 0.0, 'skill_id': 0, 'name': 'test_evade_fail',
            'base_value_source': None,
        })()

        # 通过控制random.seed使60%概率回避失败
        # random.random() * 100 < 60.0 → 需要 random.random() < 0.6
        # seed=2时 random.random()=0.956 > 0.6 → 回避失败
        random.seed(2)
        dmg_result = self.dms.calculate_damage(
            attacker=self.enemy_front,
            defender=self.caster,
            skill_data=skill_data,
        )
        # 回避失败：伤害正常
        self.assertGreater(dmg_result.total_damage, 0, "回避失败时应造成正常伤害")
        self.assertFalse(any(dmg_result.hit_evades), "回避失败时hit_evades应为False")
        # hit_limited不消耗，buff仍存在
        evade_after = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evade_after), 1, "回避失败时buff不应被移除")
        self.assertEqual(evade_after[0].hit_limited, 1, "回避失败时hit_limited不消耗")

    def test_ex_evade_buff_value_scales_with_level(self):
        """EX(110065) 回避buff的value随等级变化（Lv1=65%, Lv10=80%, Lv15=100%）"""
        # skills.json中110065的buff tag:
        #   level 1=65.0, level 10=80.0, level 15=100.0 (interpolation_mode=2)
        # 当前caster等级为10，应解析为80.0
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110065, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # caster自身应有EVADE buff（self_and_friends）
        evade_buffs = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertTrue(len(evade_buffs) > 0, "EX应赋予自身回避buff")
        # Lv10 → 80.0%
        self.assertAlmostEqual(evade_buffs[0].value, 80.0, places=1,
                               msg="Lv10时EX回避buff value应为80.0（80%概率回避）")

    def test_ex_evade_lv15_100_percent(self):
        """EX(110065) Lv15时回避概率100%，必定回避"""
        # 修改caster技能等级为15
        self.caster.skill_levels[110065] = 15
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110065, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        evade_buffs = [b for b in self.caster.buffs if b.effect_type == EVADE]
        self.assertTrue(len(evade_buffs) > 0)
        # Lv15 → 100.0%
        self.assertAlmostEqual(evade_buffs[0].value, 100.0, places=1)

        # 100%回避必定成功
        skill_data = type('obj', (object,), {
            'power': 100.0, 'hit_count': 1, 'element': 2,
            'ignore_defense': 0, 'ignore_shield': 0,
            'hp_scaling_bonus': 0, 'cannot_crit': False, 'force_crit': False,
            'bonus_crit_rate': 0.0, 'skill_id': 0, 'name': 'test_ex_100pct',
            'base_value_source': None,
        })()
        random.seed(999)  # 任意seed，100%必中
        dmg_result = self.dms.calculate_damage(
            attacker=self.enemy_front,
            defender=self.caster,
            skill_data=skill_data,
        )
        self.assertEqual(dmg_result.total_damage, 0, "100%回避必定成功")
        self.assertTrue(any(dmg_result.hit_evades))

    def test_evade_backward_compatible_value_zero(self):
        """向后兼容：value=0（未配置value_tag）的EVADE buff应100%回避"""
        # 直接创建一个value=0的EVADE buff（模拟旧配置）
        evade_buff = BuffState(
            buff_id="test_legacy_evade", name="回避",
            effect_type=EVADE, value=0,
            duration=1, timing_type=1, hit_limited=1,
        )
        self.ally_front.buffs.append(evade_buff)

        skill_data = type('obj', (object,), {
            'power': 100.0, 'hit_count': 1, 'element': 2,
            'ignore_defense': 0, 'ignore_shield': 0,
            'hp_scaling_bonus': 0, 'cannot_crit': False, 'force_crit': False,
            'bonus_crit_rate': 0.0, 'skill_id': 0, 'name': 'test_legacy',
            'base_value_source': None,
        })()
        random.seed(777)
        dmg_result = self.dms.calculate_damage(
            attacker=self.enemy_front,
            defender=self.ally_front,
            skill_data=skill_data,
        )
        # value=0 → 默认100%回避（向后兼容）
        self.assertEqual(dmg_result.total_damage, 0, "value=0应默认100%回避（向后兼容）")
        self.assertTrue(any(dmg_result.hit_evades))

    # ─── PS1: ベルセルクの洗礼 (130145) ───

    def test_ps1_config_valid(self):
        """PS1(130145) 配置验证：trigger_type=after_self_attacked, exclusive_group=stella_ps"""
        p = self.dl.get_parsed_skill_data(130145)
        self.assertIsNotNone(p, "130145 parsed data应存在")
        self.assertEqual(p.get('trigger_type'), 'after_self_attacked')
        self.assertEqual(p.get('global_condition'), {'type': 'target_is_self'})
        self.assertEqual(p.get('exclusive_group'), 'stella_ps')
        # 验证effect包含damage(trigger_attacker)和heal(lost_hp)
        effects = p['effect_blocks'][0]['effects']
        dmg_eff = [e for e in effects if e['effect_type'] == 'damage']
        self.assertEqual(len(dmg_eff), 1)
        self.assertEqual(dmg_eff[0]['target_identifier'], 'trigger_attacker')
        self.assertEqual(dmg_eff[0]['flags'].get('value_source'), 'received_damage')
        heal_eff = [e for e in effects if e['effect_type'] == 'heal']
        self.assertEqual(len(heal_eff), 1)
        self.assertEqual(heal_eff[0]['flags'].get('heal_base'), 'lost_hp')

    def test_ps1_counter_attack_damage(self):
        """PS1(130145) 反撃伤害 = 受击伤害 × dmg%"""
        # 手动构造trigger action并执行
        # 先让敌方攻击ステラ，造成5000伤害
        initial_hp = self.caster.current_hp
        self.caster.current_hp = max(1, initial_hp - 5000)
        received_damage = 5000

        # 设置trigger context
        self.ts._simultaneous_limit_triggered_in_phase = False
        self.ts._exclusive_group_triggered = set()

        # 执行PS: 130145
        # 通过trigger_service.trigger_after_self_attacked触发
        actions = self.ts.trigger_after_self_attacked(
            targets=[self.caster],
            battlefield=self.bf,
            actor=self.enemy_front,  # 攻击者
            primary_target=self.caster,
            triggered_by=self.caster,
        )

        # 验证PS被触发（至少返回1个action）
        # 注意：trigger只返回候选action，实际执行需battle_flow_controller
        # 这里验证trigger候选匹配
        if actions:
            stella_actions = [a for a in actions if a.skill_id == 130145]
            self.assertTrue(len(stella_actions) > 0,
                            "130145应在自身被攻撃後触発")

    # ─── PS2: 氷結のシンフォニー (130146) ───

    def test_ps2_config_valid(self):
        """PS2(130146) 配置验证：trigger_type=on_hp_below, mark_name=惑光, exclusive_group=stella_ps"""
        p = self.dl.get_parsed_skill_data(130146)
        self.assertIsNotNone(p, "130146 parsed data应存在")
        self.assertEqual(p.get('trigger_type'), 'on_hp_below')
        gc = p.get('global_condition')
        self.assertEqual(gc.get('type'), 'enemy_hp_percent')
        self.assertEqual(gc.get('operator'), '<=')
        self.assertEqual(gc.get('value'), 50)
        self.assertEqual(gc.get('mark_name'), '惑光')
        self.assertEqual(p.get('exclusive_group'), 'stella_ps')
        # 验证effect包含hp_ratio_damage(primary_target)和remove_mark(primary_target)
        effects = p['effect_blocks'][0]['effects']
        hp_dmg = [e for e in effects if e['effect_type'] == 'hp_ratio_damage']
        self.assertEqual(len(hp_dmg), 1)
        self.assertEqual(hp_dmg[0]['target_identifier'], 'primary_target')
        self.assertEqual(hp_dmg[0]['flags'].get('damage_cap_atk_pct'), 150)
        rm_mark = [e for e in effects if e['effect_type'] == 'remove_mark']
        self.assertEqual(len(rm_mark), 1)
        self.assertEqual(rm_mark[0]['target_identifier'], 'primary_target')
        self.assertEqual(rm_mark[0]['flags'].get('mark_name'), '惑光')
        self.assertTrue(rm_mark[0]['flags'].get('remove_all'))

    def test_ps2_hp_ratio_damage_with_cap(self):
        """PS2(130146) HP比例傷害 + ATK上限"""
        # 对enemy_front付与惑光mark（timing_type=4避免被EPHEMERAL_SKILL_END清除）
        wakou_mark = BuffState(
            buff_id="test_wakou_ps2", name="惑光",
            effect_type=MARK, value=0,
            duration=-1, timing_type=4,
        )
        self.enemy_front.debuffs.append(wakou_mark)

        # 设置HP≤50%
        self.enemy_front.current_hp = 8000  # 40% of 20000

        # 设置primary_target
        self.ss._primary_target = self.enemy_front

        # 执行PS: 130146
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130146, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证造成伤害
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "hp_ratio_damage"]
        self.assertTrue(len(dmg_effects) > 0, "应造成HP比例傷害")

        # 验证惑光mark被解除
        marks_after = [b for b in self.enemy_front.debuffs + self.enemy_front.buffs
                       if b.effect_type == MARK and b.name == "惑光"]
        self.assertEqual(len(marks_after), 0, "攻撃後応解除全部惑光mark")

    def test_ps2_hp_ratio_damage_capped_by_atk(self):
        """PS2(130146) HP比例傷害不超過自身ATK×150%"""
        # 对enemy_front付与惑光mark（timing_type=4避免被EPHEMERAL_SKILL_END清除）
        wakou_mark = BuffState(
            buff_id="test_wakou_cap", name="惑光",
            effect_type=MARK, value=0,
            duration=-1, timing_type=4,
        )
        self.enemy_front.debuffs.append(wakou_mark)

        # 设置HP很高但≤50%（避免HP太高导致HP比例傷害超过ATK上限时无法区分）
        # max_hp=20000, current_hp=10000 (50%)
        self.enemy_front.current_hp = 10000

        # caster ATK=9000, 上限=9000*150%=13500
        # HP比例傷害 = 10000 * 70%(Lv10) = 7000 < 13500 → 不触发上限
        # 改为HP=15000(75%)但需≤50%，所以用max_hp=40000 current_hp=18000(45%)
        self.enemy_front.max_hp = 40000
        self.enemy_front.current_hp = 18000  # 45%
        # HP比例傷害 = 18000 * 70% = 12600 < 13500 → 仍不触发上限
        # 改为HP=20000(50%) of max_hp=40000
        self.enemy_front.current_hp = 20000
        # HP比例傷害 = 20000 * 70% = 14000 > 13500 → 触发上限

        self.ss._primary_target = self.enemy_front

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130146, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 傷害不超過13500
        hp_loss = 20000 - self.enemy_front.current_hp
        self.assertLessEqual(hp_loss, 13500,
                             "HP比例傷害応被自身ATK×150%上限限制（≤13500）")
        self.assertGreater(hp_loss, 0, "应造成傷害")

    # ─── exclusive_group 互斥测试 ───

    def test_exclusive_group_stella_ps(self):
        """130145/130146 exclusive_group=stella_ps 互斥"""
        p145 = self.dl.get_parsed_skill_data(130145)
        p146 = self.dl.get_parsed_skill_data(130146)
        self.assertEqual(p145.get('exclusive_group'), 'stella_ps')
        self.assertEqual(p146.get('exclusive_group'), 'stella_ps')
        # 两者都不应设simultaneous_limit（exclusive_group独立机制）
        self.assertFalse(p145.get('simultaneous_limit'),
                         "130145不应设simultaneous_limit（使用exclusive_group）")
        self.assertFalse(p146.get('simultaneous_limit'),
                         "130146不应设simultaneous_limit（使用exclusive_group）")

    def test_exclusive_group_blocks_second_trigger(self):
        """exclusive_group：先発動のPS成功後、同group的PS不再触発"""
        from src.combat_v2.services.trigger_service import TriggerContext, TriggerInstance
        from src.entities_v2.enums import TriggerTiming

        # 模拟130145已成功执行，设置标志位
        self.ts._exclusive_group_triggered = {'stella_ps'}
        self.ts._simultaneous_limit_triggered_in_phase = False

        # 验证标志位已设置
        self.assertIn('stella_ps', self.ts._exclusive_group_triggered)

        # 构造TriggerInstance列表和TriggerContext
        candidates = [
            TriggerInstance(
                skill_id=130146,
                owner=self.caster,
                priority=100,
            )
        ]
        context = TriggerContext(
            timing=TriggerTiming.TURN_START,
            battlefield=self.bf,
        )

        # 调用_process_candidates
        filtered = self.ts._process_candidates(candidates, context)

        # 130146应被exclusive_group过滤掉
        self.assertEqual(len(filtered), 0,
                         "exclusive_group='stella_ps'已触发时，130146应被过滤")

        # 重置标志位
        self.ts._exclusive_group_triggered = set()

    # ─── 暗闇持续期间测试 ───

    def test_darkness_duration(self):
        """AS1(120145) 暗闇持続2行動"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120145, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 验证暗闇持续时间为2
        darkness_buffs = [d for d in self.enemy_front.debuffs if d.effect_type == DARKNESS]
        self.assertTrue(len(darkness_buffs) > 0)
        self.assertEqual(darkness_buffs[0].duration, 2, "暗闇持続時間応為2行動")

    # ─── Lv11+ 测试 ───

    def test_ex_lv11_debuff_immune(self):
        """EX(110065) Lv11+ デバフ解除+無効"""
        # 设置等级为15
        self.caster.skill_levels[110065] = 15

        # 给施法者预置一个debuff（timing_type=4避免被EPHEMERAL_SKILL_END清除）
        test_debuff = BuffState(
            buff_id="test_debuff_to_remove", name="测试debuff",
            effect_type=SkillEffectType.POISON.value, value=100,
            duration=3, timing_type=4,
        )
        self.caster.debuffs.append(test_debuff)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110065, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证debuff被解除
        poison_after = [d for d in self.caster.debuffs
                        if d.effect_type == SkillEffectType.POISON.value]
        self.assertEqual(len(poison_after), 0, "Lv11+应解除自身debuff")

        # 验证debuff_immune buff被付与
        immune_buffs = [b for b in self.caster.buffs if b.effect_type == DEBUFF_IMMUNE]
        self.assertTrue(len(immune_buffs) > 0, "Lv11+应付与デバフ無効buff")

    def test_as1_lv11_crit_rate_up(self):
        """AS1(120145) Lv11+ 味方全会心率上昇"""
        self.caster.skill_levels[120145] = 15

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120145, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 味方前排应获得会心率buff
        crit_buffs = [b for b in self.ally_front.buffs if b.effect_type == CRIT_RATE_UP]
        self.assertTrue(len(crit_buffs) > 0, "Lv11+味方应获得会心率上昇buff")
        # stackable
        self.assertTrue(crit_buffs[0].is_stackable, "会心率上昇buff应可叠加")


