"""
角色127301 体育祭のサポート役 专项测试
- EX: 110027 紅玉の逆襲（敵全体EN攻撃 + 自身に「ストイック」状態2行動）
- AS: 120066 エイムグローリー（敵単体EN攻撃 + ストイック状態時：後列の敵横一列に追加攻撃）
- PS1: 130072 ストイックリコイル（AS攻撃された後発動 + ストイック前提 + 受けたダメージの%で敵2体に反撃）
- PS2: 130073 スターターショット（ターン開始時 + 最も近い敵+隣接2体EN攻撃 + ストイック時：与ダメージ減少debuff）
- PS3: 130074 チアーエール（ターン終了時 + 最低HP味方に被ダメ減少 + ストイック時：行動時HP回復）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
MARK = SkillEffectType.MARK.value
DEALT_DAMAGE_DOWN = SkillEffectType.DEALT_DAMAGE.value
TAKEN_DAMAGE_DOWN = SkillEffectType.RECEIVED_DAMAGE.value
HEAL_OVER_TIME = SkillEffectType.HEAL_OVER_TIME.value


class TestActor127301(unittest.TestCase):
    """角色127301 体育祭のサポート役 专项测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 127301 体育祭のサポート役 (土属性, EN型, 灵活站位→放前排)
        self.caster = UnitState(
            unit_id="ally_front", name="体育祭のサポート役", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=127301, level=10,
            element=4, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=8,
            current_ap=10, current_pp=10, current_ep=8,
            skills=[110027, 120066, 130072, 130073, 130074],
            skill_levels={110027: 10, 120066: 10, 130072: 10, 130073: 10, 130074: 10},
            skill_cooldowns={},
        )

        # 友方后排（用于PS3测试）
        self.ally_back = UnitState(
            unit_id="ally_back", name="友方后排", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=999100, level=10,
            element=2, character_type=1,
            max_hp=12000, current_hp=6000,  # HP较低，用于PS3最低HP选取
            attack=6000, defense=4000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央（最近敌人，用于PS2主目标）
        self.enemy_front = UnitState(
            unit_id="enemy_front", name="敌方前排", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（邻接，用于PS2邻接目标）
        self.enemy_left_front = UnitState(
            unit_id="enemy_left_front", name="敌方左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=4, character_type=1,
            max_hp=10000, current_hp=10000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（邻接，用于PS2邻接目标）
        self.enemy_right_front = UnitState(
            unit_id="enemy_right_front", name="敌方右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=5, character_type=2,
            max_hp=8000, current_hp=8000,
            attack=5000, defense=3000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=1,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方后排中央（用于AS追加攻撃後列テスト）
        self.enemy_back = UnitState(
            unit_id="enemy_back", name="敌方后排", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=999002, level=10,
            element=3, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6000, defense=4000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=5, current_ep=4,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左后（用于AS追加攻撃後列テスト）
        self.enemy_left_back = UnitState(
            unit_id="enemy_left_back", name="敌方左后", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_BACK, character_id=999005, level=10,
            element=1, character_type=1,
            max_hp=10000, current_hp=10000,
            attack=7000, defense=4500, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=5, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右后（用于AS追加攻撃後列テスト）
        self.enemy_right_back = UnitState(
            unit_id="enemy_right_back", name="敌方右后", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_BACK, character_id=999006, level=10,
            element=6, character_type=1,
            max_hp=9000, current_hp=9000,
            attack=5500, defense=3500, speed=320,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=5, current_ep=1,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally_back]
        self.bf.enemy_team = [
            self.enemy_front, self.enemy_left_front, self.enemy_right_front,
            self.enemy_back, self.enemy_left_back, self.enemy_right_back,
        ]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _grant_stoic(self, unit=None, duration=2):
        """为指定单位赋予「ストイック」mark buff（默认施法者）"""
        if unit is None:
            unit = self.caster
        stoic_buff = BuffState(
            buff_id=f"stoic_{unit.unit_id}", name="ストイック",
            effect_type=MARK, value=1,
            duration=duration, timing_type=1,
        )
        unit.buffs.append(stoic_buff)

    # ─── EX: 紅玉の逆襲 ───

    def test_ex_grants_stoic_mark(self):
        """
        EX(110027) 赋予自身「ストイック」状态
        验证: EX执行后施法者自身持有「ストイック」mark buff，duration=2
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110027, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        stoic_buffs = [b for b in self.caster.buffs
                       if b.effect_type == MARK and b.name == "ストイック"]
        self.assertEqual(len(stoic_buffs), 1, "EX应赋予自身1个「ストイック」mark")
        self.assertEqual(stoic_buffs[0].duration, 2, "「ストイック」duration应为2")

    def test_ex_deals_damage_to_all_enemies(self):
        """
        EX(110027) 对敌方全体造成EN伤害
        验证: 所有存活敌方单位HP下降
        """
        hp_before = {e.unit_id: e.current_hp for e in self.bf.enemy_team}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110027, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        damaged_count = sum(1 for e in self.bf.enemy_team if e.current_hp < hp_before[e.unit_id])
        self.assertGreater(damaged_count, 0, "EX应至少对1个敌方造成伤害")

    # ─── AS: エイムグローリー ───

    def test_as_without_stoic_only_main_target(self):
        """
        AS(120066) 无ストイック状態：仅攻击主目标
        验证: 后排敌方HP不变
        """
        hp_back_before = self.enemy_back.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120066, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertEqual(self.enemy_back.current_hp, hp_back_before,
                         "无ストイック状態时后排敌方不应受到伤害")

    def test_as_with_stoic_hits_back_row(self):
        """
        AS(120066) 有ストイック状態：追加攻撃後排敵横一列
        验证: 后排敌方HP下降
        """
        self._grant_stoic()
        hp_back_before = self.enemy_back.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120066, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_back.current_hp, hp_back_before,
                        "有ストイック状態时后排敌方应受到追加攻撃伤害")

    # ─── PS1: ストイックリコイル ───

    def test_ps1_without_stoic_no_trigger(self):
        """
        PS1(130072) 无ストイック状態：不触发
        验证: global_condition self_has_mark过滤掉无ストイック状态的触发
        """
        # 施法者无ストイック
        context = TriggerService._build_context_for_test(
            timing=None, actor=self.enemy_front, targets=[self.caster],
            battlefield=self.bf, triggered_by=self.caster
        ) if hasattr(TriggerService, '_build_context_for_test') else None

        # 直接检查global_condition
        parsed = self.dl.get_parsed_skill_data(130072)
        gc = parsed.get('global_condition', {})
        self.assertEqual(gc.get('type'), 'self_has_mark')
        self.assertEqual(gc.get('mark_name'), 'ストイック')

        # 无ストイック时条件应为False
        has_stoic = any(b.effect_type == MARK and b.name == 'ストイック' for b in self.caster.buffs)
        self.assertFalse(has_stoic, "施法者不应持有ストイック")

    def test_ps1_with_stoic_counter_attack(self):
        """
        PS1(130072) 有ストイック状態：反撃伤害基于受けたダメージ
        验证: 施法者受到伤害后，last_received_damage被记录，PS1反撃伤害基于该值
        """
        self._grant_stoic()
        # 模拟施法者受到5000点HP伤害
        self.caster.last_received_damage = 5000

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130072, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证反撃造成伤害（至少1个敌方HP下降）
        # PS1应选择2个敌方目标
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "PS1应造成反撃伤害")

    def test_ps1_targets_two_enemies(self):
        """
        PS1(130072) 目标为2个敌方单位
        验证: target_count=2配置正确
        """
        parsed = self.dl.get_parsed_skill_data(130072)
        effects = parsed['effect_blocks'][0]['effects']
        flags = effects[0].get('flags', {}) if isinstance(effects[0], dict) else getattr(effects[0], 'flags', {})
        self.assertEqual(flags.get('target_count'), 2, "PS1应配置target_count=2")

    # ─── PS2: スターターショット ───

    def test_ps2_attacks_main_and_adjacent(self):
        """
        PS2(130073) 攻击最近敌人+邻接2体
        验证: 主目标和邻接目标都受到伤害
        """
        hp_before = {e.unit_id: e.current_hp for e in self.bf.enemy_team}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130073, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        damaged = [e.unit_id for e in self.bf.enemy_team if e.current_hp < hp_before[e.unit_id]]
        self.assertGreaterEqual(len(damaged), 1, "PS2应至少对1个敌方造成伤害")

    def test_ps2_with_stoic_applies_dmg_dealt_down(self):
        """
        PS2(130073) 有ストイック状態：赋予dmg_dealt_down debuff
        验证: 被攻击目标持有dmg_dealt_down debuff，attack_limited=1
        """
        self._grant_stoic()
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130073, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 检查被攻击的敌方是否持有dmg_dealt_down
        has_debuff = any(
            d.effect_type == DEALT_DAMAGE_DOWN
            for e in self.bf.enemy_team
            for d in e.debuffs
        )
        self.assertTrue(has_debuff, "有ストイック状態时PS2应赋予dmg_dealt_down debuff")

    def test_ps2_without_stoic_no_debuff(self):
        """
        PS2(130073) 无ストイック状態：不赋予debuff
        验证: 被攻击目标不持有dmg_dealt_down
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130073, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        has_debuff = any(
            d.effect_type == DEALT_DAMAGE_DOWN
            for e in self.bf.enemy_team
            for d in e.debuffs
        )
        self.assertFalse(has_debuff, "无ストイック状態时PS2不应赋予dmg_dealt_down debuff")

    # ─── PS3: チアーエール ───

    def test_ps3_applies_dmg_taken_down_to_lowest_hp_ally(self):
        """
        PS3(130074) 赋予最低HP比例友方dmg_taken_down
        验证: ally_back(HP=50%)持有dmg_taken_down buff
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130074, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # ally_back HP=6000/12000=50%，caster HP=20000/20000=100%
        # 应选择ally_back
        has_buff = any(b.effect_type == TAKEN_DAMAGE_DOWN for b in self.ally_back.buffs)
        self.assertTrue(has_buff, "PS3应赋予最低HP友方dmg_taken_down buff")

    def test_ps3_with_stoic_applies_heal_over_time(self):
        """
        PS3(130074) 有ストイック状態：赋予heal_over_time
        验证: ally_back持有heal_over_time buff，duration=3
        """
        self._grant_stoic()
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130074, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        hot_buffs = [b for b in self.ally_back.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hot_buffs), 1, "有ストイック状態时PS3应赋予heal_over_time")
        self.assertEqual(hot_buffs[0].duration, 3, "heal_over_time duration应为3")

    def test_ps3_without_stoic_no_heal_over_time(self):
        """
        PS3(130074) 无ストイック状態：不赋予heal_over_time
        验证: ally_back不持有heal_over_time
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130074, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        hot_buffs = [b for b in self.ally_back.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hot_buffs), 0, "无ストイック状態时PS3不应赋予heal_over_time")

    def test_ps3_solo_caster_targets_self(self):
        """
        PS3(130074) 战场仅有施法者自身时（ally_single→FRIENDS排除自身导致targets为空）
        验证: lowest_hp_priority回退到所有存活友方（含自身），对施法者自身施加dmg_taken_down
        这是用户报告的bug场景：叙事日志显示无实际效果
        """
        # 仅保留施法者自身，移除其他友方
        self.bf.friend_team = [self.caster]
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130074, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        has_buff = any(b.effect_type == TAKEN_DAMAGE_DOWN for b in self.caster.buffs)
        self.assertTrue(has_buff, "仅施法者自身时PS3应对自身施加dmg_taken_down")

    def test_ps3_solo_caster_with_stoic_both_effects(self):
        """
        PS3(130074) 仅施法者自身且有ストイック状態：减伤和hot均应生效
        验证: 施法者自身同时持有dmg_taken_down和heal_over_time
        这是用户报告的bug场景：有mark时减伤和hot效果均应生效
        """
        self.bf.friend_team = [self.caster]
        self._grant_stoic()
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130074, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        has_dmg_down = any(b.effect_type == TAKEN_DAMAGE_DOWN for b in self.caster.buffs)
        self.assertTrue(has_dmg_down, "有ストイック状態时PS3应对自身施加dmg_taken_down")

        hot_buffs = [b for b in self.caster.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hot_buffs), 1, "有ストイック状態时PS3应对自身施加heal_over_time")
        self.assertEqual(hot_buffs[0].duration, 3, "heal_over_time duration应为3")


if __name__ == '__main__':
    unittest.main()
