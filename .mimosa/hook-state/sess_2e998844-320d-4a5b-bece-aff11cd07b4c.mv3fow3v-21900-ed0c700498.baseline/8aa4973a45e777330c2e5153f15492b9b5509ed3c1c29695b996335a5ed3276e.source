#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
快速验证修复 - 对比有/无narrative的TacticalExerciseController结果
"""

import sys
import json
import random
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.battle_flow_controller import BattleConfig
from src.combat_v2.tactical_exercise_controller import TacticalExerciseController
from src.combat_v2.battle_narrative import BattleNarrativeWriter
from src.data.data_loader import DataLoader
from src.data.stat_calculator import StatCalculator
from src.config.panel_config import PanelConfig, ModuleConfig
from src.config.player_config import SchoolLevels

import logging
logging.disable(logging.CRITICAL)

GRID_ALLY_POSITIONS = [
    Position.ALLY_LEFT_FRONT, Position.ALLY_CENTER_FRONT, Position.ALLY_RIGHT_FRONT,
    Position.ALLY_LEFT_BACK, Position.ALLY_CENTER_BACK, Position.ALLY_RIGHT_BACK,
]

ENEMY_SLOT_POSITION_MAP = {
    1: Position.ENEMY_LEFT_FRONT,
    2: Position.ENEMY_CENTER_FRONT,
    3: Position.ENEMY_RIGHT_FRONT,
    4: Position.ENEMY_LEFT_BACK,
    5: Position.ENEMY_CENTER_BACK,
    6: Position.ENEMY_RIGHT_BACK,
}


def create_unit(data_loader, panel_config, player_config, stat_calculator, char_id, side, pos):
    char = data_loader.get_character_by_id(char_id)
    if not char:
        return None
    pt = getattr(char, 'position_type', 0)
    char_config = panel_config.get_character_config(char_id, char.default_rarity)
    stats = stat_calculator.calculate_stats(char_config, player_config)
    skills = data_loader.load_character_skills().get(char_id, [])
    max_extra_point = 0
    for sid in skills:
        sk = data_loader.get_skill_by_id(sid)
        if sk and sk.skill_type == 3:
            max_extra_point = max(max_extra_point, sk.resource_cost)
    side_prefix = "F" if side == Side.ALLY else "E"
    return UnitState(
        unit_id=f"{side_prefix}_{char_id}", name=char.name, side=side, position=pos,
        character_id=char_id, level=char_config.level, element=char.attribute, character_type=char.character_type,
        max_hp=stats.hp, current_hp=stats.hp, attack=stats.attack, defense=stats.defense,
        speed=stats.speed, crit_rate=stats.critical_rate,
        crit_damage=stats.critical_damage - 1.5, advantage_damage=stats.advantage_damage - 1.25,
        initial_active_point=stats.initial_ap, initial_passive_point=stats.initial_pp,
        max_extra_point=max_extra_point, current_ap=stats.initial_ap, current_pp=stats.initial_pp, current_ep=0,
        skills=skills, skill_levels=char_config.skill_levels,
        skill_cooldowns={}, role_type=getattr(char, 'role_type', 0), position_type=pt,
    )


def create_tactical_enemy(data_loader, enemy_data):
    pos = enemy_data.get("position", 2)
    enemy_pos = ENEMY_SLOT_POSITION_MAP.get(pos, Position.ENEMY_CENTER_FRONT)
    skill_ids = enemy_data.get("skill_ids", [])
    skill_levels = {sid: 15 for sid in skill_ids}
    max_ep = 0
    for sid in skill_ids:
        sk = data_loader.get_skill_by_id(sid)
        if sk and sk.skill_type == 3:
            max_ep = max(max_ep, sk.resource_cost)
    return UnitState(
        unit_id=f"E_{enemy_data['enemy_id']}", name=enemy_data["character_name"],
        side=Side.ENEMY, position=enemy_pos,
        character_id=enemy_data["enemy_id"], level=1,
        element=enemy_data["attribute"], character_type=enemy_data["type"],
        max_hp=enemy_data["hp"], current_hp=enemy_data["hp"],
        attack=enemy_data["attack"], defense=enemy_data["defense"],
        speed=enemy_data["speed"], crit_rate=enemy_data["critical_rate"],
        crit_damage=0.0, advantage_damage=0.0,
        initial_active_point=enemy_data.get("action_point", 2),
        initial_passive_point=enemy_data.get("passive_point", 2),
        max_extra_point=max_ep,
        current_ap=enemy_data.get("action_point", 2),
        current_pp=enemy_data.get("passive_point", 2),
        current_ep=0, skills=skill_ids, skill_levels=skill_levels,
        skill_cooldowns={}, role_type=enemy_data.get("role_type", 0), position_type=3,
    )


def run_batch_path(data_loader, panel_config, player_config, stat_calculator,
                   friend_ids, enemy_data, seed):
    """模拟批量运行路径（无narrative）"""
    random.seed(seed)
    bf = BattlefieldState()
    for i, cid in enumerate(friend_ids):
        if cid is not None:
            u = create_unit(data_loader, panel_config, player_config, stat_calculator,
                            cid, Side.ALLY, GRID_ALLY_POSITIONS[i])
            if u:
                bf.add_unit(u)
    enemy_unit = create_tactical_enemy(data_loader, enemy_data)
    if enemy_unit:
        bf.add_unit(enemy_unit)
    bf.memory_cards = []
    config = BattleConfig()
    config.max_turns = 5
    controller = TacticalExerciseController(bf, data_loader=data_loader, config=config)
    result = controller.execute_battle()
    score_data = result.get("score", {})
    total_score = score_data.get("total_score", 0) if score_data else 0
    return total_score, result.get("stages_cleared", 0)


def run_export_path(data_loader, panel_config, player_config, stat_calculator,
                    friend_ids, enemy_data, seed):
    """模拟导出路径（有narrative，且narrative在seed之前创建——与GUI一致）"""
    # 与GUI一致：narrative在seed之前创建
    narrative = BattleNarrativeWriter()
    random.seed(seed)
    bf = BattlefieldState()
    for i, cid in enumerate(friend_ids):
        if cid is not None:
            u = create_unit(data_loader, panel_config, player_config, stat_calculator,
                            cid, Side.ALLY, GRID_ALLY_POSITIONS[i])
            if u:
                bf.add_unit(u)
    enemy_unit = create_tactical_enemy(data_loader, enemy_data)
    if enemy_unit:
        bf.add_unit(enemy_unit)
    bf.memory_cards = []
    config = BattleConfig()
    config.max_turns = 5
    controller = TacticalExerciseController(bf, data_loader=data_loader,
                                            config=config, narrative=narrative)
    result = controller.execute_battle()
    score_data = result.get("score", {})
    total_score = score_data.get("total_score", 0) if score_data else 0
    return total_score, result.get("stages_cleared", 0)


def main():
    data_loader = DataLoader()
    data_loader.load_all()

    panel_config = PanelConfig(character_level=200, school_levels=SchoolLevels(), equipment_enabled=True)
    enemy_json_path = Path(__file__).parent / "data" / "tactical_exercise_enemies.json"
    with open(enemy_json_path, "r", encoding="utf-8") as f:
        enemy_db = json.load(f)
    enemy_id = list(enemy_db.keys())[0]
    enemy_data = enemy_db[enemy_id]

    # 使用6个角色（覆盖不同类型）
    all_char_ids = list(data_loader.load_character_skills().keys())
    friend_ids = all_char_ids[:6]  # 取前6个角色
    while len(friend_ids) < 6:
        friend_ids.append(None)

    for cid in friend_ids:
        if cid is not None:
            char = data_loader.get_character_by_id(cid)
            if char:
                panel_config.rarities[cid] = 14
                panel_config.affection_levels[cid] = 40
                skill_ids = data_loader.load_character_skills().get(cid, [])
                panel_config.skill_levels[cid] = {sid: 15 for sid in skill_ids}
                char_type = getattr(char, 'character_type', 1)
                module_ids = {1: [1,2,3], 2: [4,5,6], 3: [7,8,9]}.get(char_type, [10,11,12])
                panel_config.modules[cid] = [ModuleConfig(module_id=mid, tier=9, level=50) for mid in module_ids]

    player_config = panel_config.get_player_config()
    lerp_data = data_loader.load_level_lerp_data()
    stat_calculator = StatCalculator(lerp_data, data_loader=data_loader)

    base_seed = 12345678
    all_match = True

    print(f"=== 6角色 批量路径 vs 导出路径 对比 ===")
    print(f"角色: {friend_ids}")
    for i in range(10):
        seed = (base_seed + i) % (2**31)
        s_batch, st_batch = run_batch_path(data_loader, panel_config, player_config, stat_calculator,
                                           friend_ids, enemy_data, seed)
        s_export, st_export = run_export_path(data_loader, panel_config, player_config, stat_calculator,
                                              friend_ids, enemy_data, seed)
        ok = s_batch == s_export and st_batch == st_export
        if not ok:
            all_match = False
        print(f"  seed={seed}: batch={s_batch:,}/{st_batch} export={s_export:,}/{st_export} [{'OK' if ok else 'MISMATCH'}]")

    print(f"\n结果: {'ALL PASS' if all_match else 'SOME MISMATCH'}")
    return 0 if all_match else 1


if __name__ == "__main__":
    sys.exit(main())
