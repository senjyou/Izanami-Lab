"""_apply_split_heal_by_damage 单元测试。

测试目标：
1. 入口检查
   - 无 target_service 返回 None
   - _block_damage_total 无记录返回空结果

2. 参数读取
   - 默认 source_block_id=None 时使用 _current_block_id
   - 显式 source_block_id
   - 默认 split_among_targets=True
   - 显式 split_among_targets=False
   - 默认 percent=100
   - 显式 percent

3. 伤害来源
   - block_damage_total 为 0 时返回空结果
   - block_damage_total < 0 时返回空结果（视为无效）
   - block_damage_total > 0 时正常计算

4. 均摊计算
   - split=True: total_heal_value // len(targets)
   - split=False: 每个目标得 total_heal_value
   - 多目标时整数除法

5. 治疗应用
   - 满血目标 actual_heal=0
   - 未满血目标 actual_heal=per_target
   - 部分满血时按缺失HP限制

6. 返回值结构
   - 字段完整性
   - heals 列表结构
   - details 列表结构
   - heal_link_transfers 列表

7. heal_link 转送
   - 满血目标仍触发转送（按理论值）
   - link_target 缺失HP限制转送量
   - link_target 死亡不转送
"""
import sys
import os
import unittest

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


# ─── 工厂函数 ──────────────────────────────────────────────

def _make_unit(unit_id, name, side, position, *, hp=50000, atk=10000,
               defense=4000, speed=500, current_hp=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=2, character_type=1,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


def _make_effect(**kwargs):
    """Create a mock effect object with attributes.

    默认 target_type='friends'（不含 caster），与游戏内 split_heal_by_damage
    实际语义一致（治疗其他友方，不治疗施法者自身）。
    """
    defaults = {
        'effect_type': 'split_heal_by_damage',
        'value': 100.0,
        'value_tag': None,
        'target_type': 'friends',
        'flags': {},
        'target_identifier': None,
        'hit_count': None,
        'condition': None,
        'duration': 1,
        'duration_type': None,
    }
    defaults.update(kwargs)
    obj = type('obj', (object,), defaults)()
    return obj


def _make_heal_link_buff(buff_id, *, source_unit_id="other", value=100.0,
                         duration=-1, is_debuff=False):
    """构造 heal_link buff。"""
    return BuffState(
        buff_id=buff_id, name="heal_link",
        effect_type=SkillEffectType.HEAL_LINK.value,
        value=value, duration=duration,
        timing_type=AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
        source_unit_id=source_unit_id,
        is_debuff=is_debuff,
    )


class _BaseSplitHealTest(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf, with_target=True):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService() if with_target else None
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        ss._current_skill_id = 220360
        # 初始化内部状态
        ss._block_damage_total = {}
        ss._current_block_id = 1
        ss._block_damage_targets = None
        ss._current_skill_priority = None
        return ss, ts, aus, dms, sts


# ═══════════════════════════════════════════════════════════════════════
# Part 1: 入口检查
# ═══════════════════════════════════════════════════════════════════════

class TestApplySplitHealEntry(_BaseSplitHealTest):
    """_apply_split_heal_by_damage: 入口检查。"""

    def test_no_target_service_returns_none(self):
        """无 target_service 时返回 None。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf, with_target=False)

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        self.assertIsNone(result)

    def test_no_block_damage_total_returns_empty(self):
        """_block_damage_total 无记录返回空结果。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        # _block_damage_total 为空字典

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["effect_type"], "split_heal_by_damage")
        self.assertEqual(result["target_count"], 0)
        self.assertEqual(result["total_heal"], 0)
        self.assertEqual(result["details"], [])
        self.assertEqual(result["heals"], [])


# ═══════════════════════════════════════════════════════════════════════
# Part 2: 参数读取
# ═══════════════════════════════════════════════════════════════════════

class TestApplySplitHealParameters(_BaseSplitHealTest):
    """_apply_split_heal_by_damage: 参数读取。"""

    def test_default_source_block_id_uses_current_block(self):
        """未指定 source_block_id 时使用 _current_block_id。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}  # block 1: 20000 伤害
        ss._current_block_id = 1
        effect = _make_effect(flags={})  # 无 source_block_id

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["source_block_id"], 1)
        self.assertEqual(result["source_damage_total"], 20000)

    def test_explicit_source_block_id(self):
        """显式指定 source_block_id 读取对应 block 的伤害。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 10000, 2: 30000}
        ss._current_block_id = 2  # 当前 block 是 2
        effect = _make_effect(flags={'source_block_id': 1})  # 但读取 block 1

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["source_block_id"], 1)
        self.assertEqual(result["source_damage_total"], 10000)

    def test_default_split_among_targets_true(self):
        """默认 split_among_targets=True，按目标数均摊。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT,
                        hp=50000, current_hp=10000)
        t2 = _make_unit("t2", "T2", Side.ALLY, Position.ALLY_CENTER_FRONT,
                        hp=50000, current_hp=10000)
        bf = _make_bf(caster, t1, t2)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}
        effect = _make_effect(flags={})  # 默认 split=True

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        # 20000 × 100% = 20000, 均摊到2个目标 = 10000 每个
        self.assertEqual(result["target_count"], 2)
        for heal in result["heals"]:
            self.assertEqual(heal["amount"], 10000)

    def test_explicit_split_among_targets_false(self):
        """split_among_targets=False 时每个目标得全额治疗。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT,
                        hp=50000, current_hp=10000)
        t2 = _make_unit("t2", "T2", Side.ALLY, Position.ALLY_CENTER_FRONT,
                        hp=50000, current_hp=10000)
        bf = _make_bf(caster, t1, t2)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}
        effect = _make_effect(flags={'split_among_targets': False})

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        # 不均摊，每个目标都得 20000
        for heal in result["heals"]:
            self.assertEqual(heal["amount"], 20000)

    def test_default_percent_100(self):
        """未指定 value 时默认 percent=100。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}
        effect = _make_effect(value=None)  # 默认 percent=100

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        self.assertEqual(result["percent"], 100)
        self.assertEqual(result["heals"][0]["amount"], 20000)

    def test_explicit_percent_50(self):
        """显式 percent=50 时按 50% 计算。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}
        effect = _make_effect(value=50)

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        # 20000 × 50% = 10000
        self.assertEqual(result["percent"], 50)
        self.assertEqual(result["heals"][0]["amount"], 10000)


# ═══════════════════════════════════════════════════════════════════════
# Part 3: 伤害来源
# ═══════════════════════════════════════════════════════════════════════

class TestApplySplitHealDamageSource(_BaseSplitHealTest):
    """_apply_split_heal_by_damage: 伤害来源处理。"""

    def test_zero_damage_returns_empty(self):
        """block_damage_total=0 时返回空结果。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 0}

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        self.assertEqual(result["target_count"], 0)
        self.assertEqual(result["total_heal"], 0)

    def test_negative_damage_returns_empty(self):
        """block_damage_total<0 时返回空结果。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: -1000}

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        self.assertEqual(result["target_count"], 0)
        self.assertEqual(result["total_heal"], 0)


# ═══════════════════════════════════════════════════════════════════════
# Part 4: 均摊计算
# ═══════════════════════════════════════════════════════════════════════

class TestApplySplitHealCalculation(_BaseSplitHealTest):
    """_apply_split_heal_by_damage: 均摊计算。"""

    def test_split_true_divides_among_targets(self):
        """split=True 时按目标数整除均摊。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        targets = [
            _make_unit(f"t{i}", f"T{i}", Side.ALLY,
                       [Position.ALLY_LEFT_FRONT, Position.ALLY_CENTER_FRONT,
                        Position.ALLY_RIGHT_FRONT, Position.ALLY_LEFT_BACK][i],
                       hp=50000, current_hp=10000)
            for i in range(4)
        ]
        bf = _make_bf(caster, *targets)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 30000}  # 4个目标均摊 = 7500 每个

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        self.assertEqual(result["target_count"], 4)
        for heal in result["heals"]:
            self.assertEqual(heal["amount"], 7500)

    def test_split_false_full_amount_each(self):
        """split=False 时每个目标得全额。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT,
                        hp=50000, current_hp=10000)
        t2 = _make_unit("t2", "T2", Side.ALLY, Position.ALLY_CENTER_FRONT,
                        hp=50000, current_hp=10000)
        bf = _make_bf(caster, t1, t2)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}

        result = ss._apply_split_heal_by_damage(
            caster, _make_effect(flags={'split_among_targets': False}), bf)

        for heal in result["heals"]:
            self.assertEqual(heal["amount"], 20000)

    def test_integer_division_truncates(self):
        """整数除法截断（非四舍五入）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT,
                        hp=50000, current_hp=10000)
        t2 = _make_unit("t2", "T2", Side.ALLY, Position.ALLY_CENTER_FRONT,
                        hp=50000, current_hp=10000)
        t3 = _make_unit("t3", "T3", Side.ALLY, Position.ALLY_RIGHT_FRONT,
                        hp=50000, current_hp=10000)
        bf = _make_bf(caster, t1, t2, t3)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 10000}  # 10000 / 3 = 3333 (int 截断)

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        for heal in result["heals"]:
            self.assertEqual(heal["amount"], 3333)


# ═══════════════════════════════════════════════════════════════════════
# Part 5: 治疗应用
# ═══════════════════════════════════════════════════════════════════════

class TestApplySplitHealApplication(_BaseSplitHealTest):
    """_apply_split_heal_by_damage: 治疗应用。"""

    def test_full_hp_target_actual_zero(self):
        """满血目标 actual_heal=0，但 per_target 仍计入 details。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        full_hp_target = _make_unit("full", "F", Side.ALLY, Position.ALLY_LEFT_FRONT,
                                    hp=50000, current_hp=50000)  # 满血
        bf = _make_bf(caster, full_hp_target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        # actual_heal=0（满血），但 details 中 heal=20000（per_target）
        self.assertEqual(result["heals"][0]["amount"], 0)
        self.assertEqual(result["details"][0]["heal"], 20000)
        self.assertEqual(result["total_heal"], 0)

    def test_partial_hp_target_actual_limited_by_missing(self):
        """未满血目标 actual_heal 受缺失HP限制。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=45000)  # 缺失5000
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}  # per_target=20000 > missing=5000

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        # actual_heal 应为 5000（受缺失HP限制）
        self.assertEqual(result["heals"][0]["amount"], 5000)
        self.assertEqual(result["heals"][0]["hp_before"], 45000)
        self.assertEqual(result["heals"][0]["hp_after"], 50000)

    def test_dead_targets_filtered(self):
        """死亡目标被过滤。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        alive = _make_unit("alive", "A", Side.ALLY, Position.ALLY_LEFT_FRONT,
                           hp=50000, current_hp=10000)
        dead = _make_unit("dead", "D", Side.ALLY, Position.ALLY_CENTER_FRONT,
                          hp=50000, current_hp=0)
        dead.is_alive = False
        bf = _make_bf(caster, alive, dead)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        # 只治疗存活目标
        self.assertEqual(result["target_count"], 1)
        self.assertEqual(result["heals"][0]["target_id"], "alive")

    def test_all_dead_targets_returns_empty(self):
        """所有目标都死亡时返回空结果。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        dead = _make_unit("dead", "D", Side.ALLY, Position.ALLY_LEFT_FRONT,
                          hp=50000, current_hp=0)
        dead.is_alive = False
        bf = _make_bf(caster, dead)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        self.assertEqual(result["target_count"], 0)
        self.assertEqual(result["total_heal"], 0)


# ═══════════════════════════════════════════════════════════════════════
# Part 6: 返回值结构
# ═══════════════════════════════════════════════════════════════════════

class TestApplySplitHealReturnStructure(_BaseSplitHealTest):
    """_apply_split_heal_by_damage: 返回值结构。"""

    def test_return_value_fields_complete(self):
        """返回值包含所有字段。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}
        ss._current_block_id = 1
        effect = _make_effect(value=50)

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result["effect_type"], "split_heal_by_damage")
        self.assertEqual(result["target_count"], 1)
        self.assertEqual(result["source_block_id"], 1)
        self.assertEqual(result["source_damage_total"], 20000)
        self.assertEqual(result["percent"], 50)
        self.assertIn("details", result)
        self.assertIn("heals", result)
        self.assertIn("heal_link_transfers", result)

    def test_heals_list_structure(self):
        """heals 列表项包含完整字段。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        heal = result["heals"][0]
        self.assertEqual(heal["target_id"], "target")
        self.assertEqual(heal["target"], "T")
        self.assertEqual(heal["hp_before"], 10000)
        self.assertEqual(heal["hp_after"], 30000)
        self.assertEqual(heal["amount"], 20000)
        self.assertEqual(heal["is_crit"], False)
        self.assertIn("heal_formula", heal)
        # heal_formula 包含 src_dmg/pct/split/per_target 信息
        self.assertIn("src_dmg:20000", heal["heal_formula"])
        self.assertIn("pct:100%", heal["heal_formula"])

    def test_details_list_structure(self):
        """details 列表项包含 target_id/target/heal。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        detail = result["details"][0]
        self.assertEqual(detail["target_id"], "target")
        self.assertEqual(detail["target"], "T")
        # heal 字段为 per_target（理论值），不是 actual
        self.assertEqual(detail["heal"], 20000)

    def test_total_heal_is_sum_of_actual(self):
        """total_heal 是所有目标 actual_heal 之和。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT,
                        hp=50000, current_hp=10000)
        t2 = _make_unit("t2", "T2", Side.ALLY, Position.ALLY_CENTER_FRONT,
                        hp=50000, current_hp=25000)
        bf = _make_bf(caster, t1, t2)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}  # 每个目标 10000

        result = ss._apply_split_heal_by_damage(caster, _make_effect(), bf)

        # t1: missing=40000, actual=10000
        # t2: missing=25000, actual=10000
        # total = 20000
        self.assertEqual(result["total_heal"], 20000)


# ═══════════════════════════════════════════════════════════════════════
# Part 7: heal_link 转送
# ═══════════════════════════════════════════════════════════════════════

class TestApplySplitHealHealLinkTransfer(_BaseSplitHealTest):
    """_apply_split_heal_by_damage: heal_link 转送。"""

    def test_full_hp_target_still_triggers_transfer(self):
        """满血目标 actual=0 仍按理论值转送 heal_link。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        # 满血目标持有 heal_link，链接到 link_target
        full_hp = _make_unit("full", "F", Side.ALLY, Position.ALLY_LEFT_FRONT,
                             hp=50000, current_hp=50000)
        link_target = _make_unit("link_t", "LT", Side.ALLY, Position.ALLY_CENTER_FRONT,
                                 hp=50000, current_hp=10000)
        # heal_link: full_hp 受治疗时转送给 link_target
        full_hp.buffs.append(_make_heal_link_buff(
            "hl1", source_unit_id="link_t", value=100.0))
        bf = _make_bf(caster, full_hp, link_target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}
        # 使用 ally_single 只选中 full_hp（最近友方）
        effect = _make_effect(target_type='ally_single')

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        # heal_link_transfers 应有1条记录
        self.assertEqual(len(result["heal_link_transfers"]), 1)
        transfer = result["heal_link_transfers"][0]
        self.assertEqual(transfer["source_id"], "full")
        self.assertEqual(transfer["linker_id"], "link_t")
        # 转送量 = per_target × value% = 20000 × 100% = 20000
        # 但 link_target missing=40000，所以 link_actual=20000
        self.assertEqual(transfer["transfer_heal"], 20000)
        self.assertEqual(transfer["source_theoretical_heal"], 20000)

    def test_link_target_missing_hp_limits_transfer(self):
        """link_target 缺失HP限制转送量。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        # link_target 只缺失 5000 HP
        link_target = _make_unit("link_t", "LT", Side.ALLY, Position.ALLY_CENTER_FRONT,
                                 hp=50000, current_hp=45000)
        target.buffs.append(_make_heal_link_buff(
            "hl1", source_unit_id="link_t", value=100.0))
        bf = _make_bf(caster, target, link_target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}  # per_target=20000
        # 使用 ally_single 只选中 target
        effect = _make_effect(target_type='ally_single')

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        transfer = result["heal_link_transfers"][0]
        # transfer_amount = 20000 × 100% = 20000
        # 但 link_missing = 5000
        # link_actual = min(20000, 5000) = 5000
        self.assertEqual(transfer["transfer_heal"], 5000)
        self.assertEqual(transfer["hp_before"], 45000)
        self.assertEqual(transfer["hp_after"], 50000)

    def test_link_target_dead_no_transfer(self):
        """link_target 死亡时不转送。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        link_target = _make_unit("link_t", "LT", Side.ALLY, Position.ALLY_CENTER_FRONT,
                                 hp=50000, current_hp=0)
        link_target.is_alive = False
        target.buffs.append(_make_heal_link_buff(
            "hl1", source_unit_id="link_t", value=100.0))
        bf = _make_bf(caster, target, link_target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}
        # 使用 ally_single 只选中 target
        effect = _make_effect(target_type='ally_single')

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        # 死亡 link_target 不转送
        self.assertEqual(len(result["heal_link_transfers"]), 0)

    def test_transfer_pct_50(self):
        """transfer_pct=50% 时按比例转送。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        link_target = _make_unit("link_t", "LT", Side.ALLY, Position.ALLY_CENTER_FRONT,
                                 hp=50000, current_hp=10000)
        target.buffs.append(_make_heal_link_buff(
            "hl1", source_unit_id="link_t", value=50.0))  # 50%
        bf = _make_bf(caster, target, link_target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}
        # 使用 ally_single 只选中 target
        effect = _make_effect(target_type='ally_single')

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        transfer = result["heal_link_transfers"][0]
        # transfer_amount = 20000 × 50% = 10000
        self.assertEqual(transfer["transfer_heal"], 10000)
        self.assertEqual(transfer["link_value"], 50.0)

    def test_self_link_not_transferred(self):
        """source_unit_id == target.unit_id 时不转送（避免自指）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        # 自指 heal_link: source_unit_id == target.unit_id
        target.buffs.append(_make_heal_link_buff(
            "hl1", source_unit_id="target", value=100.0))
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}
        # 使用 ally_single 只选中 target
        effect = _make_effect(target_type='ally_single')

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        # 自指不转送
        self.assertEqual(len(result["heal_link_transfers"]), 0)

    def test_multiple_heal_link_buffs_all_transfer(self):
        """同一目标多个 heal_link buff 都转送。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        link1 = _make_unit("link1", "L1", Side.ALLY, Position.ALLY_CENTER_FRONT,
                           hp=50000, current_hp=10000)
        link2 = _make_unit("link2", "L2", Side.ALLY, Position.ALLY_RIGHT_FRONT,
                           hp=50000, current_hp=10000)
        target.buffs.append(_make_heal_link_buff(
            "hl1", source_unit_id="link1", value=50.0))
        target.buffs.append(_make_heal_link_buff(
            "hl2", source_unit_id="link2", value=30.0))
        bf = _make_bf(caster, target, link1, link2)
        ss, *_ = self._make_services(bf)
        ss._block_damage_total = {1: 20000}
        # 使用 ally_single 只选中 target（最近友方）
        effect = _make_effect(target_type='ally_single')

        result = ss._apply_split_heal_by_damage(caster, effect, bf)

        # 2个 heal_link 都应转送
        self.assertEqual(len(result["heal_link_transfers"]), 2)
        transfer_amounts = {t["linker_id"]: t["transfer_heal"]
                           for t in result["heal_link_transfers"]}
        # link1: 20000 × 50% = 10000
        self.assertEqual(transfer_amounts["link1"], 10000)
        # link2: 20000 × 30% = 6000
        self.assertEqual(transfer_amounts["link2"], 6000)


if __name__ == '__main__':
    unittest.main()
