#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
MGGBattleSimulation - 战斗模拟器入口
run_battle.py

支持 1v1 / 2v2 / 4v4 战斗，多种面板配置预设，批量模拟统计
"""

import sys
from pathlib import Path
from dataclasses import dataclass, field
from typing import List, Dict

sys.path.insert(0, str(Path(__file__).parent))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillType
from src.combat_v2.battle_flow_controller import BattleFlowController
from src.combat_v2.skill_data_resolver import SkillDataResolver
from src.data.data_loader import DataLoader
from src.data.stat_calculator import StatCalculator
from src.config.panel_config import PanelConfig, ModuleConfig
from src.config.player_config import SchoolLevels
from src.config.character_config import CharacterConfig


CHARS_TO_LOAD = [
    110301, 111301, 112301, 113301,
    114301, 117302, 121301, 132301,
]

TEAM_CONFIGS = {
    "2v2": {
        "friends": [121301, 132301],
        "enemies": [110301, 114301],
    },
    "4v4": {
        "friends": [110301, 121301, 132301, 114301],
        "enemies": [112301, 113301, 117302, 111301],
    },
    "1v1": {
        "friends": [121301],
        "enemies": [110301],
    },
}

POSITIONS_ALLY = [
    Position.ALLY_CENTER_FRONT, Position.ALLY_LEFT_FRONT,
    Position.ALLY_RIGHT_FRONT, Position.ALLY_CENTER_BACK,
]
POSITIONS_ENEMY = [
    Position.ENEMY_CENTER_FRONT, Position.ENEMY_LEFT_FRONT,
    Position.ENEMY_RIGHT_FRONT, Position.ENEMY_CENTER_BACK,
]

DEFAULT_PANEL = PanelConfig(
    character_level=200,
    school_levels=SchoolLevels(),
    equipment_ids=[],
    equipment_enabled=True,
)

PRESET_PANEL = PanelConfig(
    character_level=355,
    school_levels=SchoolLevels(
        physical_level=90,
        en_level=86,
        agility_level=88,
        fire_level=94,
        water_level=93,
        earth_level=92,
        wind_level=92,
        light_level=27,
        dark_level=27,
    ),
    equipment_ids=[11, 12, 13, 14, 21, 22, 23, 24, 31, 32, 33, 34],
    equipment_enabled=True,
)


@dataclass
class BattleConfig:
    name: str
    team_key: str
    panel_config: PanelConfig
    runs: int = 1
    panel_name: str = ""

    def __post_init__(self):
        if not self.panel_name:
            self.panel_name = self.name

BATTLE_SCENARIOS: Dict[str, BattleConfig] = {
    "4v4_max": BattleConfig(
        name="4v4满配",
        team_key="4v4",
        panel_config=PRESET_PANEL,
        runs=1,
    ),
    "1v1_max": BattleConfig(
        name="1v1满配",
        team_key="1v1",
        panel_config=PRESET_PANEL,
        runs=1,
    ),
    "4v4_default": BattleConfig(
        name="4v4默认面板",
        team_key="4v4",
        panel_config=DEFAULT_PANEL,
        runs=1,
    ),
    "4v4_batch": BattleConfig(
        name="4v4批量统计",
        team_key="4v4",
        panel_config=PRESET_PANEL,
        runs=100,
    ),
}

DEFAULT_SCENARIO = "4v4_max"


def get_module_type_ids(char_type):
    return [int(f"{char_type}1"), int(f"{char_type}2"), int(f"{char_type}3")]


def build_panel_config(data_loader, base_panel):
    for cid in CHARS_TO_LOAD:
        char = data_loader.get_character_by_id(cid)
        if not char:
            continue
        base_panel.rarities[cid] = 14
        base_panel.affection_levels[cid] = 40
        skill_ids = data_loader.load_character_skills().get(cid, [])
        base_panel.skill_levels[cid] = {sid: 15 for sid in skill_ids}
        module_ids = get_module_type_ids(char.character_type)
        base_panel.modules[cid] = [
            ModuleConfig(module_id=mid, tier=9, level=50)
            for mid in module_ids
        ]
    return base_panel


def create_unit(data_loader, stat_calculator, player_config, panel_config, char_id, side, pos):
    char = data_loader.get_character_by_id(char_id)
    if not char:
        return None

    char_config = panel_config.get_character_config(char_id, char.default_rarity)
    stats = stat_calculator.calculate_stats(char_config, player_config)

    char_skills = data_loader.load_character_skills()
    skills = char_skills.get(char_id, [])

    max_extra_point = 8
    for sid in skills:
        sk = data_loader.get_skill_by_id(sid)
        if sk and sk.skill_type == 3:
            max_extra_point = sk.resource_cost
            break

    side_prefix = "F" if side == Side.ALLY else "E"

    return UnitState(
        unit_id=f"{side_prefix}_{char_id}",
        name=char.name,
        side=side,
        position=pos,
        character_id=char_id,
        level=char_config.level,
        element=char.attribute,
        character_type=char.character_type,
        max_hp=stats.hp,
        current_hp=stats.hp,
        attack=stats.attack,
        defense=stats.defense,
        speed=stats.speed,
        crit_rate=stats.critical_rate,
        crit_damage=stats.critical_damage - 1.5,
        advantage_damage=stats.advantage_damage - 1.25,
        initial_active_point=stats.initial_ap,
        initial_passive_point=stats.initial_pp,
        max_extra_point=max_extra_point,
        current_ap=stats.initial_ap,
        current_pp=stats.initial_pp,
        current_ep=0,
        skills=skills,
        skill_levels=panel_config.skill_levels.get(char_id, {}),
        skill_cooldowns={},
        role_type=getattr(char, 'role_type', 0),
        position_type=getattr(char, 'position_type', 3),
    )


RARITY_NAMES = {1:"R",2:"R+",3:"SR",4:"SR+",5:"SSR",6:"SSR+",7:"UR",8:"UR+",9:"LR",
    10:"LR+1",11:"LR+2",12:"LR+3",13:"LR+4",14:"LR+5"}
CHARA_TYPE_NAMES = {1: "物理", 2: "EN", 3: "敏捷"}
ATTR_NAMES = {1: "火", 2: "水", 3: "地", 4: "风", 5: "光", 6: "暗"}

def print_unit_info(unit, data_loader, panel_config=None):
    stype_map = {1: "AS", 2: "PS", 3: "EX"}
    rarity_str = ""
    if panel_config and unit.character_id in panel_config.rarities:
        r = panel_config.rarities[unit.character_id]
        rarity_str = f" [{RARITY_NAMES.get(r, r)}]"
    aff_str = ""
    if panel_config and unit.character_id in panel_config.affection_levels:
        aff_str = f" 好感{panel_config.affection_levels[unit.character_id]}"
    char = data_loader.get_character_by_id(unit.character_id)
    type_name = CHARA_TYPE_NAMES.get(char.character_type if char else 0, "??")
    attr_name = ATTR_NAMES.get(char.attribute if char else 0, "??")
    print(f"  {unit.name} Lv.{unit.level}{rarity_str}{aff_str} [{type_name}/{attr_name}]")
    print(f"    HP={unit.current_hp} ATK={unit.attack} DEF={unit.defense} SPD={unit.speed} "
          f"CRIT={unit.crit_rate:.1%} AP/PP={unit.current_ap}/{unit.current_pp}")
    skills_str = []
    for sid in unit.skills:
        meta = data_loader.get_skill_by_id(sid)
        if meta:
            st = stype_map.get(meta.skill_type, "??")
            lv = 1
            if panel_config and unit.character_id in panel_config.skill_levels:
                lv = panel_config.skill_levels[unit.character_id].get(sid, 1)
            skills_str.append(f"[{st}]{meta.name}(Lv.{lv})")
    print(f"    技能: {', '.join(skills_str)}")


def run_scenario(data_loader, scenario: BattleConfig):
    print(f"\n{'='*70}")
    print(f"  场景: {scenario.name}")
    print(f"  配置: Lv={scenario.panel_config.character_level} 稀有度=LR+5 模块=T9Lv50 装备={'全满' if scenario.panel_config.equipment_enabled else '无'}")
    team = TEAM_CONFIGS[scenario.team_key]
    print(f"  阵容: {len(team['friends'])}v{len(team['enemies'])}")
    print(f"{'='*70}")

    lerp_data = data_loader.load_level_lerp_data()
    stat_calculator = StatCalculator(lerp_data)

    panel_config = build_panel_config(data_loader, scenario.panel_config)
    player_config = panel_config.get_player_config()

    if scenario.runs <= 1:
        run_battle(data_loader, panel_config, player_config, stat_calculator,
                   team["friends"], team["enemies"])
    else:
        run_batch(data_loader, panel_config, player_config, stat_calculator,
                  team["friends"], team["enemies"], scenario.runs)


def _build_units(data_loader, panel_config, player_config, stat_calculator,
                 friends_chars, enemies_chars):
    bf = BattlefieldState()
    friends, enemies = [], []

    for i, cid in enumerate(friends_chars):
        u = create_unit(data_loader, stat_calculator, player_config,
                        panel_config, cid, Side.ALLY, POSITIONS_ALLY[i])
        if u:
            bf.add_unit(u)
            friends.append(u)

    for i, cid in enumerate(enemies_chars):
        u = create_unit(data_loader, stat_calculator, player_config,
                        panel_config, cid, Side.ENEMY, POSITIONS_ENEMY[i])
        if u:
            bf.add_unit(u)
            enemies.append(u)

    return bf, friends, enemies


def run_battle(data_loader, panel_config, player_config, stat_calculator,
               friends_chars, enemies_chars, silent=False):
    bf, friends, enemies = _build_units(
        data_loader, panel_config, player_config, stat_calculator,
        friends_chars, enemies_chars)

    if not silent:
        print(f"\n  我方:")
        for u in friends:
            print_unit_info(u, data_loader, panel_config)
        print(f"  敌方:")
        for u in enemies:
            print_unit_info(u, data_loader, panel_config)

    controller = BattleFlowController(bf, data_loader=data_loader)
    result = controller.execute_battle()

    if not silent:
        _print_battle_result(result, friends, enemies)

    return result, friends, enemies


def _print_battle_result(result, friends, enemies):
    print("\n" + "=" * 60)
    print(f"  结果: {result['result']} | 回合: {result['total_turns']} | 胜者: {result['winner']}")
    print(f"  我方:")
    for u in friends:
        s = f"HP={u.current_hp}/{u.max_hp}" if u.is_alive else "阵亡"
        print(f"    {u.name}: {s} | 伤害:{u.damage_dealt_total} | 行动:{u.action_count_total}")
    print(f"  敌方:")
    for u in enemies:
        s = f"HP={u.current_hp}/{u.max_hp}" if u.is_alive else "阵亡"
        print(f"    {u.name}: {s} | 伤害:{u.damage_dealt_total} | 行动:{u.action_count_total}")
    print("=" * 60)


def run_batch(data_loader, panel_config, player_config, stat_calculator,
              friends_chars, enemies_chars, total_runs):
    from src.utils.batch_simulator import BatchSimulator
    from src.entities_v2.enums import Position

    print(f"\n  批量模拟 {total_runs} 次...")

    char_ids_f = friends_chars
    char_ids_e = enemies_chars
    char_names = {}
    for cid in char_ids_f + char_ids_e:
        char = data_loader.get_character_by_id(cid)
        if char:
            char_names[cid] = char.name

    # 构建位置列表（与_build_units使用相同的POSITIONS_ALLY/ENEMY）
    pos_a = POSITIONS_ALLY[:len(friends_chars)]
    pos_e = POSITIONS_ENEMY[:len(enemies_chars)]

    sim = BatchSimulator(data_loader)

    def progress_cb(done, total):
        pass  # CLI模式不输出进度（由BatchSimulator内部处理）

    result = sim.run_batch(
        panel_config=panel_config,
        friends_chars=friends_chars,
        friend_positions=friends_chars,
        enemies_chars=enemies_chars,
        enemy_positions=enemies_chars,
        total_runs=total_runs,
        positions_ally=pos_a,
        positions_enemy=pos_e,
        progress_callback=progress_cb,
    )

    # 输出统计（保持与原来一致的格式）
    print(f"\n{'='*70}")
    print(f"  📊 批量模拟统计 ({result.total_runs}场, {result.elapsed:.1f}秒, {result.rate:.1f}场/秒)")
    print(f"{'='*70}")

    print(f"  胜率: {result.wins}/{result.total_runs} = {result.win_rate:.1f}%")
    print(f"  回合: 平均{result.avg_turns:.1f} | 最少{result.min_turns} | 最多{result.max_turns}")

    def _avg(lst):
        return sum(lst) / len(lst) if lst else 0

    print(f"\n  {'角色':<20} {'阵营':<4} {'平均伤害':>10} {'最大伤害':>10} {'平均行动':>8} {'存活率':>8}")
    print(f"  {'-'*20} {'-'*4} {'-'*10} {'-'*10} {'-'*8} {'-'*8}")

    for cid in char_ids_f + char_ids_e:
        name = char_names.get(cid, str(cid))
        side = "我方" if cid in char_ids_f else "敌方"
        dmg_list = result.char_dmg.get(cid, [0])
        act_list = result.char_actions.get(cid, [0])
        surv = result.char_survivals.get(cid, 0)
        death = result.char_deaths.get(cid, 0)
        surv_rate = surv / (surv + death) * 100 if (surv + death) else 0
        print(f"  {name:<20} {side:<4} {_avg(dmg_list):>10.0f} {max(dmg_list):>10} {_avg(act_list):>8.1f} {surv_rate:>7.1f}%")


def main():
    scenario_key = DEFAULT_SCENARIO
    if len(sys.argv) > 1:
        scenario_key = sys.argv[1]

    scenario = BATTLE_SCENARIOS.get(scenario_key)
    if scenario is None:
        print(f"未知场景 '{scenario_key}'，可选: {list(BATTLE_SCENARIOS.keys())}")
        return

    data_loader = DataLoader()
    data_loader.load_all()
    resolver = SkillDataResolver(data_loader)

    print("\n" + "=" * 70)
    print("  MGGBattleSimulation - 战斗模拟器")
    print("  场景: " + ", ".join(BATTLE_SCENARIOS.keys()))
    print("=" * 70)
    print(f"\n  已加载 {len(CHARS_TO_LOAD)} 个角色:")
    for cid in CHARS_TO_LOAD:
        char = data_loader.get_character_by_id(cid)
        if char:
            skills = data_loader.load_character_skills().get(cid, [])
            parts = []
            for sid in skills:
                r = resolver.resolve(sid, 1)
                if r:
                    parts.append(f"[{'EX' if r.skill_type==3 else 'AS' if r.skill_type==1 else 'PS'}]{r.name}(pwr={r.power:.0f})")
            print(f"    [{cid}] {char.name} | ATK:{char.max_level_stats.attack} | " + ", ".join(parts))

    run_scenario(data_loader, scenario)


if __name__ == "__main__":
    main()