#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""回归测试: シャドウグー(230491)味方累計ダメージ触发 + enemy_random逐步暴击分支决策

Bug日志: step_crit_console_circle_20261011_133630.txt (L496, L596)
  フロニュート PS2 シャドウグー(230491)「他の味方が累計で最大HP×25%のダメージを
  受けるたびに発動」。ヴィーヴル被ストレラ(PS)一击致死(-316458 ≫ 25%阈值11619)，
  但 [ALLY_CUMULATIVE_DMG] 检查完全没有运行——PS2未触发。

根因(两层):
  1. battle_flow_controller PS伤害后的累计重查( _execute_trigger_actions /
     _execute_global_trigger_actions )用 `_u.is_alive` 过滤掉了被一击致死的被弹单位
  2. trigger_service.trigger_cumulative_damage 循环开头 `if not unit.is_alive: continue`
     也跳过死亡单位——味方累計扫描随之被跳过（PS所有者フロニュート明明存活）

Fix:
  - 直接型(自身の累計)保持死亡不触发；味方累計型扫描覆盖死亡被弹单位
  - PS重查两处放行死亡单位（per_hit_reset仅对存活单位计算）
  - 再装填：味方累計PS执行成功/PP不足后，被弹单位(triggered_by)计数器同步重置
    （否则阈值超期间每次受击都会再触发，违背「たびに」分块语义）

另外: PS2 Block1 add_status target_type=enemy_random（ランダムな敵単体に暗闇）原先
  走 _resolve_target_range 的 ONE_PAWN 兜底=固定选最近敌人。现改为全生存敌人
  一様随机，并接入逐步暴击分支决策（_random_draw_override_func,
  decision_type='enemy_random'，GUI复用random_draw候选按钮通道）。
"""
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(ROOT))

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig
from src.combat_v2.services.trigger_service import TriggerAction, TriggerInstance

SHADOWUGU = 230491   # シャドウグー（味方累計25% → 敵ランダム暗闇）
STRELA = 130184      # ストレラ（PS追撃damage，复现日志中的PS一击致死）
DARKNESS = SkillEffectType.DARKNESS.value


def _build():
    bb = BattleBuilder()
    # 玩家侧：ストレラ持有者（土4→block1执行；AP≥2满足global_condition安全网）
    bb.add_ally(unit_id="strela_user", hp=100000, atk=100000, defense=5000,
                speed=1200, element=4, skills=[STRELA], pp=10, ap=10,
                position=Position.ALLY_LEFT_FRONT)
    # 第二个玩家单位：使enemy_random候选≥2，override选择才有意义
    bb.add_ally(unit_id="bystander", hp=80000, atk=5000, defense=5000,
                speed=1000, element=1, pp=10,
                position=Position.ALLY_RIGHT_BACK)
    # 敌方：PS2持有者（远离）+ 累计伤害目标（玩家正对面，最近→被ストレラ选中）
    bb.add_enemy(unit_id="holder", hp=50000, atk=5000, defense=5000, speed=900,
                 element=2, skills=[SHADOWUGU], pp=10,
                 position=Position.ENEMY_RIGHT_BACK)
    bb.add_enemy(unit_id="victim", hp=20000, atk=5000, defense=100, speed=800,
                 element=3, position=Position.ENEMY_LEFT_FRONT)
    ctx = bb.build()
    bf = ctx['bf']
    # 玩家单位HP压到40%：PS2 block2(status_target_hp_above=50)不回PP，PP断言稳定
    for u in ctx['allies']:
        u.current_hp = int(u.max_hp * 0.4)
    bfc = BattleFlowController(bf, config=BattleConfig(max_turns=3, enable_rdps=False),
                               data_loader=ctx['services']['dl'])
    bfc.skill_service.set_battlefield(bf)
    return ctx, bf, bfc


def test_ps2_triggers_when_ally_one_shot_by_ps():
    """友方被PS一击致死也触发味方累計PS2（复现日志133630的核心场景）"""
    ctx, bf, bfc = _build()
    holder = ctx['enemies'][0]
    victim = ctx['enemies'][1]
    player = ctx['allies'][0]

    action = TriggerAction(skill_id=STRELA, owner_id=player.unit_id, action_type='ps',
                           parameters={},
                           instance=TriggerInstance(skill_id=STRELA, owner=player,
                                                    priority=100))
    bfc._execute_trigger_actions([action], player)

    assert not victim.is_alive, "victim应被ストレラ一击致死"
    assert holder.current_pp == 9, (
        f"シャドウグー应在友方累計25%到达时触发（实际PP={holder.current_pp}，应消耗1）")
    darkened = [u for u in bf.friend_team
                for d in u.debuffs if d.effect_type == DARKNESS]
    assert darkened, "シャドウグー应给随机敌方（玩家单位）施加暗闇"
    # 再装填：被弹单位（已死亡）的计数器同步重置
    assert victim.cumulative_hp_damage == 0, \
        "PS2触发后被弹单位累计计数器应重置（たびに=按25%分块再装填）"


def test_ally_cumulative_rearm_prevents_refire():
    """再装填语义：触发一次后被弹单位计数器重置，未达新阈值不再触发"""
    ctx, bf, bfc = _build()
    holder = ctx['enemies'][0]
    victim = ctx['enemies'][1]
    victim.cumulative_hp_damage = 6000  # ≥ 25%×20000=5000

    actions = bfc.trigger_service.trigger_cumulative_damage(bf, [victim])
    hit = [a for a in actions if a.skill_id == SHADOWUGU]
    assert hit, "累計25%到达应收集到シャドウグー"
    assert hit[0].parameters.get('cumulative_triggered_by') is victim, \
        "action应携带被弹单位（供PS执行后重置计数器）"

    bfc._execute_trigger_actions(hit, victim)
    assert holder.current_pp == 9, "PS2应消耗1PP"
    assert victim.cumulative_hp_damage == 0, "PS成功后被弹单位计数器应重置为0"

    actions2 = bfc.trigger_service.trigger_cumulative_damage(bf, [victim])
    assert not [a for a in actions2 if a.skill_id == SHADOWUGU], \
        "再装填后（计数器已清零）不应再次收集シャドウグー"


def test_enemy_random_uses_step_crit_override():
    """enemy_random接入逐步暴击分支决策：override选择生效且decision_type透传"""
    ctx, bf, bfc = _build()
    victim = ctx['enemies'][1]
    victim.cumulative_hp_damage = 6000

    captured = {}

    def _override(ctxdata):
        captured.update(ctxdata)
        return 1  # 用户选择第2个候选

    bfc.skill_service.set_random_draw_override(_override)
    try:
        actions = bfc.trigger_service.trigger_cumulative_damage(bf, [victim])
        hit = [a for a in actions if a.skill_id == SHADOWUGU]
        assert hit, "累計25%到达应收集到シャドウグー"
        bfc._execute_trigger_actions(hit, victim)
    finally:
        bfc.skill_service.clear_random_draw_override()

    assert captured.get('decision_type') == 'enemy_random', (
        f"决策点类型应为enemy_random，实际={captured.get('decision_type')}")
    assert captured.get('candidates'), "决策点应携带候选单位列表"
    chosen_name = captured['candidates'][1]['target_name']
    darkened = [u for u in bf.friend_team
                for d in u.debuffs if d.effect_type == DARKNESS]
    assert len(darkened) == 1, f"暗闇应只施加给1个目标，实际={len(darkened)}"
    assert darkened[0].name == chosen_name, (
        f"暗闇目标应为override选择的{chosen_name}，实际={darkened[0].name}")
