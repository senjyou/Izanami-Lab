"""测试回忆卡30035技能400226每回合开始时是否正确提升攻击力

技能400226: ターン開始時に発動。コミカル属性とクレバー属性の味方の攻撃力を1000上昇させる
trigger: turn_start
target: highlight_targets (character_attribute=5[コミカル] + character_attribute=6[クレバー])
value: 1000, value_tag=1(固定值), is_buff=true, duration=-1(永续)
"""
import sys
import os

os.chdir(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
sys.path.insert(0, os.getcwd())

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.entities.memory_card import MemoryCard
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.battle_flow_controller import BattleFlowController


def create_ally(cid, name, element, position):
    """创建友方单位"""
    char = dl.get_character_by_id(cid)
    if char:
        stats = char.max_level_stats
        base_atk = stats.attack
        base_hp = stats.hp
        base_def = stats.defense
        base_spd = stats.speed
    else:
        base_atk = 500
        base_hp = 10000
        base_def = 300
        base_spd = 200
    return UnitState(
        unit_id=f"ally_{cid}", name=name, side=Side.ALLY,
        position=position, character_id=cid, level=60,
        element=element, character_type=1,
        max_hp=base_hp, current_hp=base_hp,
        attack=base_atk, defense=base_def, speed=base_spd,
        crit_rate=5.0, crit_damage=50.0, advantage_damage=0.0,
        initial_active_point=3, initial_passive_point=3, max_extra_point=5,
        current_ap=3, current_pp=3, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


dl = DataLoader()
dl.load_all()

# 创建友方: 100302(光/コミカル), 115301(暗/クレバー), 以及一个非匹配属性角色
ally_comical = create_ally(100302, "フラットスピン(コミカル)", 5, Position.ALLY_LEFT_FRONT)
ally_clever = create_ally(115301, "一匹狼(クレバー)", 6, Position.ALLY_CENTER_FRONT)
ally_other = create_ally(100101, "其他属性角色", 1, Position.ALLY_RIGHT_FRONT)  # 火属性，不应被buff

# 创建敌方木桩
enemy = UnitState(
    unit_id="enemy_front", name="敌方木桩", side=Side.ENEMY,
    position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=1,
    element=1, character_type=1,
    max_hp=999999, current_hp=999999,
    attack=10, defense=0, speed=50,
    crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
    initial_active_point=0, initial_passive_point=0, max_extra_point=0,
    current_ap=0, current_pp=0, current_ep=0,
    skills=[], skill_levels={}, skill_cooldowns={},
)

bf = BattlefieldState()
bf.friend_team = [ally_comical, ally_clever, ally_other]
bf.enemy_team = [enemy]

# 装备回忆卡30035
mem_data = dl.load_memories()
mem_info = mem_data.get(30035)
if mem_info:
    card = MemoryCard(
        card_id=30035,
        name=mem_info.name,
        description=mem_info.description,
        rarity=mem_info.rarity,
        highlights=mem_info.highlights,
    )
    bf.memory_cards = [card]
    print(f"已装备回忆卡: {mem_info.name} (ID=30035)")
    print(f"  highlights数量: {len(mem_info.highlights)}")
    for i, hl in enumerate(mem_info.highlights):
        print(f"    [{i}] skill={hl.skill_master_id}, attr={hl.character_attribute}, pos={hl.party_position}")
else:
    print("ERROR: 回忆卡30035未找到!")
    sys.exit(1)

dms = DamageService()
aus = AuraService()
controller = BattleFlowController(bf, dl)
controller.damage_service = dms
controller.aura_service = aus

# 记录基础攻击力
base_atk_comical = ally_comical.attack
base_atk_clever = ally_clever.attack
base_atk_other = ally_other.attack
print(f"\n=== 基础攻击力 ===")
print(f"  コミカル({ally_comical.name}): {base_atk_comical}")
print(f"  クレバー({ally_clever.name}): {base_atk_clever}")
print(f"  其他属性({ally_other.name}): {base_atk_other}")

# 模拟3个回合的turn_start触发
NUM_TURNS = 3
for turn in range(1, NUM_TURNS + 1):
    bf.turn_number = turn
    print(f"\n=== 第{turn}回合开始 ===")

    # 记录触发前的攻击力
    atk_before_comical = dms._calculate_final_stat(ally_comical, "attack")
    atk_before_clever = dms._calculate_final_stat(ally_clever, "attack")
    atk_before_other = dms._calculate_final_stat(ally_other, "attack")
    print(f"  触发前攻击力: コミカル={atk_before_comical}, クレバー={atk_before_clever}, 其他={atk_before_other}")

    # 触发turn_start回忆卡效果
    controller._apply_memory_card_effects_by_trigger("turn_start")

    # 记录触发后的攻击力
    atk_after_comical = dms._calculate_final_stat(ally_comical, "attack")
    atk_after_clever = dms._calculate_final_stat(ally_clever, "attack")
    atk_after_other = dms._calculate_final_stat(ally_other, "attack")
    print(f"  触发后攻击力: コミカル={atk_after_comical}, クレバー={atk_after_clever}, 其他={atk_after_other}")

    # 计算增量
    delta_comical = atk_after_comical - atk_before_comical
    delta_clever = atk_after_clever - atk_before_clever
    delta_other = atk_after_other - atk_before_other
    print(f"  攻击力增量:   コミカル=+{delta_comical}, クレバー=+{delta_clever}, 其他=+{delta_other}")

    # 统计buff数量
    buff_count_comical = len([b for b in ally_comical.buffs if getattr(b, 'is_memory_buff', False)])
    buff_count_clever = len([b for b in ally_clever.buffs if getattr(b, 'is_memory_buff', False)])
    buff_count_other = len([b for b in ally_other.buffs if getattr(b, 'is_memory_buff', False)])
    print(f"  记忆卡buff数: コミカル={buff_count_comical}, クレバー={buff_count_clever}, 其他={buff_count_other}")

# 最终验证
print(f"\n=== 最终验证（{NUM_TURNS}回合后）===")
final_atk_comical = dms._calculate_final_stat(ally_comical, "attack")
final_atk_clever = dms._calculate_final_stat(ally_clever, "attack")
final_atk_other = dms._calculate_final_stat(ally_other, "attack")

expected_comical = base_atk_comical + 1000 * NUM_TURNS
expected_clever = base_atk_clever + 1000 * NUM_TURNS
expected_other = base_atk_other

print(f"  コミカル: 基础={base_atk_comical} → 最终={final_atk_comical} (期望={expected_comical}, 增量={final_atk_comical - base_atk_comical})")
print(f"  クレバー: 基础={base_atk_clever} → 最终={final_atk_clever} (期望={expected_clever}, 增量={final_atk_clever - base_atk_clever})")
print(f"  其他属性: 基础={base_atk_other} → 最终={final_atk_other} (期望={expected_other}, 增量={final_atk_other - base_atk_other})")

ok = True
if final_atk_comical != expected_comical:
    print(f"  [FAIL] コミカル攻击力不匹配! 期望={expected_comical}, 实际={final_atk_comical}")
    ok = False
else:
    print(f"  [PASS] コミカル每回合+1000, {NUM_TURNS}回合后共+{1000 * NUM_TURNS}")

if final_atk_clever != expected_clever:
    print(f"  [FAIL] クレバー攻击力不匹配! 期望={expected_clever}, 实际={final_atk_clever}")
    ok = False
else:
    print(f"  [PASS] クレバー每回合+1000, {NUM_TURNS}回合后共+{1000 * NUM_TURNS}")

if final_atk_other != expected_other:
    print(f"  [FAIL] 其他属性不应被buff! 期望={expected_other}, 实际={final_atk_other}")
    ok = False
else:
    print(f"  [PASS] 其他属性未被buff")

if ok:
    print(f"\n>>> 全部验证通过! 回忆卡30035技能400226每回合开始时正确提升コミカル/クレバー属性角色攻击力+1000")
else:
    print(f"\n>>> 验证失败! 存在不匹配项")
