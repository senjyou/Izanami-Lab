"""敌方761305 惨禍：ニーナ／ジーナ・ミーシナ 专项E2E测试（同名己方147301的敌方版）

技能列表（5个，全部Lv10）:
- EX: 210127 双鏡の連理（敵全体攻击 + 自身atk_down20%1行动 + 阻止atk_up2行动；HP>=50%时AP+1）
- AS1: 220466 断罪の時だ！（单体1hit + 目标每枚刻痕+1hit(上限+9)；HP<=50%时2行动HOT=付与时不足HP的1.25%快照）
- AS2: 220467 軍靴の調べにすくめ！（刻痕最少之敌所在横一列 + 刻痕x1，上限4，atk-8%/与damage-5%）
- PS1: 230496 終幕にはまだ早い！（HP<=50%跨越触发 → debuff_immune + Lv5+ 1hit伤害无效化；敌方无同排扩展）
- PS2: 230497 我が雄姿を見よ！+（自身AS攻击前 → 附魔威力53伤害 + 攻击目标1行动刻痕；前排限定，同時発動制限）

覆盖维度:
1. EX 敌全体（敌方视角=friend_team）+自封debuff+条件AP
2. AS1 hit数随刻痕增加与上限；HOT快照（Lv10, cure=1.25%）
3. AS2 横列刻痕付与（上限4、每层属性减益、锚点=刻痕最少）
4. PS1 50%跨越触发（敌方caster）；Lv10只走无效化分支
5. PS2 自身攻击前附魔+刻痕；后排不触发
6. 配置校验
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

MARK = SkillEffectType.MARK.value
HEAL_OVER_TIME = SkillEffectType.HEAL_OVER_TIME.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
DMG_INVULNERABLE = SkillEffectType.DMG_INVULNERABLE.value

KENKON = "刻痕"
KENKON_RULES = [
    {"mark_name": KENKON, "stat": "attack", "per_mark_pct": -8},
    {"mark_name": KENKON, "stat": "dealt_damage", "per_mark_pct": -5},
]

EX_ID, AS1_ID, AS2_ID, PS1_ID, PS2_ID = 210127, 220466, 220467, 230496, 230497
ALL_SKILLS = [EX_ID, AS1_ID, AS2_ID, PS1_ID, PS2_ID]


def _mk_kenkon(unit, n, source_id="src"):
    """向unit添加n个「刻痕」独立实例（含属性减益规则）。"""
    for i in range(n):
        unit.debuffs.append(BuffState(
            buff_id=f"{source_id}_kenkon_{unit.unit_id}_{i}", name=KENKON,
            effect_type=MARK, value=0, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=source_id, source_skill_id=0, is_debuff=True,
            stack_count=1, is_memory_buff=False, mark_stat_bonus=KENKON_RULES,
        ))


def _kenkon_count(unit):
    return sum(getattr(b, 'stack_count', 1) or 1 for b in unit.buffs + unit.debuffs
               if b.effect_type == MARK and b.name == KENKON)


class TestActor761305(unittest.TestCase):

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()
        cls.dms = DamageService()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 敌方施法者（演习BOSS视角）
        self.caster = UnitState(
            unit_id="caster", name="惨禍ミーシナ", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=761305, level=10,
            element=2, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=5,
            skills=ALL_SKILLS,
            skill_levels={sid: 10 for sid in ALL_SKILLS},
            skill_cooldowns={},
        )
        self.enemy_lf = self._mk_minion("enemy_lf", "敵左前", Position.ENEMY_LEFT_FRONT)
        # friend_team（敌方caster的攻击目标侧）
        self.ally_cf = self._mk_ally("ally_cf", "味方中前", Position.ALLY_CENTER_FRONT)
        self.ally_lf = self._mk_ally("ally_lf", "味方左前", Position.ALLY_LEFT_FRONT)
        self.ally_rf = self._mk_ally("ally_rf", "味方右前", Position.ALLY_RIGHT_FRONT)
        self.ally_cb = self._mk_ally("ally_cb", "味方中後", Position.ALLY_CENTER_BACK)

        self.bf.enemy_team = [self.caster, self.enemy_lf]
        self.bf.friend_team = [self.ally_cf, self.ally_lf, self.ally_rf, self.ally_cb]

        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs, damage_service=self.dms,
            aura_service=self.aus, status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _mk_minion(self, unit_id, name, position):
        return UnitState(
            unit_id=unit_id, name=name, side=Side.ENEMY,
            position=position, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    def _mk_ally(self, unit_id, name, position):
        return UnitState(
            unit_id=unit_id, name=name, side=Side.ALLY,
            position=position, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    def _reset(self):
        self.caster.current_hp = self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = 10
        self.caster.current_pp = 10
        self.caster.current_ep = 5
        self.caster.crit_counter = 0
        self.caster.position = Position.ENEMY_CENTER_FRONT
        self.caster.prev_hp_percent = 100.0
        for u in [self.ally_cf, self.ally_lf, self.ally_rf, self.ally_cb, self.enemy_lf]:
            u.current_hp = u.max_hp
            u.buffs = []
            u.debuffs = []
            u.is_alive = True

    # ─────────────── EX 210127 ───────────────

    def test_ex_210127_all_attack_and_self_debuffs(self):
        """EX: 敌方caster对friend_team全体攻击+自身atk_down/阻止atk_up。"""
        self._reset()
        hp_before = {u.unit_id: u.current_hp
                     for u in [self.ally_cf, self.ally_lf, self.ally_rf, self.ally_cb]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=EX_ID,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for uid, before in hp_before.items():
            unit = next(u for u in self.bf.friend_team if u.unit_id == uid)
            self.assertLess(unit.current_hp, before, f"{uid} 应受全体攻击")
        # 自身debuff: atk_down(1行动) + block_buff_by_type(2行动)
        debuff_types = [d.effect_type for d in self.caster.debuffs]
        self.assertIn(STATUS_ATTACK, debuff_types, "应获得atk_down 20%")
        atk_down = next(d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK)
        self.assertEqual(atk_down.duration, 1)
        blocker = [b for b in self.caster.buffs + self.caster.debuffs
                   if b.effect_type == "BlockBuffByType"]
        self.assertEqual(len(blocker), 1, "应获得阻止atk_up的debuff(2行动)")
        if blocker:
            self.assertEqual(blocker[0].duration, 2)

    def test_ex_210127_ap_gain_only_above_50pct(self):
        """EX: HP>=50%时AP+1；<50%时不变（当前AP低于上限才有提升空间）。"""
        self._reset()
        self.caster.current_ap = 5
        self.ss.execute_skill(caster=self.caster, skill_id=EX_ID,
                              battlefield=self.bf, skip_cost=True)
        self.assertEqual(self.caster.current_ap, 6, "满血使用EX应AP+1")
        self._reset()
        self.caster.current_ap = 5
        self.caster.current_hp = int(self.caster.max_hp * 0.4)  # 40% < 50%
        self.ss.execute_skill(caster=self.caster, skill_id=EX_ID,
                              battlefield=self.bf, skip_cost=True)
        self.assertEqual(self.caster.current_ap, 5, "HP<50%时AP不变")

    # ─────────────── AS1 220466 ───────────────

    def test_as1_hit_count_per_kenkon(self):
        """AS1: hit数=1+目标刻痕数（3枚→4hit），无刻痕1hit。"""
        self._reset()
        self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                              battlefield=self.bf, skip_cost=True)
        dmg_0 = self.ally_cf.max_hp - self.ally_cf.current_hp
        self._reset()
        _mk_kenkon(self.ally_cf, 3, "pre")
        self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                              battlefield=self.bf, skip_cost=True)
        dmg_3 = self.ally_cf.max_hp - self.ally_cf.current_hp
        self.assertAlmostEqual(dmg_3, dmg_0 * 4, delta=max(10, dmg_0 * 0.3),
                               msg="3枚刻痕应4hit（伤害≈4倍）")

    def test_as1_hit_cap_9_extra(self):
        """AS1: 刻痕12枚时hit数封顶10（1+9）。"""
        self._reset()
        self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                              battlefield=self.bf, skip_cost=True)
        dmg_0 = self.ally_cf.max_hp - self.ally_cf.current_hp
        self._reset()
        _mk_kenkon(self.ally_cf, 12, "pre")
        self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                              battlefield=self.bf, skip_cost=True)
        dmg_12 = self.ally_cf.max_hp - self.ally_cf.current_hp
        self.assertAlmostEqual(dmg_12, dmg_0 * 10, delta=max(20, dmg_0 * 0.6),
                               msg="12枚刻痕应封顶10hit")

    def test_as1_hot_snapshot_at_low_hp(self):
        """AS1: HP<=50%时付与HOT，快照=付与时不足HP的1.25%（Lv10 cure）。"""
        self._reset()
        self.caster.current_hp = int(self.caster.max_hp * 0.4)  # 40% <= 50%
        lost = self.caster.max_hp - self.caster.current_hp
        result = self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        hots = [b for b in self.caster.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hots), 1, "HP<=50%应获得1个HOT")
        hot = hots[0]
        self.assertEqual(hot.duration, 2, "HOT应持续2行动")
        self.assertGreaterEqual(hot.hot_base_snapshot, 0, "应为快照模式")
        self.assertEqual(hot.hot_base_snapshot, lost,
                         f"快照基数应为付与时不足HP({lost})，每tick按其×1.25%回复")

    def test_as1_no_hot_above_50pct(self):
        """AS1: HP>50%时不付与HOT。"""
        self._reset()
        self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                              battlefield=self.bf, skip_cost=True)
        hots = [b for b in self.caster.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertEqual(len(hots), 0, "HP>50%不应有HOT")

    # ─────────────── AS2 220467 ───────────────

    def test_as2_row_damage_and_kenkon(self):
        """AS2: 锚点=刻痕最少之敌所在横一列（friend前排3体）+刻痕x1。"""
        self._reset()
        hp_before = {u.unit_id: u.current_hp
                     for u in [self.ally_cf, self.ally_lf, self.ally_rf, self.ally_cb]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=AS2_ID,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for uid in ("ally_cf", "ally_lf", "ally_rf"):
            unit = next(u for u in self.bf.friend_team if u.unit_id == uid)
            self.assertLess(unit.current_hp, hp_before[uid], f"{uid} 前排应受攻击")
            self.assertEqual(_kenkon_count(unit), 1, f"{uid} 应获得刻痕x1")
        self.assertEqual(self.ally_cb.current_hp, hp_before["ally_cb"],
                         "后排不应受攻击")
        self.assertEqual(_kenkon_count(self.ally_cb), 0, "后排不应获得刻痕")
        # 每层刻痕 → ATK-8%
        atk_after = self.dms._calculate_final_stat(self.ally_cf, "attack")
        self.assertAlmostEqual(atk_after, self.ally_cf.attack * 0.92, delta=2,
                               msg="刻痕1枚应ATK-8%")

    def test_as2_kenkon_cap_4(self):
        """AS2: 已有4枚刻痕的单位不再付与（上限4）。"""
        self._reset()
        _mk_kenkon(self.ally_cf, 4, "pre")
        self.ss.execute_skill(caster=self.caster, skill_id=AS2_ID,
                              battlefield=self.bf, skip_cost=True)
        self.assertEqual(_kenkon_count(self.ally_cf), 4, "已4枚应保持4枚（不再付与）")
        self.assertEqual(_kenkon_count(self.ally_lf), 1, "其他前排仍应获得1枚")

    # ─────────────── PS1 230496 ───────────────

    def test_ps1_230496_trigger_at_50pct_crossing(self):
        """PS1: HP跨越50%阈值（60%→40%）触发；Lv10走无效化分支。"""
        self._reset()
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.caster.prev_hp_percent = 60.0
        actions = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1 = [a for a in actions if a.skill_id == PS1_ID]
        self.assertGreater(len(ps1), 0, "跨越50%应触发PS1")
        self.ss._execute_trigger_actions_inline(ps1, self.bf)
        immune = [b for b in self.caster.buffs if b.effect_type == "debuff_immune"]
        self.assertGreaterEqual(len(immune), 1, "应获得debuff_immune")
        invuln = [b for b in self.caster.buffs if b.effect_type == DMG_INVULNERABLE]
        self.assertEqual(len(invuln), 1, "Lv10应获得1hit伤害无效化")
        downs = [b for b in self.caster.buffs if b.effect_type == "dmg_taken_down"]
        self.assertEqual(len(downs), 0, "Lv10不应有减伤分支（level_max=4）")

    def test_ps1_230496_no_trigger_above_50pct(self):
        """PS1: HP未跨越50%（100%→80%）不触发。"""
        self._reset()
        self.caster.current_hp = int(self.caster.max_hp * 0.8)
        self.caster.prev_hp_percent = 100.0
        actions = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1 = [a for a in actions if a.skill_id == PS1_ID]
        self.assertEqual(len(ps1), 0, "未跨越50%不应触发")

    # ─────────────── PS2 230497 ───────────────

    def test_ps2_230497_enchant_on_own_attack(self):
        """PS2: 自身AS攻击前触发 → 附魔追伤+攻击目标刻痕1行动。"""
        self._reset()
        # 基线：无PS2直接AS1
        self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                              battlefield=self.bf, skip_cost=True)
        dmg_base = self.ally_cf.max_hp - self.ally_cf.current_hp
        # 带PS2
        self._reset()
        actions = self.ts.trigger_before_skill_use(self.caster, AS1_ID, self.bf)
        ps2 = [a for a in actions if a.skill_id == PS2_ID]
        self.assertGreater(len(ps2), 0, "自身AS攻击前应触发PS2")
        self.ss._execute_trigger_actions_inline(ps2, self.bf)
        self.ss.execute_skill(caster=self.caster, skill_id=AS1_ID,
                              battlefield=self.bf, skip_cost=True)
        dmg_with = self.ally_cf.max_hp - self.ally_cf.current_hp
        self.assertGreater(dmg_with, dmg_base, "附魔应增加伤害")
        # 攻击目标获得1行动刻痕
        self.assertEqual(_kenkon_count(self.ally_cf), 1, "攻击目标应获得刻痕x1")
        marks = [b for b in self.ally_cf.debuffs
                 if b.effect_type == MARK and b.name == KENKON]
        self.assertTrue(marks and marks[0].duration == 1, "刻痕应为1行动")

    def test_ps2_230497_back_row_no_trigger(self):
        """PS2: 自身在后排时不触发。"""
        self._reset()
        self.caster.position = Position.ENEMY_CENTER_BACK
        actions = self.ts.trigger_before_skill_use(self.caster, AS1_ID, self.bf)
        ps2 = [a for a in actions if a.skill_id == PS2_ID]
        self.assertEqual(len(ps2), 0, "后排不应触发PS2")

    def test_ps2_230497_no_trigger_on_ex(self):
        """PS2: EX技能使用前不触发（仅アクティブスキル）。"""
        self._reset()
        actions = self.ts.trigger_before_skill_use(self.caster, EX_ID, self.bf)
        ps2 = [a for a in actions if a.skill_id == PS2_ID]
        self.assertEqual(len(ps2), 0, "EX使用前不应触发（battle_flow仅对非EX调用，此处防御校验）")

    # ─────────────── 配置校验 ───────────────

    def test_config_validation(self):
        """配置校验: 敌方版阈值/触发/无同排扩展。"""
        p466 = self.dl.get_parsed_skill_data(AS1_ID)
        hots = [e for b in p466['effect_blocks'] for e in b['effects']
                if e['effect_type'] == 'heal_over_time']
        self.assertTrue(hots, "220466应有HOT")
        self.assertEqual(hots[0]['flags'].get('level_min'), 10, "敌方HOT进阶阈值应为10")
        self.assertTrue(hots[0]['flags'].get('heal_base_snapshot'), "HOT应为快照模式")
        dmgs = [e for b in p466['effect_blocks'] for e in b['effects']
                if e['effect_type'] == 'damage']
        self.assertEqual(dmgs[0]['flags']['hit_count_per_mark']['mark_name'], KENKON)
        self.assertEqual(dmgs[0]['flags']['hit_count_per_mark']['max_extra'], 9)

        p496 = self.dl.get_parsed_skill_data(PS1_ID)
        self.assertEqual(p496['trigger_type'], 'on_hp_below')
        gc = p496.get('global_condition') or {}
        self.assertEqual(gc.get('type'), 'self_hp_percent')
        self.assertEqual(gc.get('value'), 50, "敌方PS1阈值应为50%")
        self.assertEqual(len(p496['effect_blocks']), 1, "敌方PS1应只有1个block（无同排扩展）")
        effects = p496['effect_blocks'][0]['effects']
        invuln = [e for e in effects if e['effect_type'] == 'dmg_invulnerable']
        self.assertEqual(invuln[0]['flags'].get('level_min'), 5, "无效化应Lv5+")
        downs = [e for e in effects if e['effect_type'] == 'dmg_taken_down']
        self.assertEqual(downs[0]['flags'].get('level_max'), 4, "减伤应Lv1-4")

        p497 = self.dl.get_parsed_skill_data(PS2_ID)
        self.assertEqual(p497['trigger_type'], 'before_skill_use', "敌方PS2应触发自身攻击前")
        self.assertTrue(p497.get('simultaneous_limit'), "应保留同時発動制限")
        gc497 = p497.get('global_condition') or {}
        self.assertEqual(gc497.get('type'), 'self_is_front_row')
        effs = [e for b in p497['effect_blocks'] for e in b['effects']]
        enchant = [e for e in effs if e['effect_type'] == 'add_damage_to_attack']
        self.assertEqual(enchant[0].get('target_type'), 'self', "附魔目标应为self")
        marks = [e for e in effs if e['effect_type'] == 'mark']
        self.assertEqual(marks[0]['flags']['mark_name'], KENKON)
        self.assertEqual(marks[0].get('duration'), 1)

        p127 = self.dl.get_parsed_skill_data(EX_ID)
        b2 = p127['effect_blocks'][1]
        self.assertEqual(b2.get('condition'), {'type': 'self_hp_above', 'value': 50})
        self.assertEqual(b2['effects'][0]['effect_type'], 'add_ap')

        p467 = self.dl.get_parsed_skill_data(AS2_ID)
        marks467 = [e for b in p467['effect_blocks'] for e in b['effects']
                    if e['effect_type'] == 'mark']
        self.assertEqual(marks467[0]['flags'].get('max_stacks'), 4)
        self.assertTrue(marks467[0]['flags'].get('source_death_remove'))


if __name__ == '__main__':
    unittest.main()
