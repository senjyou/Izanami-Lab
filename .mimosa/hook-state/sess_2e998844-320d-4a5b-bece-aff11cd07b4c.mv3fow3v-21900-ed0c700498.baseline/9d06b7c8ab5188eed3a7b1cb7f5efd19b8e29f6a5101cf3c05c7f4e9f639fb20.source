    def test_ps1_removes_one_debuff(self):
        """PS1(130164) Block1: remove_debuff(1) 解除1个debuff。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 施加2个debuff
        for i in range(2):
            db = BuffState(
                buff_id=f"test_db_{i}",
                name=f"test_atk_down_{i}",
                effect_type=STATUS_ATTACK,
                value=10.0,
                duration=3,
                timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
                source_unit_id="enemy_cf",
                source_skill_id=999999,
                caster_attack=0,
                is_debuff=True,
            )
            self.aus.add_aura(self.caster, db)

        debuff_count_before = len(self.caster.debuffs)
        self.assertEqual(debuff_count_before, 2, "前置：应有2个debuff")

        # 触发 PS1
        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.caster.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={STATUS_ATTACK},
        )
        ps1_actions = [a for a in actions if a.skill_id == 130164]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_debuff_applied"
        )

        # remove_debuff(1) 应解除1个debuff，但PS1又施加atk_down(7.5%)
        # 所以净变化: -1(remove) + 1(atk_down from sub_unit) = 0 或 +1
        # 注意：PS1的sub_unit_target_debuffs会在创建子单位后施加减攻
        # remove_debuff移除LIFO最后一个debuff
        # 验证：至少移除了1个原始debuff
        original_debuffs = [d for d in self.caster.debuffs
                            if d.buff_id.startswith("test_db_")]
        self.assertLess(len(original_debuffs), 2,
                        "PS1应移除至少1个原始debuff")

    def test_ps1_creates_sub_unit(self):
        """PS1(130164) Block2: 创建1个「うみのともだちⅠ」子单位 + holder_debuffs。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 施加debuff触发PS1
        test_debuff = BuffState(
            buff_id="test_db_ps1",
            name="test_atk_down",
            effect_type=STATUS_ATTACK,
            value=10.0,
            duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="enemy_cf",
            source_skill_id=999999,
            caster_attack=0,
            is_debuff=True,
        )
        self.aus.add_aura(self.caster, test_debuff)

        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.caster.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={STATUS_ATTACK},
        )
        ps1_actions = [a for a in actions if a.skill_id == 130164]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_debuff_applied"
        )

        # 验证子单位创建
        sub_buffs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(sub_buffs), 1, "PS1应创建1个子单位")
        if sub_buffs:
            self.assertEqual(sub_buffs[0].name, "うみのともだちⅠ")
            self.assertEqual(sub_buffs[0].sub_unit_max_hp, 10000,
                             "子单位HP应为 caster.max_hp×50% = 10000")

        # 验证holder_debuffs
        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        # 应含至少1个value=7.5的减攻（来自PS1的sub_unit_target_debuffs）
        ps1_atk_downs = [d for d in atk_downs if abs(d.value - 7.5) < 0.01]
        self.assertGreater(len(ps1_atk_downs), 0,
                          "PS1应施加减攻7.5%")

