    # ════════════════════════════════════════════════════════════════
    # 重置辅助方法
    # ════════════════════════════════════════════════════════════════

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=10):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.level = 10
        self.caster.crit_rate = 0.0
        self.caster.once_per_battle_triggered = set()
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10

    def _reset_all_allies(self):
        """重置所有友方状态。"""
        self._reset_caster()
        for ally in [self.ally_lf, self.ally_rf, self.ally_cb]:
            ally.current_hp = ally.max_hp
            ally.buffs = []
            ally.debuffs = []
            ally.is_alive = True
            ally.skill_cooldowns = {}

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ap = 4
            e.current_pp = 4
            e.current_ep = 2

    # ════════════════════════════════════════════════════════════════
    # 配置校验
    # ════════════════════════════════════════════════════════════════

    def test_config_skill_ids(self):
        """配置校验：140302 应有5个技能ID [110074, 120162, 120163, 130164, 130165]。"""
        char_skills_map = self.dl.load_character_skills()
        char_skills = char_skills_map.get(140302)
        self.assertIsNotNone(char_skills, "character_skills 应包含 140302")
        if isinstance(char_skills, dict):
            skill_ids = char_skills.get('skill_ids', [])
        else:
            skill_ids = char_skills
        self.assertEqual(skill_ids, [110074, 120162, 120163, 130164, 130165],
                         f"技能ID列表应为 [110074, 120162, 120163, 130164, 130165]，实际: {skill_ids}")

    def test_config_ps1_trigger_type(self):
        """配置校验：PS1(130164) trigger_type=on_debuff_applied。"""
        parsed = self.dl.get_parsed_skill_data(130164)
        self.assertIsNotNone(parsed, "PS1 应有 parsed 数据")
        self.assertEqual(parsed.get('trigger_type'), 'on_debuff_applied',
                         "PS1 trigger_type 应为 on_debuff_applied")

    def test_config_ps1_exclude_timing(self):
        """配置校验：PS1(130164) global_condition 含 exclude_timing。"""
        parsed = self.dl.get_parsed_skill_data(130164)
        gc = parsed.get('global_condition')
        self.assertIsNotNone(gc, "PS1 应有 global_condition")
        self.assertEqual(gc.get('type'), 'and', "PS1 global_condition 应为 and")
        conditions = gc.get('conditions', [])
        has_exclude_timing = any(
            c.get('type') == 'exclude_timing' for c in conditions
        )
        self.assertTrue(has_exclude_timing, "PS1 应含 exclude_timing 条件")

    def test_config_ps2_once_per_battle(self):
        """配置校验：PS2(130165) once_per_battle=true。"""
        parsed = self.dl.get_parsed_skill_data(130165)
        self.assertIsNotNone(parsed, "PS2 应有 parsed 数据")
        self.assertTrue(parsed.get('once_per_battle'),
                        "PS2 once_per_battle 应为 true")

    def test_config_ps2_trigger_type(self):
        """配置校验：PS2(130165) trigger_type=on_turn_start。"""
        parsed = self.dl.get_parsed_skill_data(130165)
        self.assertEqual(parsed.get('trigger_type'), 'on_turn_start',
                         "PS2 trigger_type 应为 on_turn_start")

    def test_config_ex_sub_unit_target_debuffs(self):
        """配置校验：EX(110074) flags 含 sub_unit_target_debuffs(atk_down + dmg_taken_up)。"""
        parsed = self.dl.get_parsed_skill_data(110074)
        self.assertIsNotNone(parsed, "EX 应有 parsed 数据")
        eff = parsed['effect_blocks'][0]['effects'][0]
        self.assertEqual(eff['effect_type'], 'sub_unit')
        flags = eff.get('flags', {})
        debuffs = flags.get('sub_unit_target_debuffs', [])
        self.assertEqual(len(debuffs), 2, "应有2个 holder_debuffs")
        etypes = [d.get('effect_type') for d in debuffs]
        self.assertIn('atk_down', etypes, "应含 atk_down")
        self.assertIn('dmg_taken_up', etypes, "应含 dmg_taken_up")

    def test_config_no_simultaneous_limit(self):
        """配置校验：140302 的5个技能均无 simultaneous_limit。"""
        for sid in [110074, 120162, 120163, 130164, 130165]:
            parsed = self.dl.get_parsed_skill_data(sid)
            self.assertFalse(parsed.get('simultaneous_limit', False),
                             f"技能 {sid} 不应有 simultaneous_limit")

    # ════════════════════════════════════════════════════════════════
    # EX: 110074 リディアのおしろだいさくせん
    # ════════════════════════════════════════════════════════════════

    def test_ex_creates_3_sub_units(self):
        """EX(110074): 创建3个「うみのともだちⅡ」子单位。"""
        self._reset_caster()
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110074, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        sub_buffs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(sub_buffs), 3, "应创建3个子单位")
        for sb in sub_buffs:
            self.assertEqual(sb.name, "うみのともだちⅡ")
            self.assertEqual(sb.sub_unit_max_hp, 10000, "子单位HP应为 caster.max_hp×50% = 10000")
            self.assertEqual(sb.sub_unit_hp, sb.sub_unit_max_hp, "初始HP=最大HP")

    def test_ex_sub_unit_atk_pct(self):
        """EX(110074): 子单位追伤ATK×25%（Lv10 atk%=25.0）。"""
        self._reset_caster()
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110074, battlefield=self.bf, skip_cost=True
        )

        sub_buffs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        for sb in sub_buffs:
            self.assertAlmostEqual(sb.value, 25.0, places=1,
                                   msg="Lv10 atk% 应为 25.0")

    def test_ex_applies_atk_down_debuffs(self):
        """EX(110074): 施加3个atk_down(7.5%)给caster（stackable）。"""
        self._reset_caster()
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110074, battlefield=self.bf, skip_cost=True
        )

        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_downs), 3, "应施加3个atk_down debuff")
        for d in atk_downs:
            self.assertAlmostEqual(d.value, 7.5, places=1,
                                  msg="atk_down value 应为 7.5")
            self.assertTrue(d.is_stackable, "atk_down 应 stackable")
            self.assertEqual(d.duration, -1, "atk_down 应永续(duration=-1)")

    def test_ex_applies_dmg_taken_up_debuffs(self):
        """EX(110074): 施加3个dmg_taken_up(5.0%)(Lv10 dmg%=5.0)给caster。"""
        self._reset_caster()
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110074, battlefield=self.bf, skip_cost=True
        )

        dmg_ups = [d for d in self.caster.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_ups), 3, "应施加3个dmg_taken_up debuff")
        for d in dmg_ups:
            self.assertAlmostEqual(d.value, 5.0, places=1,
                                  msg="Lv10 dmg_taken_up value 应为 5.0")
            self.assertTrue(d.is_stackable, "dmg_taken_up 应 stackable")

    def test_ex_sub_unit_snapshot_before_debuff(self):
        """EX(110074): 子单位快照攻击力=减攻前攻击力。

        关键机制: 先创建sub_unit（快照为减攻前攻击力）→ 再施加atk_down
        验证: sub_unit.caster_attack == caster原始attack（10000）
        """
        self._reset_caster()
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110074, battlefield=self.bf, skip_cost=True
        )

        sub_buffs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        for sb in sub_buffs:
            self.assertEqual(sb.caster_attack, 10000,
                             "子单位快照攻击力应为减攻前的10000")

        # 验证减攻后caster实际攻击力降低（3层7.5% = 22.5%减攻）
        from src.combat_v2.services.damage_service import DamageService
        final_atk = self.dms._calculate_final_stat(self.caster, "attack")
        self.assertLess(final_atk, 10000, "施加atk_down后caster实际攻击力应降低")
        # 3层7.5% = 22.5% 减攻 → final_atk = 10000 * (1 - 0.225) = 7750
        self.assertAlmostEqual(final_atk, 7750, delta=1,
                               msg="3层7.5%减攻后攻击力应为7750")

    def test_ex_lv15_dmg_taken_up_skipped(self):
        """EX(110074) Lv15: dmg%=0 → dmg_taken_up不施加，但atk_down仍施加。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[110074] = 15

        self.ss.execute_skill(
            caster=self.caster, skill_id=110074, battlefield=self.bf, skip_cost=True
        )

        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_downs), 3, "Lv15 atk_down(7.5%) 仍应施加3个")

        dmg_ups = [d for d in self.caster.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_ups), 0, "Lv15 dmg%=0 → dmg_taken_up 不应施加")

    def test_ex_sub_unit_count_stacks(self):
        """EX(110074): 多次施放EX，子单位数量叠加（stackable=true）。"""
        self._reset_caster()
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110074, battlefield=self.bf, skip_cost=True
        )
        self.ss.execute_skill(
            caster=self.caster, skill_id=110074, battlefield=self.bf, skip_cost=True
        )

        sub_buffs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(sub_buffs), 6, "2次EX应累积6个子单位")

    # ════════════════════════════════════════════════════════════════
    # AS1: 120162 にげちゃ、めっ……だよ？
    # ════════════════════════════════════════════════════════════════

    def test_as1_targets_highest_max_hp(self):
        """AS1(120162) Block1: 主目标为最大HP最高的敌方单体。"""
        self._reset_caster()
        self._reset_enemies()

        cf_hp_before = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=120162, battlefield=self.bf, skip_cost=True
        )
        # enemy_cf max_hp=50000 最高 → 应受到伤害
        self.assertLess(self.enemy_cf.current_hp, cf_hp_before,
                        "enemy_cf(max_hp=50000)应作为AS1主目标受到伤害")

    def test_as1_adjacent_enemies_hit(self):
        """AS1(120162) Block2: 邻接主目标的2个敌方受到伤害。"""
        self._reset_caster()
        self._reset_enemies()

        lf_hp_before = self.enemy_lf.current_hp
        rf_hp_before = self.enemy_rf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=120162, battlefield=self.bf, skip_cost=True
        )
        # enemy_cf 在中前，邻接为左前(lf)和右前(rf)
        self.assertLess(self.enemy_lf.current_hp, lf_hp_before,
                        "enemy_lf 应作为邻接目标受到伤害")
        self.assertLess(self.enemy_rf.current_hp, rf_hp_before,
                        "enemy_rf 应作为邻接目标受到伤害")

    def test_as1_back_row_hp_ratio_damage(self):
        """AS1(120162) Block3/4: 後列追加HP比例伤害（target_is_back_row条件）。

        後列敌方(enemy_cb/lb/rb)应受到额外HP比例伤害。
        """
        self._reset_caster()
        self._reset_enemies()

        # 先记录Block1/2后的HP（不精确，但可通过对比验证Block3/4追加伤害）
        # 使用单独测试：将主目标设为後列，验证其受到额外HP比例伤害
        # 移除前排敌方，使最高HP敌方变为後列
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            e.is_alive = False
        self.bf.enemy_team = [self.enemy_cb, self.enemy_lb, self.enemy_rb]

        cb_hp_before = self.enemy_cb.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=120162, battlefield=self.bf, skip_cost=True
        )

        # enemy_cb max_hp=40000 最高 → 主目标
        # 且 enemy_cb 在後列 → 应受到HP比例伤害（Block3 condition: target_is_back_row）
        # 验证 enemy_cb 受到伤害（含威力伤害 + HP比例追加伤害）
        self.assertLess(self.enemy_cb.current_hp, cb_hp_before,
                        "後列主目标 enemy_cb 应受到威力伤害 + HP比例追加伤害")

    def test_as1_back_row_no_extra_damage_for_front(self):
        """AS1(120162) 前列主目标不受到HP比例追加伤害（target_is_back_row过滤）。

        前列敌方作为主目标时，Block3的target_is_back_row条件不满足，跳过HP比例伤害。
        通过伤害量对比验证（非精确，验证不报错）。
        """
        self._reset_caster()
        self._reset_enemies()
        # 默认场景：enemy_cf(中前, max_hp=50000)为主目标
        # enemy_cf 不在後列 → Block3 target_is_back_row 跳过
        # 验证不报错且主目标受伤
        cf_hp_before = self.enemy_cf.current_hp
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120162, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_cf.current_hp, cf_hp_before,
                        "前列主目标仍应受到威力伤害")

    def test_as1_hp_ratio_damage_cap(self):
        """AS1(120162) HP比例伤害上限: ATK×15%（damage_cap_atk_pct=15）。

        caster.attack=10000 → 上限=1500
        後列主目标 current_hp=40000, 7.5% = 3000 > 1500 → 实际伤害=1500（减去减伤乘区前）
        """
        self._reset_caster()
        self._reset_enemies()
        # 仅保留後列敌方，使主目标为後列
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            e.is_alive = False
        self.bf.enemy_team = [self.enemy_cb, self.enemy_lb, self.enemy_rb]

        cb_hp_before = self.enemy_cb.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=120162, battlefield=self.bf, skip_cost=True
        )
        # Block1/2 威力伤害 + Block3 HP比例伤害
        # 此处验证总伤害 > 0，HP比例伤害部分被cap限制
        total_dmg = cb_hp_before - self.enemy_cb.current_hp
        self.assertGreater(total_dmg, 0, "enemy_cb 应受到伤害")

