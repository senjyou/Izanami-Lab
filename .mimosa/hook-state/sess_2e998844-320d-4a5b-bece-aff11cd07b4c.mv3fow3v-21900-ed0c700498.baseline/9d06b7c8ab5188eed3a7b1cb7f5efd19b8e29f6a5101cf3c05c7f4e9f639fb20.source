            caster=self.caster, skill_id=120163, battlefield=self.bf, skip_cost=True
        )
        # enemy_cb 在 ENEMY_CENTER_BACK → 应受到 Block1 威力伤害
        self.assertLess(self.enemy_cb.current_hp, cb_hp_before,
                        "enemy_cb(後列中央)应作为AS2主目标受到威力伤害")

    def test_as2_all_exclude_primary(self):
        """AS2(120163) Block2: その他の全ての敵に威力2攻撃（主目標除外）。"""
        self._reset_caster()
        self._reset_enemies()

        cf_hp_before = self.enemy_cf.current_hp
        lf_hp_before = self.enemy_lf.current_hp
        rf_hp_before = self.enemy_rf.current_hp
        lb_hp_before = self.enemy_lb.current_hp
        rb_hp_before = self.enemy_rb.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=120163, battlefield=self.bf, skip_cost=True
        )
        # 排除主目標(enemy_cb)，其他5个敌方应受到威力2伤害
        self.assertLess(self.enemy_cf.current_hp, cf_hp_before,
                        "enemy_cf 应作为非主目标受到威力2伤害")
        self.assertLess(self.enemy_lf.current_hp, lf_hp_before,
                        "enemy_lf 应作为非主目标受到威力2伤害")
        self.assertLess(self.enemy_rf.current_hp, rf_hp_before,
                        "enemy_rf 应作为非主目标受到威力2伤害")
        self.assertLess(self.enemy_lb.current_hp, lb_hp_before,
                        "enemy_lb 应作为非主目标受到威力2伤害")
        self.assertLess(self.enemy_rb.current_hp, rb_hp_before,
                        "enemy_rb 应作为非主目标受到威力2伤害")

    def test_as2_no_back_center_fallback(self):
        """AS2(120163) 後列中央不存在时: enemy_back_center_single返回空列表。

        场景：移除enemy_cb，後列中央无目标 → Block1不造成伤害，Block2对全体造成威力2。
        """
        self._reset_caster()
        self._reset_enemies()
        # 移除後列中央
        self.enemy_cb.is_alive = False
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf,
                              self.enemy_lb, self.enemy_rb]

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120163, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 验证其他敌方仍受到威力2伤害（Block2 enemy_all_exclude_primary）
        # enemy_all_exclude_primary 在无主目标时对所有敌方生效
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "无後列中央时 enemy_cf 应受到威力2伤害")

