    def test_ps1_triggers_on_debuff_applied(self):
        """PS1(130164) on_debuff_applied: caster被施加debuff时触发。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 手动施加一个debuff给caster，触发 on_debuff_applied
        test_debuff = BuffState(
            buff_id="test_debuff_1",
            name="test_atk_down",
            effect_type=STATUS_ATTACK,
            value=10.0,
            duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="enemy_cf",
            source_skill_id=999999,
            caster_attack=0,
            is_debuff=True,
        )
        self.aus.add_aura(self.caster, test_debuff)

        # 触发 on_debuff_applied
        actions = self.ts.trigger_pawn_received_aura(
            self.bf,
            affected_unit_ids=[self.caster.unit_id],
            actor=self.enemy_cf,
            applied_debuff_types={STATUS_ATTACK},
        )
        ps1_actions = [a for a in actions if a.skill_id == 130164]
        self.assertGreater(len(ps1_actions), 0,
                           "caster被施加debuff应触发 PS1(130164)")

    def test_ps1_exclude_timing_battle_start(self):
        """PS1(130164) exclude_timing: 戦闘開始时不触发。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 设置 current_trigger_phase = BATTLE_START
        self.bf.current_trigger_phase = TriggerTiming.BATTLE_START

        # 施加debuff
        test_debuff = BuffState(
            buff_id="test_debuff_bs",
