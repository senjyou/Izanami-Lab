    def test_ps2_triggers_on_turn_start(self):
        """PS2(130165) on_turn_start: 回合开始时触发。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # on_turn_start 非先制阶段收集（PS2无is_preemptive）
        actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130165]
        self.assertGreater(len(ps2_actions), 0,
                           "回合开始应触发 PS2(130165)")

    def test_ps2_once_per_battle(self):
        """PS2(130165) once_per_battle: 第二次回合开始不再触发。"""
        self._reset_caster()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 第一次触发
        actions1 = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2_1 = [a for a in actions1 if a.skill_id == 130165]
        self.assertGreater(len(ps2_1), 0, "第一次应触发 PS2")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_1, self.bf, trigger_timing="on_turn_start"
        )
        # 验证 once_per_battle_triggered 已记录
        self.assertIn(130165, self.caster.once_per_battle_triggered,
                      "PS2执行后应记录到 once_per_battle_triggered")

        # 第二次触发（下一回合）
        self.bf.turn_number = 2
        actions2 = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2_2 = [a for a in actions2 if a.skill_id == 130165]
        self.assertEqual(len(ps2_2), 0,
                         "once_per_battle: 第二次不应再触发 PS2")

    def test_ps2_lv10_self_only(self):
        """PS2(130165) Lv1-10 Block1: 仅自身创建1个子单位。"""
        self._reset_caster()
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130165] = 10

        actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130165]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # caster 应有1个子单位
        caster_subs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(caster_subs), 1, "Lv10 PS2 应为caster创建1个子单位")
        if caster_subs:
            self.assertEqual(caster_subs[0].name, "うみのともだちⅢ")
            self.assertEqual(caster_subs[0].sub_unit_max_hp, 3000,
                             "子单位HP应为 caster.max_hp×15% = 3000")

        # 友方不应有子单位（Lv1-10仅自身）
        ally_subs_lf = [b for b in self.ally_lf.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(ally_subs_lf), 0, "Lv10 PS2 不应为友方创建子单位")

    def test_ps2_lv11_self_and_same_row_allies(self):
        """PS2(130165) Lv11+ Block2: 自身+同排友方创建子单位。"""
        self._reset_caster()
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 15
        self.caster.skill_levels[130165] = 15

        actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130165]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # caster(前排中央) 应有1个子单位
        caster_subs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(caster_subs), 1, "Lv15 PS2 应为caster创建1个子单位")

        # ally_lf(前排左) 应有1个子单位（同排=前排）
        ally_lf_subs = [b for b in self.ally_lf.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(ally_lf_subs), 1,
                         "Lv15 PS2 应为同排(前排)友方 ally_lf 创建1个子单位")

        # ally_rf(前排右) 应有1个子单位（同排=前排）
        ally_rf_subs = [b for b in self.ally_rf.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(ally_rf_subs), 1,
                         "Lv15 PS2 应为同排(前排)友方 ally_rf 创建1个子单位")

        # ally_cb(後排中央) 不应有子单位（不同排）
        ally_cb_subs = [b for b in self.ally_cb.buffs if b.effect_type == SUB_UNIT]
        self.assertEqual(len(ally_cb_subs), 0,
                         "Lv15 PS2 不应为後排友方 ally_cb 创建子单位")

    def test_ps2_atk_down_2_5_pct(self):
        """PS2(130165) holder_debuffs: atk_down(2.5%)。"""
        self._reset_caster()
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130165] = 10

        actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130165]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # caster 应有1个 atk_down(2.5%)
        atk_downs = [d for d in self.caster.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_downs), 1, "PS2应施加1个atk_down")
        if atk_downs:
            self.assertAlmostEqual(atk_downs[0].value, 2.5, places=1,
                                   msg="PS2 atk_down value 应为 2.5")

    def test_ps2_sub_unit_snapshot_before_debuff(self):
        """PS2(130165) 快照时序: 子单位caster_attack=减攻前攻击力。"""
        self._reset_caster()
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130165] = 10

        actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130165]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        sub_buffs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        for sb in sub_buffs:
            self.assertEqual(sb.caster_attack, 10000,
                             "子单位快照攻击力应为减攻前的10000")

    def test_ps2_lv15_atk_8_5_pct(self):
        """PS2(130165) Lv15: atk%=8.5（子单位追伤ATK×8.5%）。"""
        self._reset_caster()
        self._reset_all_allies()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 15
        self.caster.skill_levels[130165] = 15

        actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130165]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        sub_buffs = [b for b in self.caster.buffs if b.effect_type == SUB_UNIT]
        for sb in sub_buffs:
            self.assertAlmostEqual(sb.value, 8.5, places=1,
                                   msg="Lv15 atk% 应为 8.5")


