"""Regression: simultaneous_limit must be enforced across trigger timings by speed.

Bug: 代助一避 (130013, before_as_attacked) and デコイプロトコル (130034,
     before_any_attacked) both have simultaneous_limit=true, but the original
     _process_candidates only filtered within a single trigger timing. Since
     the two PS belong to different trigger timings (before_as_attacked vs
     before_any_attacked), both could trigger simultaneously in the same attack.

Fix: Enemy AoE attacks make before_enemy_as_attack / before_any_attacked /
     before_as_attacked logically the same timing. Collect all three timings'
     actions first, find the fastest simultaneous_limit PS by unit speed
     (priority = -speed * 10000 + pos_score, lower = faster), filter out
     slower simultaneous_limit PS, then execute each timing in order.

Note: 代助一避's trigger_type was corrected from before_enemy_as_attack
      (attacker-side) to before_as_attacked (defender-side) per the skill
      description: "triggers before an ally positioned directly in front of
      self is attacked by an enemy". PP-insufficient simultaneous_limit PS
      are excluded from the speed competition (within-timing _process_candidates
      and cross-timing skill_service._apply_damage), so a PP-insufficient
      faster PS won't block a slower PP-sufficient PS.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


# Skill IDs
DAISU_HITOMONO_YO = 130013   # 代助一避 (before_as_attacked, simultaneous_limit=true)
DECOI_PROTOCOL = 130034       # デコイプロトコル (before_any_attacked, simultaneous_limit=true)
ENEMY_ALL_AS = 220369        # 紫影の斬撃 (enemy_all damage AS)

# Effect type constants
EVADE = SkillEffectType.EVADE.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
GUARD = SkillEffectType.GUARD.value


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=pp, current_ep=0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _apply_cross_timing_filter(dl, *action_lists):
    """Replicate the cross-timing simultaneous_limit filter from _apply_damage.

    Collects all simultaneous_limit PS across the given action lists, finds the
    fastest one (lowest priority = fastest unit), and filters out slower ones.
    PP-insufficient simultaneous_limit PS are excluded from the speed competition
    (matching skill_service._apply_damage cross-timing filter behavior).
    Returns the filtered lists.
    """
    # Find fastest simultaneous_limit PS (skip PP-insufficient ones)
    best_key = None
    best_prio = None
    for actions in action_lists:
        for act in actions:
            parsed = dl.get_parsed_skill_data(act.skill_id)
            if parsed and parsed.get('simultaneous_limit'):
                # PP-insufficient simultaneous_limit PS skipped (not eligible to win)
                owner = act.instance.owner if act.instance else None
                skill_meta = dl.get_skill_by_id(act.skill_id)
                cost = getattr(skill_meta, 'resource_cost', 0) if skill_meta else 0
                if cost and cost > 0 and owner is not None and owner.current_pp < cost:
                    continue
                prio = act.instance.priority if act.instance else 0
                if best_prio is None or prio < best_prio:
                    best_prio = prio
                    best_key = (act.skill_id, act.owner_id)

    # Filter
    if best_key is None:
        return action_lists
    result = []
    for actions in action_lists:
        filtered = []
        for act in actions:
            parsed = dl.get_parsed_skill_data(act.skill_id)
            if parsed and parsed.get('simultaneous_limit'):
                if (act.skill_id, act.owner_id) != best_key:
                    continue
            filtered.append(act)
        result.append(filtered)
    return tuple(result)


class TestRegSimultaneousLimitCrossTiming(unittest.TestCase):
    """simultaneous_limit must be enforced across the three before-attack timings
    by unit speed, not by timing order."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    def test_both_skills_have_simultaneous_limit_flag(self):
        """Both 代助一避 and デコイプロトコル must have simultaneous_limit=true."""
        parsed_daisu = self.dl.get_parsed_skill_data(DAISU_HITOMONO_YO)
        parsed_decoi = self.dl.get_parsed_skill_data(DECOI_PROTOCOL)
        self.assertTrue(parsed_daisu.get('simultaneous_limit'),
                        "代助一避 should have simultaneous_limit=true")
        self.assertTrue(parsed_decoi.get('simultaneous_limit'),
                        "デコイプロトコル should have simultaneous_limit=true")

    def test_daisu_triggers_at_before_as_attacked(self):
        """代助一避 should trigger at before_as_attacked (defender-side) when
        front ally is targeted. Per skill description: 'triggers before an ally
        positioned directly in front of self is attacked by an enemy'."""
        ally_front = _make_unit("ally_front", "前方友方", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=100000)
        daisu_owner = _make_unit("daisu_owner", "代助一避持有者", Side.ALLY,
                                 Position.ALLY_CENTER_BACK, hp=100000,
                                 skills=[DAISU_HITOMONO_YO],
                                 skill_levels={DAISU_HITOMONO_YO: 10})
        enemy = _make_unit("enemy", "敌方攻击者", Side.ENEMY,
                           Position.ENEMY_CENTER_FRONT, hp=100000,
                           skills=[ENEMY_ALL_AS],
                           skill_levels={ENEMY_ALL_AS: 10})

        bf = BattlefieldState()
        bf.friend_team = [ally_front, daisu_owner]
        bf.enemy_team = [enemy]
        ss, ts = self._make_services(bf)

        actions = ts.trigger_before_as_attacked(
            [ally_front, daisu_owner], bf, attacker=enemy
        )
        daisu_actions = [a for a in actions if a.skill_id == DAISU_HITOMONO_YO]
        self.assertGreater(len(daisu_actions), 0,
                           "代助一避 should trigger at before_as_attacked "
                           "when front ally is among attack targets")

    def test_decoi_triggers_at_before_any_attacked_alone(self):
        """デコイプロトコル should trigger at before_any_attacked when no
        simultaneous_limit PS matched earlier (sanity check)."""
        decoi_owner = _make_unit("decoi_owner", "デコイ持有者", Side.ALLY,
                                 Position.ALLY_LEFT_FRONT, hp=100000,
                                 skills=[DECOI_PROTOCOL],
                                 skill_levels={DECOI_PROTOCOL: 10})
        other_ally = _make_unit("other_ally", "其他友方", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=100000)
        enemy = _make_unit("enemy", "敌方攻击者", Side.ENEMY,
                           Position.ENEMY_CENTER_FRONT, hp=100000,
                           skills=[ENEMY_ALL_AS],
                           skill_levels={ENEMY_ALL_AS: 10})

        bf = BattlefieldState()
        bf.friend_team = [decoi_owner, other_ally]
        bf.enemy_team = [enemy]
        ss, ts = self._make_services(bf)

        actions = ts.trigger_before_any_attacked(
            [decoi_owner, other_ally], bf, attacker=enemy
        )
        decoi_actions = [a for a in actions if a.skill_id == DECOI_PROTOCOL]
        self.assertGreater(len(decoi_actions), 0,
                           "デコイプロトコル should trigger at before_any_attacked "
                           "when no simultaneous_limit PS matched earlier")

    def test_faster_daisu_wins_decoi_filtered(self):
        """When 代助一避 owner is faster, デコイプロトコル must be filtered out
        (speed-based, not timing-order-based). 代助一避 is at before_as_attacked
        (defender-side), デコイ is at before_any_attacked (defender-side)."""
        ally_front = _make_unit("ally_front", "前方友方", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=100000)
        daisu_owner = _make_unit("daisu_owner", "代助一避持有者(速)", Side.ALLY,
                                 Position.ALLY_CENTER_BACK, hp=100000, speed=600,
                                 skills=[DAISU_HITOMONO_YO],
                                 skill_levels={DAISU_HITOMONO_YO: 10})
        decoi_owner = _make_unit("decoi_owner", "デコイ持有者(遅)", Side.ALLY,
                                 Position.ALLY_LEFT_FRONT, hp=100000, speed=400,
                                 skills=[DECOI_PROTOCOL],
                                 skill_levels={DECOI_PROTOCOL: 10})
        enemy = _make_unit("enemy", "敌方攻击者", Side.ENEMY,
                           Position.ENEMY_CENTER_FRONT, hp=100000,
                           skills=[ENEMY_ALL_AS],
                           skill_levels={ENEMY_ALL_AS: 10})

        bf = BattlefieldState()
        bf.friend_team = [ally_front, daisu_owner, decoi_owner]
        bf.enemy_team = [enemy]
        ss, ts = self._make_services(bf)

        all_targets = [ally_front, daisu_owner, decoi_owner]
        before_enemy_actions = ts.trigger_before_enemy_as_attack(
            enemy, ENEMY_ALL_AS, all_targets, bf
        )
        before_any_actions = ts.trigger_before_any_attacked(
            all_targets, bf, attacker=enemy
        )
        before_as_actions = ts.trigger_before_as_attacked(
            all_targets, bf, attacker=enemy
        )

        daisu_prio = None
        decoi_prio = None
        for act in before_as_actions:
            if act.skill_id == DAISU_HITOMONO_YO:
                daisu_prio = act.instance.priority
        for act in before_any_actions:
            if act.skill_id == DECOI_PROTOCOL:
                decoi_prio = act.instance.priority
        self.assertIsNotNone(daisu_prio, "代助一避 should match at before_as_attacked")
        self.assertIsNotNone(decoi_prio, "デコイプロトコル should match at before_any_attacked")
        self.assertLess(daisu_prio, decoi_prio,
                        "代助一避 owner (speed=600) should have lower priority (faster) "
                        "than デコイプロトコル owner (speed=400)")

        be, ba, bs = _apply_cross_timing_filter(
            self.dl, before_enemy_actions, before_any_actions, before_as_actions
        )

        daisu_survived = any(a.skill_id == DAISU_HITOMONO_YO for a in bs)
        decoi_survived = any(a.skill_id == DECOI_PROTOCOL for a in ba)
        self.assertTrue(daisu_survived,
                         "代助一避 (faster) should survive the cross-timing filter")
        self.assertFalse(decoi_survived,
                         "デコイプロトコル (slower) should be filtered out "
                         "by cross-timing simultaneous_limit")

    def test_faster_decoi_wins_daisu_filtered(self):
        """When デコイプロトコル owner is faster, 代助一避 must be filtered out.
        This proves selection is speed-based, not timing-order-based
        (代助一避 is at before_as_attacked, デコイ is at before_any_attacked,
        but timing order doesn't matter—only speed does)."""
        ally_front = _make_unit("ally_front", "前方友方", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=100000)
        daisu_owner = _make_unit("daisu_owner", "代助一避持有者(遅)", Side.ALLY,
                                 Position.ALLY_CENTER_BACK, hp=100000, speed=400,
                                 skills=[DAISU_HITOMONO_YO],
                                 skill_levels={DAISU_HITOMONO_YO: 10})
        decoi_owner = _make_unit("decoi_owner", "デコイ持有者(速)", Side.ALLY,
                                 Position.ALLY_LEFT_FRONT, hp=100000, speed=600,
                                 skills=[DECOI_PROTOCOL],
                                 skill_levels={DECOI_PROTOCOL: 10})
        enemy = _make_unit("enemy", "敌方攻击者", Side.ENEMY,
                           Position.ENEMY_CENTER_FRONT, hp=100000,
                           skills=[ENEMY_ALL_AS],
                           skill_levels={ENEMY_ALL_AS: 10})

        bf = BattlefieldState()
        bf.friend_team = [ally_front, daisu_owner, decoi_owner]
        bf.enemy_team = [enemy]
        ss, ts = self._make_services(bf)

        all_targets = [ally_front, daisu_owner, decoi_owner]
        before_enemy_actions = ts.trigger_before_enemy_as_attack(
            enemy, ENEMY_ALL_AS, all_targets, bf
        )
        before_any_actions = ts.trigger_before_any_attacked(
            all_targets, bf, attacker=enemy
        )
        before_as_actions = ts.trigger_before_as_attacked(
            all_targets, bf, attacker=enemy
        )

        daisu_prio = None
        decoi_prio = None
        for act in before_as_actions:
            if act.skill_id == DAISU_HITOMONO_YO:
                daisu_prio = act.instance.priority
        for act in before_any_actions:
            if act.skill_id == DECOI_PROTOCOL:
                decoi_prio = act.instance.priority
        self.assertIsNotNone(daisu_prio, "代助一避 should match at before_as_attacked")
        self.assertIsNotNone(decoi_prio, "デコイプロトコル should match at before_any_attacked")
        self.assertLess(decoi_prio, daisu_prio,
                        "デコイプロトコル owner (speed=600) should have lower priority (faster) "
                        "than 代助一避 owner (speed=400)")

        be, ba, bs = _apply_cross_timing_filter(
            self.dl, before_enemy_actions, before_any_actions, before_as_actions
        )

        daisu_survived = any(a.skill_id == DAISU_HITOMONO_YO for a in bs)
        decoi_survived = any(a.skill_id == DECOI_PROTOCOL for a in ba)
        self.assertFalse(daisu_survived,
                         "代助一避 (slower) should be filtered out "
                         "by cross-timing simultaneous_limit")
        self.assertTrue(decoi_survived,
                        "デコイプロトコル (faster) should survive the cross-timing filter")

    def test_end_to_end_faster_daisu_triggers(self):
        """End-to-end: when 代助一避 owner is faster, executing enemy AS should
        trigger 代助一避 (front ally evades) but NOT デコイプロトコル."""
        ally_front = _make_unit("ally_front", "前方友方", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=100000)
        daisu_owner = _make_unit("daisu_owner", "代助一避持有者(速)", Side.ALLY,
                                 Position.ALLY_CENTER_BACK, hp=100000, speed=600,
                                 skills=[DAISU_HITOMONO_YO],
                                 skill_levels={DAISU_HITOMONO_YO: 10})
        decoi_owner = _make_unit("decoi_owner", "デコイ持有者(遅)", Side.ALLY,
                                 Position.ALLY_LEFT_FRONT, hp=100000, speed=400,
                                 skills=[DECOI_PROTOCOL],
                                 skill_levels={DECOI_PROTOCOL: 10})
        enemy = _make_unit("enemy", "敌方攻击者", Side.ENEMY,
                           Position.ENEMY_CENTER_FRONT, hp=100000,
                           skills=[ENEMY_ALL_AS],
                           skill_levels={ENEMY_ALL_AS: 10})

        bf = BattlefieldState()
        bf.friend_team = [ally_front, daisu_owner, decoi_owner]
        bf.enemy_team = [enemy]
        ss, ts = self._make_services(bf)

        result = ss.execute_skill(enemy, ENEMY_ALL_AS, bf, skip_cost=True)
        self.assertTrue(result.get('success'), "AS execution should succeed")

        # 代助一避 should have triggered: front ally HP unchanged (evaded)
        self.assertEqual(ally_front.current_hp, ally_front.max_hp,
                         "代助一避 should give Evade to front ally (HP unchanged)")
        daisu_received_dmg = any(
            b.effect_type == RECEIVED_DAMAGE for b in daisu_owner.debuffs
        )
        self.assertTrue(daisu_received_dmg,
                        "代助一避 should give ReceivedDamage to self")

        # デコイプロトコル should NOT have triggered
        self.assertFalse(getattr(decoi_owner, 'cover_target', None) is not None,
                         "デコイプロトコル should NOT set cover_target (filtered by speed)")
        self.assertFalse(getattr(decoi_owner, 'guard_active', False),
                         "デコイプロトコル should NOT activate guard (filtered by speed)")

    def test_end_to_end_faster_decoi_triggers(self):
        """End-to-end: when デコイプロトコル owner is faster, executing enemy AS
        should trigger デコイプロトコル (cover+guard) but NOT 代助一避.

        This is the key test proving speed-based selection: 代助一避 is in the
        earlier timing (before_enemy_as_attack) but loses to a faster
        デコイプロトコル in before_any_attacked.
        """
        ally_front = _make_unit("ally_front", "前方友方", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=100000)
        daisu_owner = _make_unit("daisu_owner", "代助一避持有者(遅)", Side.ALLY,
                                 Position.ALLY_CENTER_BACK, hp=100000, speed=400,
                                 skills=[DAISU_HITOMONO_YO],
                                 skill_levels={DAISU_HITOMONO_YO: 10})
        decoi_owner = _make_unit("decoi_owner", "デコイ持有者(速)", Side.ALLY,
                                 Position.ALLY_LEFT_FRONT, hp=100000, speed=600,
                                 skills=[DECOI_PROTOCOL],
                                 skill_levels={DECOI_PROTOCOL: 10})
        enemy = _make_unit("enemy", "敌方攻击者", Side.ENEMY,
                           Position.ENEMY_CENTER_FRONT, hp=100000,
                           skills=[ENEMY_ALL_AS],
                           skill_levels={ENEMY_ALL_AS: 10})

        bf = BattlefieldState()
        bf.friend_team = [ally_front, daisu_owner, decoi_owner]
        bf.enemy_team = [enemy]
        ss, ts = self._make_services(bf)

        result = ss.execute_skill(enemy, ENEMY_ALL_AS, bf, skip_cost=True)
        self.assertTrue(result.get('success'), "AS execution should succeed")

        # デコイプロトコル should have triggered: cover_target set or guard_active
        decoi_triggered = (
            getattr(decoi_owner, 'cover_target', None) is not None or
            getattr(decoi_owner, 'guard_active', False)
        )
        self.assertTrue(decoi_triggered,
                        "デコイプロトコル (faster) should trigger cover/guard")

        # 代助一避 should NOT have triggered: front ally should take damage
        # (no Evade buff applied) and daisu_owner should NOT have ReceivedDamage
        daisu_received_dmg = any(
            b.effect_type == RECEIVED_DAMAGE for b in daisu_owner.debuffs
        )
        self.assertFalse(daisu_received_dmg,
                         "代助一避 (slower, earlier timing) should NOT give ReceivedDamage "
                         "(filtered by cross-timing simultaneous_limit speed comparison)")


if __name__ == '__main__':
    unittest.main(verbosity=2)
