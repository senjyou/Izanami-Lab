        parsed = self.dl.get_parsed_skill_data(130107)
        self.assertIsNotNone(parsed, "PS3(130107) 应有 parsed 数据")
        blocks = parsed.get("effect_blocks", [])
        self.assertGreater(len(blocks), 0, "PS3 应有 effect_blocks")
        effects = blocks[0].get("effects", [])
        self.assertGreater(len(effects), 0, "PS3 Block1 应有 effects")
