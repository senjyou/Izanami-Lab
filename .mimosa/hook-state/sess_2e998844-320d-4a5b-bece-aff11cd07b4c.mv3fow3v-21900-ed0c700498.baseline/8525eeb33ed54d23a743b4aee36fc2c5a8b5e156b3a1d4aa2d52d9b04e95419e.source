        self.assertTrue(flags.get("is_follow_up", False),
                        "PS3 damage effect 应有 is_follow_up=true 标记")

    # ════════════════════════════════════════════════════════════════
    # 附魔伤害机制专项（burn附魔、splash附魔、carried_debuff传递）
    # ════════════════════════════════════════════════════════════════

    def test_enchant_burn_deals_damage_on_attack(self):
        """burn附魔伤害结算：caster 持 burn附魔 → AS攻击 → 目标受到 burn debuff。

        burn_damage_pct=30 → burn value = caster_attack × 30%
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130105] = 10

        # 强制选择 burn 分支
        def _override(ctx):
            if ctx['group_id'] == 1:
                return 2  # burn
            return 5  # 空（group2的空分支是block_id=5）
        self.ss.set_branch_override(_override)

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )
        self.ss.clear_branch_override()

        # 验证 caster 持 burn 附魔
        burn_enchants = [b for b in self.caster.buffs if b.effect_type == ENCHANT_DAMAGE
                         and getattr(b, 'hit_limited_flags', {}) and
                         b.hit_limited_flags.get('add_status') == 'burn']
        self.assertGreater(len(burn_enchants), 0, "应有 burn 附魔buff")

        # caster 执行 AS 攻击 enemy_cf
        enemy_hp_before = self.enemy_cf.current_hp
        self.caster.skill_cooldowns = {}
        self.ss.execute_skill(
            caster=self.caster, skill_id=120097, battlefield=self.bf, skip_cost=True
        )

        # enemy_cf 应受到主攻击伤害
        self.assertLess(self.enemy_cf.current_hp, enemy_hp_before,
                        "enemy_cf 应受到主攻击伤害")

        # enemy_cf 应被施加 burn debuff（CONFLAGRATION）
        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        self.assertGreater(len(burns), 0,
                           "enemy_cf 应有 burn debuff（来自附魔）")

    def test_enchant_splash_to_adjacent(self):
        """splash附魔伤害结算：caster 持 splash附魔 → AS攻击主目标 → 邻接敌方也受伤。

        splash_to_adjacent=true：主攻击目标周围的敌方也受到同威力伤害。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130105] = 10

        # 强制选择 splash 分支
        def _override(ctx):
            if ctx['group_id'] == 1:
                return 3  # 空
            return 4  # splash
        self.ss.set_branch_override(_override)

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )
        self.ss.clear_branch_override()

        splash_enchants = [b for b in self.caster.buffs if b.effect_type == ENCHANT_DAMAGE
                           and getattr(b, 'hit_limited_flags', {}) and
                           b.hit_limited_flags.get('splash_to_adjacent') is True]
        self.assertGreater(len(splash_enchants), 0, "应有 splash 附魔buff")

        # caster 执行 AS 攻击 enemy_cf（主目标）
        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp

        self.caster.skill_cooldowns = {}
        self.ss.execute_skill(
            caster=self.caster, skill_id=120097, battlefield=self.bf, skip_cost=True
        )

        # 主目标 enemy_cf 应受到伤害
        self.assertLess(self.enemy_cf.current_hp, hp_cf_before,
                        "enemy_cf 应受到主攻击+splash附魔伤害")
        # 邻接敌方也应受到 splash 伤害（enemy_lf 或 enemy_rf 之一，取决于邻接关系）
        # enemy_cf 在中前，邻接是 enemy_lf 和 enemy_rf
        splash_total = (hp_lf_before - self.enemy_lf.current_hp) + \
                       (hp_rf_before - self.enemy_rf.current_hp)
        self.assertGreater(splash_total, 0,
                           "邻接敌方应受到 splash 伤害")

