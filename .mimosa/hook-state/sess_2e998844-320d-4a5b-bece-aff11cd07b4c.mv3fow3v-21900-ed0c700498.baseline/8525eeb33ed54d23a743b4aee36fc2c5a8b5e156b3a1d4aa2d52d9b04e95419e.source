    def test_ps1_random_choice_two_independent_groups(self):
        """PS1(130105) 2个独立概率组：可同时触发burn+splash。

        用 set_branch_override 让 group1 选 burn(block2)，group2 选 splash(block4)。
        验证两个附魔buff共存。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130105] = 10

        def _override(ctx):
            if ctx['group_id'] == 1:
                return 2  # burn
            return 4  # splash
        self.ss.set_branch_override(_override)

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )

        self.ss.clear_branch_override()

        enchants = [b for b in self.caster.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants), 2, "应有2个附魔buff（burn + splash 独立共存）")

        # 验证一个是 burn，一个是 splash
        burn_enchants = [b for b in enchants
                         if getattr(b, 'hit_limited_flags', {}) and
                         b.hit_limited_flags.get('add_status') == 'burn']
        splash_enchants = [b for b in enchants
                           if getattr(b, 'hit_limited_flags', {}) and
                           b.hit_limited_flags.get('splash_to_adjacent') is True]
        self.assertEqual(len(burn_enchants), 1, "应有1个 burn 附魔")
        self.assertEqual(len(splash_enchants), 1, "应有1个 splash 附魔")

    def test_ps1_lv11_burn_with_heal_efficacy_down_carried_debuff(self):
        """PS1(130105) Lv11+ group1 burn分支(Block6): burn附魔 + heal_efficacy_down carried_debuff。

        Lv11+ burn分支额外施加 heal_efficacy_down(value=20%, carried_debuff=true,
        duration_owner=caster)。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 15
        self.caster.skill_levels[130105] = 15

        def _override(ctx):
            if ctx['group_id'] == 1:
                return 6  # Lv11+ burn + heal_efficacy_down
            return 8  # Lv11+ splash + dmg_dealt_down
        self.ss.set_branch_override(_override)

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )

        self.ss.clear_branch_override()

        # heal_efficacy_down 作为独立 RECEIVED_HEALING buff 存在于 caster，hit_limited_flags.carried_debuff=true
        carried_heal_eff = [b for b in self.caster.buffs
                            if b.effect_type == RECEIVED_HEALING
                            and getattr(b, 'hit_limited_flags', {}).get('carried_debuff') is True]
        self.assertGreater(len(carried_heal_eff), 0,
                           "Lv11+ burn 分支应在 caster 上有 heal_efficacy_down carried_debuff buff")
        self.assertAlmostEqual(carried_heal_eff[0].value, 20.0, delta=0.5,
                               msg=f"heal_efficacy_down value 应为20，实际: {carried_heal_eff[0].value}")
        self.assertTrue(carried_heal_eff[0].is_stackable,
                        "heal_efficacy_down 应 stackable")

