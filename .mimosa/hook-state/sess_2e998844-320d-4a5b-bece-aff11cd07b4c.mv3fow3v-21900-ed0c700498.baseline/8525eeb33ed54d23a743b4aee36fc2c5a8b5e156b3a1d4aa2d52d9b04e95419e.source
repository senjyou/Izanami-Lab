# -*- coding: utf-8 -*-
"""角色126301 みんなを見守る山ガール 专项E2E测试

技能列表：
- EX: 110043 ラウラＳＯＳ！（敵全体 damage[威力] + atk_down[atk, 1action, percent]）
- AS1: 120097 落雪注意（敵単体 damage[威力]）
- PS1: 130105 整いサウナ（before_skill_use:
    Block1: self atk_up(scale_by_alive_allies, attack_limited=1, stackable, 1attack)
    Block2/3: random_choice group=1, 60%(burn enchant)/40%(空) [Lv1-10]
    Block4/5: random_choice group=2, 60%(splash enchant)/40%(空) [Lv1-10]
    Block6/7: random_choice group=1, 60%(burn enchant + heal_efficacy_down carried_debuff, duration_owner=caster)/40%(空) [Lv11+]
    Block8/9: random_choice group=2, 60%(splash enchant + dmg_dealt_down carried_debuff)/40%(空) [Lv11+]
    2个独立概率组（group1=burn, group2=splash），各独立抽选）
- PS2: 130106 みんなと一緒！（on_turn_start + ally_alive_count>=2:
    Block1: self crit_rate_up(crt, 1action, stackable)
    Block2 L11+: self crit_dmg_up(crtdmg, 1action, stackable)）
- PS3: 130107 私も混ぜて～！（after_ally_as_attack:
    Block1: enemy_single damage[威力] target_identifier=attacked_targets, is_follow_up=true, cooldown=2）

覆盖维度：
1. EX enemy_all damage + atk_down(1action, percent)
2. AS1 enemy_single damage
3. PS1 before_skill_use(仅AS触发) + atk_up(scale_by_alive_allies) + 2独立random_choice组
   + burn/splash附魔 + carried_debuff(heal_efficacy_down/dmg_dealt_down)
4. PS2 on_turn_start + ally_alive_count>=2 + crit_rate_up/crit_dmg_up
5. PS3 after_ally_as_attack追撃 + attacked_targets + is_follow_up
6. 附魔伤害专项：burn附魔burn_damage_pct=30%、splash_to_adjacent、carried_debuff传递、hit_limited消耗
7. 边界场景：scale_by_alive_allies队友存活比例、PS2 ally_alive_count<2不触发、PS3 主目标阵亡不触发
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value            # atk_up/atk_down
STATUS_CRITICAL_CHANCE = SkillEffectType.STATUS_CRITICAL_CHANCE.value  # crit_rate_up
CRITICAL_BONUS_MODIFICATION = SkillEffectType.CRITICAL_BONUS_MODIFICATION.value  # crit_dmg_up
RECEIVED_HEALING = SkillEffectType.RECEIVED_HEALING.value      # heal_efficacy_down
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value              # dmg_dealt_down
ENCHANT_DAMAGE = SkillEffectType.ENCHANT_DAMAGE.value          # add_damage_to_attack
CONFLAGRATION = SkillEffectType.CONFLAGRATION.value            # burn/炎上


class TestActor126301(unittest.TestCase):
    """角色126301 みんなを見守る山ガール 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 126301 みんなを見守る山ガール
        # 火属性attr=1, 物理型character_type=1, 后排position_type=2, 辅助role_type=5
        # AP=2, PP=2。默认Lv10，部分测试用Lv15验证Lv11+分支
        # caster 放后排中央
        self.caster = UnitState(
            unit_id="caster", name="みんなを見守る山ガール", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=126301, level=10,
            element=1, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110043, 120097, 130105, 130106, 130107],
            skill_levels={110043: 10, 120097: 10, 130105: 10,
                          130106: 10, 130107: 10},
            skill_cooldowns={},
        )

        # 友方前排中央（用于 PS3 after_ally_as_attack 触发与目标）
        # 持有 120097 作为 AS 技能，用于触发 PS3
        self.ally_front = UnitState(
            unit_id="ally_front", name="前方友方", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999101, level=10,
            element=1, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=20,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[120097], skill_levels={120097: 10}, skill_cooldowns={},
        )

        # 敌方前排中央（最近敌，主目标）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（多目标/邻接溅射测试用）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（多目标/邻接溅射测试用）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=4500, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally_front]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.level = 10
        self.caster.crit_rate = 0.0
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10

    def _reset_ally_front(self, hp=None, ap=10, pp=10, ep=0):
        """重置前方友方状态。"""
        self.ally_front.current_hp = hp if hp is not None else self.ally_front.max_hp
        self.ally_front.buffs = []
        self.ally_front.debuffs = []
        self.ally_front.is_alive = True
        self.ally_front.skill_cooldowns = {}
        self.ally_front.current_ap = ap
        self.ally_front.current_pp = pp
        self.ally_front.current_ep = ep

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ap = 4

    # ════════════════════════════════════════════════════════════════
    # EX: 110043 ラウラＳＯＳ！
    # ════════════════════════════════════════════════════════════════

    def test_ex_damage_enemy_all(self):
        """EX(110043) Block1: 敵全体に威力で攻撃。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110043, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证敌方全体受到伤害
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "enemy_cf应受到EX伤害（全体）")
        self.assertLess(self.enemy_lf.current_hp, self.enemy_lf.max_hp,
                        "enemy_lf应受到EX伤害（全体）")
        self.assertLess(self.enemy_rf.current_hp, self.enemy_rf.max_hp,
                        "enemy_rf应受到EX伤害（全体）")

    def test_ex_atk_down_applied_to_all_enemies(self):
        """EX(110043) Block2: atk_down(atk, 1action, percent) 施加给敌方全体。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110043, battlefield=self.bf, skip_cost=True
        )

        for e in (self.enemy_cf, self.enemy_lf, self.enemy_rf):
            atk_downs = [d for d in e.debuffs if d.effect_type == STATUS_ATTACK]
            self.assertGreater(len(atk_downs), 0,
                               f"{e.name}应有 atk_down debuff")

    def test_ex_atk_down_value_is_percent(self):
        """EX(110043) atk_down value_type=percent（百分比降低，非固定值）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[110043] = 10

        self.ss.execute_skill(
            caster=self.caster, skill_id=110043, battlefield=self.bf, skip_cost=True
        )

        # Lv10 atk tag value = 12.5%
        atk_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_downs), 0, "应有 atk_down debuff")
        # 验证 value 接近 12.5（Lv10 atk tag）
        self.assertAlmostEqual(atk_downs[0].value, 12.5, delta=0.5,
                               msg=f"Lv10 atk_down value应为约12.5%，实际: {atk_downs[0].value}")

    def test_ex_atk_down_duration_1_action(self):
        """EX(110043) atk_down duration=1, duration_type=action。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110043, battlefield=self.bf, skip_cost=True
        )

        atk_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_downs), 0, "应有 atk_down debuff")
        self.assertEqual(atk_downs[0].duration, 1, "atk_down duration应为1")

    # ════════════════════════════════════════════════════════════════
    # AS1: 120097 落雪注意
    # ════════════════════════════════════════════════════════════════

    def test_as1_damage_enemy_single(self):
        """AS1(120097) Block1: 敵単体に威力で攻撃。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120097, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证最近敌方(enemy_cf)受到伤害
        self.assertLess(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                        "enemy_cf应受到AS1伤害")
        # 单体攻击：其他敌方不应受伤
        self.assertEqual(self.enemy_lf.current_hp, self.enemy_lf.max_hp,
                         "enemy_lf不应受到AS1伤害（单体）")
        self.assertEqual(self.enemy_rf.current_hp, self.enemy_rf.max_hp,
                         "enemy_rf不应受到AS1伤害（单体）")

    def test_as1_no_debuff_no_buff(self):
        """AS1(120097): 仅造成伤害，不施加任何buff/debuff。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=120097, battlefield=self.bf, skip_cost=True
        )

        # enemy_cf 不应有 atk_down 等 debuff（区别于EX）
        atk_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_downs), 0, "AS1不应对敌方施加 atk_down")

    # ════════════════════════════════════════════════════════════════
    # PS1: 130105 整いサウナ（before_skill_use + random_choice + scale_by_alive_allies）
    # ════════════════════════════════════════════════════════════════

    def test_ps1_triggers_before_as_use(self):
        """PS1(130105) before_skill_use: AS技能(120097)使用前触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.assertGreater(len(ps1_actions), 0,
                           "AS使用前应收集PS1(130105)")

    def test_ps1_no_trigger_before_ex_use(self):
        """PS1(130105) before_skill_use: EX技能(110043)使用前不触发（仅AS触发）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=110043, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.assertEqual(len(ps1_actions), 0,
                         "EX使用前不应触发PS1（仅AS触发）")

    def test_ps1_block1_atk_up_buff(self):
        """PS1(130105) Block1: self atk_up buff 施加（scale_by_alive_allies, stackable）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )

        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "PS1执行后 caster 应有 atk_up buff")

    def test_ps1_atk_up_stackable(self):
        """PS1(130105) atk_up stackable=true 标记。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )

        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "应有 atk_up buff")
        self.assertTrue(atk_ups[0].is_stackable, "atk_up 应有 stackable=True 标记")

    def test_ps1_atk_up_attack_limited_1(self):
        """PS1(130105) atk_up attack_limited=1（1次攻击后消耗）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )

        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "应有 atk_up buff")
        self.assertEqual(getattr(atk_ups[0], 'attack_limited', 0), 1,
                         "atk_up attack_limited 应为1")

    def test_ps1_atk_up_scale_by_alive_allies(self):
        """PS1(130105) atk_up scale_by_alive_allies: 按存活友方数比例缩放。

        公式: final_value = value × (alive_allies / initial_allies)
        2人满员(caster+ally_front) = 100% value, 1人 = 50% value。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_ally_front()
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 2人存活场景
        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )

        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "应有 atk_up buff")
        value_2_alive = atk_ups[0].value

        # 1人存活场景（ally_front 阵亡）
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.ally_front.is_alive = False
        self.ally_front.current_hp = 0

        actions2 = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions2 = [a for a in actions2 if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions2, self.bf, trigger_timing="before_skill_use"
        )

        atk_ups2 = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups2), 0, "1人存活时也应有 atk_up buff")
        value_1_alive = atk_ups2[0].value

        # 1人存活时 value 应约为 2人存活时的 50%
        self.assertLess(value_1_alive, value_2_alive,
                        "1人存活时 atk_up value 应小于 2人存活时")
        self.assertAlmostEqual(value_1_alive, value_2_alive * 0.5, delta=value_2_alive * 0.15,
                               msg=f"1人存活时 value 应约为 2人时的50%，"
                                   f"实际: 1人={value_1_alive}, 2人={value_2_alive}")

    def test_ps1_atk_up_consumed_after_one_attack(self):
        """PS1(130105) atk_up attack_limited=1: 1次攻击后消耗。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # Step 1: 触发PS1给caster付与atk_up
        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )

        atk_ups_before = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups_before), 0, "应已施加 atk_up")

        # Step 2: caster 执行 AS 攻击（消耗 attack_limited=1）
        self.caster.skill_cooldowns = {}
        self.ss.execute_skill(
            caster=self.caster, skill_id=120097, battlefield=self.bf, skip_cost=True
        )

        # atk_up 应被消耗（attack_limited=1 → 0 → 移除）
        atk_ups_after = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK
                         and getattr(b, 'attack_limited', 0) > 0]
        self.assertEqual(len(atk_ups_after), 0,
                         "1次攻击后 atk_up(attack_limited=1) 应被消耗")

    def test_ps1_random_choice_group1_burn_lv10(self):
        """PS1(130105) Lv10 random_choice group=1: 选中60%burn分支(Block2)。

        用 set_branch_override 强制选择 block_id=2（burn附魔）。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130105] = 10

        # 强制选择 burn 分支（block_id=2 是 group1 的 burn 分支）
        def _override(ctx):
            if ctx['group_id'] == 1:
                return 2  # block_id=2: burn enchant
            return 4  # block_id=4: splash enchant
        self.ss.set_branch_override(_override)

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )

        self.ss.clear_branch_override()

        # 验证有 burn 附魔buff（ENCHANT_DAMAGE + add_status=burn）
        enchants = [b for b in self.caster.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertGreater(len(enchants), 0, "应有附魔buff")
        # 验证是 burn 附魔（hit_limited_flags 中有 add_status='burn'）
        burn_enchants = [b for b in enchants
                         if getattr(b, 'hit_limited_flags', {}) and
                         b.hit_limited_flags.get('add_status') == 'burn']
        self.assertGreater(len(burn_enchants), 0, "应有 burn 附魔buff")

