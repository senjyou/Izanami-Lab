    def test_enchant_burn_hit_limited_consumed(self):
        """burn附魔 hit_limited=1: 1次攻击后消耗。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130105] = 10

        def _override(ctx):
            if ctx['group_id'] == 1:
                return 2  # burn
            return 5  # 空（group2的空分支是block_id=5）
        self.ss.set_branch_override(_override)

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )
        self.ss.clear_branch_override()

        enchants_before = [b for b in self.caster.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertGreater(len(enchants_before), 0, "应已施加附魔buff")
        self.assertEqual(getattr(enchants_before[0], 'hit_limited', 0), 1,
                         "附魔 hit_limited 应为1")

        # 执行 AS 攻击（消耗 hit_limited）
        self.caster.skill_cooldowns = {}
        self.ss.execute_skill(
            caster=self.caster, skill_id=120097, battlefield=self.bf, skip_cost=True
        )

        # 附魔buff应被消耗
        enchants_after = [b for b in self.caster.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants_after), 0,
                         "1次攻击后附魔buff应被消耗（hit_limited消耗完毕）")

    # ════════════════════════════════════════════════════════════════
    # 集成测试：PS1 触发附魔 → caster 攻击 → 附魔伤害 + carried_debuff 完整链路
    # ════════════════════════════════════════════════════════════════

    def test_integration_ps1_burn_enchant_full_chain(self):
        """集成：PS1 触发 burn附魔 → caster AS攻击 → 主伤害+burn debuff+附魔buff消耗。

        完整流程：
        1. PS1 触发：caster 获得 atk_up + burn附魔
        2. caster 执行 AS 攻击 enemy_cf
        3. enemy_cf 受到主攻击伤害 + burn debuff
        4. 附魔buff被消耗（hit_limited=1）
        5. atk_up被消耗（attack_limited=1）
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 10
        self.caster.skill_levels[130105] = 10

        def _override(ctx):
            if ctx['group_id'] == 1:
                return 2  # burn
            return 5  # 空（group2的空分支是block_id=5）
        self.ss.set_branch_override(_override)

        # Step 1: 触发 PS1
        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )
        self.ss.clear_branch_override()

        # 验证附魔buff已施加
        enchants = [b for b in self.caster.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertGreater(len(enchants), 0, "Step1: 应已施加附魔buff")

        # Step 2: caster 执行 AS 攻击
        enemy_hp_before = self.enemy_cf.current_hp
        self.caster.skill_cooldowns = {}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120097, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Step 3: 验证 enemy_cf 受到伤害
        self.assertLess(self.enemy_cf.current_hp, enemy_hp_before,
                        "Step3: enemy_cf 应受到主攻击+附魔伤害")

        # Step 4: 验证附魔buff已被消耗
        enchants_after = [b for b in self.caster.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants_after), 0,
                         "Step4: 附魔buff应已被消耗")

        # Step 5: 验证 burn debuff 已施加给 enemy_cf
        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        self.assertGreater(len(burns), 0,
                           "Step5: enemy_cf 应有 burn debuff")

    def test_integration_ps1_lv15_burn_and_splash_with_carried_debuffs(self):
        """集成：Lv15 PS1 → burn+splash附魔 → AS攻击 → 4重效果（burn debuff + splash伤害 + heal_efficacy_down + dmg_dealt_down）。

        完整流程：
        1. Lv15 PS1 触发：caster 获得 atk_up + burn+heal_efficacy_down + splash+dmg_dealt_down
        2. caster 执行 AS 攻击 enemy_cf
        3. enemy_cf 受到主攻击+splash附魔伤害 + burn debuff + heal_efficacy_down + dmg_dealt_down
        4. 邻接敌方受到 splash 伤害 + dmg_dealt_down
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.level = 15
        self.caster.skill_levels[130105] = 15

        def _override(ctx):
            if ctx['group_id'] == 1:
                return 6  # Lv11+ burn + heal_efficacy_down
            return 8  # Lv11+ splash + dmg_dealt_down
        self.ss.set_branch_override(_override)

        # Step 1: 触发 PS1
        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=120097, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130105]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="before_skill_use"
        )
        self.ss.clear_branch_override()

        # 验证2个附魔buff共存
        enchants = [b for b in self.caster.buffs if b.effect_type == ENCHANT_DAMAGE]
        self.assertEqual(len(enchants), 2, "Step1: 应有2个附魔buff（burn + splash）")

        # Step 2: caster 执行 AS 攻击
        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp
        self.caster.skill_cooldowns = {}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120097, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Step 3: enemy_cf 受到伤害
        self.assertLess(self.enemy_cf.current_hp, hp_cf_before,
                        "Step3: enemy_cf 应受到主攻击+附魔伤害")

        # Step 4: enemy_cf 有 burn debuff
        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        self.assertGreater(len(burns), 0, "Step4: enemy_cf 应有 burn debuff")

        # Step 5: enemy_cf 有 heal_efficacy_down debuff
        heal_effs = [d for d in self.enemy_cf.debuffs if d.effect_type == RECEIVED_HEALING]
        self.assertGreater(len(heal_effs), 0, "Step5: enemy_cf 应有 heal_efficacy_down debuff")

        # Step 6: enemy_cf 有 dmg_dealt_down debuff
        dmg_dealt_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_dealt_downs), 0,
                           "Step6: enemy_cf 应有 dmg_dealt_down debuff")

        # Step 7: 邻接敌方受到 splash 伤害
        splash_total = (hp_lf_before - self.enemy_lf.current_hp) + \
                       (hp_rf_before - self.enemy_rf.current_hp)
        self.assertGreater(splash_total, 0, "Step7: 邻接敌方应受到 splash 伤害")

    # ════════════════════════════════════════════════════════════════
    # 配置标记验证（simultaneous_limit / global_condition）
    # ════════════════════════════════════════════════════════════════

    def test_ps2_global_condition_ally_alive_count_ge_2(self):
        """PS2(130106) global_condition: ally_alive_count >= 2 配置存在。"""
        parsed = self.dl.get_parsed_skill_data(130106)
        self.assertIsNotNone(parsed, "PS2 应有 parsed 数据")
        gc = parsed.get("global_condition")
        self.assertIsNotNone(gc, "PS2 应有 global_condition")
        self.assertEqual(gc.get("type"), "ally_alive_count")
        self.assertEqual(gc.get("operator"), ">=")
        self.assertEqual(gc.get("value"), 2)

    def test_ps1_trigger_type_before_skill_use(self):
        """PS1(130105) trigger_type: before_skill_use 配置正确。"""
        parsed = self.dl.get_parsed_skill_data(130105)
        self.assertIsNotNone(parsed, "PS1 应有 parsed 数据")
        self.assertEqual(parsed.get("trigger_type"), "before_skill_use")

    def test_ps3_trigger_type_after_ally_as_attack(self):
        """PS3(130107) trigger_type: after_ally_as_attack 配置正确。"""
        parsed = self.dl.get_parsed_skill_data(130107)
        self.assertIsNotNone(parsed, "PS3 应有 parsed 数据")
        self.assertEqual(parsed.get("trigger_type"), "after_ally_as_attack")

    def test_ps1_two_independent_random_choice_groups(self):
        """PS1(130105) random_choice: 2个独立 group_id（group1=burn, group2=splash）。"""
        parsed = self.dl.get_parsed_skill_data(130105)
        self.assertIsNotNone(parsed, "PS1 应有 parsed 数据")
        blocks = parsed.get("effect_blocks", [])

        group_ids = set()
        for block in blocks:
            cond = block.get("condition")
            if cond and cond.get("type") == "random_choice":
                group_ids.add(cond.get("group_id"))
        self.assertEqual(group_ids, {1, 2},
                         f"PS1 应有2个独立 group_id (1=burn, 2=splash)，实际: {group_ids}")

    def test_ps1_atk_up_scale_by_alive_allies_flag(self):
        """PS1(130105) atk_up flags: scale_by_alive_allies=true 配置存在。"""
        parsed = self.dl.get_parsed_skill_data(130105)
        self.assertIsNotNone(parsed, "PS1 应有 parsed 数据")
        blocks = parsed.get("effect_blocks", [])
        block1 = blocks[0]
        effects = block1.get("effects", [])
        self.assertGreater(len(effects), 0)
        flags = effects[0].get("flags", {}) or {}
        self.assertTrue(flags.get("scale_by_alive_allies", False),
                        "atk_up 应有 scale_by_alive_allies=true 标记")

    def test_ps1_burn_enchant_burn_damage_pct_30(self):
        """PS1(130105) burn附魔 flags: burn_damage_pct=30 配置存在。"""
        parsed = self.dl.get_parsed_skill_data(130105)
        blocks = parsed.get("effect_blocks", [])
        # 找到 burn 附魔的 block（block_id=2 或 6）
        burn_blocks = [b for b in blocks if b.get("block_id") in (2, 6)]
        self.assertGreater(len(burn_blocks), 0, "应有 burn 附魔block")
        for b in burn_blocks:
            effects = b.get("effects", [])
            self.assertGreater(len(effects), 0)
            flags = effects[0].get("flags", {}) or {}
            self.assertEqual(flags.get("burn_damage_pct"), 30,
                             "burn附魔 burn_damage_pct 应为30")

    def test_ps1_carried_debuff_duration_owner_caster_for_heal_efficacy(self):
        """PS1(130105) Lv11+ heal_efficacy_down: duration_owner=caster 配置存在。

        描述："自身が次の行動を終えるまでの間" → duration_owner=caster
        """
        parsed = self.dl.get_parsed_skill_data(130105)
        blocks = parsed.get("effect_blocks", [])
        # block_id=6 是 Lv11+ burn + heal_efficacy_down
        block6 = next((b for b in blocks if b.get("block_id") == 6), None)
        self.assertIsNotNone(block6, "应有 block_id=6 (Lv11+ burn + heal_efficacy_down)")
        effects = block6.get("effects", [])
        # 第2个 effect 是 heal_efficacy_down
        heal_eff_effect = next((e for e in effects if e.get("effect_type") == "heal_efficacy_down"),
                               None)
        self.assertIsNotNone(heal_eff_effect, "Lv11+ burn block 应有 heal_efficacy_down effect")
        flags = heal_eff_effect.get("flags", {}) or {}
        self.assertEqual(flags.get("duration_owner"), "caster",
                         "heal_efficacy_down 应有 duration_owner=caster")
        self.assertTrue(flags.get("carried_debuff", False),
                        "heal_efficacy_down 应有 carried_debuff=true")


if __name__ == "__main__":
    unittest.main()
