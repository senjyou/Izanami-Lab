"""角色119302 商売上手のエンジェルナース 专项E2E测试（「観察」mark全链 + 回復無効/回復リンク + HP阈值减伤）

技能列表（5个）:
- EX: 110076 チクっとするよ～？（最低HP比例敵を含む縦列[威力]+横列[威力2]2段攻撃）
- AS: 120165 トリアージ・スラスト（「観察」状態の敵を優先 + 「観察」時のみ防御30%無視）
- PS1: 130169 アナライザ・フォーカス（after_self_attacked → 攻撃者に「観察」2自身行動+攻撃down(重複可)
       + 回復無効(Lv1-14)/回復リンク(Lv15+)。「観察」と同時に解除、付与者死亡で解除）
- PS2: 130170 コーリングナース（「観察」状態の敵がAS使用した後に追撃+EXゲージ-1、Lv11+ PP-1）
- PS3: 130171 バイタルチェック（ターン開始時ステルス1ターン+現在HP20%超過分ダメージ減少1ターン）

覆盖维度:
1. EX enemy_column + lowest_hp_priority 索敌（最低HP比例敌所在纵列前后2人 + 横列3人）
2. AS mark_first_priority 索敌（「観察」持有者优先、距离最近；无持有者回退最近敌）
3. AS ignore_condition target_has_mark（対象持「観察」時のみ防御30%無視）
4. PS1 触发（after_self_attacked）+ mark「観察」+ atk_down(stackable, linked_buff_id)
5. PS1 Lv10 回復無効（heal_efficacy_down 100% → 対象受到治療归零）
6. PS1 Lv15 回復リンク（対象受到治療100%転送給自身、対象本身正常回復）
7. PS1 「観察」期限切れ（自身2回行動終了）→ linked debuffs级联移除
8. PS1 「観察」被驱散 → linked debuffs级联移除（驱散路径级联）
9. PS1 付与者死亡（source_death_remove flag）
10. PS2 新trigger after_enemy_skill_use（「観察」敵のAS使用後追撃+EP-1、Lv11+ PP-1）
11. PS2 负向：无「観察」敵/同阵营AS/EX使用 不触发
12. PS3 on_turn_start ステルス+HP阈值减伤 buff（1ターン、threshold_base=current_hp）
13. 配置校验
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, AuraUpdateTiming, TriggerTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value       # atk_up/atk_down 共用
RECEIVED_HEALING = SkillEffectType.RECEIVED_HEALING.value  # heal_efficacy_up/down 共用
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
HEAL_LINK = SkillEffectType.HEAL_LINK.value
MARK = SkillEffectType.MARK.value
STEALTH = "stealth"

KANSATSU = "観察"  # mark name 常量

# 通用敌方AS（skill_type=1，用于130170触发验证）
_GENERIC_AS = 120001


def _make_mark(name, source_id="pre", count=1):
    """生成 count 个指定名称 mark BuffState（debuff, 永续）。"""
    return [
        BuffState(
            buff_id=f"{source_id}_mark_{i}_{id(source_id)}",
            name=name,
            effect_type=MARK,
            value=0,
            duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=source_id,
            source_skill_id=0,
            is_debuff=True,
        )
        for i in range(count)
    ]


class TestActor119302(unittest.TestCase):
    """角色119302 商売上手のエンジェルナース 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 119302 商売上手のエンジェルナース (土属性attr=4, AGI型character_type=3)
        self.caster = UnitState(
            unit_id="caster", name="エンジェルナース", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=119302, level=10,
            element=4, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=10,
            skills=[110076, 120165, 130169, 130170, 130171],
            skill_levels={110076: 10, 120165: 10, 130169: 10,
                          130170: 10, 130171: 10},
            skill_cooldowns={},
        )

        # 敌方前排（cf为最近敌）
        self.enemy_cf = self._mk_enemy("enemy_cf", "敵中前", Position.ENEMY_CENTER_FRONT, 8000, 99999, ep=3)
        self.enemy_lf = self._mk_enemy("enemy_lf", "敵左前", Position.ENEMY_LEFT_FRONT, 7000, 99999, ep=2)
        self.enemy_rf = self._mk_enemy("enemy_rf", "敵右前", Position.ENEMY_RIGHT_FRONT, 6500, 99999, ep=2)
        # 敌方后排
        self.enemy_cb = self._mk_enemy("enemy_cb", "敵中後", Position.ENEMY_CENTER_BACK, 6000, 99999, ep=1)
        self.enemy_lb = self._mk_enemy("enemy_lb", "敵左後", Position.ENEMY_LEFT_BACK, 6000, 99999, ep=1)
        self.enemy_rb = self._mk_enemy("enemy_rb", "敵右後", Position.ENEMY_RIGHT_BACK, 6000, 99999, ep=1)

        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf,
                              self.enemy_cb, self.enemy_lb, self.enemy_rb]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _mk_enemy(self, unit_id, name, position, atk, hp, ep=2, pp=4, ap=4):
        return UnitState(
            unit_id=unit_id, name=name, side=Side.ENEMY,
            position=position, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=hp, current_hp=hp,
            attack=atk, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=ap, current_pp=pp, current_ep=ep,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    # ════════════════════════════════════════════════════════════════
    # 辅助方法
    # ════════════════════════════════════════════════════════════════

    def _reset(self, level=10):
        self.caster.current_hp = self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = 10
        self.caster.current_pp = 10
        self.caster.current_ep = 10
        self.caster.level = level
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = level
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf,
                  self.enemy_cb, self.enemy_lb, self.enemy_rb]:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True

    def _get_marks(self, unit, name=KANSATSU):
        return [d for d in unit.debuffs + unit.buffs
                if d.effect_type == MARK and d.name == name]

    def _get_auras(self, unit, effect_type):
        return [b for b in unit.debuffs + unit.buffs if b.effect_type == effect_type]

    def _direct_heal(self, target, pct=100):
        """对 target 自身执行一次直接治疗（走 _apply_heal 完整路径，含heal_link/回復無効）。
        理论治疗量 = target.attack × pct%。"""
        heal_obj = type('obj', (object,), {
            'effect_type': 'heal', 'target_type': 'self', 'target_identifier': None,
            'value': pct, 'value_tag': None, 'value_source': None,
            'duration': None, 'duration_type': None, 'duration_tag': None,
            'hit_count': None, 'hit_count_tag': None, 'condition': None, 'flags': {},
        })()
        return self.ss._apply_heal(target, heal_obj, self.bf)

    # ════════════════════════════════════════════════════════════════
    # EX 110076 チクっとするよ～？
    # ════════════════════════════════════════════════════════════════

    def test_ex_110076_column_and_row_targeting(self):
        """EX: 最低HP比例敵(enemy_cf)を含む縦列(cf+cb)+横列(前排3人)の2段攻撃。"""
        self._reset()
        # enemy_cf 设为最低HP比例
        self.enemy_cf.current_hp = int(self.enemy_cf.max_hp * 0.2)
        hp_before = {u.unit_id: u.current_hp for u in [self.enemy_cf, self.enemy_cb,
                                                       self.enemy_lf, self.enemy_rf,
                                                       self.enemy_lb, self.enemy_rb]}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # 縦列: cf + cb 受击
        self.assertLess(self.enemy_cf.current_hp, hp_before['enemy_cf'], "主目标cf应受击")
        self.assertLess(self.enemy_cb.current_hp, hp_before['enemy_cb'], "同纵列cb应受击")
        # 横列: 前排3人受击
        self.assertLess(self.enemy_lf.current_hp, hp_before['enemy_lf'], "前排lf应受横列攻击")
        self.assertLess(self.enemy_rf.current_hp, hp_before['enemy_rf'], "前排rf应受横列攻击")
        # 不同纵列/横列的后排 lb/rb 不受击（横列=前排）
        self.assertEqual(self.enemy_lb.current_hp, hp_before['enemy_lb'],
                         "左后lb不在纵列/横列内，不应受击")
        self.assertEqual(self.enemy_rb.current_hp, hp_before['enemy_rb'],
                         "右后rb不在纵列/横列内，不应受击")

    def test_ex_110076_no_damage_to_unrelated_column(self):
        """EX: 最低HP比例敵在后排cb时，纵列=cb+cf，横列=后排3人，前排lf/rf仅受纵列(中列)。"""
        self._reset()
        self.enemy_cb.current_hp = int(self.enemy_cb.max_hp * 0.1)
        hp_before = {u.unit_id: u.current_hp for u in [self.enemy_cf, self.enemy_cb,
                                                       self.enemy_lf, self.enemy_lb, self.enemy_rb]}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_cb.current_hp, hp_before['enemy_cb'])
        self.assertLess(self.enemy_cf.current_hp, hp_before['enemy_cf'], "中列前排cf应随纵列受击")
        self.assertLess(self.enemy_lb.current_hp, hp_before['enemy_lb'], "后排横列lb应受击")
        self.assertLess(self.enemy_rb.current_hp, hp_before['enemy_rb'], "后排横列rb应受击")
        self.assertEqual(self.enemy_lf.current_hp, hp_before['enemy_lf'],
                         "左前lf不在中列/后排横列，不应受击")

    # ════════════════════════════════════════════════════════════════
    # AS 120165 トリアージ・スラスト
    # ════════════════════════════════════════════════════════════════

    def test_as_120165_prefers_marked_enemy(self):
        """AS: 「観察」状態の敵を優先（持有者优先，距离最近优先于mark数）。"""
        self._reset()
        # rf 持有「観察」但距离比 cf 远 → 仍选 rf
        self.enemy_rf.debuffs.extend(_make_mark(KANSATSU, "src1", 1))
        hp_before = {u.unit_id: u.current_hp for u in [self.enemy_cf, self.enemy_rf, self.enemy_lf]}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120165, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_rf.current_hp, hp_before['enemy_rf'],
                        "应优先攻击持有「観察」的rf（距离优先于无mark的cf）")
        self.assertEqual(self.enemy_cf.current_hp, hp_before['enemy_cf'], "无mark的cf不应被攻击")
        self.assertEqual(self.enemy_lf.current_hp, hp_before['enemy_lf'], "无mark的lf不应被攻击")

    def test_as_120165_marked_nearest_among_marked(self):
        """AS: 复数「観察」持有者中选距离最近者（不看mark数）。"""
        self._reset()
        # lf(近) 1个mark、rf(远) 3个mark → 选 lf（距离优先）
        self.enemy_lf.debuffs.extend(_make_mark(KANSATSU, "src1", 1))
        self.enemy_rf.debuffs.extend(_make_mark(KANSATSU, "src2", 3))
        hp_before = {u.unit_id: u.current_hp for u in [self.enemy_lf, self.enemy_rf]}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120165, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_lf.current_hp, hp_before['enemy_lf'],
                        "复数「観察」持有者中应选距离最近的lf")
        self.assertEqual(self.enemy_rf.current_hp, hp_before['enemy_rf'],
                         "较远的rf不应被攻击（不看mark数）")

    def test_as_120165_fallback_nearest_when_no_mark(self):
        """AS: 无「観察」持有者时回退最近敌人。"""
        self._reset()
        hp_before = {u.unit_id: u.current_hp for u in [self.enemy_cf, self.enemy_lf]}
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120165, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_cf.current_hp, hp_before['enemy_cf'],
                        "无mark持有者时应攻击最近敌cf")
        self.assertEqual(self.enemy_lf.current_hp, hp_before['enemy_lf'])

    def test_as_120165_conditional_ignore_defense(self):
        """AS: 対象持「観察」時のみ防御30%無視。相同面板下 mark持有者受到伤害更大。"""
        self._reset()
        # 两个相同面板的敌人，rf 持有「観察」；将 cf 设为索敌首位不可行（rf有mark必选rf），
        # 因此分两次执行：先打有mark的rf，再清除mark打cf，比较伤害
        self.enemy_rf.debuffs.extend(_make_mark(KANSATSU, "src1", 1))
        rf_hp_before = self.enemy_rf.current_hp
        self.ss.execute_skill(caster=self.caster, skill_id=120165,
                              battlefield=self.bf, skip_cost=True)
        dmg_marked = rf_hp_before - self.enemy_rf.current_hp
        self.assertGreater(dmg_marked, 0)

        # 清除rf的mark与伤害记录，重新攻击（此时索敌回退最近敌cf）
        self._reset()
        rf_hp_before2 = self.enemy_rf.current_hp
        # rf 无mark时不会被选（有更近的cf），改用 cf 对比：
        # cf 无mark被攻击（30%穿防不生效）
        cf_hp_before = self.enemy_cf.current_hp
        self.ss.execute_skill(caster=self.caster, skill_id=120165,
                              battlefield=self.bf, skip_cost=True)
        dmg_unmarked = cf_hp_before - self.enemy_cf.current_hp
        self.assertGreater(dmg_unmarked, 0)
        # 穿防30%生效时伤害应明显更高（同面板）
        self.assertGreater(dmg_marked, dmg_unmarked,
                           "对「観察」目标的伤害应高于无mark目标（30%穿防生效）")

    # ════════════════════════════════════════════════════════════════
    # PS1 130169 アナライザ・フォーカス
    # ════════════════════════════════════════════════════════════════

    def _trigger_ps1(self, attacker=None):
        attacker = attacker or self.enemy_cf
        self.enemy_cf.current_pp = 4
        actions = self.ts.trigger_after_self_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=attacker, primary_target=self.caster, triggered_by=attacker,
        )
        ps1 = [a for a in actions if a.skill_id == 130169]
        self.assertGreater(len(ps1), 0, "被攻击后应触发PS1(130169)")
        self.ss._execute_trigger_actions_inline(ps1, self.bf)
        return ps1

    def test_ps1_130169_applies_mark_and_atk_down(self):
        """PS1: 被攻击后给攻击者挂「観察」(2自身行動)+atk_down(stackable, linked)。"""
        self._reset()
        self._trigger_ps1(self.enemy_cf)
        marks = self._get_marks(self.enemy_cf)
        self.assertEqual(len(marks), 1, "攻击者应获得1个「観察」mark")
        self.assertEqual(marks[0].duration, 2, "「観察」持续2自身行動")
        self.assertTrue(getattr(marks[0], 'source_death_remove', False),
                        "「観察」应带source_death_remove")
        atk_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == STATUS_ATTACK]
        self.assertGreaterEqual(len(atk_downs), 1, "攻击者应获得atk_down")
        self.assertTrue(getattr(atk_downs[0], 'linked_buff_id', '') == KANSATSU,
                        "atk_down应linked到「観察」")
        self.assertTrue(atk_downs[0].unremovable, "atk_down应为unremovable")
        # 实际攻击力下降验证
        final_atk = self.dms._calculate_final_stat(self.enemy_cf, "attack")
        self.assertLess(final_atk, self.enemy_cf.attack, "atk_down应实际降低攻击力")

    def test_ps1_13069_heal_invalid_lv10(self):
        """PS1 Lv10: 回復無効（heal_efficacy_down 100%）→ 対象受到治療归零。"""
        self._reset(level=10)
        self._trigger_ps1(self.enemy_cf)
        # 攻击者应持有 heal_efficacy_down（RECEIVED_HEALING debuff, value=100）
        eff_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == RECEIVED_HEALING]
        self.assertGreaterEqual(len(eff_downs), 1, "Lv1-14 应附加回復無効（heal_efficacy_down）")
        self.assertEqual(eff_downs[0].value, 100, "回復無効应为100%")
        # 治疗攻击者（理论值 = enemy_cf.atk 8000）→ 实际回血为0
        self.enemy_cf.current_hp = self.enemy_cf.max_hp - 10000
        self._direct_heal(self.enemy_cf, pct=100)
        self.assertEqual(self.enemy_cf.max_hp - self.enemy_cf.current_hp, 10000,
                         "回復無効下治疗应完全无效")

    def test_ps1_130169_heal_link_lv15(self):
        """PS1 Lv15: 回復リンク（対象受到治療100%転送給自身，対象本身正常回復）。"""
        self._reset(level=15)
        self._trigger_ps1(self.enemy_cf)
        # Lv15 回復無効被替换：不应有 heal_efficacy_down
        eff_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == RECEIVED_HEALING]
        self.assertEqual(len(eff_downs), 0, "Lv15 回復リンク应替换回復無効")
        # 対象（enemy_cf）与自身（caster）都持有 heal_link
        cf_links = [b for b in self.enemy_cf.debuffs if b.effect_type == HEAL_LINK]
        self.assertGreaterEqual(len(cf_links), 1, "対象应持有回復リンク(debuff侧)")
        self.assertEqual(cf_links[0].value, 100, "転送率应为100%")
        self.assertTrue(getattr(cf_links[0], 'linked_buff_id', '') == KANSATSU,
                        "回復リンク应linked到「観察」")
        self_links = [b for b in self.caster.buffs if b.effect_type == HEAL_LINK]
        self.assertGreaterEqual(len(self_links), 1, "自身也应持有回復リンク")
        # 治疗 enemy_cf（理论值 = 即时ATK×100%；PS1的atk_down-20%使其为 8000×0.8=6400）
        # 属性依赖效果必须使用含buff的即时属性值，故治疗基数为降低后的ATK
        self.enemy_cf.current_hp = self.enemy_cf.max_hp - 10000
        self.caster.current_hp = self.caster.max_hp - 8000
        self._direct_heal(self.enemy_cf, pct=100)
        self.assertEqual(self.enemy_cf.current_hp - (self.enemy_cf.max_hp - 10000), 6400,
                         "Lv15対象本身应正常回復（回復無効已被替换）")
        self.assertEqual(self.caster.current_hp - (self.caster.max_hp - 8000), 6400,
                         "回復リンク应将理論治療量100%転送給自身")

    def test_ps1_130169_mark_expiry_cascades(self):
        """PS1: 「観察」期限切れ（自身2回行動終了）→ linked debuffs一同消失。"""
        self._reset()
        self._trigger_ps1(self.enemy_cf)
        self.assertGreaterEqual(len(self._get_marks(self.enemy_cf)), 1)
        self.assertGreaterEqual(len([d for d in self.enemy_cf.debuffs
                                     if d.effect_type == STATUS_ATTACK]), 1)
        # 模拟battle_flow在行动间清除just_applied标记后，自身（caster）2次行动结束
        for _ in range(2):
            for d in self.enemy_cf.debuffs:
                d.just_applied = False
            self.aus.process_source_maneuver_end(self.caster, self.bf.get_all_units())
        self.assertEqual(len(self._get_marks(self.enemy_cf)), 0,
                         "2回行動終了後「観察」应消失")
        self.assertEqual(len([d for d in self.enemy_cf.debuffs
                              if getattr(d, 'linked_buff_id', '') == KANSATSU]), 0,
                         "「観察」到期后linked debuffs应级联消失")

    def test_ps1_130169_mark_dispel_cascades(self):
        """PS1: 「観察」被驱散 → linked debuffs级联移除（驱散路径）。"""
        self._reset()
        self._trigger_ps1(self.enemy_cf)
        self.assertGreaterEqual(len(self._get_marks(self.enemy_cf)), 1)
        # 敌方使用 remove_debuff（解除全部debuff）
        dispel_obj = type('obj', (object,), {
            'effect_type': 'remove_debuff', 'target_type': 'self',
            'target_identifier': None, 'value': None, 'value_tag': None,
            'value_source': None, 'duration': None, 'duration_type': None,
            'duration_tag': None, 'hit_count': None, 'hit_count_tag': None,
            'condition': None, 'flags': {},
        })()
        self.ss._apply_remove_debuff(self.enemy_cf, dispel_obj, self.bf)
        self.assertEqual(len(self._get_marks(self.enemy_cf)), 0,
                         "「観察」应可被驱散")
        self.assertEqual(len([d for d in self.enemy_cf.debuffs
                              if getattr(d, 'linked_buff_id', '') == KANSATSU]), 0,
                         "「観察」被驱散后linked debuffs应级联消失")

    def test_ps1_13069_linked_debuffs_resist_direct_dispel(self):
        """PS1: linked debuffs（攻撃down/回復無効）不可被直接驱散，仅随mark消失。"""
        self._reset()
        self._trigger_ps1(self.enemy_cf)
        n_atk_down = len([d for d in self.enemy_cf.debuffs if d.effect_type == STATUS_ATTACK])
        dispel_obj = type('obj', (object,), {
            'effect_type': 'remove_debuff', 'target_type': 'self',
            'target_identifier': None, 'value': None, 'value_tag': None,
            'value_source': None, 'duration': None, 'duration_type': None,
            'duration_tag': None, 'hit_count': None, 'hit_count_tag': None,
            'condition': None, 'flags': {},
        })()
        self.ss._apply_remove_debuff(self.enemy_cf, dispel_obj, self.bf)
        # mark被驱散 → 级联移除linked（最终都不在）
        self.assertEqual(len([d for d in self.enemy_cf.debuffs
                              if d.effect_type == STATUS_ATTACK]), 0,
                         "驱散mark后linked atk_down应级联消失")
        # 反向场景：只驱散非mark debuff时linked不被牵连 —— 用LIFO限制1个，
        # 且mark不在removable末位时，linked不被直接选中
        self._reset()
        self._trigger_ps1(self.enemy_cf)
        # 再挂一个普通debuff（最近施加，LIFO首位）
        plain = BuffState(
            buff_id="plain_debuff", name="plain", effect_type=RECEIVED_DAMAGE,
            value=10.0, duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="enemy_lf", source_skill_id=0, is_debuff=True,
        )
        self.enemy_cf.debuffs.append(plain)
        dispel_obj2 = type('obj', (object,), {
            'effect_type': 'remove_debuff', 'target_type': 'self',
            'target_identifier': None, 'value': None, 'value_tag': None,
            'value_source': None, 'duration': None, 'duration_type': None,
            'duration_tag': None, 'hit_count': None, 'hit_count_tag': None,
            'condition': None, 'flags': {'count': 1},
        })()
        self.ss._apply_remove_debuff(self.enemy_cf, dispel_obj2, self.bf)
        self.assertEqual(len(self._get_marks(self.enemy_cf)), 1,
                         "LIFO解除1个普通debuff时「観察」不应被移除")
        self.assertGreaterEqual(len([d for d in self.enemy_cf.debuffs
                                     if d.effect_type == STATUS_ATTACK]), 1,
                                "linked atk_down不应被直接驱散")

    def test_ps1_13069_atk_down_stacks(self):
        """PS1: atk_down重複可 —— 多次触发叠加多个stack，全部linked。"""
        self._reset()
        self._trigger_ps1(self.enemy_cf)
        # PS1有冷却2，第二次触发前清除冷却（模拟冷却结束后再次被攻击）
        self.caster.skill_cooldowns = {}
        self._trigger_ps1(self.enemy_cf)
        atk_downs = [d for d in self.enemy_cf.debuffs
                     if d.effect_type == STATUS_ATTACK
                     and getattr(d, 'linked_buff_id', '') == KANSATSU]
        self.assertGreaterEqual(len(atk_downs), 2,
                                "2次触发应叠加2个linked atk_down（重複可）")

    def test_ps1_13069_source_death_remove_flag(self):
        """PS1: 「観察」+linked debuffs 均带 source_death_remove（付与者死亡时消失）。"""
        self._reset()
        self._trigger_ps1(self.enemy_cf)
        marks = self._get_marks(self.enemy_cf)
        self.assertTrue(getattr(marks[0], 'source_death_remove', False))
        for d in self.enemy_cf.debuffs:
            if getattr(d, 'linked_buff_id', '') == KANSATSU:
                self.assertTrue(getattr(d, 'source_death_remove', False),
                                f"{d.name} 应带source_death_remove")

    # ════════════════════════════════════════════════════════════════
    # PS2 130170 コーリングナース
    # ════════════════════════════════════════════════════════════════

    def _enemy_use_as(self, actor, skill_id=_GENERIC_AS):
        """模拟敌方使用AS后的Phase3触发收集与执行。"""
        actions = self.ts.trigger_after_as_attack(
            actor=actor, skill_id=skill_id, result={"total_damage": 100},
            battlefield=self.bf,
        )
        ps2 = [a for a in actions if a.skill_id == 130170]
        if ps2:
            self.ss._execute_trigger_actions_inline(ps2, self.bf)
        return ps2

    def test_ps2_130170_triggers_on_marked_enemy_as(self):
        """PS2: 「観察」状態の敵がAS使用した後に発動（追撃+EP-1）。"""
        self._reset()
        self.enemy_cf.debuffs.extend(_make_mark(KANSATSU, "src", 1))
        cf_hp_before = self.enemy_cf.current_hp
        cf_ep_before = self.enemy_cf.current_ep
        pp_before = self.caster.current_pp
        ps2 = self._enemy_use_as(self.enemy_cf)
        self.assertGreater(len(ps2), 0, "「観察」状態の敵使用AS应触发PS2")
        self.assertLess(self.enemy_cf.current_hp, cf_hp_before, "追撃伤害应命中该敌")
        self.assertEqual(self.enemy_cf.current_ep, cf_ep_before - 1, "EXゲージ应-1")
        self.assertEqual(self.caster.current_pp, pp_before - 1, "PS发动消耗PP 1")
        # Lv10: 不削PP
        self.assertEqual(self.enemy_cf.current_pp, 4, "Lv10不应削PP")

    def test_ps2_130170_no_mark_no_trigger(self):
        """PS2: 无「観察」的敌使用AS → 不触发。"""
        self._reset()
        cf_hp_before = self.enemy_cf.current_hp
        ps2 = self._enemy_use_as(self.enemy_cf)
        self.assertEqual(len(ps2), 0, "无「観察」敵使用AS不应触发")
        self.assertEqual(self.enemy_cf.current_hp, cf_hp_before)

    def test_ps2_130170_same_side_no_trigger(self):
        """PS2: 同阵营（友方）使用AS → 不触发。"""
        self._reset()
        self.caster.debuffs.extend(_make_mark(KANSATSU, "src", 1))
        cf_hp_before = self.enemy_cf.current_hp
        ps2 = self._enemy_use_as(self.caster)
        self.assertEqual(len(ps2), 0, "同阵营AS使用不应触发after_enemy_skill_use")
        self.assertEqual(self.enemy_cf.current_hp, cf_hp_before)

    def test_ps2_130170_ex_skill_no_trigger(self):
        """PS2: 「観察」敵使用EX（skill_type=3）→ 不触发（アクティブスキル=ASのみ）。"""
        self._reset()
        self.enemy_cf.debuffs.extend(_make_mark(KANSATSU, "src", 1))
        cf_hp_before = self.enemy_cf.current_hp
        ps2 = self._enemy_use_as(self.enemy_cf, skill_id=110076)
        self.assertEqual(len(ps2), 0, "EX使用不应触发（仅AS）")
        self.assertEqual(self.enemy_cf.current_hp, cf_hp_before)

    def test_ps2_130170_lv11_removes_pp(self):
        """PS2 Lv11+: 追撃+EXゲージ-1+PP-1。"""
        self._reset(level=11)
        self.enemy_cf.debuffs.extend(_make_mark(KANSATSU, "src", 1))
        cf_pp_before = self.enemy_cf.current_pp
        ps2 = self._enemy_use_as(self.enemy_cf)
        self.assertGreater(len(ps2), 0)
        self.assertEqual(self.enemy_cf.current_pp, cf_pp_before - 1,
                         "Lv11+应追加削PP 1")

    def test_ps2_130170_hits_marked_actor(self):
        """PS2: 使用AS的「観察」敵在后排时也应被追撃（trigger_attacker定位）。"""
        self._reset()
        self.enemy_cb.debuffs.extend(_make_mark(KANSATSU, "src", 1))
        cb_hp_before = self.enemy_cb.current_hp
        ps2 = self._enemy_use_as(self.enemy_cb)
        self.assertGreater(len(ps2), 0, "后排「観察」敵使用AS应触发")
        self.assertLess(self.enemy_cb.current_hp, cb_hp_before,
                        "追撃应命中AS使用者（trigger_attacker）而非最近敌cf")
        self.assertEqual(self.enemy_cf.current_hp, self.enemy_cf.max_hp,
                         "最近敌cf不应被误击")

    # ════════════════════════════════════════════════════════════════
    # PS3 130171 バイタルチェック
    # ════════════════════════════════════════════════════════════════

    def test_ps3_130171_turn_start_stealth_and_threshold(self):
        """PS3: ターン開始時 自身にステルス1ターン+HP20%超過分減少(1ターン)。"""
        self._reset()
        self.caster.skill_cooldowns = {}
        actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps3 = [a for a in actions if a.skill_id == 130171]
        self.assertGreater(len(ps3), 0, "回合开始应触发PS3(130171)")
        self.ss._execute_trigger_actions_inline(ps3, self.bf, trigger_timing="on_turn_start")
        # ステルス
        stealths = [b for b in self.caster.buffs if b.effect_type == SkillEffectType.STEALTH.value]
        self.assertGreaterEqual(len(stealths), 1, "应获得ステルス")
        self.assertEqual(stealths[0].duration, 1, "ステルス持续1ターン")
        # HP阈值减伤buff
        thresholds = [b for b in self.caster.buffs
                      if b.effect_type == "dmg_taken_down_threshold"]
        self.assertGreaterEqual(len(thresholds), 1, "应获得HP阈值减伤buff")
        self.assertEqual(thresholds[0].threshold_pct, 20.0, "阈值应为20%")
        self.assertEqual(thresholds[0].threshold_base, "current_hp", "阈值基数为当前HP")
        self.assertEqual(thresholds[0].duration, 1, "持续1ターン")

    def test_ps3_130171_threshold_reduces_excess_damage(self):
        """PS3: 現在HPの20%超過分のみdmg%減少（Lv10=50%）。"""
        self._reset()
        self.caster.skill_cooldowns = {}
        actions = self.ts.trigger_turn_start_non_preemptive(self.bf)
        ps3 = [a for a in actions if a.skill_id == 130171]
        self.ss._execute_trigger_actions_inline(ps3, self.bf, trigger_timing="on_turn_start")

        # 降低当前HP使阈值(=当前HP×20%)低于基础伤害3000：HP=10000 → 阈值2000
        self.caster.current_hp = 10000

        # 无buff基准伤害：直接调用calculate_damage
        # 移除buff计算基准
        thresholds = [b for b in self.caster.buffs
                      if b.effect_type == "dmg_taken_down_threshold"]
        self.caster.buffs.remove(thresholds[0])
        dmg_obj = type('obj', (object,), {
            'power': 100.0, 'hit_count': 1, 'element': 1,
            'ignore_defense': 0, 'ignore_shield': 0, 'hp_scaling_bonus': 0.0,
            'cannot_crit': True, 'force_crit': False, 'bonus_crit_rate': 0.0,
            'skill_id': 999999, 'name': 'test', 'base_value_source': None,
        })
        base_result = self.dms.calculate_damage(self.enemy_cf, self.caster, dmg_obj)
        base_dmg = base_result.total_damage
        self.assertGreater(base_dmg, 0)

        # 恢复buff后再计算（阈值按受击时当前HP=10000动态计算）
        self.caster.buffs.append(thresholds[0])
        buffed_result = self.dms.calculate_damage(self.enemy_cf, self.caster, dmg_obj)
        buffed_dmg = buffed_result.total_damage
        # 语义与130160一致（実戦検証）: 单次伤害>阈值(当前HP×20%)时，整段伤害按dmg%减免
        # 阈值=10000×20%=2000，基础3000>2000 → 3000×(1-50%)=1500
        threshold = self.caster.current_hp * 0.2
        self.assertGreater(base_dmg, threshold, "基准伤害应超过阈值才能触发减伤")
        expected = base_dmg * 0.5
        self.assertLess(buffed_dmg, base_dmg, "超過分減少应生效")
        self.assertAlmostEqual(buffed_dmg, expected, delta=max(5, expected * 0.02),
                               msg=f"阈值减伤: base={base_dmg} > threshold={threshold} → base×0.5")

    # ════════════════════════════════════════════════════════════════
    # 配置校验
    # ════════════════════════════════════════════════════════════════

    def test_config_validation(self):
        """配置校验: trigger_type已注册 / target_identifier / 持续时间。"""
        p169 = self.dl.get_parsed_skill_data(130169)
        self.assertEqual(p169['trigger_type'], 'after_self_attacked')
        for blk_ in p169['effect_blocks']:
            for eff_ in blk_['effects']:
                if eff_['target_type'] == 'enemy_single':
                    self.assertEqual(eff_.get('target_identifier'), 'trigger_attacker',
                                     "130169 反击型效果必须定位trigger_attacker")
        p170 = self.dl.get_parsed_skill_data(130170)
        self.assertEqual(p170['trigger_type'], 'after_enemy_skill_use')
        self.assertIn(p170['trigger_type'],
                      __import__('src.combat_v2.services.trigger_service',
                                 fromlist=['TRIGGER_TYPE_MAP']).TRIGGER_TYPE_MAP,
                      "after_enemy_skill_use 必须已注册到TRIGGER_TYPE_MAP")
        for blk_ in p170['effect_blocks']:
            for eff_ in blk_['effects']:
                self.assertEqual(eff_.get('target_identifier'), 'trigger_attacker',
                                 "130170 追撃效果必须定位trigger_attacker")
        p171 = self.dl.get_parsed_skill_data(130171)
        self.assertEqual(p171['trigger_type'], 'on_turn_start')
        for blk_ in p171['effect_blocks']:
            for eff_ in blk_['effects']:
                self.assertEqual(eff_['duration_type'], 'turn',
                                 "130171 「1ターン」效果必须用turn制")
        # EX
        p076 = self.dl.get_parsed_skill_data(110076)
        types = [e['target_type'] for b in p076['effect_blocks'] for e in b['effects']]
        self.assertIn('enemy_column', types, "EX Block1应为縦列")
        self.assertIn('enemy_row', types, "EX Block2应为横列")


if __name__ == '__main__':
    unittest.main()
