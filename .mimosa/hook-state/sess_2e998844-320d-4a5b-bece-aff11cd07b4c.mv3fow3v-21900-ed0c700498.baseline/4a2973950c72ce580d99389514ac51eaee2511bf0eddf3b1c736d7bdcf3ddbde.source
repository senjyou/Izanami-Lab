# -*- coding: utf-8 -*-
"""回归测试：130184「ストレラ」的攻击力上升必须在伤害结算前生效（先加攻再攻击）

Bug: effect_blocks 顺序为 [damage, buff(atk_up), pp-]，导致伤害先结算、加攻后生效，
     等于加攻对本次追击伤害无效。
Fix: 将 buff 块（PP恢复+atk_up）调整到 damage 块之前 → [buff, damage, pp-]。
"""
import os
import sys

os.chdir(os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))))
sys.path.insert(0, os.getcwd())

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.skill_service import SkillService


def _build():
    dl = DataLoader()
    dl.load_all()

    def mk(uid, side, pos, element, hp, atk, skills, level):
        return UnitState(
            unit_id=uid, name=uid, side=side, position=pos, character_id=500301 if side == Side.ALLY else 999001,
            level=level, element=element, character_type=2,
            max_hp=hp, current_hp=hp, attack=atk, defense=1000, speed=100,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=10,
            current_ap=4, current_pp=4, current_ep=0,
            skills=skills, skill_levels={s: level for s in skills}, skill_cooldowns={},
        )

    # 500301 施法者（主土4/副火1），108301 攻击友方（属性可调），敌木桩
    c500 = mk("c500", Side.ALLY, Position.ALLY_CENTER_BACK, 4, 50000, 10000, [130184], 15)
    attacker = mk("atk", Side.ALLY, Position.ALLY_LEFT_FRONT, 1, 50000, 8000, [], 1)
    enemy = mk("enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT, 2, 1000000, 1000, [], 1)

    bf = BattlefieldState()
    bf.friend_team = [c500, attacker]
    bf.enemy_team = [enemy]

    rs = ResourceService()
    dms = DamageService()
    tgs = TargetService()
    aus = AuraService()
    tsvc = TriggerService()
    tsvc.set_data_loader(dl)
    ss = SkillService(dl, rs, target_service=tgs, damage_service=dms,
                      aura_service=aus, trigger_service=tsvc)
    tsvc.set_skill_service(ss)
    return bf, ss, c500, attacker, enemy


def _run(actor_element):
    bf, ss, c500, attacker, enemy = _build()
    attacker.element = actor_element
    ss._trigger_attacker = attacker
    ss._primary_target = enemy
    r = ss.execute_skill(c500, 130184, bf)
    dmg = [t for t in r['effects_applied'] if t.get('effect_type') == 'damage']
    assert dmg, "追撃伤害未结算"
    return dmg[0]['targets'][0]['calc_detail']['atk']


def test_strela_atk_up_applied_before_damage():
    """攻击友方为アグレッシブ(火1) → 伤害使用加攻后的ATK (10000×1.35=13500)"""
    assert _run(1) == 13500


def test_strela_atk_up_applied_before_damage_cute():
    """攻击友方为キュート(土4) → 伤害使用加攻后的ATK (13500)"""
    assert _run(4) == 13500


def test_strela_no_atk_up_for_other_element():
    """攻击友方非触发属性(水2) → 伤害使用基础ATK (10000)"""
    assert _run(2) == 10000
