"""Regression: heal_link must transfer THEORETICAL heal, not actual heal.

Bug: heal_link transfer used actual_heal (capped at missing HP) instead of
     the theoretical heal amount. When the target was at full HP, actual_heal=0
     and the transfer was skipped entirely. However, per game behavior, the
     heal_link beneficiary should still receive the full theoretical amount.

     Example: Target at full HP receives heal (theory=20000, actual=0 because
     full HP). heal_link beneficiary should still be healed for 20000.

Fix:
  1. skill_service _apply_heal: Use heal_amount (theoretical) for transfer
  2. skill_service _apply_split_heal_by_damage: Use per_target (theoretical),
     remove `if actual_heal > 0` guard
  3. status_service apply_regen: Restructure so heal_link transfer happens
     even when unit is at full HP, using heal (theoretical) instead of actual

Constraint: The transfer itself is still capped at the LINK TARGET's missing HP.
            Only the SOURCE heal is theoretical; the link target's actual heal
            is still min(transfer_amount, link_missing).
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


HEAL_LINK = SkillEffectType.HEAL_LINK.value
HOT = SkillEffectType.HEAL_OVER_TIME.value


def _make_unit(unit_id, name, side, position, *, hp=50000, atk=10000,
               defense=4000, speed=500, current_hp=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=2, character_type=1,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


def _make_heal_link_buff(caster_uid, target_uid, transfer_pct=100.0, duration=1):
    return BuffState(
        buff_id=f"{caster_uid}_heal_link_{target_uid}",
        name="回復リンク",
        effect_type=HEAL_LINK,
        value=transfer_pct,
        duration=duration,
        timing_type=AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
        source_unit_id=caster_uid,
        source_skill_id=120154,
        is_debuff=False,
        original_duration_type="attacker_action",
    )


def _make_hot_buff(caster_uid, value=50.0, caster_attack=10000):
    return BuffState(
        buff_id=f"{caster_uid}_hot_{id(caster_uid)}",
        name="継続回復",
        effect_type=HOT,
        value=value,
        duration=3,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=caster_uid,
        caster_attack=caster_attack,
        heal_base="atk",
        is_debuff=False,
    )


class TestRegHealLinkTheoretical(unittest.TestCase):
    """heal_link must transfer theoretical heal even when target is at full HP."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts, aus, dms, sts

    def _apply_heal_link(self, target, caster, aura_service, transfer_pct=100.0):
        buff = _make_heal_link_buff(caster.unit_id, target.unit_id, transfer_pct)
        aura_service.add_aura(target, buff)
        return buff

    # ── Test 1: direct heal on full-HP target ──

    def test_direct_heal_full_hp_transfers_theoretical(self):
        """When target is at full HP and receives direct heal (actual=0),
        heal_link must still transfer the theoretical heal amount to the link target."""
        # Caster (link target) at low HP
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, atk=10000, current_hp=10000)
        # Target at FULL HP with heal_link linked to caster
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=50000, atk=10000, current_hp=50000)  # full HP
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)

        # Apply heal_link to target (linked to caster, 100% transfer)
        self._apply_heal_link(target, caster, aus)

        # Create heal effect: 50% of ATK = 5000 theoretical heal
        heal_effect = type('obj', (object,), {
            'effect_type': 'heal',
            'value': 50.0,
            'target_type': 'ally_single',
            'flags': {'heal_base': 'atk'},
            'target_identifier': None,
            'hit_count': None,
            'condition': None,
        })()
        ss._current_skill_id = 120013

        caster_hp_before = caster.current_hp  # 10000
        target_hp_before = target.current_hp  # 50000 (full)

        result = ss._apply_heal(caster, heal_effect, bf)

        # Target: actual heal = 0 (full HP), but theoretical = 5000
        self.assertEqual(target.current_hp, 50000,
                         "target at full HP should receive 0 actual heal")

        # Caster (link target): should receive 5000 transfer (theoretical × 100%)
        expected_transfer = 5000
        self.assertEqual(caster.current_hp, caster_hp_before + expected_transfer,
                         f"caster should receive {expected_transfer} theoretical heal transfer "
                         f"even though target's actual heal was 0")

        # Verify heal_link_transfers recorded
        transfers = result.get("heal_link_transfers", [])
        self.assertEqual(len(transfers), 1, "one heal_link transfer should be recorded")
        self.assertEqual(transfers[0]["source_theoretical_heal"], 5000,
                         "source_theoretical_heal should be 5000 (theoretical, not actual)")
        self.assertEqual(transfers[0]["transfer_heal"], 5000,
                         "transfer_heal should be 5000 (100% of theoretical)")

    # ── Test 2: HOT on full-HP target ──

    def test_hot_full_hp_transfers_theoretical(self):
        """When target is at full HP and receives HOT (actual=0),
        heal_link must still transfer the theoretical heal amount."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, current_hp=10000)
        # Target at FULL HP with heal_link
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=50000, current_hp=50000)  # full HP
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)

        # Apply heal_link to target (linked to caster, 100% transfer)
        self._apply_heal_link(target, caster, aus)

        # Apply HOT buff to target: 50% of caster_attack=10000 → heal=5000
        hot_buff = _make_hot_buff(caster_uid="healer_id", value=50.0, caster_attack=10000)
        target.buffs.append(hot_buff)

        caster_hp_before = caster.current_hp  # 10000
        target_hp_before = target.current_hp  # 50000 (full)

        total_heal, details = sts.apply_regen(target, dms, bf)

        # Target: actual heal = 0 (full HP)
        self.assertEqual(target.current_hp, 50000,
                         "target at full HP should receive 0 actual HOT heal")

        # Caster (link target): should receive 5000 transfer (theoretical)
        expected_transfer = 5000
        self.assertEqual(caster.current_hp, caster_hp_before + expected_transfer,
                         f"caster should receive {expected_transfer} theoretical heal transfer "
                         f"from HOT even though target's actual heal was 0")

        # Verify heal_link_transfers recorded in regen details
        for detail in details:
            transfers = detail.get('heal_link_transfers', [])
            if transfers:
                self.assertEqual(transfers[0]["source_theoretical_heal"], 5000,
                                 "source_theoretical_heal should be 5000")
                self.assertEqual(transfers[0]["transfer_heal"], 5000,
                                 "transfer_heal should be 5000")

    # ── Test 3: split_heal_by_damage on full-HP target ──

    def test_split_heal_full_hp_transfers_theoretical(self):
        """When target is at full HP and receives split_heal_by_damage (actual=0),
        heal_link must still transfer the theoretical heal amount."""
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, atk=10000, current_hp=10000)
        # Target at FULL HP with heal_link
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=50000, atk=10000, current_hp=50000)  # full HP
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)

        # Apply heal_link to target (linked to caster, 100% transfer)
        self._apply_heal_link(target, caster, aus)

        # Set up block damage total for split_heal_by_damage
        ss._block_damage_total = {1: 10000}
        ss._current_block_id = 1

        # Create split_heal_by_damage effect: 50% of damage = 5000 per target
        split_effect = type('obj', (object,), {
            'effect_type': 'split_heal_by_damage',
            'value': 50.0,
            'target_type': 'ally_all',
            'flags': {'split': True},
            'target_identifier': None,
            'hit_count': None,
            'condition': None,
        })()
        ss._current_skill_id = 220360

        caster_hp_before = caster.current_hp  # 10000
        target_hp_before = target.current_hp  # 50000 (full)

        result = ss._apply_split_heal_by_damage(caster, split_effect, bf)

        # Target: actual heal = 0 (full HP)
        self.assertEqual(target.current_hp, 50000,
                         "target at full HP should receive 0 actual split_heal")

        # Caster (link target): should receive transfer from target's theoretical heal
        # per_target = 10000 * 50% / 2 = 2500 (split between 2 targets)
        # caster also gets its own split_heal (not full HP): 2500 actual
        # caster total = 2500 (own split_heal) + 2500 (transfer from target) = 5000
        # But we only check the transfer part:
        transfers = result.get("heal_link_transfers", [])
        self.assertGreaterEqual(len(transfers), 1,
                                "at least one heal_link transfer should be recorded")

        # Find the transfer from target to caster
        target_to_caster = [t for t in transfers if t["source_id"] == target.unit_id]
        self.assertEqual(len(target_to_caster), 1,
                         "exactly one transfer from full-HP target to caster")
        self.assertEqual(target_to_caster[0]["source_theoretical_heal"], 2500,
                         "source_theoretical_heal should be 2500 (per_target theoretical)")
        self.assertEqual(target_to_caster[0]["transfer_heal"], 2500,
                         "transfer_heal should be 2500 (100% of theoretical)")

    # ── Test 4: transfer still capped at link target's missing HP ──

    def test_transfer_capped_at_link_target_missing_hp(self):
        """Even with theoretical heal transfer, the link target's actual heal
        is still capped at their missing HP."""
        # Caster (link target) at near-full HP (only 1000 missing)
        caster = _make_unit("caster", "施法者", Side.ALLY, Position.ALLY_LEFT_FRONT,
                            hp=50000, atk=10000, current_hp=49000)
        # Target at FULL HP with heal_link
        target = _make_unit("target", "目標", Side.ALLY, Position.ALLY_CENTER_FRONT,
                            hp=50000, atk=10000, current_hp=50000)
        bf = _make_bf(caster, target)

        ss, ts, aus, dms, sts = self._make_services(bf)

        # Apply heal_link to target (linked to caster, 100% transfer)
        self._apply_heal_link(target, caster, aus)

        # Create heal effect: 50% of ATK = 5000 theoretical heal
        heal_effect = type('obj', (object,), {
            'effect_type': 'heal',
            'value': 50.0,
            'target_type': 'ally_single',
            'flags': {'heal_base': 'atk'},
            'target_identifier': None,
            'hit_count': None,
            'condition': None,
        })()
        ss._current_skill_id = 120013

        result = ss._apply_heal(caster, heal_effect, bf)

        # Target: full HP, actual = 0
        self.assertEqual(target.current_hp, 50000)

        # Caster: theoretical transfer = 5000, but missing = 1000
        # So actual transfer = min(5000, 1000) = 1000
        self.assertEqual(caster.current_hp, 50000,
                         "caster should be capped at max_hp (49000 + 1000 = 50000)")

        transfers = result.get("heal_link_transfers", [])
        self.assertEqual(len(transfers), 1)
        self.assertEqual(transfers[0]["source_theoretical_heal"], 5000,
                         "source_theoretical_heal should be 5000 (uncapped)")
        self.assertEqual(transfers[0]["transfer_heal"], 1000,
                         "transfer_heal should be 1000 (capped at link target's missing HP)")


if __name__ == '__main__':
    unittest.main()
