"""角色101302 穹を統べる虹色の号令 专项E2E测试（「攻勢」状态切换 + cover + PS后回复 + 友方累计伤害反应）

技能列表（5个）:
- EX: 110077 新しき一歩を（无攻勢: 净化+进入攻勢[debuff无效化+被ダメ-{dmg}%]；有攻勢: 临时攻up25%+敌全体攻击+解除攻勢）
- AS: 120166 パーフェクトオーダー（无攻勢: 含自身友方横一列 atk×{shield}%盾[1行动/死亡解除]；有攻勢: 敌2体攻击）
- PS1: 130172 ランパートシャッター（before_any_attacked cover+guard，HP>=50%限定，同時発動制限）
- PS2: 130173 セントリフレイン（after_ps_use: EP2消费+威力回复+PP+2，HP>=50%且EP>=2限定）
- PS3: 130174 リベンジスタンス（他の味方累计伤害>=其maxHP×20% → 按其类型分支，自身HP<50%限定）

覆盖维度:
1. EX 攻勢进入（净化+mark+debuff_immune+被ダメdown，Block2不执行——lacks_mark_at_start互斥）
2. EX 攻勢消耗（有攻勢时: 全体攻击+攻勢解除+linked auras级联移除+atk_up attack_limited消耗）
3. AS 盾分支/攻击分支互斥（ally_row盾 source_death_remove / 敌2体攻击）
4. PS1 cover+guard 触发（HP>=50%）与HP<50%不触发
5. PS2 after_ps_use 链式触发（EP-2/回复/PP+2net+1）、HP<50%或EP<2不触发、自身不递归
6. PS3 三类型分支（物理:被ダメdown/EN:回复/敏捷:暴击率up）、他の味方限定、HP<50%限定
7. 配置校验
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
STATUS_CRITICAL_CHANCE = SkillEffectType.STATUS_CRITICAL_CHANCE.value
MARK = SkillEffectType.MARK.value
SHIELD = SkillEffectType.SHIELD.value

KOSHI = "攻勢"


def _mk_debuff(name, effect_type, value, source_id="src", duration=3):
    return BuffState(
        buff_id=f"{source_id}_{name}_{id(name)}", name=name, effect_type=effect_type,
        value=value, duration=duration,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=source_id, source_skill_id=0, is_debuff=True,
    )


class TestActor101302(unittest.TestCase):

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        self.caster = UnitState(
            unit_id="caster", name="虹色の号令", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=101302, level=10,
            element=3, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=10, initial_passive_point=10, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=5,
            skills=[110077, 120166, 130172, 130173, 130174],
            skill_levels={110077: 10, 120166: 10, 130172: 10,
                          130173: 10, 130174: 10},
            skill_cooldowns={},
        )
        # 同排友方（ally_row盾目标）
        self.ally_lf = UnitState(
            unit_id="ally_lf", name="味方左前", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=5000, speed=450,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        # 累计伤害反应的友方（可改character_type）
        self.ally_rb = UnitState(
            unit_id="ally_rb", name="味方右後", side=Side.ALLY,
            position=Position.ALLY_RIGHT_BACK, character_id=999002, level=10,
            element=2, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=8000, defense=5000, speed=420,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.enemy_cf = self._mk_enemy("enemy_cf", "敵中前", Position.ENEMY_CENTER_FRONT)
        self.enemy_lf = self._mk_enemy("enemy_lf", "敵左前", Position.ENEMY_LEFT_FRONT)
        self.enemy_rf = self._mk_enemy("enemy_rf", "敵右前", Position.ENEMY_RIGHT_FRONT)

        self.bf.friend_team = [self.caster, self.ally_lf, self.ally_rb]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs, damage_service=self.dms,
            aura_service=self.aus, status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _mk_enemy(self, unit_id, name, position):
        return UnitState(
            unit_id=unit_id, name=name, side=Side.ENEMY,
            position=position, character_id=999001, level=10,
            element=2, character_type=1,
            max_hp=99999, current_hp=99999,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    def _reset(self, level=10):
        self.caster.current_hp = self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = 10
        self.caster.current_pp = 10
        self.caster.current_ep = 5
        self.caster.level = level
        self.caster.crit_counter = 0
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = level
        for u in [self.ally_lf, self.ally_rb]:
            u.current_hp = u.max_hp
            u.buffs = []
            u.debuffs = []
            u.is_alive = True
            u.cumulative_hp_damage = 0
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.cumulative_hp_damage = 0

    def _marks(self, unit, name=KOSHI):
        return [b for b in unit.buffs + unit.debuffs
                if b.effect_type == MARK and b.name == name]

    # ══════════════════ EX 110077 ══════════════════

    def test_ex_110077_enter_koshi(self):
        """EX无攻勢: 净化+进入攻勢（mark+debuff_immune+被ダメdown），Block2不执行。"""
        self._reset()
        self.caster.debuffs.append(_mk_debuff("test_atk_down", STATUS_ATTACK, 20.0))
        hp_before = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=110077,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 净化
        self.assertEqual(len(self.caster.debuffs), 0, "自身debuff应被全部解除")
        # 攻勢 mark + linked auras
        self.assertEqual(len(self._marks(self.caster)), 1, "应获得「攻勢」mark")
        immunes = [b for b in self.caster.buffs
                   if b.effect_type in ("debuff_immune", "DebuffImmune")]
        self.assertGreaterEqual(len(immunes), 1, "应获得debuff_immune buff")
        downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreaterEqual(len(downs), 1, "应获得被ダメージ减少buff")
        # Block2不执行（互斥）
        self.assertEqual(self.enemy_cf.current_hp, hp_before['enemy_cf'],
                         "无攻勢时Block2不应执行（互斥）")
        self.assertEqual(result["total_damage"], 0)

    def test_ex_110077_consume_koshi(self):
        """EX有攻勢: 敌全体攻击+攻勢解除+linked auras级联移除。"""
        self._reset()
        # 预置攻勢状态
        self.caster.buffs.append(BuffState(
            buff_id="pre_koshi", name=KOSHI, effect_type=MARK, value=0, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="caster", source_skill_id=110077, is_debuff=False,
        ))
        hp_before = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=110077,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertGreater(result["total_damage"], 0, "有攻勢时应执行敌全体攻击")
        for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]:
            self.assertLess(e.current_hp, hp_before[e.unit_id], "敌全体应受击")
        # 攻勢解除 + linked auras级联
        self.assertEqual(len(self._marks(self.caster)), 0, "攻勢应被解除")
        self.assertEqual(len([b for b in self.caster.buffs
                              if b.effect_type in ("debuff_immune", "DebuffImmune")]), 0,
                         "debuff_immune应随攻勢级联移除")
        self.assertEqual(len([b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]), 0,
                         "被ダメdown应随攻勢级联移除")
        # atk_up(attack_limited=1)消耗后不残留
        self.assertEqual(len([b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]), 0,
                         "临时atk_up应在攻击后消耗")

    # ══════════════════ AS 120166 ══════════════════

    def test_as_120166_shield_branch(self):
        """AS无攻勢: 含自身友方横一列盾（atk×shield%），source_death_remove。"""
        self._reset()
        result = self.ss.execute_skill(caster=self.caster, skill_id=120166,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        for u in [self.caster, self.ally_lf]:
            shields = [b for b in u.buffs if b.effect_type == SHIELD]
            self.assertGreaterEqual(len(shields), 1, f"{u.unit_id}同排友方应获得盾")
            if shields:
                # Lv10 shield tag = 25 → atk 10000 × 25% = 2500
                self.assertEqual(shields[0].shield_amount, 2500,
                                 "盾值应为攻击力×25%")
                self.assertTrue(getattr(shields[0], 'source_death_remove', False),
                                "盾应带source_death_remove")
        # 不同排友方（后排ally_rb）不应获得
        self.assertEqual(len([b for b in self.ally_rb.buffs if b.effect_type == SHIELD]), 0,
                         "不同排的ally_rb不应获得盾")

    def test_as_120166_attack_branch(self):
        """AS有攻勢: 敌2体攻击（无盾）。"""
        self._reset()
        self.caster.buffs.append(BuffState(
            buff_id="pre_koshi", name=KOSHI, effect_type=MARK, value=0, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="caster", source_skill_id=110077, is_debuff=False,
        ))
        hp_before = {e.unit_id: e.current_hp for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]}
        result = self.ss.execute_skill(caster=self.caster, skill_id=120166,
                                       battlefield=self.bf, skip_cost=True)
        self.assertTrue(result["success"])
        hit = [e.unit_id for e in [self.enemy_cf, self.enemy_lf, self.enemy_rf]
               if e.current_hp < hp_before[e.unit_id]]
        self.assertEqual(len(hit), 2, "应攻击敌2体")
        self.assertEqual(len([b for b in self.caster.buffs if b.effect_type == SHIELD]), 0,
                         "有攻勢时不应上盾")

    # ══════════════════ PS1 130172 ══════════════════

    def _trigger_cover(self):
        actions = self.ts.trigger_before_any_attacked(
            targets=[self.ally_lf], battlefield=self.bf,
            attacker=self.enemy_cf,
        )
        return [a for a in actions if a.skill_id == 130172]

    def test_ps1_130172_cover_triggers_when_hp_ge_50(self):
        """PS1: HP>=50%时友方被攻击前触发cover+guard（guard为特殊机制guard_active）。"""
        self._reset()
        ps1 = self._trigger_cover()
        self.assertGreater(len(ps1), 0, "HP满时应触发cover PS")
        self.ss._execute_trigger_actions_inline(ps1, self.bf)
        # guard: 特殊机制（unit.guard_active/guard_rate），非buff（130034同款）
        self.assertTrue(getattr(self.caster, 'guard_active', False), "应激活guard机制")
        self.assertEqual(getattr(self.caster, 'guard_rate', 0), 30.0, "guard率应为Lv10的30%")

    def test_ps1_130172_no_trigger_when_hp_below_50(self):
        """PS1: HP<50%时不触发。"""
        self._reset()
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        ps1 = self._trigger_cover()
        self.assertEqual(len(ps1), 0, "HP<50%时不应触发")

    # ══════════════════ PS2 130173 (after_ps_use) ══════════════════

    def _run_cover_ps(self):
        """执行一个自身PS（130172）以触发after_ps_use链。"""
        ps1 = self._trigger_cover()
        self.assertGreater(len(ps1), 0)
        self.ss._execute_trigger_actions_inline(ps1, self.bf)

    def test_ps2_130173_triggers_after_own_ps(self):
        """PS2: 自身PS执行后链式触发（EP-2+威力回复+PP net+1）。"""
        self._reset()
        ep_before = self.caster.current_ep
        pp_before = self.caster.current_pp
        self.caster.current_hp = int(self.caster.max_hp * 0.8)  # 制造回复空间
        self._run_cover_ps()
        # 资源经济: PS消耗1PP并同步+1EP（_deduct_cost）
        # 链条: 130172(PP-1,EP+1至cap5) → 130173(PP-1,EP+1,remove_ep-2,heal10%,PP+2)
        # EP: 5(cap) → 5 → 5 → 3; PP: 10 → 9 → 8 → 10(net 0); HP: +1000(威力10%)
        self.assertEqual(self.caster.current_ep, 3, "EP应为5-2(消费)且受PS+1EP经济影响")
        self.assertEqual(self.caster.current_pp, pp_before, "PP应net 0（两次-1消耗+2加算）")
        expected_heal = int(self.caster.attack * 0.10)  # Lv10 威力 tag = 10.0
        self.assertEqual(self.caster.current_hp - int(self.caster.max_hp * 0.8),
                         expected_heal, "回复量应为攻击力×威力%")

    def test_ps2_130173_no_trigger_when_hp_below_50(self):
        """PS2: HP<50%时不触发（用130174作为前置PS——其HP<50%限定可触发）。"""
        self._reset()
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.ally_rb.character_type = 1
        self.ally_rb.cumulative_hp_damage = int(self.ally_rb.max_hp * 0.2)
        self._trigger_ally_cumulative(self.ally_rb)  # 130174执行
        self.ss._execute_trigger_actions_inline(
            [a for a in self.ts.trigger_cumulative_damage(self.bf, [self.ally_rb])
             if a.skill_id == 130174], self.bf)
        self.assertEqual(self.caster.current_ep, 5, "HP<50%时130173不应消费EP")

    def test_ps2_130173_no_trigger_when_ep_below_2(self):
        """PS2: EP<2时不触发（消耗量不足）。注意PS执行自身+1EP（PP→EP经济）。"""
        self._reset()
        self.caster.current_ep = 0
        self._run_cover_ps()
        # 130172执行后EP=0+1=1，130173条件EP>=2不满足 → 不触发
        self.assertEqual(self.caster.current_ep, 1, "EP<2时不应触发（EP仅因前置PS+1）")

    # ══════════════════ PS3 130174 ══════════════════

    def _trigger_ally_cumulative(self, damaged_ally):
        """触发友方累计伤害检查（damaged_ally累计伤害已达标）。"""
        actions = self.ts.trigger_cumulative_damage(
            self.bf, damaged_units=[damaged_ally]
        )
        return [a for a in actions if a.skill_id == 130174]

    def test_ps3_130174_physical_ally_dmg_taken_down(self):
        """PS3: 物理友方累计伤害→自身被ダメdown 5%（重複可）。"""
        self._reset()
        self.caster.current_hp = int(self.caster.max_hp * 0.4)  # HP<50%
        self.ally_rb.character_type = 1  # 物理
        self.ally_rb.cumulative_hp_damage = int(self.ally_rb.max_hp * 0.2)
        ps3 = self._trigger_ally_cumulative(self.ally_rb)
        self.assertGreater(len(ps3), 0, "友方累计伤害达标应触发")
        self.ss._execute_trigger_actions_inline(ps3, self.bf)
        downs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreaterEqual(len(downs), 1, "应获得被ダメdown 5%")
        self.assertEqual(downs[0].value, 5)

    def test_ps3_130174_en_ally_heal(self):
        """PS3: EN友方累计伤害→自身威力回复。"""
        self._reset()
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.caster.current_ep = 0  # EP+1(PS经济)=1 <2，阻断130173链式跟随，隔离断言
        self.ally_rb.character_type = 2  # EN
        self.ally_rb.cumulative_hp_damage = int(self.ally_rb.max_hp * 0.25)
        hp_before = self.caster.current_hp
        ps3 = self._trigger_ally_cumulative(self.ally_rb)
        self.assertGreater(len(ps3), 0)
        self.ss._execute_trigger_actions_inline(ps3, self.bf)
        expected_heal = int(self.caster.attack * 0.30)  # Lv10 威力 = 30.0
        self.assertEqual(self.caster.current_hp - hp_before, expected_heal,
                         "EN分支应按威力回复")
        self.assertEqual(len([b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]), 0,
                         "EN分支不应获得被ダメdown")

    def test_ps3_130174_agile_ally_crit_up(self):
        """PS3: 敏捷友方累计伤害→自身会心率+2.5%。"""
        self._reset()
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.ally_rb.character_type = 3  # 敏捷
        self.ally_rb.cumulative_hp_damage = int(self.ally_rb.max_hp * 0.3)
        ps3 = self._trigger_ally_cumulative(self.ally_rb)
        self.assertGreater(len(ps3), 0)
        self.ss._execute_trigger_actions_inline(ps3, self.bf)
        crits = [b for b in self.caster.buffs if b.effect_type == STATUS_CRITICAL_CHANCE]
        self.assertGreaterEqual(len(crits), 1, "应获得会心率up")
        self.assertEqual(crits[0].value, 2.5)

    def test_ps3_130174_no_trigger_when_self_damaged(self):
        """PS3: 自身累计伤害达标不触发（他の味方限定）。"""
        self._reset()
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.caster.cumulative_hp_damage = int(self.caster.max_hp * 0.5)
        ps3 = self._trigger_ally_cumulative(self.caster)
        self.assertEqual(len(ps3), 0, "自身受伤不应触发（他の味方限定）")

    def test_ps3_130174_no_trigger_when_hp_ge_50(self):
        """PS3: 自身HP>=50%时不触发。"""
        self._reset()
        self.ally_rb.character_type = 1
        self.ally_rb.cumulative_hp_damage = int(self.ally_rb.max_hp * 0.2)
        ps3 = self._trigger_ally_cumulative(self.ally_rb)
        self.assertEqual(len(ps3), 0, "HP>=50%时不应触发")

    # ══════════════════ 配置校验 ══════════════════

    def test_config_validation(self):
        """配置校验: trigger_type注册 + 互斥block + 同时发动制限。"""
        p172 = self.dl.get_parsed_skill_data(130172)
        self.assertTrue(p172.get('simultaneous_limit'), "130172应配置同時発動制限")
        p173 = self.dl.get_parsed_skill_data(130173)
        self.assertEqual(p173['trigger_type'], 'after_ps_use')
        self.assertIn('after_ps_use',
                      __import__('src.combat_v2.services.trigger_service',
                                 fromlist=['TRIGGER_TYPE_MAP']).TRIGGER_TYPE_MAP)
        p174 = self.dl.get_parsed_skill_data(130174)
        self.assertEqual(p174['trigger_type'], 'on_cumulative_damage')
        p077 = self.dl.get_parsed_skill_data(110077)
        conds = [b.get('condition', {}).get('type') for b in p077['effect_blocks']]
        self.assertIn('lacks_mark_at_start', conds, "EX应有lacks_mark_at_start互斥block")
        self.assertIn('has_mark_at_start', conds, "EX应有has_mark_at_start互斥block")


if __name__ == '__main__':
    unittest.main()
