"""回归测试: 回忆卡20089「父さんの、そして私の願い」的编成守卫

Bug（以文本描述为准发现）:
  400246 闘志【ALL】描述:
    「戦闘開始時に発動。榊野ヒイロ[疾走する自由の孤狼]に「闘志」を4つ、
      他の味方全体に「闘志」を2つ付与する。…
      榊野ヒイロ[疾走する自由の孤狼]が編成されていない場合、このスキルは発動しない」
  原实现只靠 block1(highlight_targets) 无匹配自然跳过，但 block2(ally_all_exclude_self)
  仍会执行 → ヒイロ未编成时，其他味方各得 2 层「闘志」，与描述矛盾。

修复:
  trigger.require_highlight_match = true（400246）→ highlight 未命中任何单位时
  整个技能不发动（battle_flow_controller._apply_memory_card_structured_effect）。
"""
import sys
import os
import unittest

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.entities.memory_card import MemoryCard
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.battle_flow_controller import BattleFlowController

MARK = SkillEffectType.MARK.value
TOUSHI = "闘志"
CARD_ID = 20089
HIIRO = 115302

_dl = DataLoader()
_dl.load_all()


def _mk_ally(cid, name, pos):
    return UnitState(
        unit_id=f"ally_{cid}", name=name, side=Side.ALLY, position=pos,
        character_id=cid, level=60, element=1, character_type=1,
        max_hp=10000, current_hp=10000, attack=1000, defense=100, speed=100,
        crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
        initial_active_point=0, initial_passive_point=0, max_extra_point=0,
        current_ap=0, current_pp=0, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={})


def _mk_enemy():
    return UnitState(
        unit_id="enemy_1", name="敵", side=Side.ENEMY, position=Position.ENEMY_CENTER_FRONT,
        character_id=999001, level=1, element=1, character_type=1,
        max_hp=999999, current_hp=999999, attack=10, defense=0, speed=50,
        crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
        initial_active_point=0, initial_passive_point=0, max_extra_point=0,
        current_ap=0, current_pp=0, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={})


def _make_card():
    m = _dl.load_memories().get(CARD_ID)
    return MemoryCard(card_id=CARD_ID, name=m.name, description=m.description,
                      rarity=m.rarity, highlights=m.highlights)


def _toushi_count(unit):
    return sum(int(getattr(b, 'stack_count', 1) or 1) for b in unit.buffs
               if b.effect_type == MARK and b.name == TOUSHI)


def _run(allies):
    bf = BattlefieldState()
    bf.friend_team = allies
    bf.enemy_team = [_mk_enemy()]
    bf.memory_cards = [_make_card()]
    ctrl = BattleFlowController(bf, _dl)
    ctrl.damage_service = DamageService()
    ctrl.aura_service = AuraService()
    ctrl._apply_memory_card_effects()
    return [_toushi_count(a) for a in allies]


class TestReg20089ToushiDeployGuard(unittest.TestCase):
    """400246 require_highlight_match：ヒイロ未编成时技能不发动"""

    def test_config_has_guard_flag(self):
        """配置校验：400246 必须开启 require_highlight_match"""
        eff = _dl.get_memory_effect(400246)
        self.assertIsNotNone(eff, "400246 结构化数据缺失")
        self.assertTrue(eff.get("trigger", {}).get("require_highlight_match"),
                        "400246 trigger.require_highlight_match 必须为 true")

    def test_no_marks_when_hiiro_absent(self):
        """ヒイロ未编成 → 其他味方不应获得「闘志」（修复前为各2层）"""
        a1 = _mk_ally(100201, "一般A", Position.ALLY_LEFT_FRONT)
        a2 = _mk_ally(101201, "一般B", Position.ALLY_CENTER_FRONT)
        counts = _run([a1, a2])
        self.assertEqual(counts, [0, 0],
                         f"ヒイロ未编成时不应付与闘志，实际 {counts}")

    def test_marks_when_hiiro_present(self):
        """ヒイロ编成 → ヒイロ4层、其他味方2层"""
        hiiro = _mk_ally(HIIRO, "ヒイロ", Position.ALLY_LEFT_FRONT)
        other = _mk_ally(101201, "一般B", Position.ALLY_CENTER_FRONT)
        counts = _run([hiiro, other])
        self.assertEqual(counts, [4, 2],
                         f"ヒイロ编成时应为 [4, 2]，实际 {counts}")

    def test_guard_does_not_affect_other_cards(self):
        """无该标志的回忆卡行为不变（回归保护）"""
        eff = _dl.get_memory_effect(400000)
        self.assertFalse(eff.get("trigger", {}).get("require_highlight_match", False),
                         "400000 不应被误加 require_highlight_match")


if __name__ == "__main__":
    unittest.main(verbosity=2)