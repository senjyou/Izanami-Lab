    # ─── EX: ふわとろのきもち ───

    def test_ex_skill_110003(self):
        """
        EX(110003) 全体伤害 + dmg_taken_up debuff + 最高攻敌人眩晕
        验证:
        1. 对敌方全体造成伤害
        2. 对敌方全体施加dmg_taken_up debuff（2次被攻击后消失，可叠加）
        3. 对最高攻敌人施加眩晕(knockout) 1行动
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110003, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 1. 验证敌方全体受到伤害
        for enemy in self.bf.enemy_team:
            self.assertLess(enemy.current_hp, enemy.max_hp,
                            f"{enemy.name}应受到EX伤害")

        # 2. 验证dmg_taken_up debuff
        for enemy in self.bf.enemy_team:
            dmg_taken_up_debuffs = [d for d in enemy.debuffs
                                    if d.effect_type == RECEIVED_DAMAGE]
            self.assertTrue(len(dmg_taken_up_debuffs) > 0,
                            f"{enemy.name}应有dmg_taken_up debuff")
            debuff = dmg_taken_up_debuffs[0]
            self.assertEqual(debuff.attack_limited, 2,
                             "dmg_taken_up应2次被攻击后消失")
            self.assertTrue(debuff.is_stackable,
                            "dmg_taken_up应可叠加")

        # 3. 验证最高攻敌人（enemy_front, attack=8000）被眩晕
        knockout_debuffs = [d for d in self.enemy_front.debuffs
                            if d.effect_type == KNOCKOUT]
        self.assertTrue(len(knockout_debuffs) > 0, "最高攻敌人应有眩晕debuff")
        self.assertEqual(knockout_debuffs[0].duration, 1, "眩晕应持续1行动")
        self.assertTrue(self.enemy_front.is_stunned, "最高攻敌人应处于眩晕状态")

        # 非最高攻敌人不应有眩晕
        for enemy in [self.enemy_back, self.enemy_left_front, self.enemy_right_back]:
            knockout_on_other = [d for d in enemy.debuffs if d.effect_type == KNOCKOUT]
            self.assertEqual(len(knockout_on_other), 0,
                             f"{enemy.name}不应有眩晕debuff")

    def test_ex_110003_knockout_on_highest_atk_not_nearest(self):
        """
        EX(110003) 严格验证：knockout应施加在最高攻敌方，而非最近敌方
        区分"选最高攻"与"选最近"两种逻辑。

        原配置中enemy_front既是最高攻(atk=8000)也是最近(距离²=0)，无法区分两种逻辑。
        本测试临时把enemy_right_back的attack设为最高(10000)，使其成为"最远+最高攻"。
        - enemy_right_back(1,2): atk=10000(最高攻), 距离²=2(最远)
        - enemy_front(0,1): atk=8000, 距离²=0(最近)

        若bug存在(选最近)：knockout会施加在enemy_front
        若修复正确(选最高攻)：knockout会施加在enemy_right_back
        """
        # 临时把enemy_right_back的attack设为最高，使其成为"最远+最高攻"
        self.enemy_right_back.attack = 10000

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110003, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 核心断言：knockout必须施加在最高攻敌方(enemy_right_back, atk=10000)
        knockout_on_highest = [d for d in self.enemy_right_back.debuffs
                               if d.effect_type == KNOCKOUT]
        self.assertTrue(len(knockout_on_highest) > 0,
                        "knockout应施加在最高攻敌方(enemy_right_back, atk=10000)，"
                        "而非最近敌方(enemy_front)")

        # 验证最近敌方(enemy_front)未获得knockout
        knockout_on_nearest = [d for d in self.enemy_front.debuffs
                               if d.effect_type == KNOCKOUT]
        self.assertEqual(len(knockout_on_nearest), 0,
                         "最近敌方(enemy_front, atk=8000)不应有knockout，"
                         "knockout应施加在最高攻敌方")

    # ─── AS1: ペンタブレイド ───

    def test_as1_skill_120048_basic(self):
        """
        AS1(120048) 基本5hit攻击
        验证: 对HP比例最低敌人造成5hit伤害
        """
        # 设置敌方右后HP比例最低（50%），其他满血
        self.enemy_right_back.current_hp = int(self.enemy_right_back.max_hp * 0.5)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120048, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "AS1应造成伤害")

        # 验证5hit（排除追加攻击）
        for e in dmg_effects:
            hits = e.get("hits", [])
            if hits and not e.get("flags", {}).get("is_follow_up"):
                self.assertEqual(len(hits), 5, f"AS1应为5hit, 实际: {len(hits)}")

        # 验证目标为HP比例最低敌人（enemy_right_back, 50%）
        target_ids = set()
        for e in dmg_effects:
            for t in e.get("targets", []):
                tid = t.get("target_id")
                if tid:
                    target_ids.add(tid)

        self.assertIn(self.enemy_right_back.unit_id, target_ids,
                      f"AS1应攻击HP比例最低敌人, 实际目标: {target_ids}")

    def test_as1_skill_120048_threshold_cross(self):
        """
        AS1(120048) HP穿越30%阈值追加攻击
        验证: 当目标HP从30%以上被打到30%以下时，追加一次攻击
        """
        # 设置敌方前排HP为60%，5hit后约剩3385(22.5%)，穿越30%阈值
        self.enemy_front.current_hp = int(self.enemy_front.max_hp * 0.6)
        # 让enemy_front成为HP比例最低的敌人
        for enemy in [self.enemy_back, self.enemy_left_front, self.enemy_right_back]:
            enemy.current_hp = enemy.max_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120048, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]

        # 应有2个伤害效果：5hit主攻击 + 1hit追加攻击
        self.assertTrue(len(dmg_effects) >= 2,
                        f"HP穿越30%阈值时应有追加攻击(至少2个伤害效果), 实际: {len(dmg_effects)}")

        # 验证追加攻击：第二个伤害效果应有伤害值
        if len(dmg_effects) >= 2:
            follow_up = dmg_effects[1]
            self.assertGreater(follow_up.get("total_damage", 0), 0,
                               "追加攻击应造成伤害")

        # 验证目标HP确实穿越了30%阈值
        hp_pct = self.enemy_front.current_hp / self.enemy_front.max_hp * 100
        self.assertLess(hp_pct, 30,
                        f"目标HP应低于30%, 实际: {hp_pct:.1f}%")

    # ─── AS2: レストブレイカー ───

    def test_as2_skill_120049_hp_scaling(self):
        """
        AS2(120049) 反比HP增伤
        验证: 敌人满血时无增伤，残血时最大增伤（hp_scaling_inverse + hp_scaling_enemy）
        """
        # 满血情况
        self.enemy_front.current_hp = self.enemy_front.max_hp

        result_full = self.ss.execute_skill(
            caster=self.caster, skill_id=120049, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_full["success"])

        dmg_full = [e for e in result_full["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_full) > 0, "AS2应造成伤害")
        total_dmg_full = sum(e.get("total_damage", 0) for e in dmg_full)

        # 重置敌人状态，设置低血量
        self.enemy_front.current_hp = int(self.enemy_front.max_hp * 0.1)
        self.enemy_front.shield = 0
        self.caster.skill_cooldowns = {}

        result_low = self.ss.execute_skill(
            caster=self.caster, skill_id=120049, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_low["success"])

        dmg_low = [e for e in result_low["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_low) > 0, "AS2应造成伤害")
        total_dmg_low = sum(e.get("total_damage", 0) for e in dmg_low)

        # 低血量时伤害应高于满血时（反比HP增伤）
        self.assertGreater(total_dmg_low, total_dmg_full,
                           f"敌人低血量时AS2伤害应更高: 低血量={total_dmg_low}, 满血={total_dmg_full}")

    # ─── PS1: チェイスブレイダー ───

    def test_ps1_skill_130054_follow_up(self):
        """
        PS1(130054) 追击
        验证: 其他友方使用AS技能后，PS1触发追击（after_ally_as_attack）
        """
        # 添加另一个友方角色来触发PS1
        ally_attacker = UnitState(
            unit_id="ally_attacker", name="友方攻击者", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=100301, level=10,
            element=1, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[120049], skill_levels={120049: 10}, skill_cooldowns={},
        )
        self.bf.friend_team = [self.caster, ally_attacker]

        # 友方攻击者使用AS技能
        result = self.ss.execute_skill(
            caster=ally_attacker, skill_id=120049, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 触发after_ally_as_attack（其他友方AS攻击后触发）
        trigger_actions = self.ts.trigger_after_ally_as_attack(
            ally_attacker, 120049, [self.enemy_front], self.bf
        )

        ps1_actions = [a for a in trigger_actions if a.skill_id == 130054]
        self.assertTrue(len(ps1_actions) > 0, "友方AS攻击后PS1应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="after_ally_as_attack"
        )

        # 验证追击造成了伤害
        self.assertTrue(
            any(e.current_hp < e.max_hp for e in self.bf.enemy_team if e.is_alive),
            "PS1追击应造成伤害"
        )

    def test_ps1_skill_130054_hp_bonus(self):
        """
        PS1(130054) HP≤30%增伤
        验证: 目标HP≤30%时，PS1追击获得conditional_power_bonus增伤，
        伤害应高于目标HP>30%时
        """
        # 添加另一个友方角色来触发PS1
        ally_attacker = UnitState(
            unit_id="ally_attacker", name="友方攻击者", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=100301, level=10,
            element=1, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[120049], skill_levels={120049: 10}, skill_cooldowns={},
        )
        self.bf.friend_team = [self.caster, ally_attacker]

        # 场景1: 目标HP>30%（满血），PS1无增伤
        self.enemy_front.current_hp = self.enemy_front.max_hp
        result1 = self.ss.execute_skill(
            caster=ally_attacker, skill_id=120049, battlefield=self.bf, skip_cost=True
        )
        trigger_actions1 = self.ts.trigger_after_ally_as_attack(
            ally_attacker, 120049, [self.enemy_front], self.bf
        )
        ps1_actions1 = [a for a in trigger_actions1 if a.skill_id == 130054]
        self.assertTrue(len(ps1_actions1) > 0, "PS1应触发")

        # 记录PS1攻击前的HP
        hp_before_ps1_normal = {}
        for e in self.bf.enemy_team:
            if e.is_alive:
                hp_before_ps1_normal[e.unit_id] = e.current_hp

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions1, self.bf, trigger_timing="after_ally_as_attack"
        )

        # 计算PS1对满血敌人造成的伤害
        ps1_dmg_normal = 0
        for e in self.bf.enemy_team:
            if e.is_alive and e.unit_id in hp_before_ps1_normal:
                ps1_dmg_normal += hp_before_ps1_normal[e.unit_id] - e.current_hp

        # 重置状态
        self.caster.skill_cooldowns = {}
        self.caster.current_pp = 10
        ally_attacker.skill_cooldowns = {}
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.debuffs = []

        # 场景2: 设置一个敌人HP≤30%，PS1应有增伤
        self.enemy_front.current_hp = int(self.enemy_front.max_hp * 0.25)
        result2 = self.ss.execute_skill(
            caster=ally_attacker, skill_id=120049, battlefield=self.bf, skip_cost=True
        )
        trigger_actions2 = self.ts.trigger_after_ally_as_attack(
            ally_attacker, 120049, [self.enemy_front], self.bf
        )
        ps1_actions2 = [a for a in trigger_actions2 if a.skill_id == 130054]
        self.assertTrue(len(ps1_actions2) > 0, "PS1应触发")

        hp_before_ps1_bonus = {}
        for e in self.bf.enemy_team:
            if e.is_alive:
                hp_before_ps1_bonus[e.unit_id] = e.current_hp

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions2, self.bf, trigger_timing="after_ally_as_attack"
        )

        # 计算PS1对低血量敌人造成的伤害（包括已死亡的单位）
        ps1_dmg_bonus = 0
        for e in self.bf.enemy_team:
            if e.unit_id in hp_before_ps1_bonus:
                ps1_dmg_bonus += hp_before_ps1_bonus[e.unit_id] - max(e.current_hp, 0)

        # 低血量时PS1伤害应更高（conditional_power_bonus增伤）
        self.assertGreater(ps1_dmg_bonus, ps1_dmg_normal,
                           f"目标HP≤30%时PS1伤害应更高: 低血量={ps1_dmg_bonus}, 满血={ps1_dmg_normal}")

    # ─── PS2: リストリクションエッジ ───

    def test_ps2_skill_130055_even_turn(self):
        """
        PS2(130055) 偶数回合触发 + 伤害 + 降攻debuff
        验证: 偶数回合结束时触发，对最高攻敌人造成伤害并施加dmg_dealt_down debuff
        """
        # 设置偶数回合
        self.bf.turn_number = 2

        trigger_actions = self.ts.trigger_turn_end(self.bf)

        ps2_actions = [a for a in trigger_actions if a.skill_id == 130055]
        self.assertTrue(len(ps2_actions) > 0, "偶数回合PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 验证最高攻敌人（enemy_front, attack=8000）受到伤害
        self.assertLess(self.enemy_front.current_hp, self.enemy_front.max_hp,
                        "PS2应对最高攻敌人造成伤害")

        # 验证dmg_dealt_down debuff
        dealt_down_debuffs = [d for d in self.enemy_front.debuffs
                              if d.effect_type == DEALT_DAMAGE]
        self.assertTrue(len(dealt_down_debuffs) > 0, "PS2应施加dmg_dealt_down debuff")
        self.assertEqual(dealt_down_debuffs[0].duration, 2, "dmg_dealt_down应持续2行动")
        self.assertTrue(dealt_down_debuffs[0].is_stackable, "dmg_dealt_down应可叠加")

    def test_ps2_skill_130055_odd_turn_skip(self):
        """
        PS2(130055) 奇数回合不触发
        验证: 奇数回合（turn_number % 2 != 0）时PS2不触发
        """
        # 设置奇数回合
        self.bf.turn_number = 1

        trigger_actions = self.ts.trigger_turn_end(self.bf)

        ps2_actions = [a for a in trigger_actions if a.skill_id == 130055]
        self.assertEqual(len(ps2_actions), 0, "奇数回合PS2不应触发")

        # 再测试奇数回合3
        self.bf.turn_number = 3
        trigger_actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130055]
        self.assertEqual(len(ps2_actions), 0, "奇数回合3时PS2也不应触发")

    # ─── EX: ふわとろのきもち (补充) ───

    def test_ex_dmg_taken_up_attack_limited_consumption(self):
        """
        EX(110003) dmg_taken_up的attack_limited=2消耗机制
        验证:
        1. 施放EX后，敌方获得dmg_taken_up debuff（attack_limited=2）
        2. 第1次攻击该敌方：attack_limited 2→1，debuff 仍存在
        3. 第2次攻击该敌方：attack_limited 1→0，debuff 被移除
        注: attack_limited是per-skill消耗（每次被攻击技能-1，不是per-hit）
        """
        # 仅保留单一敌方，确保AS1攻击它
        # 设置高HP确保敌方能承受EX+2次AS1攻击
        self.enemy_front.max_hp = 200000
        self.enemy_front.current_hp = 200000
        self.bf.enemy_team = [self.enemy_front]

        # 第1步：施放EX → enemy_front 获得 dmg_taken_up（attack_limited=2）
        result_ex = self.ss.execute_skill(
            caster=self.caster, skill_id=110003, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_ex["success"])

        dmg_taken_debuffs = [d for d in self.enemy_front.debuffs
                             if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_taken_debuffs), 1, "EX后应有1个dmg_taken_up debuff")
        self.assertEqual(dmg_taken_debuffs[0].attack_limited, 2,
                         "初始attack_limited应为2")

        # 第2步：施放AS1攻击enemy_front → attack_limited 2→1
        self.caster.skill_cooldowns = {}
        result_as1_1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120048, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as1_1["success"])

        dmg_taken_debuffs = [d for d in self.enemy_front.debuffs
                             if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_taken_debuffs), 1,
                         "第1次攻击后dmg_taken_up应仍存在（attack_limited=1>0）")
        self.assertEqual(dmg_taken_debuffs[0].attack_limited, 1,
                         "第1次攻击后attack_limited应减为1")

        # 第3步：再次施放AS1 → attack_limited 1→0，debuff被移除
        self.caster.skill_cooldowns = {}
        result_as1_2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120048, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_as1_2["success"])

        dmg_taken_debuffs = [d for d in self.enemy_front.debuffs
                             if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(dmg_taken_debuffs), 0,
                         "第2次攻击后dmg_taken_up应被移除（attack_limited=0）")

    def test_ex_dmg_taken_up_stackable(self):
        """
        EX(110003) dmg_taken_up的stackable叠加
        验证: 多次施放EX后，dmg_taken_up debuff应叠加（多个独立buff_id）
        注: stackable=true使_apply_aura生成唯一buff_id，独立存储
        """
        # 设置高HP确保敌方存活
        self.enemy_front.max_hp = 500000
        self.enemy_front.current_hp = 500000
        self.bf.enemy_team = [self.enemy_front]

        # 第1次施放EX
        self.ss.execute_skill(
            caster=self.caster, skill_id=110003, battlefield=self.bf, skip_cost=True
        )

        debuffs_after_1st = [d for d in self.enemy_front.debuffs
                             if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(debuffs_after_1st), 1, "第1次EX后应有1个dmg_taken_up")

        # 第2次施放EX
        self.caster.skill_cooldowns = {}
        self.ss.execute_skill(
            caster=self.caster, skill_id=110003, battlefield=self.bf, skip_cost=True
        )

        debuffs_after_2nd = [d for d in self.enemy_front.debuffs
                             if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(debuffs_after_2nd), 2,
                         "第2次EX后应有2个独立的dmg_taken_up（stackable叠加）")

        # 验证两个debuff有独立的buff_id
        self.assertNotEqual(debuffs_after_2nd[0].buff_id, debuffs_after_2nd[1].buff_id,
                            "两个dmg_taken_up应有不同的buff_id")

        # 验证两个debuff都是stackable
        for d in debuffs_after_2nd:
            self.assertTrue(d.is_stackable, "dmg_taken_up应为stackable")

        # 验证第1个debuff被消耗1次（attack_limited 2→1），第2个debuff未被消耗（attack_limited=2）
        # 因为第1个debuff不在第2次EX的_debuffs_applied_this_skill中
        attack_limited_values = sorted([d.attack_limited for d in debuffs_after_2nd])
        self.assertEqual(attack_limited_values, [1, 2],
                         f"第1个debuff应attack_limited=1（被消耗）, 第2个应attack_limited=2（刚施加）, "
                         f"实际: {attack_limited_values}")

    # ─── AS2: レストブレイカー (补充) ───

    def test_as2_hp_scaling_inverse_curve(self):
        """
        AS2(120049) hp_scaling_inverse数值曲线
        验证: 敌方HP越低，AS2伤害越高（线性反比关系）
        Lv10: range=100，hp_scaling_max=100
        - HP=100% → hp_ratio=0.0 → bonus=0%（无增伤）
        - HP=50% → hp_ratio=0.5 → bonus=50%
        - HP=10% → hp_ratio=0.9 → bonus=90%
        """
        # 设置单一敌方确保AS2攻击它
        self.bf.enemy_team = [self.enemy_front]
        self.enemy_front.max_hp = 100000  # 高HP确保即使低血量也有足够HP

        # 场景1: 敌方满血（HP=100%）
        self.enemy_front.current_hp = self.enemy_front.max_hp
        self.enemy_front.shield = 0
        self.caster.skill_cooldowns = {}
        result_full = self.ss.execute_skill(
            caster=self.caster, skill_id=120049, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_full["success"])
        dmg_full = [e for e in result_full["effects_applied"]
                    if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_full) > 0, "AS2应造成伤害")
        total_dmg_full = sum(e.get("total_damage", 0) for e in dmg_full)

        # 场景2: 敌方50%血
        self.enemy_front.current_hp = int(self.enemy_front.max_hp * 0.5)
        self.enemy_front.shield = 0
        self.caster.skill_cooldowns = {}
        result_half = self.ss.execute_skill(
            caster=self.caster, skill_id=120049, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_half["success"])
        dmg_half = [e for e in result_half["effects_applied"]
                    if e.get("effect_type") == "damage"]
        total_dmg_half = sum(e.get("total_damage", 0) for e in dmg_half)

        # 场景3: 敌方10%血
        self.enemy_front.current_hp = int(self.enemy_front.max_hp * 0.1)
        self.enemy_front.shield = 0
        self.caster.skill_cooldowns = {}
        result_low = self.ss.execute_skill(
            caster=self.caster, skill_id=120049, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_low["success"])
        dmg_low = [e for e in result_low["effects_applied"]
                   if e.get("effect_type") == "damage"]
        total_dmg_low = sum(e.get("total_damage", 0) for e in dmg_low)

        # 验证: 低血量伤害 > 中血量伤害 > 满血伤害（线性反比关系）
        self.assertGreater(total_dmg_half, total_dmg_full,
                           f"50%血伤害应高于满血: {total_dmg_half} vs {total_dmg_full}")
        self.assertGreater(total_dmg_low, total_dmg_half,
                           f"10%血伤害应高于50%血: {total_dmg_low} vs {total_dmg_half}")

    # ─── PS2: リストリクションエッジ (补充) ───

    def test_ps2_even_turn_stack(self):
        """
        PS2(130055) 偶数回合连续叠加
        验证: 连续两个偶数回合（2、4）触发后，应有2个独立的dmg_dealt_down debuff
        注: dmg_dealt_down是stackable=true，每次触发生成唯一buff_id
        """
        # 第1个偶数回合（turn=2）
        self.bf.turn_number = 2
        trigger_actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130055]
        self.assertTrue(len(ps2_actions) > 0, "第2回合PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        debuffs_after_turn2 = [d for d in self.enemy_front.debuffs
                               if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(debuffs_after_turn2), 1,
                         "第2回合后应有1个dmg_dealt_down")

        # 第2个偶数回合（turn=4）
        # 重置PS2的冷却（确保能再次触发）
        self.caster.skill_cooldowns = {}
        self.bf.turn_number = 4
        trigger_actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130055]
        self.assertTrue(len(ps2_actions) > 0, "第4回合PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        debuffs_after_turn4 = [d for d in self.enemy_front.debuffs
                               if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(debuffs_after_turn4), 2,
                         "第4回合后应有2个独立的dmg_dealt_down（stackable叠加）")

        # 验证两个debuff有独立的buff_id
        self.assertNotEqual(debuffs_after_turn4[0].buff_id, debuffs_after_turn4[1].buff_id,
                            "两个dmg_dealt_down应有不同的buff_id")

        # 验证两个debuff都是stackable
        for d in debuffs_after_turn4:
            self.assertTrue(d.is_stackable, "dmg_dealt_down应为stackable")

    def test_ps2_target_consistency(self):
        """
        PS2(130055) 索敌一致性
        验证: PS2的target_type=enemy_single_highest_atk，当最高ATK敌方变更时，
        PS2应选择新的最高ATK敌方
        """
        # 场景1: enemy_front(atk=8000)是最高ATK
        self.bf.turn_number = 2
        # 确保enemy_front是最高ATK
        self.enemy_front.attack = 8000
        self.enemy_back.attack = 6000

        trigger_actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130055]
        self.assertTrue(len(ps2_actions) > 0, "场景1: PS2应触发")

        hp_before_front = self.enemy_front.current_hp
        hp_before_back = self.enemy_back.current_hp
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 验证enemy_front（最高ATK）受到伤害，enemy_back不受伤害
        self.assertLess(self.enemy_front.current_hp, hp_before_front,
                        "场景1: PS2应攻击最高ATK敌方(enemy_front)")
        self.assertEqual(self.enemy_back.current_hp, hp_before_back,
                         "场景1: PS2不应攻击非最高ATK敌方(enemy_back)")

        # 场景2: 修改enemy_back的ATK为最高，PS2应改打enemy_back
        self.caster.skill_cooldowns = {}
        # 重置敌方HP和debuffs，避免场景1的状态影响场景2
        self.enemy_front.current_hp = self.enemy_front.max_hp
        self.enemy_front.debuffs = []
        self.enemy_back.current_hp = self.enemy_back.max_hp
        self.enemy_back.debuffs = []
        # 修改ATK使enemy_back成为最高ATK
        self.enemy_back.attack = 10000
        self.enemy_front.attack = 8000

        self.bf.turn_number = 4
        trigger_actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in trigger_actions if a.skill_id == 130055]
        self.assertTrue(len(ps2_actions) > 0, "场景2: PS2应触发")

        hp_before_front = self.enemy_front.current_hp
        hp_before_back = self.enemy_back.current_hp
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 验证enemy_back（新的最高ATK）受到伤害，enemy_front不受伤害
        self.assertLess(self.enemy_back.current_hp, hp_before_back,
                        "场景2: PS2应攻击新的最高ATK敌方(enemy_back)")
        self.assertEqual(self.enemy_front.current_hp, hp_before_front,
                         "场景2: PS2不应攻击非最高ATK敌方(enemy_front)")

    # ─── AS1: ペンタブレイド (补充) ───

    def test_as1_5hit_damage_distribution(self):
        """
        AS1(120048) 5hit伤害分配
        验证:
        1. AS1的damage effect的targets[0]["hits"]字段有5个元素
        2. 5个hit的伤害值都是正数（无闪避）
        3. 5个hit的总和等于total_damage
        注: AS1的hit_count=5，damage_service按hit_count循环计算每hit伤害
        """
        # 设置单一敌方，高HP确保5hit后不穿越30%阈值（无追加攻击）
        self.bf.enemy_team = [self.enemy_front]
        self.enemy_front.max_hp = 100000
        self.enemy_front.current_hp = 100000

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120048, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = [e for e in result["effects_applied"]
                       if e.get("effect_type") == "damage"]
        self.assertTrue(len(dmg_effects) > 0, "AS1应造成伤害")

        # 高HP敌方应只有1个主5hit伤害effect（无追加攻击，因HP未穿越30%阈值）
        self.assertEqual(len(dmg_effects), 1,
                         f"高HP敌方应只有1个主5hit伤害effect（无追加攻击）, 实际: {len(dmg_effects)}")

        main_dmg_effect = dmg_effects[0]
        targets = main_dmg_effect.get("targets", [])
        self.assertEqual(len(targets), 1, "应攻击单一目标")

        target0 = targets[0]
        hits = target0.get("hits", [])
        self.assertEqual(len(hits), 5,
                         f"AS1应为5hit, 实际: {len(hits)}")

        # 验证每个hit的伤害值都是正数
        for i, hit_dmg in enumerate(hits):
            self.assertGreater(hit_dmg, 0,
                               f"第{i+1}hit伤害应大于0, 实际: {hit_dmg}")

        # 验证5hit总和等于total_damage
        total_from_hits = sum(hits)
        total_damage = main_dmg_effect.get("total_damage", 0)
        self.assertEqual(total_from_hits, total_damage,
                         f"5hit伤害总和应等于total_damage: {total_from_hits} vs {total_damage}")


if __name__ == "__main__":
    unittest.main()
