"""Regression: それはやりすぎ！+ must trigger before ぜ～～ったい負けないから！

Bug: on_cumulative_damage (それはやりすぎ！+) and skill_use_count
     (ぜ～～ったい負けないから！) were collected into the same phase1_actions
     list and sorted by speed. When the skill_use_count owner was faster,
     ぜ～～ったい負けないから！ executed before それはやりすぎ！+, contradicting
     game behavior.

Fix: Split Phase 1 into Phase 1a (被攻撃反応+自身行動後発動+傷害関連, includes
     on_critical + on_cumulative_damage) and Phase 1b (技能使用次数, includes
     skill_use_count). Phase 1a executes completely before Phase 1b, ensuring
     on_cumulative_damage always triggers before skill_use_count regardless
     of speed.

Game behavior:
  それはやりすぎ！+ (on_cumulative_damage) → ぜ～～ったい負けないから！ (skill_use_count)

Constraint: skill_use_count must remain in Phase 1 (not Phase 2) to preserve
  the previous fix where it must be evaluated before buff removal at action end,
  and must be skipped during genwaku/confusion via check_triggers.
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'src'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.battle_flow_controller import BattleFlowController

# Skill IDs
ZETTAI_MAKENAI = 130081      # ぜ～～ったい負けないから！ (on_skill_use_count, mod 3)
SOREHAYARI_SUGI = 230400     # それはやりすぎ！+ (on_cumulative_damage, 75%)
AS_SKILL = 120068            # ゴーストハザード (AS, 敵3体に2ヒットEN攻撃)


def _make_unit(unit_id, name, side, position, *, hp=1000000, atk=10000,
               defense=5000, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ap=10, crit_rate=0.0):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=15, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


class TestRegCumulativeVsSkillCountOrder(unittest.TestCase):
    """on_cumulative_damage must execute before skill_use_count (Phase 1a → 1b)."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def test_cumulative_damage_before_skill_use_count(self):
        """それはやりすぎ！+ (on_cumulative_damage, slow enemy) must trigger
        BEFORE ぜ～～ったい負けないから！ (skill_use_count, fast ally) even when
        the skill_use_count owner has higher speed.

        Setup:
        - Unit A (ally, speed=900): holds ぜ～～ったい負けないから！ + AS skill
          Pre-set skill_use_count[AS_SKILL]=2 so next AS use makes it 3 (mod 3 == 0)
        - Unit B (enemy, speed=500): holds それはやりすぎ！+
          Pre-set cumulative_hp_damage near 75% threshold

        Flow:
        1. Unit A uses AS skill → deals damage to Unit B
        2. Phase 1a: on_cumulative_damage collects それはやりすぎ！+ (speed=500)
        3. Phase 1a executes それはやりすぎ！+
        4. Phase 1b: skill_use_count collects ぜ～～ったい負けないから！ (speed=900)
        5. Phase 1b executes ぜ～～ったい負けないから！

        Expected: それはやりすぎ！+ (230400) before ぜ～～ったい負けないから！ (130081)
        """
        bf = BattlefieldState()

        # Unit A: fast ally with ぜ～～ったい負けないから！ (speed=900)
        unit_a = _make_unit(
            "ally_a", "UnitA(ぜ～～ったい)", Side.ALLY,
            Position.ALLY_CENTER_FRONT,
            hp=1000000, atk=50000, speed=900, pp=10, ap=10,
            skills=[AS_SKILL, ZETTAI_MAKENAI],
            skill_levels={AS_SKILL: 15, ZETTAI_MAKENAI: 15},
        )
        # Pre-set skill_use_count so next AS use triggers mod 3 == 0
        unit_a.skill_use_count = {AS_SKILL: 2}

        # Unit B: slow enemy with それはやりすぎ！+ (speed=500)
        unit_b = _make_unit(
            "enemy_b", "UnitB(それはやりすぎ)", Side.ENEMY,
            Position.ENEMY_CENTER_FRONT,
            hp=1000000, atk=1000, speed=500, pp=10, ap=10,
            skills=[SOREHAYARI_SUGI],
            skill_levels={SOREHAYARI_SUGI: 15},
        )
        # Pre-set cumulative_hp_damage near 75% threshold (750000)
        unit_b.cumulative_hp_damage = 749999

        bf.friend_team = [unit_a]
        bf.enemy_team = [unit_b]

        controller = BattleFlowController(bf, data_loader=self.dl)
        controller._build_display_names()
        controller.skill_service.set_battlefield(bf)
        controller._deferred_crit_triggers = []

        # Record PS execution order by wrapping skill_service.execute_skill
        execution_order = []
        original_execute = controller.skill_service.execute_skill

        def recording_execute(*args, **kwargs):
            result = original_execute(*args, **kwargs)
            skill_id = kwargs.get('skill_id')
            caster = kwargs.get('caster')
            if skill_id and caster:
                execution_order.append((skill_id, caster.name))
            return result

        controller.skill_service.execute_skill = recording_execute

        # Execute Unit A's action (AS skill)
        controller._execute_unit_action(unit_a, turn=1)

        # Filter out the AS skill, keep only PS skills
        ps_order = [(sid, name) for sid, name in execution_order
                    if sid != AS_SKILL]

        actual_ids = [sid for sid, _ in ps_order]

        # Both PS skills should have triggered
        self.assertIn(SOREHAYARI_SUGI, actual_ids,
                      f"それはやりすぎ！+ should have triggered. Actual: {actual_ids}")
        self.assertIn(ZETTAI_MAKENAI, actual_ids,
                      f"ぜ～～ったい負けないから！ should have triggered. Actual: {actual_ids}")

        # それはやりすぎ！+ must trigger BEFORE ぜ～～ったい負けないから！
        # even though Unit A (speed=900) > Unit B (speed=500)
        pos_sorehayari = actual_ids.index(SOREHAYARI_SUGI)
        pos_zettai = actual_ids.index(ZETTAI_MAKENAI)
        self.assertLess(pos_sorehayari, pos_zettai,
                        "それはやりすぎ！+ (on_cumulative_damage, Phase1a) must trigger "
                        "BEFORE ぜ～～ったい負けないから！ (skill_use_count, Phase1b) "
                        f"regardless of speed. Actual order: {actual_ids}")

    def test_phase1a_and_phase1b_separate_execution(self):
        """Verify that Phase 1a (on_cumulative_damage) and Phase 1b (skill_use_count)
        are collected and executed as separate sub-phases, not merged into one
        speed-sorted list.

        This test uses units where the skill_use_count owner is SLOWER than
        the on_cumulative_damage owner. Even in this case, the order should be
        on_cumulative_damage first (Phase 1a), then skill_use_count (Phase 1b).
        If they were merged and sorted by speed, the order would be the same
        (on_cumulative_damage owner is faster). So this test verifies the
        separation doesn't break the natural speed order case.
        """
        bf = BattlefieldState()

        # Unit A: slow ally with ぜ～～ったい負けないから！ (speed=300)
        unit_a = _make_unit(
            "ally_a", "UnitA(ぜ～～ったい)", Side.ALLY,
            Position.ALLY_CENTER_FRONT,
            hp=1000000, atk=50000, speed=300, pp=10, ap=10,
            skills=[AS_SKILL, ZETTAI_MAKENAI],
            skill_levels={AS_SKILL: 15, ZETTAI_MAKENAI: 15},
        )
        unit_a.skill_use_count = {AS_SKILL: 2}

        # Unit B: fast enemy with それはやりすぎ！+ (speed=900)
        unit_b = _make_unit(
            "enemy_b", "UnitB(それはやりすぎ)", Side.ENEMY,
            Position.ENEMY_CENTER_FRONT,
            hp=1000000, atk=1000, speed=900, pp=10, ap=10,
            skills=[SOREHAYARI_SUGI],
            skill_levels={SOREHAYARI_SUGI: 15},
        )
        unit_b.cumulative_hp_damage = 749999

        bf.friend_team = [unit_a]
        bf.enemy_team = [unit_b]

        controller = BattleFlowController(bf, data_loader=self.dl)
        controller._build_display_names()
        controller.skill_service.set_battlefield(bf)
        controller._deferred_crit_triggers = []

        execution_order = []
        original_execute = controller.skill_service.execute_skill

        def recording_execute(*args, **kwargs):
            result = original_execute(*args, **kwargs)
            skill_id = kwargs.get('skill_id')
            caster = kwargs.get('caster')
            if skill_id and caster:
                execution_order.append((skill_id, caster.name))
            return result

        controller.skill_service.execute_skill = recording_execute

        controller._execute_unit_action(unit_a, turn=1)

        ps_order = [(sid, name) for sid, name in execution_order
                    if sid != AS_SKILL]
        actual_ids = [sid for sid, _ in ps_order]

        self.assertIn(SOREHAYARI_SUGI, actual_ids)
        self.assertIn(ZETTAI_MAKENAI, actual_ids)

        # Even when skill_use_count owner is slower, on_cumulative_damage
        # (Phase 1a) must still trigger before skill_use_count (Phase 1b)
        pos_sorehayari = actual_ids.index(SOREHAYARI_SUGI)
        pos_zettai = actual_ids.index(ZETTAI_MAKENAI)
        self.assertLess(pos_sorehayari, pos_zettai,
                        "それはやりすぎ！+ must trigger before ぜ～～ったい負けないから！ "
                        f"regardless of speed. Actual: {actual_ids}")


if __name__ == '__main__':
    unittest.main()
