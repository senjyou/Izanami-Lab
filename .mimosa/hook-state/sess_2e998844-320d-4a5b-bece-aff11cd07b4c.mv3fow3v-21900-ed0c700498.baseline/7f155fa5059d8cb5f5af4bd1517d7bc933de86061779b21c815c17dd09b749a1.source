"""Regression: 一日一不憫 (110002) 追加第6hitの skill_id=0 異常と
damage settlement 未収計問題。

Bug: _apply_on_crit_blocks で構築した dmg_skill_obj に skill_id/name フィールド
が欠落しており、damage_service の _crit_context で skill_id=0 と表示される。
また、on_crit 追加ダメージの処理で以下4種の累計が未呼び出し：
  - caster.damage_dealt_total
  - target.damage_taken_total
  - self._most_recent_damage (lifesteal 基礎値)
  - tracker.record_damage (scoring)

Fix:
  1. dmg_skill_obj に skill_id / name / base_value_source を追加
  2. ダメージ结算後に主フロー (_apply_damage) と同様の4種累計を追加

Test approach:
  - 100% crit で 110002 を実行 → 5hit + 追撃6hit 発生
  - skill_id: damage_service.calculate_damage を spy して
    on_crit 呼び出し時の skill_data.skill_id が 110002 であることを検証
  - 累計: caster.damage_dealt_total / target.damage_taken_total /
    ss._most_recent_damage が 主5hit + 追撃1hit の合計と一致することを検証
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.resource_service import ResourceService


def _make_caster():
    return UnitState(
        unit_id="ally_back", name="caster", side=Side.ALLY,
        position=Position.ALLY_CENTER_BACK, character_id=106301, level=10,
        element=1, character_type=2,
        max_hp=15000, current_hp=15000,
        attack=10000, defense=4000, speed=400,
        crit_rate=1.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=2, initial_passive_point=2, max_extra_point=8,
        current_ap=10, current_pp=10, current_ep=0,
        skills=[110002], skill_levels={110002: 10}, skill_cooldowns={},
    )


def _make_enemy():
    return UnitState(
        unit_id="enemy_front", name="enemy", side=Side.ENEMY,
        position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
        element=1, character_type=1,
        max_hp=999999, current_hp=999999,
        attack=1000, defense=3000, speed=400,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=5,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


class TestRegOnCritSkillIdAndDamage(unittest.TestCase):
    """on_crit 追加ダメージの skill_id=0 と damage settlement 未収計 bug 修正回帰テスト"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.caster = _make_caster()
        self.enemy = _make_enemy()
        self.bf.friend_team = [self.caster]
        self.bf.enemy_team = [self.enemy]

        rs = ResourceService()
        trg = TriggerService()
        tgs = TargetService()
        dms = DamageService()
        aus = AuraService()
        sts = StatusService()
        self.ss = SkillService(
            self.dl, rs, target_service=tgs, damage_service=dms,
            aura_service=aus, status_service=sts, trigger_service=trg,
        )
        trg.set_data_loader(self.dl)
        trg.set_skill_service(self.ss)
        trg.set_damage_service(dms)
        self.ss.set_battlefield(self.bf)

    def _get_damage_effects(self, result):
        return [e for e in result.get("effects_applied", [])
                if e.get("effect_type") == "damage"]

    def test_on_crit_dmg_skill_obj_has_correct_skill_id(self):
        """on_crit 第6hit の dmg_skill_obj.skill_id は 110002 であること（0 ではない）"""
        captured_skill_ids = []
        original_calc = self.ss.damage_service.calculate_damage

        def spy_calc(attacker, defender, skill_data, *args, **kwargs):
            sid = getattr(skill_data, 'skill_id', None)
            captured_skill_ids.append(sid)
            return original_calc(attacker, defender, skill_data, *args, **kwargs)

        self.ss.damage_service.calculate_damage = spy_calc
        try:
            result = self.ss.execute_skill(
                caster=self.caster, skill_id=110002,
                battlefield=self.bf, skip_cost=True
            )
        finally:
            self.ss.damage_service.calculate_damage = original_calc

        self.assertTrue(result["success"])
        dmg_effects = self._get_damage_effects(result)
        self.assertEqual(len(dmg_effects), 2,
                         "暴击時は主5hit + 追撃1hit = 2つのdamage effect")

        # 全ての calculate_damage 呼び出しで skill_id が 110002 であること
        for i, sid in enumerate(captured_skill_ids):
            self.assertEqual(
                sid, 110002,
                f"calculate_damage 呼び出し#{i} の skill_id が {sid} (期待値=110002)。"
                f"on_crit 第6hit で skill_id=0 になる bug が残存している可能性。"
            )

    def test_damage_dealt_total_includes_on_crit_hit(self):
        """caster.damage_dealt_total が主5hit + 追撃1hit の合計を含むこと"""
        dealt_before = self.caster.damage_dealt_total
        hp_before = self.enemy.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110002,
            battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = self._get_damage_effects(result)
        self.assertEqual(len(dmg_effects), 2,
                         "暴击時は主5hit + 追撃1hit = 2つのdamage effect")

        main_dmg = sum(t["actual_damage"] for t in dmg_effects[0].get("targets", []))
        pursuit_dmg = sum(t["actual_damage"] for t in dmg_effects[1].get("targets", []))
        expected_total = main_dmg + pursuit_dmg

        dealt_after = self.caster.damage_dealt_total
        actual_increment = dealt_after - dealt_before

        self.assertEqual(
            actual_increment, expected_total,
            f"caster.damage_dealt_total の増分({actual_increment})が"
            f" 主+追撃の合計({expected_total}=主{main_dmg}+追撃{pursuit_dmg})と不一致。"
            f" on_crit 追加ダメージが統計に計上されていない可能性。"
        )

    def test_damage_taken_total_includes_on_crit_hit(self):
        """target.damage_taken_total が主5hit + 追撃1hit の合計を含むこと"""
        taken_before = self.enemy.damage_taken_total

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110002,
            battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = self._get_damage_effects(result)
        self.assertEqual(len(dmg_effects), 2)

        main_dmg = sum(t["actual_damage"] for t in dmg_effects[0].get("targets", []))
        pursuit_dmg = sum(t["actual_damage"] for t in dmg_effects[1].get("targets", []))
        expected_total = main_dmg + pursuit_dmg

        taken_after = self.enemy.damage_taken_total
        actual_increment = taken_after - taken_before

        self.assertEqual(
            actual_increment, expected_total,
            f"target.damage_taken_total の増分({actual_increment})が"
            f" 主+追撃の合計({expected_total})と不一致。"
        )

    def test_most_recent_damage_includes_on_crit_hit(self):
        """ss._most_recent_damage が主5hit + 追撃1hit の合計を含むこと
        （lifesteal 基礎値として正しく設定されるかの検証）"""
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110002,
            battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = self._get_damage_effects(result)
        self.assertEqual(len(dmg_effects), 2)

        main_dmg = sum(t["actual_damage"] for t in dmg_effects[0].get("targets", []))
        pursuit_dmg = sum(t["actual_damage"] for t in dmg_effects[1].get("targets", []))
        expected_total = main_dmg + pursuit_dmg

        actual_recent = getattr(self.ss, '_most_recent_damage', 0)
        self.assertEqual(
            actual_recent, expected_total,
            f"_most_recent_damage({actual_recent})が"
            f" 主+追撃の合計({expected_total}=主{main_dmg}+追撃{pursuit_dmg})と不一致。"
            f" on_crit 追加ダメージが lifesteal 基礎値に未収計の可能性。"
        )

    def test_scoring_tracker_records_on_crit_hit(self):
        """scoring_tracker に追撃1hit ダメージが記録されること"""
        from src.combat_v2.scoring_tracker import ScoringTracker
        tracker = ScoringTracker()
        self.bf.scoring_tracker = tracker

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110002,
            battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_effects = self._get_damage_effects(result)
        self.assertEqual(len(dmg_effects), 2)

        pursuit_dmg = sum(t["actual_damage"] for t in dmg_effects[1].get("targets", []))
        self.assertGreater(pursuit_dmg, 0, "追撃1hit ダメージが存在すること")

        # tracker から caster のダメージ統計を取得
        caster_stats = tracker._unit_stats.get(self.caster.unit_id)
        self.assertIsNotNone(caster_stats, "tracker に caster の統計が記録されていること")

        # 主5hit + 追撃1hit の合計が tracker に記録されていること
        main_dmg = sum(t["actual_damage"] for t in dmg_effects[0].get("targets", []))
        expected_total = main_dmg + pursuit_dmg
        actual_total = caster_stats.damage_dealt

        self.assertEqual(
            actual_total, expected_total,
            f"tracker の damage_dealt({actual_total})が"
            f" 主+追撃の合計({expected_total})と不一致。"
            f" on_crit 追加ダメージが scoring に未収計の可能性。"
        )


if __name__ == '__main__':
    unittest.main(verbosity=2)
