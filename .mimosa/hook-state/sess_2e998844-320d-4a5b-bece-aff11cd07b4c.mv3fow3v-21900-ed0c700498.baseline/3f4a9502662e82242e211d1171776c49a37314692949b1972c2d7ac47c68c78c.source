"""Regression: 連れ添い歩む傍らの友 (129302) 全技能実装.

5 skills:
  EX  110045 メイドの本能         - perfect_evasion + atk_up + poison(value_tag) on lowest_hp ally
  AS1 120100 キックアウト         - EN damage + Lv11: lifesteal(lowest_hp ally) + heal(max_hp*10%)
  AS2 120101 エイド・フロム       - heal(lowest_hp ally, ATK*威力%)
  AS3 120102 マーシーズ・エンブレイス - heal(split_among_targets) + Lv11: heal_efficacy_up/down
  PS  130110 ルミナス・ガード     - after_own_action: HOT(ally_adjacent) + Lv11: action_damage(enemy_front_row)

New mechanisms:
  1. poison value_tag support (skill_service.py _apply_add_status)
  2. lifesteal target_type extension (skill_service.py _apply_lifesteal)
  3. heal split_among_targets support (skill_service.py _apply_heal)
  4. enemy_front_row target_type (target_service.py + skill_service.py)
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import BuffState
from src.entities_v2.enums import Position, SkillEffectType, Side
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig


# Skill IDs
EX_MAID_INSTINCT = 110045
AS_KICK_OUT = 120100
AS_AID_FROM = 120101
AS_MERCY = 120102
PS_LUMINOUS = 130110


class TestReg129302Tsuresoi(unittest.TestCase):
    """連れ添い歩む傍らの友 (129302) 技能実装."""

    @classmethod
    def setUpClass(cls):
        bb = BattleBuilder()
        # Caster: 連れ添い歩む傍らの友 (back row center)
        bb.add_ally(unit_id="caster", position=Position.ALLY_CENTER_BACK,
                    hp=50000, atk=10000, speed=500,
                    skills=[EX_MAID_INSTINCT, AS_KICK_OUT, AS_AID_FROM, AS_MERCY, PS_LUMINOUS],
                    level=15, pp=10, ep=10)
        # Allies: varying HP for lowest_hp_priority tests
        bb.add_ally(unit_id="ally_front_l", position=Position.ALLY_LEFT_FRONT,
                    hp=40000, atk=5000, speed=400, skills=[], level=15)
        bb.add_ally(unit_id="ally_front_c", position=Position.ALLY_CENTER_FRONT,
                    hp=30000, atk=5000, speed=400, skills=[], level=15)
        bb.add_ally(unit_id="ally_front_r", position=Position.ALLY_RIGHT_FRONT,
                    hp=20000, atk=5000, speed=400, skills=[], level=15)
        # Enemies: front + back row
        bb.add_enemy(unit_id="enemy_front_l", position=Position.ENEMY_LEFT_FRONT,
                     hp=999999, atk=1000, defense=0, speed=400, skills=[], level=15)
        bb.add_enemy(unit_id="enemy_front_c", position=Position.ENEMY_CENTER_FRONT,
                     hp=999999, atk=1000, defense=0, speed=400, skills=[], level=15)
        bb.add_enemy(unit_id="enemy_front_r", position=Position.ENEMY_RIGHT_FRONT,
                     hp=999999, atk=1000, defense=0, speed=400, skills=[], level=15)
        bb.add_enemy(unit_id="enemy_back_c", position=Position.ENEMY_CENTER_BACK,
                     hp=999999, atk=1000, defense=0, speed=400, skills=[], level=15)
        ctx = bb.build()
        cls.bf = ctx['bf']
        cls.ss = ctx['ss']
        cls.dl = ctx['services']['dl']
        cls.caster = next(u for u in cls.bf.friend_team if u.unit_id == "caster")
        cls.ally_fl = next(u for u in cls.bf.friend_team if u.unit_id == "ally_front_l")
        cls.ally_fc = next(u for u in cls.bf.friend_team if u.unit_id == "ally_front_c")
        cls.ally_fr = next(u for u in cls.bf.friend_team if u.unit_id == "ally_front_r")
        cls.enemy_fl = next(u for u in cls.bf.enemy_team if u.unit_id == "enemy_front_l")
        cls.enemy_fc = next(u for u in cls.bf.enemy_team if u.unit_id == "enemy_front_c")
        cls.enemy_fr = next(u for u in cls.bf.enemy_team if u.unit_id == "enemy_front_r")
        cls.enemy_bc = next(u for u in cls.bf.enemy_team if u.unit_id == "enemy_back_c")

    def _get_skill_config(self, skill_id):
        return self.dl.get_parsed_skill_data(skill_id)

    def _reset_allies(self):
        """Reset ally HP and clear buffs/debuffs for lowest_hp tests."""
        for u in (self.caster, self.ally_fl, self.ally_fc, self.ally_fr):
            u.current_hp = u.max_hp
            u.buffs = []
            u.debuffs = []

    def _reset_enemies(self):
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.debuffs = []
            e.buffs = []

    # ── Config checks ────────────────────────────────────────

    def test_config_110045_exists(self):
        cfg = self._get_skill_config(EX_MAID_INSTINCT)
        self.assertIsNotNone(cfg, "110045 config must exist")
        effects = cfg['effect_blocks'][0]['effects']
        types = [e['effect_type'] for e in effects]
        self.assertIn("perfect_evasion", types)
        self.assertIn("atk_up", types)
        self.assertIn("add_status", types)

    def test_config_110045_poison_uses_value_tag(self):
        """EX 110045 poison effect must use value_tag='poison' (not fixed flag)."""
        cfg = self._get_skill_config(EX_MAID_INSTINCT)
        poison_eff = next(e for e in cfg['effect_blocks'][0]['effects']
                          if e['effect_type'] == "add_status")
        self.assertEqual(poison_eff['value_tag'], "poison")
        flags = poison_eff.get('flags', {}) or {}
        self.assertEqual(flags.get('status_type'), "poison")

    def test_config_120100_lifesteal_has_target_type(self):
        """AS1 120100 lifesteal must have target_type='ally_single' + lowest_hp_priority."""
        cfg = self._get_skill_config(AS_KICK_OUT)
        # Block 2 (Lv11+) has lifesteal
        block2 = cfg['effect_blocks'][1]
        ls_eff = next(e for e in block2['effects'] if e['effect_type'] == "lifesteal")
        self.assertEqual(ls_eff['target_type'], "ally_single")
        flags = ls_eff.get('flags', {}) or {}
        self.assertTrue(flags.get('lowest_hp_priority'),
                        "lifesteal must have lowest_hp_priority=true")

    def test_config_120102_heal_has_split_among_targets(self):
        """AS3 120102 heal must have split_among_targets=true."""
        cfg = self._get_skill_config(AS_MERCY)
        heal_eff = cfg['effect_blocks'][0]['effects'][0]
        self.assertEqual(heal_eff['effect_type'], "heal")
        flags = heal_eff.get('flags', {}) or {}
        self.assertTrue(flags.get("split_among_targets"),
                        "heal must have split_among_targets=true")

    def test_config_130110_uses_enemy_front_row(self):
        """PS 130110 Lv11+ action_damage must target enemy_front_row."""
        cfg = self._get_skill_config(PS_LUMINOUS)
        block2 = cfg['effect_blocks'][1]
        dmg_eff = block2['effects'][0]
        self.assertEqual(dmg_eff['target_type'], "enemy_front_row")
        flags = dmg_eff.get('flags', {}) or {}
        self.assertEqual(flags.get('status_type'), "action_damage")

    def test_config_130110_trigger_after_own_action(self):
        """PS 130110 trigger_type must be after_own_action."""
        cfg = self._get_skill_config(PS_LUMINOUS)
        self.assertEqual(cfg['trigger_type'], "after_own_action")

    # ── EX 110045 functional tests ───────────────────────────

    def test_ex_110045_targets_lowest_hp_ally(self):
        """EX 110045: perfect_evasion/atk_up/poison applied to lowest HP ally."""
        self._reset_allies()
        # ally_fr has lowest max_hp (20000) -> lowest HP ratio at full HP
        # ally_fc has 30000, ally_fl has 40000, caster has 50000
        # At full HP: ally_fr has lowest ratio only if all are at full
        # Make ally_fr clearly lowest HP ratio
        self.ally_fr.current_hp = 5000  # 25% HP
        self.ally_fc.current_hp = self.ally_fc.max_hp  # 100%
        self.ally_fl.current_hp = self.ally_fl.max_hp  # 100%
        self.caster.current_hp = self.caster.max_hp  # 100%

        result = self.ss.execute_skill(self.caster, EX_MAID_INSTINCT, self.bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        # ally_fr should have perfect_evasion, atk_up, poison
        evade_buffs = [b for b in self.ally_fr.buffs if b.effect_type == SkillEffectType.EVADE.value]
        self.assertEqual(len(evade_buffs), 1, "lowest HP ally must have perfect_evasion")
        self.assertGreater(evade_buffs[0].hit_limited, 0, "evade hit_limited must be > 0")

        atk_buffs = [b for b in self.ally_fr.buffs if b.effect_type == SkillEffectType.STATUS_ATTACK.value]
        self.assertEqual(len(atk_buffs), 1, "lowest HP ally must have atk_up")

        poison_debuffs = [b for b in self.ally_fr.debuffs if b.effect_type == SkillEffectType.POISON.value]
        self.assertEqual(len(poison_debuffs), 1, "lowest HP ally must have poison")

        # Other allies should NOT have these buffs
        self.assertEqual(len([b for b in self.ally_fc.buffs if b.effect_type == SkillEffectType.EVADE.value]), 0)

    def test_ex_110045_poison_value_tag_lv15(self):
        """EX 110045 Lv15: poison value = 20.0 (from value_tag)."""
        self._reset_allies()
        self.ally_fr.current_hp = 5000  # lowest

        result = self.ss.execute_skill(self.caster, EX_MAID_INSTINCT, self.bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        poison_debuffs = [b for b in self.ally_fr.debuffs if b.effect_type == SkillEffectType.POISON.value]
        self.assertEqual(len(poison_debuffs), 1)
        # Lv15 poison = 20.0% -> value = 0.20
        self.assertAlmostEqual(poison_debuffs[0].value, 0.20, places=2,
                               msg="Lv15 poison value should be 0.20 (20%)")

    def test_ex_110045_poison_value_tag_lv10(self):
        """EX 110045 Lv10: poison value = 30.0 (from value_tag)."""
        # Create a separate battle with Lv10
        bb = BattleBuilder()
        bb.add_ally(unit_id="caster10", position=Position.ALLY_CENTER_BACK,
                    hp=50000, atk=10000, speed=500,
                    skills=[EX_MAID_INSTINCT], level=10, pp=10, ep=10)
        bb.add_ally(unit_id="ally10", position=Position.ALLY_LEFT_FRONT,
                    hp=20000, atk=5000, speed=400, skills=[], level=10)
        bb.add_enemy(unit_id="enemy10", position=Position.ENEMY_CENTER_FRONT,
                     hp=999999, atk=1000, defense=0, speed=400, skills=[], level=10)
        ctx = bb.build()
        bf = ctx['bf']
        ss = ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster10")
        ally = next(u for u in bf.friend_team if u.unit_id == "ally10")
        ally.current_hp = 5000  # lowest

        result = ss.execute_skill(caster, EX_MAID_INSTINCT, bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        poison_debuffs = [b for b in ally.debuffs if b.effect_type == SkillEffectType.POISON.value]
        self.assertEqual(len(poison_debuffs), 1)
        # Lv10 poison = 30.0% -> value = 0.30
        self.assertAlmostEqual(poison_debuffs[0].value, 0.30, places=2,
                               msg="Lv10 poison value should be 0.30 (30%)")

    # ── AS1 120100 functional tests ──────────────────────────

    def test_as1_120100_lifesteal_heals_lowest_hp_ally(self):
        """AS1 120100 Lv15: lifesteal heals HP% lowest ally (not caster)."""
        self._reset_allies()
        self._reset_enemies()
        # Make caster NOT the lowest HP
        self.caster.current_hp = self.caster.max_hp  # 100%
        self.ally_fr.current_hp = 5000  # 25% - lowest
        self.ally_fc.current_hp = self.ally_fc.max_hp  # 100%
        self.ally_fl.current_hp = self.ally_fl.max_hp  # 100%

        caster_hp_before = self.caster.current_hp
        ally_fr_hp_before = self.ally_fr.current_hp

        result = self.ss.execute_skill(self.caster, AS_KICK_OUT, self.bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        # Caster should NOT be healed by lifesteal
        self.assertEqual(self.caster.current_hp, caster_hp_before,
                         "caster should NOT be healed (target is lowest HP ally)")

        # ally_fr (lowest HP) should be healed
        self.assertGreater(self.ally_fr.current_hp, ally_fr_hp_before,
                           "lowest HP ally must be healed by lifesteal")

    def test_as1_120100_heal_max_hp_10pct(self):
        """AS1 120100 Lv15: heal max_hp×10% on lowest HP ally."""
        self._reset_allies()
        self._reset_enemies()
        self.caster.current_hp = self.caster.max_hp
        self.ally_fr.current_hp = 5000  # lowest
        self.ally_fc.current_hp = self.ally_fc.max_hp
        self.ally_fl.current_hp = self.ally_fl.max_hp

        ally_fr_hp_before = self.ally_fr.current_hp

        result = self.ss.execute_skill(self.caster, AS_KICK_OUT, self.bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        # ally_fr should receive both lifesteal heal + max_hp×10% heal
        # max_hp×10% = 20000×10% = 2000
        total_heal = self.ally_fr.current_hp - ally_fr_hp_before
        self.assertGreater(total_heal, 2000,
                           "ally_fr must receive at least max_hp*10%=2000 heal (+ lifesteal)")

    # ── AS2 120101 functional tests ──────────────────────────

    def test_as2_120101_heals_lowest_hp_ally(self):
        """AS2 120101: heal targets lowest HP ally."""
        self._reset_allies()
        self.caster.current_hp = self.caster.max_hp
        self.ally_fr.current_hp = 5000  # lowest
        self.ally_fc.current_hp = self.ally_fc.max_hp
        self.ally_fl.current_hp = self.ally_fl.max_hp

        ally_fr_hp_before = self.ally_fr.current_hp

        result = self.ss.execute_skill(self.caster, AS_AID_FROM, self.bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        # ally_fr should be healed
        self.assertGreater(self.ally_fr.current_hp, ally_fr_hp_before,
                           "lowest HP ally must be healed by AS2")

        # Other allies should NOT be healed
        self.assertEqual(self.ally_fc.current_hp, self.ally_fc.max_hp)
        self.assertEqual(self.ally_fl.current_hp, self.ally_fl.max_hp)

    # ── AS3 120102 functional tests ───────────────────────────

    def test_as3_120102_split_among_targets(self):
        """AS3 120102: total heal (ATK×威力%) split equally among allies."""
        self._reset_allies()
        self._reset_enemies()
        # Set all allies to same HP deficit for clean measurement
        deficit = 10000
        for ally in [self.caster, self.ally_fl, self.ally_fc, self.ally_fr]:
            ally.current_hp = ally.max_hp - deficit

        hp_before = {u.unit_id: u.current_hp for u in [self.caster, self.ally_fl, self.ally_fc, self.ally_fr]}

        result = self.ss.execute_skill(self.caster, AS_MERCY, self.bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        # Each ally should receive approximately the same heal amount
        heals = {u.unit_id: u.current_hp - hp_before[u.unit_id]
                 for u in [self.caster, self.ally_fl, self.ally_fc, self.ally_fr]}

        # All heals should be positive
        for uid, heal in heals.items():
            self.assertGreater(heal, 0, f"{uid} must receive heal > 0")

        # All heals should be approximately equal (split_among_targets)
        heal_values = list(heals.values())
        max_heal = max(heal_values)
        min_heal = min(heal_values)
        # Allow small difference due to integer division
        self.assertLessEqual(max_heal - min_heal, 1,
                             f"heals should be approximately equal (split_among_targets), got {heals}")

        # Total heal = ATK × 威力% / 100. At Lv15, 威力 is interpolated (~65-70)
        # per_target = total / 4 allies
        # Just verify it's reasonable: ATK=10000, 威力~65% -> total=6500, per_target~1625
        # (not strict since exact 威力 depends on interpolation)

    def test_as3_120102_lv11_heal_efficacy_up(self):
        """AS3 120102 Lv15: heal_efficacy_up on ally_all (permanent, stackable)."""
        self._reset_allies()
        self._reset_enemies()

        result = self.ss.execute_skill(self.caster, AS_MERCY, self.bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        # Check allies have heal_efficacy_up buff (ReceivedHealing in buffs)
        for ally in [self.caster, self.ally_fl, self.ally_fc, self.ally_fr]:
            heal_eff_buffs = [b for b in ally.buffs
                              if b.effect_type == SkillEffectType.RECEIVED_HEALING.value]
            self.assertGreaterEqual(len(heal_eff_buffs), 1,
                                    f"{ally.unit_id} must have heal_efficacy_up (ReceivedHealing in buffs)")
            self.assertEqual(heal_eff_buffs[0].duration, -1,
                             "heal_efficacy_up must be permanent (duration=-1)")

    def test_as3_120102_lv11_heal_efficacy_down(self):
        """AS3 120102 Lv15: heal_efficacy_down on enemy_all (permanent, stackable)."""
        self._reset_allies()
        self._reset_enemies()

        result = self.ss.execute_skill(self.caster, AS_MERCY, self.bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        # Check enemies have heal_efficacy_down debuff (ReceivedHealing in debuffs)
        for enemy in self.bf.enemy_team:
            heal_eff_debuffs = [b for b in enemy.debuffs
                                if b.effect_type == SkillEffectType.RECEIVED_HEALING.value]
            self.assertGreaterEqual(len(heal_eff_debuffs), 1,
                                    f"{enemy.unit_id} must have heal_efficacy_down (ReceivedHealing in debuffs)")
            self.assertEqual(heal_eff_debuffs[0].duration, -1,
                             "heal_efficacy_down must be permanent (duration=-1)")

    # ── PS 130110 functional tests ───────────────────────────

    def test_ps_130110_enemy_front_row_targeting(self):
        """PS 130110 Lv11+: action_damage on enemy_front_row (front only, not back)."""
        self._reset_allies()
        self._reset_enemies()

        result = self.ss.execute_skill(self.caster, PS_LUMINOUS, self.bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        # Front row enemies should have action_damage debuff
        from src.entities_v2.enums import SkillEffectType
        for enemy in [self.enemy_fl, self.enemy_fc, self.enemy_fr]:
            action_dmg = [b for b in enemy.debuffs
                          if b.effect_type == SkillEffectType.ACTION_DAMAGE.value]
            self.assertGreaterEqual(len(action_dmg), 1,
                                    f"{enemy.unit_id} (front row) must have action_damage")

        # Back row enemy should NOT have action_damage
        back_action_dmg = [b for b in self.enemy_bc.debuffs
                           if b.effect_type == SkillEffectType.ACTION_DAMAGE.value]
        self.assertEqual(len(back_action_dmg), 0,
                         "enemy_back_c (back row) must NOT have action_damage")

    def test_ps_130110_hot_on_ally_adjacent(self):
        """PS 130110: HOT applied to adjacent allies (not all allies)."""
        self._reset_allies()
        self._reset_enemies()
        # Clear buffs from previous tests
        for u in self.bf.friend_team:
            u.buffs = []

        result = self.ss.execute_skill(self.caster, PS_LUMINOUS, self.bf, skip_cost=True)
        self.assertTrue(result.get("success"))

        # Caster is at ALLY_CENTER_BACK. Adjacent allies are:
        # ally_front_c (front of caster), and left/right back if they exist
        # In our setup: caster at center_back, ally_front_l/c/r at front, no back allies
        # Adjacent to ALLY_CENTER_BACK: ALLY_CENTER_FRONT (ally_fc), ALLY_LEFT_BACK, ALLY_RIGHT_BACK
        # But we only have ally_fc adjacent (front), and no left_back/right_back allies
        from src.entities_v2.enums import SkillEffectType
        # ally_fc should have HOT
        hot_buffs = [b for b in self.ally_fc.buffs
                     if b.effect_type == SkillEffectType.HEAL_OVER_TIME.value]
        self.assertGreaterEqual(len(hot_buffs), 1,
                                "ally_fc (adjacent to caster) must have HOT")
        # ally_fl and ally_fr should NOT have HOT (not adjacent to center_back)
        hot_fl = [b for b in self.ally_fl.buffs
                  if b.effect_type == SkillEffectType.HEAL_OVER_TIME.value]
        self.assertEqual(len(hot_fl), 0,
                         "ally_fl (not adjacent to center_back caster) must NOT have HOT")


if __name__ == '__main__':
    unittest.main()
