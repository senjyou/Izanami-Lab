#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""回归测试：RDPS 归因 - mark_stat_bonus 伪源池

Bug 背景：「真心」等 mark 的 mark_stat_bonus（dealt_damage/crit_damage/attack）
参与实际伤害乘区，但 RDPS 归因池只收集 StatusAttack/DealtDamage/
CriticalBonusModification 类型 buff，mark 的贡献被按权重泄漏给同乘区的其他
buff 施加者（如心色的 +10% DealtDamage、回忆卡 20019 的 +8.4% EN伤害），
导致角色与回忆卡的 RDPS 统计明显偏差。

修复：_attribute_buffs_by_value 增加 mark_stat_name 参数，mark 池作为伪源
加入归因（总量由 _calc_mark_stat_bonus 精确给出），按授予者 stack_count
占比二次分配；回忆卡授予的 mark 归因到回忆卡。
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[2]))

from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.data.data_loader import DataLoader
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.rdps_tracker import RDPSTracker


def _make_unit(unit_id: str, name: str, side=Side.ALLY,
               position=Position.ALLY_CENTER_FRONT) -> UnitState:
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=1, level=1, element=1, character_type=1,
        max_hp=100000, current_hp=100000,
        attack=100000, defense=5000, speed=500,
        crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
        initial_active_point=5, initial_passive_point=5,
        max_extra_point=0, current_ap=5, current_pp=5, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_tracker():
    dl = DataLoader()
    dl.load_all()
    ds = DamageService()
    bf = BattlefieldState()
    tracker = RDPSTracker()
    tracker.set_damage_service(ds)
    tracker.set_battlefield(bf)
    return dl, ds, bf, tracker


def _add_dealt_buff(unit, value_pct, source_unit_id, name="dealt_buff"):
    """百分比 DealtDamage buff（value_tag=0，value 存百分点）"""
    b = BuffState(
        buff_id=f"{name}_{source_unit_id}", name=name,
        effect_type="DealtDamage", value=value_pct, duration=-1,
        timing_type=0, source_unit_id=source_unit_id, source_skill_id=0,
        is_debuff=False, value_tag=0, is_memory_buff=False,
    )
    unit.buffs.append(b)
    return b


def _add_mark(unit, mark_name, per_mark_pct, source_unit_id, stack_count=1,
              stat="dealt_damage", is_memory=False, source_skill_id=0):
    """携带 mark_stat_bonus 的 mark buff"""
    b = BuffState(
        buff_id=f"mark_{mark_name}_{source_unit_id}", name=mark_name,
        effect_type=SkillEffectType.MARK.value, value=0, duration=-1,
        timing_type=0, source_unit_id=source_unit_id, source_skill_id=source_skill_id,
        is_debuff=False, value_tag=0, is_memory_buff=is_memory,
        stack_count=stack_count,
        mark_stat_bonus={"mark_name": mark_name, "stat": stat,
                         "per_mark_pct": per_mark_pct, "max_marks": 0},
    )
    unit.buffs.append(b)
    return b


class TestRDPSMarkStatAttribution:
    """mark_stat_bonus 伪源池归因"""

    def test_mark_contribution_goes_to_granter(self):
        """mark 的 dealt_damage 加成应归因到 mark 授予者，而非同池 DealtDamage buff 施加者"""
        dl, ds, bf, tracker = _make_tracker()
        caster = _make_unit("F_carry", "输出核心")
        granter = _make_unit("F_granter", "mark授予者")
        buffer_unit = _make_unit("F_buffer", "buff施加者")
        enemy = _make_unit("E_1", "敌人", side=Side.ENEMY, position=Position.ENEMY_CENTER_FRONT)
        for u in (caster, granter, buffer_unit, enemy):
            bf.add_unit(u)

        # 输出核心身上：第三方 +10% DealtDamage buff + 授予者给的 +50% dealt mark
        _add_dealt_buff(caster, 10.0, "F_buffer")
        _add_mark(caster, "真心", 50.0, "F_granter", stack_count=1)

        share = 1000.0
        tracker._attribute_buffs_by_value(
            caster, caster.buffs, caster.debuffs,
            "DealtDamage", share, "buff_contribution", "dealt_dmg_contribution",
            bf, ds, mark_stat_name="dealt_damage")

        buff_stats = tracker._unit_stats
        granter_credit = buff_stats["F_granter"].buff_contribution
        buffer_credit = buff_stats["F_buffer"].buff_contribution
        # 权重：mark = 0.50（小数尺度），buff = 10/100 = 0.10
        assert abs(granter_credit - share * 0.5 / 0.6) < 1.0, \
            f"granter credit {granter_credit} != {share * 0.5 / 0.6}"
        assert abs(buffer_credit - share * 0.1 / 0.6) < 1.0, \
            f"buffer credit {buffer_credit} != {share * 0.1 / 0.6}"
        # 守恒：份额不增不减
        assert abs(granter_credit + buffer_credit - share) < 1.0

    def test_mark_pool_scales_with_stacks(self):
        """2枚同源 mark → mark 权重翻倍（0.5/枚 × 2 = 1.0），占比相应提高"""
        dl, ds, bf, tracker = _make_tracker()
        caster = _make_unit("F_carry", "输出核心")
        granter = _make_unit("F_granter", "mark授予者")
        enemy = _make_unit("E_1", "敌人", side=Side.ENEMY, position=Position.ENEMY_CENTER_FRONT)
        for u in (caster, granter, enemy):
            bf.add_unit(u)

        # 单个 buff 实例 stack_count=2（回忆卡 count 型 mark 也如此计数）
        _add_mark(caster, "真心", 50.0, "F_granter", stack_count=2)

        share = 1000.0
        # 无其他 buff：mark 池占 100%
        tracker._attribute_buffs_by_value(
            caster, caster.buffs, caster.debuffs,
            "DealtDamage", share, "buff_contribution", "dealt_dmg_contribution",
            bf, ds, mark_stat_name="dealt_damage")
        assert abs(tracker._unit_stats["F_granter"].buff_contribution - share) < 1.0

    def test_memory_card_mark_credited_to_card(self):
        """回忆卡授予的 mark 贡献应归因到回忆卡而非角色"""
        dl, ds, bf, tracker = _make_tracker()
        caster = _make_unit("F_carry", "输出核心")
        enemy = _make_unit("E_1", "敌人", side=Side.ENEMY, position=Position.ENEMY_CENTER_FRONT)
        for u in (caster, enemy):
            bf.add_unit(u)

        tracker.register_card_skill(30099, 400999)
        _add_mark(caster, "アイデア", 20.0, "F_carry", stack_count=1,
                  is_memory=True, source_skill_id=400999)

        share = 1000.0
        tracker._attribute_buffs_by_value(
            caster, caster.buffs, caster.debuffs,
            "DealtDamage", share, "buff_contribution", "dealt_dmg_contribution",
            bf, ds, mark_stat_name="dealt_damage")
        assert abs(tracker._memory_card_stats[30099].buff_contribution - share) < 1.0
        # 不应同时计入角色（避免双重计算）
        assert "F_carry" not in tracker._unit_stats or \
            tracker._unit_stats["F_carry"].buff_contribution == 0

    def test_no_mark_behavior_unchanged(self):
        """无 mark 时行为与旧逻辑一致：全部归到 buff 施加者"""
        dl, ds, bf, tracker = _make_tracker()
        caster = _make_unit("F_carry", "输出核心")
        buffer_unit = _make_unit("F_buffer", "buff施加者")
        enemy = _make_unit("E_1", "敌人", side=Side.ENEMY, position=Position.ENEMY_CENTER_FRONT)
        for u in (caster, buffer_unit, enemy):
            bf.add_unit(u)

        _add_dealt_buff(caster, 10.0, "F_buffer")

        share = 1000.0
        tracker._attribute_buffs_by_value(
            caster, caster.buffs, caster.debuffs,
            "DealtDamage", share, "buff_contribution", "dealt_dmg_contribution",
            bf, ds, mark_stat_name="dealt_damage")
        assert abs(tracker._unit_stats["F_buffer"].buff_contribution - share) < 1.0

    def test_attack_zone_mark_weight_absolute(self):
        """attack 乘区：mark 权重为绝对值加数，与固值/百分比 buff 公平分配"""
        dl, ds, bf, tracker = _make_tracker()
        caster = _make_unit("F_carry", "输出核心")
        granter = _make_unit("F_granter", "mark授予者")
        enemy = _make_unit("E_1", "敌人", side=Side.ENEMY, position=Position.ENEMY_CENTER_FRONT)
        for u in (caster, granter, enemy):
            bf.add_unit(u)

        # mark: attack +50%/枚 → 绝对值 100000×0.5 = 50000
        _add_mark(caster, "闘志", 50.0, "F_granter", stack_count=1, stat="attack")
        # 固值 ATK buff +25000
        b = BuffState(
            buff_id="atk_fixed", name="atk_fixed", effect_type="StatusAttack",
            value=25000, duration=-1, timing_type=0,
            source_unit_id="F_granter", source_skill_id=0,
            is_debuff=False, value_tag=1, is_memory_buff=False,
        )
        caster.buffs.append(b)

        share = 6000.0
        tracker._attribute_buffs_by_value(
            caster, caster.buffs, caster.debuffs,
            "StatusAttack", share, "buff_contribution", "atk_buff_contribution",
            bf, ds, base_stat_unit=caster, mark_stat_name="attack")

        # 权重比 50000:25000 = 2:1
        granter_credit = tracker._unit_stats["F_granter"].buff_contribution
        assert abs(granter_credit - share) < 1.0  # 同一授予者，两个池都归他
        detail = tracker._unit_stats["F_granter"].atk_buff_contribution
        assert abs(detail - share) < 1.0
