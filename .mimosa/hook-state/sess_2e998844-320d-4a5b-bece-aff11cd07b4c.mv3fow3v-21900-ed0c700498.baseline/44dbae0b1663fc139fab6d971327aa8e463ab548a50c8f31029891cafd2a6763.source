    # ════════════════════════════════════════════════════════════════
    # PS2: 130087 キャットウォーク (on_turn_end + mark_count>=1 enemy)
    # ════════════════════════════════════════════════════════════════

    def test_ps2_triggers_on_turn_end_with_mark(self):
        """PS2(130087) on_turn_end: 敵陣営にターゲットmark>=1の单位存在時 → Block1执行。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # enemy_cf に ターゲットmark付与
        self._apply_target_mark(self.enemy_cf, count=1)

        actions = self.ts.trigger_turn_end(self.bf)

        ps2_actions = [a for a in actions if a.skill_id == 130087]
        self.assertGreater(len(ps2_actions), 0, "敵にターゲットmark有り→PS2应触发")

    def test_ps2_not_triggers_without_mark(self):
        """PS2(130087) on_turn_end: 敵陣営にターゲットmark無し → Block1条件不满足（mark_count>=1未达）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 不付与ターゲットmark

        # PS2 trigger_turn_end 会触发，但execute_skill中Block1条件不满足→跳过
        # 这里通过执行PS2并验证无EP变化/无def_down来确认
        actions = self.ts.trigger_turn_end(self.bf)

        ps2_actions = [a for a in actions if a.skill_id == 130087]
        # PS2 may trigger (turn_end match) but Block1 should be skipped inside execute_skill
        # 关键验证: 即使PS2被触发，无mark的enemy不应有EP变化或def_down
        ep_cf_before = self.enemy_cf.current_ep

        self.ss._pending_crit_triggers = []
        if ps2_actions:
            self.ss._execute_trigger_actions_inline(
                ps2_actions, self.bf, trigger_timing="on_turn_end"
            )

        # 无mark → 不应消耗EP
        self.assertEqual(self.enemy_cf.current_ep, ep_cf_before,
                         "無ターゲットmark時PS2 Block1应跳过，EP不变")
        # 无mark → 不应施加 def_down
        def_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == STATUS_DEFENSE]
        self.assertEqual(len(def_downs), 0, "無ターゲットmark時PS2 Block1应跳过，无def_down")

    def test_ps2_removes_ep_from_marked_enemies(self):
        """PS2(130087) Block1: ターゲットmarkを持つ敵全員にEXゲージ-1。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # enemy_cf と enemy_lf にmark付与（enemy_rf無し）
        self._apply_target_mark(self.enemy_cf, count=1)
        self._apply_target_mark(self.enemy_lf, count=2)

        ep_cf_before = self.enemy_cf.current_ep  # 3
        ep_lf_before = self.enemy_lf.current_ep   # 2
        ep_rf_before = self.enemy_rf.current_ep   # 2

        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130087]
        self.assertGreater(len(ps2_actions), 0, "PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # markを持つ敵のみEP-1
        self.assertEqual(self.enemy_cf.current_ep, ep_cf_before - 1,
                         "enemy_cf(ターゲットmark有り)のEP应-1")
        self.assertEqual(self.enemy_lf.current_ep, ep_lf_before - 1,
                         "enemy_lf(ターゲットmark有り)のEP应-1")
        # mark無しの敵はEP不变
        self.assertEqual(self.enemy_rf.current_ep, ep_rf_before,
                         "enemy_rf(ターゲットmark無し)のEP应不变")

    def test_ps2_applies_def_down_to_marked_enemies(self):
        """PS2(130087) Block1: ターゲットmarkを持つ敵全員にdef_down(2action, percent)付与。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # enemy_cf にmark付与
        self._apply_target_mark(self.enemy_cf, count=1)

        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130087]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # enemy_cf (mark有り) 应被付与 def_down
        def_downs_cf = [d for d in self.enemy_cf.debuffs if d.effect_type == STATUS_DEFENSE]
        self.assertGreater(len(def_downs_cf), 0,
                           "enemy_cf(ターゲットmark有り)应有def_down debuff")
        self.assertEqual(def_downs_cf[0].duration, 2, "def_down duration应为2(2action)")
        # value_tag="def" Lv10=20.0 → value应为正数
        self.assertGreater(def_downs_cf[0].value, 0, "def_down value应为正数(Lv10 def=20%)")

        # enemy_rf (mark無し) 不应被付与 def_down
        def_downs_rf = [d for d in self.enemy_rf.debuffs if d.effect_type == STATUS_DEFENSE]
        self.assertEqual(len(def_downs_rf), 0,
                         "enemy_rf(ターゲットmark無し)不应有def_down")

    # ════════════════════════════════════════════════════════════════
    # ターゲットmark 全链专项
    # ════════════════════════════════════════════════════════════════

    def test_target_mark_is_debuff(self):
        """ターゲットmark is_buff_mark=false → 进 debuffs 列表(is_debuff=True)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        self.ss.execute_skill(
            caster=self.caster, skill_id=110033, battlefield=self.bf, skip_cost=True
        )

        # ターゲットmark 应在 debuffs 列表
        marks_in_buffs = [b for b in self.enemy_cf.buffs
                          if b.effect_type == MARK and b.name == "ターゲット"]
        marks_in_debuffs = [d for d in self.enemy_cf.debuffs
                            if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks_in_buffs), 0, "ターゲットmark不应在buffs列表")
        self.assertEqual(len(marks_in_debuffs), 1, "ターゲットmark应在debuffs列表")
        self.assertTrue(marks_in_debuffs[0].is_debuff, "ターゲットmark is_debuff应为True")

    def test_target_mark_stackable_across_skills(self):
        """ターゲットmark stackable=true → 跨技能(EX + AS2 on_crit)累积共存。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._force_crit()

        # 1. EX付与全体mark（enemy_cf に1個）
        self.ss.execute_skill(
            caster=self.caster, skill_id=110033, battlefield=self.bf, skip_cost=True
        )
        marks_after_ex = [d for d in self.enemy_cf.debuffs
                          if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks_after_ex), 1, "EX后enemy_cf应有1个ターゲットmark")

        # 2. AS2暴击 → 追加1個mark
        self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
        marks_after_as2 = [d for d in self.enemy_cf.debuffs
                           if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks_after_as2), 2,
                         "EX+AS2暴击后应有2个ターゲットmark(stackable累积)")

    def test_mark_full_chain_ex_as1_as2_ps1_ps2(self):
        """ターゲットmark 全链：EX付与→AS1 tiers增伤→AS2 on_crit追加→PS1 on_ally_killed付与→PS2 mark_count消费。

        本测试串联验证5技能联动的mark全链。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_allies()
        self._force_crit()

        # 1. EX付与全体ターゲットmark（enemy_cf/lb/rf 各1個）
        self.ss.execute_skill(
            caster=self.caster, skill_id=110033, battlefield=self.bf, skip_cost=True
        )
        marks_cf = [d for d in self.enemy_cf.debuffs
                    if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks_cf), 1, "EX后enemy_cf应有1個ターゲットmark")

        # 2. AS2暴击 → enemy_cf に追加1個mark（合計2個）
        self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
        marks_cf = [d for d in self.enemy_cf.debuffs
                    if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks_cf), 2, "EX+AS2暴击后enemy_cf应有2個ターゲットmark")

        # 3. AS1 with 2 mark → tier2(20%)增伤 → 伤害应×1.20
        dmg_as1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        ).get("total_damage", 0)
        self.assertGreater(dmg_as1, 0, "AS1应造成伤害")

        # 4. PS1 on_ally_killed付与trigger_attacker(ally_cf被enemy_lf击杀)
        # 让ally_cf被enemy_lf击杀
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_cf],
            battlefield=self.bf,
            killer=self.enemy_lf,
        )
        ps1_actions = [a for a in actions if a.skill_id == 130086]
        self.assertGreater(len(ps1_actions), 0, "PS1应触发(ally_cf被击杀)")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_ally_killed"
        )
        # enemy_lf (trigger_attacker) 应有 ターゲットmark
        marks_lf = [d for d in self.enemy_lf.debuffs
                    if d.effect_type == MARK and d.name == "ターゲット"]
        # EX付与1個 + PS1追加1個 = 2個
        self.assertEqual(len(marks_lf), 2,
                         "PS1应在trigger_attacker(enemy_lf)追加ターゲットmark")

        # 5. PS2 on_turn_end → markを持つ敵全員にEP-1 + def_down
        # 確認: enemy_cf (2個mark), enemy_lf (2個mark), enemy_rf (1個mark) 全員mark有り
        ep_cf_before = self.enemy_cf.current_ep
        ep_lf_before = self.enemy_lf.current_ep
        ep_rf_before = self.enemy_rf.current_ep

        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130087]
        self.assertGreater(len(ps2_actions), 0, "PS2应触发")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # 全敵都有mark → 全員EP-1 + def_down
        self.assertEqual(self.enemy_cf.current_ep, ep_cf_before - 1, "enemy_cf EP应-1")
        self.assertEqual(self.enemy_lf.current_ep, ep_lf_before - 1, "enemy_lf EP应-1")
        self.assertEqual(self.enemy_rf.current_ep, ep_rf_before - 1, "enemy_rf EP应-1")

        for e in self.bf.enemy_team:
            def_downs = [d for d in e.debuffs if d.effect_type == STATUS_DEFENSE]
            self.assertGreater(len(def_downs), 0,
                               f"{e.name}应有def_down debuff")

    def test_mark_count_per_target_independent_ps2(self):
        """PS2 mark_count>=1条件 per-target 独立判断（target_scope=enemy）。

        场景: enemy_cf 有2个mark, enemy_lf 有0个mark, enemy_rf 有1个mark
        → PS2 应作用于 enemy_cf と enemy_rf（mark>=1的敵），跳过 enemy_lf（mark=0）。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # enemy_cf: 2個mark, enemy_lf: 0個mark, enemy_rf: 1個mark
        self._apply_target_mark(self.enemy_cf, count=2)
        self._apply_target_mark(self.enemy_rf, count=1)
        # enemy_lf 无mark

        ep_cf_before = self.enemy_cf.current_ep
        ep_lf_before = self.enemy_lf.current_ep
        ep_rf_before = self.enemy_rf.current_ep

        actions = self.ts.trigger_turn_end(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130087]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_end"
        )

        # mark有りの敵: EP-1 + def_down
        self.assertEqual(self.enemy_cf.current_ep, ep_cf_before - 1,
                         "enemy_cf(2個mark)EP应-1")
        self.assertEqual(self.enemy_rf.current_ep, ep_rf_before - 1,
                         "enemy_rf(1個mark)EP应-1")
        # mark無しの敵: EP不变 + 无def_down
        self.assertEqual(self.enemy_lf.current_ep, ep_lf_before,
                         "enemy_lf(0個mark)EP应不变")
        def_downs_lf = [d for d in self.enemy_lf.debuffs if d.effect_type == STATUS_DEFENSE]
        self.assertEqual(len(def_downs_lf), 0,
                         "enemy_lf(0個mark)不应有def_down")

    # ════════════════════════════════════════════════════════════════
    # on_crit + once_per_skill 专项
    # ════════════════════════════════════════════════════════════════

    def test_on_crit_block_executed_only_once(self):
        """AS2 Block3 on_crit once_per_skill=true → 单次技能仅执行1次（即使多hit暴击）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._force_crit()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证: 即使暴击，仅1个ターゲットmark（once_per_skill限制）
        marks = [d for d in self.enemy_cf.debuffs
                 if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks), 1,
                         "once_per_skill=true → 即使暴击多次，仅付与1个mark")

    def test_on_crit_no_trigger_when_force_no_crit(self):
        """AS2 Block3 on_crit → 非暴击时不触发（force_no_crit验证）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._force_no_crit()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 非暴击 → Block3 不应执行
        marks = [d for d in self.enemy_cf.debuffs
                 if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks), 0, "非暴击时不应触发on_crit block")

    def test_on_crit_mark_targets_crit_target_only(self):
        """AS2 Block3: ターゲットmark付与对象为crit_target（暴击対象）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._force_crit()

        # AS2 single target = enemy_cf (最近敌方) → crit_target = enemy_cf
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 仅 crit_target (enemy_cf) 应被付与 ターゲットmark
        marks_cf = [d for d in self.enemy_cf.debuffs
                    if d.effect_type == MARK and d.name == "ターゲット"]
        marks_lf = [d for d in self.enemy_lf.debuffs
                    if d.effect_type == MARK and d.name == "ターゲット"]
        marks_rf = [d for d in self.enemy_rf.debuffs
                    if d.effect_type == MARK and d.name == "ターゲット"]

        self.assertEqual(len(marks_cf), 1, "crit_target(enemy_cf)应被付与mark")
        self.assertEqual(len(marks_lf), 0, "enemy_lf(非crit_target)不应被付与mark")
        self.assertEqual(len(marks_rf), 0, "enemy_rf(非crit_target)不应被付与mark")

    # ════════════════════════════════════════════════════════════════
    # on_ally_killed 专项
    # ════════════════════════════════════════════════════════════════

    def test_on_ally_killed_triggers_when_ally_dies(self):
        """PS1 on_ally_killed → 友方(ally_cf)阵亡时PS1触发。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_allies()

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_cf],
            battlefield=self.bf,
            killer=self.enemy_cf,
        )
        ps1_actions = [a for a in actions if a.skill_id == 130086]
        self.assertGreater(len(ps1_actions), 0, "ally_cf阵亡时PS1应触发")

    def test_on_ally_killed_no_trigger_when_enemy_dies(self):
        """PS1 on_ally_killed → 敌方阵亡时不触发（仅友方阵亡）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf],
            battlefield=self.bf,
            killer=self.caster,
        )
        ps1_actions = [a for a in actions if a.skill_id == 130086]
        self.assertEqual(len(ps1_actions), 0, "敌方阵亡时PS1不应触发")

    def test_on_ally_killed_no_trigger_when_self_dies(self):
        """PS1 on_ally_killed → 自身阵亡时不触发（owner is the dead one）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        actions = self.ts.trigger_pawn_died(
            dead_units=[self.caster],
            battlefield=self.bf,
            killer=self.enemy_cf,
        )
        ps1_actions = [a for a in actions if a.skill_id == 130086]
        self.assertEqual(len(ps1_actions), 0, "自身阵亡时PS1不应触发")

    def test_on_ally_killed_trigger_attacker_is_killer(self):
        """PS1 on_ally_killed → trigger_attacker = killer（击杀者），用于damage/mark定位。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_allies()

        # 让 enemy_lf 击杀 ally_cf
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_cf],
            battlefield=self.bf,
            killer=self.enemy_lf,
        )
        ps1_actions = [a for a in actions if a.skill_id == 130086]
        self.assertGreater(len(ps1_actions), 0, "PS1应触发")

        # 执行PS1
        hp_lf_before = self.enemy_lf.current_hp
        hp_cf_before = self.enemy_cf.current_hp
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_ally_killed"
        )

        # trigger_attacker = enemy_lf (killer) → enemy_lf 应受到伤害
        self.assertLess(self.enemy_lf.current_hp, hp_lf_before,
                       "trigger_attacker(enemy_lf)应受到PS1伤害")
        # 其他敌人不应受到伤害
        self.assertEqual(self.enemy_cf.current_hp, hp_cf_before,
                         "enemy_cf(非killer)不应受到PS1伤害")

    # ════════════════════════════════════════════════════════════════
    # tiers 模式专项（conditional_power_bonus target_mark_count tiers）
    # ════════════════════════════════════════════════════════════════

    def test_tiers_mode_1_mark_gives_10pct(self):
        """AS1 tiers模式: mark_count=1 → tier(min_count=1, value=10%)增伤。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=1)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_with_mark = result.get("total_damage", 0)

        # base damage
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_base = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_base = result_base.get("total_damage", 0)

        ratio = dmg_with_mark / dmg_base
        self.assertAlmostEqual(ratio, 1.10, delta=0.05,
                               msg=f"1层mark → tier1 10%增伤，实际: {ratio:.3f}")

    def test_tiers_mode_2_marks_gives_20pct(self):
        """AS1 tiers模式: mark_count=2 → tier(min_count=2, value=20%)增伤。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=2)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_with_mark = result.get("total_damage", 0)

        # base damage
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_base = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_base = result_base.get("total_damage", 0)

        ratio = dmg_with_mark / dmg_base
        self.assertAlmostEqual(ratio, 1.20, delta=0.05,
                               msg=f"2层mark → tier2 20%增伤，实际: {ratio:.3f}")

    def test_tiers_mode_3_marks_gives_30pct(self):
        """AS1 tiers模式: mark_count=3 → tier(min_count=3, value=30%)增伤。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=3)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_with_mark = result.get("total_damage", 0)

        # base damage
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_base = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_base = result_base.get("total_damage", 0)

        ratio = dmg_with_mark / dmg_base
        self.assertAlmostEqual(ratio, 1.30, delta=0.05,
                               msg=f"3层mark → tier3 30%增伤，实际: {ratio:.3f}")

    def test_tiers_mode_5_marks_caps_at_30pct(self):
        """AS1 tiers模式: mark_count=5(>3) → 仍取tier3(30%)增伤（封顶）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=5)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_with_mark = result.get("total_damage", 0)

        # base damage
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_base = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_base = result_base.get("total_damage", 0)

        ratio = dmg_with_mark / dmg_base
        # 5层mark → 仍30%增伤（tier3封顶，无更高tier）
        self.assertAlmostEqual(ratio, 1.30, delta=0.05,
                               msg=f"5层mark应封顶在tier3(30%)，实际: {ratio:.3f}")

    def test_tiers_mode_skipped_when_no_mark(self):
        """AS1 tiers模式: mark_count=0 → 无tier匹配 → 无增伤。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 无ターゲットmark

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 无conditional_power_bonus → 无临时dmg_dealt_up buff
        dmg_ups = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_ups), 0, "无ターゲットmark时不应有dmg_dealt_up buff")

    def test_tiers_mode_no_burn_below_3_marks(self):
        """AS1 Block2: mark_count<3 → burn付与block跳过（mark_count>=3未满足）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 2个mark（<3）
        self._apply_target_mark(self.enemy_cf, count=2)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block2 应跳过 → 无burn
        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        self.assertEqual(len(burns), 0, "2层mark(<3)时Block2应跳过，无burn付与")

    def test_tiers_mode_burn_with_exact_3_marks(self):
        """AS1 Block2: mark_count=3(>=3) → burn付与（边界值验证）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=3)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        self.assertGreater(len(burns), 0, "3层mark(>=3)时Block2应执行burn付与")
        self.assertEqual(burns[0].duration, 1, "burn duration应为1(1action)")


if __name__ == "__main__":
    unittest.main(verbosity=2)
