        self.assertEqual(len(marks), 1, "PS1应付与trigger_attacker 1个ターゲットmark")
        self.assertTrue(marks[0].is_debuff, "ターゲットmark应为debuff")
        self.assertTrue(marks[0].is_stackable, "ターゲットmark应可叠加")

    def test_ps1_lv11_dmg_taken_up_to_trigger_attacker(self):
        """PS1(130086) Block2 Lv11+: 倒した敵に dmg_taken_up(percent, attack_limited=1)付与。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_allies()
        self.caster.level = 11
        self.caster.skill_levels[130086] = 11

