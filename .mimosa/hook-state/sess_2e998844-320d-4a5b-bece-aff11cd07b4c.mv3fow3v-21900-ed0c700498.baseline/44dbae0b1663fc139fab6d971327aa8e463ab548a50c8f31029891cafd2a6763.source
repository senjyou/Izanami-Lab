        self._force_crit()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block2 应执行: 暴击+3mark → knockout
        knockouts = [d for d in self.enemy_cf.debuffs if d.effect_type == KNOCKOUT]
        self.assertGreater(len(knockouts), 0,
                           "Lv11+暴击+3层ターゲット→应施加knockout")
        self.assertEqual(knockouts[0].duration, 1, "knockout duration应为1(1action)")

    def test_as2_lv11_no_knockout_below_3_marks(self):
        """AS2(120077) Block2 Lv11+: 暴击 + ターゲットmark<3 → 跳过knockout。"""
        self._reset_caster(hp=self.caster.max_hp)
