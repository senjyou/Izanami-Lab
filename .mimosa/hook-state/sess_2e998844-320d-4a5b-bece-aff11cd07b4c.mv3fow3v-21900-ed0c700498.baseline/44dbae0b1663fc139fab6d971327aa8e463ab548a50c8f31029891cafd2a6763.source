    def test_as2_damage_to_single_enemy(self):
        """AS2(120077) Block1: 敵単体に威力ダメージ。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._force_no_crit()

        hp_cf_before = self.enemy_cf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
