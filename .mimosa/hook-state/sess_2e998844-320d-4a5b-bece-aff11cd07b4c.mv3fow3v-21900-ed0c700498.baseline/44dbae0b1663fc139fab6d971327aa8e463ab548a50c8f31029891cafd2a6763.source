        self.assertEqual(len(knockouts), 0,
                         "ターゲットmark<3时即使暴击+Lv11+也不应施加knockout")

    # ════════════════════════════════════════════════════════════════
    # PS1: 130086 キャッチライト (on_ally_killed)
    # ════════════════════════════════════════════════════════════════

    def test_ps1_triggers_on_ally_killed(self):
        """PS1(130086) on_ally_killed: 他の味方が敵に倒された際に発動。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_allies()

        # ally_cf 被enemy_cf击杀
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_cf],
            battlefield=self.bf,
            killer=self.enemy_cf,
        )

        ps1_actions = [a for a in actions if a.skill_id == 130086]
        self.assertGreater(len(ps1_actions), 0, "友方(ally_cf)被击杀时PS1应触发")

    def test_ps1_not_triggers_on_self_killed(self):
        """PS1(130086) on_ally_killed: 自身阵亡不触发（owner is the dead one）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # caster自身被击杀
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.caster],
            battlefield=self.bf,
            killer=self.enemy_cf,
        )

        ps1_actions = [a for a in actions if a.skill_id == 130086]
        self.assertEqual(len(ps1_actions), 0, "自身阵亡时PS1不应触发")

    def test_ps1_not_triggers_on_enemy_killed(self):
        """PS1(130086) on_ally_killed: 敌方阵亡不触发（仅友方阵亡时）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # enemy_cf 被击杀（敌方阵亡）
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf],
            battlefield=self.bf,
            killer=self.caster,
        )

        ps1_actions = [a for a in actions if a.skill_id == 130086]
        self.assertEqual(len(ps1_actions), 0, "敌方阵亡时PS1不应触发(仅友方阵亡)")

    def test_ps1_damage_to_trigger_attacker(self):
        """PS1(130086) Block1: 倒した敵(trigger_attacker)に威力ダメージ。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_allies()

        # ally_cf 被enemy_cf击杀
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_cf],
            battlefield=self.bf,
            killer=self.enemy_cf,
        )

        ps1_actions = [a for a in actions if a.skill_id == 130086]
        self.assertGreater(len(ps1_actions), 0, "PS1应触发")

        # 执行PS1
        hp_cf_before = self.enemy_cf.current_hp
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_ally_killed"
        )

        # enemy_cf (trigger_attacker) 应受到PS1伤害
        self.assertLess(self.enemy_cf.current_hp, hp_cf_before,
                        "PS1应对trigger_attacker(enemy_cf)造成伤害")

    def test_ps1_mark_to_trigger_attacker(self):
        """PS1(130086) Block1: 倒した敵(trigger_attacker)にターゲットmark付与。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_allies()

