        self.assertEqual(vulns[0].attack_limited, 1, "dmg_taken_up attack_limited应为1")
        self.assertTrue(vulns[0].is_stackable, "dmg_taken_up应可叠加")
        # value_tag="dmg" Lv11=15.0
        self.assertGreater(vulns[0].value, 0, "dmg_taken_up value应为正数(Lv11 dmg=15%)")

