# -*- coding: utf-8 -*-
"""角色138301 気高きランウェイモデル 专项E2E测试（ターゲットmark全链 + on_crit/once_per_skill +
on_ally_killed + conditional_power_bonus tiers + mark_count block条件）

技能列表：
- EX: 110033 プラウド・ランウェイ（敵全体威力ダメージ + ターゲットmark(stackable)付与
  ; Lv11+: 敵全体に dmg_taken_up(value_tag=dmg, percent, attack_limited=1, hit, stackable)）
- AS1: 120076 トップライトショット（敵単体威力ダメージ
  + conditional_power_bonus(target_mark_count ターゲット tiers 3=30%/2=20%/1=10%, bonus_type=dealt_damage)
  ; Block2: mark_count ターゲット>=3 attacked → burn付与(burn_damage_pct=30, 1action)）
- AS2: 120077 アバンギャルドカット（敵単体威力ダメージ
  + Block2 (Lv11+ AND on_crit AND once_per_skill AND mark_count ターゲット>=3 attacked):
       knockout(1action) to crit_target
  + Block3 (on_crit AND once_per_skill): ターゲットmark(stackable) to crit_target）
- PS1: 130086 キャッチライト（on_ally_killed: 他の味方が敵に倒された際に発動
  ; Block1: 倒した敵(trigger_attacker)に威力ダメージ + ターゲットmark付与
  ; Block2 Lv11+: 倒した敵に dmg_taken_up(percent, attack_limited=1, hit, stackable)）
- PS2: 130087 キャットウォーク（on_turn_end: ターゲットmarkを持つ敵全員に
  ; Block1 mark_count ターゲット>=1 enemy → remove_ep(value=1, target_count=99) + def_down(2action, percent)）

覆盖维度：
1. EX 敵全体威力 + ターゲットmark付与(全敵) + Lv11+ dmg_taken_up(attack_limited)
2. AS1 conditional_power_bonus tiers模式(1/2/3层增伤 10/20/30%) + Block2 mark_count>=3 burn付与
3. AS2 on_crit ターゲットmark追加 + once_per_skill + Lv11+ on_crit+mark_count>=3 knockout
4. PS1 on_ally_killed trigger_attacker定位 + ターゲットmark付与 + Lv11+ dmg_taken_up
5. PS2 on_turn_end mark_count>=1条件 + remove_ep + def_down
6. ターゲットmark 全链专项（EX付与→AS1 tiers增伤→AS2 on_crit追加→PS1 on_ally_killed付与→PS2 mark_count消费）
7. on_crit + once_per_skill 专项（暴击触发1次/多hit暴击仅触发1次/非暴击不触发）
8. on_ally_killed 专项（友方被击杀触发/敌方阵亡不触发/自身阵亡不触发）
9. tiers 模式专项（mark_count=1→10%, =2→20%, =3→30%, =5→30%封顶）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction, TriggerTiming
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# mark 用 MARK 枚举（ターゲット mark is_buff_mark=false → debuffs 列表, is_debuff=True）
# knockout 用 KNOCKOUT 枚举（気絶，进 debuffs 列表）
# burn 用 CONFLAGRATION 枚举（炎上，进 debuffs 列表）
# dmg_taken_up 用 RECEIVED_DAMAGE 枚举
# def_down 用 STATUS_DEFENSE 枚举
# dmg_dealt_up 用 DEALT_DAMAGE 枚举
MARK = SkillEffectType.MARK.value
KNOCKOUT = SkillEffectType.KNOCKOUT.value
CONFLAGRATION = SkillEffectType.CONFLAGRATION.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value

# AuraUpdateTiming 数值
# DURABLE_TARGET_MANEUVER_END=4: duration_type="action" 映射
# DURABLE_WHEN_USED=6: duration_type="hit"/"attack" + attack_limited/hit_limited 映射
DURABLE_TARGET_MANEUVER_END = AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value   # 4
DURABLE_WHEN_USED = AuraUpdateTiming.DURABLE_WHEN_USED.value                       # 6


class TestActor138301(unittest.TestCase):
    """角色138301 気高きランウェイモデル 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 1

        # 施法者: 138301 気高きランウェイモデル (水属性attr=2, 敏捷型character_type=3, 灵活position_type=3, 控制role_type=5)
        # max_ap=2, max_pp=2
        # caster 放后排中央
        self.caster = UnitState(
            unit_id="caster", name="気高きランウェイモデル", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=138301, level=10,
            element=2, character_type=3,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110033, 120076, 120077, 130086, 130087],
            skill_levels={110033: 10, 120076: 10, 120077: 10,
                          130086: 10, 130087: 10},
            skill_cooldowns={},
        )

        # 敌方前排中央（最近敌方，便于索敌）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（atk最高）
        # 注: max_hp=30000 确保 enemy_lf 能在 全链测试 中承受 EX(8580)+PS1(8423)=17003 伤害后存活
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=12000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（spd最高）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=4500, speed=600,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 友方前排中央（用于PS1 on_ally_killed测试）
        self.ally_cf = UnitState(
            unit_id="ally_cf", name="味方中前", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999101, level=10,
            element=5, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=9000, defense=4000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally_cf]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    # ────────────────────────────────────────────────────────────────
    # 辅助方法
    # ────────────────────────────────────────────────────────────────

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.is_stunned = False
        self.caster.is_frozen = False
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.skill_use_count = {}
        self.caster.level = 10
        for sid in self.caster.skill_levels:
            self.caster.skill_levels[sid] = 10
        # 清理暴击override
        self.dms.set_crit_override(None)

    def _reset_enemies(self):
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.is_stunned = False
            e.is_frozen = False
            e.current_ap = 4
            e.current_ep = 2 if e.unit_id != "enemy_cf" else 3

    def _reset_allies(self):
        for a in self.bf.friend_team:
            if a.unit_id == "caster":
                continue
            a.current_hp = a.max_hp
            a.buffs = []
            a.debuffs = []
            a.is_alive = True
            a.is_stunned = False
            a.is_frozen = False
            a.current_ap = 4
            a.current_ep = 2 if a.unit_id != "ally_cf" else 2

    def _apply_target_mark(self, target, count=1):
        """为指定目标附加「ターゲット」mark debuff（is_buff_mark=false → debuffs 列表, is_debuff=True）。

        138301 的核心 debuff mark：ターゲット 驱动 AS1 tiers增伤 + AS2 Block2 knockout + PS2 mark_count条件。
        通常由 EX/AS2 on_crit/PS1 on_ally_killed 付与敌方。
        """
        for i in range(count):
            target.debuffs.append(BuffState(
                buff_id=f"test_target_mark_{id(target)}_{i}",
                name="ターゲット", effect_type=MARK, value=1,
                duration=-1, timing_type=2, is_debuff=True,
                is_stackable=True, unremovable=False,
            ))

    def _force_crit(self):
        """强制caster攻击必定暴击（用于on_crit block测试）。"""
        self.dms.set_crit_override(lambda ctx: True)

    def _force_no_crit(self):
        """强制caster攻击必定不暴击。"""
        self.dms.set_crit_override(lambda ctx: False)

    # ════════════════════════════════════════════════════════════════
    # EX: 110033 プラウド・ランウェイ
    # ════════════════════════════════════════════════════════════════

    def test_ex_damage_to_all_enemies(self):
        """EX(110033) Block1: 敵全体に威力ダメージ（全敵HP减少）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_before = {e.unit_id: e.current_hp for e in self.bf.enemy_team}

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110033, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 全敵都应受到伤害
        for e in self.bf.enemy_team:
            self.assertLess(e.current_hp, hp_before[e.unit_id],
                            f"{e.name}应受到EX全体伤害")

    def test_ex_applies_target_mark_to_all_enemies(self):
        """EX(110033) Block1: 敵全体にターゲットmark(debuff, stackable)付与。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110033, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 全敵应被付与1个ターゲットmark（debuffs列表）
        for e in self.bf.enemy_team:
            marks = [d for d in e.debuffs
                     if d.effect_type == MARK and d.name == "ターゲット"]
            self.assertEqual(len(marks), 1, f"{e.name}应有1个ターゲットmark")
            self.assertTrue(marks[0].is_debuff, "ターゲットmark应为debuff")
            self.assertTrue(marks[0].is_stackable, "ターゲットmark应可叠加")
            self.assertEqual(marks[0].duration, -1, "ターゲットmark duration应为-1(永続)")

    def test_ex_mark_stackable_across_multiple_casts(self):
        """EX(110033) ターゲットmark stackable=true → 多次EX累积mark数。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 第1次EX
        self.ss.execute_skill(
            caster=self.caster, skill_id=110033, battlefield=self.bf, skip_cost=True
        )
        # 第2次EX
        self.ss.execute_skill(
            caster=self.caster, skill_id=110033, battlefield=self.bf, skip_cost=True
        )

        # enemy_cf 应有2个ターゲットmark（stackable累积）
        marks = [d for d in self.enemy_cf.debuffs
                 if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks), 2,
                         "2次EX后enemy_cf应有2个ターゲットmark(stackable累积)")

    def test_ex_lv10_no_dmg_taken_up(self):
        """EX(110033) Block2: Lv10时跳过（active_level_min=11 未满足）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[110033] = 10

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110033, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block2 dmg_taken_up 不应被施加
        for e in self.bf.enemy_team:
            vulns = [d for d in e.debuffs if d.effect_type == RECEIVED_DAMAGE]
            self.assertEqual(len(vulns), 0,
                             f"Lv10时{e.name}不应有dmg_taken_up debuff")

    def test_ex_lv11_applies_dmg_taken_up(self):
        """EX(110033) Block2 Lv11+: 敵全体に dmg_taken_up(percent, attack_limited=1, hit, stackable)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[110033] = 11

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110033, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 全敵应被付与 dmg_taken_up debuff
        for e in self.bf.enemy_team:
            vulns = [d for d in e.debuffs if d.effect_type == RECEIVED_DAMAGE]
            self.assertGreater(len(vulns), 0,
                               f"Lv11+时{e.name}应有dmg_taken_up debuff")
            v = vulns[0]
            self.assertEqual(v.attack_limited, 1, "dmg_taken_up attack_limited应为1")
            self.assertTrue(v.is_stackable, "dmg_taken_up应可叠加(stackable=true)")
            # value_tag="dmg" Lv11=10.0 → value应为正数
            self.assertGreater(v.value, 0, "dmg_taken_up value应为正数(Lv11 dmg=10%)")

    # ════════════════════════════════════════════════════════════════
    # AS1: 120076 トップライトショット
    # ════════════════════════════════════════════════════════════════

    def test_as1_damage_to_single_enemy(self):
        """AS1(120076) Block1: 敵単体に威力ダメージ（最近敌方enemy_cf受到伤害，其他敌人不受影响）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_cf (最近) 应受到伤害
        self.assertLess(self.enemy_cf.current_hp, hp_cf_before,
                        "enemy_cf(最近敌方)应受到AS1伤害")
        # 其他敌人不应受到伤害
        self.assertEqual(self.enemy_lf.current_hp, hp_lf_before,
                         "enemy_lf不应受到AS1伤害")
        self.assertEqual(self.enemy_rf.current_hp, hp_rf_before,
                         "enemy_rf不应受到AS1伤害")

    def test_as1_no_bonus_without_target_mark(self):
        """AS1(120076) Block1: 无ターゲットmark时无conditional_power_bonus增伤（base damage）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 不施加ターゲットmark

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 无conditional_power_bonus → 不应创建临时dmg_dealt_up buff
        dmg_ups = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_ups), 0, "无ターゲットmark时不应有dmg_dealt_up buff")

    def test_as1_tier1_bonus_with_1_mark(self):
        """AS1(120076) Block1: ターゲットmark=1 → tier1(value=10%)增伤。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=1)

        # 场景1: 1层mark
        result_with_1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_with_1["success"])
        dmg_with_1 = result_with_1.get("total_damage", 0)

        # 场景2: 0层mark（base damage）
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_base = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_base["success"])
        dmg_base = result_base.get("total_damage", 0)

        # 验证: 1层mark → 10%增伤 → 伤害应约为base × 1.10
        self.assertGreater(dmg_with_1, 0, "AS1应造成伤害")
        self.assertGreater(dmg_base, 0, "base damage应>0")
        ratio = dmg_with_1 / dmg_base
        self.assertAlmostEqual(ratio, 1.10, delta=0.05,
                               msg=f"1层ターゲット→10%增伤，实际: {dmg_with_1}/{dmg_base}={ratio:.3f}")

    def test_as1_tier2_bonus_with_2_marks(self):
        """AS1(120076) Block1: ターゲットmark=2 → tier2(value=20%)增伤。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=2)

        result_with_2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_with_2["success"])
        dmg_with_2 = result_with_2.get("total_damage", 0)

        # base damage
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_base = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_base = result_base.get("total_damage", 0)

        # 验证: 2层mark → 20%增伤 → 伤害应约为base × 1.20
        ratio = dmg_with_2 / dmg_base
        self.assertAlmostEqual(ratio, 1.20, delta=0.05,
                               msg=f"2层ターゲット→20%增伤，实际: {dmg_with_2}/{dmg_base}={ratio:.3f}")

    def test_as1_tier3_bonus_with_3_marks(self):
        """AS1(120076) Block1: ターゲットmark=3 → tier3(value=30%)增伤。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=3)

        result_with_3 = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_with_3["success"])
        dmg_with_3 = result_with_3.get("total_damage", 0)

        # base damage
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_base = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_base = result_base.get("total_damage", 0)

        # 验证: 3层mark → 30%增伤 → 伤害应约为base × 1.30
        ratio = dmg_with_3 / dmg_base
        self.assertAlmostEqual(ratio, 1.30, delta=0.05,
                               msg=f"3层ターゲット→30%增伤，实际: {dmg_with_3}/{dmg_base}={ratio:.3f}")

    def test_as1_tier3_caps_at_3_marks_with_5_marks(self):
        """AS1(120076) Block1: ターゲットmark=5(>3) → 仍取tier3(30%)增伤（封顶）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=5)

        result_with_5 = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result_with_5["success"])
        dmg_with_5 = result_with_5.get("total_damage", 0)

        # base damage
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        result_base = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        dmg_base = result_base.get("total_damage", 0)

        # 验证: 5层mark → 仍30%增伤（tier3封顶）
        ratio = dmg_with_5 / dmg_base
        self.assertAlmostEqual(ratio, 1.30, delta=0.05,
                               msg=f"5层ターゲット应封顶在tier3(30%)，实际: {ratio:.3f}")

    def test_as1_block2_burn_with_3_marks(self):
        """AS1(120076) Block2: ターゲットmark>=3 → burn(1action, burn_damage_pct=30)付与。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=3)

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_cf 应被付与 burn debuff
        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        self.assertGreater(len(burns), 0, "3层ターゲット→Block2应施加burn")
        b = burns[0]
        self.assertEqual(b.duration, 1, "burn duration应为1(1action)")
        # burn value = snapshot_atk × burn_damage_pct / 100 = 10000 × 30 / 100 = 3000
        self.assertAlmostEqual(b.value, 3000.0, delta=1.0,
                               msg=f"burn value应为10000×30%=3000，实际: {b.value}")

    def test_as1_block2_no_burn_below_3_marks(self):
        """AS1(120076) Block2: ターゲットmark<3 → 跳过（无burn付与）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._apply_target_mark(self.enemy_cf, count=2)  # <3

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120076, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_cf 不应被付与 burn
        burns = [d for d in self.enemy_cf.debuffs if d.effect_type == CONFLAGRATION]
        self.assertEqual(len(burns), 0, "2层ターゲット(<3)→Block2应跳过，无burn")

