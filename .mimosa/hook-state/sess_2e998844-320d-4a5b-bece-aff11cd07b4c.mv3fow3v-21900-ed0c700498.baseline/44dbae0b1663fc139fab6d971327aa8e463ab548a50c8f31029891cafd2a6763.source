        self._force_crit()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Lv10 → Block2 跳过 → 不应施加 knockout
        knockouts = [d for d in self.enemy_cf.debuffs if d.effect_type == KNOCKOUT]
        self.assertEqual(len(knockouts), 0, "Lv10时即使条件满足也不应施加knockout")

    def test_as2_lv11_knockout_on_crit_with_3_marks(self):
        """AS2(120077) Block2 Lv11+: 暴击 + ターゲットmark>=3 → knockout(1action)付与crit_target。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 11
        self.caster.skill_levels[120077] = 11
        # 预设3个ターゲットmark（在技能执行前已存在）
