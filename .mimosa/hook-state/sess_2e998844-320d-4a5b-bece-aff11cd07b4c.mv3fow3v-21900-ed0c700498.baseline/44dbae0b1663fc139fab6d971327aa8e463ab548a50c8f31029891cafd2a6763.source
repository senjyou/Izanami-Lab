        # enemy_cf (最近) 应受到伤害
        self.assertLess(self.enemy_cf.current_hp, hp_cf_before,
                        "enemy_cf应受到AS2伤害")

    def test_as2_mark_applied_on_crit(self):
        """AS2(120077) Block3: 暴击時 → ターゲットmark付与crit_target(stackable)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._force_crit()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_cf (crit_target) 应被付与 ターゲットmark
        marks = [d for d in self.enemy_cf.debuffs
                 if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks), 1, "暴击时应付与1个ターゲットmark")
        self.assertTrue(marks[0].is_debuff, "ターゲットmark应为debuff")
        self.assertTrue(marks[0].is_stackable, "ターゲットmark应可叠加")
        self.assertEqual(marks[0].duration, -1, "ターゲットmark duration应为-1(永続)")

    def test_as2_no_mark_without_crit(self):
        """AS2(120077) Block3: 非暴击時 → 不付与ターゲットmark（on_crit条件不满足）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._force_no_crit()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_cf 不应被付与 ターゲットmark
        marks = [d for d in self.enemy_cf.debuffs
                 if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks), 0, "非暴击时不应付与ターゲットmark")

    def test_as2_once_per_skill_single_mark(self):
        """AS2(120077) Block3: once_per_skill=true → 单次技能仅付与1个mark。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._force_crit()

        # 执行AS2一次（即使是暴击，也只应付与1个mark）
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120077, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 仅1个ターゲットmark（once_per_skill限制）
        marks = [d for d in self.enemy_cf.debuffs
                 if d.effect_type == MARK and d.name == "ターゲット"]
        self.assertEqual(len(marks), 1,
                         "once_per_skill=true → 单次技能仅付与1个mark")

    def test_as2_lv10_no_knockout(self):
        """AS2(120077) Block2: Lv10时跳过（active_level_min=11 未满足），即使暴击+mark>=3也无knockout。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[120077] = 10
