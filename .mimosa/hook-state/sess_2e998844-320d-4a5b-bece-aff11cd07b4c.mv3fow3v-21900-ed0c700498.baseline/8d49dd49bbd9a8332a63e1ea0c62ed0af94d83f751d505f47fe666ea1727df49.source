# -*- coding: utf-8 -*-
"""验证己方101302 EX 110077「新しき一歩を」攻勢linked buff清理（与敌方版210129同源bug）。"""
import sys, os, logging
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
os.chdir(os.path.join(os.path.dirname(__file__), '..'))

logging.basicConfig(level=logging.WARNING)  # 只看关键输出

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position

bb = BattleBuilder()
# 己方101302（EX=110077）
bb.add_ally(unit_id="c1", position=Position.ALLY_CENTER_FRONT,
            hp=80000, atk=10000, defense=4000, speed=500, skills=[110077], level=10, ap=10, ep=10)
# 敌方1体（被打）
bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT,
             hp=420063, atk=10663, defense=6155, speed=400, skills=[])
ctx = bb.build()
bf, ss = ctx['bf'], ctx['ss']
caster = bf.friend_team[0]

def dump(tag):
    dmgt = [b for b in caster.buffs if b.effect_type == 'ReceivedDamage']
    immune = [b for b in caster.buffs if b.effect_type == 'debuff_immune']
    print(f"{tag}: dmg_taken_down={len(dmgt)}层(合计{sum(b.value for b in dmgt)}%) debuff_immune={len(immune)}个")

for i in range(1, 5):
    ss.execute_skill(caster=caster, skill_id=110077, battlefield=bf, skip_cost=True)
    dump(f"EX{i}后")
