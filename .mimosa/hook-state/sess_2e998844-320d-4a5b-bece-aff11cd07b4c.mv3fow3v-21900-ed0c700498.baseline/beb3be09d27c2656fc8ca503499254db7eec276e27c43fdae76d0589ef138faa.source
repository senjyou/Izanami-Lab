from typing import Dict, Any, List
from ..config.battle_config import BattleConfig
from ..config.battle_setup import BattleSetup, TeamSetup, UnitSetup
from ..config.character_config import CharacterConfig
from ..combat.position import Position, Side
from ..data.data_loader import DataLoader
from ..data.stat_calculator import StatCalculator
from ..entities.memory_card import MemoryCard, MemoryHighlight

class BattleSetupBuilder:
    """战斗启动数据构建器"""
    
    def __init__(self):
        self.data_loader = DataLoader()
        level_lerp_data = self.data_loader.load_level_lerp_data()
        self.stat_calculator = StatCalculator(level_lerp_data)
        
    def build(self, config: BattleConfig) -> BattleSetup:
        """构建战斗启动数据"""
        # 1. 构建己方队伍
        ally_team = self._build_team(Side.ALLY, config.ally_team.units, config.ally_team.memory_cards, config.player_config)
        
        # 2. 构建敌方队伍
        # TODO: 从 config.enemy_team_id 加载敌方配置
        # 暂时创建一个空队伍或测试队伍
        enemy_team = TeamSetup()
        
        return BattleSetup(
            max_turns=config.max_turns,
            ally_team=ally_team,
            enemy_team=enemy_team
        )
        
    def _build_team(self, side: Side, units_config: Dict[Position, CharacterConfig], memory_card_ids: List[int], player_config: Any) -> TeamSetup:
        """构建队伍数据"""
        team_setup = TeamSetup()
        
        # 1. 处理单位
        for pos, char_config in units_config.items():
            # 获取静态数据
            char_data = self.data_loader.get_character(char_config.character_id)
            if not char_data:
                continue
                
            # 计算属性
            stats = self.stat_calculator.calculate_stats(char_config, player_config)
            
            # 创建单位预设
            unit_setup = UnitSetup(
                unit_id=f"{side.name}_{pos.name}",
                character_id=char_config.character_id,
                name=char_data.name,
                side=side,
                position=pos,
                element=char_data.attribute,
                position_type=char_data.position_type,
                stats=stats,
                config=char_config,
                skill_levels=char_config.skill_levels.copy()
            )
            team_setup.units.append(unit_setup)
            
        # 2. 处理回忆卡
        for card_id in memory_card_ids:
            memory_data = self.data_loader.get_memory(card_id)
            if not memory_data:
                continue
            highlights = [
                MemoryHighlight(
                    character_attribute=hl.character_attribute,
                    character_base_master_id=hl.character_base_master_id,
                    character_master_id=hl.character_master_id,
                    character_role=hl.character_role,
                    character_team_master_id=hl.character_team_master_id,
                    character_type=hl.character_type,
                    is_targeting_friendly_party=hl.is_targeting_friendly_party,
                    party_position=hl.party_position,
                    skill_master_id=hl.skill_master_id,
                )
                for hl in memory_data.highlights
            ]
            team_setup.memory_cards.append(MemoryCard(
                card_id=card_id,
                name=memory_data.name,
                description=memory_data.description,
                rarity=memory_data.rarity,
                highlights=highlights,
            ))
            
        # 3. 设置玩家配置
        team_setup.player_config = player_config
            
        return team_setup
