#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""回归测试: add_status（状態異常付与）不算攻击——ルインブースト不得触发被攻撃反応PS

Bug日志: step_crit_console_circle_20261011_130043.txt (L370-410)
  敌方AS ルインブースト(220461) = 自身atk_up/dmg_dealt_up + 敌全体1行動継続ENダメージ
  （add_status action_damage）。实测游戏：该技能「不算作攻击」，不触发
  「他の味方が攻撃される前に発動」(デコイプロトコル 130034) 与
  「自身が攻撃される直前に発動」(鉄壁の母娘 130185)。
  模拟器：纯效果AS预扫描把 add_status 的 enemy_all 目标当作"被攻击目标"，
  before_any_attacked 上下文含全体 → 两个防御PS误触发（各消耗1PP）。

根因: skill_service 纯效果AS预扫描（_pre_scanned_non_damage_enemy_targets）把
  add_status 效果目标计入攻击目标。

Fix: 纯效果AS预扫描排除 add_status（状態異常付与≠攻撃）。デバフ系
  （atk_down/dmg_dealt_down等）维持既有语义仍算攻击
  （120159夏のせいです純効果分支、test_reg_aigis_non_damage_target 锁定）。
  after_as_attacked 等被攻撃反応以 damaged_targets 非空为前提，
  无伤害AS本就走不到，无需修改。

正确行为:
  1. ルインブースト: 防御PS不触发（PP不变、无Guard），但ActionDamage正常付与
  2. プチ・ディメリット(220160, atk/def/spd/crit_down→enemy_all): 防御PS正常触发
"""
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(ROOT))

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import SkillEffectType

RUIN_ID = 220461       # ルインブースト（add_statusのみ）
PETIT_ID = 220160      # プチ・ディメリット（statデバフのみ→enemy_all）
DECOY_ID = 130034      # デコイプロトコル（before_any_attacked, cover+guard, simultaneous_limit）
TEKIPEKI_ID = 130185   # 鉄壁の母娘（before_any_attacked + target_is_self）

GUARD = SkillEffectType.GUARD.value
ACTION_DAMAGE = SkillEffectType.ACTION_DAMAGE.value
SPD_DOWN = SkillEffectType.STATUS_SPEED.value


def _build_battle(enemy_skill_id: int):
    """敌 AS 施法者 + 两名防御PS持有友方（对应实际日志阵容的最小化）"""
    bb = BattleBuilder()
    bb.add_enemy(
        unit_id="caster", hp=5000000, atk=12000, defense=5000,
        speed=1351, element=2, skills=[enemy_skill_id],
    )
    bb.add_ally(
        unit_id="decoy_holder", hp=180669, atk=9000, defense=5000,
        speed=1119, element=1, skills=[DECOY_ID], pp=10,
    )
    bb.add_ally(
        unit_id="guard_holder", hp=190278, atk=9000, defense=5000,
        speed=1179, element=1, skills=[TEKIPEKI_ID], pp=10,
    )
    return bb.build()


def _holder(bf, unit_id):
    return next(u for u in bf.friend_team if u.unit_id == unit_id)


def test_ruin_boost_does_not_trigger_attack_reaction_ps():
    """ルインブースト（add_statusのみ）：防御PS不触发，但DoT正常付与"""
    ctx = _build_battle(RUIN_ID)
    bf, ss = ctx['bf'], ctx['ss']
    caster = next(u for u in bf.enemy_team if u.unit_id == "caster")
    decoy = _holder(bf, "decoy_holder")
    guard = _holder(bf, "guard_holder")

    result = ss.execute_skill(caster=caster, skill_id=RUIN_ID,
                              battlefield=bf, skip_cost=True)
    assert result.get("success"), result

    # 技能本体效果正常：敌全体获得ActionDamage（継続ENダメージ）
    for u in bf.friend_team:
        dots = [d for d in u.debuffs if d.effect_type == ACTION_DAMAGE]
        assert dots, f"{u.unit_id} 应获得ActionDamage（ルインブースト本体效果）"

    # 不算作攻击：两个防御PS均不触发（PP不变、无Guard）
    assert decoy.current_pp == 10, (
        f"デコイプロトコル不应触发（PP被消耗至{decoy.current_pp}）"
    )
    assert guard.current_pp == 10, (
        f"鉄壁の母娘不应触发（PP被消耗至{guard.current_pp}）"
    )
    assert not [b for b in guard.buffs if b.effect_type == GUARD], \
        "鉄壁の母娘不应获得Guard（ルインブースト不算攻击）"


def test_stat_debuff_as_still_triggers_attack_reaction_ps():
    """对照：プチ・ディメリット（statデバフ→enemy_all）仍算攻击，防御PS正常触发"""
    ctx = _build_battle(PETIT_ID)
    bf, ss = ctx['bf'], ctx['ss']
    caster = next(u for u in bf.enemy_team if u.unit_id == "caster")
    guard = _holder(bf, "guard_holder")

    result = ss.execute_skill(caster=caster, skill_id=PETIT_ID,
                              battlefield=bf, skip_cost=True)
    assert result.get("success"), result

    # 减益正常付与
    spd_downs = [d for d in guard.debuffs if d.effect_type == SPD_DOWN]
    assert spd_downs, "プチ・ディメリット应给全体施加spd_down"

    # 减益算攻击：鉄壁の母娘触发（消耗1PP、获得Guard）
    assert [b for b in guard.buffs if b.effect_type == GUARD], \
        "statデバフAS仍算攻击，鉄壁の母娘应触发获得Guard"
    assert guard.current_pp == 9, (
        f"鉄壁の母娘应消耗1PP（实际PP={guard.current_pp}）"
    )
