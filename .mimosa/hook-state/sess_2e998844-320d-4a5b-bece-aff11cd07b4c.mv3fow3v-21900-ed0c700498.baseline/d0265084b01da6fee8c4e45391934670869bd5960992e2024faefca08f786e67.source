"""Regression: 独立guard架势 (230500 ランパートシャッター+ / 130095) 不生效。

Bug: duration_type="attacker_action" 的独立 guard（无cover）走特殊机制
     (unit.guard_active=True)，但 _get_guard_multiplier 仅在 is_cover_damage=True
     时读取 guard_active——guard对普通伤害/HP比例伤害完全不生效；
     且清理端仅在 cover_target is not None 时清理状态，独立guard永不消失。
实例: 心色見つめるムードメーカー 120155 HP比例伤害 vs 鳴滝七彩 230500 guard 50%
     模拟器 48559 (ATK cap截断, guard未生效) vs 实测 28222 (= int(raw×0.5),
     guard在cap之前生效)。
Fix: _get_guard_multiplier 中 guard_active 且无 cover_target 时对所有伤害生效
     （cover附带型130034语义不变：仅cover转移伤害）；
     _cleanup_guard_buffs 清理条件加 guard_active。
"""
import unittest
import sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.skill_data_resolver import SkillDataResolver
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig

_EN_AS = 120001  # generic EN damage AS for testing
_HP_RATIO_AS = 120155  # 心色見つめるムードメーカー AS: 现HP 12.5% 比例伤害, cap=ATK*50%(Lv15)


def _make_unit(side, unit_id, name, skills, level=15, character_type=1,
               hp=100000, atk=10000, defense=2000, position=None):
    if side == Side.ALLY:
        pos = position or Position.ALLY_CENTER_FRONT
    else:
        pos = position or Position.ENEMY_CENTER_FRONT
    skill_levels = {sid: level for sid in skills}
    return UnitState(
        unit_id=unit_id, name=name, side=side,
        position=pos, character_id=999900 + hash(unit_id) % 100, level=level,
        element=2, character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=500,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=10, current_ep=10,
        skills=skills, skill_levels=skill_levels, skill_cooldowns={},
    )


class TestRegStandaloneGuardMechanism(unittest.TestCase):

    def setUp(self):
        self.bb = BattleBuilder()
        self.bb.add_ally(unit_id="dummy", hp=1)  # placeholder
        self.bb.add_enemy(unit_id="dummy_e", hp=1)
        ctx = self.bb.build()
        self.dl = ctx['services']['dl']
        self.ss = ctx['ss']
        self.ts = ctx['ts']
        self.dms = ctx['dms']
        self.resolver = SkillDataResolver(self.dl)

    def _activate_230500_guard(self, guard_owner, attacker):
        """通过 before_any_attacked 触发器激活 230500 guard（返回 PS actions）"""
        bf = BattlefieldState()
        if guard_owner.side == Side.ALLY:
            bf.friend_team = [guard_owner]
            bf.enemy_team = [attacker]
        else:
            bf.friend_team = [attacker]
            bf.enemy_team = [guard_owner]
        actions = self.ts.trigger_before_any_attacked(
            targets=[guard_owner], battlefield=bf, attacker=attacker
        )
        ps_actions = [a for a in actions if a.skill_id == 230500]
        self.assertGreater(len(ps_actions), 0, "230500 should trigger before attack")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps_actions, bf, trigger_timing="before_any_attacked"
        )
        self.assertTrue(guard_owner.guard_active, "guard应激活")
        self.assertEqual(guard_owner.guard_rate, 50.0, "guard值应为tag Lv10=50%")
        return bf

    # ── 1. 乘区语义（单元级） ──────────────────────────────

    def test_standalone_guard_applies_to_all_damage(self):
        """独立guard（guard_standalone=True，如230500）：直接伤害与cover伤害均减伤50%"""
        unit = _make_unit(Side.ENEMY, "e1", "独立guard单位", skills=[])
        unit.guard_active = True
        unit.guard_rate = 50.0
        unit.guard_standalone = True
        self.assertAlmostEqual(self.dms._get_guard_multiplier(unit, is_cover_damage=False), 0.5)
        self.assertAlmostEqual(self.dms._get_guard_multiplier(unit, is_cover_damage=True), 0.5)

    def test_cover_attached_guard_only_for_cover_damage(self):
        """cover附带guard（guard_standalone=False，130034语义）：仅cover转移伤害减伤"""
        unit = _make_unit(Side.ALLY, "a1", "cover单位", skills=[])
        ally = _make_unit(Side.ALLY, "a2", "被保护友方", skills=[])
        unit.guard_active = True
        unit.guard_rate = 50.0
        unit.guard_standalone = False
        unit.cover_target = ally.unit_id
        self.assertAlmostEqual(self.dms._get_guard_multiplier(unit, is_cover_damage=False), 1.0)
        self.assertAlmostEqual(self.dms._get_guard_multiplier(unit, is_cover_damage=True), 0.5)

    # ── 2. 普通伤害路径 E2E ──────────────────────────────

    def test_230500_reduces_normal_damage_by_half(self):
        """230500 独立guard应使普通AS伤害减半（此前guard完全不生效）"""
        attacker = _make_unit(Side.ALLY, "ally_en", "EN攻击者",
                              skills=[_EN_AS], level=15, character_type=2)
        guard_owner = _make_unit(Side.ENEMY, "enemy_guard", "敌方guard持有者",
                                 skills=[230500], level=10)

        # Baseline without guard
        as_data = self.resolver.resolve(_EN_AS, skill_level=15)
        guard_owner.buffs.clear()
        guard_owner.guard_active = False
        guard_owner.guard_rate = 0.0
        base = self.dms.calculate_damage(attacker, guard_owner, as_data).total_damage
        self.assertGreater(base, 0)

        # Guarded
        guard_owner.buffs.clear()
        guard_owner.guard_active = False
        guard_owner.guard_rate = 0.0
        bf = self._activate_230500_guard(guard_owner, attacker)
        guarded = self.dms.calculate_damage(attacker, guard_owner, as_data).total_damage
        expected = base * 0.5
        self.assertAlmostEqual(guarded, expected, delta=expected * 0.1,
                               msg=f"230500 guard应减伤50%: base={base}, "
                                   f"expected~{expected:.0f}, got={guarded}")

    # ── 3. HP比例伤害路径 E2E（本bug实例：guard须在cap之前生效） ──

    def test_230500_guard_applies_before_cap_on_hp_ratio_damage(self):
        """120155 HP比例伤害 vs 230500 guard: guard在ATK cap之前应用

        数值设计: 敌HP=420063, 攻击ATK=80000 → raw=int(420063*12.5%)=52507,
        cap=ATK*50%=40000。无guard时cap截断→40000; 有guard时int(52507*0.5)=26253
        (<cap不再截断)。若错误地在cap之后应用guard会得到int(40000*0.5)=20000，
        可精确区分应用顺序（实测对照: 28222=int(56445.97*0.5), cap=48559.5）。
        """
        caster = _make_unit(Side.ALLY, "ally_caster", "比例伤害施法者",
                            skills=[_HP_RATIO_AS], level=15, atk=80000)
        enemy = _make_unit(Side.ENEMY, "enemy_guard", "敌方guard持有者",
                           skills=[], level=10, hp=420063)

        # Baseline（敌方无PS）: cap 截断生效
        as_data = self.resolver.resolve(_HP_RATIO_AS, skill_level=15)
        eff = [e for blk in as_data.effect_blocks for e in blk.effects
               if e.effect_type == 'hp_ratio_damage'][0]
        self.assertAlmostEqual(eff.value, 12.5, places=2)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        hp0 = enemy.current_hp
        self.ss.execute_skill(caster=caster, skill_id=_HP_RATIO_AS,
                              battlefield=bf, skip_cost=True)
        base_loss = hp0 - enemy.current_hp
        raw = int(enemy.max_hp * eff.value / 100.0)
        self.assertEqual(base_loss, min(raw, 40000),
                         f"无guard时应为min(raw={raw}, cap=40000)")

        # Guarded: 230500 guard 50% 在 cap 之前应用
        caster2 = _make_unit(Side.ALLY, "ally_caster2", "比例伤害施法者",
                             skills=[_HP_RATIO_AS], level=15, atk=80000)
        enemy2 = _make_unit(Side.ENEMY, "enemy_guard2", "敌方guard持有者",
                            skills=[230500], level=10, hp=420063)
        bf2 = self._activate_230500_guard(enemy2, caster2)
        hp1 = enemy2.current_hp
        self.ss.execute_skill(caster=caster2, skill_id=_HP_RATIO_AS,
                              battlefield=bf2, skip_cost=True)
        guarded_loss = hp1 - enemy2.current_hp
        expected = max(1, int(raw * 0.5))
        self.assertEqual(guarded_loss, expected,
                         f"guard应在cap之前应用: expected={expected} "
                         f"(=int(raw {raw}×0.5)), got={guarded_loss}; "
                         f"若为{int(min(raw, 40000) * 0.5)}则说明guard在cap之后应用")

    # ── 4. 清理端 ──────────────────────────────

    def test_standalone_guard_cleared_on_cleanup(self):
        """独立guard状态应在 _cleanup_guard_buffs 时清理（此前永不清理）"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="a1", hp=50000)
        bb.add_enemy(unit_id="e1", hp=50000)
        ctx = bb.build()
        bf, dl = ctx['bf'], ctx['services']['dl']
        ally = bf.friend_team[0]
        enemy = bf.enemy_team[0]
        controller = BattleFlowController(bf, BattleConfig(), data_loader=dl)

        enemy.guard_active = True
        enemy.guard_rate = 50.0  # 独立guard: 无cover_target
        enemy.guard_standalone = True
        controller._cleanup_guard_buffs(ally)
        self.assertFalse(enemy.guard_active, "独立guard应在清理时移除")
        self.assertFalse(enemy.guard_standalone, "standalone标记应一并重置")
        self.assertEqual(enemy.guard_rate, 0.0)

        # cover附带状态清理不受影响（回归保护）
        enemy.guard_active = True
        enemy.guard_rate = 50.0
        enemy.cover_target = "a1"
        controller._cleanup_guard_buffs(ally)
        self.assertFalse(enemy.guard_active)
        self.assertIsNone(enemy.cover_target)


if __name__ == '__main__':
    unittest.main(verbosity=2)
