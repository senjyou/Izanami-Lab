#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""AS技能120057「ストライクリリース」误判为蓄力技能bug修复测试

Bug场景:
- 技能120057「ストライクリリース」: 敵単体の攻撃力を1行動の間低下させる (debuff技能)
- 技能数据: skill_type=1, skill_kind=3, 无features字段
- 旧检测逻辑: is_charge_skill = skill_type==1 and (features&32 or skill_kind==3)
- Bug: skill_kind==3表示debuff技能(如atk_down)，不是蓄力技能
- 修复: 移除skill_kind==3条件，仅使用features&32检测蓄力技能

同时验证真正的蓄力技能120135「溜め技いくよー！」仍正常工作
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, Attribute, CharacterType
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig

ATK_DOWN = SkillEffectType.STATUS_ATTACK.value


def _make_unit(unit_id, name, position, side=Side.ALLY, **kwargs):
    defaults = dict(
        side=side, character_id=999011, level=15,
        element=2, character_type=3,
        max_hp=12000, current_hp=12000,
        attack=6000, defense=4000, speed=400,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=2, initial_passive_point=2, max_extra_point=5,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )
    defaults.update(kwargs)
    return UnitState(unit_id=unit_id, name=name, position=position, **defaults)


class TestChargeSkillDetectionBug(unittest.TestCase):
    """蓄力技能检测bug修复测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.config = BattleConfig()
        self.config.max_turns = 2

    def test_skill_120057_metadata_not_charging(self):
        """测试120057的metadata: features=0, 不应被检测为蓄力技能"""
        meta = self.dl.get_skill_by_id(120057)
        self.assertIsNotNone(meta, "技能120057应存在")
        self.assertEqual(meta.skill_type, 1, "skill_type应为1(AS)")
        self.assertEqual(meta.skill_kind, 3, "skill_kind应为3(debuff)")
        self.assertEqual(
            meta.features & 32, 0,
            f"features不应包含32(RequiresCharging), 实际features={meta.features}"
        )

    def test_skill_120135_metadata_is_charging(self):
        """测试120135「溜め技いくよー！」的metadata: features=32, 应被检测为蓄力技能"""
        meta = self.dl.get_skill_by_id(120135)
        self.assertIsNotNone(meta, "技能120135应存在")
        self.assertEqual(meta.skill_type, 1, "skill_type应为1(AS)")
        self.assertTrue(
            meta.features & 32,
            f"features应包含32(RequiresCharging), 实际features={meta.features}"
        )

    def test_skill_120019_metadata_is_charging(self):
        """测试120019「リリカルブラスト」的metadata: features=32, 应被检测为蓄力技能"""
        meta = self.dl.get_skill_by_id(120019)
        self.assertIsNotNone(meta, "技能120019应存在")
        self.assertEqual(meta.skill_type, 1, "skill_type应为1(AS)")
        self.assertTrue(
            meta.features & 32,
            f"features应包含32(RequiresCharging), 实际features={meta.features}"
        )

    def test_skill_120057_not_detected_as_charge_in_battle(self):
        """
        测试120057在战斗中不被检测为蓄力技能:
        - 施放后应立即执行效果(施加atk_down)
        - 不应进入蓄力状态(is_charging=False)
        """
        # 風紀委員会の策謀家 (持有120057)
        caster = _make_unit(
            "ally_1", "風紀委員会の策謀家", Position.ALLY_CENTER_FRONT,
            character_id=131301, level=15,
            skills=[120057], skill_levels={120057: 15}, skill_cooldowns={},
        )
        enemy = _make_unit(
            "enemy_1", "敌方", Position.ENEMY_CENTER_FRONT,
            side=Side.ENEMY, character_id=999001,
            max_hp=999999, current_hp=999999,
        )

        self.bf.friend_team = [caster]
        self.bf.enemy_team = [enemy]

        controller = BattleFlowController(self.bf, self.config, data_loader=self.dl)
        controller.skill_service.set_battlefield(self.bf)

        # 执行一次行动
        controller._execute_unit_action(caster, 1)

        # 验证: 120057不是蓄力技能，应立即执行
        self.assertFalse(
            caster.is_charging,
            "120057「ストライクリリース」是debuff技能，不应进入蓄力状态"
        )
        self.assertEqual(
            caster.charge_skill_id, 0,
            "120057不应设置charge_skill_id"
        )

        # 验证: 敌方应被施加atk_down debuff
        enemies_with_atk_down = [
            e for e in self.bf.enemy_team
            if any(d.effect_type == ATK_DOWN for d in e.debuffs)
        ]
        self.assertGreaterEqual(
            len(enemies_with_atk_down), 1,
            f"120057应立即执行并对敌方施加atk_down, "
            f"实际debuffs: {[(d.name, d.effect_type) for d in enemy.debuffs]}"
        )

    def test_skill_120135_detected_as_charge_in_battle(self):
        """
        测试120135「溜め技いくよー！」在战斗中被检测为蓄力技能:
        - 施放后应进入蓄力状态(is_charging=True)
        - 不应立即执行效果
        """
        # 创建一个持有120135的角色
        caster = _make_unit(
            "ally_1", "蓄力测试角色", Position.ALLY_CENTER_FRONT,
            character_id=137301, level=15,  # 使用一个可能持有120135的角色ID
            skills=[120135], skill_levels={120135: 15}, skill_cooldowns={},
            current_ap=4, current_pp=4,
        )
        enemy = _make_unit(
            "enemy_1", "敌方", Position.ENEMY_CENTER_FRONT,
            side=Side.ENEMY, character_id=999001,
            max_hp=999999, current_hp=999999,
        )
        # 添加更多敌方单位以构成横一列
        enemy2 = _make_unit(
            "enemy_2", "敌方2", Position.ENEMY_LEFT_FRONT,
            side=Side.ENEMY, character_id=999002,
            max_hp=999999, current_hp=999999,
        )

        self.bf.friend_team = [caster]
        self.bf.enemy_team = [enemy, enemy2]

        controller = BattleFlowController(self.bf, self.config, data_loader=self.dl)
        controller.skill_service.set_battlefield(self.bf)

        # 记录施放前敌方debuff状态
        enemy_debuffs_before = len(enemy.debuffs) + len(enemy2.debuffs)

        # 执行一次行动
        controller._execute_unit_action(caster, 1)

        # 验证: 120135是蓄力技能，应进入蓄力状态
        self.assertTrue(
            caster.is_charging,
            "120135「溜め技いくよー！」是蓄力技能，应进入蓄力状态"
        )
        self.assertEqual(
            caster.charge_skill_id, 120135,
            "120135应设置charge_skill_id=120135"
        )

        # 验证: 蓄力技能不应立即执行效果（敌方不应在本次行动获得凍結debuff）
        enemy_debuffs_after = len(enemy.debuffs) + len(enemy2.debuffs)
        self.assertEqual(
            enemy_debuffs_after, enemy_debuffs_before,
            "120135蓄力中，不应立即对敌方施加debuff"
        )


if __name__ == "__main__":
    unittest.main(verbosity=2)
