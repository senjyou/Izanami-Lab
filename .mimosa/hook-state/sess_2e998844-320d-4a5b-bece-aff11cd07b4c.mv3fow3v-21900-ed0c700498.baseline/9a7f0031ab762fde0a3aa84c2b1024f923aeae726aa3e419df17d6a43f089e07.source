"""_apply_damage_link / _apply_remove_damage_links / 伤害转送 单元测试。

测试目标：
1. _apply_damage_link 本身（DamageLinkEntry施加）
   - 入口检查: 无target_service / value无法解析 / 无alive目标
   - 参数读取: link_mode / duration / duration_type / unremovable
   - value_tag解析
   - link_mode="to_caster" (默认): 每个target(outgoing) + caster(incoming)
   - link_mode="to_primary_target": caster(outgoing) + primary(incoming)
   - link_mode="bidirectional": 共享link_id, 双向
   - 边界: bidirectional需要≥2目标 / to_primary_target需要≥2单位
   - to_caster模式caster自身跳过
   - 返回值结构

2. _resolve_damage_link_targets 索敌
   - 缓存优先
   - 特殊postfilter类型转ALL_PAWNS

3. _apply_remove_damage_links
   - 全部移除 / 指定数量倒序移除 / unremovable也可移除

4. 伤害转送逻辑（_apply_damage 中的 damage_link 块）
   - outgoing方向: 源目标HP回退
   - bidirectional方向: 源目标不回退
   - 盾吸收 (physical_shield / en_shield / 汎用shield)
   - 累计伤害 / damage_taken_total / scoring_tracker
   - transfer_dmg=0跳过 / linker死亡跳过

5. 死亡清除 (_remove_damage_link_from_dead)
   - 死亡者自身全部清除
   - partner_unit_id指向死亡者的清除

6. DoT触发 (_trigger_damage_link_for_dot)
   - DoT链接伤害不被盾吸收
   - outgoing方向HP回退

7. _update_damage_link_durations 持续时间递减
   - action / turn / just_applied跳过 / -1永久
"""
import sys
import os
import unittest
from types import SimpleNamespace
from unittest.mock import MagicMock

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState, DamageLinkEntry
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


# ─── 工厂函数 ──────────────────────────────────────────────

def _make_unit(unit_id, name, side, position, *, hp=50000, atk=10000,
               defense=4000, speed=500, current_hp=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=2, character_type=1,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


def _make_effect(**kwargs):
    """Create a mock effect object with attributes."""
    defaults = {
        'effect_type': 'damage_link',
        'value': 50.0,
        'value_tag': None,
        'target_type': 'self_and_friends',
        'flags': {},
        'target_identifier': None,
        'hit_count': None,
        'condition': None,
        'duration': -1,
        'duration_type': None,
    }
    defaults.update(kwargs)
    obj = type('obj', (object,), defaults)()
    return obj


class _BaseDamageLinkTest(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf, with_target=True):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService() if with_target else None
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        ss._current_skill_id = 120123
        return ss, ts, aus, dms, sts


# ═══════════════════════════════════════════════════════════════════════
# Part 1: _apply_damage_link entry checks
# ═══════════════════════════════════════════════════════════════════════

class TestApplyDamageLinkEntry(_BaseDamageLinkTest):
    """_apply_damage_link: entry checks."""

    def test_no_target_service_returns_none(self):
        """无target_service时返回None。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        bf = _make_bf(caster)
        ss, *_ = self._make_services(bf, with_target=False)

        result = ss._apply_damage_link(caster, _make_effect(), bf)

        self.assertIsNone(result)

    def test_no_value_resolved_returns_none(self):
        """value无法解析时返回None。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)

        # value=None 且 value_tag=None
        effect = _make_effect(value=None, value_tag=None)
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNone(result)

    def test_no_alive_targets_returns_none(self):
        """所有目标都死亡时返回None（caster也死亡）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        # 让caster和target都死亡，确保 _get_candidates_by_type 返回空列表
        caster.is_alive = False
        target.is_alive = False
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)

        # 由于targets_filter为空，targets为空，应返回None
        # 注意：实际_apply_damage_link代码会先获取candidates，
        # candidates依赖bf.get_alive_units(side)，caster死后返回空list
        # targets = [t for t in [] if t.is_alive] = [] → return None
        result = ss._apply_damage_link(caster, _make_effect(), bf)

        self.assertIsNone(result)

    def test_only_caster_alive_returns_empty_applied(self):
        """仅caster存活（其他targets都死亡）时返回非None但applied为空。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        target.is_alive = False
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)

        result = ss._apply_damage_link(caster, _make_effect(), bf)

        # caster自身在to_caster模式被跳过，但代码仍返回非None
        self.assertIsNotNone(result)
        self.assertEqual(len(result['applied']), 0)


# ═══════════════════════════════════════════════════════════════════════
# Part 2: _apply_damage_link parameter reading
# ═══════════════════════════════════════════════════════════════════════

class TestApplyDamageLinkParameters(_BaseDamageLinkTest):
    """参数读取测试。"""

    def test_default_link_mode_is_to_caster(self):
        """link_mode默认为to_caster。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)

        result = ss._apply_damage_link(caster, _make_effect(), bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['link_mode'], 'to_caster')

    def test_explicit_link_mode_bidirectional(self):
        """显式指定link_mode='bidirectional'。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        t2 = _make_unit("t2", "T2", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)
        bf = _make_bf(caster, t1, t2)
        ss, *_ = self._make_services(bf)

        effect = _make_effect(
            target_type='enemy_nearest_and_farthest',
            flags={'link_mode': 'bidirectional'},
        )
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['link_mode'], 'bidirectional')

    def test_default_duration_is_negative_one(self):
        """默认duration=-1（永久）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)

        effect = _make_effect(duration=None)
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['duration'], -1)

    def test_explicit_duration(self):
        """显式指定duration=2。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)

        effect = _make_effect(duration=2)
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['duration'], 2)

    def test_explicit_duration_type(self):
        """显式指定duration_type='action'。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)

        effect = _make_effect(duration=2, duration_type='action')
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['duration_type'], 'action')

    def test_default_duration_type_is_empty_string(self):
        """默认duration_type=''（永久）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)

        result = ss._apply_damage_link(caster, _make_effect(), bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['duration_type'], '')

    def test_unremovable_flag(self):
        """flags.unremovable=True 传递到entry。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        target = _make_unit("target", "T", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, target)
        ss, *_ = self._make_services(bf)

        effect = _make_effect(flags={'unremovable': True})
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertTrue(result['unremovable'])
        # Check entry on target
        outgoing = [dl for dl in target.damage_links if dl.direction == 'outgoing']
        self.assertTrue(all(dl.is_unremovable for dl in outgoing))


# ═══════════════════════════════════════════════════════════════════════
# Part 3: link_mode='to_caster' entries creation
# ═══════════════════════════════════════════════════════════════════════

class TestToCasterLinkMode(_BaseDamageLinkTest):
    """link_mode='to_caster' (default): each target(outgoing) -> caster(incoming)."""

    def test_each_target_gets_outgoing_caster_gets_incoming(self):
        """每个target得到outgoing entry, caster得到incoming entry。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        t2 = _make_unit("t2", "T2", Side.ALLY, Position.ALLY_CENTER_FRONT)
        bf = _make_bf(caster, t1, t2)
        ss, *_ = self._make_services(bf)

        result = ss._apply_damage_link(caster, _make_effect(), bf)

        self.assertIsNotNone(result)
        # t1 gets outgoing
        t1_out = [dl for dl in t1.damage_links if dl.direction == 'outgoing']
        self.assertEqual(len(t1_out), 1)
        self.assertEqual(t1_out[0].partner_unit_id, caster.unit_id)
        # t2 gets outgoing
        t2_out = [dl for dl in t2.damage_links if dl.direction == 'outgoing']
        self.assertEqual(len(t2_out), 1)
        self.assertEqual(t2_out[0].partner_unit_id, caster.unit_id)
        # caster gets 2 incoming (one per target)
        caster_in = [dl for dl in caster.damage_links if dl.direction == 'incoming']
        self.assertEqual(len(caster_in), 2)

    def test_caster_self_skipped_in_to_caster_mode(self):
        """to_caster模式: self_and_friends含caster，但caster自身跳过。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, t1)
        ss, *_ = self._make_services(bf)

        # target_type='self_and_friends' includes caster
        result = ss._apply_damage_link(caster, _make_effect(), bf)

        self.assertIsNotNone(result)
        # caster should NOT have outgoing entry (only incoming from t1)
        caster_out = [dl for dl in caster.damage_links if dl.direction == 'outgoing']
        self.assertEqual(len(caster_out), 0)
        caster_in = [dl for dl in caster.damage_links if dl.direction == 'incoming']
        self.assertEqual(len(caster_in), 1)

    def test_each_link_has_unique_link_id(self):
        """每个link关系有独立的link_id。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        t2 = _make_unit("t2", "T2", Side.ALLY, Position.ALLY_CENTER_FRONT)
        bf = _make_bf(caster, t1, t2)
        ss, *_ = self._make_services(bf)

        ss._apply_damage_link(caster, _make_effect(), bf)

        # Each target has 1 outgoing, caster has 2 incoming
        # link_ids should pair: t1.outgoing.link_id == caster.incoming[0].link_id
        # but each pair should be unique
        t1_link_ids = {dl.link_id for dl in t1.damage_links}
        t2_link_ids = {dl.link_id for dl in t2.damage_links}
        self.assertEqual(len(t1_link_ids), 1)
        self.assertEqual(len(t2_link_ids), 1)
        # t1 and t2 have different link_ids
        self.assertNotEqual(t1_link_ids, t2_link_ids)

    def test_value_propagated_to_entries(self):
        """value正确传递到entries。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, t1)
        ss, *_ = self._make_services(bf)

        effect = _make_effect(value=33.0)
        ss._apply_damage_link(caster, effect, bf)

        t1_out = [dl for dl in t1.damage_links if dl.direction == 'outgoing']
        self.assertEqual(t1_out[0].value, 33.0)

    def test_just_applied_true(self):
        """新施加的entry just_applied=True。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, t1)
        ss, *_ = self._make_services(bf)

        ss._apply_damage_link(caster, _make_effect(), bf)

        for dl in t1.damage_links:
            self.assertTrue(dl.just_applied)
        for dl in caster.damage_links:
            self.assertTrue(dl.just_applied)

    def test_return_structure_to_caster(self):
        """返回值结构正确（to_caster模式）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, t1)
        ss, *_ = self._make_services(bf)

        result = ss._apply_damage_link(caster, _make_effect(), bf)

        self.assertEqual(result['effect_type'], 'damage_link')
        self.assertEqual(result['link_mode'], 'to_caster')
        self.assertEqual(len(result['applied']), 1)
        applied = result['applied'][0]
        self.assertEqual(applied['target_id'], t1.unit_id)
        self.assertEqual(applied['partner_id'], caster.unit_id)
        self.assertEqual(applied['direction'], 'outgoing')
        self.assertEqual(applied['value'], 50.0)


# ═══════════════════════════════════════════════════════════════════════
# Part 4: link_mode='to_primary_target' entries creation
# ═══════════════════════════════════════════════════════════════════════

class TestToPrimaryTargetLinkMode(_BaseDamageLinkTest):
    """link_mode='to_primary_target': caster(outgoing) -> primary(incoming)."""

    def test_caster_outgoing_primary_incoming(self):
        """caster得到outgoing entry, primary得到incoming entry。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        primary = _make_unit("primary", "P", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, primary)
        ss, *_ = self._make_services(bf)
        ss._original_primary_target = primary

        effect = _make_effect(target_type='self_and_primary_target')
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['link_mode'], 'to_primary_target')
        # caster gets outgoing
        caster_out = [dl for dl in caster.damage_links if dl.direction == 'outgoing']
        self.assertEqual(len(caster_out), 1)
        self.assertEqual(caster_out[0].partner_unit_id, primary.unit_id)
        # primary gets incoming
        primary_in = [dl for dl in primary.damage_links if dl.direction == 'incoming']
        self.assertEqual(len(primary_in), 1)
        self.assertEqual(primary_in[0].partner_unit_id, caster.unit_id)

    def test_self_and_primary_target_overrides_link_mode(self):
        """target_type='self_and_primary_target' override link_mode='to_primary_target'。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        primary = _make_unit("primary", "P", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, primary)
        ss, *_ = self._make_services(bf)
        ss._original_primary_target = primary

        # 即使flags.link_mode指定为其他值，target_type=self_and_primary_target时仍override
        effect = _make_effect(
            target_type='self_and_primary_target',
            flags={'link_mode': 'to_caster'},
        )
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['link_mode'], 'to_primary_target')

    def test_no_original_primary_target_returns_none(self):
        """_original_primary_target为None时返回None。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        primary = _make_unit("primary", "P", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, primary)
        ss, *_ = self._make_services(bf)
        ss._original_primary_target = None

        effect = _make_effect(target_type='self_and_primary_target')
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNone(result)

    def test_dead_original_primary_target_returns_none(self):
        """_original_primary_target已死亡时返回None。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        primary = _make_unit("primary", "P", Side.ALLY, Position.ALLY_LEFT_FRONT)
        primary.is_alive = False
        bf = _make_bf(caster, primary)
        ss, *_ = self._make_services(bf)
        ss._original_primary_target = primary

        effect = _make_effect(target_type='self_and_primary_target')
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNone(result)

    def test_shared_link_id_between_caster_and_primary(self):
        """caster和primary共享同一link_id。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        primary = _make_unit("primary", "P", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, primary)
        ss, *_ = self._make_services(bf)
        ss._original_primary_target = primary

        ss._apply_damage_link(caster, _make_effect(target_type='self_and_primary_target'), bf)

        caster_link_ids = {dl.link_id for dl in caster.damage_links}
        primary_link_ids = {dl.link_id for dl in primary.damage_links}
        self.assertEqual(len(caster_link_ids), 1)
        self.assertEqual(len(primary_link_ids), 1)
        self.assertEqual(caster_link_ids, primary_link_ids)


# ═══════════════════════════════════════════════════════════════════════
# Part 5: link_mode='bidirectional' entries creation
# ═══════════════════════════════════════════════════════════════════════

class TestBidirectionalLinkMode(_BaseDamageLinkTest):
    """link_mode='bidirectional': 配对targets, 双向link。"""

    def test_needs_at_least_two_targets(self):
        """bidirectional需要≥2目标，否则返回None。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        bf = _make_bf(caster, t1)
        ss, *_ = self._make_services(bf)

        effect = _make_effect(
            target_type='enemy_nearest_and_farthest',
            flags={'link_mode': 'bidirectional'},
        )
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNone(result)

    def test_each_target_gets_bidirectional_entry(self):
        """每个target得到bidirectional entry, partner为下一个target。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        t2 = _make_unit("t2", "T2", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)
        bf = _make_bf(caster, t1, t2)
        ss, *_ = self._make_services(bf)

        effect = _make_effect(
            target_type='enemy_nearest_and_farthest',
            flags={'link_mode': 'bidirectional'},
        )
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNotNone(result)
        # t1 bidirectional partner = t2
        t1_bidir = [dl for dl in t1.damage_links if dl.direction == 'bidirectional']
        self.assertEqual(len(t1_bidir), 1)
        self.assertEqual(t1_bidir[0].partner_unit_id, t2.unit_id)
        # t2 bidirectional partner = t1 (cyclic % len)
        t2_bidir = [dl for dl in t2.damage_links if dl.direction == 'bidirectional']
        self.assertEqual(len(t2_bidir), 1)
        self.assertEqual(t2_bidir[0].partner_unit_id, t1.unit_id)

    def test_shared_link_id_for_bidirectional_pair(self):
        """配对的bidirectional entries共享同一link_id。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        t2 = _make_unit("t2", "T2", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)
        bf = _make_bf(caster, t1, t2)
        ss, *_ = self._make_services(bf)

        effect = _make_effect(
            target_type='enemy_nearest_and_farthest',
            flags={'link_mode': 'bidirectional'},
        )
        ss._apply_damage_link(caster, effect, bf)

        t1_link_ids = {dl.link_id for dl in t1.damage_links}
        t2_link_ids = {dl.link_id for dl in t2.damage_links}
        self.assertEqual(t1_link_ids, t2_link_ids)
        self.assertEqual(len(t1_link_ids), 1)

    def test_three_targets_cyclic_pairing(self):
        """3个targets时cyclic配对: t1->t2, t2->t3, t3->t1。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        t2 = _make_unit("t2", "T2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        t3 = _make_unit("t3", "T3", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)
        bf = _make_bf(caster, t1, t2, t3)
        ss, *_ = self._make_services(bf)

        effect = _make_effect(
            target_type='enemies',
            flags={'link_mode': 'bidirectional'},
        )
        ss._apply_damage_link(caster, effect, bf)

        # t1 partner = t2 (i=0, (0+1)%3=1)
        t1_p = [dl.partner_unit_id for dl in t1.damage_links if dl.direction == 'bidirectional']
        self.assertEqual(t1_p, [t2.unit_id])
        # t2 partner = t3
        t2_p = [dl.partner_unit_id for dl in t2.damage_links if dl.direction == 'bidirectional']
        self.assertEqual(t2_p, [t3.unit_id])
        # t3 partner = t1 (cyclic)
        t3_p = [dl.partner_unit_id for dl in t3.damage_links if dl.direction == 'bidirectional']
        self.assertEqual(t3_p, [t1.unit_id])


# ═══════════════════════════════════════════════════════════════════════
# Part 6: value_tag resolution
# ═══════════════════════════════════════════════════════════════════════

class TestDamageLinkValueTagResolution(_BaseDamageLinkTest):
    """value_tag解析测试。"""

    def test_value_tag_resolves_to_value(self):
        """value=None + value_tag存在时, 通过_resolve_tag_value_for_caster解析。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, t1)
        ss, *_ = self._make_services(bf)

        # Mock _resolve_tag_value_for_caster
        ss._resolve_tag_value_for_caster = MagicMock(return_value=42.0)

        effect = _make_effect(value=None, value_tag='dmg_link')
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNotNone(result)
        ss._resolve_tag_value_for_caster.assert_called_once()
        # Entry should have value 42.0
        t1_out = [dl for dl in t1.damage_links if dl.direction == 'outgoing']
        self.assertEqual(t1_out[0].value, 42.0)

    def test_value_tag_resolution_returns_none_skips(self):
        """value_tag解析失败返回None时, 跳过。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, t1)
        ss, *_ = self._make_services(bf)

        ss._resolve_tag_value_for_caster = MagicMock(return_value=None)

        effect = _make_effect(value=None, value_tag='dmg_link')
        result = ss._apply_damage_link(caster, effect, bf)

        self.assertIsNone(result)

    def test_explicit_value_takes_precedence_over_value_tag(self):
        """显式value优先于value_tag。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, t1)
        ss, *_ = self._make_services(bf)

        ss._resolve_tag_value_for_caster = MagicMock(return_value=42.0)

        effect = _make_effect(value=99.0, value_tag='dmg_link')
        ss._apply_damage_link(caster, effect, bf)

        # Should NOT call resolver since value is explicit
        ss._resolve_tag_value_for_caster.assert_not_called()
        t1_out = [dl for dl in t1.damage_links if dl.direction == 'outgoing']
        self.assertEqual(t1_out[0].value, 99.0)


# ═══════════════════════════════════════════════════════════════════════
# Part 7: _apply_remove_damage_links
# ═══════════════════════════════════════════════════════════════════════

class TestApplyRemoveDamageLinks(_BaseDamageLinkTest):
    """_apply_remove_damage_links测试。"""

    def test_remove_all_links(self):
        """移除全部links (value=0或None)。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, t1)
        ss, *_ = self._make_services(bf)

        # 先施加2个link
        ss._apply_damage_link(caster, _make_effect(), bf)
        self.assertGreater(len(t1.damage_links), 0)
        self.assertGreater(len(caster.damage_links), 0)

        # 移除自身全部
        effect = _make_effect(
            effect_type='remove_damage_links',
            target_type='self', value=0,
        )
        result = ss._apply_remove_damage_links(caster, effect, bf)

        self.assertIsNotNone(result)
        self.assertEqual(result['effect_type'], 'remove_damage_links')
        self.assertGreaterEqual(result['removed_count'], 1)
        self.assertEqual(len(caster.damage_links), 0)
        # t1的outgoing仍存在（只移除了caster的）
        self.assertGreater(len(t1.damage_links), 0)

    def test_remove_specific_count(self):
        """移除指定数量（倒序）。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        t2 = _make_unit("t2", "T2", Side.ALLY, Position.ALLY_CENTER_FRONT)
        bf = _make_bf(caster, t1, t2)
        ss, *_ = self._make_services(bf)

        # 施加2个link (caster得到2个incoming)
        ss._apply_damage_link(caster, _make_effect(), bf)
        initial_count = len(caster.damage_links)
        self.assertEqual(initial_count, 2)

        # 移除1个
        effect = _make_effect(
            effect_type='remove_damage_links',
            target_type='self', value=1,
        )
        ss._apply_remove_damage_links(caster, effect, bf)

        self.assertEqual(len(caster.damage_links), 1)

    def test_remove_unremovable_links(self):
        """unremovable=True的link也可被remove_damage_links移除。"""
        caster = _make_unit("caster", "C", Side.ALLY, Position.ALLY_LEFT_BACK)
        t1 = _make_unit("t1", "T1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        bf = _make_bf(caster, t1)
        ss, *_ = self._make_services(bf)

        # 施加unremovable link
        effect_apply = _make_effect(flags={'unremovable': True})
        ss._apply_damage_link(caster, effect_apply, bf)
        self.assertTrue(t1.damage_links[0].is_unremovable)

        # 移除全部
        effect_remove = _make_effect(
            effect_type='remove_damage_links',
            target_type='self', value=0,
        )
        ss._apply_remove_damage_links(caster, effect_remove, bf)

        self.assertEqual(len(caster.damage_links), 0)


