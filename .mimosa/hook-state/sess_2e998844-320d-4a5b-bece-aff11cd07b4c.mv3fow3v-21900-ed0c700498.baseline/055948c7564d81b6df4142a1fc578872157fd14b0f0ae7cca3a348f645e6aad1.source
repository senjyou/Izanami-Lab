"""Regression: damage_link transfer must consume linker's shield attack_limited per-hit.

Bug: damage_link transfer was settled as a lump-sum (per-skill), not per-hit.
     This caused incorrect attack_limited shield duration calculation:
     a 4-hit source skill should consume 4 attack_limited from the linker's
     shield, but only consumed 1.

Fix: 
  1. _apply_damage_process_damage_links: process per-hit, each hit independently
     calculates transfer_dmg and absorbs through linker's shield.
  2. execute_skill cleanup: attacked_unit_ids changed from set to dict
     (unit_id -> attack_count). Main damage targets: count=1 (per-skill).
     Damage_link linkers: count=hit_count (per-hit).

Requirements verified:
1. Per-hit: 4-hit source skill → shield attack_limited consumed 4 times
2. Shield expires when attack_limited reaches 0 mid-skill
3. is_sharing=true mode also consumes per-hit
4. damage_link transfer does NOT trigger PS
5. Per-hit shield absorption precision (shield_amount depletes, remaining hits go to HP)
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState, DamageLinkEntry
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

SHIELD = SkillEffectType.SHIELD.value
ATTACK_SKILL = 120041  # 四連突: 4-hit single-target damage skill
ATTACK_HIT_COUNT = 4


def _make_unit(unit_id, name, side, position, *, hp=200000, atk=50000,
               defense=3000, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ep=10):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=15, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=pp, current_ep=ep,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


class TestRegDamageLinkConsumesShieldAttackLimited(unittest.TestCase):
    """damage_link转送伤害应per-hit消耗linker的shield attack_limited。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    def _make_attack_limited_shield(self, unit, source_id, attack_limited=2,
                                    shield_amount=99999):
        """Manually add an attack_limited shield buff (like ドリルミルキィパンチ Lv11+)."""
        buff = BuffState(
            buff_id=f"test_shield_{unit.unit_id}",
            name="テスト盾", effect_type=SHIELD, value=0.0,
            duration=-1, timing_type=0,
            source_unit_id=source_id,
            source_skill_id=110030,
            is_debuff=False, is_stackable=True, is_memory_buff=False,
            attack_limited=attack_limited,
            shield_amount=shield_amount,
        )
        unit.buffs.append(buff)
        unit.shield = shield_amount
        return buff

    def _make_damage_link(self, source_unit, partner_unit, value=50.0,
                          is_sharing=True, direction="outgoing"):
        """Manually add a DamageLinkEntry (like 少しお行儀悪いですが…… Block4)."""
        entry = DamageLinkEntry(
            link_id=f"test_link_{source_unit.unit_id}_{partner_unit.unit_id}",
            partner_unit_id=partner_unit.unit_id,
            value=value,
            source_skill_id=110071,
            source_unit_id=source_unit.unit_id,
            direction=direction,
            is_unremovable=True,
            is_sharing=is_sharing,
            duration=-1,
            duration_type="",
            just_applied=False,
        )
        source_unit.damage_links.append(entry)
        return entry

    def test_per_hit_consumes_shield_4_hits(self):
        """4-hit源技能应per-hit消耗linker的shield attack_limited (4→0)。

        120041「四連突」是4-hit技能，每hit的链接伤害都是一次独立攻击。
        shield attack_limited=4 → 4-4=0，盾应在技能结束后消失。
        """
        ally_target = _make_unit("ally_target", "被リンク者", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=500000, atk=10000)
        enemy_linker = _make_unit("enemy_linker", "リンク先", Side.ENEMY,
                                  Position.ENEMY_RIGHT_FRONT, hp=500000, atk=10000)
        enemy_attacker = _make_unit("enemy_attacker", "攻撃者", Side.ENEMY,
                                   Position.ENEMY_CENTER_FRONT, hp=200000, atk=50000,
                                   skills=[ATTACK_SKILL],
                                   skill_levels={ATTACK_SKILL: 15})

        self._make_attack_limited_shield(enemy_linker, enemy_linker.unit_id,
                                         attack_limited=ATTACK_HIT_COUNT,
                                         shield_amount=99999)
        self._make_damage_link(ally_target, enemy_linker, value=50.0,
                               is_sharing=True, direction="outgoing")

        bf = BattlefieldState()
        bf.friend_team = [ally_target]
        bf.enemy_team = [enemy_attacker, enemy_linker]
        ss, _ = self._make_services(bf)

        ss.execute_skill(enemy_attacker, ATTACK_SKILL, bf, skip_cost=True)

        # 4 hits → attack_limited 4→0，盾消失
        shield_buffs = [b for b in enemy_linker.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_buffs), 0,
                         "Shield应在4次per-hit消耗后消失 (attack_limited 4→0)")

    def test_shield_expires_mid_skill_when_attack_limited_reaches_zero(self):
        """shield attack_limited=2，4-hit技能：盾在前2hit消耗后消失，
        后2hit的链接伤害直接扣HP。"""
        ally_target = _make_unit("ally_target", "被リンク者", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=500000, atk=10000)
        enemy_linker = _make_unit("enemy_linker", "リンク先", Side.ENEMY,
                                  Position.ENEMY_RIGHT_FRONT, hp=500000, atk=10000)
        enemy_attacker = _make_unit("enemy_attacker", "攻撃者", Side.ENEMY,
                                   Position.ENEMY_CENTER_FRONT, hp=200000, atk=50000,
                                   skills=[ATTACK_SKILL],
                                   skill_levels={ATTACK_SKILL: 15})

        self._make_attack_limited_shield(enemy_linker, enemy_linker.unit_id,
                                         attack_limited=2, shield_amount=99999)
        self._make_damage_link(ally_target, enemy_linker, value=50.0,
                               is_sharing=True, direction="outgoing")

        bf = BattlefieldState()
        bf.friend_team = [ally_target]
        bf.enemy_team = [enemy_attacker, enemy_linker]
        ss, _ = self._make_services(bf)

        linker_hp_before = enemy_linker.current_hp

        ss.execute_skill(enemy_attacker, ATTACK_SKILL, bf, skip_cost=True)

        # 4 hits → attack_limited 2→0 (consumed 2, then clamped at 0)
        shield_buffs = [b for b in enemy_linker.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_buffs), 0,
                         "Shield应在2次per-hit消耗后消失 (attack_limited 2→0, 剩余2hit直接扣HP)")

    def test_two_skills_consume_shield_8_hits(self):
        """连续两次4-hit技能，shield attack_limited=8 → 8→4→0。"""
        ally_target = _make_unit("ally_target", "被リンク者", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=500000, atk=10000)
        enemy_linker = _make_unit("enemy_linker", "リンク先", Side.ENEMY,
                                  Position.ENEMY_RIGHT_FRONT, hp=500000, atk=10000)
        enemy_attacker = _make_unit("enemy_attacker", "攻撃者", Side.ENEMY,
                                   Position.ENEMY_CENTER_FRONT, hp=200000, atk=50000,
                                   skills=[ATTACK_SKILL],
                                   skill_levels={ATTACK_SKILL: 15})

        self._make_attack_limited_shield(enemy_linker, enemy_linker.unit_id,
                                         attack_limited=8, shield_amount=99999)
        self._make_damage_link(ally_target, enemy_linker, value=50.0,
                               is_sharing=True, direction="outgoing")

        bf = BattlefieldState()
        bf.friend_team = [ally_target]
        bf.enemy_team = [enemy_attacker, enemy_linker]
        ss, _ = self._make_services(bf)

        # 第一次4-hit攻击
        ss.execute_skill(enemy_attacker, ATTACK_SKILL, bf, skip_cost=True)
        shield_after_1 = [b for b in enemy_linker.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_after_1), 1, "Shield应仍存在 (8→4)")
        self.assertEqual(shield_after_1[0].attack_limited, 4,
                         "attack_limited应从8减为4 (4 hits)")

        # 第二次4-hit攻击
        ss.execute_skill(enemy_attacker, ATTACK_SKILL, bf, skip_cost=True)
        shield_after_2 = [b for b in enemy_linker.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_after_2), 0,
                         "Shield应在第2次4-hit后消失 (attack_limited 4→0)")

    def test_is_sharing_mode_consumes_shield_per_hit(self):
        """is_sharing=true (伤害共有) 模式也应per-hit消耗shield attack_limited。"""
        ally_target = _make_unit("ally_target", "被リンク者", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=500000, atk=10000)
        enemy_linker = _make_unit("enemy_linker", "リンク先", Side.ENEMY,
                                  Position.ENEMY_RIGHT_FRONT, hp=500000, atk=10000)
        enemy_attacker = _make_unit("enemy_attacker", "攻撃者", Side.ENEMY,
                                   Position.ENEMY_CENTER_FRONT, hp=200000, atk=50000,
                                   skills=[ATTACK_SKILL],
                                   skill_levels={ATTACK_SKILL: 15})

        self._make_attack_limited_shield(enemy_linker, enemy_linker.unit_id,
                                         attack_limited=4, shield_amount=99999)
        self._make_damage_link(ally_target, enemy_linker, value=50.0,
                               is_sharing=True, direction="outgoing")

        bf = BattlefieldState()
        bf.friend_team = [ally_target]
        bf.enemy_team = [enemy_attacker, enemy_linker]
        ss, _ = self._make_services(bf)

        ss.execute_skill(enemy_attacker, ATTACK_SKILL, bf, skip_cost=True)

        shield_buffs = [b for b in enemy_linker.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_buffs), 0,
                         "is_sharing=true时shield也应在4次per-hit消耗后消失")

    def test_damage_link_transfer_does_not_trigger_ps(self):
        """damage_link转送本身不应触发任何PS技能。

        验证: linker仅通过damage_link转送承受伤害时，
        after_as_attacked / after_ally_attacked 等PS不应被触发。
        """
        ally_target = _make_unit("ally_target", "被リンク者", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=500000, atk=10000)
        enemy_linker = _make_unit("enemy_linker", "リンク先", Side.ENEMY,
                                  Position.ENEMY_RIGHT_FRONT, hp=500000, atk=10000)
        enemy_attacker = _make_unit("enemy_attacker", "攻撃者", Side.ENEMY,
                                   Position.ENEMY_CENTER_FRONT, hp=200000, atk=50000,
                                   skills=[ATTACK_SKILL],
                                   skill_levels={ATTACK_SKILL: 15})

        self._make_attack_limited_shield(enemy_linker, enemy_linker.unit_id,
                                         attack_limited=4, shield_amount=99999)
        self._make_damage_link(ally_target, enemy_linker, value=50.0,
                               is_sharing=True, direction="outgoing")

        bf = BattlefieldState()
        bf.friend_team = [ally_target]
        bf.enemy_team = [enemy_attacker, enemy_linker]
        ss, ts = self._make_services(bf)

        enemy_linker_pp_before = enemy_linker.current_pp

        ss.execute_skill(enemy_attacker, ATTACK_SKILL, bf, skip_cost=True)

        self.assertEqual(enemy_linker.current_pp, enemy_linker_pp_before,
                         "linker的PP不应因damage_link转送而变化 (PS未触发)")

    def test_per_hit_shield_absorption_precision(self):
        """per-hit盾吸收精度：shield_amount有限时，盾值在前几hit耗尽，
        后续hit直接扣HP（验证per-hit独立盾吸收）。

        场景：4-hit技能，每hit transfer_dmg=5000，linker盾 shield_amount=10000
        - hit1: 盾吸收5000, shield_amount=5000
        - hit2: 盾吸收5000, shield_amount=0
        - hit3: 盾已耗尽，5000直接扣HP
        - hit4: 盾已耗尽，5000直接扣HP
        总HP损失 = 5000+5000 = 10000
        """
        ally_target = _make_unit("ally_target", "被リンク者", Side.ALLY,
                                Position.ALLY_CENTER_FRONT, hp=500000, atk=10000)
        enemy_linker = _make_unit("enemy_linker", "リンク先", Side.ENEMY,
                                  Position.ENEMY_RIGHT_FRONT, hp=500000, atk=10000)
        enemy_attacker = _make_unit("enemy_attacker", "攻撃者", Side.ENEMY,
                                   Position.ENEMY_CENTER_FRONT, hp=200000, atk=50000,
                                   skills=[ATTACK_SKILL],
                                   skill_levels={ATTACK_SKILL: 15})

        # shield_amount=10000, attack_limited=99 (不会因次数耗尽)
        self._make_attack_limited_shield(enemy_linker, enemy_linker.unit_id,
                                         attack_limited=99, shield_amount=10000)
        self._make_damage_link(ally_target, enemy_linker, value=50.0,
                               is_sharing=True, direction="outgoing")

        bf = BattlefieldState()
        bf.friend_team = [ally_target]
        bf.enemy_team = [enemy_attacker, enemy_linker]
        ss, _ = self._make_services(bf)

        linker_hp_before = enemy_linker.current_hp

        ss.execute_skill(enemy_attacker, ATTACK_SKILL, bf, skip_cost=True)

        # 盾吸收了前2hit (10000/5000=2), 后2hit直接扣HP
        # linker HP应减少 (后2hit的transfer_dmg)
        hp_loss = linker_hp_before - enemy_linker.current_hp
        self.assertGreater(hp_loss, 0,
                          "盾耗尽后后续hit应直接扣HP (per-hit独立盾吸收)")

        # 盾值应为0 (已耗尽)
        self.assertEqual(enemy_linker.shield, 0,
                        "盾值应在per-hit吸收后耗尽为0")


if __name__ == '__main__':
    unittest.main()
