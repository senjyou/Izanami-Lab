# -*- coding: utf-8 -*-
"""解析rdps track日志：统计card 30042归因分布 vs 逐事件解析真实边际"""
import re, os

LOG = os.path.join(os.path.dirname(__file__), "rdps_track_30042.log")
with open(LOG, "r", encoding="utf-8") as f:
    lines = f.readlines()

# 事件状态机
attr = {"atk": 0.0, "crit_rate": 0.0, "other": 0.0}
cur_pool = None
cur_event = {"type": None, "attacker": None, "dmg": 0.0, "m_base_diff": 1.0,
             "bbd": 0.0, "eff": 1.0, "crit": False}
ev_list = []
re_event = re.compile(r"--- RDPS Track #\d+ \[(\w+)\] ---")
re_attacker = re.compile(r"^\s*\S+ \((F_\d+)\) ->")
re_damage = re.compile(r"Damage: ([\d.]+)")
re_zones = re.compile(r"m_base_diff=([\d.]+) m_dealt=([\d.]+) m_received=([\d.]+) m_crit_dmg=([\d.]+)")
re_baseline = re.compile(r"baseline_base_diff")
re_pool_header = re.compile(r"\[buff_attr\] effect_type=(\w+)")
re_card = re.compile(r"-> card 30042 \+= ([\d.]+)")

for ln in lines:
    m = re_event.search(ln)
    if m:
        cur_event = {"type": m.group(1), "attacker": None, "dmg": 0.0,
                     "m_base_diff": 1.0, "bbd": 0.0, "eff": 1.0}
        continue
    m = re_attacker.match(ln)
    if m and cur_event["attacker"] is None:
        cur_event["attacker"] = m.group(1)
        continue
    m = re_damage.search(ln)
    if m and cur_event["dmg"] == 0.0:
        cur_event["dmg"] = float(m.group(1))
        continue
    m = re_zones.search(ln)
    if m:
        cur_event["m_base_diff"] = float(m.group(1))
        cur_event["eff"] = float(m.group(4))  # 仅近似（m_crit_dmg=eff/bcf）
        continue
    m = re.search(r"\[actual\] ([\d.]+) \| crit=(\w+) eff_crit_f=([\d.]+)", ln)
    if m:
        cur_event["dmg"] = float(m.group(1))
        cur_event["crit"] = m.group(2) == "True"
        cur_event["eff"] = float(m.group(3))
        continue
    m = re.search(r"\[baseline\] .*?base_diff=(\d+)", ln)
    if m:
        cur_event["bbd"] = float(m.group(1))
        continue
    m = re_pool_header.search(ln)
    if m:
        cur_pool = m.group(1)
        continue
    m = re_card.search(ln)
    if m:
        v = float(m.group(1))
        if cur_pool == "StatusAttack":
            attr["atk"] += v
        elif cur_pool == "StatusCriticalChance":
            attr["crit_rate"] += v
        else:
            attr["other"] += v

print(f"card 30042 归因分布: ATK通道={attr['atk']:.0f}  暴击率通道={attr['crit_rate']:.0f}  其他={attr['other']:.0f}  合计={sum(attr.values()):.0f}")

# 解析真实边际（逐事件）
FRONT = {"F_100303", "F_132301"}
BACK = {"F_145301", "F_112302", "F_111301"}
true_atk = 0.0
true_crit = 0.0
for ev in ev_list:
    pass
# 重跑一遍事件收集
events = []
cur = None
for ln in lines:
    m = re_event.search(ln)
    if m:
        if cur: events.append(cur)
        cur = {"type": m.group(1), "attacker": None, "dmg": 0.0, "crit": False,
               "eff": 1.0, "m_bd": 1.0, "bbd": 0.0}
        continue
    if cur is None: continue
    m = re_attacker.match(ln)
    if m and cur["attacker"] is None:
        cur["attacker"] = m.group(1); continue
    m = re.search(r"\[actual\] ([\d.]+) \| crit=(\w+) eff_crit_f=([\d.]+)", ln)
    if m:
        cur["dmg"] = float(m.group(1)); cur["crit"] = m.group(2) == "True"
        cur["eff"] = float(m.group(3)); continue
    m = re.search(r"\[baseline\] .*?base_diff=(\d+)", ln)
    if m:
        cur["bbd"] = float(m.group(1)); continue
    m = re_zones.search(ln)
    if m:
        cur["m_bd"] = float(m.group(1)); continue
if cur: events.append(cur)

for ev in events:
    if ev["type"] != "main" or ev["dmg"] <= 0:
        continue
    a = ev["attacker"]
    if a in FRONT:
        # 400258: +1250 flat ATK -> Δbase_diff=1250（线性），Δdmg = dmg_nc × 1250/actual_bd × eff
        actual_bd = ev["m_bd"] * ev["bbd"]
        if actual_bd > 0:
            true_atk += ev["dmg"] * 1250.0 / actual_bd
    elif a in BACK:
        # 400259: +2% crit rate，真实边际 = actual_nc × (eff-1) × 0.02
        if ev["eff"] > 1.0:
            true_crit += ev["dmg"] * (1.0 - 1.0 / ev["eff"]) * 0.02

print(f"\n解析真实边际（同一战斗，hold RNG）:")
print(f"  400258 ATK+1250(前衛直伤): {true_atk:.0f}")
print(f"  400259 暴击+2%(後衛直伤):  {true_crit:.0f}")
print(f"  合计: {true_atk+true_crit:.0f}")
print(f"\n捕获率: ATK={attr['atk']/max(1,true_atk)*100:.1f}%  暴击率={attr['crit_rate']/max(1,true_crit)*100:.1f}%")
