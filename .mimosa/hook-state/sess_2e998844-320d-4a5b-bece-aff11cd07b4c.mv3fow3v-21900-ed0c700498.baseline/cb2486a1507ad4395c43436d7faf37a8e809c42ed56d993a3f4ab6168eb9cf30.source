#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""回归测试: ファストジャッジ(230493)被跳过block的enemy_all目标不得驱动防御PS误触发

Bug日志: step_crit_console_circle_20261011_123450.txt (L202-228)
  敌方PS ファストジャッジ(230493) Block1 damage→enemy_single_highest_spd
  选中速度最快的隣歩む想い(spd=1223)；Block2(spd_down/skill_power_down→enemy_all)
  条件 prev_target_element_advantage 不成立（水2 vs 風3）被跳过。
  但非伤害敌方目标预扫描未排除该block，其enemy_all目标(其余4名友方)被合并进
  all_block_targets，繋がり合う母娘の絆 的 鉄壁の母娘(130185, before_any_attacked
  + target_is_self) 在自身未被攻击时误触发（消耗1PP并获得75% Guard）。

根因: skill_service.execute_skill 非伤害敌方效果目标预扫描循环未调用
  _is_block_definitely_skipped 过滤（cover候选预扫描与纯效果AS路径均有此过滤），
  且该函数不支持 prev_target_element_advantage 判定。

Fix: 非伤害预扫描循环补充 _is_block_definitely_skipped 过滤；该函数新增
  prev_target_element_advantage 分支（用预扫描主目标镜像执行期判定）。

正确行为:
  1. 属性有利不成立 → Block2被跳过 → 非伤害目标不计入 → 鉄壁の母娘不触发
  2. 属性有利成立   → Block2执行(enemy_all减速) → 全体视为被攻击 → 鉄壁の母娘触发
"""
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(ROOT))

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import SkillEffectType

FASTJUDGE_ID = 230493
TEKIPEKI_ID = 130185  # 鉄壁の母娘

GUARD = SkillEffectType.GUARD.value
SPD_DOWN = SkillEffectType.STATUS_SPEED.value


def _build_battle(caster_element: int, target_element: int):
    """构造最小战场：敌方施法者 + 最速目标(承受Block1伤害) + 鉄壁の母娘持有者。

    caster_element=2(水) vs target_element=3(風) → 属性有利不成立（复现bug）
    caster_element=4(土) vs target_element=2(水) → 属性有利成立（正例）
    """
    bb = BattleBuilder()
    bb.add_enemy(
        unit_id="caster", hp=5000000, atk=12000, defense=5000,
        speed=1351, element=caster_element, skills=[FASTJUDGE_ID],
    )
    bb.add_ally(
        unit_id="fast_target", hp=144332, atk=10000, defense=5000,
        speed=1223, element=target_element,
    )
    bb.add_ally(
        unit_id="ps_holder", hp=190278, atk=9000, defense=5000,
        speed=1179, element=1, skills=[TEKIPEKI_ID], pp=10,
    )
    return bb.build()


def test_skipped_block2_targets_do_not_trigger_tekipeki():
    """属性有利不成立时：Block2被跳过，其enemy_all目标不驱动鉄壁の母娘触发"""
    ctx = _build_battle(caster_element=2, target_element=3)
    bf, ss = ctx['bf'], ctx['ss']
    caster = next(u for u in bf.enemy_team if u.unit_id == "caster")
    fast_target = next(u for u in bf.friend_team if u.unit_id == "fast_target")
    ps_holder = next(u for u in bf.friend_team if u.unit_id == "ps_holder")

    result = ss.execute_skill(caster=caster, skill_id=FASTJUDGE_ID,
                              battlefield=bf, skip_cost=True)
    assert result.get("success"), result

    # Block1伤害命中速度最快的目标
    assert fast_target.current_hp < fast_target.max_hp, "Block1应命中最速单位fast_target"

    # 鉄壁の母娘持有者未被攻击：不消耗PP、不获得Guard
    assert ps_holder.current_pp == 10, (
        f"鉄壁の母娘不应触发（PP被消耗至{ps_holder.current_pp}）"
    )
    guard_buffs = [b for b in ps_holder.buffs if b.effect_type == GUARD]
    assert not guard_buffs, "未被攻击的鉄壁の母娘持有者不应获得Guard"

    # Block2被跳过：无任何友方获得spd_down
    for u in bf.friend_team:
        spd_downs = [d for d in u.debuffs if d.effect_type == SPD_DOWN]
        assert not spd_downs, f"{u.unit_id} 不应获得spd_down（Block2已跳过）"


def test_advantage_block2_targets_trigger_tekipeki():
    """属性有利成立时：Block2执行，enemy_all目标视为被攻击，鉄壁の母娘正常触发"""
    ctx = _build_battle(caster_element=4, target_element=2)
    bf, ss = ctx['bf'], ctx['ss']
    caster = next(u for u in bf.enemy_team if u.unit_id == "caster")
    ps_holder = next(u for u in bf.friend_team if u.unit_id == "ps_holder")

    result = ss.execute_skill(caster=caster, skill_id=FASTJUDGE_ID,
                              battlefield=bf, skip_cost=True)
    assert result.get("success"), result

    # 鉄壁の母娘触发：消耗1PP并获得Guard（减速debuff目标=被攻击，符合仕様）
    guard_buffs = [b for b in ps_holder.buffs if b.effect_type == GUARD]
    assert guard_buffs, "Block2执行的enemy_all目标应触发鉄壁の母娘获得Guard"
    assert ps_holder.current_pp == 9, (
        f"鉄壁の母娘应消耗1PP（实际PP={ps_holder.current_pp}）"
    )
    # Block2执行：全体友方获得spd_down
    spd_downs = [d for d in ps_holder.debuffs if d.effect_type == SPD_DOWN]
    assert spd_downs, "Block2执行时ps_holder应获得spd_down"
