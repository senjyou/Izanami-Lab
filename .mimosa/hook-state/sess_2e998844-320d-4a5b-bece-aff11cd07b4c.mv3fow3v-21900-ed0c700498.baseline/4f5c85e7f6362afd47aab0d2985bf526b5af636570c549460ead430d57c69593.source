# -*- coding: utf-8 -*-
"""验证敌方381305「惨禍：鳴滝七彩」210129 EX的「攻勢」linked buff清理是否完整。

流程：
1. 敌方EX第1次（非攻勢）→ 应获得: 攻勢mark + debuff_immune + dmg_taken_down
2. 敌方EX第2次（攻勢状态）→ 敌全体攻击 + remove_mark「攻勢」
3. 检查 remove_mark 后 dmg_taken_down / debuff_immune 是否残留
"""
import sys, os, logging
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
os.chdir(os.path.join(os.path.dirname(__file__), '..'))

logging.basicConfig(level=logging.INFO, format='%(levelname)s %(name)s: %(message)s')

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position

bb = BattleBuilder()
# 玩家1体（被打）
bb.add_ally(unit_id="p1", position=Position.ALLY_CENTER_FRONT,
            hp=200000, atk=12000, defense=5000, speed=400, skills=[])
# 敌方381305（EX=210129），AP给足（EX cost 6）
bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT,
             hp=420063, atk=10663, defense=6155, speed=552,
             skills=[210129], level=10, ap=10, ep=10)
ctx = bb.build()
bf, ss = ctx['bf'], ctx['ss']
enemy = bf.enemy_team[0]

def dump_buffs(tag):
    print(f"\n===== {tag} =====")
    for b in enemy.buffs:
        print(f"  [buff ] {b.effect_type:20s} name={b.name!r} val={b.value} dur={b.duration} "
              f"stack={getattr(b, 'stackable', None)} linked={getattr(b, 'linked_buff_id', '')!r} id={b.buff_id[:8]}")
    for d in enemy.debuffs:
        print(f"  [debuf] {d.effect_type:20s} name={d.name!r} val={d.value} dur={d.duration} "
              f"linked={getattr(d, 'linked_buff_id', '')!r} id={d.buff_id[:8]}")
    marks = [b for b in enemy.buffs + enemy.debuffs if b.effect_type == 'mark']
    dmgt = [b for b in enemy.buffs if b.effect_type == 'dmg_taken_down']
    print(f"  >>> 攻勢mark: {len(marks)} 个, dmg_taken_down: {len(dmgt)} 层 (总减伤 {sum(b.value for b in dmgt)}%)")

# 第1次EX（非攻勢 → 获得攻勢）
print("\n########## EX 第1次（非攻勢→获得攻勢） ##########")
r1 = ss.execute_skill(caster=enemy, skill_id=210129, battlefield=bf, skip_cost=True)
print("result:", r1.get('status') if isinstance(r1, dict) else r1)
dump_buffs("EX1 后")

# 第2次EX（攻勢状态 → 攻击+移除攻勢）
print("\n########## EX 第2次（攻勢状态→攻击+解除攻勢） ##########")
r2 = ss.execute_skill(caster=enemy, skill_id=210129, battlefield=bf, skip_cost=True)
print("result:", r2.get('status') if isinstance(r2, dict) else r2)
dump_buffs("EX2 后（关键检查点：dmg_taken_down 应为0层）")

# 第3次EX（又应获得1层攻勢）
print("\n########## EX 第3次（非攻勢→再获得攻勢） ##########")
r3 = ss.execute_skill(caster=enemy, skill_id=210129, battlefield=bf, skip_cost=True)
print("result:", r3.get('status') if isinstance(r3, dict) else r3)
dump_buffs("EX3 后（预期：减伤仅1层=35%；若bug则2层=70%）")

# 第4次EX
print("\n########## EX 第4次（攻勢→攻击+解除） ##########")
r4 = ss.execute_skill(caster=enemy, skill_id=210129, battlefield=bf, skip_cost=True)
dump_buffs("EX4 后（预期：0层；若bug则1层=35%残留）")
