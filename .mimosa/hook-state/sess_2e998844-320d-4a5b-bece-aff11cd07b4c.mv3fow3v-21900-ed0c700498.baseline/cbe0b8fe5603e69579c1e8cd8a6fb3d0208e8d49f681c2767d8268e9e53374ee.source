#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""回归测试: dmg_taken_down_threshold 低于阈值未减伤时不消耗hit_limited

Bug (实战验证, step_crit_console_tactical_20260819_135822.txt):
  L11275: アニス・ベネット获得减伤buff (hit_limited=3)
  L11331: 受击减伤 509034→254517, hit_limited 3→2
  L11462: 受击减伤 252829→126414, hit_limited 2→1
  L11467: add_damage 24917 <= threshold 38816, no reduction
  L11468: 但仍消耗 hit_limited 1→0, buff被移除  ← 错误
  L11614: 最后一次レバッ！ 4hit全无减伤
          第1hit 181058（期望减伤至90529 = 181058×50%）

实战正确行为: 低于阈值未触发减伤的受击不消耗次数。L11467不消耗则buff
  保留1次, 最后一次レバッ！第1hit触发减伤 181058→90529。

Fix: 三条伤害路径的hit_limited消耗均绑定"实际触发减伤":
  - damage_service.calculate_damage (damage路径)
  - skill_service._apply_hp_ratio_damage (hp_ratio_damage路径)
  - skill_service._process_enchant_damage_for_target (add_damage路径)
"""
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

DMG_TAKEN_DOWN_THRESHOLD = "dmg_taken_down_threshold"

_dl = None


def _get_dl():
    global _dl
    if _dl is None:
        _dl = DataLoader()
        _dl.load_all()
    return _dl


def _make_unit(unit_id, side, max_hp, hp, atk, defense=4000):
    pos = Position.ALLY_LEFT_BACK if side == Side.ALLY else Position.ENEMY_CENTER_BACK
    return UnitState(
        unit_id=unit_id, name=unit_id, side=side, position=pos,
        character_id=999901 if side == Side.ALLY else 999001,
        level=10, element=2, character_type=1,
        max_hp=max_hp, current_hp=hp, attack=atk, defense=defense, speed=500,
        crit_rate=0.0, crit_damage=50.0, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=10, current_pp=10, current_ep=0,
    )


def _make_dtd_buff(hit_limited=3, value=50, threshold_pct=2):
    return BuffState(
        buff_id="test_dtd", name=DMG_TAKEN_DOWN_THRESHOLD,
        effect_type=DMG_TAKEN_DOWN_THRESHOLD,
        value=value, duration=-1, timing_type=2,
        is_debuff=False, is_stackable=False, value_tag=0,
        hit_limited=hit_limited,
        threshold_pct=threshold_pct,
        threshold_base="current_hp",
    )


def _make_add_damage_buff(value=15, caster_attack=112517, source_id="a1"):
    return BuffState(
        buff_id="test_add_dmg", name="AddDamage",
        effect_type="AddDamage",
        value=value, duration=-1, timing_type=2,
        is_debuff=False, is_stackable=False, value_tag=0,
        caster_attack=caster_attack,
        source_unit_id=source_id,
    )


def _make_effect(value=12.5, cap_atk_pct=50):
    return type('obj', (object,), {
        'effect_type': 'hp_ratio_damage', 'value': value, 'value_tag': None,
        'value_source': 'target_current_hp', 'target_type': 'enemy_single',
        'flags': {'damage_cap_atk_pct': cap_atk_pct}, 'target_identifier': None,
        'hit_count': None, 'condition': None, 'duration': 1,
        'duration_type': None, 'ignore_shield': 0, 'ignore_defense': 0,
    })()


def _make_services(bf):
    dl = _get_dl()
    rs = ResourceService()
    ts = TriggerService()
    ts.set_data_loader(dl)
    aus = AuraService()
    dms = DamageService()
    tgs = TargetService()
    sts = StatusService()
    ss = SkillService(dl, rs, target_service=tgs, damage_service=dms,
                      aura_service=aus, trigger_service=ts, status_service=sts)
    ts.set_skill_service(ss)
    ts.set_damage_service(dms)
    ss.set_battlefield(bf)
    ss._current_skill_id = 120155
    ss._block_damage_total = {}
    ss._current_block_id = 1
    ss._block_damage_targets = {}
    ss._current_skill_priority = None
    ss._hp_consumed = 0
    ss._most_recent_damage = 0
    ss._per_hit_hp_losses = {}
    ss._pending_deaths = set()
    ss._primary_target = None
    ss._mark_condition_targets = None
    ss._mark_condition_target = None
    ss._newly_created_sub_unit_ids = set()
    return ss


class TestDtdNoConsumeBelowThreshold:
    """低于阈值未触发减伤的受击不消耗hit_limited"""

    def test_log_scenario_add_damage_below_threshold_keeps_buff(self):
        """复现日志L11467: add_damage 24917 < threshold 38816 不减伤不消耗

        hp_ratio_damage 252829 > threshold 40453 触发减伤消耗 3→2
        add_damage 24917 < threshold(减伤后HP对应阈值) 不减伤不消耗 保持2
        """
        # 复现日志数值: caster=心色見つめるムードメーカー ATK=101083
        caster = _make_unit("a1", Side.ALLY, 170589, 170589, 101083)
        # アニス・ベネット: max=1120832, 受击前current≈2025270*... 用日志第4轮值
        # hp=2025270(受击前), threshold=2025270*2%=40505
        enemy = _make_unit("e1", Side.ENEMY, 2231414, 2025270, 6806)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        dtd = _make_dtd_buff(hit_limited=3, value=50, threshold_pct=2)
        enemy.buffs.append(dtd)
        # add_damage快照ATK=112517 power=15% → base=16877 max(0,112517+min(0,112517-6806))
        caster.buffs.append(_make_add_damage_buff(value=15, caster_attack=112517))
        ss = _make_services(bf)

        result = ss._apply_hp_ratio_damage(caster, _make_effect(), bf)

        # hp_ratio: raw=2025270*12.5%=253158.75 → 253158 > threshold 40505 减伤→126579
        # cap=101083*50%=50541.5 → 126579 > cap → 截断50541
        # 触发减伤 → 消耗1次: 3→2
        assert result['targets'][0]['actual_damage'] == 50541
        assert dtd.hit_limited == 2, "hp_ratio触发减伤应消耗1次: 3→2"

        # add_damage: base=112517*15%=16877 < threshold(减伤后HP 1974729*2%=39494)
        # 不减伤不消耗 → hit_limited保持2, buff存活
        assert dtd.hit_limited == 2, "add_damage低于阈值未减伤, 不应消耗hit_limited"
        assert dtd in enemy.buffs, "未减伤时buff不应被移除"

    def test_damage_path_below_threshold_no_consume(self):
        """damage路径(calculate_damage): 低于阈值的hit不消耗hit_limited"""
        dl = _get_dl()
        caster = _make_unit("a1", Side.ALLY, 170589, 170589, 50000)
        enemy = _make_unit("e1", Side.ENEMY, 2231414, 2025270, 6806)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        dtd = _make_dtd_buff(hit_limited=3, value=50, threshold_pct=90)
        enemy.buffs.append(dtd)
        dms = DamageService()

        skill_data = type('obj', (object,), {
            'power': 50.0, 'hit_count': 2, 'element': 2,
            'ignore_defense': 0, 'ignore_shield': 0, 'hp_scaling_bonus': 0,
            'cannot_crit': True, 'bonus_crit_rate': 0.0,
            'skill_id': 999999, 'name': "test",
        })()
        result = dms.calculate_damage(caster, enemy, skill_data)

        # threshold=2025270*90%=1822743, 每hit伤害远低于 → 不减伤
        assert result.total_damage > 0
        # 2hit均未触发减伤 → 不消耗: hit_limited保持3
        assert dtd.hit_limited == 3, "低于阈值的hit不应消耗hit_limited"
        assert dtd in enemy.buffs

    def test_damage_path_mixed_hits_consume_only_reduced(self):
        """damage路径: 多hit中仅触发减伤的hit消耗次数

        hit1超阈值减伤→消耗, hit2...同样超阈值→消耗, hit3低于→不消耗
        """
        caster = _make_unit("a1", Side.ALLY, 170589, 170589, 150000)
        enemy = _make_unit("e1", Side.ENEMY, 2231414, 2025270, 6806)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        # threshold=2025270*2%=40505: 多数hit超阈值
        dtd = _make_dtd_buff(hit_limited=3, value=50, threshold_pct=2)
        enemy.buffs.append(dtd)
        dms = DamageService()

        skill_data = type('obj', (object,), {
            'power': 50.0, 'hit_count': 3, 'element': 2,
            'ignore_defense': 0, 'ignore_shield': 0, 'hp_scaling_bonus': 0,
            'cannot_crit': True, 'bonus_crit_rate': 0.0,
            'skill_id': 999999, 'name': "test",
        })()
        result = dms.calculate_damage(caster, enemy, skill_data)

        # 3hit均超阈值触发减伤 → 消耗3次 → 3→0, buff移除
        assert dtd.hit_limited == 0
        remaining = [b for b in enemy.buffs
                     if b.effect_type == DMG_TAKEN_DOWN_THRESHOLD]
        assert len(remaining) == 0, "3次减伤耗尽3次hit_limited, buff应移除"

    def test_kept_buff_reduces_next_skill_hit(self):
        """端到端验证: 保留的次数使下一次技能第1hit吃到减伤（日志期望90529场景）"""
        # ATK=200000 → cap=100000 > 90529 不截断（模拟日志final_atk=209291场景）
        caster = _make_unit("a1", Side.ALLY, 170589, 170589, 200000)
        enemy = _make_unit("e1", Side.ENEMY, 2231414, 1961627, 6806)
        bf = BattlefieldState()
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]
        dtd = _make_dtd_buff(hit_limited=1, value=50, threshold_pct=2)
        enemy.buffs.append(dtd)
        ss = _make_services(bf)

        # 第1次: 低伤害不触发减伤不消耗（模拟低值add_damage场景）
        # raw=1961627*0.1%=1961 < threshold 39232
        result = ss._apply_hp_ratio_damage(caster, _make_effect(value=0.1), bf)
        assert result['targets'][0]['actual_damage'] == 1961
        assert dtd.hit_limited == 1, "低伤害未触发减伤不消耗"
        assert dtd in enemy.buffs

        # 第2次: 超阈值伤害触发减伤（模拟レバッ！第1hit: 181058→90529）
        # 181058 = raw(设HP使raw=181058): current=1961627-1961=1959666
        # 1959666*9.238%≈181058 → 直接构造: value=181058/1959666*100≈9.238
        result2 = ss._apply_hp_ratio_damage(
            caster, _make_effect(value=181058 / 1959666 * 100), bf)
        # 触发减伤50%: 181058 → 90529, 消耗 1→0, buff移除
        assert result2['targets'][0]['actual_damage'] == 90529, \
            "レバッ！第1hit期望减伤至90529 (181058×50%)"
        remaining = [b for b in enemy.buffs
                     if b.effect_type == DMG_TAKEN_DOWN_THRESHOLD]
        assert len(remaining) == 0, "减伤生效后hit_limited耗尽, buff移除"
