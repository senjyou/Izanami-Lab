"""Regression: 装いを新たに (110050) sub_unit cross-target linked expiry.

History:
  Skill 110050 「装いを新たに」creates 2 子機Ⅱ on 2 different allies via
  ally_single_chained_nearest targeting. In-game bug: the sub_units' duration
  only respects the first one to expire — when one 子機Ⅱ expires (duration or
  HP depletion), the other also expires simultaneously.

  Implemented via sub_unit_link_group field on BuffState: when linked_expiry
  flag is set in effect flags, _apply_sub_unit generates a shared link_group_id
  and assigns it to all sub_unit buffs created in the same execution. The
  cascade is triggered in three expiry paths:
    1. Duration expiry: check_expiration(all_units) calls _cascade_linked_sub_unit_expiry
    2. HP depletion: _apply_damage calls _cascade_linked_sub_unit_expiry directly
    3. Min-damage HP depletion: same as #2

  Original implementation path (no linked_expiry flag) is preserved:
  sub_unit_link_group defaults to "" and _cascade_linked_sub_unit_expiry
  returns immediately.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType, AuraUpdateTiming
from src.entities_v2.unit_state import BuffState


class TestRegYosoiLinkedSubUnitExpiry(unittest.TestCase):
    """子機Ⅱ linked expiry: when one expires, the other also expires."""

    def _setup_battlefield(self):
        """Build battlefield with caster(CB) + ally_a(LF) + ally_b(CF) + dummy enemy.

        Execute skill 110050 to create linked sub_units on ally_a and ally_b.
        Caster at CENTER_BACK → A=ally_b(CF, nearest front-row), B=ally_a(LF, nearest to CF).
        Returns (bf, ss, aus, caster, ally_a, ally_b).
        """
        bb = BattleBuilder()
        bb.add_ally(unit_id="caster", position=Position.ALLY_CENTER_BACK,
                    hp=50000, atk=5000, defense=5000, speed=500,
                    skills=[110050], level=10, ap=10, pp=10, ep=10)
        bb.add_ally(unit_id="ally_a", position=Position.ALLY_LEFT_FRONT,
                    hp=50000, atk=3000, defense=3000, speed=300,
                    level=10, ap=10, pp=10, ep=10)
        bb.add_ally(unit_id="ally_b", position=Position.ALLY_CENTER_FRONT,
                    hp=50000, atk=3000, defense=3000, speed=300,
                    level=10, ap=10, pp=10, ep=10)
        bb.add_enemy(unit_id="dummy_enemy", position=Position.ENEMY_CENTER_FRONT,
                     hp=999999, atk=100, defense=99999, speed=100)
        ctx = bb.build()
        bf = ctx['bf']
        ss = ctx['ss']
        aus = ctx['aus']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")
        ally_a = next(u for u in bf.friend_team if u.unit_id == "ally_a")
        ally_b = next(u for u in bf.friend_team if u.unit_id == "ally_b")

        result = ss.execute_skill(caster=caster, skill_id=110050,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result.get("success", False),
                        f"Skill 110050 execution failed: {result}")
        return bf, ss, aus, caster, ally_a, ally_b

    def _get_sub_unit(self, unit):
        buffs = [b for b in unit.buffs if b.effect_type == SkillEffectType.SUB_UNIT.value]
        return buffs[0] if buffs else None

    # ── linked_expiry flag is set: sub_units share link_group ──

    def test_sub_units_share_link_group(self):
        """After executing skill 110050, both sub_units share the same link_group."""
        bf, ss, aus, caster, ally_a, ally_b = self._setup_battlefield()

        sub_a = self._get_sub_unit(ally_a)
        sub_b = self._get_sub_unit(ally_b)

        self.assertIsNotNone(sub_a, "ally_a should have sub_unit")
        self.assertIsNotNone(sub_b, "ally_b should have sub_unit")
        self.assertTrue(sub_a.sub_unit_link_group,
                        "sub_unit on ally_a should have non-empty link_group")
        self.assertEqual(sub_a.sub_unit_link_group, sub_b.sub_unit_link_group,
                         "Both sub_units should share the same link_group")
        # Caster should NOT have sub_unit (caster at back row, not a target)
        self.assertIsNone(self._get_sub_unit(caster),
                          "Caster (back row) should NOT have sub_unit")

    def test_duration_expiry_cascade(self):
        """When one sub_unit's duration expires, the other also expires."""
        bf, ss, aus, caster, ally_a, ally_b = self._setup_battlefield()

        sub_a = self._get_sub_unit(ally_a)
        sub_b = self._get_sub_unit(ally_b)
        self.assertIsNotNone(sub_a)
        self.assertIsNotNone(sub_b)

        # Clear just_applied (simulating caster's action end which clears the flag)
        # so process_maneuver_end will actually decrement duration on next action end
        for u in bf.get_all_units():
            for b in u.buffs + u.debuffs:
                b.just_applied = False

        # Speed up: set duration to 1 so it expires on next action end
        sub_a.duration = 1
        sub_b.duration = 1

        # Simulate ally_a's action end: decrement duration, then check_expiration
        all_units = bf.get_all_units()
        aus.process_maneuver_end(ally_a)  # sub_a.duration -> 0
        # check_expiration with all_units triggers cascade
        aus.check_expiration(ally_a, all_units)

        # ally_a's sub_unit should be gone (duration expired)
        self.assertIsNone(self._get_sub_unit(ally_a),
                          "ally_a's sub_unit should be removed (duration expired)")
        # ally_b's sub_unit should ALSO be gone (cascade)
        self.assertIsNone(self._get_sub_unit(ally_b),
                          "ally_b's sub_unit should be cascade-removed when ally_a's expires")

    def test_hp_depletion_cascade(self):
        """When one sub_unit's HP is depleted, the other also expires."""
        bf, ss, aus, caster, ally_a, ally_b = self._setup_battlefield()

        sub_a = self._get_sub_unit(ally_a)
        sub_b = self._get_sub_unit(ally_b)
        self.assertIsNotNone(sub_a)
        self.assertIsNotNone(sub_b)

        # Simulate HP depletion: remove sub_a and trigger cascade
        ally_a.buffs = [b for b in ally_a.buffs if b.buff_id != sub_a.buff_id]
        all_units = bf.get_all_units()
        removed = aus._cascade_linked_sub_unit_expiry(sub_a, ally_a, all_units)

        self.assertTrue(len(removed) > 0,
                        "Cascade should have removed linked sub_unit on ally_b")
        self.assertIsNone(self._get_sub_unit(ally_a),
                          "ally_a's sub_unit should be removed (HP depleted)")
        self.assertIsNone(self._get_sub_unit(ally_b),
                          "ally_b's sub_unit should be cascade-removed when ally_a's HP depletes")
        # sub_b's duration should be set to 0 by cascade
        self.assertEqual(sub_b.duration, 0,
                         "sub_b's duration should be set to 0 by cascade")

    def test_cascade_skips_already_expired(self):
        """Cascade only affects non-expired linked sub_units (idempotent)."""
        bf, ss, aus, caster, ally_a, ally_b = self._setup_battlefield()

        sub_a = self._get_sub_unit(ally_a)
        sub_b = self._get_sub_unit(ally_b)

        # Pre-expire sub_b (duration=0)
        sub_b.duration = 0
        all_units = bf.get_all_units()
        # Now expire sub_a and cascade
        sub_a.duration = 0
        removed = aus._cascade_linked_sub_unit_expiry(sub_a, ally_a, all_units)

        # Cascade should not find sub_b (it's already expired, duration not > 0)
        # (sub_b might still be in ally_b.buffs if check_expiration wasn't called,
        #  but the cascade checks duration > 0 and skips it)
        self.assertEqual(len(removed), 0,
                         "Cascade should skip already-expired sub_units")

    # ── linked_expiry flag NOT set: no cascade (original behavior) ──

    def test_no_cascade_without_link_group(self):
        """Without sub_unit_link_group, no cascade happens (original behavior)."""
        bb = BattleBuilder()
        bb.add_ally(unit_id="caster", position=Position.ALLY_CENTER_BACK,
                    hp=50000, atk=5000, defense=5000, speed=500,
                    skills=[110050], level=10, ap=10, pp=10, ep=10)
        bb.add_ally(unit_id="ally_a", position=Position.ALLY_LEFT_FRONT,
                    hp=50000, atk=3000, defense=3000, speed=300,
                    level=10, ap=10, pp=10, ep=10)
        bb.add_ally(unit_id="ally_b", position=Position.ALLY_CENTER_FRONT,
                    hp=50000, atk=3000, defense=3000, speed=300,
                    level=10, ap=10, pp=10, ep=10)
        bb.add_enemy(unit_id="dummy_enemy", position=Position.ENEMY_CENTER_FRONT,
                     hp=999999, atk=100, defense=99999, speed=100)
        ctx = bb.build()
        bf = ctx['bf']
        ss = ctx['ss']
        aus = ctx['aus']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")
        ally_a = next(u for u in bf.friend_team if u.unit_id == "ally_a")
        ally_b = next(u for u in bf.friend_team if u.unit_id == "ally_b")

        # Manually create sub_units WITHOUT link_group (original behavior)
        sub_a = BuffState(
            buff_id="manual_sub_a", name="子機Ⅱ",
            effect_type=SkillEffectType.SUB_UNIT.value,
            value=10.0, duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=caster.unit_id, source_skill_id=110050,
            is_debuff=False, is_stackable=True,
            sub_unit_hp=1000, sub_unit_max_hp=1000,
            sub_unit_link_group="",  # No link group
        )
        sub_b = BuffState(
            buff_id="manual_sub_b", name="子機Ⅱ",
            effect_type=SkillEffectType.SUB_UNIT.value,
            value=10.0, duration=3,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=caster.unit_id, source_skill_id=110050,
            is_debuff=False, is_stackable=True,
            sub_unit_hp=1000, sub_unit_max_hp=1000,
            sub_unit_link_group="",  # No link group
        )
        aus.add_aura(ally_a, sub_a)
        aus.add_aura(ally_b, sub_b)

        # Clear just_applied (simulating caster's action end which clears the flag)
        # so process_maneuver_end will actually decrement duration on next action end
        for u in bf.get_all_units():
            for b in u.buffs + u.debuffs:
                b.just_applied = False

        # Expire ally_a's sub_unit via duration
        sub_a.duration = 1
        all_units = bf.get_all_units()
        aus.process_maneuver_end(ally_a)
        aus.check_expiration(ally_a, all_units)

        # ally_a's sub_unit should be gone
        self.assertIsNone(self._get_sub_unit(ally_a),
                          "ally_a's sub_unit should be removed (duration expired)")
        # ally_b's sub_unit should STILL be there (no cascade without link_group)
        self.assertIsNotNone(self._get_sub_unit(ally_b),
                             "ally_b's sub_unit should NOT be cascade-removed (no link_group)")


if __name__ == '__main__':
    unittest.main()
