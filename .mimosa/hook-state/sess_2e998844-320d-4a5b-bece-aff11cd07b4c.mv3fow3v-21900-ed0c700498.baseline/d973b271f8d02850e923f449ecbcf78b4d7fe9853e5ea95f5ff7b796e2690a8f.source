def load_skills_meta() -> dict[int, dict]:
    with SKILLS_JSON.open("r", encoding="utf-8") as fh:
        data = json.load(fh)
    return {int(k): v for k, v in data.items()}


def main() -> None:
    meta = load_skills_meta()
    with HYBRID_JSON.open("r", encoding="utf-8") as fh:
        hybrid = json.load(fh)
    print(f"[INFO] Loaded {len(hybrid)} existing hybrid entries")

    added, updated, missing_meta = [], [], []
    for skill in SKILLS:
        sid = skill["skill_id"]
        if sid not in meta:
            missing_meta.append(sid)
            continue
        m = meta[sid]
        # sanity: name must match skills.json
        assert m["name"] == skill["name"], f"{sid} name mismatch: {m['name']} vs {skill['name']}"
        assert m["skill_type"] == skill["skill_type"], f"{sid} skill_type mismatch"
        assert m["resource_cost"] == skill["resource_cost"], f"{sid} resource_cost mismatch: {m['resource_cost']} vs {skill['resource_cost']}"
        assert m["cooldown"] == skill["cooldown"], f"{sid} cooldown mismatch: {m['cooldown']} vs {skill['cooldown']}"
        old = hybrid.get(str(sid))
        hybrid[str(sid)] = skill
        if old:
            updated.append(sid)
        else:
            added.append(sid)

    if missing_meta:
        print(f"[WARN] skills.json missing meta for: {missing_meta}")

    with HYBRID_JSON.open("w", encoding="utf-8") as fh:
        json.dump(hybrid, fh, ensure_ascii=False, indent=1)
    print(f"[INFO] Added: {len(added)} ({added})")
    print(f"[INFO] Updated: {len(updated)} ({updated})")
    print(f"[OK] Wrote {HYBRID_JSON} ({len(hybrid)} entries)")


if __name__ == "__main__":
    main()
