"""Generate skill_effects_hybrid.json entries for S7 circle battle enemies (17 skills).
Merges into existing skill_effects_hybrid.json, preserving existing entries.

ヴィーヴル (133120451) の4技能 220172/220173/230163/230164 は
戦術演习で実装済みのため本スクリプトでは扱わない。

Skills:
    スウォング (167120351):
        220455 スウォームファング (AS) - 生存味方数で威力選択 3hit
        230487 カウンターバイト (PS) - after_self_attacked 反撃
        230488 デスレイジハイ (PS) - on_ally_killed 雌伏解除 + 全体攻防up
        230489 ダイブスリープ (PS) - on_turn_start once_per_battle ステルス+雌伏4
    シェラッグ (169120351):
        220458 シェルクレア (AS) - デバフ全解除 + シェル付与
        220459 コキュートバリア (AS) - 次攻撃被ダメ減 (caster HP比例)
        220460 バブルリヴァ (AS) - HP低順2体回復
        230492 アクアオラクル (PS) - 被攻撃後回復 + 幻惑
    サーヴェント (170121663):
        210133 カタラクトブレイク (EX) - 全体EN攻撃 + 被ダメ増 (caster HP比例)
        220461 ルインブースト (AS) - 自身強化(解除不可) + 継続ENダメージ
        220462 ストリームブレイク (AS) - HP割合最高敵の前後列 5hit EN
        220463 ウェーブバッシュ (AS) - HP割合最高敵(EN優先) EN攻撃
        230493 ファストジャッジ (PS) - on_turn_start 先制EN攻撃 + 属性有利時全体デバフ
    フロニュート (168120351):
        220456 グーイダウン (AS) - 最速敵 atk/def-12.5% (自身1行動まで)
        220457 スラッジバレット (AS) - 最速敵 EN攻撃 + spd-30
        230490 スティッキーロック (PS) - before_ally_as_attack 回避不可(必中)
        230491 シャドウグー (PS) - on_cumulative_damage 暗闇 + 条件PP回復

Usage:
    python scripts/_import_s7_skill_effects.py
"""
from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HYBRID_JSON = ROOT / "data" / "skill_effects_hybrid.json"
SKILLS_JSON = ROOT / "data" / "skills.json"

# Field-order template matching existing entries
EFFECT_TEMPLATE = {
    "effect_type": None,
    "target_type": None,
    "target_identifier": None,
    "value": None,
    "value_tag": None,
    "value_source": None,
    "duration": None,
    "duration_type": None,
    "duration_tag": None,
    "hit_count": None,
    "hit_count_tag": None,
    "condition": None,
    "flags": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
}

SKILL_TEMPLATE = {
    "skill_id": None,
    "name": None,
    "skill_type": None,
    "resource_cost": None,
    "cooldown": None,
    "cooldown_update_timing": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
    "trigger_type": None,
    "global_condition": None,
    "effect_blocks": [],
    "display_target_priority": None,
    "display_target_range": None,
    "display_target_type": None,
    "parse_status": "manual",
    "parse_notes": [],
}


def E(effect_type, target_type, target_identifier=None, value=None, value_tag=None,
      duration=None, duration_type=None, hit_count=None, condition=None, flags=None):
    eff = {k: v for k, v in EFFECT_TEMPLATE.items()}
    eff.update({
        "effect_type": effect_type,
        "target_type": target_type,
        "target_identifier": target_identifier,
        "value": value,
        "value_tag": value_tag,
        "duration": duration,
        "duration_type": duration_type,
        "hit_count": hit_count,
        "condition": condition,
        "flags": flags if flags is not None else {},
    })
    return eff


def B(block_id, effects, condition=None):
    return {"block_id": block_id, "condition": condition, "effects": effects}


def S(skill_id, name, skill_type, resource_cost, cooldown, cooldown_update_timing,
      display_target_type, display_target_range, blocks, notes,
      trigger_type=None, global_condition=None, extra=None):
    skill = {k: v for k, v in SKILL_TEMPLATE.items()}
    skill.update({
        "skill_id": skill_id,
        "name": name,
        "skill_type": skill_type,
        "resource_cost": resource_cost,
        "cooldown": cooldown,
        "cooldown_update_timing": cooldown_update_timing,
        "trigger_type": trigger_type,
        "global_condition": global_condition,
        "effect_blocks": blocks,
        "display_target_type": display_target_type,
        "display_target_range": display_target_range,
        "parse_notes": notes,
    })
    if extra:
        skill.update(extra)
    return skill


