"""Regression: グローリーコール (130022) buff duration not decremented on
next turn's first action.

Bug: on_turn_end PS applies buff via add_aura → just_applied=True.
just_applied is only cleared in _process_aura_expiry (called after each
unit's action). At turn end, _process_aura_expiry is NOT called, so
just_applied persists to the next turn. On the next turn, the buff
holder's first action end → _update_duration skips decrement due to
just_applied=True → clears just_applied. This causes the buff to last
one extra action (3 actions instead of 2 for duration=2).

Fix: Clear just_applied flags after turn-start and turn-end PS execution
in _execute_turn, since global triggers are not "during a unit's action"
and should not be protected by just_applied.

Test approach: Directly trigger turn-end PS via trigger_service + 
_execute_global_trigger_actions (same as _execute_turn does internally),
then manually apply the same just_applied clearing that _execute_turn
performs after turn-end PS execution. Finally verify _process_aura_expiry
correctly decrements the duration.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig

STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value


def _clear_just_applied(bf):
    """Clear just_applied flags for all units (same logic as _execute_turn
    does after turn-start/turn-end PS execution)."""
    for u in bf.get_all_units():
        for b in u.buffs + u.debuffs:
            b.just_applied = False


class TestRegGloryCallTurnEndJustApplied(unittest.TestCase):
    """グローリーコール buff just_applied must be cleared after turn-end PS."""

    def _build_battlefield(self):
        """Set up: 4 allies (130022 holder in back row) + 1 enemy.
        global_condition requires ally_alive_count >= 4.
        """
        bb = BattleBuilder()
        # Ally 1: グローリーコール holder, back row (buff target)
        bb.add_ally(unit_id="glory_holder", position=Position.ALLY_LEFT_BACK,
                    hp=99999, atk=5000, speed=500,
                    skills=[130022, 120013], level=10, pp=10)
        # Ally 2: back row (buff target)
        bb.add_ally(unit_id="ally_back2", position=Position.ALLY_CENTER_BACK,
                    hp=99999, atk=5000, speed=400,
                    skills=[120013], level=10, pp=10)
        # Ally 3: front row (filler)
        bb.add_ally(unit_id="ally_front1", position=Position.ALLY_LEFT_FRONT,
                    hp=99999, atk=5000, speed=300,
                    skills=[120013], level=10, pp=10)
        # Ally 4: front row (filler)
        bb.add_ally(unit_id="ally_front2", position=Position.ALLY_CENTER_FRONT,
                    hp=99999, atk=5000, speed=200,
                    skills=[120013], level=10, pp=10)
        # Enemy: high HP, no skills
        bb.add_enemy(unit_id="enemy", position=Position.ENEMY_CENTER_FRONT,
                     hp=999999, atk=1, speed=100)
        return bb.build()

    def _make_controller(self, ctx):
        bf = ctx['bf']
        controller = BattleFlowController(
            bf, BattleConfig(max_turns=5),
            data_loader=ctx['services']['dl'])
        controller._build_display_names()
        controller.skill_service.set_battlefield(bf)
        controller._deferred_crit_triggers = []
        return controller, bf

    def _trigger_turn_end_ps(self, controller, bf, turn_number=1):
        """Manually trigger turn-end PS (simulates _execute_turn turn-end phase
        without running the action loop)."""
        bf.turn_number = turn_number
        turn_end_actions = controller.trigger_service.trigger_turn_end(bf)
        controller._execute_global_trigger_actions(turn_end_actions)
        return turn_end_actions

    def test_glory_call_triggers_and_applies_atk_up(self):
        """グローリーコール should trigger at turn end and apply atk_up
        to back-row allies with duration=2."""
        ctx = self._build_battlefield()
        controller, bf = self._make_controller(ctx)
        holder = next(u for u in bf.friend_team if u.unit_id == "glory_holder")

        actions = self._trigger_turn_end_ps(controller, bf)

        # グローリーコール should be in the actions
        glory_actions = [a for a in actions if a.skill_id == 130022]
        self.assertGreater(len(glory_actions), 0,
                           "グローリーコール should trigger at turn end")

        # Back-row allies should have atk_up buff
        atk_buffs = [b for b in holder.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 1)
        self.assertEqual(atk_buffs[0].duration, 2,
                         "duration should be 2 right after application")

    def test_just_applied_true_right_after_add_aura(self):
        """Right after turn-end PS execution (before fix clears it),
        just_applied should be True. This confirms the bug exists."""
        ctx = self._build_battlefield()
        controller, bf = self._make_controller(ctx)
        holder = next(u for u in bf.friend_team if u.unit_id == "glory_holder")

        self._trigger_turn_end_ps(controller, bf)

        atk_buffs = [b for b in holder.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 1)
        self.assertTrue(atk_buffs[0].just_applied,
                        "just_applied should be True right after add_aura "
                        "(before _execute_turn fix clears it)")

    def test_bug_duration_not_decremented_without_fix(self):
        """WITHOUT the fix (just_applied not cleared): _process_aura_expiry
        skips decrement → duration stays 2 (bug)."""
        ctx = self._build_battlefield()
        controller, bf = self._make_controller(ctx)
        holder = next(u for u in bf.friend_team if u.unit_id == "glory_holder")

        self._trigger_turn_end_ps(controller, bf)
        # DO NOT clear just_applied (simulate the bug)

        # Simulate holder's action end
        controller._process_aura_expiry(holder)

        atk_buffs = [b for b in holder.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 1)
        self.assertEqual(atk_buffs[0].duration, 2,
                         "BUG: duration should stay 2 when just_applied not cleared "
                         "(skipped decrement)")

    def test_fix_duration_decremented_after_clearing(self):
        """WITH the fix (just_applied cleared after turn-end PS):
        _process_aura_expiry decrements normally → duration 2→1."""
        ctx = self._build_battlefield()
        controller, bf = self._make_controller(ctx)
        holder = next(u for u in bf.friend_team if u.unit_id == "glory_holder")

        self._trigger_turn_end_ps(controller, bf)

        # Apply the fix: clear just_applied (as _execute_turn does after turn-end PS)
        _clear_just_applied(bf)
        atk_buffs = [b for b in holder.buffs if b.effect_type == STATUS_ATTACK]
        self.assertFalse(atk_buffs[0].just_applied,
                         "just_applied must be False after fix clears it")

        # Simulate holder's action end
        controller._process_aura_expiry(holder)

        atk_buffs = [b for b in holder.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 1,
                         "buff should still exist (duration=1, not expired)")
        self.assertEqual(atk_buffs[0].duration, 1,
                         "FIX: duration should decrement 2→1 after just_applied cleared")

    def test_fix_two_actions_expire_buff(self):
        """WITH the fix: two action ends decrement duration 2→1→0, buff expires."""
        ctx = self._build_battlefield()
        controller, bf = self._make_controller(ctx)
        holder = next(u for u in bf.friend_team if u.unit_id == "glory_holder")

        self._trigger_turn_end_ps(controller, bf)
        _clear_just_applied(bf)

        # 1st action end → duration 2→1
        controller._process_aura_expiry(holder)
        atk_buffs = [b for b in holder.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 1)
        self.assertEqual(atk_buffs[0].duration, 1)

        # 2nd action end → duration 1→0, buff expires
        controller._process_aura_expiry(holder)
        atk_buffs = [b for b in holder.buffs if b.effect_type == STATUS_ATTACK]
        self.assertEqual(len(atk_buffs), 0,
                         "buff should expire after 2 action ends (duration 2→1→0)")


if __name__ == '__main__':
    unittest.main()
