"""角色463105 惨禍：ロージー・ヒューズ 专项E2E测试（敌方版）

同名己方参考: 120302 蠱惑のキャンペーンガール（110075/120164/130166/130167/130168）
参考测试: tests/test_rosie_campaign_120302.py（己方版）

技能列表（敌方版）:
- EX:  210117 特別サービス♪（消费现HP2.5% + 双护盾[消费HP×100% + maxHP×3.5%(Lv10)] +
       アイデアmark 4行動；創作中不发动且不扣EP）
- AS:  220413 プロモーション・バースト（非創作: 敌方单体[=己方队]威力[Lv10=93.6]，
       持アイデア追加攻击威力2[46.8]，Lv5+吸血cure[Lv10=50]；
       創作中: 回复1.5%maxHP无攻击）
- PS1: 230432 スマイル・ファンサービス（累计受伤≥0.75%maxHP触发，治疗HP比例最低2体
       （含自身）+自身PP回复1；創作中不触发且计数保留）
- PS2: 230433 ボルテージ・マックス+（HP<20%自身被攻击前触发，致死锁血+回复1.5%maxHP；
       創作mark 2行動解除不可；Lv5+ atk/def+6%重複可；HP>=20%/創作中不触发）
- PS3: 230434 スペシャル・アピール+（創作中自身被攻击前触发，减伤75%持续至攻击者
       行动结束；非創作不触发）

敌方差异（vs 己方120302）:
- 数值全部按敌方原始tags（EX消费2.5%、护盾3.5%、AS自愈1.5%、PS1阈值0.75%、
  PS2锁血回复1.5%、PS3减伤75%）
- PS2/PS3 移除 ally_alive_count>=2 限制（敌方描述无「生存友方仅自身」句）

角色信息:
- 角色: 惨禍：ロージー・ヒューズ（敌方）/ 蠱惑のキャンペーンガール（己方）
- 属性: 1 (火), 类型: 3 (敏捷), 站位: 5 (中後), 定位: 辅助
- 技能: 210117, 220413, 230432, 230433, 230434
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.battle_flow_controller import BattleFlowController

# 简写
MARK = SkillEffectType.MARK.value
SHIELD = SkillEffectType.SHIELD.value
CHEAT_DEATH = SkillEffectType.CHEAT_DEATH.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value

EX_SKILL = 210117
AS_SKILL = 220413
PS_HEAL = 230432
PS_CHEAT = 230433
PS_REDUCE = 230434

# 己方测试用纯伤害单体AS技能（一閃 120040: 威力156% Lv10, 1hit, 无附加效果）
ALLY_ATTACK = 120040

ROSIE_MAX_HP = 20000
ALLY_A_MAX_HP = 15000
ALLY_B_MAX_HP = 12000
ALLY_C_MAX_HP = 10000


class TestActor463105(unittest.TestCase):
    """角色463105 惨禍：ロージー・ヒューズ 专项E2E测试（敌方版）"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # ロージー 463105 (火属性, 敏捷, 中後 = 真实站位5)
        self.rosie = UnitState(
            unit_id="rosie", name="惨禍：ロージー", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=0, level=10,
            element=1, character_type=3,
            max_hp=ROSIE_MAX_HP, current_hp=ROSIE_MAX_HP,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=10,
            current_ap=10, current_pp=4, current_ep=10,
            skills=[EX_SKILL, AS_SKILL, PS_HEAL, PS_CHEAT, PS_REDUCE],
            skill_levels={EX_SKILL: 10, AS_SKILL: 10, PS_HEAL: 10,
                          PS_CHEAT: 10, PS_REDUCE: 10},
            skill_cooldowns={},
        )

        # 敌方同队（PS1治疗目标统计用；后排，避免抢走一閃主目标）
        self.enemy_2 = self._mk_enemy("enemy_2", "敵2", Position.ENEMY_LEFT_BACK, 10000)
        self.enemy_3 = self._mk_enemy("enemy_3", "敵3", Position.ENEMY_RIGHT_BACK, 10000)

        # 己方前排中央（一閃攻击者 / AS主目标=最近）
        self.ally_a = UnitState(
            unit_id="ally_a", name="友方A", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999101, level=10,
            element=1, character_type=1,   # 与ロージー同属性避免有利属性系数1.25
            max_hp=ALLY_A_MAX_HP, current_hp=ALLY_A_MAX_HP,
            attack=8000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[ALLY_ATTACK], skill_levels={ALLY_ATTACK: 10},
            skill_cooldowns={},
        )
        self.ally_b = self._mk_ally("ally_b", "友方B", Position.ALLY_LEFT_BACK,
                                    ALLY_B_MAX_HP)
        self.ally_c = self._mk_ally("ally_c", "友方C", Position.ALLY_RIGHT_BACK,
                                    ALLY_C_MAX_HP)

        self.bf.friend_team = [self.ally_a, self.ally_b, self.ally_c]
        self.bf.enemy_team = [self.rosie, self.enemy_2, self.enemy_3]

        self.controller = BattleFlowController(self.bf, data_loader=self.dl)
        self.controller._build_display_names()
        self.controller.skill_service.set_battlefield(self.bf)
        self.controller._deferred_crit_triggers = []
        self.ss = self.controller.skill_service
        self.ts = self.controller.trigger_service

    # ─── helpers ───

    def _mk_enemy(self, uid, name, pos, hp):
        return UnitState(
            unit_id=uid, name=name, side=Side.ENEMY, position=pos,
            character_id=0, level=10, element=1, character_type=1,
            max_hp=hp, current_hp=hp, attack=5000, defense=3000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=10,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    def _mk_ally(self, uid, name, pos, hp):
        return UnitState(
            unit_id=uid, name=name, side=Side.ALLY, position=pos,
            character_id=999102, level=10, element=1, character_type=1,
            max_hp=hp, current_hp=hp, attack=7000, defense=3000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

    def _add_mark(self, unit, mark_name, duration=4, unremovable=False):
        """手动施加mark（模拟技能施加的アイデア/創作状态）"""
        mark = BuffState(
            buff_id=f"test_mark_{mark_name}", name=mark_name, effect_type=MARK,
            value=1, duration=duration,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=unit.unit_id, source_skill_id=0,
            is_debuff=False, unremovable=unremovable,
        )
        unit.buffs.append(mark)
        return mark

    def _get_marks(self, unit, mark_name):
        return [b for b in unit.buffs + unit.debuffs
                if b.effect_type == MARK and b.name == mark_name]

    def _ally_attack_rosie(self, atk=None):
        """己方A对ロージー发动一閃攻击（触发before_any_attacked）"""
        if atk is not None:
            self.ally_a.attack = atk
        return self.ss.execute_skill(
            caster=self.ally_a, skill_id=ALLY_ATTACK,
            battlefield=self.bf, skip_cost=True
        )

    def _tag(self, sid, tag_name, level=10):
        sk = self.dl.get_skill_by_id(sid)
        return sk.template_tags[tag_name].get_value_at_level(level)

    # ════════════════════════════════════════════════════════════════
    # 配置校验
    # ════════════════════════════════════════════════════════════════

    def test_config_skill_ids_present(self):
        """配置校验：5个技能均在 skills.json / hybrid 中。"""
        for sid in [EX_SKILL, AS_SKILL, PS_HEAL, PS_CHEAT, PS_REDUCE]:
            self.assertIsNotNone(self.dl.get_skill_by_id(sid), f"skills.json 缺 {sid}")
            self.assertIsNotNone(self.dl.get_parsed_skill_data(sid), f"hybrid 缺 {sid}")

    def test_config_enemy_tag_values_lv10(self):
        """配置校验：关键数值取敌方原始Lv10 tag值（非己方数值）。"""
        self.assertAlmostEqual(self._tag(EX_SKILL, "shield"), 3.5, places=2,
                               msg="EX maxHP护盾应为3.5%（己方55%）")
        self.assertAlmostEqual(self._tag(AS_SKILL, "威力"), 93.6, places=1)
        self.assertAlmostEqual(self._tag(AS_SKILL, "威力2"), 46.8, places=1)
        self.assertAlmostEqual(self._tag(AS_SKILL, "cure"), 50.0, places=1,
                               msg="AS吸血cure应为50%")
        self.assertAlmostEqual(self._tag(PS_HEAL, "威力"), 35.0, places=1,
                               msg="PS1治疗威力应为35%")
        self.assertAlmostEqual(self._tag(PS_CHEAT, "cure"), 1.5, places=2,
                               msg="PS2锁血回复应为1.5%（己方30%）")
        self.assertAlmostEqual(self._tag(PS_CHEAT, "atk"), 6.0, places=1)
        self.assertAlmostEqual(self._tag(PS_CHEAT, "def"), 6.0, places=1)
        self.assertAlmostEqual(self._tag(PS_REDUCE, "dmg"), 75.0, places=1,
                               msg="PS3减伤应为75%（己方60%）")

    def test_config_ex_consume_hp_2_5(self):
        """配置校验：EX consume_hp=2.5%（敌方原始值，己方50%）+ 創作中不发动。"""
        parsed = self.dl.get_parsed_skill_data(EX_SKILL)
        self.assertEqual(parsed["execute_condition"]["type"], "self_lacks_mark")
        self.assertEqual(parsed["execute_condition"]["mark_name"], "創作")
        consume = [e for b in parsed["effect_blocks"] for e in b["effects"]
                   if e["effect_type"] == "consume_hp"]
        self.assertEqual(len(consume), 1)
        self.assertAlmostEqual(consume[0]["value"], 2.5, places=2)

    def test_config_as_lifesteal_threshold_lv5(self):
        """配置校验：AS吸血block阈值 11→5（敌方Lv5描述新增吸血）。"""
        parsed = self.dl.get_parsed_skill_data(AS_SKILL)
        block3 = [b for b in parsed["effect_blocks"] if b["block_id"] == 3][0]
        conds = block3["condition"]["conditions"]
        lv = [c for c in conds if c.get("type") == "active_level_min"][0]
        self.assertEqual(lv["value"], 5, "敌方阈值应为Lv5")
        # 創作中自愈为1.5% maxHP
        block4 = [b for b in parsed["effect_blocks"] if b["block_id"] == 4][0]
        heal = block4["effects"][0]
        self.assertEqual(heal["effect_type"], "heal")
        self.assertAlmostEqual(heal["value"], 1.5, places=2)
        self.assertEqual(heal["flags"]["heal_base"], "max_hp")

    def test_config_ps1_threshold_0_75(self):
        """配置校验：PS1累计受伤阈值=0.75%（敌方原始值，己方15%）。"""
        parsed = self.dl.get_parsed_skill_data(PS_HEAL)
        self.assertEqual(parsed["trigger_type"], "on_cumulative_damage")
        conds = parsed["global_condition"]["conditions"]
        thr = [c for c in conds if c.get("type") == "cumulative_damage_percent"][0]
        self.assertAlmostEqual(thr["value"], 0.75, places=2)
        # 治疗2体（HP比例最低优先，含自身）
        heal = parsed["effect_blocks"][0]["effects"][0]
        self.assertEqual(heal["flags"]["target_count"], 2)
        self.assertTrue(heal["flags"]["lowest_hp_priority"])
        self.assertTrue(heal["flags"]["include_self"])

    def test_config_ps2_ps3_no_ally_alive_count(self):
        """配置校验：PS2/PS3 敌方版无 ally_alive_count>=2 限制（用户确认差异）。"""
        for sid in (PS_CHEAT, PS_REDUCE):
            parsed = self.dl.get_parsed_skill_data(sid)
            self.assertEqual(parsed["trigger_type"], "before_any_attacked")
            conds = parsed["global_condition"]["conditions"]
            self.assertFalse(any(c.get("type") == "ally_alive_count" for c in conds),
                             f"{sid} 敌方版不应含 ally_alive_count 条件")
            self.assertTrue(any(c.get("type") == "target_is_self" for c in conds))

    def test_config_tactical_entry(self):
        """配置校验：战术演习条目 position=5 / party=400245 / 技能10级。"""
        enemies = self.dl.get_tactical_exercise_enemies()
        self.assertIn(463105, enemies)
        e = enemies[463105]
        self.assertEqual(e["position"], 5)
        self.assertEqual(e["party_id"], 400245)
        self.assertEqual(e["attribute"], 1)
        self.assertEqual(e["type"], 3)
        self.assertEqual(e["role_type"], 4)
        self.assertEqual(e["character_name"], "ロージー・ヒューズ")
        self.assertEqual(e["skill_ids"], [EX_SKILL, AS_SKILL, PS_HEAL, PS_CHEAT, PS_REDUCE])

    # ════════════════════════════════════════════════════════════════
    # EX: 210117 特別サービス♪
    # ════════════════════════════════════════════════════════════════

    def test_ex_consume_hp_shields_and_idea_mark(self):
        """EX(210117): 消费2.5%现HP + 双护盾 + アイデアmark 4行動。"""
        result = self.ss.execute_skill(
            caster=self.rosie, skill_id=EX_SKILL, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        # HP: 20000 → 消费 20000×2.5% = 500 → 19500
        self.assertEqual(self.rosie.current_hp, 19500, "EX应消费2.5%当前HP")
        # 护盾①: 消费HP×100% = 500; 护盾②: maxHP×3.5% = 700; 合计 1200
        self.assertEqual(self.rosie.shield, 1200,
                         f"双护盾合计应为 500+700=1200, 实际: {self.rosie.shield}")
        shield_buffs = [b for b in self.rosie.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_buffs), 2, "应施加2个护盾buff")
        idea_marks = self._get_marks(self.rosie, "アイデア")
        self.assertEqual(len(idea_marks), 1, "应施加アイデア mark")
        self.assertEqual(idea_marks[0].duration, 4, "アイデア应持续4行動")

    def test_ex_blocked_during_sousaku_no_ep_cost(self):
        """EX(210117): 創作中不发动（execute_condition），EP不扣、HP不变。"""
        self._add_mark(self.rosie, "創作", duration=2)
        ep_before = self.rosie.current_ep
        hp_before = self.rosie.current_hp
        result = self.ss.execute_skill(
            caster=self.rosie, skill_id=EX_SKILL, battlefield=self.bf, skip_cost=False
        )
        self.assertFalse(result["success"], "創作中EX不应发动")
        self.assertEqual(result.get("error"), "execute_condition not met")
        self.assertEqual(self.rosie.current_ep, ep_before, "EP不应被消耗")
        self.assertEqual(self.rosie.current_hp, hp_before, "HP不应被消费")
        self.assertEqual(self.rosie.shield, 0, "不应获得护盾")
        self.assertEqual(len(self._get_marks(self.rosie, "アイデア")), 0,
                         "不应施加アイデア mark")

    # ════════════════════════════════════════════════════════════════
    # AS: 220413 プロモーション・バースト
    # ════════════════════════════════════════════════════════════════

    def test_as_main_attack_targets_ally_team_only(self):
        """AS(220413): 非創作无アイデア时仅主攻击，且目标为己方队（不含敌方自身）。"""
        self.rosie.current_hp = 10000
        ally_a_hp = self.ally_a.current_hp
        enemy2_hp = self.enemy_2.current_hp
        enemy3_hp = self.enemy_3.current_hp
        result = self.ss.execute_skill(
            caster=self.rosie, skill_id=AS_SKILL, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 1, "无アイデア时应只有主攻击")
        # 最近的己方前排中央单位应受击: (10000-3000)×93.6% ≈ 6552
        dealt = ally_a_hp - self.ally_a.current_hp
        self.assertGreater(dealt, 0, "敌方caster的enemy_single应解析为己方队最近单位")
        self.assertLess(abs(dealt - 6552), 5, f"主攻击伤害应≈6552, 实际: {dealt}")
        # 己方阵营自己人（敵2/敵3）不应受伤
        self.assertEqual(self.enemy_2.current_hp, enemy2_hp, "敵2不应受到自身技能伤害")
        self.assertEqual(self.enemy_3.current_hp, enemy3_hp, "敵3不应受到自身技能伤害")
        # Lv10 cure=50: 自身通过吸血回复（HP上升）
        self.assertGreater(self.rosie.current_hp, 10000, "Lv10吸血应回复自身HP")

    def test_as_extra_attack_with_idea(self):
        """AS(220413): 持アイデア时追加攻击（2次伤害）。"""
        self._add_mark(self.rosie, "アイデア", duration=4)
        result = self.ss.execute_skill(
            caster=self.rosie, skill_id=AS_SKILL, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 2, "持アイデア时应有主攻击+追加攻击")

    def test_as_lifesteal_lv10(self):
        """AS(220413): Lv10持アイデア时吸血=总伤害×50%（cure=50）。"""
        self._add_mark(self.rosie, "アイデア", duration=4)
        self.rosie.current_hp = 5000
        result = self.ss.execute_skill(
            caster=self.rosie, skill_id=AS_SKILL, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        total_dmg = result["total_damage"]
        self.assertGreater(total_dmg, 0)
        expected_heal = int(total_dmg * 50 / 100)
        self.assertEqual(self.rosie.current_hp, 5000 + expected_heal,
                         f"吸血应为总伤害{total_dmg}×50%={expected_heal}")

    def test_as_heal_mode_during_sousaku(self):
        """AS(220413): 創作中切换为自愈模式（回复1.5%maxHP=300，无攻击）。"""
        self._add_mark(self.rosie, "創作", duration=2)
        self.rosie.current_hp = 10000
        ally_a_hp = self.ally_a.current_hp
        result = self.ss.execute_skill(
            caster=self.rosie, skill_id=AS_SKILL, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        dmg_effects = [e for e in result["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 0, "創作中AS不应造成伤害")
        self.assertEqual(self.ally_a.current_hp, ally_a_hp, "己方HP不应变化")
        self.assertEqual(self.rosie.current_hp, 10300,
                         "創作中AS应回复1.5%maxHP=300")

    # ════════════════════════════════════════════════════════════════
    # PS1: 230432 スマイル・ファンサービス
    # ════════════════════════════════════════════════════════════════

    def test_ps1_trigger_via_cumulative_damage_threshold(self):
        """PS1(230432): 累计受伤≥0.75%maxHP(=150)触发，治疗HP比例最低2体+PP净变化0。"""
        self.rosie.cumulative_hp_damage = 150
        # HP比例: rosie 20% < enemy_2 40% < enemy_3 100%
        self.rosie.current_hp = 4000
        self.enemy_2.current_hp = 4000
        pp_before = self.rosie.current_pp

        actions = self.ts.trigger_cumulative_damage(self.bf, [self.rosie])
        ps_actions = [a for a in actions if a.skill_id == PS_HEAL]
        self.assertGreater(len(ps_actions), 0, "累计受伤达0.75%阈值应触发PS1")

        self.controller._execute_global_trigger_actions(actions)

        # 治疗 ATK10000×35% = 3500
        self.assertEqual(self.rosie.current_hp, 4000 + 3500, "HP比例最低的自身应被治疗")
        self.assertEqual(self.enemy_2.current_hp, 4000 + 3500, "第二低比例敵2应被治疗")
        self.assertEqual(self.enemy_3.current_hp, 10000, "满血敵3不应被治疗")
        self.assertEqual(self.rosie.current_pp, pp_before, "PP净变化应为0（消耗1+回复1）")
        self.assertEqual(self.rosie.cumulative_hp_damage, 0, "触发成功后累计计数应清零")

    def test_ps1_below_threshold_no_trigger(self):
        """PS1(230432): 累计受伤未达0.75%阈值(=150)时不触发。"""
        self.rosie.cumulative_hp_damage = 149
        actions = self.ts.trigger_cumulative_damage(self.bf, [self.rosie])
        ps_actions = [a for a in actions if a.skill_id == PS_HEAL]
        self.assertEqual(len(ps_actions), 0, "未达阈值不应触发")

    def test_ps1_not_triggered_during_sousaku_counter_preserved(self):
        """PS1(230432): 創作中不触发且累计受伤计数保留。"""
        self._add_mark(self.rosie, "創作", duration=2)
        self.rosie.cumulative_hp_damage = 300
        self.enemy_2.current_hp = 4000
        actions = self.ts.trigger_cumulative_damage(self.bf, [self.rosie])
        ps_actions = [a for a in actions if a.skill_id == PS_HEAL]
        self.assertEqual(len(ps_actions), 0, "創作中PS1不应触发")
        self.assertEqual(self.rosie.cumulative_hp_damage, 300, "计数应保留")
        self.assertEqual(self.enemy_2.current_hp, 4000, "不应发生治疗")

    # ════════════════════════════════════════════════════════════════
    # PS2: 230433 ボルテージ・マックス+
    # ════════════════════════════════════════════════════════════════

    def test_ps2_triggers_at_low_hp_lethal_attack(self):
        """PS2(230433): HP<20%被致死攻击前触发→锁血+回复1.5%maxHP+創作mark+atk/def上升。"""
        self.rosie.current_hp = 3000  # 15% < 20%
        self.rosie.shield = 0
        pp_before = self.rosie.current_pp

        result = self._ally_attack_rosie(atk=50000)  # (50000-5000)*1.56=70200 必致死
        self.assertTrue(result["success"])

        self.assertTrue(self.rosie.is_alive, "锁血后应存活")
        self.assertEqual(self.rosie.current_hp, 300,
                         "致死伤害应被耐受并回复1.5%maxHP=300")
        cheat_buffs = [b for b in self.rosie.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_buffs), 0, "单段锁血触发后应消耗")
        sousaku = self._get_marks(self.rosie, "創作")
        self.assertEqual(len(sousaku), 1, "应施加創作mark")
        self.assertEqual(sousaku[0].duration, 2, "創作应持续2行動")
        self.assertTrue(getattr(sousaku[0], 'unremovable', False), "創作应解除不可")
        self.assertEqual(self.rosie.current_pp, pp_before - 1, "PS触发应消耗PP 1")
        # 敌方Lv10: active_level_min=5 → atk_up/def_up +6%（己方Lv10无）
        atk_buffs = [b for b in self.rosie.buffs if b.effect_type == STATUS_ATTACK]
        def_buffs = [b for b in self.rosie.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertEqual(len(atk_buffs), 1, "敌方Lv10应施加atk_up(Lv5+生效)")
        self.assertEqual(len(def_buffs), 1, "敌方Lv10应施加def_up(Lv5+生效)")
        self.assertAlmostEqual(atk_buffs[0].value, 6.0, places=1)
        self.assertAlmostEqual(def_buffs[0].value, 6.0, places=1)
        self.assertTrue(atk_buffs[0].is_stackable, "atk_up应重複可")

    def test_ps2_no_trigger_at_high_hp(self):
        """PS2(230433): HP>=20%时不触发（无锁血、无創作）。"""
        self.rosie.current_hp = 10000  # 50%
        result = self._ally_attack_rosie()
        self.assertTrue(result["success"])
        cheat_buffs = [b for b in self.rosie.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_buffs), 0, "HP>=20%不应触发锁血")
        self.assertEqual(len(self._get_marks(self.rosie, "創作")), 0,
                         "HP>=20%不应施加創作mark")
        self.assertLess(self.rosie.current_hp, 10000, "应正常受到伤害")

    def test_ps2_no_trigger_during_sousaku(self):
        """PS2(230433): 創作中不触发（PS3代替触发减伤）。"""
        self._add_mark(self.rosie, "創作", duration=2)
        self.rosie.current_hp = 3000  # 15%
        hp_before = self.rosie.current_hp
        result = self._ally_attack_rosie()
        self.assertTrue(result["success"])
        cheat_buffs = [b for b in self.rosie.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_buffs), 0, "創作中PS2不应触发锁血")
        self.assertEqual(len(self._get_marks(self.rosie, "創作")), 1)
        # PS3减伤75%: (8000-5000)*1.56=4680 → ×0.25 = 1170
        damage = hp_before - self.rosie.current_hp
        self.assertLess(abs(damage - 4680 * 0.25), 5,
                        f"創作中应触发PS3减伤75%≈1170, 实际: {damage}")
        self.assertTrue(self.rosie.is_alive)

    def test_ps2_triggers_when_last_enemy(self):
        """PS2(230433): 敌方版无「生存友方仅自身」限制 → 仅剩自身仍触发锁血。"""
        self.enemy_2.is_alive = False
        self.enemy_3.is_alive = False
        self.rosie.current_hp = 3000  # 15%
        self.rosie.shield = 0
        result = self._ally_attack_rosie(atk=50000)  # 必致死
        self.assertTrue(result["success"])
        self.assertTrue(self.rosie.is_alive, "仅剩自身时敌方版仍应触发锁血")
        self.assertEqual(self.rosie.current_hp, 300, "应回复1.5%maxHP=300")
        self.assertEqual(len(self._get_marks(self.rosie, "創作")), 1, "应获得創作")

    def test_ps2_no_trigger_when_other_enemy_attacked(self):
        """PS2(230433): 其他敌方被攻击时不触发（target_is_self）。"""
        # 敵2移到前排中央（成为一閃的最近目标），ロージー留在中後
        self.enemy_2.position = Position.ENEMY_CENTER_FRONT
        self.rosie.current_hp = 3000  # 15%
        hp_before = self.rosie.current_hp
        result = self._ally_attack_rosie()
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_2.current_hp, 10000, "敵2应被攻击")
        cheat_buffs = [b for b in self.rosie.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_buffs), 0, "其他敌方被攻击时不应触发锁血")
        self.assertEqual(len(self._get_marks(self.rosie, "創作")), 0)
        self.assertEqual(self.rosie.current_hp, hp_before, "ロージーHP不应变化")

    # ════════════════════════════════════════════════════════════════
    # PS3: 230434 スペシャル・アピール+
    # ════════════════════════════════════════════════════════════════

    def test_ps3_damage_reduction_75_during_sousaku(self):
        """PS3(230434): 創作中被攻击→减伤75%（Lv10）覆盖当次攻击。"""
        # 基线: 无創作时伤害
        hp_before = self.rosie.current_hp
        result = self._ally_attack_rosie()
        self.assertTrue(result["success"])
        base_damage = hp_before - self.rosie.current_hp
        self.assertGreater(base_damage, 0)

        # 重置 + 創作中被攻击
        self.rosie.current_hp = ROSIE_MAX_HP
        self.rosie.shield = 0
        self._add_mark(self.rosie, "創作", duration=2)
        hp_before = self.rosie.current_hp
        result = self._ally_attack_rosie()
        self.assertTrue(result["success"])
        reduced_damage = hp_before - self.rosie.current_hp

        self.assertGreater(reduced_damage, 0, "应受到伤害")
        self.assertLess(abs(reduced_damage - base_damage * 0.25), 5,
                        f"减伤75%后伤害应≈{base_damage * 0.25:.0f}, 实际: {reduced_damage}")
        dtd_buffs = [b for b in self.rosie.buffs
                     if b.effect_type == RECEIVED_DAMAGE
                     and getattr(b, 'original_duration_type', '') == 'attacker_action']
        self.assertGreater(len(dtd_buffs), 0, "应持有attacker_action减伤buff")

    def test_ps3_triggers_when_last_enemy(self):
        """PS3(230434): 敌方版无「生存友方仅自身」限制 → 仅剩自身仍触发减伤。"""
        self.enemy_2.is_alive = False
        self.enemy_3.is_alive = False
        self._add_mark(self.rosie, "創作", duration=2)
        result = self._ally_attack_rosie()
        self.assertTrue(result["success"])
        dtd_buffs = [b for b in self.rosie.buffs
                     if b.effect_type == RECEIVED_DAMAGE
                     and getattr(b, 'original_duration_type', '') == 'attacker_action']
        self.assertEqual(len(dtd_buffs), 1, "仅剩自身时敌方版仍应触发减伤")

    def test_ps3_buff_cleaned_at_action_end(self):
        """PS3(230434): 减伤buff在攻击者行动结束时清除（行动级清理）。"""
        self._add_mark(self.rosie, "創作", duration=2)
        result = self._ally_attack_rosie()
        self.assertTrue(result["success"])
        dtd_buffs = [b for b in self.rosie.buffs
                     if b.effect_type == RECEIVED_DAMAGE
                     and getattr(b, 'original_duration_type', '') == 'attacker_action']
        self.assertGreater(len(dtd_buffs), 0, "技能级清理后buff应仍存在（仅行动级清理）")
        # 攻击者行动结束 → 清除
        self.controller._cleanup_guard_buffs(self.ally_a, action_ended=True)
        dtd_buffs = [b for b in self.rosie.buffs
                     if b.effect_type == RECEIVED_DAMAGE
                     and getattr(b, 'original_duration_type', '') == 'attacker_action']
        self.assertEqual(len(dtd_buffs), 0, "攻击者行动结束后减伤buff应被清除")
        self.assertEqual(len(self._get_marks(self.rosie, "創作")), 1,
                         "創作mark不受行动级清理影响")

    def test_ps3_no_trigger_without_sousaku(self):
        """PS3(230434): 非創作时不触发（无减伤buff，伤害未减免）。"""
        hp_before = self.rosie.current_hp
        result = self._ally_attack_rosie()
        self.assertTrue(result["success"])
        dtd_buffs = [b for b in self.rosie.buffs
                     if b.effect_type == RECEIVED_DAMAGE
                     and getattr(b, 'original_duration_type', '') == 'attacker_action']
        self.assertEqual(len(dtd_buffs), 0, "非創作时不应触发减伤")
        damage = hp_before - self.rosie.current_hp
        # (8000-5000)*1.56 = 4680
        self.assertGreater(abs(damage - 4680), -5, "伤害应未被减免")

    def test_ps3_no_trigger_when_other_enemy_attacked(self):
        """PS3(230434): 其他敌方被攻击时不触发（target_is_self）。"""
        self.enemy_2.position = Position.ENEMY_CENTER_FRONT
        self._add_mark(self.rosie, "創作", duration=2)
        result = self._ally_attack_rosie()
        self.assertTrue(result["success"])
        self.assertLess(self.enemy_2.current_hp, 10000, "敵2应被攻击")
        dtd_buffs = [b for b in self.rosie.buffs
                     if b.effect_type == RECEIVED_DAMAGE
                     and getattr(b, 'original_duration_type', '') == 'attacker_action']
        self.assertEqual(len(dtd_buffs), 0, "其他敌方被攻击时PS3不应触发")

    # ════════════════════════════════════════════════════════════════
    # 状态机循环
    # ════════════════════════════════════════════════════════════════

    def test_state_machine_cycle(self):
        """状态机循环: EX(アイデア)→AS追打→濒死PS2(創作)→AS自愈→PS3减伤→行动结束清理。"""
        # Step 1: EX → アイデア + HP消费2.5% + 双护盾
        r1 = self.ss.execute_skill(
            caster=self.rosie, skill_id=EX_SKILL, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(r1["success"])
        self.assertEqual(self.rosie.current_hp, 19500)
        self.assertEqual(len(self._get_marks(self.rosie, "アイデア")), 1)
        self.assertEqual(self.rosie.shield, 1200)

        # Step 2: AS持アイデア → 主攻击+追加攻击（目标为己方前排中央）
        ally_hp_2 = self.ally_a.current_hp
        r2 = self.ss.execute_skill(
            caster=self.rosie, skill_id=AS_SKILL, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(r2["success"])
        dmg_effects = [e for e in r2["effects_applied"] if e.get("effect_type") == "damage"]
        self.assertEqual(len(dmg_effects), 2, "持アイデア时应有2次攻击")
        self.assertLess(self.ally_a.current_hp, ally_hp_2)

        # Step 3: 濒死(HP<20%)被致死攻击 → PS2锁血 + 創作
        self.rosie.current_hp = 3000
        self.rosie.shield = 0
        r3 = self._ally_attack_rosie(atk=50000)
        self.assertTrue(r3["success"])
        self.assertTrue(self.rosie.is_alive)
        self.assertEqual(self.rosie.current_hp, 300, "锁血回复1.5%maxHP")
        self.assertEqual(len(self._get_marks(self.rosie, "創作")), 1, "获得創作")

        # Step 4: 創作中AS → 自愈1.5%maxHP、无攻击
        self.ally_a.attack = 8000
        ally_hp_4 = self.ally_a.current_hp
        r4 = self.ss.execute_skill(
            caster=self.rosie, skill_id=AS_SKILL, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(r4["success"])
        self.assertEqual(self.rosie.current_hp, 300 + 300, "創作中AS回复1.5%maxHP")
        self.assertEqual(self.ally_a.current_hp, ally_hp_4, "創作中AS无攻击")

        # Step 5: 創作中被攻击 → PS3减伤75%
        # 注意: PS2已在Step3施加def_up+6%（5000→5300），故base_diff=2700
        self.rosie.current_hp = 5000
        hp_before_5 = self.rosie.current_hp
        r5 = self._ally_attack_rosie()
        self.assertTrue(r5["success"])
        dmg5 = hp_before_5 - self.rosie.current_hp
        expected5 = 2700 * 1.56 * 0.25
        self.assertLess(abs(dmg5 - expected5), 5,
                        f"創作中被攻击应减伤75%≈{expected5:.0f}, 实际: {dmg5}")
        self.assertTrue(self.rosie.is_alive)

        # Step 6: 攻击者行动结束 → 减伤buff清除、創作保留
        self.controller._cleanup_guard_buffs(self.ally_a, action_ended=True)
        dtd = [b for b in self.rosie.buffs
               if b.effect_type == RECEIVED_DAMAGE
               and getattr(b, 'original_duration_type', '') == 'attacker_action']
        self.assertEqual(len(dtd), 0, "行动结束后减伤buff清除")
        self.assertEqual(len(self._get_marks(self.rosie, "創作")), 1,
                         "創作持续2行動不受行动级清理影响")


if __name__ == '__main__':
    unittest.main()