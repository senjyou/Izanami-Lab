        # 前排中央友方（与caster邻接：后排中央→前排中央为邻接）
        # 用作PS1 ally_column测试（caster同列友方）
        self.ally_front_center = UnitState(
            unit_id="ally_front_center", name="前列中友方", side=Side.ALLY,
