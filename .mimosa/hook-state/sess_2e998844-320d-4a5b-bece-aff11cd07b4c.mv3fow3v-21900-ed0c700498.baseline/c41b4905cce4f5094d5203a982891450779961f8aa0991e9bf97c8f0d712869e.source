"""角色101301 オールラウンダーな統率者 专项E2E测试

技能列表：
- EX: 110016 七彩の庭園（敵全体に3行動の凍結を付与。被ダメージ増加）
- AS1: 120053 イグナイト（自身に最も近い敵単体に5行動炎上 + 自身に隣接する味方にHP回復）
- AS2: 120054 スタンサプレッション（攻撃力最高敵を含む横一列にEN攻撃 +
  主目标HP>=90%時 stun 1行動 / L11+ 同列他敵 atk_down stackable）
- PS1: 130061 セントリストア（on_turn_end + 自身含む味方前後列にdmg_taken_down(EN限定, attack_limited=3) +
  自身状態異常時 remove_debuff / L11+ heal_over_time 2行動）
- PS2: 130062 リベンジシュート（after_ally_attacked + target_is_ally +
  攻撃力最高敵単体にEN攻撃）

覆盖维度：
1. EX 凍結付与敵全体(3行動) + 被ダメージ増加(value_tag=value)
2. AS1 炎上付与最近敵(5行動) + ally_adjacent回復(value_source=attack)
3. AS2 enemy_row_highest_atk横一列EN攻撃 + stun(HP>=90%条件) + L11+ enemy_row_others atk_down
4. PS1 on_turn_end + ally_column dmg_taken_down(EN限定, attack_limited=3) + self_has_status_ailment→remove_debuff + L11+ heal_over_time
5. PS2 after_ally_attacked + target_is_ally + enemy_single_highest_atk EN攻撃
6. 凍結機制：被ダメージ増加+凍結解除
7. ally_adjacent专项：邻接位置选择（前后左右4方向，不含自身）
8. enemy_row_highest_atk专项：最高ATK敵を含む横一列選択
9. enemy_row_others专项：主目标以外の同列敵選択
10. dmg_taken_down专项：EN限定減少、attack_limited=3消耗、stackable
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType, AuraUpdateTiming
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.skill_data_resolver import SkillDataResolver

# 简写
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value
STUN = SkillEffectType.KNOCKOUT.value
FREEZE = SkillEffectType.FREEZE.value
BURN = SkillEffectType.CONFLAGRATION.value  # 炎上
POISON = SkillEffectType.POISON.value
DMG_TAKEN_DOWN = SkillEffectType.RECEIVED_DAMAGE.value
HEAL_OVER_TIME = SkillEffectType.HEAL_OVER_TIME.value


class TestActor101301(unittest.TestCase):
    """角色101301 オールラウンダーな統率者 专项E2E测试"""

