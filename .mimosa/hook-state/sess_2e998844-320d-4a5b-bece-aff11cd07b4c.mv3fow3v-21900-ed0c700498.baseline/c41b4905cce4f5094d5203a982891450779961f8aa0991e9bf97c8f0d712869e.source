    # ════════════════════════════════════════════════════════════════
    # PS2: 130062 リベンジシュート
    # ════════════════════════════════════════════════════════════════

    def test_ps2_trigger_after_ally_attacked(self):
        """PS2(130062) after_ally_attacked + target_is_ally触发。"""
        self._reset_caster(pp=10)
        self._reset_all_allies()
        self._reset_enemies()
        # 用enemy_cf攻撃ally_front_center（友方被攻撃）
        # 需要让enemy_cf的攻击指定ally_front_center
        # trigger_after_ally_attacked 应收集PS2
        # 此处验证trigger_service能匹配该PS
        from src.combat_v2.services.trigger_service import TriggerContext
        # 先检查PS2的trigger_type配置
        parsed = self.dl.get_parsed_skill_data(130062)
        self.assertEqual(parsed.get('trigger_type'), 'after_ally_attacked',
                         "PS2 trigger_type应为after_ally_attacked")

    def test_ps2_targets_highest_atk_enemy(self):
        """PS2(130062) 反撃攻撃最高ATK敵単体（target_identifier=null，非trigger_attacker）。"""
        self._reset_caster(pp=10)
        self._reset_all_allies()
        self._reset_enemies()

        # enemy_cb ATK=15000 是最高，应被PS2攻击
        # 模拟PS2触发：直接inline执行
        actions = self.ts.trigger_after_ally_attacked(
            targets=[self.ally_front_center], battlefield=self.bf,
            actor=self.enemy_cf, primary_target=self.ally_front_center,
        )
        ps2_actions = [a for a in actions if a.skill_id == 130062]
        if ps2_actions:
            hp_cb_before = self.enemy_cb.current_hp
            self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_ally_attacked")
            # 验证enemy_cb(最高ATK)受伤
            self.assertLess(self.enemy_cb.current_hp, hp_cb_before,
                            "enemy_cb(最高ATK)应被PS2反撃受伤")
            # 验证enemy_cf(攻击者)未被反撃（PS2针对最高ATK敌，非攻击者）
            # 注：enemy_cf可能因AS2等受伤，本测试中PS2仅攻enemy_cb

    def test_ps2_target_is_ally_includes_self(self):
        """PS2(130062) target_is_ally条件：自身被攻撃時也触发（exclude_self未配置）。"""
        self._reset_caster(pp=10)
        self._reset_all_allies()
        self._reset_enemies()

        # caster自身被攻撃
        actions = self.ts.trigger_after_ally_attacked(
            targets=[self.caster], battlefield=self.bf,
            actor=self.enemy_cf, primary_target=self.caster,
        )
        ps2_actions = [a for a in actions if a.skill_id == 130062]
        # target_is_ally 未配置 exclude_self → 自身被攻撃也触发
        self.assertGreater(len(ps2_actions), 0,
                           "caster自身被攻撃時PS2也触发（target_is_ally含自身）")

    def test_ps2_no_trigger_when_attacker_is_ally(self):
        """PS2(130062) 攻撃者是友方時不触发（after_ally_attacked僅対敵方攻撃）。"""
        self._reset_caster(pp=10)
        self._reset_all_allies()
        self._reset_enemies()

        # 攻撃者是友方
        actions = self.ts.trigger_after_ally_attacked(
            targets=[self.ally_front_center], battlefield=self.bf,
            actor=self.ally_back_left, primary_target=self.ally_front_center,
        )
        ps2_actions = [a for a in actions if a.skill_id == 130062]
        # 攻撃者=友方 → 不应触发
        self.assertEqual(len(ps2_actions), 0, "攻撃者是友方時PS2不应触发")

    def test_ps2_cooldown_1(self):
        """PS2(130062) cooldown=1，触发后设为1。"""
        self._reset_caster(pp=10)
        self._reset_all_allies()
        self._reset_enemies()

        actions = self.ts.trigger_after_ally_attacked(
            targets=[self.ally_front_center], battlefield=self.bf,
            actor=self.enemy_cf, primary_target=self.ally_front_center,
        )
        ps2_actions = [a for a in actions if a.skill_id == 130062]
        if ps2_actions:
            self.ss._execute_trigger_actions_inline(ps2_actions, self.bf, "after_ally_attacked")
            self.ss.update_cooldown_after_skill_use(self.caster, 130062)
            self.assertEqual(self.caster.skill_cooldowns.get(130062), 1,
                             "PS2触发后cooldown应为1")

    # ════════════════════════════════════════════════════════════════
    # 配置/数据完整性测试
    # ════════════════════════════════════════════════════════════════

    def test_all_skills_loadable(self):
        """所有技能可正常加载。"""
        for sid in [110016, 120053, 120054, 130061, 130062]:
            parsed = self.dl.get_parsed_skill_data(sid)
            self.assertIsNotNone(parsed, f"skill {sid} 应可加载")
            self.assertNotEqual(parsed.get('parse_status'), 'failed',
                                f"skill {sid} parse_status 不应为 failed")

    def test_ps_trigger_type_valid(self):
        """PS技能trigger_type合法。"""
        from src.combat_v2.services.trigger_service import TRIGGER_TYPE_MAP
        for sid in [130061, 130062]:
            parsed = self.dl.get_parsed_skill_data(sid)
            trig = parsed.get('trigger_type')
            self.assertIsNotNone(trig, f"skill {sid} trigger_type不应为空")
            self.assertIn(trig, TRIGGER_TYPE_MAP,
                          f"skill {sid} trigger_type '{trig}' 应在TRIGGER_TYPE_MAP中")

    def test_character_data_loadable(self):
        """角色数据可正常加载。"""
        cdata = self.dl.load_characters().get(101301)
        self.assertIsNotNone(cdata, "101301 角色数据应可加载")
        self.assertEqual(cdata.character_type, 2, "character_type应为2(特殊型)")
        self.assertEqual(cdata.attribute, 4, "attribute应为4(風)")


if __name__ == '__main__':
    unittest.main(verbosity=2)
