#!/usr/bin/env python3
"""
对抗压制战（公会战）数据导入脚本
scripts/import_circle_battle.py

从 split_data 原始解包数据中提取对抗压制战敌方阵容信息，
输出到 data/circle_battle_enemies.json

用法: python scripts/import_circle_battle.py [--season 5]
"""

import json
import sys
from pathlib import Path

# ─── 路径配置 ──────────────────────────────────────────────────────────────────
SCRIPT_DIR = Path(__file__).parent.parent
SPLIT_DATA_DIR = SCRIPT_DIR / "split_data"
OUTPUT_DIR = SCRIPT_DIR / "data"

# ─── 站位映射 ──────────────────────────────────────────────────────────────────
POSITION_NAMES = {
    1: "左前", 2: "中前", 3: "右前",
    4: "左後", 5: "中後", 6: "右後",
}


def load_json(filename: str):
    filepath = SPLIT_DATA_DIR / filename
    with open(filepath, "r", encoding="utf-8") as f:
        return json.load(f)


def build_index(data: list, key: str) -> dict:
    return {item[key]: item for item in data if item.get(key) is not None}


def build_multi_index(data: list, key: str) -> dict:
    index: dict = {}
    for item in data:
        k = item.get(key)
        if k is not None:
            index.setdefault(k, []).append(item)
    return index


def calc_stat(base: int, per_level, level: int) -> int:
    """计算含等级加成的最终属性值"""
    if per_level and per_level != 0:
        return int(base + per_level * (level - 1))
    return int(base)


def get_season_quest_ids(boss_data: list, season_id: int) -> list:
    """获取指定赛季所有脅威度レベルA的QuestMasterId列表（已排序）
    脅威度レベルA 对应 DifficultType=4。
    每个赛季存在两组脅威度レベルA quest：
      - 首通版（如第五赛季 80061xxx、第六赛季 80071xxx），属性较低
      - 重复版（如第五赛季 80062xxx、第六赛季 80072xxx），属性较高
    按原开发方案约定采用首通版，quest_id 排序后取前 100 个（属性较低的一组）。"""
    quest_ids = []
    seen = set()
    for entry in boss_data:
        if (entry.get("CircleBattleMasterId") == season_id
                and entry.get("Name") == "脅威度レベルA"
                and entry.get("QuestMasterId") is not None):
            qid = entry["QuestMasterId"]
            if qid in seen:
                continue
            seen.add(qid)
            quest_ids.append(qid)
    quest_ids.sort()
    # 取前 100 个（首通版），过滤重复版
    if len(quest_ids) > 100:
        first_batch = quest_ids[:100]
        print(f"[INFO] 赛季 {season_id} 共 {len(quest_ids)} 个脅威度レベルA quest，"
              f"取首通版前 100 个：{first_batch[0]} ~ {first_batch[-1]}")
        quest_ids = first_batch
    return quest_ids


def extract_enemy_data(enemy_master: dict, level: int, slot: int,
                       skill_map_index: dict) -> dict:
    """从EnemyMaster提取敌方单位数据"""
    # 获取技能列表 + 每个技能的等级 (EnemySkillMaster.Level)
    skill_mappings = skill_map_index.get(enemy_master["Id"], [])
    skill_ids = sorted([sm["SkillMasterId"] for sm in skill_mappings
                        if sm.get("SkillMasterId") is not None])
    # 提取每个技能的等级 (默认1)
    skill_levels = {sm["SkillMasterId"]: sm.get("Level", 1)
                    for sm in skill_mappings
                    if sm.get("SkillMasterId") is not None}

    return {
        "slot": slot,
        "position": slot,
        "enemy_id": enemy_master["Id"],
        "model_asset_id": enemy_master.get("ModelAssetId", ""),
        "name": enemy_master.get("Name", "???"),
        "level": level,
        "hp": calc_stat(enemy_master.get("Hp", 0), enemy_master.get("HpPerLevel", 0), level),
        "attack": calc_stat(enemy_master.get("Attack", 0), enemy_master.get("AttackPerLevel", 0), level),
        "defense": calc_stat(enemy_master.get("Defense", 0), enemy_master.get("DefensePerLevel", 0), level),
        "speed": calc_stat(enemy_master.get("Speed", 0), enemy_master.get("SpeedPerLevel", 0), level),
        "critical_rate": enemy_master.get("CriticalRate", 0.0),
        "attribute": enemy_master.get("Attribute", 1),
        "type": enemy_master.get("Type", 1),
        "role_type": enemy_master.get("RoleType", 0),
        "rarity": enemy_master.get("Rarity", 1),
        "action_point": enemy_master.get("ActionPoint", 2),
        "passive_point": enemy_master.get("PassivePoint", 2),
        "skill_ids": skill_ids,
        "skill_levels": skill_levels,
    }


def import_season(season_id: int, quest_data, party_data, enemy_data,
                  skill_map_data, skill_data) -> dict:
    """导入指定赛季的所有阶段数据"""
    # 构建索引
    quest_index = build_index(quest_data, "Id")
    party_index = build_index(party_data, "Id")
    enemy_index = build_index(enemy_data, "Id")
    skill_map_index = build_multi_index(skill_map_data, "EnemyMasterId")
    skill_index = build_index(skill_data, "Id")

    # 获取该赛季的quest id列表
    # 从CircleBattleBossMaster获取
    boss_data = load_json("CircleBattleBossMaster.json")
    quest_ids = get_season_quest_ids(boss_data, season_id)

    if not quest_ids:
        print(f"[警告] 赛季 {season_id} 未找到脅威度レベルA的quest数据")
        return {}

    print(f"[INFO] 赛季 {season_id}: 共 {len(quest_ids)} 个阶段")
    print(f"  Quest ID 范围: {quest_ids[0]} ~ {quest_ids[-1]}")

    season_data = {}
    all_skill_ids = set()

    for stage_num, quest_id in enumerate(quest_ids, 1):
        quest = quest_index.get(quest_id)
        if not quest:
            print(f"  [警告] 阶段 {stage_num}: 找不到 QuestMaster Id={quest_id}")
            continue

        party_id = quest.get("EnemyPartyMasterId")
        party = party_index.get(party_id)
        if not party:
            print(f"  [警告] 阶段 {stage_num}: 找不到 EnemyPartyMaster Id={party_id}")
            continue

        max_turn = quest.get("MaxTurn", 5)

        # 从CircleBattleBossMaster获取弱点属性
        weakness_attr = None
        for entry in boss_data:
            if entry.get("QuestMasterId") == quest_id:
                weakness_attr = entry.get("WeaknessAttribute")
                break

        enemies = []
        for slot in range(1, 7):
            master_id = party.get(f"Enemy{slot}MasterId")
            level = party.get(f"Enemy{slot}Level")
            if master_id is not None and level is not None:
                enemy_master = enemy_index.get(master_id)
                if enemy_master:
                    enemy = extract_enemy_data(enemy_master, level, slot, skill_map_index)
                    enemies.append(enemy)
                    all_skill_ids.update(enemy["skill_ids"])
                else:
                    print(f"  [警告] 阶段 {stage_num} 格位 {slot}: 找不到 EnemyMaster Id={master_id}")

        stage_data = {
            "quest_id": quest_id,
            "max_turn": max_turn,
            "weakness_attribute": weakness_attr,
            "enemies": enemies,
        }
        season_data[str(stage_num)] = stage_data

        if stage_num <= 3 or stage_num % 20 == 0:
            enemy_names = [e["name"] for e in enemies]
            print(f"  阶段 {stage_num}: {len(enemies)}个敌人, MaxTurn={max_turn}, {enemy_names}")

    # 输出技能清单
    print(f"\n[INFO] 赛季 {season_id} 涉及 {len(all_skill_ids)} 个不重复技能ID:")
    for sid in sorted(all_skill_ids):
        skill = skill_index.get(sid)
        skill_name = skill.get("Name", "???") if skill else "???"
        print(f"  {sid}: {skill_name}")

    return season_data, sorted(all_skill_ids)


def main():
    season_id = 5
    if "--season" in sys.argv:
        idx = sys.argv.index("--season")
        if idx + 1 < len(sys.argv):
            season_id = int(sys.argv[idx + 1])

    # merge 模式：默认开启，保留已有赛季数据；--no-merge 关闭
    merge_mode = "--no-merge" not in sys.argv

    print(f"========== 对抗压制战数据导入 ==========")
    print(f"目标赛季: 第 {season_id} 赛季")
    print(f"合并模式: {'开启（保留已有赛季）' if merge_mode else '关闭（覆盖整个文件）'}")
    print(f"数据源: {SPLIT_DATA_DIR}")
    print(f"输出到: {OUTPUT_DIR}")
    print()

    # 加载数据
    print("正在加载数据文件...")
    quest_data = load_json("QuestMaster.json")
    party_data = load_json("EnemyPartyMaster.json")
    enemy_data = load_json("EnemyMaster.json")
    skill_map_data = load_json("EnemySkillMaster.json")
    skill_data = load_json("SkillMaster.json")
    print("数据加载完成。\n")

    # 导入赛季数据
    result = import_season(season_id, quest_data, party_data, enemy_data,
                           skill_map_data, skill_data)

    if not result:
        print("[错误] 未获取到数据，退出。")
        return

    season_data, all_skill_ids = result

    # 构建输出：merge 模式下保留已有赛季
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    output_path = OUTPUT_DIR / "circle_battle_enemies.json"

    if merge_mode and output_path.exists():
        with open(output_path, "r", encoding="utf-8") as f:
            existing = json.load(f)
        print(f"[INFO] 合并模式：保留已有 {len(existing)} 个赛季数据")
    else:
        existing = {}

    existing[f"season_{season_id}"] = season_data
    output = existing

    # 写入文件
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(output, f, ensure_ascii=False, indent=2)

    print(f"\n[OK] 数据已写入: {output_path}")
    print(f"  赛季 {season_id}: {len(season_data)} 个阶段")
    print(f"  技能清单: {all_skill_ids}")


if __name__ == "__main__":
    main()
