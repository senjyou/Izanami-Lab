"""Real E2E test: リフシルト def_up duration with real _process_aura_expiry
AND narrative log verification.

Verifies:
1. Duration is NOT decremented at cast action end (stays 2).
2. Narrative does NOT output "[效果更新]" for the def_up buff.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import BuffState
from src.entities_v2.enums import Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig
from src.combat_v2.battle_narrative import BattleNarrativeWriter

STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value


class TestRifshildRealE2E(unittest.TestCase):

    def _build(self, skills=None, with_narrative=False):
        bb = BattleBuilder()
        bb.add_ally(unit_id="caster", hp=20000, atk=10000,
                    skills=skills or [220069], level=10, speed=500)
        bb.add_enemy(unit_id="enemy", position=Position.ENEMY_CENTER_FRONT, hp=50000, speed=100)
        ctx = bb.build()
        bf = ctx['bf']
        ss = ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")
        narrative = BattleNarrativeWriter(data_loader=ctx['services']['dl']) if with_narrative else None
        controller = BattleFlowController(
            bf, BattleConfig(max_turns=1),
            data_loader=ctx['services']['dl'], narrative=narrative)
        controller._build_display_names()
        return controller, bf, ss, caster, narrative

    def test_new_buff_no_duration_decrement_no_narrative_log(self):
        """New def_up: duration stays 2 AND no [效果更新] narrative log for StatusDefense."""
        controller, bf, ss, caster, narrative = self._build(with_narrative=True)

        result = ss.execute_skill(caster=caster, skill_id=220069, battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])

        def_ups = [b for b in caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertEqual(len(def_ups), 1)
        buff = def_ups[0]
        self.assertEqual(buff.duration, 2)

        controller._process_aura_expiry(caster)

        # Duration must stay 2
        self.assertEqual(buff.duration, 2,
                         "duration should NOT decrement (expected 2, got %d)" % buff.duration)

        # Narrative must NOT contain [效果更新] for StatusDefense
        lines = narrative._lines
        sd_updates = [l for l in lines if "效果更新" in l and "StatusDefense" in l]
        print("[NARRATIVE] All effect_update lines:")
        for l in lines:
            if "效果更新" in l:
                print(f"  {l}")
        self.assertEqual(len(sd_updates), 0,
                         "should NOT have [效果更新] for StatusDefense, but found: %s" % sd_updates)

    def test_coexisting_buff_new_not_decremented_no_narrative_log(self):
        """Pre-existing def_up (PS 230029, duration=1) coexists with new
        リフシルト def_up (duration=2). New buff is just_applied → not
        decremented, no [效果更新] log. Pre-existing expires normally."""
        controller, bf, ss, caster, narrative = self._build(with_narrative=True)

        pre_existing = BuffState(
            buff_id="ps_230029_StatusDefense_caster",
            name="StatusDefense",
            effect_type=STATUS_DEFENSE,
            value=15.0,
            duration=1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=caster.unit_id,
            source_skill_id=230029,
        )
        caster.buffs.append(pre_existing)

        result = ss.execute_skill(caster=caster, skill_id=220069, battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])

        # Both buffs coexist (different skills → different buff_ids)
        def_ups = [b for b in caster.buffs if b.effect_type == STATUS_DEFENSE]
        self.assertEqual(len(def_ups), 2, "both def_up buffs should coexist")

        new_buff = next(b for b in def_ups if b.source_skill_id == 220069)
        old_buff = next(b for b in def_ups if b.source_skill_id == 230029)
        self.assertEqual(new_buff.duration, 2, "new buff duration should be 2")
        self.assertTrue(new_buff.just_applied, "new buff should be just_applied")
        self.assertEqual(old_buff.duration, 1, "pre-existing buff NOT refreshed (coexist)")

        controller._process_aura_expiry(caster)

        # New buff: protected by just_applied, stays at 2
        self.assertEqual(new_buff.duration, 2,
                         "new buff: duration should NOT decrement (expected 2, got %d)" % new_buff.duration)
        # Old buff: decremented normally (1→0, expires)
        self.assertEqual(old_buff.duration, 0,
                         "pre-existing buff: should be decremented to 0 (expires)")

        # Narrative: NO [效果更新] for the new (just_applied) StatusDefense.
        # The old buff (dur 1→0) doesn't get [効果更新] either (dur_after=0, not >0).
        # It gets [失去] (expired) instead.
        lines = narrative._lines
        sd_updates = [l for l in lines if "效果更新" in l and "StatusDefense" in l]
        print("[NARRATIVE] All effect_update lines:")
        for l in lines:
            if "效果更新" in l:
                print(f"  {l}")
        self.assertEqual(len(sd_updates), 0,
                         "should NOT have [效果更新] for StatusDefense, but found: %s" % sd_updates)


if __name__ == '__main__':
    unittest.main(verbosity=2)
