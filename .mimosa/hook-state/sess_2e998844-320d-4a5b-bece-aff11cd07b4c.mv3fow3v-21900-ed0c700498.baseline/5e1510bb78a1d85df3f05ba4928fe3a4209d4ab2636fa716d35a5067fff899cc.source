        """PS1(130058) 配置: trigger_type=on_hp_below。"""
        parsed = self.dl.get_parsed_skill_data(PS_WALL)
        self.assertEqual(parsed.get("trigger_type"), "on_hp_below",
                         "PS1 trigger_type 应为 on_hp_below")

    def test_config_ps1_global_condition_self_hp_percent_30(self):
        """PS1(130058) 配置: global_condition self_hp_percent<=30。"""
        parsed = self.dl.get_parsed_skill_data(PS_WALL)
        gc = parsed.get("global_condition")
        self.assertIsNotNone(gc, "PS1 应有 global_condition")
        self.assertEqual(gc.get("type"), "self_hp_percent")
