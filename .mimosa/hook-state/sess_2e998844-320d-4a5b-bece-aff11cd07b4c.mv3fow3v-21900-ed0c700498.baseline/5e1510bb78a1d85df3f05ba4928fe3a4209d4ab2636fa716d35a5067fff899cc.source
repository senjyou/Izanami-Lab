            ps2_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 验证 atk_up buff 付与
        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "PS2 应付与 atk_up buff")
        # 验证 hp_ratio_dynamic_inverse 标记
        self.assertTrue(getattr(atk_ups[0], 'hp_ratio_dynamic_inverse', False),
                        "atk_up 应有 hp_ratio_dynamic_inverse 标记")
        # 验证 stackable
        self.assertTrue(atk_ups[0].is_stackable, "atk_up 应 stackable=True")
        # 验证 duration=1
        self.assertEqual(atk_ups[0].duration, 1, "atk_up duration 应为 1")

