        self.assertGreater(len(ps2_actions), 0,
                           "caster 被 AS 攻击前 PS2 应被收集")

    def test_ps2_grants_cheat_death_buff(self):
        """PS2(130059) Block1: cheat_death buff付与（HP1忍耐）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
