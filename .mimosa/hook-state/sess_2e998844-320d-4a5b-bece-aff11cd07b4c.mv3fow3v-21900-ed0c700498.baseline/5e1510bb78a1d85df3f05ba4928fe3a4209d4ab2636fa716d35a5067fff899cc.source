    def test_config_ps2_cheat_death_duration_neg1_turn(self):
        """PS2(130059) 配置: cheat_death duration=-1, duration_type=turn。"""
        parsed = self.dl.get_parsed_skill_data(PS_MADA)
        blocks = parsed.get("effect_blocks", [])
        self.assertGreater(len(blocks), 0)
        effects = blocks[0].get("effects", [])
        cheat_effects = [e for e in effects if e.get("effect_type") == "cheat_death"]
        self.assertGreater(len(cheat_effects), 0, "PS2 应有 cheat_death 效果")
        self.assertEqual(cheat_effects[0].get("duration"), -1,
                         "cheat_death duration 应为 -1")
        self.assertEqual(cheat_effects[0].get("duration_type"), "turn",
                         "cheat_death duration_type 应为 turn")

