        self.assertGreater(len(cheat_buffs), 0, "PS2 应付与 cheat_death buff")
        # value=0 表示 HP1 忍耐
        self.assertEqual(cheat_buffs[0].value, 0, "cheat_death value 应为 0（HP1忍耐）")
        # duration=-1, duration_type=turn
        self.assertEqual(cheat_buffs[0].duration, -1, "cheat_death duration 应为 -1")

    def test_ps2_grants_atk_up_with_hp_ratio_dynamic_inverse(self):
        """PS2(130059) Block1: atk_up buff付与（hp_ratio_dynamic_inverse）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
