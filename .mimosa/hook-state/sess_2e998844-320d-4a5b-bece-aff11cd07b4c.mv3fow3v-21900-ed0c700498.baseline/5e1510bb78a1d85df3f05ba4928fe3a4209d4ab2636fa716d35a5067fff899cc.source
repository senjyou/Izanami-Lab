    # 配置校验
    # ════════════════════════════════════════════════════════════════

    def test_config_ps1_cooldown_99(self):
        """PS1(130058) 配置: cooldown=99（戦闘中1度のみ）。"""
        parsed = self.dl.get_parsed_skill_data(PS_WALL)
        self.assertIsNotNone(parsed, "PS1 应有 parsed 数据")
        self.assertEqual(parsed.get("cooldown"), 99,
                         "PS1 cooldown 应为 99")

