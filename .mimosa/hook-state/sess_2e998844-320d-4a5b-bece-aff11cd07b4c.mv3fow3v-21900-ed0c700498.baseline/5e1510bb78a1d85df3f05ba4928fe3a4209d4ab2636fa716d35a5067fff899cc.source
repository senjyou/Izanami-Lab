    def test_config_ps3_dmg_dealt_up_attack_limited_1(self):
        """PS3(130060) 配置: dmg_dealt_up flags.attack_limited=1, stackable=true。"""
        parsed = self.dl.get_parsed_skill_data(PS_BOOST)
        blocks = parsed.get("effect_blocks", [])
        effects = blocks[0].get("effects", [])
        dmg_ups = [e for e in effects if e.get("effect_type") == "dmg_dealt_up"]
        self.assertGreater(len(dmg_ups), 0, "PS3 应有 dmg_dealt_up 效果")
