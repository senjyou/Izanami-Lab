            ps1_actions, self.bf, trigger_timing="on_hp_below"
        )

        # 验证 shield buff 付与
        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertGreater(len(shield_buffs), 0, "PS1 应付与 shield buff")
        self.assertEqual(shield_buffs[0].duration, 3, "shield duration 应为 3 actions")

    def test_ps1_shield_amount_max_hp_based(self):
        """PS1(130058) shield: shield值=max_hp*shield%（Lv10=30%）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self.caster.skill_cooldowns = {}

        self.caster.prev_hp_percent = 50.0
        self.caster.current_hp = int(self.caster.max_hp * 0.20)

        actions = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1_actions = [a for a in actions if a.skill_id == PS_WALL]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_hp_below"
        )

        # shield 值应为 max_hp * 30% = 20000 * 0.30 = 6000
        # 注意：caster.shield 字段记录总盾值
        self.assertGreater(self.caster.shield, 0, "caster.shield 应大于 0")
        expected_shield = int(self.caster.max_hp * 0.30)
        self.assertEqual(self.caster.shield, expected_shield,
                         f"shield 值应为 max_hp*30%={expected_shield}，实际 {self.caster.shield}")

    def test_ps1_cooldown_99_once_per_battle(self):
        """PS1(130058) cooldown=99: 戦闘中1度しか発動しない。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self.caster.skill_cooldowns = {}

        # 第一次触发
        self.caster.prev_hp_percent = 50.0
        self.caster.current_hp = int(self.caster.max_hp * 0.20)
        actions1 = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1_1 = [a for a in actions1 if a.skill_id == PS_WALL]
        self.assertGreater(len(ps1_1), 0, "第一次应触发 PS1")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_1, self.bf, trigger_timing="on_hp_below"
        )

        # 验证 cooldown 已设置为 99
        self.assertEqual(self.caster.skill_cooldowns.get(PS_WALL), 99,
                         "PS1 触发后 cooldown 应为 99")

        # 第二次触发（PS1 在冷却中，不应再被收集）
        actions2 = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1_2 = [a for a in actions2 if a.skill_id == PS_WALL]
        self.assertEqual(len(ps1_2), 0, "PS1 冷却中 → 不应再次被收集")

