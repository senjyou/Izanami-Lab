    def test_ps2_atk_up_high_hp_low_effect(self):
        """PS2(130059) hp_ratio_dynamic_inverse: HP高时 atk_up 效果低。

        场景：caster HP=100% → atk_up effective = 0%（buff.value * (1-1.0) = 0）
        场景：caster HP=0%   → atk_up effective = max（buff.value * (1-0) = max）
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 触发 PS2
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == PS_MADA]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="before_as_attacked"
        )

        atk_ups = [b for b in self.caster.buffs if b.effect_type == STATUS_ATTACK]
        self.assertGreater(len(atk_ups), 0, "应有 atk_up buff")
        # buff.value 应为 Lv10 atk tag 值（40.0）
        self.assertGreater(atk_ups[0].value, 0, "atk_up buff.value 应大于 0（Lv10 atk tag=40）")

        # HP=100% 时实际有效攻击力应等于基础攻击力（无加成）
        self.caster.current_hp = self.caster.max_hp
        effective_atk_full_hp = self.dms._calculate_final_stat(self.caster, "attack")
        # HP=100% → hp_ratio_dynamic_inverse = buff.value * (1-1.0) = 0
        # 实际 atk 应等于基础 attack
        self.assertEqual(effective_atk_full_hp, self.caster.attack,
                         f"HP=100% 时 atk_up effective 应为 0，实际 atk={effective_atk_full_hp} 应等于基础 {self.caster.attack}")

    def test_ps2_atk_up_low_hp_high_effect(self):
        """PS2(130059) hp_ratio_dynamic_inverse: HP低时 atk_up 效果高。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == PS_MADA]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # HP=10% 时实际有效攻击力应高于基础攻击力
        self.caster.current_hp = int(self.caster.max_hp * 0.10)
        effective_atk_low_hp = self.dms._calculate_final_stat(self.caster, "attack")
        # HP=10% → effective = buff.value * (1-0.1) = buff.value * 0.9
        # 实际 atk 应大于基础 attack
        self.assertGreater(effective_atk_low_hp, self.caster.attack,
                           f"HP=10% 时 atk_up effective 应大于 0，实际 atk={effective_atk_low_hp} 应 > 基础 {self.caster.attack}")

    def test_ps2_atk_up_monotonic_decrease_with_hp(self):
        """PS2(130059) hp_ratio_dynamic_inverse: HP越高，atk加成越低（单调递减）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == PS_MADA]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 测试多个 HP 比例下的实际攻击力
        results = {}
        for hp_pct in [100, 75, 50, 25, 10]:
            self.caster.current_hp = int(self.caster.max_hp * hp_pct / 100)
            results[hp_pct] = self.dms._calculate_final_stat(self.caster, "attack")

        # HP 越低，atk 应越高（单调）
        self.assertGreater(results[10], results[25],
                           f"HP10%({results[10]}) 应 > HP25%({results[25]})")
        self.assertGreater(results[25], results[50],
                           f"HP25%({results[25]}) 应 > HP50%({results[50]})")
        self.assertGreater(results[50], results[75],
                           f"HP50%({results[50]}) 应 > HP75%({results[75]})")
        self.assertGreaterEqual(results[100], self.caster.attack,
                                f"HP100%({results[100]}) 应 >= 基础({self.caster.attack})")

    def test_ps2_cheat_death_survives_lethal_damage(self):
        """PS2(130059) cheat_death: 致命伤害时HP1保留。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 触发 PS2 付与 cheat_death
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == PS_MADA]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="before_as_attacked"
        )

        # 验证 cheat_death buff 存在
        cheat_buffs = [b for b in self.caster.buffs if b.effect_type in (CHEAT_DEATH, "cheat_death", "CheatDeath")]
        self.assertGreater(len(cheat_buffs), 0, "应有 cheat_death buff")

        # 设置 caster HP=100，然后让其受到致命伤害
        self.caster.current_hp = 100
        # 用 enemy_cf 直接攻击 caster 造成致命伤害
        # 简化：直接调用 _apply_damage_cheat_death_post_processing 模拟致命伤害
        # 这里用更直接的方式：调用 execute_skill 让 enemy 攻击 caster
        # 简化验证：直接设置 HP=0 并调用 cheat_death 处理
        # 实际通过 execute_skill 让 enemy_cf 攻击 caster
        # 但 caster 是 ally，enemy_cf 不能直接 select_targets 到 caster
        # 改用：直接设置 caster.current_hp = 0，然后调用 cheat_death 处理逻辑
        # 验证 cheat_death buff 会将 caster.current_hp 恢复到 1

        # 模拟致命伤害：将 HP 直接设为 0，然后调用 cheat_death 处理
        # 由于 cheat_death 处理在 _apply_damage_post_hit_effects 中，
        # 我们可以通过将 caster.current_hp 设为 0 来验证逻辑
        # 但更准确的方式是让 enemy_cf 用一个 damage 技能攻击 caster

        # 简化测试：直接调用 cheat_death 处理逻辑
        # 创建一个 mock dmg_skill_obj
        class MockDmgObj:
            hit_count = 1
        mock = MockDmgObj()

        self.caster.current_hp = 0  # 致命伤害
        # 调用 cheat_death 处理
        self.ss._apply_damage_handle_post_hit_target_effects(
            target=self.caster, dmg_skill_obj=mock, hp_before=100,
            actual_damage=100, shield_absorbed=0, effect_flags={},
            targets_hit=[{"target_id": self.caster.unit_id}]
        )

        # cheat_death 应使 caster HP 恢复到 1
        self.assertEqual(self.caster.current_hp, 1,
                         f"cheat_death 应使 HP 保留 1，实际 {self.caster.current_hp}")

        # cheat_death buff 应被消耗（移除）
        cheat_after = [b for b in self.caster.buffs if b.effect_type in (CHEAT_DEATH, "cheat_death", "CheatDeath")]
        self.assertEqual(len(cheat_after), 0,
                         "cheat_death 应在致命伤害后被消耗")

    def test_ps2_no_cheat_death_after_consumed(self):
        """PS2(130059) cheat_death: 消耗后再次致命伤害时不再触发。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 触发 PS2 付与 cheat_death
        actions = self.ts.trigger_before_as_attacked(
            targets=[self.caster], battlefield=self.bf, attacker=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == PS_MADA]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="before_as_attacked"
        )

        class MockDmgObj:
            hit_count = 1
        mock = MockDmgObj()

        # 第一次致命伤害：cheat_death 触发
        self.caster.current_hp = 0
        self.ss._apply_damage_handle_post_hit_target_effects(
            target=self.caster, dmg_skill_obj=mock, hp_before=100,
            actual_damage=100, shield_absorbed=0, effect_flags={},
            targets_hit=[{"target_id": self.caster.unit_id}]
        )
        self.assertEqual(self.caster.current_hp, 1, "第一次致命伤害 cheat_death 应触发")

        # 第二次致命伤害：无 cheat_death，加入 pending_deaths
        self.caster.current_hp = 0
        # 清空 pending_deaths 以便验证
        self.ss._pending_deaths = set()
        self.ss._apply_damage_handle_post_hit_target_effects(
            target=self.caster, dmg_skill_obj=mock, hp_before=1,
            actual_damage=1, shield_absorbed=0, effect_flags={},
            targets_hit=[{"target_id": self.caster.unit_id}]
        )
        # 无 cheat_death → HP 保持 0，加入 pending_deaths
        self.assertEqual(self.caster.current_hp, 0,
                         "第二次致命伤害无 cheat_death，HP 应保持 0")
        self.assertIn(self.caster.unit_id, self.ss._pending_deaths,
                      "无 cheat_death 时应加入 pending_deaths")

