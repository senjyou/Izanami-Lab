    def test_ps3_dmg_dealt_up_value_resolved(self):
        """PS3(130060) dmg_dealt_up: value 通过 value_tag=dmg 解析为 Lv10=40%。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=AS_CRISIS, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == PS_BOOST]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_skill_use"
        )

        dmg_ups = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_ups), 0, "应有 dmg_dealt_up buff")
        # Lv10 dmg tag=40.0
        self.assertGreater(dmg_ups[0].value, 0,
                          f"dmg_dealt_up value 应大于 0（Lv10 dmg tag=40），实际 {dmg_ups[0].value}")

    def test_ps3_cooldown_1(self):
        """PS3(130060) cooldown=1: 触发后设置 cooldown=1。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=AS_CRISIS, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == PS_BOOST]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_skill_use"
        )

        self.assertEqual(self.caster.skill_cooldowns.get(PS_BOOST), 1,
                         "PS3 触发后 cooldown 应为 1")

    def test_ps3_cooldown_blocks_retrigger(self):
        """PS3(130060) cooldown=1: 第一次触发后冷却中，第二次不应再被收集。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 第一次触发
        actions1 = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=AS_CRISIS, battlefield=self.bf
        )
        ps3_1 = [a for a in actions1 if a.skill_id == PS_BOOST]
        self.assertGreater(len(ps3_1), 0, "第一次应触发 PS3")
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_1, self.bf, trigger_timing="before_skill_use"
        )

        # 第二次触发（PS3 在冷却中）
        actions2 = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=AS_CRISIS, battlefield=self.bf
        )
        ps3_2 = [a for a in actions2 if a.skill_id == PS_BOOST]
        self.assertEqual(len(ps3_2), 0, "PS3 在冷却中 → 不应再次被收集")

    # ════════════════════════════════════════════════════════════════
    # 集成场景：PS3 触发 → AS 攻击 → dmg_dealt_up 消耗
    # ════════════════════════════════════════════════════════════════

    def test_integration_ps3_then_as_more_damage(self):
        """集成：PS3 触发付与 dmg_dealt_up → AS 攻击伤害提升 → buff 消耗。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()

        # 场景1: 无 PS3 buff，AS 攻击 baseline 伤害
        hp_before_1 = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_CRISIS, battlefield=self.bf, skip_cost=True
        )
        dmg_without_buff = hp_before_1 - self.enemy_cf.current_hp

        # 重置并触发 PS3
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        actions = self.ts.trigger_before_skill_use(
            actor=self.caster, skill_id=AS_CRISIS, battlefield=self.bf
        )
        ps3_actions = [a for a in actions if a.skill_id == PS_BOOST]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="before_skill_use"
        )

        # 验证 buff 存在
        dmg_ups_before = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_ups_before), 0, "AS 前应有 dmg_dealt_up buff")

        # 场景2: 有 PS3 buff，AS 攻击应造成更高伤害
        hp_before_2 = self.enemy_cf.current_hp
        self.ss.execute_skill(
            caster=self.caster, skill_id=AS_CRISIS, battlefield=self.bf, skip_cost=True
        )
        dmg_with_buff = hp_before_2 - self.enemy_cf.current_hp

        # 有 buff 时伤害应高于无 buff 时
        self.assertGreater(dmg_with_buff, dmg_without_buff,
                           f"PS3 buff 应提升 AS 伤害: 有buff({dmg_with_buff}) > 无buff({dmg_without_buff})")

        # 验证 buff 被消耗
        dmg_ups_after = [b for b in self.caster.buffs if b.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_ups_after), 0,
                         "AS 攻击后 dmg_dealt_up 应被消耗（attack_limited=1）")

