    def test_config_as_hp_scaling_inverse_max_150(self):
        """AS(120052) 配置: hp_scaling_inverse max=150。"""
        parsed = self.dl.get_parsed_skill_data(AS_CRISIS)
        blocks = parsed.get("effect_blocks", [])
        effects = blocks[0].get("effects", [])
        dmg_effects = [e for e in effects if e.get("effect_type") == "damage"]
        self.assertGreater(len(dmg_effects), 0, "AS 应有 damage 效果")
        flags = dmg_effects[0].get("flags", {})
        hp_scaling = flags.get("hp_scaling")
        self.assertIsNotNone(hp_scaling, "AS damage flags 应有 hp_scaling")
        self.assertEqual(hp_scaling.get("max"), 150,
                         "hp_scaling max 应为 150")
        self.assertTrue(flags.get("hp_scaling_inverse"),
                        "hp_scaling_inverse 应为 true")

    def test_config_ex_target_killed_block(self):
        """EX(110006) 配置: Block2 Lv11+ target_killed condition。"""
        parsed = self.dl.get_parsed_skill_data(EX_AKKAN)
        blocks = parsed.get("effect_blocks", [])
        # 找到 target_killed block
        target_killed_block = None
        for b in blocks:
            cond = b.get("condition")
            if cond and cond.get("type") == "and":
                for sub in cond.get("conditions", []):
                    if sub.get("type") == "target_killed":
                        target_killed_block = b
                        break
        self.assertIsNotNone(target_killed_block, "EX 应有 target_killed block")
        # 验证 condition 包含 active_level_min=11 和 target_killed
        cond = target_killed_block.get("condition")
        types = [sub.get("type") for sub in cond.get("conditions", [])]
        self.assertIn("active_level_min", types, "应有 active_level_min 条件")
        self.assertIn("target_killed", types, "应有 target_killed 条件")


