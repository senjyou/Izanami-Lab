# -*- coding: utf-8 -*-
"""回归测试：500301「繋がり合う母娘の絆」EX「母娘の絆」(110083 / 敌方 210128)
的 def_down（防御力低下）应持续到「施法者的下一次行动结束」。

Bug: 配置写成 duration_type="attacker_action"（timing=DURABLE_WHEN_USED），
     导致 def_down 在施法者本次行动结束时就被 _cleanup_guard_buffs 清除，
     施法者下次行动前触发的 PS「ストレラ」(130184) 伤害未享受降防，
     模拟器伤害偏低（347880 vs 实战 353593）。

Fix: 改为 duration_type="action" + flags.duration_owner="caster"
     → timing=DURABLE_SOURCE_MANEUVER_END，在施法者行动结束时递减；
     just_applied 保护使当次行动结束不递减，故存活到施法者的下一次行动结束。

测试用 controller._process_aura_expiry(unit) 模拟单位行动结束。
"""
import os
import sys
import unittest

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig

STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value
SOURCE_END = AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value


def _make_controller(ctx):
    bf = ctx['bf']
    controller = BattleFlowController(
        bf, BattleConfig(max_turns=5),
        data_loader=ctx['services']['dl'])
    controller._build_display_names()
    controller.skill_service.set_battlefield(bf)
    controller._deferred_crit_triggers = []
    return controller, bf


class TestReg110083DefDownDuration(unittest.TestCase):
    """母娘の絆 def_down 生命周期 = 施法者下一次行动结束。"""

    def _setup(self):
        bb = BattleBuilder()
        # 施法者：500301，持有 EX「母娘の絆」(110083)，EP 充足
        bb.add_ally(unit_id="caster", position=Position.ALLY_LEFT_BACK,
                    hp=99999, atk=5000, defense=1000, speed=500,
                    character_id=500301, skills=[110083], level=15, ep=10)
        # 其他友方：用于模拟“非施法者”的行动结束
        bb.add_ally(unit_id="other", position=Position.ALLY_CENTER_BACK,
                    hp=99999, atk=5000, defense=1000, speed=600,
                    skills=[], level=10)
        # 敌方木桩：高HP，不会被击杀
        bb.add_enemy(unit_id="boss", position=Position.ENEMY_CENTER_FRONT,
                     hp=5000000, atk=100, defense=5000, speed=100)
        ctx = bb.build()
        controller, bf = _make_controller(ctx)
        return ctx, controller, bf

    @staticmethod
    def _def_down_debuffs(bf):
        boss = next(u for u in bf.enemy_team if u.unit_id == "boss")
        return [b for b in boss.debuffs if b.effect_type == STATUS_DEFENSE]

    def _apply_def_down(self, controller, bf):
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")
        result = controller.skill_service.execute_skill(caster, 110083, bf)
        self.assertTrue(result.get("success"), "EX 110083 应执行成功")
        return caster

    def test_def_down_applied_with_source_maneuver_timing(self):
        """付与的 def_down 使用 DURABLE_SOURCE_MANEUVER_END（施法者行动结束时递减）。"""
        ctx, controller, bf = self._setup()
        self._apply_def_down(controller, bf)

        debuffs = self._def_down_debuffs(bf)
        self.assertEqual(len(debuffs), 1, "应对最高HP敌付与1个 def_down")
        d = debuffs[0]
        self.assertEqual(d.timing_type, SOURCE_END,
                         "def_down 应为 DURABLE_SOURCE_MANEUVER_END")
        self.assertEqual(d.duration, 1, "付与瞬间 duration 应为 1")
        self.assertGreater(d.value, 0, "降防数值应 > 0")

    def test_def_down_survives_casters_current_action_end(self):
        """施法者本次行动结束：just_applied 保护 → def_down 仍存在。"""
        ctx, controller, bf = self._setup()
        caster = self._apply_def_down(controller, bf)

        controller._process_aura_expiry(caster)

        self.assertEqual(len(self._def_down_debuffs(bf)), 1,
                         "施法者本次行动结束时不应清除 def_down（应为下次行动结束）")

    def test_def_down_survives_other_units_action_end(self):
        """其他单位行动结束：不应递减施法者施加的 def_down。"""
        ctx, controller, bf = self._setup()
        caster = self._apply_def_down(controller, bf)
        other = next(u for u in bf.friend_team if u.unit_id == "other")

        # 施法者本次行动结束（跳过递减，并清除 just_applied）
        controller._process_aura_expiry(caster)
        # 其他单位行动结束（与施法者无关）
        controller._process_aura_expiry(other)

        debuffs = self._def_down_debuffs(bf)
        self.assertEqual(len(debuffs), 1, "其他单位行动结束不应影响 def_down")
        self.assertEqual(debuffs[0].duration, 1, "其他单位行动结束不应递减 duration")

    def test_def_down_removed_at_casters_next_action_end(self):
        """施法者下一次行动结束：def_down 递减 1→0 并过期。"""
        ctx, controller, bf = self._setup()
        caster = self._apply_def_down(controller, bf)
        other = next(u for u in bf.friend_team if u.unit_id == "other")

        # 本次行动结束 → 保护（跳过）
        controller._process_aura_expiry(caster)
        # 其他单位行动
        controller._process_aura_expiry(other)
        self.assertEqual(len(self._def_down_debuffs(bf)), 1, "中途应仍存在")

        # 施法者下一次行动结束 → 递减并过期
        controller._process_aura_expiry(caster)

        self.assertEqual(len(self._def_down_debuffs(bf)), 0,
                         "施法者下一次行动结束时应清除 def_down")


if __name__ == '__main__':
    unittest.main()
