"""Generate skill_effects_hybrid.json entries for S6 大雷 (161560553) - 4 skills.
Merges into existing skill_effects_hybrid.json, preserving existing entries.

Skills:
    220367 大ノ掃射 (AS) - enemy_row damage + per-target hp_scaling + on_crit remove_buff_by_type
    220368 大ノ双弾 (AS) - 2 targets damage + on_crit remove_buff_by_type
    230389 大ノ反撃 (PS) - after_as_attacked_ally 反撃 + shield_from_damage + on_crit remove_buff_by_type
    230390 大ノ増幅 (PS) - after_as_attack atk_up + crit_rate_up (stackable, 永久)

Requires new effect_type: remove_buff_by_type
Requires new flag: hp_scaling.max_bonus_pct (per-target)

Usage:
    python scripts/_import_s6_skill_effects_dalei.py
"""
from __future__ import annotations

import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HYBRID_JSON = ROOT / "data" / "skill_effects_hybrid.json"
SKILLS_JSON = ROOT / "data" / "skills.json"

EFFECT_TEMPLATE = {
    "effect_type": None,
    "target_type": None,
    "target_identifier": None,
    "value": None,
    "value_tag": None,
    "value_source": None,
    "duration": None,
    "duration_type": None,
    "duration_tag": None,
    "hit_count": None,
    "hit_count_tag": None,
    "condition": None,
    "flags": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
}

SKILL_TEMPLATE = {
    "skill_id": None,
    "name": None,
    "skill_type": None,
    "resource_cost": None,
    "cooldown": None,
    "cooldown_update_timing": None,
    "ignore_defense": 0,
    "ignore_shield": 0,
    "trigger_type": None,
    "global_condition": None,
    "effect_blocks": [],
    "display_target_priority": None,
    "display_target_range": None,
    "display_target_type": None,
    "parse_status": "manual",
    "parse_notes": [],
    "simultaneous_limit": None,
}


def make_effect(**kwargs) -> dict:
    eff = {k: v for k, v in EFFECT_TEMPLATE.items()}
    for k, v in kwargs.items():
        eff[k] = v
    return eff


def make_block(block_id: int, effects: list, condition=None) -> dict:
    return {"block_id": block_id, "condition": condition, "effects": effects}


def make_skill(**kwargs) -> dict:
    skill = {k: v for k, v in SKILL_TEMPLATE.items()}
    for k, v in kwargs.items():
        if k in skill:
            skill[k] = v
        else:
            skill[k] = v
    return skill


def load_skills_meta() -> dict[int, dict]:
    with SKILLS_JSON.open("r", encoding="utf-8") as fh:
        data = json.load(fh)
    out: dict[int, dict] = {}
    for k, v in data.items():
        try:
            sid = int(k)
        except (TypeError, ValueError):
            continue
        out[sid] = v
    return out


# on_crit block: remove atk_up + crit_rate_up from self
def make_remove_buff_by_type_block(block_id: int = 2) -> dict:
    return make_block(block_id, [
        make_effect(
            effect_type="remove_buff_by_type",
            target_type="self",
            flags={"filter": ["atk_up", "crit_rate_up"]},
        ),
    ], condition={"once_per_skill": True})


def build_dalei(skills_meta: dict[int, dict]) -> dict[str, dict]:
    out: dict[str, dict] = {}

    # 220367 大ノ掃射 (AS) - enemy_row + per-target hp_scaling + on_crit remove_buff
    meta = skills_meta[220367]
    out["220367"] = make_skill(
        skill_id=220367,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_row",
                    value_tag="威力",
                    hit_count=1,
                    flags={
                        "is_en_attack": True,
                        "hp_scaling": {"max_bonus_pct": 100},
                    },
                ),
            ]),
            make_remove_buff_by_type_block(2),
        ],
        display_target_range=6,
        display_target_type=3,
        parse_notes=["AS: 横一列EN + 対象HP比例+100% + on_crit 自身atk/crit_rate全解除"],
    )

    # 220368 大ノ双弾 (AS) - 2 targets + on_crit remove_buff
    meta = skills_meta[220368]
    out["220368"] = make_skill(
        skill_id=220368,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_single",
                    value_tag="威力",
                    hit_count=1,
                    flags={"target_count": 2, "is_en_attack": True},
                ),
            ]),
            make_remove_buff_by_type_block(2),
        ],
        display_target_range=2,
        display_target_type=3,
        parse_notes=["AS: 敵2体EN + on_crit 自身atk/crit_rate全解除"],
    )

    # 230389 大ノ反撃 (PS) - 反撃 + shield_from_damage + on_crit remove_buff
    meta = skills_meta[230389]
    out["230389"] = make_skill(
        skill_id=230389,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type="after_as_attacked_ally",
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="damage",
                    target_type="enemy_single",
                    target_identifier="trigger_attacker",
                    value_tag="威力",
                    hit_count=1,
                    flags={"is_en_attack": True},
                ),
                make_effect(
                    effect_type="shield_from_damage",
                    target_type="self",
                    value=80,
                    value_type="percent",
                    duration=-1,
                    duration_type=None,
                    flags={},
                ),
            ]),
            make_remove_buff_by_type_block(2),
        ],
        display_target_range=1,
        display_target_type=3,
        parse_notes=["PS: 被AS反撃 + 与ダメ80%シールド + on_crit 自身atk/crit_rate全解除"],
    )

    # 230390 大ノ増幅 (PS) - after_as_attack atk_up + crit_rate_up (stackable, 永久)
    meta = skills_meta[230390]
    out["230390"] = make_skill(
        skill_id=230390,
        name=meta["name"],
        skill_type=meta["skill_type"],
        resource_cost=meta["resource_cost"],
        cooldown=meta["cooldown"],
        cooldown_update_timing=meta["cooldown_update_timing"],
        trigger_type="after_as_attack",
        effect_blocks=[
            make_block(1, [
                make_effect(
                    effect_type="atk_up",
                    target_type="self",
                    value=10.0,
                    duration=-1,
                    duration_type=None,
                    flags={"value_type": "percent", "stackable": True},
                ),
                make_effect(
                    effect_type="crit_rate_up",
                    target_type="self",
                    value=10.0,
                    duration=-1,
                    duration_type=None,
                    flags={"value_type": "percent", "stackable": True},
                ),
            ]),
        ],
        display_target_range=None,
        display_target_type=1,
        parse_notes=["PS: 自身AS後 atk+10% + crit_rate+10% 永久重複可"],
    )

    return out


def main() -> None:
    skills_meta = load_skills_meta()
    new_entries = build_dalei(skills_meta)
    print(f"[INFO] Built {len(new_entries)} 大雷 skill entries")

    with HYBRID_JSON.open("r", encoding="utf-8") as fh:
        hybrid = json.load(fh)
    print(f"[INFO] Loaded {len(hybrid)} existing skill_effects_hybrid.json entries")

    added: list[int] = []
    skipped: list[int] = []
    for sid_str, entry in new_entries.items():
        if sid_str in hybrid:
            skipped.append(int(sid_str))
            continue
        hybrid[sid_str] = entry
        added.append(int(sid_str))

    print(f"[INFO] Added: {added}")
    if skipped:
        print(f"[INFO] Skipped (already present): {skipped}")

    with HYBRID_JSON.open("w", encoding="utf-8") as fh:
        json.dump(hybrid, fh, ensure_ascii=False, indent=2)
    print(f"[OK] Wrote {HYBRID_JSON}")


if __name__ == "__main__":
    main()
