"""Regression: 120032 リブートラッピング (104201 ミステリアスガール).

Validates:
1. heal effect: heal_base='atk', heal amount = atk * 威力% (Lv10: 10000 * 101.4% = 10140)
2. atk_up effect: stackable + permanent (duration=-1)
3. After execution: caster HP increases by heal amount
4. After execution: caster gains StatusAttack buff with value=5.0 (Lv10)
5. Buff is permanent (still active after one action ends)
6. Buff is stackable (executing twice creates 2 separate buffs, both contribute)

Spec (docs/103201_104201_skill_implementation.md):
- AS: heal (atk * 威力%) + atk_up (atk%, 永続 duration=-1, stackable)
- Lv10: 威力=101.4, atk=5.0%
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'src'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

SKILL_ID = 120032  # リブートラッピング


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=0, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ap=10,
               crit_rate=0.0, crit_damage=0.5, current_hp=None):
    u = UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=current_hp if current_hp is not None else hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=0,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )
    return u


class TestReg104201RebootWrapping(unittest.TestCase):
    """120032: heal (atk x 威力%) + atk_up (permanent, stackable)."""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _build_battlefield(self, caster_current_hp=None):
        bf = BattlefieldState()
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=100000, atk=10000, defense=0, speed=500,
            skills=[SKILL_ID], skill_levels={SKILL_ID: 10},
            current_hp=caster_current_hp,
        )
        enemy = _make_unit(
            "enemy", "Enemy", Side.ENEMY, Position.ENEMY_CENTER_FRONT,
            hp=1000000, atk=1000, defense=0, speed=800,
        )
        bf.friend_team = [caster]
        bf.enemy_team = [enemy]

        ss = SkillService(
            self.dl, ResourceService(),
            target_service=TargetService(), damage_service=DamageService(),
            aura_service=AuraService(), trigger_service=TriggerService(),
            status_service=StatusService(),
        )
        ss.set_battlefield(bf)
        return bf, ss, caster, enemy

    def test_heal_effect_config(self):
        """heal effect should have heal_base='atk'."""
        parsed = self.dl.get_parsed_skill_data(SKILL_ID)
        heal_effects = []
        for block in parsed.get('effect_blocks', []):
            for eff in block.get('effects', []):
                if eff.get('effect_type') == 'heal':
                    heal_effects.append(eff)
        self.assertEqual(len(heal_effects), 1, "Should have exactly 1 heal effect")
        self.assertEqual(heal_effects[0].get('flags', {}).get('heal_base'), 'atk',
                         "heal_base should be 'atk'")
        self.assertEqual(heal_effects[0].get('target_type'), 'self',
                         "heal target should be self")
        self.assertEqual(heal_effects[0].get('value_tag'), '威力',
                         "heal value_tag should be '威力'")

    def test_atk_up_effect_config(self):
        """atk_up effect should be permanent (duration=-1) and stackable."""
        parsed = self.dl.get_parsed_skill_data(SKILL_ID)
        atk_up_effects = []
        for block in parsed.get('effect_blocks', []):
            for eff in block.get('effects', []):
                if eff.get('effect_type') == 'atk_up':
                    atk_up_effects.append(eff)
        self.assertEqual(len(atk_up_effects), 1, "Should have exactly 1 atk_up effect")
        eff = atk_up_effects[0]
        self.assertEqual(eff.get('duration'), -1, "atk_up duration should be -1 (永久)")
        self.assertEqual(eff.get('target_type'), 'self', "atk_up target should be self")
        self.assertTrue(eff.get('flags', {}).get('stackable'),
                        "atk_up should be stackable")
        self.assertEqual(eff.get('flags', {}).get('value_type'), 'percent',
                         "atk_up value_type should be 'percent'")

    def test_heal_amount_based_on_atk(self):
        """Heal amount should be atk * 威力% (Lv10: 10000 * 101.4% = 10140)."""
        # Set current_hp below max so heal doesn't cap
        bf, ss, caster, enemy = self._build_battlefield(caster_current_hp=50000)
        caster.current_ap = 5
        hp_before = caster.current_hp
        ss.execute_skill(caster, SKILL_ID, bf)
        heal_amount = caster.current_hp - hp_before
        # Lv10 威力=101.4, atk=10000 => heal = int(10000 * 101.4 / 100) = 10140
        expected_heal = int(10000 * 101.4 / 100)  # 10140
        self.assertGreater(heal_amount, 0, "Heal should occur")
        self.assertAlmostEqual(heal_amount, expected_heal, delta=expected_heal * 0.05,
                               msg=f"Heal should be ~{expected_heal} (atk * 威力%), got {heal_amount}")

    def test_atk_up_buff_applied(self):
        """After execution, caster should gain a StatusAttack buff."""
        bf, ss, caster, enemy = self._build_battlefield(caster_current_hp=50000)
        caster.current_ap = 5
        ss.execute_skill(caster, SKILL_ID, bf)
        atk_up_buffs = [b for b in caster.buffs
                        if b.effect_type == SkillEffectType.STATUS_ATTACK.value]
        self.assertEqual(len(atk_up_buffs), 1,
                         f"Should have 1 STATUS_ATTACK buff, got {len(atk_up_buffs)}")
        # Lv10 atk=5.0
        self.assertAlmostEqual(atk_up_buffs[0].value, 5.0, delta=0.01,
                               msg=f"buff value should be 5.0 (Lv10 atk%), got {atk_up_buffs[0].value}")

    def test_atk_up_buff_is_permanent(self):
        """atk_up buff should have duration=-1 (永久)."""
        bf, ss, caster, enemy = self._build_battlefield(caster_current_hp=50000)
        caster.current_ap = 5
        ss.execute_skill(caster, SKILL_ID, bf)
        atk_up_buffs = [b for b in caster.buffs
                        if b.effect_type == SkillEffectType.STATUS_ATTACK.value]
        self.assertEqual(len(atk_up_buffs), 1)
        self.assertEqual(atk_up_buffs[0].duration, -1,
                         f"Permanent buff should have duration=-1, got {atk_up_buffs[0].duration}")

    def test_atk_up_buff_is_stackable(self):
        """Executing skill twice should create 2 separate stackable buffs."""
        bf, ss, caster, enemy = self._build_battlefield(caster_current_hp=100000)
        caster.current_ap = 10
        # Execute twice
        ss.execute_skill(caster, SKILL_ID, bf)
        # Re-set AP for second execution
        caster.current_ap = 10
        ss.execute_skill(caster, SKILL_ID, bf)
        atk_up_buffs = [b for b in caster.buffs
                        if b.effect_type == SkillEffectType.STATUS_ATTACK.value]
        self.assertEqual(len(atk_up_buffs), 2,
                         f"Should have 2 stackable STATUS_ATTACK buffs after 2 casts, "
                         f"got {len(atk_up_buffs)}")
        # Each should have unique buff_id (stackable => uuid in buff_id)
        buff_ids = {b.buff_id for b in atk_up_buffs}
        self.assertEqual(len(buff_ids), 2,
                         f"2 stackable buffs should have unique buff_ids, got {buff_ids}")
        # Both should be is_stackable=True
        for b in atk_up_buffs:
            self.assertTrue(b.is_stackable, "Stackable buff should have is_stackable=True")


if __name__ == '__main__':
    unittest.main()
