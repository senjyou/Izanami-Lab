#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
角色增量导入脚本

从原始解包数据增量导入新角色到模拟器项目。
不允许覆盖已导入的数据，以保护已修正的bug修复。

使用方法:
    python scripts/import_character.py <character_id> [character_id2 ...]
    python scripts/import_character.py 144301
    python scripts/import_character.py 144301 145201

工作流程:
    1. 解析角色ID → 获取根ID → 获取队伍ID
    2. 检查依赖项（队伍、根）是否已存在，不存在则导入
    3. 检查角色是否已存在，不存在则导入角色数据
    4. 导入角色关联的技能数据
    5. 导入稀有度加成数据
    6. 更新数据库
    7. 解析新技能效果
    8. 重建新角色的属性缓存
"""

import sys
import os
import json
import sqlite3
from pathlib import Path
from datetime import datetime
from typing import Dict, List, Set, Any, Optional, Tuple
from collections import defaultdict

# 添加项目根目录到Python路径
PROJECT_ROOT = Path(__file__).parent.parent
sys.path.insert(0, str(PROJECT_ROOT))

from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()

# 路径配置
SPLIT_DATA_DIR = PROJECT_ROOT / "split_data"
DATA_DIR = PROJECT_ROOT / "data"
DB_CHARACTER = PROJECT_ROOT / "db" / "character_stats.db"
DB_SKILL = PROJECT_ROOT / "db" / "skill_data.db"


class CharacterImporter:
    """角色增量导入器"""

    def __init__(self):
        self.stats = {
            'teams_added': 0,
            'bases_added': 0,
            'variants_added': 0,
            'characters_added': 0,
            'skills_added': 0,
            'skill_tags_added': 0,
            'char_skills_added': 0,
            'rarity_bonuses_added': 0,
            'skills_parsed': 0,
            'cache_rebuilt': 0,
            'skipped_existing': 0,
        }
        self.new_skill_ids: Set[int] = set()
        self.new_character_ids: Set[int] = set()
        self.warnings: List[str] = []

    # ========================================================================
    # 数据加载工具
    # ========================================================================

    def _load_split_data(self, filename: str) -> List[Dict]:
        """加载split_data中的原始数据"""
        filepath = SPLIT_DATA_DIR / filename
        with open(filepath, 'r', encoding='utf-8') as f:
            return json.load(f)

    def _load_data_json(self, filename: str) -> Dict:
        """加载data目录中的转换后数据"""
        filepath = DATA_DIR / filename
        with open(filepath, 'r', encoding='utf-8') as f:
            return json.load(f)

    def _save_data_json(self, data: Any, filename: str):
        """保存数据到data目录"""
        filepath = DATA_DIR / filename
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(data, f, ensure_ascii=False, indent=2)
        safe_print(f"  已保存: {filename}")

    # ========================================================================
    # 原始数据查找
    # ========================================================================

    def _find_character_raw(self, character_id: int) -> Optional[Dict]:
        """在CharacterMaster.json中查找角色原始数据"""
        raw_data = self._load_split_data("CharacterMaster.json")
        for item in raw_data:
            if item["Id"] == character_id:
                return item
        return None

    def _find_base_raw(self, base_id: int) -> Optional[Dict]:
        """在CharacterBaseMaster.json中查找根角色原始数据"""
        raw_data = self._load_split_data("CharacterBaseMaster.json")
        for item in raw_data:
            if item["Id"] == base_id:
                return item
        return None

    def _find_team_raw(self, team_id: int) -> Optional[Dict]:
        """在CharacterTeamMaster.json中查找队伍原始数据"""
        raw_data = self._load_split_data("CharacterTeamMaster.json")
        for item in raw_data:
            if item["Id"] == team_id:
                return item
        return None

    def _find_character_skills_raw(self, character_id: int) -> List[int]:
        """在CharacterSkillMaster.json中查找角色的技能ID列表"""
        raw_data = self._load_split_data("CharacterSkillMaster.json")
        skill_ids = []
        for item in raw_data:
            if item["CharacterMasterId"] == character_id:
                skill_ids.append(item["SkillMasterId"])
        return sorted(skill_ids)

    def _find_skill_raw(self, skill_id: int) -> Optional[Dict]:
        """在SkillMaster.json中查找技能原始数据"""
        raw_data = self._load_split_data("SkillMaster.json")
        for item in raw_data:
            if item["Id"] == skill_id:
                return item
        return None

    def _find_rarity_bonuses_raw(self, character_id: int) -> List[Dict]:
        """在CharacterRarityStatusMaster.json中查找角色的稀有度加成"""
        raw_data = self._load_split_data("CharacterRarityStatusMaster.json")
        bonuses = []
        for item in raw_data:
            if item["CharacterMasterId"] == character_id:
                bonuses.append(item)
        return bonuses

    def _find_all_variants_for_base(self, base_id: int) -> List[int]:
        """查找同一根ID下的所有角色变体ID"""
        raw_data = self._load_split_data("CharacterMaster.json")
        variant_ids = []
        for item in raw_data:
            if item["CharacterBaseMasterId"] == base_id:
                variant_ids.append(item["Id"])
        return sorted(variant_ids)

    # ========================================================================
    # 数据转换（复用DataDumper的逻辑）
    # ========================================================================

    def _convert_character(self, raw: Dict) -> Dict:
        """将原始角色数据转换为项目格式"""
        character_id = raw["Id"]
        return {
            "character_id": character_id,
            "name": raw["Name"],
            "character_base_id": raw["CharacterBaseMasterId"],
            "default_rarity": raw["DefaultRarity"],
            "character_type": raw["Type"],
            "attribute": raw["Attribute"],
            "position_type": raw["PositionType"],
            "role_type": raw["RoleType"],
            "action_point": raw["ActionPoint"],
            "passive_point": raw["PassivePoint"],
            "min_level_stats": {
                "level": 1,
                "hp": raw["MinHp"],
                "attack": raw["MinAttack"],
                "defense": raw["MinDefense"],
                "speed": raw["MinSpeed"],
                "crit_rate": raw["MinCriticalRate"]
            },
            "max_level_stats": {
                "level": 200,
                "hp": raw["MaxHp"],
                "attack": raw["MaxAttack"],
                "defense": raw["MaxDefense"],
                "speed": raw["MaxSpeed"],
                "crit_rate": raw["MaxCriticalRate"]
            },
            "bonus_per_level": {
                "hp": raw["BonusHpPerLevel"],
                "attack": raw["BonusAttackPerLevel"],
                "defense": raw["BonusDefensePerLevel"],
                "speed": raw["BonusSpeedPerLevel"],
                "crit_rate": raw["BonusCriticalRatePerLevel"]
            },
            "grades": {
                "hp_grade": raw["HpGrade"],
                "attack_grade": raw["AttackGrade"],
                "defense_grade": raw["DefenseGrade"],
                "speed_grade": raw["SpeedGrade"],
                "crit_rate_grade": raw["CriticalRateGrade"]
            },
            "raw_data": raw
        }

    def _convert_skill(self, raw: Dict) -> Tuple[Dict, Dict]:
        """将原始技能数据转换为项目格式，返回 (skill_data, tag_values_data)"""
        skill_id = raw["Id"]

        # 处理AdditionalKinds
        additional_kinds = []
        for ak in raw.get("AdditionalKinds", []):
            additional_kinds.append({
                "level": ak["Level"],
                "value": ak["Value"]
            })

        # 处理DescriptionTemplates
        descriptions = []
        for desc in raw.get("DescriptionTemplates", []):
            descriptions.append({
                "min_level": desc["Level"],
                "template": desc["Template"]
            })

        # 处理TemplateTags
        template_tags = {}
        tag_values = {}
        for tag in raw.get("TemplateTags", []):
            tag_name = tag["TagName"]
            values = []
            for val in tag.get("Values", []):
                values.append({
                    "level": val["Level"],
                    "value": val["Value"]
                })
            template_tags[tag_name] = {
                "interpolation_mode": tag["InterpolationMode"],
                "values": values
            }
            # 构建 skill_tag_values 格式
            tag_values[tag_name] = {
                "interpolation_mode": tag["InterpolationMode"],
                "values": values
            }

        skill_data = {
            "skill_id": skill_id,
            "name": raw["Name"],
            "skill_type": raw["Type"],
            "skill_kind": raw.get("Kind", 0),
            "resource_cost": raw["ResourceCost"],
            "cooldown": raw["CoolTime"],
            "cooldown_update_timing": raw.get("CoolTimeUpdateTiming"),
            "default_max_level": raw["DefaultMaxLevel"],
            "descriptions": descriptions,
            "template_tags": template_tags,
        }

        return skill_data, tag_values

    def _convert_rarity_bonus(self, raw: Dict) -> Dict:
        """将原始稀有度加成数据转换为项目格式"""
        return {
            "character_id": raw["CharacterMasterId"],
            "rarity": raw["Rarity"],
            "additional_hp": raw["AdditionalHp"],
            "additional_attack": raw["AdditionalAttack"],
            "additional_defense": raw["AdditionalDefence"],
            "additional_speed": raw["AdditionalSpeed"],
            "additional_crit_rate": raw["AdditionalCriticalRate"],
            "additional_action_point": raw["AdditionalActionPoint"],
            "additional_passive_point": raw["AdditionalPassivePoint"]
        }

    # ========================================================================
    # 导入步骤
    # ========================================================================

    def import_character(self, character_id: int, force: bool = False) -> bool:
        """导入单个角色的完整数据

        Args:
            character_id: 角色ID
            force: 是否强制重新导入（覆盖已有数据）
        """
        safe_print(f"\n{'='*60}")
        safe_print(f"导入角色: {character_id}")
        safe_print(f"{'='*60}")

        # Step 1: 查找角色原始数据
        char_raw = self._find_character_raw(character_id)
        if char_raw is None:
            safe_print(f"  [错误] 在CharacterMaster.json中未找到角色ID: {character_id}")
            return False

        base_id = char_raw["CharacterBaseMasterId"]
        safe_print(f"  角色名: {char_raw['Name']}")
        safe_print(f"  根ID: {base_id}")

        # Step 2: 查找根角色数据
        base_raw = self._find_base_raw(base_id)
        if base_raw is None:
            safe_print(f"  [错误] 在CharacterBaseMaster.json中未找到根ID: {base_id}")
            return False

        team_id = base_raw["CharacterTeamMasterId"]
        safe_print(f"  队伍ID: {team_id}")

        # Step 3: 检查角色是否已存在
        characters = self._load_data_json("characters.json")
        already_exists = str(character_id) in characters

        if already_exists and not force:
            safe_print(f"  [跳过] 角色 {character_id} 已存在于characters.json，不覆盖")
            # 即使角色已存在，也收集其技能ID用于后续解析检查
            skill_ids = self._find_character_skills_raw(character_id)
            for skill_id in skill_ids:
                skill_raw = self._find_skill_raw(skill_id)
                if skill_raw and str(skill_id) not in self._load_data_json("skills.json"):
                    self.new_skill_ids.add(skill_id)
            # 标记需要缓存重建检查
            self.new_character_ids.add(character_id)
            self.stats['skipped_existing'] += 1
            return True

        if already_exists and force:
            safe_print(f"  [强制] 角色 {character_id} 已存在，强制重新导入")

        # Step 4: 导入队伍（如果不存在）
        self._import_team(team_id)

        # Step 5: 导入根角色（如果不存在）
        self._import_base(base_id, base_raw, team_id)

        # Step 6: 导入角色变体映射
        self._import_variant(base_id, character_id)

        # Step 7: 导入角色数据
        self._import_character_data(character_id, char_raw, force=force)

        # Step 8: 导入角色技能映射
        self._import_character_skills(character_id, force=force)

        # Step 9: 导入技能数据（新技能）
        skill_ids = self._find_character_skills_raw(character_id)
        for skill_id in skill_ids:
            self._import_skill(skill_id, force=force)

        # Step 10: 导入稀有度加成
        self._import_rarity_bonuses(character_id, force=force)

        self.new_character_ids.add(character_id)
        safe_print(f"  [完成] 角色 {character_id} ({char_raw['Name']}) 导入成功")
        return True

    def _import_team(self, team_id: int):
        """导入队伍数据到character_team_mapping.json"""
        mapping = self._load_data_json("character_team_mapping.json")

        if str(team_id) in mapping["teams"]:
            safe_print(f"  [跳过] 队伍 {team_id} 已存在")
            return

        team_raw = self._find_team_raw(team_id)
        if team_raw is None:
            self.warnings.append(f"队伍ID {team_id} 在CharacterTeamMaster.json中未找到")
            safe_print(f"  [警告] 队伍 {team_id} 在原始数据中未找到")
            return

        mapping["teams"][str(team_id)] = team_raw["Name"]
        self._save_data_json(mapping, "character_team_mapping.json")
        self.stats['teams_added'] += 1
        safe_print(f"  [新增] 队伍 {team_id}: {team_raw['Name']}")

    def _import_base(self, base_id: int, base_raw: Dict, team_id: int):
        """导入根角色数据到character_team_mapping.json"""
        mapping = self._load_data_json("character_team_mapping.json")

        if str(base_id) in mapping["character_base"]:
            safe_print(f"  [跳过] 根角色 {base_id} 已存在")
            return

        # 获取队伍名
        team_name = mapping["teams"].get(str(team_id), "")

        mapping["character_base"][str(base_id)] = {
            "name": base_raw["Name"],
            "name_ruby": base_raw["NameRuby"],
            "team_id": team_id,
            "team_name": team_name
        }
        self._save_data_json(mapping, "character_team_mapping.json")
        self.stats['bases_added'] += 1
        safe_print(f"  [新增] 根角色 {base_id}: {base_raw['Name']}")

    def _import_variant(self, base_id: int, character_id: int):
        """导入角色变体映射到character_team_mapping.json"""
        mapping = self._load_data_json("character_team_mapping.json")

        if str(base_id) not in mapping["character_variants"]:
            mapping["character_variants"][str(base_id)] = []

        variants = mapping["character_variants"][str(base_id)]
        existing_ids = {v["character_id"] for v in variants}

        if character_id not in existing_ids:
            variants.append({"character_id": character_id, "rarity": "N/A"})
            self._save_data_json(mapping, "character_team_mapping.json")
            self.stats['variants_added'] += 1
            safe_print(f"  [新增] 变体映射: 根{base_id} → 角色{character_id}")

    def _import_character_data(self, character_id: int, char_raw: Dict, force: bool = False):
        """导入角色数据到characters.json"""
        characters = self._load_data_json("characters.json")

        if str(character_id) in characters and not force:
            return

        converted = self._convert_character(char_raw)
        characters[str(character_id)] = converted
        self._save_data_json(characters, "characters.json")
        self.stats['characters_added'] += 1
        safe_print(f"  [新增] 角色数据: {character_id} ({char_raw['Name']})")

    def _import_character_skills(self, character_id: int, force: bool = False):
        """导入角色技能映射到character_skills.json"""
        char_skills = self._load_data_json("character_skills.json")

        if str(character_id) in char_skills and not force:
            safe_print(f"  [跳过] 角色 {character_id} 的技能映射已存在")
            return

        skill_ids = self._find_character_skills_raw(character_id)
        char_skills[str(character_id)] = {
            "character_id": character_id,
            "skill_ids": skill_ids
        }
        self._save_data_json(char_skills, "character_skills.json")
        self.stats['char_skills_added'] += 1
        safe_print(f"  [新增] 角色技能映射: {character_id} → {skill_ids}")

    def _import_skill(self, skill_id: int, force: bool = False):
        """导入技能数据到skills.json和skill_tag_values.json"""
        # 检查skills.json
        skills = self._load_data_json("skills.json")

        if str(skill_id) in skills and not force:
            return

        skill_raw = self._find_skill_raw(skill_id)
        if skill_raw is None:
            self.warnings.append(f"技能ID {skill_id} 在SkillMaster.json中未找到")
            safe_print(f"  [警告] 技能 {skill_id} 在原始数据中未找到")
            return

        skill_data, tag_values = self._convert_skill(skill_raw)

        # 保存到skills.json
        skills[str(skill_id)] = skill_data
        self._save_data_json(skills, "skills.json")
        self.stats['skills_added'] += 1
        safe_print(f"  [新增] 技能: {skill_id} ({skill_raw['Name']})")

        # 保存到skill_tag_values.json
        tag_values_data = self._load_data_json("skill_tag_values.json")
        tag_values_data[str(skill_id)] = tag_values
        self._save_data_json(tag_values_data, "skill_tag_values.json")
        self.stats['skill_tags_added'] += 1

        self.new_skill_ids.add(skill_id)

    def _import_rarity_bonuses(self, character_id: int, force: bool = False):
        """导入稀有度加成到rarity_bonuses.json"""
        rarity_bonuses = self._load_data_json("rarity_bonuses.json")

        if str(character_id) in rarity_bonuses and not force:
            safe_print(f"  [跳过] 角色 {character_id} 的稀有度加成已存在")
            return

        raw_bonuses = self._find_rarity_bonuses_raw(character_id)
        if not raw_bonuses:
            safe_print(f"  [信息] 角色 {character_id} 无稀有度加成数据")
            return

        char_rarity_data = {}
        for raw in raw_bonuses:
            rarity = raw["Rarity"]
            char_rarity_data[str(rarity)] = self._convert_rarity_bonus(raw)

        rarity_bonuses[str(character_id)] = char_rarity_data
        self._save_data_json(rarity_bonuses, "rarity_bonuses.json")
        self.stats['rarity_bonuses_added'] += len(raw_bonuses)
        safe_print(f"  [新增] 稀有度加成: {character_id} ({len(raw_bonuses)}个稀有度)")

    # ========================================================================
    # 数据库更新
    # ========================================================================

    def update_databases(self):
        """更新SQLite数据库"""
        if not self.new_character_ids and not self.new_skill_ids:
            safe_print("\n无需更新数据库")
            return

        safe_print(f"\n{'='*60}")
        safe_print("更新数据库")
        safe_print(f"{'='*60}")

        self._update_character_db()
        self._update_skill_db()

    def _update_character_db(self):
        """更新character_stats.db"""
        if not self.new_character_ids:
            return

        safe_print("\n[1/2] 更新 character_stats.db ...")
        conn = sqlite3.connect(DB_CHARACTER)
        cursor = conn.cursor()

        try:
            # 导入队伍
            mapping = self._load_data_json("character_team_mapping.json")
            for team_id_str, team_name in mapping["teams"].items():
                team_id = int(team_id_str)
                cursor.execute("SELECT team_id FROM teams WHERE team_id = ?", (team_id,))
                if not cursor.fetchone():
                    cursor.execute(
                        "INSERT OR IGNORE INTO teams (team_id, team_name) VALUES (?, ?)",
                        (team_id, team_name)
                    )
                    safe_print(f"  [DB] 新增队伍: {team_id} - {team_name}")

            # 导入根角色
            for base_id_str, base_info in mapping["character_base"].items():
                base_id = int(base_id_str)
                cursor.execute("SELECT base_id FROM character_base WHERE base_id = ?", (base_id,))
                if not cursor.fetchone():
                    cursor.execute(
                        "INSERT OR IGNORE INTO character_base (base_id, name, name_ruby, team_id) VALUES (?, ?, ?, ?)",
                        (base_id, base_info['name'], base_info['name_ruby'], base_info['team_id'])
                    )
                    safe_print(f"  [DB] 新增根角色: {base_id} - {base_info['name']}")

            # 导入角色数据
            characters = self._load_data_json("characters.json")
            for char_id in self.new_character_ids:
                char_data = characters.get(str(char_id))
                if not char_data:
                    continue
                cursor.execute("SELECT character_id FROM characters WHERE character_id = ?", (char_id,))
                if cursor.fetchone():
                    continue
                cursor.execute("""
                    INSERT OR IGNORE INTO characters
                    (character_id, name, character_base_id, default_rarity,
                     character_type, attribute, position_type, role_type,
                     action_point, passive_point,
                     min_level, min_hp, min_attack, min_defense, min_speed, min_crit_rate,
                     max_level, max_hp, max_attack, max_defense, max_speed, max_crit_rate,
                     bonus_hp_per_level, bonus_attack_per_level, bonus_defense_per_level,
                     bonus_speed_per_level, bonus_crit_rate_per_level,
                     hp_grade, attack_grade, defense_grade, speed_grade, crit_rate_grade,
                     is_released, is_default_character)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """, (
                    char_data['character_id'],
                    char_data['name'],
                    char_data['character_base_id'],
                    char_data['default_rarity'],
                    char_data['character_type'],
                    char_data['attribute'],
                    char_data['position_type'],
                    char_data['role_type'],
                    char_data['action_point'],
                    char_data['passive_point'],
                    char_data['min_level_stats']['level'],
                    char_data['min_level_stats']['hp'],
                    char_data['min_level_stats']['attack'],
                    char_data['min_level_stats']['defense'],
                    char_data['min_level_stats']['speed'],
                    char_data['min_level_stats']['crit_rate'],
                    char_data['max_level_stats']['level'],
                    char_data['max_level_stats']['hp'],
                    char_data['max_level_stats']['attack'],
                    char_data['max_level_stats']['defense'],
                    char_data['max_level_stats']['speed'],
                    char_data['max_level_stats']['crit_rate'],
                    char_data['bonus_per_level']['hp'],
                    char_data['bonus_per_level']['attack'],
                    char_data['bonus_per_level']['defense'],
                    char_data['bonus_per_level']['speed'],
                    char_data['bonus_per_level']['crit_rate'],
                    char_data['grades']['hp_grade'],
                    char_data['grades']['attack_grade'],
                    char_data['grades']['defense_grade'],
                    char_data['grades']['speed_grade'],
                    char_data['grades']['crit_rate_grade'],
                    char_data['raw_data'].get('IsReleased', True),
                    char_data['raw_data'].get('IsDefaultCharacter', False)
                ))
                safe_print(f"  [DB] 新增角色: {char_id} - {char_data['name']}")

            # 导入角色变体关系
            for base_id_str, variants in mapping["character_variants"].items():
                base_id = int(base_id_str)
                for variant in variants:
                    char_id = variant['character_id']
                    cursor.execute(
                        "SELECT character_id FROM character_variants WHERE character_id = ?",
                        (char_id,)
                    )
                    if cursor.fetchone():
                        continue
                    # 确保角色在characters表中存在
                    cursor.execute("SELECT character_id FROM characters WHERE character_id = ?", (char_id,))
                    if cursor.fetchone():
                        cursor.execute(
                            "INSERT OR IGNORE INTO character_variants (base_id, character_id) VALUES (?, ?)",
                            (base_id, char_id)
                        )

            # 导入稀有度加成
            rarity_bonuses = self._load_data_json("rarity_bonuses.json")
            for char_id in self.new_character_ids:
                char_rarity = rarity_bonuses.get(str(char_id), {})
                for rarity_str, bonus_data in char_rarity.items():
                    cursor.execute(
                        "SELECT id FROM rarity_bonuses WHERE character_id = ? AND rarity = ?",
                        (char_id, bonus_data['rarity'])
                    )
                    if cursor.fetchone():
                        continue
                    cursor.execute("""
                        INSERT OR IGNORE INTO rarity_bonuses
                        (character_id, rarity,
                         additional_hp, additional_attack, additional_defense, additional_speed,
                         additional_crit_rate, additional_action_point, additional_passive_point)
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """, (
                        bonus_data['character_id'],
                        bonus_data['rarity'],
                        bonus_data['additional_hp'],
                        bonus_data['additional_attack'],
                        bonus_data['additional_defense'],
                        bonus_data['additional_speed'],
                        bonus_data['additional_crit_rate'],
                        bonus_data['additional_action_point'],
                        bonus_data['additional_passive_point']
                    ))

            conn.commit()
            safe_print("  character_stats.db 更新完成")

        except Exception as e:
            conn.rollback()
            safe_print(f"  [错误] character_stats.db 更新失败: {e}")
            raise
        finally:
            conn.close()

    def _update_skill_db(self):
        """更新skill_data.db"""
        if not self.new_skill_ids and not self.new_character_ids:
            return

        safe_print("\n[2/2] 更新 skill_data.db ...")

        if not DB_SKILL.exists():
            safe_print("  [警告] skill_data.db 不存在，跳过技能数据库更新")
            return

        conn = sqlite3.connect(DB_SKILL)
        cursor = conn.cursor()

        try:
            # 导入技能基础数据
            skills = self._load_data_json("skills.json")
            for skill_id in self.new_skill_ids:
                skill_data = skills.get(str(skill_id))
                if not skill_data:
                    continue

                # 确定技能类型ID
                skill_type_id = skill_data['skill_type']
                # 检查枚举表中是否存在该类型
                cursor.execute("SELECT skill_type_id FROM enum_skill_types WHERE skill_type_id = ?",
                             (skill_type_id,))
                if not cursor.fetchone():
                    safe_print(f"  [警告] 技能类型 {skill_type_id} 不在枚举表中，跳过技能 {skill_id}")
                    continue

                # 计算cost
                resource_cost = skill_data.get('resource_cost', 0)
                cost_ap = resource_cost if skill_type_id == 1 else 0
                cost_pp = resource_cost if skill_type_id == 2 else 0
                cost_ep = resource_cost if skill_type_id == 3 else 0

                cursor.execute("""
                    INSERT OR IGNORE INTO skills
                    (skill_id, name, skill_type_id, base_kind,
                     cost_ap, cost_pp, cost_ep,
                     cooldown_value, cooldown_timing,
                     default_max_level, entry_status)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                """, (
                    skill_id,
                    skill_data['name'],
                    skill_type_id,
                    skill_data.get('skill_kind', 1),
                    cost_ap, cost_pp, cost_ep,
                    skill_data.get('cooldown', 0) or 0,
                    skill_data.get('cooldown_update_timing', 0) or 0,
                    skill_data.get('default_max_level', 10),
                    'pending'
                ))
                safe_print(f"  [DB] 新增技能: {skill_id} - {skill_data['name']}")

                # 导入技能Tag值
                tag_values_data = self._load_data_json("skill_tag_values.json")
                skill_tags = tag_values_data.get(str(skill_id), {})
                for tag_name, tag_info in skill_tags.items():
                    interpolation_mode = tag_info.get('interpolation_mode', 1)
                    for val_info in tag_info.get('values', []):
                        cursor.execute("""
                            INSERT OR IGNORE INTO skill_tag_values
                            (skill_id, tag_name, skill_level, tag_value, interpolation_mode)
                            VALUES (?, ?, ?, ?, ?)
                        """, (
                            skill_id,
                            tag_name,
                            val_info['level'],
                            val_info['value'],
                            interpolation_mode
                        ))

            # 导入角色-技能映射
            char_skills = self._load_data_json("character_skills.json")
            for char_id in self.new_character_ids:
                cs_data = char_skills.get(str(char_id))
                if not cs_data:
                    continue
                skill_ids = cs_data['skill_ids']
                for order, skill_id in enumerate(skill_ids, 1):
                    cursor.execute("""
                        INSERT OR IGNORE INTO character_skills
                        (character_id, skill_id, skill_order)
                        VALUES (?, ?, ?)
                    """, (char_id, skill_id, order))

            conn.commit()
            safe_print("  skill_data.db 更新完成")

        except Exception as e:
            conn.rollback()
            safe_print(f"  [错误] skill_data.db 更新失败: {e}")
            raise
        finally:
            conn.close()

    # ========================================================================
    # 技能效果解析
    # ========================================================================

    def parse_new_skills(self):
        """解析新导入技能的效果（通过子进程调用，避免模块级setup_console_encoding冲突）"""
        if not self.new_skill_ids:
            safe_print("\n无新技能需要解析")
            return

        safe_print(f"\n{'='*60}")
        safe_print(f"解析新技能效果 ({len(self.new_skill_ids)}个)")
        safe_print(f"{'='*60}")

        # 加载现有解析结果
        skill_effects = self._load_data_json("skill_effects_hybrid.json")

        # 筛选需要解析的技能
        skills_to_parse = []
        for skill_id in sorted(self.new_skill_ids):
            if str(skill_id) in skill_effects:
                safe_print(f"  [跳过] 技能 {skill_id} 的效果已存在")
                continue
            skills_to_parse.append(skill_id)

        if not skills_to_parse:
            safe_print("  所有技能效果已存在，无需解析")
            return

        # 通过子进程运行解析脚本，避免模块级setup_console_encoding替换stdout导致崩溃
        # 生成临时脚本文件
        temp_script = PROJECT_ROOT / "scripts" / "_temp_parse_skills.py"
        skill_ids_str = ", ".join(str(sid) for sid in skills_to_parse)
        output_file = PROJECT_ROOT / "data" / "_temp_parsed_skills.json"

        script_content = f'''#!/usr/bin/env python
# -*- coding: utf-8 -*-
import sys
import json
from pathlib import Path
from dataclasses import asdict

sys.path.insert(0, str(Path(__file__).parent.parent))
# 注意：不在子进程中调用setup_console_encoding()，因为它会替换stdout导致子进程崩溃
from scripts.parse_skill_hybrid import HybridSkillParser

SKILL_IDS = [{skill_ids_str}]
SPLIT_DATA = Path(__file__).parent.parent / "split_data" / "SkillMaster.json"

raw_data = json.load(open(SPLIT_DATA, 'r', encoding='utf-8'))
skill_map = {{s['Id']: s for s in raw_data}}

parser = HybridSkillParser()
results = {{}}

for skill_id in SKILL_IDS:
    skill_raw = skill_map.get(skill_id)
    if not skill_raw:
        print(f"  [警告] 技能 {{skill_id}} 未找到")
        continue
    try:
        parsed = parser.parse_skill(skill_raw)
        effect_dict = asdict(parsed)
        results[str(skill_id)] = effect_dict
        print(f"  [解析] 技能 {{skill_id}}: {{parsed.name}} ({{parsed.parse_status}})")
    except Exception as e:
        print(f"  [错误] 技能 {{skill_id}} 解析失败: {{e}}")

json.dump(results, open(r"{output_file}", 'w', encoding='utf-8'), ensure_ascii=False, indent=2)
print(f"DONE: {{len(results)}} skills parsed")
'''

        with open(temp_script, 'w', encoding='utf-8') as f:
            f.write(script_content)

        try:
            import subprocess
            result = subprocess.run(
                [sys.executable, str(temp_script)],
                capture_output=True,
                text=True,
                encoding='utf-8',
                errors='replace',
                cwd=str(PROJECT_ROOT)
            )

            # 打印子进程输出
            if result.stdout:
                for line in result.stdout.strip().split('\n'):
                    safe_print(f"  {line}")

            if result.returncode != 0:
                safe_print(f"  [警告] 技能解析子进程返回非零退出码: {result.returncode}")
                if result.stderr:
                    safe_print(f"  [错误] {result.stderr[:500]}")

            # 读取解析结果
            if output_file.exists():
                parsed_results = json.load(open(output_file, 'r', encoding='utf-8'))
                for skill_id_str, effect_data in parsed_results.items():
                    skill_effects[skill_id_str] = effect_data
                self.stats['skills_parsed'] = len(parsed_results)

                # 保存合并后的结果
                self._save_data_json(skill_effects, "skill_effects_hybrid.json")

                # 清理临时文件
                output_file.unlink()
            else:
                safe_print("  [警告] 未生成解析结果文件")

        except Exception as e:
            safe_print(f"  [错误] 技能解析失败: {e}")
            safe_print("  请手动运行: python scripts/parse_skill_hybrid.py")
        finally:
            # 清理临时脚本
            if temp_script.exists():
                temp_script.unlink()

    # ========================================================================
    # 属性缓存重建
    # ========================================================================

    def rebuild_cache(self):
        """重建新角色的属性缓存（使用与initialize_db_cache.py相同的方式）"""
        if not self.new_character_ids:
            safe_print("\n无新角色需要重建缓存")
            return

        safe_print(f"\n{'='*60}")
        safe_print(f"重建属性缓存 ({len(self.new_character_ids)}个角色)")
        safe_print(f"{'='*60}")

        try:
            from src.data.stat_calculator import StatCalculator
            from src.config.character_config import CharacterConfig, ModuleConfig
            from src.config.player_config import PlayerConfig, SchoolLevels
            from src.data.data_loader import DataLoader
            from src.data.models import CharacterData

            db_path = str(DB_CHARACTER)
            data_loader = DataLoader()
            lerp_data = data_loader.load_level_lerp_data()
            calculator = StatCalculator(lerp_data, data_loader=data_loader)

            conn = sqlite3.connect(db_path)
            cursor = conn.cursor()

            # 默认配置
            DEFAULT_LEVEL = 200
            DEFAULT_AFFECTION = 40
            DEFAULT_SCHOOL_LEVEL = 50
            DEFAULT_MODULE_TIER = 10
            DEFAULT_MODULE_LEVEL = 55

            for char_id in self.new_character_ids:
                try:
                    char_data = data_loader.get_character(char_id)
                    if not char_data:
                        safe_print(f"  [跳过] 角色 {char_id} 在DataLoader中未找到")
                        continue

                    # 获取最高稀有度
                    cursor.execute("SELECT MAX(rarity) FROM rarity_bonuses WHERE character_id = ?", (char_id,))
                    result = cursor.fetchone()
                    max_rarity = result[0] if result and result[0] else 5

                    # 构建模块配置
                    base_module_id = char_data.character_type * 10
                    modules = [
                        ModuleConfig(module_id=base_module_id + 1, tier=DEFAULT_MODULE_TIER, level=DEFAULT_MODULE_LEVEL),
                        ModuleConfig(module_id=base_module_id + 2, tier=DEFAULT_MODULE_TIER, level=DEFAULT_MODULE_LEVEL),
                        ModuleConfig(module_id=base_module_id + 3, tier=DEFAULT_MODULE_TIER, level=DEFAULT_MODULE_LEVEL),
                    ]

                    # 装备IDs
                    equipment_ids = [base_module_id + i for i in range(1, 5)]

                    # 构建配置对象
                    char_config = CharacterConfig(
                        character_id=char_id,
                        level=DEFAULT_LEVEL,
                        rarity=max_rarity,
                        affection_level=DEFAULT_AFFECTION,
                        modules=modules,
                        equipment_ids=equipment_ids,
                    )
                    school_levels = SchoolLevels(
                        physical_level=DEFAULT_SCHOOL_LEVEL,
                        en_level=DEFAULT_SCHOOL_LEVEL,
                        agility_level=DEFAULT_SCHOOL_LEVEL,
                        fire_level=DEFAULT_SCHOOL_LEVEL,
                        water_level=DEFAULT_SCHOOL_LEVEL,
                        earth_level=DEFAULT_SCHOOL_LEVEL,
                        wind_level=DEFAULT_SCHOOL_LEVEL,
                        light_level=DEFAULT_SCHOOL_LEVEL,
                        dark_level=DEFAULT_SCHOOL_LEVEL,
                    )
                    player_config = PlayerConfig(
                        school_level=DEFAULT_SCHOOL_LEVEL,
                        school_levels=school_levels,
                    )

                    # 计算属性
                    stats = calculator.calculate_stats(char_config, player_config)

                    # 保存到主缓存
                    timestamp = datetime.now().isoformat()
                    cursor.execute("""
                        INSERT OR REPLACE INTO character_cache
                        (character_id, name, character_type, attribute,
                         level, rarity, affection_level,
                         hp, attack, defense, speed,
                         critical_rate, critical_damage, advantage_damage,
                         action_point, passive_point,
                         last_modified)
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """, (
                        char_id, char_data.name, char_data.character_type, char_data.attribute,
                        DEFAULT_LEVEL, max_rarity, DEFAULT_AFFECTION,
                        stats.hp, stats.attack, stats.defense, stats.speed,
                        stats.critical_rate, stats.critical_damage, stats.advantage_damage,
                        stats.initial_ap, stats.initial_pp,
                        timestamp
                    ))

                    # 保存模块配置
                    cursor.execute("DELETE FROM character_modules WHERE character_id = ?", (char_id,))
                    for slot, module in enumerate(modules, 1):
                        cursor.execute("""
                            INSERT INTO character_modules (character_id, slot, module_id, tier, level)
                            VALUES (?, ?, ?, ?, ?)
                        """, (char_id, slot, module.module_id, module.tier, module.level))

                    # 保存装备配置
                    cursor.execute("DELETE FROM character_equipment WHERE character_id = ?", (char_id,))
                    for slot, eq_id in enumerate(equipment_ids, 1):
                        cursor.execute("""
                            INSERT INTO character_equipment (character_id, slot, equipment_id)
                            VALUES (?, ?, ?)
                        """, (char_id, slot, eq_id))

                    # 保存到默认备份表
                    cursor.execute("""
                        INSERT OR REPLACE INTO character_cache_default
                        (character_id, name, character_type, attribute,
                         level, rarity, affection_level,
                         hp, attack, defense, speed,
                         critical_rate, critical_damage, advantage_damage,
                         action_point, passive_point,
                         created_at)
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    """, (
                        char_id, char_data.name, char_data.character_type, char_data.attribute,
                        DEFAULT_LEVEL, max_rarity, DEFAULT_AFFECTION,
                        stats.hp, stats.attack, stats.defense, stats.speed,
                        stats.critical_rate, stats.critical_damage, stats.advantage_damage,
                        stats.initial_ap, stats.initial_pp,
                        timestamp
                    ))

                    cursor.execute("DELETE FROM character_modules_default WHERE character_id = ?", (char_id,))
                    for slot, module in enumerate(modules, 1):
                        cursor.execute("""
                            INSERT INTO character_modules_default (character_id, slot, module_id, tier, level)
                            VALUES (?, ?, ?, ?, ?)
                        """, (char_id, slot, module.module_id, module.tier, module.level))

                    cursor.execute("DELETE FROM character_equipment_default WHERE character_id = ?", (char_id,))
                    for slot, eq_id in enumerate(equipment_ids, 1):
                        cursor.execute("""
                            INSERT INTO character_equipment_default (character_id, slot, equipment_id)
                            VALUES (?, ?, ?)
                        """, (char_id, slot, eq_id))

                    conn.commit()
                    safe_print(f"  [缓存] 角色 {char_id} 缓存已重建 (Lv{DEFAULT_LEVEL}, R{max_rarity})")
                    self.stats['cache_rebuilt'] += 1

                except Exception as e:
                    conn.rollback()
                    safe_print(f"  [错误] 角色 {char_id} 缓存重建失败: {e}")
                    self.warnings.append(f"角色 {char_id} 缓存重建失败: {e}")

            conn.close()

        except Exception as e:
            safe_print(f"  [错误] 缓存重建失败: {e}")
            self.warnings.append(f"缓存重建失败: {e}")
            safe_print("  请手动运行: python scripts/initialize_db_cache.py")

    # ========================================================================
    # 汇总报告
    # ========================================================================

    def print_summary(self):
        """打印导入汇总"""
        safe_print(f"\n{'='*60}")
        safe_print("导入汇总")
        safe_print(f"{'='*60}")
        safe_print(f"  新增队伍:           {self.stats['teams_added']}")
        safe_print(f"  新增根角色:         {self.stats['bases_added']}")
        safe_print(f"  新增变体映射:       {self.stats['variants_added']}")
        safe_print(f"  新增角色数据:       {self.stats['characters_added']}")
        safe_print(f"  新增技能:           {self.stats['skills_added']}")
        safe_print(f"  新增技能Tag值:      {self.stats['skill_tags_added']}")
        safe_print(f"  新增角色技能映射:   {self.stats['char_skills_added']}")
        safe_print(f"  新增稀有度加成:     {self.stats['rarity_bonuses_added']}")
        safe_print(f"  解析技能效果:       {self.stats['skills_parsed']}")
        safe_print(f"  重建属性缓存:       {self.stats['cache_rebuilt']}")
        safe_print(f"  跳过(已存在):       {self.stats['skipped_existing']}")

        if self.warnings:
            safe_print(f"\n警告 ({len(self.warnings)}):")
            for w in self.warnings:
                safe_print(f"  - {w}")

        safe_print(f"\n{'='*60}")


def main():
    """主函数"""
    if len(sys.argv) < 2:
        safe_print("用法: python scripts/import_character.py [--force] <character_id> [character_id2 ...]")
        safe_print("示例: python scripts/import_character.py 144301")
        safe_print("      python scripts/import_character.py 144301 145201")
        safe_print("      python scripts/import_character.py --force 144301")
        sys.exit(1)

    # 解析参数
    force = False
    character_ids = []
    for arg in sys.argv[1:]:
        if arg == '--force' or arg == '-f':
            force = True
        else:
            try:
                character_ids.append(int(arg))
            except ValueError:
                safe_print(f"[错误] 无效的角色ID: {arg}")
                sys.exit(1)

    if not character_ids:
        safe_print("[错误] 未指定角色ID")
        sys.exit(1)

    safe_print("=" * 60)
    safe_print("MGG 角色增量导入工具")
    safe_print("=" * 60)
    safe_print(f"待导入角色: {character_ids}")
    if force:
        safe_print("模式: 强制覆盖")
    safe_print(f"原始数据目录: {SPLIT_DATA_DIR}")
    safe_print(f"目标数据目录: {DATA_DIR}")

    # 创建导入器
    importer = CharacterImporter()

    # 逐个导入角色
    success_count = 0
    for char_id in character_ids:
        if importer.import_character(char_id, force=force):
            success_count += 1

    # 更新数据库
    importer.update_databases()

    # 解析新技能效果
    importer.parse_new_skills()

    # 重建属性缓存
    importer.rebuild_cache()

    # 打印汇总
    importer.print_summary()

    if success_count < len(character_ids):
        sys.exit(1)


if __name__ == "__main__":
    main()
