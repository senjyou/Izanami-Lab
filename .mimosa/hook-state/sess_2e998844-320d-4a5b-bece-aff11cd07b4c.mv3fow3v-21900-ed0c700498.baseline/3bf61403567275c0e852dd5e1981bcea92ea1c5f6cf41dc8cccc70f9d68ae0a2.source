        (f"atk_up施加(日志:StatusAttack val=30)", atk_up_log7, "有", "无" if not atk_up_log7 else "有"),
        (f"敌A spd_down存在", has_spd_down7, "有", f"有(value={spd_down_val7})" if has_spd_down7 else "无"),
        (f"spd_down施加(日志:StatusSpeed val=50)", spd_down_log7, "有", "无" if not spd_down_log7 else "有"),
