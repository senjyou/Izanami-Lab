    char7 = next((u for u in bf7.get_all_units() if u.character_id == char_id), None)
    ally7 = next((u for u in bf7.get_all_units() if u.name == "友方A"), None)
    enemy_a7 = next((u for u in bf7.get_all_units() if u.name == "敌A"), None)
    atk_up_buffs7 = [b for b in ally7.buffs if b.effect_type in ("atk_up", "StatusAttack")] if ally7 else []
    has_atk_up7 = len(atk_up_buffs7) > 0
    atk_up_val7 = atk_up_buffs7[0].value if atk_up_buffs7 else 0
    spd_down_a7 = [b for b in enemy_a7.debuffs if b.effect_type in ("spd_down", "StatusSpeed")] if enemy_a7 else []
    has_spd_down7 = len(spd_down_a7) > 0
    spd_down_val7 = spd_down_a7[0].value if spd_down_a7 else 0
    triggered_130048 = any("ヴォイドアンプリファイ" in log for log in logs7)
    atk_up_log7 = any("StatusAttack" in log and "val=30.0" in log for log in logs7)
    spd_down_log7 = any("StatusSpeed" in log and "val=50.0" in log for log in logs7)
    _verify_and_print(bf7, "PS 130048 ヴォイドアンプリファイ (Lv11, atk_up+spd_down)", [
        (f"130048触发(日志)", triggered_130048, "有", "无" if not triggered_130048 else "有"),
