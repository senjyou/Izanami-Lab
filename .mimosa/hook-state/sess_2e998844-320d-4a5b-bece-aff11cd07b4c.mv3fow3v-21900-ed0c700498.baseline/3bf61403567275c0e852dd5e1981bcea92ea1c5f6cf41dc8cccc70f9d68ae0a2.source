    ally6 = next((u for u in bf6.get_all_units() if u.name == "友方A"), None)
    enemy_a6 = next((u for u in bf6.get_all_units() if u.name == "敌A"), None)
    enemy_b6 = next((u for u in bf6.get_all_units() if u.name == "敌B"), None)
    atk_up_buffs6 = [b for b in ally6.buffs if b.effect_type in ("atk_up", "StatusAttack")] if ally6 else []
    has_atk_up6 = len(atk_up_buffs6) > 0
    atk_down_a6 = [b for b in enemy_a6.debuffs if b.effect_type in ("atk_down", "StatusAttack")] if enemy_a6 else []
    atk_down_b6 = [b for b in enemy_b6.debuffs if b.effect_type in ("atk_down", "StatusAttack")] if enemy_b6 else []
    has_atk_down_on_a = len(atk_down_a6) > 0
    has_atk_down_on_b = len(atk_down_b6) > 0
    atk_down_log6 = any("StatusAttack" in log and "[debuffs]" in log for log in logs6)
    _verify_and_print(bf6, "PS 130032 ステージブースト (Lv11, atk_up+atk_down)", [
        (f"友方A(後列) atk_up存在", has_atk_up6, "有", "有" if has_atk_up6 else "无"),
        (f"敌A(前列) atk_down存在", has_atk_down_on_a, "有", f"有(value={atk_down_a6[0].value})" if has_atk_down_on_a else "无"),
        (f"敌B(前列) atk_down存在", has_atk_down_on_b, "有", f"有(value={atk_down_b6[0].value})" if has_atk_down_on_b else "无"),
        (f"atk_down施加(日志:[debuffs] StatusAttack)", atk_down_log6, "有", "无" if not atk_down_log6 else "有"),
    ])

    # ============================================================
    # Test 7: 130048 ヴォイドアンプリファイ (PS) Lv11+
    # 验证: 後列味方被攻击后 → atk_up(30%) + spd_down(50%)
    # 将友方放后排中央(被攻击), 角色放后排右侧(触发者)
