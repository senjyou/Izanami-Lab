    atk_up_val5 = atk_up_buffs5[0].value if atk_up_buffs5 else 0
    triggered_130032 = any("ステージブースト" in log for log in logs5)
    atk_up_log5 = any("StatusAttack" in log and "val=15" in log for log in logs5)
    _verify_and_print(bf5, "PS 130032 ステージブースト (Lv10, 味方後列atk_up)", [
        (f"130032触发(日志)", triggered_130032, "有", "无" if not triggered_130032 else "有"),
        (f"友方A(後列) atk_up存在", has_atk_up5, "有", f"有(value={atk_up_val5})" if has_atk_up5 else "无"),
        (f"atk_up施加(日志:StatusAttack val=15)", atk_up_log5, "有", "无" if not atk_up_log5 else "有"),
    ])

    # ============================================================
    # Test 6: 130032 ステージブースト (PS) Lv11+
    # 验证: 味方後列atk_up + 敵前列atk_down(10% at Lv11)
    # ============================================================
    test_idx += 1
    _, bf6, _, logs6 = run_test("PS_130032_ステージブースト_Lv11",
        friends_config=[
            {"is_dummy": False, "char_id": char_id,
             "pos": Position.ALLY_CENTER_FRONT,
             "skill_cooldown_override": {120024: 5}},
            {"is_dummy": True, "name": "友方A", "char_id": -601,
             "pos": Position.ALLY_CENTER_BACK,
             "hp": 100000, "atk": 5000, "defense": 3000, "speed": 300,
             "ap": 5, "pp": 5, "element": 3, "char_type": 2},
        ],
        enemies_config=[
            {"is_dummy": True, "name": "敌A", "char_id": -602,
             "pos": Position.ENEMY_CENTER_FRONT,
             "hp": 500000, "atk": 1000, "defense": 3000, "speed": 100,
             "ap": 1, "pp": 1},
            {"is_dummy": True, "name": "敌B", "char_id": -603,
             "pos": Position.ENEMY_LEFT_FRONT,
