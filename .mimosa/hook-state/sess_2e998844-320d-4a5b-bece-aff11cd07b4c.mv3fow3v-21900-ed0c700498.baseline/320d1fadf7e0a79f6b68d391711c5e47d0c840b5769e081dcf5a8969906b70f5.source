# -*- coding: utf-8 -*-
"""回归测试: 双属性角色在「组队同属性加成」中主/副只能二选一（取加成更高的属性）

Bug: 实战中「繋がり合う母娘の絆」(500301, 主土4/副火1) 所在队伍
  风×1(100303) + 土×3(132301/500301/145301) + 火×1(111301)
  模拟器把 500301 的副属性火也计入 → 火=2 → 误触 (primary>=3 且 secondary>=2) 档
  → ATK+15%/HP+15% → 进场ATK 86405×1.15=99365 → 技能伤害 295902
  实战应为 3土1火1风 → primary=3 档 → ATK+10% → 86405×1.10=95045 → 伤害 282365

Fix: _apply_side_synergy 对双属性角色枚举「主/副二选一」，取使全队加成最高者。
"""
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.entities_v2.unit_state import UnitState
from src.entities_v2.enums import Side, Position
from src.combat_v2.services.element_synergy import apply_element_synergy


def _u(uid, element, sub_element=0):
    return UnitState(
        unit_id=uid, name=uid, side=Side.ALLY, position=Position.ALLY_LEFT_FRONT,
        character_id=1, level=1, element=element, sub_element=sub_element,
        character_type=1, max_hp=10000, current_hp=10000, attack=1000,
        defense=1000, speed=100, crit_rate=0.0, crit_damage=0.5,
        advantage_damage=0.0, initial_active_point=3, initial_passive_point=3,
        max_extra_point=0, current_ap=3, current_pp=3, current_ep=0, position_type=3,
    )


class TestDualAttributeSingleCount:
    def test_real_team_gives_10_percent(self):
        """实战队伍 风1/土3/火1 + 主土副火 → 计土(3土1火1风) → ATK+10% HP+10%"""
        units = [
            _u("100303", 3),            # 风
            _u("132301", 4),            # 土
            _u("500301", 4, 1),         # 土 / 副火
            _u("145301", 4),            # 土
            _u("111301", 1),            # 火
        ]
        apply_element_synergy(units)
        for u in units:
            assert u.attack == int(1000 * 1.10), u.unit_id
            assert u.max_hp == int(10000 * 1.10), u.unit_id
        # 不该是 15%（2土2火1风 的取值）
        assert units[2].attack != int(1000 * 1.15)

    def test_damage_reproduction_282365(self):
        """复现目标伤害: 86405×1.10=95045 进场ATK → (130686-6791)×0.78×2.2575×1.204×1.075=282365"""
        base = 86405
        atk = int(base * 1.10)
        assert atk == 95045
        final_atk = int(atk * 1.375)          # 回忆卡攻+2.5% + ストレラ atk_up+35%
        base_diff = final_atk - 6791          # 敌方DEF
        dmg = int(base_diff * 0.78 * 2.2575 * 1.204 * 1.075)
        assert dmg == 282365

    def test_dual_chosen_as_sub_when_sub_gives_more(self):
        """副属性给出更高档位时应计副属性: 3土 + 主火副土 → 计土(土=4) → +15%/+20%"""
        units = [_u("a", 4), _u("b", 4), _u("c", 4), _u("d", 1, 4)]
        apply_element_synergy(units)
        assert units[0].attack == int(1000 * 1.15)
        assert units[0].max_hp == int(10000 * 1.20)

    def test_dual_never_double_counted(self):
        """同一双属性角色不会被同时计入主副: 2土 + 1主土副火 → 土=2/火=1 → 0%"""
        units = [_u("a", 4), _u("b", 4), _u("c", 4, 1)]
        apply_element_synergy(units)
        # 计土: 土=3 → +10%（正确）; 若误当2土2火则 primary=2 → 0%
        assert units[0].attack == int(1000 * 1.10)
