"""查看已成功解析技能的 hybrid 数据结构作为模板。"""
import json

with open('data/skill_effects_hybrid.json', encoding='utf-8') as f:
    data = json.load(f)

# 找几个 success 的 freeze 和 remove_ep 技能作为模板
print('=== 含 freeze 的 success 技能 ===')
for sid, skill in data.items():
    if skill.get('parse_status') != 'success':
        continue
    blocks = skill.get('effect_blocks') or []
    for block in blocks:
        effects = block.get('effects') or []
        for eff in effects:
            if eff.get('effect_type') == 'freeze':
                print(f'  {sid}: {skill.get("name", "")}')
                print(json.dumps(skill, ensure_ascii=False, indent=2)[:1500])
                print()
                break
        else:
            continue
        break

print('=== 含 remove_ep 的 success 技能 ===')
for sid, skill in data.items():
    if skill.get('parse_status') != 'success':
        continue
    blocks = skill.get('effect_blocks') or []
    for block in blocks:
        effects = block.get('effects') or []
        for eff in effects:
            if eff.get('effect_type') == 'remove_ep':
                print(f'  {sid}: {skill.get("name", "")}')
                print(json.dumps(skill, ensure_ascii=False, indent=2)[:1500])
                print()
                break
        else:
            continue
        break

# 找 highest_atk 索敌的技能
print('=== 含 enemy_single_highest_atk 的 success 技能 ===')
count = 0
for sid, skill in data.items():
    if skill.get('parse_status') != 'success':
        continue
    blocks = skill.get('effect_blocks') or []
    for block in blocks:
        effects = block.get('effects') or []
        for eff in effects:
            if eff.get('target_type') == 'enemy_single_highest_atk':
                print(f'  {sid}: {skill.get("name", "")} | trigger={skill.get("trigger_type", "")}')
                count += 1
                if count <= 3:
                    print(json.dumps(skill, ensure_ascii=False, indent=2)[:1500])
                    print()
                break
        else:
            continue
        break
    if count >= 10:
        break
print(f'Total found: {count}+')
