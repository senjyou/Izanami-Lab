# -*- coding: utf-8 -*-
"""回归测试：`adjacent_enemies` 的参照单位必须是「本技能的主目标」，
即使主目标的索敌类型是 `enemy_single_highest_max_hp` 等最高/比例系（非 enemy_single）。

Bug: skill_service 的 adjacent_enemies 分支只从 _block_damage_targets 中查
     ("enemy_single", "enemy_single_furthest", "enemy_single_nearest") 三键，
     遗漏 enemy_single_highest_max_hp（母娘の絆 110083/210128、にげちゃ 120162/220417）
     与 enemy_single_highest_hp_ratio（これは没収です！ 110055）。
     于是退化为「距施法者最近敌人的邻接」，把伤害/减防打到了错误单位
     （敌方オルガ＆ナージャ使用210128时，邻接目标错成主目标自身）。

Fix: 先按明确键查找，再通用回退到本block内首个「enemy_single*」单目标。
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position, SkillEffectType

STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value

MAIN = "繋がり合う母娘の絆"          # ALLY_LEFT_BACK，最高max_hp → 主目标
ADJ_LEFT_FRONT = "隣歩む想い"        # ALLY_LEFT_FRONT，主目标邻接
ADJ_CENTER_BACK = "心色見つめるムードメーカー"  # ALLY_CENTER_BACK，主目标邻接
OTHER_RIGHT_FRONT = "唯一無二の幼なじみ"        # ALLY_RIGHT_FRONT，非邻接
OTHER_RIGHT_BACK = "混沌の立役者"    # ALLY_RIGHT_BACK，非邻接


def _setup():
    bb = BattleBuilder()
    bb.add_ally(unit_id=ADJ_LEFT_FRONT, position=Position.ALLY_LEFT_FRONT, hp=50000,
                atk=1000, defense=1000, speed=500)
    bb.add_ally(unit_id=ADJ_CENTER_BACK, position=Position.ALLY_CENTER_BACK, hp=50000,
                atk=1000, defense=1000, speed=500)
    bb.add_ally(unit_id=OTHER_RIGHT_FRONT, position=Position.ALLY_RIGHT_FRONT, hp=50000,
                atk=1000, defense=1000, speed=500)
    bb.add_ally(unit_id=OTHER_RIGHT_BACK, position=Position.ALLY_RIGHT_BACK, hp=50000,
                atk=1000, defense=1000, speed=500)
    # 主目标：最高max_hp
    bb.add_ally(unit_id=MAIN, position=Position.ALLY_LEFT_BACK, hp=60000,
                atk=1000, defense=1000, speed=500)
    # 敌方施法者：EX 210128「母娘の絆」（低ATK，避免击杀导致断言不稳定）
    bb.add_enemy(unit_id="オルガ＆ナージャ", position=Position.ENEMY_CENTER_FRONT,
                 hp=1000000, atk=100, defense=1000, speed=100,
                 skills=[210128], level=10)
    ctx = bb.build()
    bf, ss = ctx['bf'], ctx['ss']
    caster = next(u for u in bf.enemy_team if u.unit_id == "オルガ＆ナージャ")
    return bf, ss, caster


class TestAdjacentEnemiesUsesMainTarget:
    def test_adjacent_uses_highest_max_hp_main_target(self):
        bf, ss, caster = _setup()

        r = ss.execute_skill(caster, 210128, bf)
        assert r.get("success"), "EX 210128 应执行成功"

        # 收集每个 def_down effect 的目标集合（主目标effect / 邻接effect 各一组）
        groups = [
            {a["target"] for a in t.get("auras", []) if a.get("effect") == STATUS_DEFENSE}
            for t in r["effects_applied"]
            if t.get("effect_type") == "aura"
            and any(a.get("effect") == STATUS_DEFENSE for a in t.get("auras", []))
        ]
        assert {MAIN} in groups, f"应有一组降防作用于主目标，实际={groups}"
        assert {ADJ_LEFT_FRONT, ADJ_CENTER_BACK} in groups, \
            f"邻接组应为最高max_hp主目标的邻接2体，实际={groups}"

    def test_def_down_applied_to_main_and_adjacent(self):
        bf, ss, caster = _setup()

        ss.execute_skill(caster, 210128, bf)

        def_down_units = {
            u.name for u in bf.friend_team
            for b in u.debuffs if b.effect_type == STATUS_DEFENSE
        }
        assert def_down_units == {MAIN, ADJ_LEFT_FRONT, ADJ_CENTER_BACK}, \
            f"降防应作用于主目标+邻接2体，实际={def_down_units}"
        # 非邻接单位不应被降防
        assert OTHER_RIGHT_FRONT not in def_down_units
        assert OTHER_RIGHT_BACK not in def_down_units
