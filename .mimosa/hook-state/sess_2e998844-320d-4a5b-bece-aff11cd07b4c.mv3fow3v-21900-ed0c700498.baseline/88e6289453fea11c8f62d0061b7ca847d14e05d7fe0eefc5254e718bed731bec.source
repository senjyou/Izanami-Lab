    # ── 130044 シンフォニックドロップ (PS2) ──

    def test_ps2_config_symphonic_drop(self):
        """130044 must have Block1 (spd_up) and Block2 (Lv11+ dmg_dealt_up)."""
        parsed = self.dl.get_parsed_skill_data(PS_SYMPHONIC_DROP)
        self.assertIsNotNone(parsed)
        self.assertEqual(parsed.get('trigger_type'), 'after_as_attack')

        blocks = parsed.get('effect_blocks', [])
        self.assertEqual(len(blocks), 2, "130044 should have 2 blocks")

        # Block1: spd_up
        b1_effects = blocks[0].get('effects', [])
        self.assertEqual(len(b1_effects), 1)
        spd_eff = b1_effects[0]
        self.assertEqual(spd_eff.get('effect_type'), 'spd_up')
        self.assertEqual(spd_eff.get('target_type'), 'self')
        self.assertEqual(spd_eff.get('value_tag'), 'spd')
        self.assertEqual(spd_eff.get('duration'), 2)
        self.assertTrue(spd_eff.get('flags', {}).get('stackable'),
                        "spd_up must be stackable (重複可)")

        # Block2: Lv11+ dmg_dealt_up
        b2 = blocks[1]
        b2_cond = b2.get('condition', {})
        self.assertEqual(b2_cond.get('type'), 'active_level_min')
        self.assertEqual(b2_cond.get('value'), 11)

        b2_effects = b2.get('effects', [])
        self.assertEqual(len(b2_effects), 1)
        dmg_up = b2_effects[0]
        self.assertEqual(dmg_up.get('effect_type'), 'dmg_dealt_up')
        self.assertEqual(dmg_up.get('target_type'), 'self')
        self.assertEqual(dmg_up.get('value_tag'), 'dmg')
        self.assertEqual(dmg_up.get('duration'), 1)
        self.assertEqual(dmg_up.get('duration_type'), 'attack')
        self.assertTrue(dmg_up.get('flags', {}).get('stackable'))
        self.assertEqual(dmg_up.get('flags', {}).get('attack_limited'), 1)

    def test_ps2_trigger_after_as_attack(self):
        """130044 trigger_type must be 'after_as_attack'."""
        parsed = self.dl.get_parsed_skill_data(PS_SYMPHONIC_DROP)
        self.assertEqual(parsed.get('trigger_type'), 'after_as_attack')

    def test_ps2_spd_up_2_actions_stackable(self):
        """130044 Block1 spd_up: duration=2 (actions), stackable=true."""
        caster = _make_unit(
            "caster", "Caster", Side.ALLY, Position.ALLY_CENTER_BACK,
            hp=100000, atk=10000, skills=[PS_SYMPHONIC_DROP],
            skill_levels={PS_SYMPHONIC_DROP: 10}, pp=10, ap=10,  # Lv10
            element=Attribute.WIND.value, character_type=2,
        )
        enemy = _make_unit("enemy", "敵", Side.ENEMY, Position.ENEMY_CENTER_FRONT, hp=50000)
        bf = _make_bf(caster, enemy)
        ss, _ = self._make_services(bf)

        ss.execute_skill(caster, PS_SYMPHONIC_DROP, bf, skip_cost=True)

        STATUS_SPEED = SkillEffectType.STATUS_SPEED.value
        spd_buffs = [b for b in caster.buffs if b.effect_type == STATUS_SPEED]
        self.assertGreater(len(spd_buffs), 0,
                           "Caster should have spd_up buff")
        # duration should be 2 (actions)
        self.assertEqual(spd_buffs[0].duration, 2,
                         "spd_up duration must be 2 (actions)")

