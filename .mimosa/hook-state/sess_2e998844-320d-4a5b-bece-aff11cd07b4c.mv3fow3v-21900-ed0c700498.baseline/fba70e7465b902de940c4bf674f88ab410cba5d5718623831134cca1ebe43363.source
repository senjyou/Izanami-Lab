# 10. シェラッグ 220459 コキュートバリア：味方全体 dmg_taken_down(反比HP冻结)
# =============================================================================
class TestS7CocytusBarrier220459(unittest.TestCase):
    """220459: dmg_taken_down ally_all, attack_limited=1,
    caster_hp_ratio_inverse+floor=0.3（付与時冻结）"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_svc(self):
        return SkillService(
            data_loader=MagicMock(),
            resource_service=MagicMock(),
            target_service=TargetService(),
            damage_service=MagicMock(),
            aura_service=AuraService(),
            status_service=MagicMock(),
            trigger_service=MagicMock(),
        )

    def _make_effect(self, **kwargs):
        e = MagicMock()
        defaults = dict(effect_type="dmg_taken_down", target_type="ally_all",
                        target_identifier=None, value=50, value_tag=None,
                        duration=-1, duration_type="action", hit_count=None,
                        condition=None,
                        flags={"value_type": "percent", "attack_limited": 1,
                               "caster_hp_ratio_inverse": True,
                               "caster_hp_ratio_floor": 0.3})
        defaults.update(kwargs)
        for k, v in defaults.items():
            setattr(e, k, v)
        return e

    def test_config(self):
        """配置: dmg_taken_down 50% ally_all + attack_limited + caster_hp_ratio"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        eff = hy["220459"]["effect_blocks"][0]["effects"][0]
        self.assertEqual(eff["effect_type"], "dmg_taken_down")
        self.assertEqual(eff["target_type"], "ally_all")
        self.assertEqual(eff["value"], 50)
        self.assertEqual(eff["flags"]["attack_limited"], 1)
        self.assertTrue(eff["flags"]["caster_hp_ratio_inverse"])
        self.assertAlmostEqual(eff["flags"]["caster_hp_ratio_floor"], 0.3)

    def test_full_hp_value_zero(self):
        """施法者满血 → 缩放值 = 0"""
        ss = self._make_svc()
        caster = _make_unit("shera", "シェラッグ", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT, hp=10000)
        ally = _make_unit("ea", "敵友", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                          hp=10000)
        bf = _make_bf(caster, ally)
        ss._current_skill_id = 220459
        result = ss._apply_aura(caster, self._make_effect(), bf, is_debuff=False)
        self.assertIsNotNone(result)
        buffs = [b for b in ally.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(buffs), 1)
        self.assertAlmostEqual(buffs[0].value, 0.0, places=4)

    def test_hp30_percent_max_value(self):
        """施法者HP=30%（floor）→ 最大值50"""
        ss = self._make_svc()
        caster = _make_unit("shera", "シェラッグ", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT, hp=10000)
        caster.current_hp = 3000
        ally = _make_unit("ea", "敵友", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                          hp=10000)
        bf = _make_bf(caster, ally)
        ss._current_skill_id = 220459
        ss._apply_aura(caster, self._make_effect(), bf, is_debuff=False)
        buffs = [b for b in ally.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertAlmostEqual(buffs[0].value, 50.0, places=4)

    def test_hp_below_floor_capped(self):
        """施法者HP=15%（低于floor）→ 仍为最大值50"""
        ss = self._make_svc()
        caster = _make_unit("shera", "シェラッグ", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT, hp=10000)
        caster.current_hp = 1500
        ally = _make_unit("ea", "敵友", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                          hp=10000)
        bf = _make_bf(caster, ally)
        ss._current_skill_id = 220459
        ss._apply_aura(caster, self._make_effect(), bf, is_debuff=False)
        buffs = [b for b in ally.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertAlmostEqual(buffs[0].value, 50.0, places=4)

    def test_value_frozen_at_application(self):
        """付与時冻结: 施法者回血不改变已付与buff的value"""
        ss = self._make_svc()
        caster = _make_unit("shera", "シェラッグ", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT, hp=10000)
        caster.current_hp = 6500
        ally = _make_unit("ea", "敵友", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                          hp=10000)
        bf = _make_bf(caster, ally)
        ss._current_skill_id = 220459
        ss._apply_aura(caster, self._make_effect(), bf, is_debuff=False)
        buffs = [b for b in ally.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertAlmostEqual(buffs[0].value, 50.0 * (0.35 / 0.7), places=4)
        caster.current_hp = 3000
        self.assertAlmostEqual(buffs[0].value, 50.0 * (0.35 / 0.7), places=4)


# =============================================================================
# 11. シェラッグ 220460 バブルリヴァ：最低HP味方×2回復（威力35固定）
# =============================================================================
class TestS7BubbleRiva220460(unittest.TestCase):
    """220460: HP低い順に味方2体 威力35回復（InterpolationMode=1固定値）"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def test_config(self):
        """配置: heal ally_single_lowest_hp_x2 value_tag=威力"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        eff = hy["220460"]["effect_blocks"][0]["effects"][0]
        self.assertEqual(eff["effect_type"], "heal")
        self.assertEqual(eff["target_type"], "ally_single_lowest_hp_x2")
        self.assertEqual(eff["value_tag"], "威力")
        self.assertIsNone(eff["value"])
        sk = json.load(open(ROOT / "data" / "skills.json", encoding="utf-8"))
        self.assertEqual(sk["220460"]["template_tags"]["威力"]["values"][0]["value"], 35.0)

    def test_runtime_heals_two_lowest_hp_allies(self):
        """运行时: HP最低的2个味方被回復"""
        caster = _make_unit("shera", "シェラッグ", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=10000, speed=800,
                            skills=[220460], skill_levels={220460: 1})
        a = _make_unit("ea_a", "敵友A", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                       hp=10000, atk=8000)
        a.current_hp = 2000  # 最低
        b = _make_unit("ea_b", "敵友B", Side.ENEMY, Position.ENEMY_RIGHT_FRONT,
                       hp=10000, atk=8000)
        b.current_hp = 5000  # 次低
        c = _make_unit("ea_c", "敵友C", Side.ENEMY, Position.ENEMY_CENTER_BACK,
                       hp=10000, atk=8000)  # 满血
        bf = _make_bf(caster, a, b, c)
        ss, *_ = _make_services(bf, self.dl)
        hp_a, hp_b, hp_c = a.current_hp, b.current_hp, c.current_hp
        result = ss.execute_skill(caster=caster, skill_id=220460,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertGreater(a.current_hp, hp_a, "最低HP味方A应被回復")
        self.assertGreater(b.current_hp, hp_b, "次低HP味方B应被回復")
        self.assertEqual(c.current_hp, hp_c, "满血味方C不应被回復")
        # 回復量 = atk × 35%（威力35, InterpolationMode=1固定）
        expected = int(caster.attack * 0.35)
        self.assertEqual(a.current_hp - hp_a, min(expected, 10000 - hp_a))


# =============================================================================
# 12. シェラッグ 230492 アクアオラクル：after_ally_attacked 回復+幻惑
# =============================================================================
class TestS7AquaOracle230492(unittest.TestCase):
    """230492: 味方被攻击后回復该味方（威力40）+ HP<30%时幻惑攻击者"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self, attacked_hp_ratio=0.9, atk=10000):
        caster = _make_unit("shera", "シェラッグ", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=atk, speed=800,
                            skills=[230492], skill_levels={230492: 1}, pp=10)
        damaged = _make_unit("ea", "受击敵友", Side.ENEMY,
                             Position.ENEMY_LEFT_FRONT,
                             hp=10000, atk=8000)
        damaged.current_hp = int(10000 * attacked_hp_ratio)
        attacker = _make_unit("al_atk", "我方攻击者", Side.ALLY,
                              Position.ALLY_CENTER_FRONT,
                              hp=50000, atk=8000, defense=3000,
                              skills=[220001], skill_levels={220001: 1})
        bf = _make_bf(caster, damaged, attacker)
        ss, ts, *_ = _make_services(bf, self.dl)
        return caster, damaged, attacker, bf, ss, ts

    def test_config(self):
        """配置: after_ally_attacked + target_is_alive + heal(trigger_attacker→受击者回退) +
        heal_target_hp_below30→genwaku50"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        s = hy["230492"]
        self.assertEqual(s["trigger_type"], "after_ally_attacked")
        self.assertEqual(s["global_condition"], {"type": "target_is_alive"})
        heal = s["effect_blocks"][0]["effects"][0]
        self.assertEqual(heal["effect_type"], "heal")
        self.assertEqual(heal["target_identifier"], "trigger_attacker")
        self.assertEqual(heal["value_tag"], "威力")
        block2 = s["effect_blocks"][1]
        self.assertEqual(block2["condition"]["type"], "heal_target_hp_below")
        self.assertEqual(block2["condition"]["value"], 30)
        gen = block2["effects"][0]
        self.assertEqual(gen["effect_type"], "genwaku")
        self.assertEqual(gen["target_identifier"], "trigger_attacker")
        self.assertEqual(gen["value"], 50)
        self.assertEqual(gen["duration"], 1)
        # skills.json 威力=40
        sk = json.load(open(ROOT / "data" / "skills.json", encoding="utf-8"))
        self.assertEqual(sk["230492"]["template_tags"]["威力"]["values"][0]["value"], 40.0)

    def test_heals_attacked_ally_no_genwaku_when_hp_high(self):
        """运行时: 受击味方被回復; HP>=30%时不给攻击者幻惑"""
        caster, damaged, attacker, bf, ss, ts = self._setup(attacked_hp_ratio=0.9)
        actions = ts.trigger_after_ally_attacked(
            targets=[damaged], battlefield=bf,
            actor=attacker, primary_target=damaged,
        )
        ps = [a for a in actions if a.skill_id == 230492]
        self.assertGreater(len(ps), 0, "味方被攻击后应触发アクアオラクル")
        hp_before = damaged.current_hp
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf, trigger_timing="after_ally_attacked")
        self.assertGreater(damaged.current_hp, hp_before, "受击味方应被回復")
        self.assertIsNone(_find_aura(attacker, GENWAKU),
                          "HP>=30%时攻击者不应被幻惑")

    def test_genwaku_when_attacked_ally_below_30pct(self):
        """运行时: 受击味方回復後HP<30% → 攻击者被幻惑
        （heal_target_hp_below 按回復後HP判定: 5%+回復2000(atk5000×40%) → 25% < 30%）"""
        caster, damaged, attacker, bf, ss, ts = self._setup(attacked_hp_ratio=0.05,
                                                            atk=5000)
        actions = ts.trigger_after_ally_attacked(
            targets=[damaged], battlefield=bf,
            actor=attacker, primary_target=damaged,
        )
        ps = [a for a in actions if a.skill_id == 230492]
        self.assertGreater(len(ps), 0)
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf, trigger_timing="after_ally_attacked")
        self.assertIsNotNone(_find_aura(attacker, GENWAKU),
                             "受击味方回復後HP<30%时攻击者应被幻惑")

    def test_no_trigger_when_attacked_ally_dead(self):
        """受击味方阵亡 → target_is_alive 不满足，不触发"""
        caster, damaged, attacker, bf, ss, ts = self._setup(attacked_hp_ratio=0.9)
        damaged.is_alive = False
        actions = ts.trigger_after_ally_attacked(
            targets=[damaged], battlefield=bf,
            actor=attacker, primary_target=damaged,
        )
        ps = [a for a in actions if a.skill_id == 230492]
        self.assertEqual(len(ps), 0, "受击味方阵亡不应触发")


# =============================================================================
# 13. サーヴェント 220461 ルインブースト：HP>=80%条件 + 自身強化 + action_damage
# =============================================================================
class TestS7RuinBoost220461(unittest.TestCase):
    """220461: HP>=80%才发动; atk+8%/dmg_dealt+5%（永続重複可unremovable）+
    敌全体 action_damage EN (dmg tag, 1action)"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self, hp_ratio=1.0):
        caster = _make_unit("serv", "サーヴェント", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[220461], skill_levels={220461: 1})
        caster.current_hp = int(100000 * hp_ratio)
        targets = [_make_unit(f"al_{i}", f"我方{i}", Side.ALLY,
                              [Position.ALLY_LEFT_FRONT, Position.ALLY_CENTER_FRONT,
                               Position.ALLY_RIGHT_FRONT][i], hp=10000)
                   for i in range(3)]
        bf = _make_bf(caster, *targets)
        ss, *_ = _make_services(bf, self.dl)
        return caster, targets, bf, ss

    def test_config(self):
        """配置: global_condition self_hp_above 80 + atk_up/dmg_dealt_up unremovable +
        action_damage EN"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        s = hy["220461"]
        self.assertEqual(s["global_condition"], {"type": "self_hp_above", "value": 80})
        effs = s["effect_blocks"][0]["effects"]
        self.assertEqual({e["effect_type"] for e in effs},
                         {"atk_up", "dmg_dealt_up", "add_status"})
        for e in effs[:2]:
            self.assertEqual(e["target_type"], "self")
            self.assertTrue(e["flags"]["unremovable"])
            self.assertTrue(e["flags"]["stackable"])
            self.assertEqual(e["duration"], -1)
        dot = effs[2]
        self.assertEqual(dot["flags"]["status_type"], "action_damage")
        self.assertTrue(dot["flags"]["is_en_attack"])
        self.assertEqual(dot["value_tag"], "dmg")
        self.assertEqual(dot["duration"], 1)
        self.assertEqual(dot["target_type"], "enemy_all")

    def test_runtime_full_hp_applies_buffs_and_dot(self):
        """运行时: 满血 → 自身 atk_up/dmg_dealt_up + 敌全体 action_damage"""
        caster, targets, bf, ss = self._setup(hp_ratio=1.0)
        result = ss.execute_skill(caster=caster, skill_id=220461,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        atk_up = _find_aura(caster, STATUS_ATTACK)
        self.assertIsNotNone(atk_up, "应获得atk_up")
        self.assertAlmostEqual(atk_up.value, 8.0, places=4, msg="atk_up应+8%")
        dealt = _find_aura(caster, SkillEffectType.DEALT_DAMAGE.value)
        self.assertIsNotNone(dealt, "应获得dmg_dealt_up")
        self.assertAlmostEqual(dealt.value, 5.0, places=4, msg="dmg_dealt_up应+5%")
        for t in targets:
            dot = _find_aura(t, ACTION_DAMAGE)
            self.assertIsNotNone(dot, f"{t.unit_id} 应获得action_damage")

    def test_runtime_below_80pct_skill_blocked(self):
        """运行时: HP<80% → 技能不发动（global_condition）"""
        caster, targets, bf, ss = self._setup(hp_ratio=0.5)
        result = ss.execute_skill(caster=caster, skill_id=220461,
                                  battlefield=bf, skip_cost=True)
        self.assertFalse(result.get("success"), "HP<80%不应执行成功")
        self.assertEqual(result.get("error"), "global_condition not met")
        self.assertIsNone(_find_aura(caster, STATUS_ATTACK))
        for t in targets:
            self.assertIsNone(_find_aura(t, ACTION_DAMAGE))

    def test_select_skill_skips_when_below_80pct(self):
        """select_skill AI: HP<80%时跳过220461选择其他技能/待机"""
        caster, targets, bf, ss = self._setup(hp_ratio=0.5)
        caster.current_ap = 4
        chosen = ss.select_skill(caster)
        self.assertNotEqual(chosen, 220461, "HP<80%时AI不应选择220461")

    def test_select_skill_picks_when_full_hp(self):
        """select_skill AI: 满血时选择220461"""
        caster, targets, bf, ss = self._setup(hp_ratio=1.0)
        chosen = ss.select_skill(caster)
        self.assertEqual(chosen, 220461, "满血时AI应选择220461")


# =============================================================================
# 14. サーヴェント 220462 ストリームブレイク：縦列5hit EN攻撃
# =============================================================================
class TestS7StreamBreak220462(unittest.TestCase):
    """220462: HP割合最高敵の縦列（同列前后位）5hit EN攻撃"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def test_config(self):
        """配置: damage enemy_column_highest_hp_ratio 5hit EN 威力"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        eff = hy["220462"]["effect_blocks"][0]["effects"][0]
        self.assertEqual(eff["effect_type"], "damage")
        self.assertEqual(eff["target_type"], "enemy_column_highest_hp_ratio")
        self.assertEqual(eff["hit_count"], 5)
        self.assertTrue(eff["flags"]["is_en_attack"])
        self.assertEqual(eff["value_tag"], "威力")

    def test_runtime_hits_whole_column(self):
        """运行时: HP割合最高敵所在縦列全体受伤，他列不受伤"""
        caster = _make_unit("serv", "サーヴェント", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[220462], skill_levels={220462: 1})
        lf = _make_unit("al_lf", "左前", Side.ALLY, Position.ALLY_LEFT_FRONT,
                        hp=100000)
        lb = _make_unit("al_lb", "左後", Side.ALLY, Position.ALLY_LEFT_BACK,
                        hp=100000)
        cf = _make_unit("al_cf", "中前", Side.ALLY, Position.ALLY_CENTER_FRONT,
                        hp=100000)
        cf.current_hp = 5000  # 50%: 全场最高HP比例（其他100%? no——满血=100%更高）
        cb_ = _make_unit("al_cb", "中後", Side.ALLY, Position.ALLY_CENTER_BACK,
                         hp=100000)
        # 调整: 中列 cf 50%，cb 20%，左右列 100%（最高）→应打左列
        cb_.current_hp = 2000
        bf = _make_bf(caster, lf, lb, cf, cb_)
        ss, *_ = _make_services(bf, self.dl)
        hp_before = {u.unit_id: u.current_hp for u in (lf, lb, cf, cb_)}
        result = ss.execute_skill(caster=caster, skill_id=220462,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 左列满血(100%)为最高比例 → 左列两体受伤
        self.assertLess(lf.current_hp, hp_before["al_lf"], "左前应受伤（左列100%最高）")
        self.assertLess(lb.current_hp, hp_before["al_lb"], "左後应受伤（同縦列）")
        self.assertEqual(cf.current_hp, hp_before["al_cf"], "中列不应受伤")
        self.assertEqual(cb_.current_hp, hp_before["al_cb"], "中列不应受伤")

    def test_single_member_column(self):
        """縦列只有1体时仅单体受伤"""
        caster = _make_unit("serv", "サーヴェント", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[220462], skill_levels={220462: 1})
        lf = _make_unit("al_lf", "左前", Side.ALLY, Position.ALLY_LEFT_FRONT,
                        hp=100000)
        cf = _make_unit("al_cf", "中前", Side.ALLY, Position.ALLY_CENTER_FRONT,
                        hp=100000)
        cf.current_hp = 3000  # 中前30% < 左前100%
        bf = _make_bf(caster, lf, cf)
        ss, *_ = _make_services(bf, self.dl)
        hp_before = {u.unit_id: u.current_hp for u in (lf, cf)}
        result = ss.execute_skill(caster=caster, skill_id=220462,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertLess(lf.current_hp, hp_before["al_lf"], "左前应受伤")


# =============================================================================
# 15. サーヴェント 220463 ウェーブバッシュ：EN優先 HP割合最高单体
# =============================================================================
class TestS7WaveBash220463(unittest.TestCase):
    """220463: ENタイプ(character_type=2)優先でHP割合最高单体 EN攻撃"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def test_config(self):
        """配置: damage enemy_single_highest_hp_ratio_en_priority 1hit EN"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        eff = hy["220463"]["effect_blocks"][0]["effects"][0]
        self.assertEqual(eff["effect_type"], "damage")
        self.assertEqual(eff["target_type"],
                         "enemy_single_highest_hp_ratio_en_priority")
        self.assertEqual(eff["hit_count"], 1)
        self.assertTrue(eff["flags"]["is_en_attack"])

    def test_runtime_prefers_en_type(self):
        """运行时: 有EN类型时，即使HP比例更低也优先打EN类型"""
        caster = _make_unit("serv", "サーヴェント", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[220463], skill_levels={220463: 1})
        en_low = _make_unit("al_en", "EN型低血", Side.ALLY,
                            Position.ALLY_LEFT_FRONT, hp=100000,
                            character_type=2)
        en_low.current_hp = 50000  # 50%
        non_en_high = _make_unit("al_n", "非EN型高血", Side.ALLY,
                                 Position.ALLY_CENTER_FRONT, hp=100000,
                                 character_type=1)  # 100%
        bf = _make_bf(caster, en_low, non_en_high)
        ss, *_ = _make_services(bf, self.dl)
        result = ss.execute_skill(caster=caster, skill_id=220463,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertLess(en_low.current_hp, 50000, "EN类型应被优先攻击")
        self.assertEqual(non_en_high.current_hp, 100000, "非EN型不应被攻击")

    def test_runtime_falls_back_to_highest_ratio(self):
        """运行时: 无EN类型 → 全体中HP割合最高"""
        caster = _make_unit("serv", "サーヴェント", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[220463], skill_levels={220463: 1})
        u1 = _make_unit("al_1", "低血", Side.ALLY, Position.ALLY_LEFT_FRONT,
                        hp=100000, character_type=1)
        u1.current_hp = 50000
        u2 = _make_unit("al_2", "高血", Side.ALLY, Position.ALLY_CENTER_FRONT,
                        hp=100000, character_type=3)
        bf = _make_bf(caster, u1, u2)
        ss, *_ = _make_services(bf, self.dl)
        result = ss.execute_skill(caster=caster, skill_id=220463,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertEqual(u1.current_hp, 50000, "低血不应被攻击")
        self.assertLess(u2.current_hp, 100000, "高血应被攻击")


# =============================================================================
# 16. サーヴェント 230493 ファストジャッジ：on_turn_start 先制EN攻撃+属性有利分支
# =============================================================================
class TestS7FastJudge230493(unittest.TestCase):
    """230493: 回合开始最速敌先制EN攻撃; 属性有利时敌全体 spd/skill_power -50%"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self, caster_element=1, target_element=3):
        """caster_elem=1(火) → 有利=3(风)"""
        caster = _make_unit("serv", "サーヴェント", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            element=caster_element,
                            skills=[230493], skill_levels={230493: 1}, pp=10)
        fast = _make_unit("al_fast", "最速我方", Side.ALLY,
                          Position.ALLY_CENTER_FRONT, hp=100000, speed=900,
                          element=target_element)
        slow = _make_unit("al_slow", "低速我方", Side.ALLY,
                          Position.ALLY_LEFT_FRONT, hp=100000, speed=300,
                          element=target_element)
        bf = _make_bf(caster, fast, slow)
        ss, ts, *_ = _make_services(bf, self.dl)
        return caster, fast, slow, bf, ss, ts

    def test_config(self):
        """配置: on_turn_start + 先制最速敌EN + prev_target_element_advantage分支"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        s = hy["230493"]
        self.assertEqual(s["trigger_type"], "on_turn_start")
        dmg = s["effect_blocks"][0]["effects"][0]
        self.assertEqual(dmg["effect_type"], "damage")
        self.assertEqual(dmg["target_type"], "enemy_single_highest_spd")
        self.assertTrue(dmg["flags"]["is_preemptive"])
        self.assertTrue(dmg["flags"]["is_en_attack"])
        block2 = s["effect_blocks"][1]
        self.assertEqual(block2["condition"]["type"], "prev_target_element_advantage")
        self.assertEqual({e["effect_type"] for e in block2["effects"]},
                         {"spd_down", "skill_power_down"})
        for e in block2["effects"]:
            self.assertEqual(e["value"], 50)
            self.assertEqual(e["duration"], 1)
            self.assertEqual(e["target_type"], "enemy_all")

    def test_preemptive_filtered_by_phase(self):
        """配置含is_preemptive → 在先制阶段被收集"""
        caster, fast, slow, bf, ss, ts = self._setup()
        pre_actions = ts.trigger_turn_start_preemptive(bf)
        ps_pre = [a for a in pre_actions if a.skill_id == 230493]
        self.assertGreater(len(ps_pre), 0, "ファストジャッジ应在先制阶段触发")
        non_pre = ts.trigger_turn_start_non_preemptive(bf)
        ps_non = [a for a in non_pre if a.skill_id == 230493]
        self.assertEqual(len(ps_non), 0, "不应出现在非先制阶段")

    def test_advantage_applies_both_debuffs(self):
        """属性有利（火→风）: 最速敌受伤+敌全体 spd/skill_power down"""
        caster, fast, slow, bf, ss, ts = self._setup(caster_element=1,
                                                     target_element=3)
        actions = ts.trigger_turn_start_preemptive(bf)
        ps = [a for a in actions if a.skill_id == 230493]
        self.assertGreater(len(ps), 0)
        hp_before = fast.current_hp
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf, trigger_timing="on_turn_start")
        self.assertLess(fast.current_hp, hp_before, "最速敌应受伤")
        self.assertIsNotNone(_find_aura(fast, STATUS_SPEED, debuff=True),
                             "应获得spd_down")
        self.assertIsNotNone(_find_aura(slow, STATUS_SPEED, debuff=True),
                             "敌全体应获得spd_down")
        self.assertIsNotNone(_find_aura(fast,
                                        SkillEffectType.SKILL_POWER_DOWN.value,
                                        debuff=True),
                             "应获得skill_power_down")

    def test_no_advantage_no_debuffs(self):
        """属性无利（火→水）: 仍受伤但不加debuff"""
        caster, fast, slow, bf, ss, ts = self._setup(caster_element=1,
                                                     target_element=2)
        actions = ts.trigger_turn_start_preemptive(bf)
        ps = [a for a in actions if a.skill_id == 230493]
        self.assertGreater(len(ps), 0)
        hp_before = fast.current_hp
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf, trigger_timing="on_turn_start")
        self.assertLess(fast.current_hp, hp_before, "最速敌应受伤")
        self.assertIsNone(_find_aura(fast, STATUS_SPEED, debuff=True),
                          "属性无利时不应获得spd_down")
        self.assertIsNone(_find_aura(slow, STATUS_SPEED, debuff=True))


# =============================================================================
# 17. サーヴェント 210133 カタラクトブレイク：EX AP6 敌全体EN+被ダメup(反比冻结)
# =============================================================================
class TestS7CataractBreak210133(unittest.TestCase):
    """210133: EX(AP6) 敵全体威力50 EN攻撃 + dmg_taken_up(dmg tag, 重複可,
    attack_limited=1, caster_hp_ratio_inverse)"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self, caster_hp_ratio=1.0):
        caster = _make_unit("serv", "サーヴェント", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[210133], skill_levels={210133: 1})
        caster.current_hp = int(100000 * caster_hp_ratio)
        targets = [_make_unit(f"al_{i}", f"我方{i}", Side.ALLY,
                              [Position.ALLY_LEFT_FRONT, Position.ALLY_CENTER_FRONT,
                               Position.ALLY_RIGHT_FRONT][i], hp=10000)
                   for i in range(3)]
        bf = _make_bf(caster, *targets)
        ss, *_ = _make_services(bf, self.dl)
        return caster, targets, bf, ss

    def test_config(self):
        """配置: EX skill_type=3 AP6 + damage(EN,威力) + dmg_taken_up(dmg tag)"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        s = hy["210133"]
        self.assertEqual(s["skill_type"], 3)
        self.assertEqual(s["resource_cost"], 6)
        dmg = s["effect_blocks"][0]["effects"][0]
        self.assertEqual(dmg["target_type"], "enemy_all")
        self.assertTrue(dmg["flags"]["is_en_attack"])
        self.assertEqual(dmg["value_tag"], "威力")
        debuff = s["effect_blocks"][0]["effects"][1]
        self.assertEqual(debuff["effect_type"], "dmg_taken_up")
        self.assertEqual(debuff["value_tag"], "dmg")
        self.assertTrue(debuff["flags"]["stackable"])
        self.assertEqual(debuff["flags"]["attack_limited"], 1)
        self.assertTrue(debuff["flags"]["caster_hp_ratio_inverse"])
        # dmg tag: Lv1=30 → Lv10=50
        sk = json.load(open(ROOT / "data" / "skills.json", encoding="utf-8"))
        vals = {v["level"]: v["value"] for v in
                sk["210133"]["template_tags"]["dmg"]["values"]}
        self.assertEqual(vals[1], 30.0)
        self.assertAlmostEqual(vals[10], 50.0, places=4)

    def test_runtime_ex_requires_ep_full(self):
        """运行时: EP满时EX才被AI选择"""
        caster, targets, bf, ss = self._setup()
        caster.current_ep = caster.max_extra_point  # EP满
        caster.current_ap = 0
        chosen = ss.select_skill(caster)
        self.assertEqual(chosen, 210133, "EP满时AI应选择EX 210133")

    def test_runtime_damage_and_debuff(self):
        """运行时: 敌全体受伤+获得dmg_taken_up debuff"""
        caster, targets, bf, ss = self._setup(caster_hp_ratio=0.3)
        for t in targets:
            t.max_ep = 10
        ss._current_skill_id = 210133
        caster.skill_levels[210133] = 10  # dmg tag Lv10=50 → 反比0.3 → 50
        hp_before = {u.unit_id: u.current_hp for u in targets}
        result = ss.execute_skill(caster=caster, skill_id=210133,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        for t in targets:
            self.assertLess(t.current_hp, hp_before[t.unit_id],
                            f"{t.unit_id} 应受伤")
            db = [d for d in t.debuffs if d.effect_type == RECEIVED_DAMAGE]
            self.assertEqual(len(db), 1, f"{t.unit_id} 应获得dmg_taken_up")
            # caster HP=30% → floor → 最大值 = dmg tag Lv10 = 50
            self.assertAlmostEqual(db[0].value, 50.0, places=4)


# =============================================================================
# 18. 阶段集成冒烟：阶段1/50/100 可完整战斗
# =============================================================================
class TestS7StageIntegrationSmoke(unittest.TestCase):
    """第7期阶段完整战斗冒烟测试（无异常 + 关键机制触发）"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()
        with (ROOT / "data" / "circle_battle_enemies.json").open("r", encoding="utf-8") as f:
            cls.cb = json.load(f)

    def _run_stage(self, stage: int, seed: int = 2026):
        import random as _random
        from src.combat_v2.circle_battle_controller import CircleBattleController
        from src.combat_v2.battle_flow_controller import BattleConfig
        from src.utils.batch_simulator import _create_circle_battle_enemy_worker

        stage_data = self.cb["season_7"][str(stage)]
        _random.seed(seed)
        bf = BattlefieldState()
        POS = [Position.ALLY_LEFT_FRONT, Position.ALLY_CENTER_FRONT,
               Position.ALLY_RIGHT_FRONT, Position.ALLY_LEFT_BACK,
               Position.ALLY_CENTER_BACK, Position.ALLY_RIGHT_BACK]
        for i in range(6):
            bf.add_unit(_make_unit(f"A_{i}", f"Ally{i}", Side.ALLY, POS[i],
                                   hp=100000, atk=5000, defense=5000, speed=800))
        for enemy_data in stage_data["enemies"]:
            u = _create_circle_battle_enemy_worker(self.dl, enemy_data)
            if u:
                bf.add_unit(u)
        bc = BattleConfig()
        bc.max_turns = stage_data.get("max_turn", 5)
        controller = CircleBattleController(bf, data_loader=self.dl, config=bc,
                                            season=7, stage=stage)
        return controller.execute_battle(), bf

    def test_stage1_battle_runs(self):
        """阶段1: 完整战斗无异常，ダイブスリープ仅标记一次"""
        result, bf = self._run_stage(1)
        self.assertIn(result.get("result"),
                      ("FINISHED", "TIMEOUT", "TIMEOUT_LOSS"))
        self.assertTrue(result.get("is_circle_battle"))
        self.assertEqual(result.get("season"), 7)
        self.assertEqual(result.get("stage"), 1)
        swong = next((u for u in bf.enemy_team if u.name == "スウォング"), None)
        if swong is not None:
            self.assertIn(230489, swong.once_per_battle_triggered)

    def test_stage50_battle_runs(self):
        """阶段50: 完整战斗无异常（含EX 210133）"""
        result, bf = self._run_stage(50)
        self.assertIn(result.get("result"),
                      ("FINISHED", "TIMEOUT", "TIMEOUT_LOSS"))
        self.assertTrue(result.get("is_circle_battle"))

    def test_stage100_battle_runs(self):
        """阶段100: boss Lv200 完整战斗无异常"""
        result, bf = self._run_stage(100)
        self.assertIn(result.get("result"),
                      ("FINISHED", "TIMEOUT", "TIMEOUT_LOSS"))
        self.assertTrue(result.get("is_circle_battle"))


if __name__ == "__main__":
    unittest.main()
