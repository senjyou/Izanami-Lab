# 6. フロニュート 220457 スラッジバレット：最速敌 EN攻撃+spd_down固定30
# =============================================================================
class TestS7SludgeBullet220457(unittest.TestCase):
    """220457: 最速敌 威力60 EN攻撃 + spd_down 30(固定値, 重複可, 永続)"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def test_config(self):
        """配置: damage(EN, 威力) + spd_down flat 30 永続"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        effs = hy["220457"]["effect_blocks"][0]["effects"]
        self.assertEqual(effs[0]["effect_type"], "damage")
        self.assertTrue(effs[0]["flags"]["is_en_attack"])
        self.assertEqual(effs[0]["value_tag"], "威力")
        self.assertEqual(effs[0]["target_type"], "enemy_single_highest_spd")
        spd = effs[1]
        self.assertEqual(spd["effect_type"], "spd_down")
        self.assertEqual(spd["value"], 30)
        self.assertEqual(spd["flags"]["value_type"], "flat")
        self.assertTrue(spd["flags"]["stackable"])
        self.assertEqual(spd["duration"], -1)
        # skills.json 威力=60 固定
        sk = json.load(open(ROOT / "data" / "skills.json", encoding="utf-8"))
        self.assertEqual(sk["220457"]["template_tags"]["威力"]["values"][0]["value"], 60.0)

    def test_runtime_damage_and_spd_down(self):
        """运行时: 最速敌受伤+spd固定值降低"""
        caster = _make_unit("fro", "フロニュート", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[220457], skill_levels={220457: 1})
        fast = _make_unit("al_fast", "最速", Side.ALLY,
                          Position.ALLY_CENTER_FRONT, hp=100000, speed=900)
        slow = _make_unit("al_slow", "低速", Side.ALLY,
                          Position.ALLY_LEFT_FRONT, hp=100000, speed=300)
        bf = _make_bf(caster, fast, slow)
        ss, *_ = _make_services(bf, self.dl)
        hp_before = fast.current_hp
        result = ss.execute_skill(caster=caster, skill_id=220457,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertLess(fast.current_hp, hp_before, "最速敌应受伤")
        debuff = _find_aura(fast, STATUS_SPEED, debuff=True)
        self.assertIsNotNone(debuff, "最速敌应获得spd_down")
        self.assertAlmostEqual(debuff.value, 30.0, places=4, msg="spd_down应为固定值30")
        self.assertIsNone(_find_aura(slow, STATUS_SPEED, debuff=True))


# =============================================================================
# 7. フロニュート 230490 スティッキーロック：enemy_has_evade_buff + sure_hit
# =============================================================================
class TestS7StickyLock230490(unittest.TestCase):
    """230490: before_ally_as_attack + 敌持回避buff时给攻击者sure_hit"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self, ally_has_evade=True):
        caster = _make_unit("fro", "フロニュート", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[230490], skill_levels={230490: 1}, pp=10)
        attacker = _make_unit("ea", "敵友攻擊者", Side.ENEMY,
                              Position.ENEMY_LEFT_FRONT,
                              hp=100000, atk=5000, speed=700,
                              skills=[220001], skill_levels={220001: 1})
        target = _make_unit("al", "我方", Side.ALLY,
                            Position.ALLY_CENTER_FRONT, hp=100000)
        if ally_has_evade:
            target.buffs.append(BuffState(
                buff_id="ev1", name="回避", effect_type=EVADE,
                value=100, duration=-1,
                timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
                hit_limited=1, is_debuff=False,
            ))
        bf = _make_bf(caster, attacker, target)
        ss, ts, *_ = _make_services(bf, self.dl)
        return caster, attacker, target, bf, ss, ts

    def test_config(self):
        """配置: before_ally_as_attack + enemy_has_evade_buff + sure_hit(attacker_action)"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        s = hy["230490"]
        self.assertEqual(s["trigger_type"], "before_ally_as_attack")
        self.assertTrue(s.get("simultaneous_limit"))
        self.assertEqual(s["global_condition"], {"type": "enemy_has_evade_buff"})
        eff = s["effect_blocks"][0]["effects"][0]
        self.assertEqual(eff["effect_type"], "sure_hit")
        self.assertEqual(eff["target_identifier"], "trigger_attacker")
        self.assertEqual(eff["duration_type"], "attacker_action")

    def test_triggers_when_enemy_has_evade(self):
        """敌方（caster视角的敌=我方）持有回避buff → 触发"""
        caster, attacker, target, bf, ss, ts = self._setup(ally_has_evade=True)
        actions = ts.trigger_before_ally_as_attack(attacker, 220001, bf)
        ps = [a for a in actions if a.skill_id == 230490]
        self.assertGreater(len(ps), 0, "目标持回避buff应触发スティッキーロック")
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf, trigger_timing="before_ally_as_attack")
        self.assertIsNotNone(_find_aura(attacker, SURE_HIT),
                             "攻击者应获得sure_hit（必中）")

    def test_no_trigger_without_evade(self):
        """无回避buff → 不触发"""
        caster, attacker, target, bf, ss, ts = self._setup(ally_has_evade=False)
        actions = ts.trigger_before_ally_as_attack(attacker, 220001, bf)
        ps = [a for a in actions if a.skill_id == 230490]
        self.assertEqual(len(ps), 0, "无回避buff不应触发")

    def test_evade_without_hit_limited_ignored(self):
        """回避buff无hit_limited次数限制（hit_limited=0）→ 不算持有效回避"""
        caster = _make_unit("fro", "フロニュート", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[230490], skill_levels={230490: 1}, pp=10)
        attacker = _make_unit("ea", "敵友", Side.ENEMY,
                              Position.ENEMY_LEFT_FRONT,
                              hp=100000, atk=5000, speed=700,
                              skills=[220001], skill_levels={220001: 1})
        target = _make_unit("al", "我方", Side.ALLY,
                            Position.ALLY_CENTER_FRONT, hp=100000)
        target.buffs.append(BuffState(
            buff_id="ev0", name="回避0次", effect_type=EVADE,
            value=100, duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_WHEN_USED.value,
            hit_limited=0, is_debuff=False,
        ))
        bf = _make_bf(caster, attacker, target)
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        ss = SkillService(self.dl, ResourceService(), target_service=TargetService(),
                          damage_service=DamageService(), aura_service=AuraService(),
                          trigger_service=ts, status_service=StatusService())
        ts.set_skill_service(ss)
        ts.set_damage_service(DamageService())
        ss.set_battlefield(bf)
        actions = ts.trigger_before_ally_as_attack(attacker, 220001, bf)
        ps = [a for a in actions if a.skill_id == 230490]
        self.assertEqual(len(ps), 0, "hit_limited=0的回避buff不应视为有效回避")


# =============================================================================
# 8. フロニュート 230491 シャドウグー：on_cumulative_damage 暗闇+PP回復
# =============================================================================
class TestS7ShadowGo230491(unittest.TestCase):
    """230491: 味方累计受伤>=25% → 随机敌暗闇75% 1行动; 敌HP>=50%时PP+1"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self):
        caster = _make_unit("fro", "フロニュート", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[230491], skill_levels={230491: 1}, pp=3)
        damaged = _make_unit("ea", "受击敵友", Side.ENEMY,
                             Position.ENEMY_LEFT_FRONT,
                             hp=10000, atk=5000, speed=700)
        target = _make_unit("al", "我方高血", Side.ALLY,
                            Position.ALLY_CENTER_FRONT, hp=10000)
        bf = _make_bf(caster, damaged, target)
        ss, ts, *_ = _make_services(bf, self.dl)
        return caster, damaged, target, bf, ss, ts

    def test_config(self):
        """配置: on_cumulative_damage + ally_cumulative_damage_percent>=25 +
        darkness75(1action) + status_target_hp_above50→modify_pp 1"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        s = hy["230491"]
        self.assertEqual(s["trigger_type"], "on_cumulative_damage")
        self.assertEqual(s["global_condition"]["type"], "ally_cumulative_damage_percent")
        self.assertEqual(s["global_condition"]["value"], 25)
        dark = s["effect_blocks"][0]["effects"][0]
        self.assertEqual(dark["effect_type"], "add_status")
        self.assertEqual(dark["flags"]["status_type"], "darkness")
        self.assertEqual(dark["value"], 75)
        self.assertEqual(dark["duration"], 1)
        self.assertEqual(dark["target_type"], "enemy_random")
        block2 = s["effect_blocks"][1]
        self.assertEqual(block2["condition"]["type"], "status_target_hp_above")
        self.assertEqual(block2["condition"]["value"], 50)
        pp = block2["effects"][0]
        self.assertEqual(pp["effect_type"], "modify_pp")
        self.assertEqual(pp["value"], 1)

    def test_cumulative_damage_triggers_darkness_and_pp(self):
        """运行时: 友方累计受伤>=25% → 暗闇+PP净+1（PS耗1、回復1、目标HP>=50%）
        用两个场景对比：目标HP>=50%时PP应比HP<50%时高1"""
        caster, damaged, target, bf, ss, ts = self._setup()
        damaged.cumulative_hp_damage = 2500  # 25% of 10000
        actions = ts.trigger_cumulative_damage(bf, damaged_units=[damaged])
        ps = [a for a in actions if a.skill_id == 230491]
        self.assertGreater(len(ps), 0, "累计受伤25%应触发シャドウグー")
        pp_before = caster.current_pp
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf, trigger_timing="on_cumulative_damage")
        # 暗闇在随机敌方（唯一目标=target）
        darkness = _find_aura(target, DARKNESS)
        self.assertIsNotNone(darkness, "唯一敌方应获得暗闇")
        self.assertAlmostEqual(darkness.value, 75.0, places=4)
        # 目标HP>=50% → PP+1（PS耗1、回復1 → 净0）
        self.assertEqual(caster.current_pp, pp_before,
                         "目标HP>=50%时PP应净变化0（PS耗1+回復1）")

    def test_no_pp_when_status_target_below_50pct(self):
        """暗闇目标HP<50% → 不回PP（PS耗1 → 净-1）"""
        caster, damaged, target, bf, ss, ts = self._setup()
        target.current_hp = 4000  # 40%
        damaged.cumulative_hp_damage = 2500
        actions = ts.trigger_cumulative_damage(bf, damaged_units=[damaged])
        ps = [a for a in actions if a.skill_id == 230491]
        self.assertGreater(len(ps), 0)
        pp_before = caster.current_pp
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf, trigger_timing="on_cumulative_damage")
        self.assertEqual(caster.current_pp, pp_before - 1,
                         "暗闇目标HP<50%时PP应净-1（仅PS耗1）")

    def test_below_threshold_no_trigger(self):
        """累计受伤<25% → 不触发"""
        caster, damaged, target, bf, ss, ts = self._setup()
        damaged.cumulative_hp_damage = 2400  # 24% < 25%
        actions = ts.trigger_cumulative_damage(bf, damaged_units=[damaged])
        ps = [a for a in actions if a.skill_id == 230491]
        self.assertEqual(len(ps), 0, "累计受伤<25%不应触发")


# =============================================================================
# 9. シェラッグ 220458 シェルクレア：最低HP味方 debuff全解除+5种stat+7.5%+シェルmark
# =============================================================================
class TestS7ShellClarify220458(unittest.TestCase):
    """220458: 最低HP味方 → remove_all_debuffs + 5种stat up 7.5% + シェルmark"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self):
        caster = _make_unit("shera", "シェラッグ", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[220458], skill_levels={220458: 1})
        low = _make_unit("ea_low", "最低HP敵友", Side.ENEMY,
                         Position.ENEMY_LEFT_FRONT,
                         hp=10000, atk=8000)
        low.current_hp = 3000
        full = _make_unit("ea_full", "满血敵友", Side.ENEMY,
                          Position.ENEMY_RIGHT_FRONT, hp=10000, atk=8000)
        foe = _make_unit("al", "我方", Side.ALLY,
                         Position.ALLY_CENTER_FRONT, hp=100000)
        bf = _make_bf(caster, low, full, foe)
        ss, *_ = _make_services(bf, self.dl)
        # low 挂2个可解除的debuff
        for i in range(2):
            low.debuffs.append(BuffState(
                buff_id=f"db_{i}", name=f"debuff{i}", effect_type=RECEIVED_DAMAGE,
                value=10.0, duration=3,
                timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
                source_unit_id="al", source_skill_id=0, is_debuff=True,
            ))
        return caster, low, full, bf, ss

    def test_config(self):
        """配置: remove_all_debuffs + 5种stat 7.5% + markシェル"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        s = hy["220458"]
        rm = s["effect_blocks"][0]["effects"][0]
        self.assertEqual(rm["effect_type"], "remove_all_debuffs")
        self.assertEqual(rm["target_type"], "ally_single_lowest_hp")
        effs = s["effect_blocks"][1]["effects"]
        stat_types = [e["effect_type"] for e in effs if e["effect_type"] != "mark"]
        self.assertEqual(stat_types,
                         ["max_hp_up", "atk_up", "def_up", "spd_up", "crit_rate_up"])
        for e in effs:
            if e["effect_type"] == "mark":
                self.assertEqual(e["flags"]["mark_name"], "シェル")
                self.assertTrue(e["flags"]["is_buff_mark"])
            else:
                self.assertEqual(e["value"], 7.5)
                self.assertTrue(e["flags"]["stackable"])

    def test_runtime_clears_debuffs_and_applies_shell(self):
        """运行时: 最低HP味方debuff全解除+获得4种stat buff+シェルmark
        max_hp_up 特殊处理为直接修改 max_hp（不添加buff）→ 检查 max_hp 增加"""
        caster, low, full, bf, ss = self._setup()
        max_hp_before = low.max_hp
        result = ss.execute_skill(caster=caster, skill_id=220458,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertEqual(len(low.debuffs), 0, "最低HP味方debuff应全解除")
        self.assertIsNotNone(_find_aura(low, MARK, name="シェル"), "应获得シェルmark")
        # max_hp_up: +7.5% 直接修改 max_hp（10000 → 10750）
        self.assertEqual(low.max_hp, int(max_hp_before * 1.075),
                         "max_hp_up应+7.5%直接提升max_hp")
        # 其余4种stat buff（atk/def/spd/crit_rate）
        for et in (STATUS_ATTACK, STATUS_DEFENSE, STATUS_SPEED,
                   SkillEffectType.STATUS_CRITICAL_CHANCE.value):
            self.assertIsNotNone(_find_aura(low, et), f"应获得 {et}")
        self.assertIsNone(_find_aura(full, MARK, name="シェル"),
                          "满血味方不应获得シェル")


