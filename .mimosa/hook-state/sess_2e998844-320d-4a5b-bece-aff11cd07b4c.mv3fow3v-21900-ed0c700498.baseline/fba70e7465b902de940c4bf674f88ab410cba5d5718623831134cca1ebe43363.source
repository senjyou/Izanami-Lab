# 5. フロニュート 220456 グーイダウン：最快敌 atk/def -12.5%（重複可）caster duration
# =============================================================================
class TestS7GuyDown220456(unittest.TestCase):
    """220456: 最速敌 atk/def -12.5%×2, duration_owner=caster + source_death_remove"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self):
        caster = _make_unit("fro", "フロニュート", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[220456], skill_levels={220456: 1})
        # 最速敌（spd最高）
        fast = _make_unit("al_fast", "最速", Side.ALLY,
                          Position.ALLY_CENTER_FRONT, hp=100000, speed=900)
        slow = _make_unit("al_slow", "低速", Side.ALLY,
                          Position.ALLY_LEFT_FRONT, hp=100000, speed=300)
        bf = _make_bf(caster, fast, slow)
        ss, *_ = _make_services(bf, self.dl)
        return caster, fast, slow, bf, ss

    def test_config(self):
        """配置: atk_down/def_down 12.5% enemy_single_highest_spd,
        duration_owner=caster + source_death_remove"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        for eff in hy["220456"]["effect_blocks"][0]["effects"]:
            self.assertIn(eff["effect_type"], ("atk_down", "def_down"))
            self.assertEqual(eff["value"], 12.5)
            self.assertEqual(eff["target_type"], "enemy_single_highest_spd")
            self.assertEqual(eff["flags"]["duration_owner"], "caster")
            self.assertTrue(eff["flags"]["source_death_remove"])
            self.assertTrue(eff["flags"]["stackable"])
            self.assertEqual(eff["duration"], 1)

    def test_runtime_hits_fastest_with_both_debuffs(self):
        """运行时: 最速敌获得 atk_down+def_down 各一个"""
        caster, fast, slow, bf, ss = self._setup()
        result = ss.execute_skill(caster=caster, skill_id=220456,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        self.assertIsNotNone(_find_aura(fast, STATUS_ATTACK, debuff=True),
                             "最速敌应获得atk_down")
        self.assertIsNotNone(_find_aura(fast, STATUS_DEFENSE, debuff=True),
                             "最速敌应获得def_down")
        self.assertIsNone(_find_aura(slow, STATUS_ATTACK, debuff=True),
                          "非最速敌不应中招")


