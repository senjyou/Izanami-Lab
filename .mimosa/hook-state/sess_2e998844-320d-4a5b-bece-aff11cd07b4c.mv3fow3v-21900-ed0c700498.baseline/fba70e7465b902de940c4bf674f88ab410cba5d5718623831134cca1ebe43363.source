#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
第七赛季对抗压制战 (Circle Battle S7) — 敌方技能效果配置依序检查测试

对 S7 敌方 5 名单位（スウォング/フロニュート/シェラッグ/サーヴェント/ヴィーヴル）
的 17 个 S7 技能的效果点（effect block 内每个 effect / 关键条件 / flags）建立
依序测试，通过真实 SkillService.execute_skill + 真实 TriggerService 触发链路
验证配置是否真正按预期生效。覆盖维度：

1. 配置级检查：17个技能在 skill_effects_hybrid.json / skills.json 均有完整配置，
   season_7 100个阶段全部引用合法技能
2. 数据级+运行时依序检查：每个技能按 effect block 顺序逐点验证
   （伤害/附魔/治疗/增益/减益/mark/状态/资源/驱散 等效果类型全覆盖）
3. 新机制专项：caster_hp_ratio_inverse（付与時冻结）、EN優先索敵、
   縦列索敵、enemy_has_evade_buff 触发条件、once_per_battle、
   simultaneous_limit、block 间引用条件（prev_target_element_advantage /
   heal_target_hp_below / status_target_hp_above）
4. 边界场景：条件分支边界（存活数1-4、HP阈值两侧）、持续效果联动解除、
   duration_owner=caster、source_death_remove
5. 数据完整性：敌方配置的 skill_ids 全部存在于 hybrid + skills；
   サーヴェント分级 enemy_id 机制（170121651-170121663）
"""

import os
import sys
import unittest
import json
import random
from pathlib import Path
from unittest.mock import MagicMock

ROOT = Path(__file__).resolve().parent.parent.parent
sys.path.insert(0, str(ROOT))
os.chdir(ROOT)

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, AuraUpdateTiming,
    TriggerTiming,
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

S7_SKILL_IDS = [
    210133, 220461, 220462, 220463, 230493,      # サーヴェント
    220455, 230487, 230488, 230489,              # スウォング
    220458, 220459, 220460, 230492,              # シェラッグ
    220456, 220457, 230490, 230491,              # フロニュート
]

# 敌方单位 → 技能对应表（circle_battle_enemies.json season_7）
S7_ENEMY_SKILLS = {
    167120351: {"name": "スウォング", "skills": [220455, 230487, 230488, 230489]},
    168120351: {"name": "フロニュート", "skills": [220456, 220457, 230490, 230491]},
    169120351: {"name": "シェラッグ", "skills": [220458, 220459, 220460, 230492]},
    170121651: {"name": "サーヴェント", "skills": [220461, 220462, 220463, 230493]},
    170121652: {"name": "サーヴェント(EX)", "skills": [210133, 220461, 220462, 220463, 230493]},
}

MARK = SkillEffectType.MARK.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
STATUS_ATTACK = SkillEffectType.STATUS_ATTACK.value
STATUS_DEFENSE = SkillEffectType.STATUS_DEFENSE.value
STATUS_SPEED = SkillEffectType.STATUS_SPEED.value
ACTION_DAMAGE = SkillEffectType.ACTION_DAMAGE.value
SURE_HIT = SkillEffectType.SURE_HIT.value
EVADE = SkillEffectType.EVADE.value
STEALTH = SkillEffectType.STEALTH.value
GENWAKU = SkillEffectType.GENWAKU.value
DARKNESS = SkillEffectType.DARKNESS.value


# =============================================================================
# 辅助函数
# =============================================================================

def _make_unit(unit_id, name, side, position, *, hp=10000, atk=1000, defense=500,
               speed=500, crit_rate=0.0, crit_damage=0.5,
               element=Attribute.FIRE.value, character_type=1, level=10,
               ap=10, pp=10, ep=0, max_ep=10,
               skills=None, skill_levels=None):
    """构造 UnitState"""
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=level, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=ap, initial_passive_point=pp, max_extra_point=max_ep,
        current_ap=ap, current_pp=pp, current_ep=ep,
        is_alive=True,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    """构造 BattlefieldState"""
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


def _find_aura(unit, effect_type, name=None, debuff=False):
    """在 buffs/debuffs 中查找指定 effect_type 的 aura"""
    if debuff:
        pools = [unit.debuffs]
    else:
        pools = [unit.buffs, unit.debuffs]
    for pool in pools:
        for b in pool:
            if b.effect_type != effect_type:
                continue
            if name is not None and getattr(b, 'name', '') != name:
                continue
            return b
    return None


def _count_auras(unit, effect_type, name=None):
    n = 0
    for b in list(unit.buffs) + list(unit.debuffs):
        if b.effect_type != effect_type:
            continue
        if name is not None and getattr(b, 'name', '') != name:
            continue
        n += 1
    return n


def _find_mark(unit, mark_name):
    return _find_aura(unit, MARK, name=mark_name)


def _count_marks(unit, mark_name):
    return _count_auras(unit, MARK, name=mark_name)


def _make_services(bf, dl):
    """为指定战场构造全套真实服务"""
    rs = ResourceService()
    ts = TriggerService()
    ts.set_data_loader(dl)
    aus = AuraService()
    dms = DamageService()
    tgs = TargetService()
    sts = StatusService()
    ss = SkillService(
        dl, rs,
        target_service=tgs, damage_service=dms,
        aura_service=aus, trigger_service=ts, status_service=sts,
    )
    ts.set_skill_service(ss)
    ts.set_damage_service(dms)
    ss.set_battlefield(bf)
    return ss, ts, dms, aus, tgs, sts


# =============================================================================
# 0. 配置完整性：17个技能的配置数据级依序校验
# =============================================================================
class TestS7ConfigIntegrity(unittest.TestCase):
    """S7 技能配置完整性：hybrid + skills + season_7 三方一致性"""

    @classmethod
    def setUpClass(cls):
        with (ROOT / "data" / "skill_effects_hybrid.json").open("r", encoding="utf-8") as f:
            cls.hy = json.load(f)
        with (ROOT / "data" / "skills.json").open("r", encoding="utf-8") as f:
            cls.sk = json.load(f)
        with (ROOT / "data" / "circle_battle_enemies.json").open("r", encoding="utf-8") as f:
            cls.cb = json.load(f)

    def test_all_17_skills_in_hybrid_and_skills(self):
        """17个S7技能在 hybrid 与 skills 均有配置"""
        for sid in S7_SKILL_IDS:
            self.assertIn(str(sid), self.hy, f"skill {sid} missing in hybrid")
            self.assertIn(str(sid), self.sk, f"skill {sid} missing in skills.json")

    def test_hybrid_skill_id_matches_key(self):
        """hybrid 内 skill_id 字段与键一致"""
        for sid in S7_SKILL_IDS:
            self.assertEqual(self.hy[str(sid)]["skill_id"], sid)

    def test_season_7_stage_count(self):
        """season_7 有100个阶段"""
        self.assertIn("season_7", self.cb)
        self.assertEqual(len(self.cb["season_7"]), 100)

    def test_stage_enemy_skill_ids_all_exist(self):
        """season_7 每个阶段每个敌人的 skill_ids 都存在于 skills.json"""
        for stg, sd in self.cb["season_7"].items():
            for e in sd["enemies"]:
                for sid in e["skill_ids"]:
                    self.assertIn(str(sid), self.sk,
                                  f"stage {stg} enemy {e['enemy_id']} skill {sid} missing")

    def test_enemy_skill_levels_consistent(self):
        """skill_levels 与 skill_ids 一致（无多余/遗漏）"""
        for stg, sd in self.cb["season_7"].items():
            for e in sd["enemies"]:
                self.assertEqual(sorted(e["skill_levels"].keys()),
                                 sorted(str(s) for s in e["skill_ids"]),
                                 f"stage {stg} enemy {e['enemy_id']} skill_levels mismatch")

    def test_servant_enemy_id_tiers(self):
        """サーヴェント分级 enemy_id 机制：低阶段 170121651（无EX），高阶段带 210133"""
        s7 = self.cb["season_7"]
        # 阶段1: 170121651 (4技能, 无EX)
        ids_s1 = {e["enemy_id"] for e in s7["1"]["enemies"]}
        self.assertIn(170121651, ids_s1)
        # 阶段100: 170121663 (5技能, 含EX 210133), boss Lv200
        ids_s100 = {e["enemy_id"] for e in s7["100"]["enemies"]}
        self.assertIn(170121663, ids_s100)
        boss = next(e for e in s7["100"]["enemies"] if e["enemy_id"] == 170121663)
        self.assertEqual(boss["level"], 200)
        self.assertIn(210133, boss["skill_ids"])

    def test_stage1_5_enemies(self):
        """阶段1: 5个敌人（slot2空）"""
        enemies = self.cb["season_7"]["1"]["enemies"]
        self.assertEqual(len(enemies), 5)
        slots = sorted(e["slot"] for e in enemies)
        self.assertEqual(slots, [1, 3, 4, 5, 6])

    def test_s7_hybrid_names_match_skills(self):
        """hybrid 与 skills 的技能名一致（防止配置错位）"""
        for sid in S7_SKILL_IDS:
            self.assertEqual(self.hy[str(sid)]["name"], self.sk[str(sid)]["name"],
                             f"skill {sid} name mismatch between hybrid/skills")

    def test_skill_levels_used_in_stages_exist_in_tags(self):
        """各阶段用到的技能等级的tag值有效（1-10）"""
        for stg, sd in self.cb["season_7"].items():
            for e in sd["enemies"]:
                for sid, lv in e["skill_levels"].items():
                    self.assertTrue(1 <= lv <= 10,
                                    f"stage {stg} skill {sid} level {lv} out of range")


# =============================================================================
# 1. スウォング 220455 スウォームファング：按生存味方数选择威力1-4，各3hit
# =============================================================================
class TestS7SwongFang220455(unittest.TestCase):
    """220455: 4个block按 ally_alive_count 选威力（>=4/==3/==2/<=1），3hit"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_battle(self, alive_ally_count=4):
        """swong caster + alive_ally_count 个敌友军 + 我方3人"""
        caster = _make_unit("swong", "スウォング", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, defense=4000, speed=800)
        allies = []
        pos_pool = [Position.ENEMY_LEFT_FRONT, Position.ENEMY_RIGHT_FRONT,
                    Position.ENEMY_LEFT_BACK, Position.ENEMY_RIGHT_BACK,
                    Position.ENEMY_CENTER_BACK]
        for i in range(alive_ally_count):
            allies.append(_make_unit(f"ea_{i}", f"敵友{i}", Side.ENEMY,
                                     pos_pool[i % len(pos_pool)], hp=100000))
        targets = []
        tpos = [Position.ALLY_LEFT_FRONT, Position.ALLY_CENTER_FRONT,
                Position.ALLY_RIGHT_FRONT]
        for i in range(3):
            targets.append(_make_unit(f"al_{i}", f"我方{i}", Side.ALLY,
                                      tpos[i], hp=100000))
        # 多余盟友设为死亡
        all_ally_units = []
        for i in range(5):
            u = _make_unit(f"ea_{i}", f"敵友{i}", Side.ENEMY,
                           pos_pool[i % len(pos_pool)], hp=100000)
            if i >= alive_ally_count:
                u.is_alive = False
            all_ally_units.append(u)
        bf = _make_bf(caster, *all_ally_units, *targets)
        return caster, bf, targets

    def test_4_allies_alive_uses_power1(self):
        """存活味方4体 → 威力1(25)"""
        caster, bf, targets = self._make_battle(alive_ally_count=4)
        caster.skill_levels[220455] = 1
        ss, *_ = _make_services(bf, self.dl)
        hp_before = {u.unit_id: u.current_hp for u in targets}
        result = ss.execute_skill(caster=caster, skill_id=220455,
                                  battlefield=bf, skip_cost=True)
        self.assertTrue(result["success"])
        # 主目标受伤
        hurt = [u for u in targets if u.current_hp < hp_before[u.unit_id]]
        self.assertGreater(len(hurt), 0, "至少1个目标应受到伤害")

    def test_ally_count_branches_all_run(self):
        """威力1-4各分支均可执行（3hit 伤害型）"""
        for n in (4, 3, 2, 1):
            caster, bf, targets = self._make_battle(alive_ally_count=n)
            ss, *_ = _make_services(bf, self.dl)
            hp_before = {u.unit_id: u.current_hp for u in targets}
            result = ss.execute_skill(caster=caster, skill_id=220455,
                                      battlefield=bf, skip_cost=True)
            self.assertTrue(result["success"], f"alive_ally_count={n} 应执行成功")
            hurt = [u for u in targets if u.current_hp < hp_before[u.unit_id]]
            self.assertGreater(len(hurt), 0, f"alive_ally_count={n} 应有伤害")

    def test_hybrid_block_structure(self):
        """配置: 4 blocks 依序条件 >=4 / ==3 / ==2 / <=1, 各3hit 威力1-4"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        blocks = hy["220455"]["effect_blocks"]
        self.assertEqual(len(blocks), 4)
        expect = [(">=", 4, "威力1"), ("==", 3, "威力2"),
                  ("==", 2, "威力3"), ("<=", 1, "威力4")]
        for block, (op, val, tag) in zip(blocks, expect):
            cond = block["condition"]
            self.assertEqual(cond["type"], "ally_alive_count")
            self.assertEqual(cond["operator"], op)
            self.assertEqual(cond["value"], val)
            eff = block["effects"][0]
            self.assertEqual(eff["effect_type"], "damage")
            self.assertEqual(eff["value_tag"], tag)
            self.assertEqual(eff["hit_count"], 3)
        # skills.json tag值: 25/27.5/32.5/37.5
        sk = json.load(open(ROOT / "data" / "skills.json", encoding="utf-8"))
        tags = sk["220455"]["template_tags"]
        self.assertEqual(tags["威力1"]["values"][0]["value"], 25.0)
        self.assertEqual(tags["威力2"]["values"][0]["value"], 27.5)
        self.assertEqual(tags["威力3"]["values"][0]["value"], 32.5)
        self.assertEqual(tags["威力4"]["values"][0]["value"], 37.5)


# =============================================================================
# 2. スウォング 230487 カウンターバイト：after_self_attacked 反撃
# =============================================================================
class TestS7CounterBite230487(unittest.TestCase):
    """230487: 自身被任意攻击后 trigger_attacker 反撃（威力85物理）"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self):
        caster = _make_unit("swong", "スウォング", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, defense=4000, speed=800,
                            skills=[230487], skill_levels={230487: 1},
                            pp=10)
        attacker = _make_unit("atk", "攻击者", Side.ALLY,
                              Position.ALLY_CENTER_FRONT,
                              hp=50000, atk=8000, defense=3000)
        bf = _make_bf(caster, attacker)
        ss, ts, *_ = _make_services(bf, self.dl)
        return caster, attacker, bf, ss, ts

    def test_config_after_self_attacked(self):
        """配置: trigger_type=after_self_attacked + trigger_attacker damage"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        s = hy["230487"]
        self.assertEqual(s["trigger_type"], "after_self_attacked")
        eff = s["effect_blocks"][0]["effects"][0]
        self.assertEqual(eff["effect_type"], "damage")
        self.assertEqual(eff["target_identifier"], "trigger_attacker")
        self.assertNotIn("is_en_attack", eff["flags"], "应为物理反撃")
        # skills.json 威力 tag 固定85
        sk = json.load(open(ROOT / "data" / "skills.json", encoding="utf-8"))
        self.assertEqual(sk["230487"]["template_tags"]["威力"]["values"][0]["value"], 85.0)

    def test_counter_deals_damage_to_attacker(self):
        """运行时: 被攻击后触发反撃 → 攻击者受伤"""
        caster, attacker, bf, ss, ts = self._setup()
        actions = ts.trigger_after_self_attacked(
            targets=[caster], battlefield=bf,
            actor=attacker, primary_target=caster,
            triggered_by=attacker,
        )
        ps = [a for a in actions if a.skill_id == 230487]
        self.assertGreater(len(ps), 0, "被攻击后应触发カウンターバイト")
        hp_before = attacker.current_hp
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf, trigger_timing="after_self_attacked")
        self.assertLess(attacker.current_hp, hp_before, "攻击者应受到反撃伤害")

    def test_no_trigger_when_not_attacked(self):
        """无攻击时不应触发"""
        caster, attacker, bf, ss, ts = self._setup()
        actions = ts.trigger_after_self_attacked(
            targets=[attacker], battlefield=bf,
            actor=attacker, primary_target=attacker,
            triggered_by=attacker,
        )
        ps = [a for a in actions if a.skill_id == 230487]
        self.assertEqual(len(ps), 0, "未持有者被攻击不应触发")


# =============================================================================
# 3. スウォング 230488 デスレイジハイ：on_ally_killed 雌伏解除+全体攻防up
# =============================================================================
class TestS7DeathRageHigh230488(unittest.TestCase):
    """230488: 味方被击倒时 雌伏-1 + 味方全体 atk/def +3.5%（重複可）"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self, shifuku_layers=4):
        caster = _make_unit("swong", "スウォング", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[230488], skill_levels={230488: 1}, pp=10)
        ally = _make_unit("ea", "敵友", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
                          hp=100000, atk=8000, defense=3000)
        enemy_foe = _make_unit("foe", "我方", Side.ALLY,
                               Position.ALLY_CENTER_FRONT, hp=100000)
        bf = _make_bf(caster, ally, enemy_foe)
        ss, ts, *_ = _make_services(bf, self.dl)
        # 预置雌伏 mark × N
        for i in range(shifuku_layers):
            caster.buffs.append(BuffState(
                buff_id=f"mark_{i}", name="雌伏", effect_type=MARK,
                value=0, duration=-1,
                timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
                stack_count=1, is_debuff=False,
            ))
        return caster, ally, enemy_foe, bf, ss, ts

    def test_config(self):
        """配置: on_ally_killed + remove_mark(雌伏,1) + atk/def_up 3.5% stackable"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        s = hy["230488"]
        self.assertEqual(s["trigger_type"], "on_ally_killed")
        rm = s["effect_blocks"][0]["effects"][0]
        self.assertEqual(rm["effect_type"], "remove_mark")
        self.assertEqual(rm["value"], 1)
        self.assertEqual(rm["flags"]["mark_name"], "雌伏")
        buffs = s["effect_blocks"][1]["effects"]
        self.assertEqual({b["effect_type"] for b in buffs}, {"atk_up", "def_up"})
        for b in buffs:
            self.assertEqual(b["value"], 3.5)
            self.assertTrue(b["flags"]["stackable"])
            self.assertEqual(b["target_type"], "ally_all")

    def test_ally_killed_triggers_and_removes_mark(self):
        """运行时: 友方死亡 → 雌伏4→3 + 全体攻防+3.5%"""
        caster, ally, foe, bf, ss, ts = self._setup(shifuku_layers=4)
        ally.is_alive = False
        actions = ts.trigger_pawn_died([ally], bf)
        ps = [a for a in actions if a.skill_id == 230488]
        self.assertGreater(len(ps), 0, "友方死亡应触发デスレイジハイ")
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf, trigger_timing="on_ally_killed")
        self.assertEqual(_count_marks(caster, "雌伏"), 3, "雌伏应4→3")
        # atk_up/def_up buff 给 caster 和（假想的）友方全体 —— caster身上应有
        self.assertIsNotNone(_find_aura(caster, STATUS_ATTACK), "应获得atk_up")
        self.assertIsNotNone(_find_aura(caster, STATUS_DEFENSE), "应获得def_up")

    def test_no_trigger_on_own_death(self):
        """自身死亡时不触发（owner is not the dead one）"""
        caster, ally, foe, bf, ss, ts = self._setup()
        actions = ts.trigger_pawn_died([caster], bf)
        ps = [a for a in actions if a.skill_id == 230488]
        self.assertEqual(len(ps), 0, "自身死亡不应触发")

    def test_no_trigger_when_enemy_dies(self):
        """敌方（对立阵营）死亡时不触发"""
        caster, ally, foe, bf, ss, ts = self._setup()
        foe.is_alive = False
        actions = ts.trigger_pawn_died([foe], bf)
        ps = [a for a in actions if a.skill_id == 230488]
        self.assertEqual(len(ps), 0, "对立阵营死亡不应触发")


# =============================================================================
# 4. スウォング 230489 ダイブスリープ：once_per_battle ステルス+雌伏4+spd_down×4
# =============================================================================
class TestS7DiveSleep230489(unittest.TestCase):
    """230489: 战斗中1次 on_turn_start → 永久ステルス + 雌伏4层 + spd_down×4 (linked)"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup(self):
        caster = _make_unit("swong", "スウォング", Side.ENEMY,
                            Position.ENEMY_CENTER_FRONT,
                            hp=100000, atk=5000, speed=800,
                            skills=[230489], skill_levels={230489: 1}, pp=10)
        foe = _make_unit("foe", "我方", Side.ALLY,
                         Position.ALLY_CENTER_FRONT, hp=100000)
        bf = _make_bf(caster, foe)
        ss, ts, *_ = _make_services(bf, self.dl)
        return caster, foe, bf, ss, ts

    def test_config(self):
        """配置: once_per_battle + stealth(-1) + mark雌伏4 + spd_down12.5%×4 linked"""
        hy = json.load(open(ROOT / "data" / "skill_effects_hybrid.json",
                            encoding="utf-8"))
        s = hy["230489"]
        self.assertTrue(s.get("once_per_battle"))
        self.assertEqual(s["trigger_type"], "on_turn_start")
        effects = s["effect_blocks"][0]["effects"]
        stealth = effects[0]
        self.assertEqual(stealth["effect_type"], "stealth")
        self.assertEqual(stealth["duration"], -1)
        mark = effects[1]
        self.assertEqual(mark["effect_type"], "mark")
        self.assertEqual(mark["value"], 4)
        self.assertTrue(mark["flags"]["stackable"])
        self.assertTrue(mark["flags"]["unremovable"])
        self.assertEqual(mark["flags"]["mark_name"], "雌伏")
        spd_downs = [e for e in effects[2:] if e["effect_type"] == "spd_down"]
        self.assertEqual(len(spd_downs), 4)
        for e in spd_downs:
            self.assertEqual(e["value"], 12.5)
            self.assertEqual(e["flags"]["linked_mark"], "雌伏")
            self.assertTrue(e["flags"]["unremovable"])

    def test_runtime_applies_stealth_marks_and_spd_down(self):
        """运行时: on_turn_start 触发 → ステルス+雌伏4+spd_down×4"""
        caster, foe, bf, ss, ts = self._setup()
        actions = ts.trigger_turn_start(bf)
        ps = [a for a in actions if a.skill_id == 230489]
        self.assertGreater(len(ps), 0, "回合开始应触发ダイブスリープ")
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf, trigger_timing="on_turn_start")
        self.assertIsNotNone(_find_aura(caster, STEALTH), "应获得ステルス")
        self.assertEqual(_count_marks(caster, "雌伏"), 4, "雌伏应4层")
        self.assertEqual(_count_auras(caster, STATUS_SPEED), 4, "spd_down×4")
        # once_per_battle 标记
        self.assertIn(230489, caster.once_per_battle_triggered,
                      "once_per_battle 应记录")

    def test_once_per_battle_no_second_trigger(self):
        """once_per_battle: 第二回合不再触发"""
        caster, foe, bf, ss, ts = self._setup()
        actions = ts.trigger_turn_start(bf)
        ps = [a for a in actions if a.skill_id == 230489]
        self.assertGreater(len(ps), 0)
        ss._pending_crit_triggers = []
        ss._execute_trigger_actions_inline(ps, bf)
        bf.turn_number = 2
        actions2 = ts.trigger_turn_start(bf)
        ps2 = [a for a in actions2 if a.skill_id == 230489]
        self.assertEqual(len(ps2), 0, "第二回合不应再触发")


