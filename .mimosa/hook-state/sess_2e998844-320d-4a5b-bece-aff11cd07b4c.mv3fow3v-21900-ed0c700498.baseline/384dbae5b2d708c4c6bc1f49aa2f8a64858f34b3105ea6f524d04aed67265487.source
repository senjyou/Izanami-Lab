#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""测试アタックアンプリファイ+(230373) PS效果是否正常触发"""

import sys, os
sys.path.insert(0, os.path.dirname(__file__))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.enums import Position, Side, SkillEffectType
from src.entities_v2.battlefield_state import BattlefieldState
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.skill_data_resolver import SkillDataResolver

import logging
logging.basicConfig(level=logging.INFO, format="[%(levelname)-5s] %(message)s", stream=sys.stdout)

def main():
    data_loader = DataLoader()
    data_loader.load_all()

    resolver = SkillDataResolver(data_loader)

    # 1. 验证技能数据解析
    resolved = resolver.resolve(230373, 10)
    if not resolved:
        print("FAIL: skill 230373 无法解析")
        return

    print(f"技能名: {resolved.name}")
    print(f"trigger_type: {resolved.trigger_type}")
    print(f"effect_blocks: {len(resolved.effect_blocks)}")

    for block in resolved.effect_blocks:
        print(f"  Block {block.block_id}:")
        for eff in block.effects:
            print(f"    effect_type={eff.effect_type} target_type={eff.target_type} "
                  f"value={eff.value} hit_limited={eff.flags.get('hit_limited')} "
                  f"is_en_attack={eff.flags.get('is_en_attack')}")

    # 验证block 1的add_damage_to_attack效果
    block1 = resolved.effect_blocks[0]
    eff1 = block1.effects[0]
    assert eff1.target_type == "self", f"target_type应为self, 实际为{eff1.target_type}"
    assert eff1.flags.get('hit_limited') == 1, f"hit_limited应为1, 实际为{eff1.flags.get('hit_limited')}"
    assert eff1.flags.get('is_en_attack') == True, f"is_en_attack应为True"
    assert eff1.value > 0, f"威力值应>0, 实际为{eff1.value}"

    print(f"\n威力值: {eff1.value}")
    print("PASS: 技能数据解析正确")

    # 2. 验证PS触发和buff应用
    bf = BattlefieldState()

    enemy = UnitState(
        unit_id="enemy_232315", name="フィー・ドレーゼ", side=Side.ENEMY,
        position=Position.ENEMY_CENTER_FRONT, character_id=232315, level=1,
        element=3, character_type=2,
        max_hp=474374, current_hp=474374,
        attack=17260, defense=8408, speed=649, crit_rate=0.21, crit_damage=1.5,
        advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=7,
        current_ap=4, current_pp=4, current_ep=2,
        skills=[210096, 220350, 230373, 230374, 230375],
        skill_levels={210096: 10, 220350: 10, 230373: 10, 230374: 10, 230375: 10},
        skill_cooldowns={}, role_type=2, position_type=3,
    )

    ally = UnitState(
        unit_id="ally_111201", name="ノーブル・グレイス", side=Side.ALLY,
        position=Position.ALLY_CENTER_FRONT, character_id=111201, level=80,
        element=0, character_type=1,
        max_hp=112464, current_hp=112464,
        attack=101521, defense=55688, speed=1261, crit_rate=0.2, crit_damage=1.5,
        advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=6,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
        role_type=1, position_type=1,
    )

    bf.add_unit(enemy)
    bf.add_unit(ally)

    damage_svc = DamageService()
    target_svc = TargetService()
    aura_svc = AuraService()
    trigger_svc = TriggerService()
    trigger_svc.set_data_loader(data_loader)

    from src.combat_v2.services.resource_service import ResourceService
    resource_svc = ResourceService()

    skill_svc = SkillService(data_loader, resource_svc,
                             target_service=target_svc,
                             damage_service=damage_svc,
                             aura_service=aura_svc,
                             trigger_service=trigger_svc)
    trigger_svc.set_skill_service(skill_svc)

    # 执行PS技能
    result = skill_svc.execute_skill(
        caster=enemy,
        skill_id=230373,
        battlefield=bf,
        skip_cost=True,
    )

    print(f"\nPS执行结果: success={result['success']}")
    print(f"effects_applied: {len(result['effects_applied'])}")
    for eff in result['effects_applied']:
        print(f"  {eff}")

    # 检查buff是否应用
    enchant_buffs = [b for b in enemy.buffs if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value]
    print(f"\nEnchantDamage buffs on enemy: {len(enchant_buffs)}")
    for b in enchant_buffs:
        print(f"  buff_id={b.buff_id} value={b.value} hit_limited={b.hit_limited}")

    if not enchant_buffs:
        print("FAIL: EnchantDamage buff未应用到施法者")
        return

    print("PASS: EnchantDamage buff已正确应用")

    # 3. 验证enchant damage在AS攻击时触发
    # 执行AS技能（カーテンショット 220350）
    as_result = skill_svc.execute_skill(
        caster=enemy,
        skill_id=220350,
        battlefield=bf,
        skip_cost=True,
    )

    print(f"\nAS执行结果: success={as_result['success']}")
    print(f"total_damage: {as_result['total_damage']}")

    # 检查enchant damage是否被触发
    enchant_effects = [e for e in as_result['effects_applied'] if e.get('effect_type') == 'enchant_damage']
    if enchant_effects:
        print(f"\nEnchant damage已触发!")
        for e in enchant_effects:
            for t in e.get('targets', []):
                print(f"  target={t.get('target_id')} damage={t.get('damage')}")
    else:
        print("\nWARN: 未找到独立的enchant_damage效果")

    # 检查buff是否被消耗
    enchant_buffs_after = [b for b in enemy.buffs if b.effect_type == SkillEffectType.ENCHANT_DAMAGE.value]
    print(f"\nAS执行后EnchantDamage buffs: {len(enchant_buffs_after)}")
    if len(enchant_buffs_after) == 0:
        print("PASS: EnchantDamage buff已被正确消耗")
    else:
        print(f"INFO: EnchantDamage buff剩余 hit_limited={enchant_buffs_after[0].hit_limited}")

    print("\n=== 测试完成 ===")

if __name__ == "__main__":
    main()
