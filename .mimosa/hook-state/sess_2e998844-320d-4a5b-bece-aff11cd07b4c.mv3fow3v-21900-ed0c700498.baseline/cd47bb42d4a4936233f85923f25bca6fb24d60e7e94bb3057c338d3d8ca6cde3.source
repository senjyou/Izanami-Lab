"""Full battle E2E: リフシルト def_up duration in real execute_battle().

Runs a complete battle and checks the narrative output for
[効果更新] ... StatusDefense ... which should NOT appear at the
end of the cast action.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig
from src.combat_v2.battle_narrative import BattleNarrativeWriter


class TestRifshildFullBattle(unittest.TestCase):

    def test_full_battle_no_effect_update_for_new_def_up(self):
        """Run execute_battle() and verify no [効果更新] for StatusDefense
        appears at the end of the リフシルト cast action."""
        bb = BattleBuilder()
        bb.add_ally(unit_id="caster", hp=20000, atk=100000,
                    skills=[220069], level=10, speed=500, ap=1)
        bb.add_enemy(unit_id="enemy", position=Position.ENEMY_CENTER_FRONT,
                     hp=1, speed=100)
        ctx = bb.build()
        bf = ctx['bf']
        narrative = BattleNarrativeWriter(data_loader=ctx['services']['dl'])
        controller = BattleFlowController(
            bf, BattleConfig(max_turns=1),
            data_loader=ctx['services']['dl'], narrative=narrative)

        controller.execute_battle()

        lines = narrative._lines
        print("\n===== FULL NARRATIVE =====")
        for l in lines:
            print(l)
        print("===== END NARRATIVE =====\n")

        sd_updates = [l for l in lines if "效果更新" in l and "StatusDefense" in l]
        print(f"[RESULT] StatusDefense effect_update lines: {sd_updates}")

        sd_gain = [l for l in lines if "获得增益" in l and "StatusDefense" in l]
        print(f"[RESULT] StatusDefense gain lines: {sd_gain}")

        self.assertGreater(len(sd_gain), 0, "StatusDefense buff should be gained")
        self.assertEqual(len(sd_updates), 0,
                         "should NOT have [效果更新] for StatusDefense at cast action end")

    def test_full_battle_with_ps_def_up_preexisting(self):
        """If the character also has PS that grants def_up (simulated with
        pre-existing buff), the AS cast should still not produce [効果更新]
        for StatusDefense."""
        from src.entities_v2.unit_state import BuffState
        from src.entities_v2.enums import SkillEffectType, AuraUpdateTiming

        bb = BattleBuilder()
        bb.add_ally(unit_id="caster", hp=20000, atk=100000,
                    skills=[220069], level=10, speed=500, ap=1)
        bb.add_enemy(unit_id="enemy", position=Position.ENEMY_CENTER_FRONT,
                     hp=1, speed=100)
        ctx = bb.build()
        bf = ctx['bf']
        caster = next(u for u in bf.friend_team if u.unit_id == "caster")

        pre_existing = BuffState(
            buff_id="ps_230029_StatusDefense_caster",
            name="StatusDefense",
            effect_type=SkillEffectType.STATUS_DEFENSE.value,
            value=15.0,
            duration=2,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id=caster.unit_id,
            source_skill_id=230029,
        )
        caster.buffs.append(pre_existing)

        narrative = BattleNarrativeWriter(data_loader=ctx['services']['dl'])
        controller = BattleFlowController(
            bf, BattleConfig(max_turns=1),
            data_loader=ctx['services']['dl'], narrative=narrative)

        controller.execute_battle()

        lines = narrative._lines
        print("\n===== FULL NARRATIVE (with pre-existing PS def_up) =====")
        for l in lines:
            print(l)
        print("===== END NARRATIVE =====\n")

        sd_updates = [l for l in lines if "效果更新" in l and "StatusDefense" in l]
        print(f"[RESULT] StatusDefense effect_update lines: {sd_updates}")

        self.assertEqual(len(sd_updates), 0,
                         "should NOT have [效果更新] for StatusDefense at cast action end")


if __name__ == '__main__':
    unittest.main(verbosity=2)
