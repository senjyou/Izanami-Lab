# -*- coding: utf-8 -*-
"""Regression: アーマー・ジャム (130027/230076/230315) must NOT trigger at all
when its primary_target (the AS-attacked unit) is dead.

Bug: When the caster's AS kills the target, the after_as_attack PS
     アーマー・ジャム still triggered. Its def_down effect uses
     target_type="debuff_applied_target" which should resolve to the AS
     primary_target. But the primary_target is now dead (HP=0), so:
       (1) aura resolution fell back to select_targets and applied def_down
           to the nearest *other* enemy — wrong target.
       (2) even after fixing (1) to skip (targets=[]), the PS still
           triggered: consumed PP, entered cooldown, incremented
           skill_use_count. The player wastes PP for no effect.

     Skill description: "自身がアクティブスキルで攻撃した後に発動。
     自身が攻撃した対象が次に行動を終えるまでの間、防御力を{def}%低下させる"
     The debuff target must be "自身が攻撃した対象" (the unit the caster
     attacked with AS). If that unit is dead, there is no valid target and
     the PS must NOT trigger at all.

Fix: In trigger_service._match_trigger_timing (AFTER_SKILL_USE branch),
     check if the PS has any effect with target_type="debuff_applied_target".
     If so, require context.primary_target to be alive; otherwise block
     the trigger (return False). This prevents PP consumption, cooldown,
     and skill_use_count increment when the AS target is dead.

     Defensive fix in skill_service._apply_aura and _apply_damage: when
     target_type=="debuff_applied_target" and primary_target is dead/None,
     set targets=[] (skip) instead of falling back to select_targets.
"""
import sys
import os
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute,
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig
from src.combat_v2.battle_narrative import BattleNarrativeWriter


DEF_DOWN = SkillEffectType.STATUS_DEFENSE.value


def _make_unit(unit_id, name, side, position, *,
               hp=100000, atk=10000, defense=4000, speed=500,
               crit_rate=0.0, crit_damage=0.5,
               element=Attribute.LIGHT.value, character_type=1,
               level=15, ap=10, pp=10, ep=0,
               skills=None, skill_levels=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=level, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=crit_damage, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=ap, current_pp=pp, current_ep=ep,
        is_alive=True,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class TestRegArmorJamNoFallback(unittest.TestCase):
    """アーマー・ジャム: AS主目标死亡时不应触发（不消耗PP，不进冷却）。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_caster(self, position=Position.ALLY_CENTER_FRONT, *, atk=100000):
        """正々堂々なミス・ツンデレ: AS=120018(クアッドエッジ), PS=130027(アーマー・ジャム)"""
        return _make_unit(
            "caster", "正々堂々なミス・ツンデレ",
            Side.ALLY, position,
            hp=100000, atk=atk, defense=4000, speed=600,
            crit_rate=0.0,
            element=Attribute.LIGHT.value, character_type=1,
            level=15,
            skills=[120018, 130027],
            skill_levels={120018: 15, 130027: 15},
        )

    def _make_enemy(self, unit_id, name, position, *, hp=10000, atk=5000):
        return _make_unit(
            unit_id, name,
            Side.ENEMY, position,
            hp=hp, atk=atk, defense=3000, speed=400,
            crit_rate=0.0,
            element=Attribute.DARK.value, character_type=1,
            level=15,
            skills=[], skill_levels={},
        )

    def _build_controller(self, bf):
        narrative = BattleNarrativeWriter(data_loader=self.dl)
        controller = BattleFlowController(
            bf, BattleConfig(max_turns=1),
            data_loader=self.dl, narrative=narrative,
        )
        controller._build_display_names()
        controller._deferred_crit_triggers = []
        return controller, narrative

    def _run_as_and_collect_ps(self, bf, caster, controller):
        """执行 AS 120018 → 收集 after_as_attack 触发器。

        Returns:
            ps_actions: 130027 的 trigger actions（可能为空）
        """
        ss = controller.skill_service
        ts = controller.trigger_service

        # 执行 AS
        ss.execute_skill(
            caster=caster, skill_id=120018, battlefield=bf, skip_cost=True
        )

        # 收集 after_as_attack 触发器
        # primary_target 来自 _last_primary_target（AS执行中记录的主目标）
        as_primary_target = getattr(ss, '_last_primary_target', None)
        trigger_actions = ts.trigger_after_skill_use(
            actor=caster, skill_id=120018, result={}, battlefield=bf,
            primary_target=as_primary_target,
        )
        ps_actions = [a for a in trigger_actions if a.skill_id == 130027]
        return ps_actions

    def test_armor_jam_not_triggered_when_as_kills_target(self):
        """AS 击杀目标时，アーマー・ジャム 不应触发（ps_actions 为空）。

        场景:
          - caster (ALLY_CENTER_FRONT) - 有 120018 AS + 130027 PS
          - enemy_weak (ENEMY_LEFT_FRONT, HP=1000) - AS 主目标，会被击杀
          - enemy_other (ENEMY_RIGHT_FRONT, HP=999999) - 次近敌方

        AS 攻击 enemy_weak 并击杀 → primary_target 死亡
        修复前: アーマー・ジャム 触发，fallback 到 select_targets，def_down 错误施加给 enemy_other
        修复后: アーマー・ジャム 不触发（trigger阶段被阻止），ps_actions 为空
        """
        caster = self._make_caster(Position.ALLY_CENTER_FRONT, atk=100000)
        enemy_weak = self._make_enemy(
            "enemy_weak", "弱敵", Position.ENEMY_LEFT_FRONT, hp=1000)
        enemy_other = self._make_enemy(
            "enemy_other", "他敵", Position.ENEMY_RIGHT_FRONT, hp=999999)
        bf = _make_bf(caster, enemy_weak, enemy_other)

        pp_before = caster.current_pp
        controller, narrative = self._build_controller(bf)
        ps_actions = self._run_as_and_collect_ps(bf, caster, controller)

        # enemy_weak 应该已死亡
        self.assertFalse(enemy_weak.is_alive,
                         "弱敵 应被 AS 击杀")

        # 关键验证：アーマー・ジャム 不应触发（primary_target 死亡，trigger阶段阻止）
        self.assertEqual(len(ps_actions), 0,
                         "アーマー・ジャム 不应在 primary_target 死亡时触发 "
                         f"(ps_actions={len(ps_actions)})")

        # PP 不应被消耗（PS未执行）
        self.assertEqual(caster.current_pp, pp_before,
                         "アーマー・ジャム 未触发，PP 不应消耗")

        # PS 不应进入冷却
        self.assertEqual(caster.skill_cooldowns.get(130027, 0), 0,
                         "アーマー・ジャム 未触发，不应进入冷却")

        # enemy_other 不应有 def_down buff
        other_def_downs = [b for b in enemy_other.debuffs
                           if b.effect_type == DEF_DOWN]
        self.assertEqual(len(other_def_downs), 0,
                         "他敵 不应有 def_down (アーマー・ジャム 未触发)")

    def test_armor_jam_triggered_when_target_alive(self):
        """AS 未击杀目标时，アーマー・ジャム 应正常触发并施加 def_down。

        场景:
          - caster (ALLY_CENTER_FRONT) - 有 120018 AS + 130027 PS
          - enemy_tank (ENEMY_LEFT_FRONT, HP=999999) - AS 主目标，存活
          - enemy_other (ENEMY_RIGHT_FRONT, HP=999999) - 次近敌方

        AS 攻击 enemy_tank 未击杀 → primary_target 存活
        アーマー・ジャム 应触发，def_down 施加给 enemy_tank（不是 enemy_other）
        """
        caster = self._make_caster(Position.ALLY_CENTER_FRONT, atk=1000)
        enemy_tank = self._make_enemy(
            "enemy_tank", "肉盾敵", Position.ENEMY_LEFT_FRONT, hp=999999)
        enemy_other = self._make_enemy(
            "enemy_other", "他敵", Position.ENEMY_RIGHT_FRONT, hp=999999)
        bf = _make_bf(caster, enemy_tank, enemy_other)

        controller, narrative = self._build_controller(bf)
        ps_actions = self._run_as_and_collect_ps(bf, caster, controller)

        # enemy_tank 应存活
        self.assertTrue(enemy_tank.is_alive,
                        "肉盾敵 应存活 (HP足够高)")

        # アーマー・ジャム 应触发
        self.assertGreater(len(ps_actions), 0,
                           "アーマー・ジャム 应触发 (primary_target 存活)")

        # 执行 PS
        controller._execute_trigger_actions(ps_actions, caster)

        # enemy_tank 应有 def_down buff
        tank_def_downs = [b for b in enemy_tank.debuffs
                          if b.effect_type == DEF_DOWN]
        self.assertGreater(len(tank_def_downs), 0,
                           "アーマー・ジャム 应对 primary_target (肉盾敵) 施加 def_down")

        # enemy_other 不应有 def_down
        other_def_downs = [b for b in enemy_other.debuffs
                           if b.effect_type == DEF_DOWN]
        self.assertEqual(len(other_def_downs), 0,
                         "アーマー・ジャム 不应对非 primary_target (他敵) 施加 def_down")

    def test_armor_jam_no_def_down_in_narrative_when_skipped(self):
        """AS击杀目标时，叙事日志中不应出现 def_down 施加记录。"""
        caster = self._make_caster(Position.ALLY_CENTER_FRONT, atk=100000)
        enemy_weak = self._make_enemy(
            "enemy_weak", "弱敵", Position.ENEMY_LEFT_FRONT, hp=1000)
        enemy_other = self._make_enemy(
            "enemy_other", "他敵", Position.ENEMY_RIGHT_FRONT, hp=999999)
        bf = _make_bf(caster, enemy_weak, enemy_other)

        controller, narrative = self._build_controller(bf)
        ps_actions = self._run_as_and_collect_ps(bf, caster, controller)
        if ps_actions:
            controller._execute_trigger_actions(ps_actions, caster)

        # 叙事日志中不应出现对他敵施加 def_down 的记录
        lines = narrative._lines
        def_down_on_other = any("他敵" in l and "防御" in l for l in lines)
        self.assertFalse(def_down_on_other,
                         "叙事日志不应记录对他敵施加 def_down。日志:\n"
                         + "\n".join(lines))


if __name__ == '__main__':
    unittest.main(verbosity=2)
