"""Regression: 鳴ノ硬直 (230386) / 大ノ反撃 (230389) / カウンターショット (230391)
should trigger when SELF is attacked by AS, not when an ALLY is attacked.

Bug: These three PS skills had trigger_type "after_as_attacked_ally" (triggers
     when any ally is attacked by AS), but their descriptions say
     "自身がアクティブスキルで攻撃された後に発動" (triggers after SELF is attacked
     by AS). This caused them to fire when an ally was attacked instead of only
     when the PS owner was attacked.

Fix: Changed trigger_type from "after_as_attacked_ally" to "after_as_attacked"
     in data/skill_effects_hybrid.json for skills 230386, 230389, 230391.
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, Attribute
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=Attribute.WATER.value,
               character_type=2, skills=None, skill_levels=None):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_bf(*units):
    bf = BattlefieldState()
    bf.friend_team = [u for u in units if u.side == Side.ALLY]
    bf.enemy_team = [u for u in units if u.side == Side.ENEMY]
    return bf


class TestRegNaruKouchokuSelfAttacked(unittest.TestCase):
    """鳴ノ硬直/大ノ反撃/カウンターショット must trigger on SELF attacked, not ally."""

    SKILL_SPECS = [
        # (skill_id, name, position, skills_list)
        (230386, "鳴雷", Position.ENEMY_CENTER_BACK,
         [220365, 220366, 230386, 230387]),
        (230389, "大雷", Position.ENEMY_LEFT_FRONT,
         [220367, 220368, 230389, 230390]),
        (230391, "霞光", Position.ENEMY_RIGHT_FRONT,
         [220369, 220370, 230391, 230393]),
    ]

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    def _make_owner(self, skill_id, name, position, skills_list):
        return _make_unit(
            "owner", name, Side.ENEMY, position,
            hp=200000, atk=10000, defense=4000, speed=500,
            skills=skills_list,
            skill_levels={sid: 10 for sid in skills_list},
        )

    def _make_attacker(self):
        return _make_unit(
            "atk", "友方攻撃者", Side.ALLY, Position.ALLY_CENTER_FRONT,
            hp=50000, atk=8000, defense=4000, speed=500,
            element=Attribute.FIRE.value, character_type=1,
        )

    def _make_teammate(self):
        return _make_unit(
            "tm", "队友", Side.ENEMY, Position.ENEMY_LEFT_FRONT,
            hp=999999, atk=5000, defense=3000, speed=400,
        )

    def _check_trigger_after_as_attacked(self, ts, bf, attacker, primary_target):
        """Call trigger_after_as_attacked and return matching actions for
        the three target skill IDs."""
        actions = ts.trigger_after_as_attacked(
            targets=[primary_target], battlefield=bf,
            actor=attacker, primary_target=primary_target,
        )
        return {sid: [a for a in actions if a.skill_id == sid]
                for sid, _, _, _ in self.SKILL_SPECS}

    def _check_trigger_after_as_attacked_ally(self, ts, bf, attacker, primary_target):
        """Call trigger_after_as_attacked_ally (should NOT match after fix)."""
        actions = ts.trigger_after_as_attacked_ally(
            targets=[primary_target], battlefield=bf,
            actor=attacker, primary_target=primary_target,
        )
        return {sid: [a for a in actions if a.skill_id == sid]
                for sid, _, _, _ in self.SKILL_SPECS}

    def test_trigger_type_is_after_as_attacked(self):
        """Verify the three skills now have trigger_type=after_as_attacked."""
        for skill_id, name, _, _ in self.SKILL_SPECS:
            parsed = self.dl.get_parsed_skill_data(skill_id)
            self.assertIsNotNone(parsed, f"{name}({skill_id}) parsed data missing")
            self.assertEqual(
                parsed.get('trigger_type'), 'after_as_attacked',
                f"{name}({skill_id}) should have trigger_type=after_as_attacked, "
                f"got {parsed.get('trigger_type')}"
            )

    def test_triggers_when_self_is_as_primary_target(self):
        """Each PS should trigger when its owner is the AS primary target."""
        for skill_id, name, position, skills_list in self.SKILL_SPECS:
            with self.subTest(skill=name):
                owner = self._make_owner(skill_id, name, position, skills_list)
                attacker = self._make_attacker()
                bf = _make_bf(owner, attacker)
                _, ts = self._make_services(bf)

                result = self._check_trigger_after_as_attacked(
                    ts, bf, attacker, primary_target=owner)
                self.assertGreater(
                    len(result[skill_id]), 0,
                    f"{name}({skill_id}) should trigger via after_as_attacked "
                    f"when self is AS primary target"
                )

    def test_does_not_trigger_when_ally_is_as_primary_target(self):
        """Each PS should NOT trigger when only an ally is the AS primary target."""
        for skill_id, name, position, skills_list in self.SKILL_SPECS:
            with self.subTest(skill=name):
                owner = self._make_owner(skill_id, name, position, skills_list)
                teammate = self._make_teammate()
                attacker = self._make_attacker()
                bf = _make_bf(owner, teammate, attacker)
                _, ts = self._make_services(bf)

                result = self._check_trigger_after_as_attacked(
                    ts, bf, attacker, primary_target=teammate)
                self.assertEqual(
                    len(result[skill_id]), 0,
                    f"{name}({skill_id}) should NOT trigger via after_as_attacked "
                    f"when ally (not self) is AS primary target"
                )

    def test_does_not_match_after_as_attacked_ally_timing(self):
        """The three skills should NOT match after_as_attacked_ally timing anymore."""
        for skill_id, name, position, skills_list in self.SKILL_SPECS:
            with self.subTest(skill=name):
                owner = self._make_owner(skill_id, name, position, skills_list)
                teammate = self._make_teammate()
                attacker = self._make_attacker()
                bf = _make_bf(owner, teammate, attacker)
                _, ts = self._make_services(bf)

                result = self._check_trigger_after_as_attacked_ally(
                    ts, bf, attacker, primary_target=teammate)
                self.assertEqual(
                    len(result[skill_id]), 0,
                    f"{name}({skill_id}) should NOT match after_as_attacked_ally "
                    f"timing (it's now after_as_attacked)"
                )


if __name__ == '__main__':
    unittest.main()
