"""
角色106302 夏色シャイガール 专项测试
- EX: 110073 だ、誰か止めてぇ～～！（最近敵単体 + 対象に隣接する敵に攻撃）
- AS1: 120161 クリティカル・スプラッシュ（攻撃力最高敵単体攻撃 + Lv11+ 潮騒mark + 自身dmg_taken_down）
- PS1: 130161 オブ・ザ・グラウンド（AS攻撃後発動, 前列優先敵2体攻撃 + def_down(source_death_remove) + Lv11+ dmg_taken_down）
- PS2: 130162 サマー・クラッチ（他の味方被击倒時発動, atk_up+add_ep + Lv11+ dmg_dealt_up）
- PS3: 130163 スイッチ・ポジション（ターン開始時発動, 前列:perfect_evasion+cheat_death / 後列:dmg_dealt_up+crit_dmg_up）
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# effect_type 枚举值简写
ATK_UP = SkillEffectType.STATUS_ATTACK.value             # "StatusAttack"
DEF_DOWN = SkillEffectType.STATUS_DEFENSE.value          # "StatusDefense"
CRIT_DMG_UP = SkillEffectType.CRITICAL_BONUS_MODIFICATION.value  # "CriticalBonusModification"
DMG_DEALT_UP = SkillEffectType.DEALT_DAMAGE.value        # "DealtDamage"
DMG_TAKEN_DOWN = SkillEffectType.RECEIVED_DAMAGE.value   # "ReceivedDamage"
EVASION = SkillEffectType.EVADE.value                    # "Evade"
# 注意: cheat_death 在 _JSON_EFFECT_TO_ENUM 中未映射，buff.effect_type 保持原始字符串 "cheat_death"
CHEAT_DEATH = "cheat_death"
MARK = SkillEffectType.MARK.value                        # "Mark"


class TestActor106302(unittest.TestCase):
    """角色106302 夏色シャイガール 专项测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()
        self.bf.turn_number = 2  # 默认第2回合（PS3 on_turn_start 需要非第1回合）

        # 施法者: 106302 夏色シャイガール (光属性, 敏捷型, 后排中央)
        # 满级属性: HP=21120, ATK=16600, DEF=8520, SPD=750, CRT=15%
        self.caster = UnitState(
            unit_id="ally_back", name="夏色シャイガール", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=106302, level=15,
            element=5, character_type=3,
            max_hp=21120, current_hp=21120,
            attack=16600, defense=8520, speed=750,
            crit_rate=0.15, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=8,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110073, 120161, 130161, 130162, 130163],
            skill_levels={110073: 15, 120161: 15, 130161: 15, 130162: 15, 130163: 15},
            skill_cooldowns={},
        )

        # 友方前排中央（用于PS2 on_ally_killed测试，可被击杀）
        self.ally_front = UnitState(
            unit_id="ally_front", name="友方前排", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=999100, level=15,
            element=2, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=12000, defense=6000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央（主目标候选，攻击力较低）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敌方前排中央", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=15,
            element=2, character_type=1,
            max_hp=50000, current_hp=50000,
            attack=8000, defense=3000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（与中央相邻，攻击力最高）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敌方左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=15,
            element=4, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=15000, defense=2500, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（与中央相邻）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敌方右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=15,
            element=5, character_type=2,
            max_hp=25000, current_hp=25000,
            attack=5000, defense=2000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=1,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方后排中央（用于PS1 front_priority回退测试）
        self.enemy_cb = UnitState(
            unit_id="enemy_cb", name="敌方后排中央", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=999002, level=15,
            element=3, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=6000, defense=2000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=5, current_ep=4,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally_front]
        self.bf.enemy_team = [
            self.enemy_cf, self.enemy_lf, self.enemy_rf, self.enemy_cb,
        ]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ts.set_damage_service(self.dms)
        self.ss.set_battlefield(self.bf)

    def _reset_all_units(self):
        """重置所有单位的HP/buff/cooldown状态"""
        for u in self.bf.friend_team + self.bf.enemy_team:
            u.current_hp = u.max_hp
            u.buffs = []
            u.debuffs = []
            u.is_alive = True
            u.is_death_notified = False
            u.skill_cooldowns = {}
            u.current_ep = 0

    # ════════════════════════════════════════════════════════════════
    # EX: 110073 だ、誰か止めてぇ～～！
    # ════════════════════════════════════════════════════════════════

    def test_ex_damage_to_main_and_adjacent(self):
        """EX(110073) 主目标+相邻敌方都受到伤害"""
        self._reset_all_units()
        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110073, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"], "EX应成功执行")

        # 主目标（最近敌方）应受到伤害
        self.assertLess(self.enemy_cf.current_hp, hp_cf_before,
                        "EX主目标(敌方前排中央)应受到伤害")
        # 相邻敌方也应受到伤害
        self.assertLess(self.enemy_lf.current_hp, hp_lf_before,
                        "EX相邻敌方(左前)应受到伤害")
        self.assertLess(self.enemy_rf.current_hp, hp_rf_before,
                        "EX相邻敌方(右前)应受到伤害")

    def test_ex_two_damage_effects(self):
        """EX(110073) effects_applied中应包含2个damage效果"""
        self._reset_all_units()
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110073, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])
        damage_effects = [e for e in result.get("effects_applied", [])
                          if e.get("effect_type") == "damage"]
        self.assertEqual(len(damage_effects), 2,
                         "EX应有2个damage效果（主目标 + 相邻敌方）")

    # ════════════════════════════════════════════════════════════════
    # AS1: 120161 クリティカル・スプラッシュ
    # ════════════════════════════════════════════════════════════════

    def test_as_targets_highest_atk_enemy(self):
        """AS(120161) 目标是攻击力最高的敌方"""
        self._reset_all_units()
        # enemy_lf 攻击力最高 (15000)
        hp_lf_before = self.enemy_lf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 攻击力最高的 enemy_lf 应受到伤害
        self.assertLess(self.enemy_lf.current_hp, hp_lf_before,
                        "AS应攻击攻击力最高的敌方(敌方左前)")

    def test_as_lv10_no_mark(self):
        """AS(120161) Lv10 不付与「潮騒」mark，自身无dmg_taken_down buff"""
        self._reset_all_units()
        self.caster.skill_levels[120161] = 10

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_lf (攻击力最高) 不应有「潮騒」mark
        marks = [b for b in self.enemy_lf.debuffs + self.enemy_lf.buffs
                 if b.effect_type == MARK and b.name == "潮騒"]
        self.assertEqual(len(marks), 0, "Lv10不应付与「潮騒」mark")

        # 自身不应有 dmg_taken_down buff
        dmg_down_buffs = [b for b in self.caster.buffs if b.effect_type == DMG_TAKEN_DOWN]
        self.assertEqual(len(dmg_down_buffs), 0, "Lv10自身不应有dmg_taken_down buff")

    def test_as_lv11_applies_mark(self):
        """AS(120161) Lv11+ 对目标付与「潮騒」mark"""
        self._reset_all_units()
        self.caster.skill_levels[120161] = 15

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_lf (攻击力最高) 应有「潮騒」mark
        marks = [b for b in self.enemy_lf.debuffs + self.enemy_lf.buffs
                 if b.effect_type == MARK and b.name == "潮騒"]
        self.assertGreater(len(marks), 0, "Lv11+应付与目标「潮騒」mark")

    def test_as_lv11_self_dmg_taken_down(self):
        """AS(120161) Lv11+ 自身获得 dmg_taken_down buff (mark_condition=潮騒)"""
        self._reset_all_units()
        self.caster.skill_levels[120161] = 15

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_down_buffs = [b for b in self.caster.buffs if b.effect_type == DMG_TAKEN_DOWN]
        self.assertGreater(len(dmg_down_buffs), 0,
                           "Lv11+自身应获得dmg_taken_down buff")
        buff = dmg_down_buffs[0]
        self.assertEqual(buff.mark_condition, "潮騒",
                         "dmg_taken_down 应有 mark_condition=潮騒")
        self.assertTrue(buff.unremovable,
                        "dmg_taken_down 应为 unremovable (解除不可)")

    def test_as_lv11_mark_not_reapplied(self):
        """AS(120161) Lv11+ 已持「潮騒」的目标不重复付与"""
        self._reset_all_units()
        self.caster.skill_levels[120161] = 15

        # 第1次施放：付与「潮騒」mark
        result1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result1["success"])
        marks_after_1 = [b for b in self.enemy_lf.debuffs + self.enemy_lf.buffs
                         if b.effect_type == MARK and b.name == "潮騒"]
        self.assertEqual(len(marks_after_1), 1, "第1次施放后应有1个「潮騒」mark")

        # 第2次施放：不应重复付与
        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result2["success"])
        marks_after_2 = [b for b in self.enemy_lf.debuffs + self.enemy_lf.buffs
                         if b.effect_type == MARK and b.name == "潮騒"]
        self.assertEqual(len(marks_after_2), 1,
                         "已持「潮騒」的目标不应重复付与")

    # ════════════════════════════════════════════════════════════════
    # PS1: 130161 オブ・ザ・グラウンド
    # ════════════════════════════════════════════════════════════════

    def test_ps1_triggers_after_as_attack(self):
        """PS1(130161) 自身AS攻击后触发"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}

        # 先执行AS技能
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 触发after_as_attack
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120161, result=result, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130161]
        self.assertGreater(len(ps1_actions), 0,
                           "PS1应在自身AS攻击后触发")

    def test_ps1_front_priority_2_targets(self):
        """PS1(130161) 选前排优先的2名敌方"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}

        hp_cf_before = self.enemy_cf.current_hp
        hp_lf_before = self.enemy_lf.current_hp
        hp_rf_before = self.enemy_rf.current_hp
        hp_cb_before = self.enemy_cb.current_hp

        # 直接执行PS1技能（跳过AS触发流程，单独验证PS1的front_priority逻辑）
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=130161, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"], "PS1应成功执行")

        # 前排3个敌方中应有2个受到伤害（前排优先）
        front_damaged = 0
        if self.enemy_cf.current_hp < hp_cf_before:
            front_damaged += 1
        if self.enemy_lf.current_hp < hp_lf_before:
            front_damaged += 1
        if self.enemy_rf.current_hp < hp_rf_before:
            front_damaged += 1
        self.assertEqual(front_damaged, 2,
                         "PS1应攻击前排优先的2名敌方")

        # 后排不应受到伤害（前排有3人≥2人）
        self.assertEqual(self.enemy_cb.current_hp, hp_cb_before,
                         "PS1在前排充足时不应攻击后排")

    def test_ps1_def_down_source_death_remove_flag(self):
        """PS1(130161) def_down 应有 source_death_remove 标志"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120161, result=result, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130161]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="after_as_attack"
        )

        # 受伤的敌方应有 def_down debuff 且 source_death_remove=True
        damaged_enemies = [u for u in self.bf.enemy_team
                           if any(b.effect_type == DEF_DOWN for b in u.debuffs)]
        self.assertGreater(len(damaged_enemies), 0,
                           "应有敌方被付与def_down")
        for enemy in damaged_enemies:
            def_downs = [b for b in enemy.debuffs if b.effect_type == DEF_DOWN]
            self.assertTrue(def_downs[0].source_death_remove,
                            f"{enemy.name} 的 def_down 应有 source_death_remove=True")
            self.assertTrue(def_downs[0].is_stackable,
                            f"{enemy.name} 的 def_down 应为 stackable")

    def test_ps1_def_down_removed_on_caster_death(self):
        """PS1(130161) 付与者死亡时 def_down 自动清除 (source_death_remove)"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}

        # 触发PS1付与def_down
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120161, result=result, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130161]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="after_as_attack"
        )

        # 找到带def_down的敌方
        enemies_with_def_down = [u for u in self.bf.enemy_team
                                 if any(b.effect_type == DEF_DOWN and b.source_death_remove
                                        for b in u.debuffs)]
        self.assertGreater(len(enemies_with_def_down), 0,
                           "应有敌方持有source_death_remove的def_down")
        enemy = enemies_with_def_down[0]
        def_down_count_before = len([b for b in enemy.debuffs if b.effect_type == DEF_DOWN])

        # 施法者死亡，复制 source_death_remove 清理逻辑验证
        self.caster.is_alive = False
        dead_ids = {self.caster.unit_id}
        to_remove = []
        for buff in enemy.debuffs:
            if getattr(buff, 'source_death_remove', False) and buff.source_unit_id in dead_ids:
                to_remove.append(buff.buff_id)
        enemy.debuffs = [b for b in enemy.debuffs if b.buff_id not in to_remove]

        def_down_count_after = len([b for b in enemy.debuffs if b.effect_type == DEF_DOWN])
        self.assertLess(def_down_count_after, def_down_count_before,
                        "施法者死亡后def_down应被清除")

    def test_ps1_lv11_self_dmg_taken_down(self):
        """PS1(130161) Lv11+ 自身获得 dmg_taken_down (1 action)"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}
        self.caster.skill_levels[130161] = 15

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        actions = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120161, result=result, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130161]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="after_as_attack"
        )

        dmg_down_buffs = [b for b in self.caster.buffs if b.effect_type == DMG_TAKEN_DOWN]
        self.assertGreater(len(dmg_down_buffs), 0,
                           "Lv11+自身应获得dmg_taken_down buff")
        self.assertTrue(dmg_down_buffs[0].is_stackable,
                        "dmg_taken_down 应为 stackable")

    def test_ps1_cooldown_blocks_second_trigger(self):
        """PS1(130161) cooldown=1 一次行动内仅触发一次"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}

        # 第1次触发
        result1 = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        actions1 = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120161, result=result1, battlefield=self.bf
        )
        ps1_actions1 = [a for a in actions1 if a.skill_id == 130161]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions1, self.bf, trigger_timing="after_as_attack"
        )

        # 验证cooldown已设置
        self.assertEqual(self.caster.skill_cooldowns.get(130161, 0), 1,
                         "PS1触发后应设置cooldown=1")

        # 第2次触发应被cooldown阻止（trigger_service应不再收集）
        result2 = self.ss.execute_skill(
            caster=self.caster, skill_id=120161, battlefield=self.bf, skip_cost=True
        )
        actions2 = self.ts.trigger_after_as_attack(
            actor=self.caster, skill_id=120161, result=result2, battlefield=self.bf
        )
        ps1_actions2 = [a for a in actions2 if a.skill_id == 130161]
        self.assertEqual(len(ps1_actions2), 0,
                         "PS1在cooldown中时不应再次触发")

    # ════════════════════════════════════════════════════════════════
    # PS2: 130162 サマー・クラッチ
    # ════════════════════════════════════════════════════════════════

    def test_ps2_triggers_on_ally_killed(self):
        """PS2(130162) 其他友方被击倒时触发"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}

        # ally_front 阵亡
        self.ally_front.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_front], battlefield=self.bf, killer=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130162]
        self.assertGreater(len(ps2_actions), 0,
                           "PS2应在其他友方被击倒时触发")

    def test_ps2_no_trigger_when_self_killed(self):
        """PS2(130162) 自身被击倒时不触发"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}

        # caster 自身阵亡
        self.caster.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.caster], battlefield=self.bf, killer=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130162]
        self.assertEqual(len(ps2_actions), 0,
                         "PS2不应在自身被击倒时触发")

    def test_ps2_no_trigger_when_enemy_killed(self):
        """PS2(130162) 敌方被击倒时不触发"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}

        # 敌方阵亡
        self.enemy_cf.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.enemy_cf], battlefield=self.bf, killer=self.caster
        )
        ps2_actions = [a for a in actions if a.skill_id == 130162]
        self.assertEqual(len(ps2_actions), 0,
                         "PS2不应在敌方被击倒时触发")

    def test_ps2_atk_up_and_add_ep(self):
        """PS2(130162) atk_up + add_ep 2"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}
        self.caster.skill_levels[130162] = 10  # Lv10 仅Block1
        ep_before = self.caster.current_ep

        self.ally_front.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_front], battlefield=self.bf, killer=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130162]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_ally_killed"
        )

        # 验证 atk_up buff
        atk_ups = [b for b in self.caster.buffs if b.effect_type == ATK_UP]
        self.assertGreater(len(atk_ups), 0, "PS2应赋予自身atk_up buff")
        self.assertTrue(atk_ups[0].is_stackable, "atk_up应为stackable")

        # 验证 EP增加：PS技能消耗1PP自动产生1EP + add_ep +2 = 总共+3
        self.assertEqual(self.caster.current_ep, ep_before + 3,
                         "PS2应增加自身EP+3 (1PP消耗+1EP + add_ep+2)")

    def test_ps2_lv11_dmg_dealt_up(self):
        """PS2(130162) Lv11+ 额外获得 dmg_dealt_up"""
        self._reset_all_units()
        self.caster.skill_cooldowns = {}
        self.caster.skill_levels[130162] = 15

        self.ally_front.is_alive = False
        actions = self.ts.trigger_pawn_died(
            dead_units=[self.ally_front], battlefield=self.bf, killer=self.enemy_cf
        )
        ps2_actions = [a for a in actions if a.skill_id == 130162]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_ally_killed"
        )

        dmg_up_buffs = [b for b in self.caster.buffs if b.effect_type == DMG_DEALT_UP]
        self.assertGreater(len(dmg_up_buffs), 0,
                           "Lv11+应额外获得dmg_dealt_up buff")
        self.assertTrue(dmg_up_buffs[0].is_stackable,
                        "dmg_dealt_up 应为 stackable")

    # ════════════════════════════════════════════════════════════════
    # PS3: 130163 スイッチ・ポジション
    # ════════════════════════════════════════════════════════════════

    def test_ps3_triggers_on_turn_start(self):
        """PS3(130163) 回合开始时触发"""
        self._reset_all_units()
        self.bf.turn_number = 2

        actions = self.ts.trigger_turn_start(self.bf)
        ps3_actions = [a for a in actions if a.skill_id == 130163]
        self.assertGreater(len(ps3_actions), 0,
                           "PS3应在回合开始时触发")

    def test_ps3_back_row_dmg_dealt_up_and_crit_dmg_up(self):
        """PS3(130163) 后排时获得 dmg_dealt_up + crit_dmg_up"""
        self._reset_all_units()
        self.caster.position = Position.ALLY_CENTER_BACK  # 后排

        actions = self.ts.trigger_turn_start(self.bf)
        ps3_actions = [a for a in actions if a.skill_id == 130163]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证 dmg_dealt_up buff
        dmg_up_buffs = [b for b in self.caster.buffs if b.effect_type == DMG_DEALT_UP]
        self.assertGreater(len(dmg_up_buffs), 0,
                           "后排时应获得dmg_dealt_up buff")
        self.assertTrue(dmg_up_buffs[0].is_stackable,
                        "dmg_dealt_up 应为 stackable")

        # 验证 crit_dmg_up buff
        crit_buffs = [b for b in self.caster.buffs if b.effect_type == CRIT_DMG_UP]
        self.assertGreater(len(crit_buffs), 0,
                           "后排时应获得crit_dmg_up buff")

    def test_ps3_front_row_evade_and_cheat_death(self):
        """PS3(130163) 前排时获得 perfect_evasion + cheat_death"""
        self._reset_all_units()
        self.caster.position = Position.ALLY_CENTER_FRONT  # 前排

        actions = self.ts.trigger_turn_start(self.bf)
        ps3_actions = [a for a in actions if a.skill_id == 130163]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证 perfect_evasion buff
        evade_buffs = [b for b in self.caster.buffs if b.effect_type == EVASION]
        self.assertGreater(len(evade_buffs), 0,
                           "前排时应获得perfect_evasion buff")
        # hit_limited=3
        self.assertEqual(evade_buffs[0].hit_limited, 3,
                         "perfect_evasion 应有 hit_limited=3")

        # 验证 cheat_death buff
        cheat_buffs = [b for b in self.caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertGreater(len(cheat_buffs), 0,
                           "前排时应获得cheat_death buff")
        # hit_limited=1
        self.assertEqual(cheat_buffs[0].hit_limited, 1,
                         "cheat_death 应有 hit_limited=1")

    def test_ps3_front_row_no_back_row_buffs(self):
        """PS3(130163) 前排时不应获得后排的buff"""
        self._reset_all_units()
        self.caster.position = Position.ALLY_CENTER_FRONT  # 前排

        actions = self.ts.trigger_turn_start(self.bf)
        ps3_actions = [a for a in actions if a.skill_id == 130163]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 不应有 dmg_dealt_up / crit_dmg_up
        dmg_up_buffs = [b for b in self.caster.buffs if b.effect_type == DMG_DEALT_UP]
        self.assertEqual(len(dmg_up_buffs), 0,
                         "前排时不应获得dmg_dealt_up buff")
        crit_buffs = [b for b in self.caster.buffs if b.effect_type == CRIT_DMG_UP]
        self.assertEqual(len(crit_buffs), 0,
                         "前排时不应获得crit_dmg_up buff")

    def test_ps3_back_row_no_front_row_buffs(self):
        """PS3(130163) 后排时不应获得前排的buff"""
        self._reset_all_units()
        self.caster.position = Position.ALLY_CENTER_BACK  # 后排

        actions = self.ts.trigger_turn_start(self.bf)
        ps3_actions = [a for a in actions if a.skill_id == 130163]
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps3_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 不应有 perfect_evasion / cheat_death
        evade_buffs = [b for b in self.caster.buffs if b.effect_type == EVASION]
        self.assertEqual(len(evade_buffs), 0,
                         "后排时不应获得perfect_evasion buff")
        cheat_buffs = [b for b in self.caster.buffs if b.effect_type == CHEAT_DEATH]
        self.assertEqual(len(cheat_buffs), 0,
                         "后排时不应获得cheat_death buff")


