"""Regression: EX技能使用后不应触发 on_skill_use_count 类PS（如 ぜ～～ったい負けないから！）。

Bug: trigger_skill_use_count 在 _execute_unit_action 中被无条件调用，
     导致使用EX技能(skill_type=3)后也会检查 skill_use_count_modulo 条件。
     若之前AS使用累积的count >= 阈值（PS被genwaku/PP不足阻止未执行，count保持），
     EX技能执行后会错误触发PS。

Fix: L1007 只对PS技能(skill_type=2)更新skill_use_count；
     L1012 EX技能(skill_type=3)跳过 trigger_skill_use_count 调用。

Scenario:
  1. Unit has genwaku + AS count=2
  2. AS skill used (genwaku active) → count=3, PS blocked by genwaku
  3. Genwaku expires
  4. EP set to full, EX skill used → PS must NOT trigger
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'src'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.battle_flow_controller import BattleFlowController

ZETTAI_MAKENAI = 130081      # ぜ～～ったい負けないから！ (on_skill_use_count, >= 3)
AS_SKILL = 120068            # ゴーストハザード (AS)
EX_SKILL = 110001            # ルミナグレイス (EX, skill_type=3)
GENWAKU = SkillEffectType.GENWAKU.value


def _make_unit(unit_id, name, side, position, *, hp=1000000, atk=10000,
               defense=5000, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ap=20, ep=0, max_ep=10,
               crit_rate=0.0):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=15, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=20, initial_passive_point=4, max_extra_point=max_ep,
        current_ap=ap, current_pp=pp, current_ep=ep,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _make_genwaku_buff(caster_id, duration=1):
    return BuffState(
        buff_id=f"{caster_id}_genwaku_test",
        name=GENWAKU,
        effect_type=GENWAKU,
        value=50.0,
        duration=duration,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=caster_id,
        is_debuff=True,
    )


class TestRegExSkillNoSkillCountTrigger(unittest.TestCase):
    """EX技能使用后不应触发 on_skill_use_count 类PS。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _setup_battle(self, *, ep=0, max_ep=10, pp=4):
        bf = BattlefieldState()

        unit_a = _make_unit(
            "ally_a", "UnitA", Side.ALLY,
            Position.ALLY_CENTER_FRONT,
            hp=1000000, atk=50000, speed=900, pp=pp, ap=20, ep=ep, max_ep=max_ep,
            skills=[AS_SKILL, EX_SKILL, ZETTAI_MAKENAI],
            skill_levels={AS_SKILL: 15, EX_SKILL: 15, ZETTAI_MAKENAI: 15},
        )
        unit_a.skill_use_count = {AS_SKILL: 2}

        unit_b = _make_unit(
            "enemy_b", "UnitB", Side.ENEMY,
            Position.ENEMY_CENTER_FRONT,
            hp=1000000, atk=1000, speed=500, pp=10, ap=10,
            skills=[], skill_levels={},
        )

        bf.friend_team = [unit_a]
        bf.enemy_team = [unit_b]

        controller = BattleFlowController(bf, data_loader=self.dl)
        controller._build_display_names()
        controller.skill_service.set_battlefield(bf)
        controller._deferred_crit_triggers = []

        return bf, unit_a, unit_b, controller

    def _record_executions(self, controller):
        execution_log = []
        original_execute = controller.skill_service.execute_skill

        def recording_execute(*args, **kwargs):
            result = original_execute(*args, **kwargs)
            skill_id = kwargs.get('skill_id')
            caster = kwargs.get('caster')
            if skill_id and caster:
                execution_log.append(skill_id)
            return result

        controller.skill_service.execute_skill = recording_execute
        return execution_log

    def test_ex_skill_does_not_trigger_skill_count_ps(self):
        """EX技能使用后不应触发 on_skill_use_count 类PS。

        场景：genwaku阻止PS触发后count保持=3，EP满后使用EX技能，PS不应触发。
        """
        bf, unit_a, unit_b, controller = self._setup_battle(ep=0, max_ep=10, pp=4)
        execution_log = self._record_executions(controller)

        # 1. Apply genwaku, use AS skill → count=3, PS blocked
        genwaku = _make_genwaku_buff("external_caster", duration=1)
        unit_a.debuffs.append(genwaku)
        unit_a.is_genwaku = True

        controller._execute_unit_action(unit_a, turn=1)

        # PS should NOT have triggered (genwaku blocked)
        self.assertNotIn(ZETTAI_MAKENAI, execution_log,
                         f"PS should not trigger during genwaku. Log: {execution_log}")

        # AS count should be 3 (2 pre-set + 1)
        as_count = unit_a.skill_use_count.get(AS_SKILL, 0)
        self.assertEqual(as_count, 3,
                         f"AS count should be 3 after AS use. skill_use_count={dict(unit_a.skill_use_count)}")

        # 2. Expire genwaku
        controller._process_aura_expiry(unit_a)
        self.assertFalse(unit_a.is_genwaku,
                         "Genwaku should have expired")

        # Reset cooldown so AS is usable if needed
        unit_a.skill_cooldowns = {}

        # 3. Set EP to full so select_skill picks EX skill
        unit_a.current_ep = unit_a.max_extra_point

        # 4. Execute action - should pick EX skill (EP full)
        controller._execute_unit_action(unit_a, turn=2)

        # EX skill should have been used
        self.assertIn(EX_SKILL, execution_log,
                      f"EX skill should be used when EP is full. Log: {execution_log}")

        # PS should NOT have triggered (EX skill does not trigger skill_use_count)
        self.assertNotIn(ZETTAI_MAKENAI, execution_log,
                         f"PS should NOT trigger after EX skill use. Log: {execution_log}")

    def test_as_skill_still_triggers_skill_count_ps(self):
        """AS技能使用后仍应正常触发 on_skill_use_count 类PS（回归验证）。"""
        bf, unit_a, unit_b, controller = self._setup_battle(ep=0, max_ep=10, pp=4)
        execution_log = self._record_executions(controller)

        # No genwaku, no EP - AS skill should be selected
        controller._execute_unit_action(unit_a, turn=1)

        # AS skill used
        self.assertIn(AS_SKILL, execution_log,
                      f"AS skill should be used. Log: {execution_log}")

        # PS should trigger (count=3, 3>=3)
        self.assertIn(ZETTAI_MAKENAI, execution_log,
                      f"PS should trigger after AS skill use (count=3>=3). Log: {execution_log}")


if __name__ == '__main__':
    unittest.main()
