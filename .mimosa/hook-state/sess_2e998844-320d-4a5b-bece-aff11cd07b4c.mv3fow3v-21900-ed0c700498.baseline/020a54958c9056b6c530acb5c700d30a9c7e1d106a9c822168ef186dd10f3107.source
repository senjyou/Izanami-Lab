#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""あったかいの、どうぞ♪ (110069/210102) 追加伤害buff共存テスト

Bug シナリオ:
- スキル「あったかいの、どうぞ♪」を同じユニットに複数回付与した際、
  追加伤害(ADD_DAMAGE)buffが上書きされてしまい、共存できない
- 正しい動作: 複数回付与された追加伤害buffは共存し、それぞれの付与時の
  キャスター攻撃力スナップショット(caster_attack)を使用して独立にダメージ計算する
- 処理順序: 先に付与されたbuffから先に処理される

修正内容: skill_effects_hybrid.json の 110069/210102 の add_damage effect に
          "stackable": true を追加し、buff_id が一意になるようにする
"""

import unittest
import sys
import os
import json

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.skill_service import SkillService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.trigger_service import TriggerService


class TestAddDamageCoexistenceConfig(unittest.TestCase):
    """設定ファイルの stackable:true フラグ検証"""

    def test_110069_block1_add_damage_has_stackable(self):
        """110069(己方) Block1 の add_damage に stackable:true があることを確認"""
        config_path = os.path.join(os.path.dirname(__file__), '..', '..',
                                   'data', 'skill_effects_hybrid.json')
        with open(config_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        skill = data['110069']
        block1 = skill['effect_blocks'][0]
        add_damage_effects = [e for e in block1['effects'] if e['effect_type'] == 'add_damage']
        self.assertEqual(len(add_damage_effects), 1, "Block1 should have 1 add_damage effect")
        self.assertTrue(add_damage_effects[0]['flags'].get('stackable', False),
                        "Block1 add_damage must have stackable:true")

    def test_110069_block2_add_damage_has_stackable(self):
        """110069(己方) Block2 の add_damage に stackable:true があることを確認"""
        config_path = os.path.join(os.path.dirname(__file__), '..', '..',
                                   'data', 'skill_effects_hybrid.json')
        with open(config_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        skill = data['110069']
        block2 = skill['effect_blocks'][1]
        add_damage_effects = [e for e in block2['effects'] if e['effect_type'] == 'add_damage']
        self.assertEqual(len(add_damage_effects), 1, "Block2 should have 1 add_damage effect")
        self.assertTrue(add_damage_effects[0]['flags'].get('stackable', False),
                        "Block2 add_damage must have stackable:true")

    def test_210102_block1_add_damage_has_stackable(self):
        """210102(敌方) Block1 の add_damage に stackable:true があることを確認"""
        config_path = os.path.join(os.path.dirname(__file__), '..', '..',
                                   'data', 'skill_effects_hybrid.json')
        with open(config_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        skill = data['210102']
        block1 = skill['effect_blocks'][0]
        add_damage_effects = [e for e in block1['effects'] if e['effect_type'] == 'add_damage']
        self.assertEqual(len(add_damage_effects), 1, "Block1 should have 1 add_damage effect")
        self.assertTrue(add_damage_effects[0]['flags'].get('stackable', False),
                        "Block1 add_damage must have stackable:true")

    def test_210102_block2_add_damage_has_stackable(self):
        """210102(敌方) Block2 の add_damage に stackable:true があることを確認"""
        config_path = os.path.join(os.path.dirname(__file__), '..', '..',
                                   'data', 'skill_effects_hybrid.json')
        with open(config_path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        skill = data['210102']
        block2 = skill['effect_blocks'][1]
        add_damage_effects = [e for e in block2['effects'] if e['effect_type'] == 'add_damage']
        self.assertEqual(len(add_damage_effects), 1, "Block2 should have 1 add_damage effect")
        self.assertTrue(add_damage_effects[0]['flags'].get('stackable', False),
                        "Block2 add_damage must have stackable:true")


class TestAddDamageCoexistenceAndProcessing(unittest.TestCase):
    """追加伤害buffの共存と独立ダメージ処理の検証"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _build_bf(self):
        """构建场景: holder 持有两个 ADD_DAMAGE buff(不同caster_attack), 攻击 enemy"""
        self.bf = BattlefieldState()

        # holder: 持有 ADD_DAMAGE buff, 使用 120068(2hit EN攻撃)
        self.holder = UnitState(
            unit_id="holder", name="Holder", side=Side.ALLY,
            position=Position.ALLY_CENTER_FRONT, character_id=117302, level=15,
            element=3, character_type=2,
            max_hp=148105, current_hp=148105,
            attack=100000, defense=50000, speed=1000,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=100,
            current_ap=10, current_pp=10, current_ep=100,
            skills=[120068], skill_levels={120068: 15},
            skill_cooldowns={},
        )

        # enemy: 高HP目标
        self.enemy = UnitState(
            unit_id="enemy", name="Enemy", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999002, level=200,
            element=1, character_type=1,
            max_hp=100000000, current_hp=100000000,
            attack=51726, defense=1000, speed=500,
            crit_rate=0.0, crit_damage=0.0, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=0,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.add_unit(self.holder)
        self.bf.add_unit(self.enemy)

        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        asvc = AuraService()
        dmgsvc = DamageService()
        tgtsvc = TargetService()
        stsvc = StatusService()
        self.ss = SkillService(self.dl, rs, target_service=tgtsvc,
                               damage_service=dmgsvc, aura_service=asvc,
                               status_service=stsvc, trigger_service=ts)
        ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)
        self.damage_service = dmgsvc

        # 手動で2つの ADD_DAMAGE buff を holder に付与(異なる caster_attack)
        # buff1: caster_attack=50000 (先に付与)
        # buff2: caster_attack=80000 (後に付与)
        self.buff1_atk = 50000
        self.buff2_atk = 80000
        self.add_damage_power = 15.0  # 15% (Lv15時のdmg tag値)

        buff1 = BuffState(
            buff_id="caster_110069_ADD_DAMAGE_holder_abc12345",
            name="追加ダメージ",
            effect_type=SkillEffectType.ADD_DAMAGE.value,
            value=self.add_damage_power,
            duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="caster1",
            source_skill_id=110069,
            caster_attack=self.buff1_atk,
            is_debuff=False,
            is_stackable=True,
            value_tag=0,
        )
        buff2 = BuffState(
            buff_id="caster_110069_ADD_DAMAGE_holder_def67890",
            name="追加ダメージ",
            effect_type=SkillEffectType.ADD_DAMAGE.value,
            value=self.add_damage_power,
            duration=-1,
            timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
            source_unit_id="caster2",
            source_skill_id=110069,
            caster_attack=self.buff2_atk,
            is_debuff=False,
            is_stackable=True,
            value_tag=0,
        )
        self.holder.buffs.append(buff1)
        self.holder.buffs.append(buff2)

    def test_two_add_damage_buffs_coexist(self):
        """2つの ADD_DAMAGE buff が holder 上に共存していることを確認"""
        self._build_bf()
        add_damage_buffs = [b for b in self.holder.buffs
                            if b.effect_type == SkillEffectType.ADD_DAMAGE.value]
        self.assertEqual(len(add_damage_buffs), 2,
                         "2つのADD_DAMAGE buffが共存すべき（stackable=trueにより上書きされない）")

    def test_each_buff_has_different_caster_attack(self):
        """各 ADD_DAMAGE buff が異なる caster_attack スナップショットを持つことを確認"""
        self._build_bf()
        add_damage_buffs = [b for b in self.holder.buffs
                            if b.effect_type == SkillEffectType.ADD_DAMAGE.value]
        self.assertEqual(len(add_damage_buffs), 2)
        attacks = {b.caster_attack for b in add_damage_buffs}
        self.assertEqual(len(attacks), 2,
                         "各buffのcaster_attackは異なるべき（各自のスナップショット）")
        self.assertIn(self.buff1_atk, attacks)
        self.assertIn(self.buff2_atk, attacks)

    def test_both_buffs_process_damage_independently(self):
        """攻撃時に両方の ADD_DAMAGE buff が独立してダメージ処理されることを確認

        新API: _prepare_enchant_buffs_for_damage_effect + _process_enchant_damage_for_target
              + _finalize_enchant_buffs_after_damage_effect + _apply_block_enchant_damage
        （旧API _process_enchant_damage はper-targetリファクタリングで廃止）
        """
        self._build_bf()

        # _prepare_enchant_buffs_for_damage_effect をラップして add_damage_buffs を記録
        original_prepare = self.ss._prepare_enchant_buffs_for_damage_effect
        captured_add_damage_buffs = []

        def wrapped_prepare(caster):
            sub_unit_buffs, add_damage_buffs, enchant_buffs, carried_debuff_buffs = original_prepare(caster)
            captured_add_damage_buffs.extend(add_damage_buffs)
            return sub_unit_buffs, add_damage_buffs, enchant_buffs, carried_debuff_buffs

        self.ss._prepare_enchant_buffs_for_damage_effect = wrapped_prepare

        # _apply_block_enchant_damage をラップして enchant_targets を記録
        original_apply = self.ss._apply_block_enchant_damage
        captured_enchant_targets = []

        def wrapped_apply(caster, targets_hit, battlefield, total_damage):
            results = original_apply(caster, targets_hit, battlefield, total_damage)
            if results:
                for r in results:
                    if r.get("effect_type") == "damage":
                        captured_enchant_targets.extend(r.get("targets", []))
            return results

        self.ss._apply_block_enchant_damage = wrapped_apply

        # 暴撃を無効化（ダメージ計算を単純化）
        self.damage_service._crit_override_func = lambda ctx: False

        enemy_hp_before = self.enemy.current_hp

        result = self.ss.execute_skill(
            caster=self.holder,
            skill_id=120068,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"], f"技能执行应成功: {result.get('error', '')}")

        # _prepare_enchant_buffs_for_damage_effect が呼ばれ、2つの ADD_DAMAGE buff が処理されたことを確認
        self.assertEqual(len(captured_add_damage_buffs), 2,
                         "2つのADD_DAMAGE buffが処理されるべき")

        # 処理順序: 先に付与されたbuff(caster_attack=50000)が先に処理される
        self.assertEqual(captured_add_damage_buffs[0].caster_attack, self.buff1_atk,
                         "先に付与されたbuffが先に処理されるべき")
        self.assertEqual(captured_add_damage_buffs[1].caster_attack, self.buff2_atk,
                         "後に付与されたbuffが後に処理されるべき")

        # enchant_targets に2つの追加ダメージエントリが含まれることを確認
        add_damage_entries = [t for t in captured_enchant_targets
                              if "追加" in (t.get("modifiers", []) or [])]
        self.assertEqual(len(add_damage_entries), 2,
                         "追加ダメージのエントリが2つあるべき")

        # 各エントリの source_atk が異なることを確認
        source_atks = [t.get("calc_detail", {}).get("source_atk", 0)
                       for t in add_damage_entries]
        self.assertEqual(len(set(source_atks)), 2,
                         f"各エントリのsource_atkは異なるべき: {source_atks}")
        self.assertIn(self.buff1_atk, source_atks)
        self.assertIn(self.buff2_atk, source_atks)

        # 処理順序の確認: enchant_targets の順序 = 追加ダメージの処理順序
        self.assertEqual(source_atks[0], self.buff1_atk,
                         "先に付与されたbuffのダメージが先に処理されるべき")
        self.assertEqual(source_atks[1], self.buff2_atk,
                         "後に付与されたbuffのダメージが後に処理されるべき")

        # enemy HP が減少したことを確認（主ダメージ + 追加ダメージ×2）
        enemy_hp_after = self.enemy.current_hp
        total_damage_dealt = enemy_hp_before - enemy_hp_after
        self.assertGreater(total_damage_dealt, 0, "敵HPが減少すべき")

    def test_buffs_persist_after_attack(self):
        """hit_limited=0(無制限)の ADD_DAMAGE buff は攻撃後も消失しないことを確認"""
        self._build_bf()

        self.damage_service._crit_override_func = lambda ctx: False

        result = self.ss.execute_skill(
            caster=self.holder,
            skill_id=120068,
            battlefield=self.bf,
            skip_cost=True,
        )
        self.assertTrue(result["success"])

        # 攻撃後も2つの ADD_DAMAGE buff が残っていることを確認
        add_damage_buffs = [b for b in self.holder.buffs
                            if b.effect_type == SkillEffectType.ADD_DAMAGE.value]
        self.assertEqual(len(add_damage_buffs), 2,
                         "hit_limited=0のbuffは攻撃後も消失しないべき")


if __name__ == '__main__':
    unittest.main()
