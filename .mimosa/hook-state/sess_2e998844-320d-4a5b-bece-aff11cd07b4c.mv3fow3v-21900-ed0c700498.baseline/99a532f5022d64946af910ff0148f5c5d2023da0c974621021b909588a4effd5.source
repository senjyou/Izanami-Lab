#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
迁移SkillMaster.json到数据库

功能:
1. 迁移skills表（基础信息）
2. 迁移skill_tag_values表（Tag值）
3. 迁移skill_kind_changes表（AdditionalKinds）
"""

import sys
import json
import sqlite3
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent))

from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()

PROJECT_ROOT = Path(__file__).parent.parent
DB_FILE = PROJECT_ROOT / "db" / "skill_data.db"
SKILL_MASTER_FILE = PROJECT_ROOT / "split_data" / "SkillMaster.json"


def safe_get(data, key, default=None):
    """安全获取字典值"""
    return data.get(key, default)


def migrate_skills(conn, skills_data):
    """迁移技能基础信息"""
    cursor = conn.cursor()
    count = 0
    skipped = 0
    
    safe_print("\n[1/3] Migrating skills table...")
    total = len(skills_data)
    
    for i, skill in enumerate(skills_data, 1):
        skill_id = skill['Id']
        
        # 确定技能类型
        skill_type = skill.get('Type')
        if skill_type is None:
            safe_print(f"  Warning: Skill {skill_id} has no Type, skipping")
            skipped += 1
            continue
        
        # 提取Kind
        base_kind = skill.get('Kind', 1)
        
        # 提取基础信息
        name = skill.get('Name', '')
        resource_cost = skill.get('ResourceCost', 0)
        cool_time = skill.get('CoolTime', 0)
        cool_time_timing = skill.get('CoolTimeUpdateTiming')
        default_max_level = skill.get('DefaultMaxLevel', 10)
        
        # 目标配置
        display_target_type = skill.get('DisplayTargetType')
        display_target_range = skill.get('DisplayTargetRange')
        display_target_priority = skill.get('DisplayTargetPriority')
        
        # 根据Type分配cost
        cost_ap = 0
        cost_pp = 0
        cost_ep = 0
        
        if skill_type == 1:  # AS
            cost_ap = resource_cost
        elif skill_type == 2:  # PS
            cost_pp = resource_cost
        elif skill_type == 3:  # EX
            cost_ep = resource_cost
        
        try:
            cursor.execute("""
                INSERT OR REPLACE INTO skills
                (skill_id, name, skill_type_id, base_kind,
                 cost_ap, cost_pp, cost_ep,
                 cooldown_value, cooldown_timing,
                 default_max_level,
                 display_target_type, display_target_range, display_target_priority,
                 entry_status)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'pending')
            """, (
                skill_id, name, skill_type, base_kind,
                cost_ap, cost_pp, cost_ep,
                cool_time, cool_time_timing if cool_time_timing else 0,
                default_max_level,
                display_target_type, display_target_range, display_target_priority
            ))
            count += 1
            
            if count % 500 == 0:
                safe_print(f"  Processed {count}/{total} skills...")
                conn.commit()
                
        except Exception as e:
            safe_print(f"  Error inserting skill {skill_id}: {e}")
            skipped += 1
    
    conn.commit()
    safe_print(f"  Total: {count} skills migrated, {skipped} skipped")
    return count


def migrate_tag_values(conn, skills_data):
    """迁移技能Tag值"""
    cursor = conn.cursor()
    count = 0
    
    safe_print("\n[2/3] Migrating skill_tag_values table...")
    total = len(skills_data)
    
    for i, skill in enumerate(skills_data, 1):
        skill_id = skill['Id']
        template_tags = skill.get('TemplateTags', [])
        
        for tag in template_tags:
            tag_name = tag.get('TagName', '')
            interpolation_mode = tag.get('InterpolationMode', 1)
            values = tag.get('Values', [])
            
            for value_obj in values:
                level = value_obj.get('Level', 1)
                value = value_obj.get('Value', 0.0)
                
                try:
                    cursor.execute("""
                        INSERT OR REPLACE INTO skill_tag_values
                        (skill_id, tag_name, skill_level, tag_value, interpolation_mode)
                        VALUES (?, ?, ?, ?, ?)
                    """, (skill_id, tag_name, level, value, interpolation_mode))
                    count += 1
                except Exception as e:
                    safe_print(f"  Error inserting tag {tag_name} for skill {skill_id}: {e}")
        
        if (i % 500 == 0):
            safe_print(f"  Processed {i}/{total} skills...")
            conn.commit()
    
    conn.commit()
    safe_print(f"  Total: {count} tag values migrated")
    return count


def migrate_additional_kinds(conn, skills_data):
    """迁移AdditionalKinds"""
    cursor = conn.cursor()
    count = 0
    
    safe_print("\n[3/3] Migrating skill_kind_changes table...")
    total = len(skills_data)
    
    for i, skill in enumerate(skills_data, 1):
        skill_id = skill['Id']
        additional_kinds = skill.get('AdditionalKinds', [])
        
        for kind_obj in additional_kinds:
            level = kind_obj.get('Level', 1)
            kind_value = kind_obj.get('Value', 1)
            
            try:
                cursor.execute("""
                    INSERT OR REPLACE INTO skill_kind_changes
                    (skill_id, level, kind_value)
                    VALUES (?, ?, ?)
                """, (skill_id, level, kind_value))
                count += 1
            except Exception as e:
                safe_print(f"  Error inserting kind change for skill {skill_id}: {e}")
        
        if (i % 500 == 0 and count > 0):
            safe_print(f"  Processed {i}/{total} skills...")
            conn.commit()
    
    conn.commit()
    safe_print(f"  Total: {count} kind changes migrated")
    return count


def main():
    """主函数"""
    safe_print("="*80)
    safe_print("Migrating SkillMaster.json to Database")
    safe_print("="*80)
    
    # 加载JSON数据
    safe_print(f"\nLoading data from: {SKILL_MASTER_FILE}")
    with open(SKILL_MASTER_FILE, 'r', encoding='utf-8') as f:
        skills_data = json.load(f)
    
    safe_print(f"Loaded {len(skills_data)} skills")
    
    # 连接数据库
    safe_print(f"\nConnecting to database: {DB_FILE}")
    conn = sqlite3.connect(DB_FILE)
    
    # 执行迁移
    skills_count = migrate_skills(conn, skills_data)
    tag_count = migrate_tag_values(conn, skills_data)
    kind_count = migrate_additional_kinds(conn, skills_data)
    
    # 验证
    safe_print("\n" + "="*80)
    safe_print("Migration Summary")
    safe_print("="*80)
    
    cursor = conn.cursor()
    
    cursor.execute("SELECT COUNT(*) FROM skills")
    db_skills = cursor.fetchone()[0]
    
    cursor.execute("SELECT COUNT(*) FROM skill_tag_values")
    db_tags = cursor.fetchone()[0]
    
    cursor.execute("SELECT COUNT(*) FROM skill_kind_changes")
    db_kinds = cursor.fetchone()[0]
    
    safe_print(f"Skills:         {db_skills}")
    safe_print(f"Tag Values:     {db_tags}")
    safe_print(f"Kind Changes:   {db_kinds}")
    
    # 示例查询
    safe_print("\n" + "-"*80)
    safe_print("Sample: Skill 110018")
    safe_print("-"*80)
    
    cursor.execute("SELECT * FROM skills WHERE skill_id = 110018")
    row = cursor.fetchone()
    if row:
        safe_print(f"Name: {row[1]}")
        safe_print(f"Type: {row[4]}")
        safe_print(f"Kind: {row[5]}")
        safe_print(f"Cost: AP={row[6]}, PP={row[7]}, EP={row[8]}")
    
    cursor.execute("SELECT tag_name, COUNT(*) FROM skill_tag_values WHERE skill_id = 110018 GROUP BY tag_name")
    tags = cursor.fetchall()
    if tags:
        safe_print("\nTag Values:")
        for tag_name, count in tags:
            safe_print(f"  {tag_name}: {count} levels")
    
    conn.close()
    
    safe_print("\n" + "="*80)
    safe_print("Migration complete!")
    safe_print("="*80)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        safe_print(f"\nERROR: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)
