#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
真夏の風紀委員長 (142302) 技能実装テスト

検証対象:
1. damage_base=consume_hp (120156)
2. hp_ratio_dynamic 動的減傷 (130155)
3. target_hp_ratio_higher_than_self 条件増傷 (130155 Lv11+)
4. cheat_death 多段耐久 (110070 Lv11-15)
5. BuffState新規フィールド
"""

import pytest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.enums import SkillEffectType, Side, Position
from src.combat_v2.services.damage_service import DamageService


def make_ally(unit_id="ally", hp=10000, atk=500, defense=100, speed=100, crit_rate=0.0, element=1, character_type=2):
    return UnitState(
        unit_id=unit_id, name=unit_id, side=Side.ALLY,
        position=Position.ALLY_LEFT_FRONT, character_id=999901, level=15,
        element=element, character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=50.0, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=5, current_pp=5, current_ep=0,
    )


def make_enemy(unit_id="enemy", hp=10000, atk=300, defense=200, speed=80, crit_rate=0.0, element=1, character_type=1):
    return UnitState(
        unit_id=unit_id, name=unit_id, side=Side.ENEMY,
        position=Position.ENEMY_LEFT_FRONT, character_id=999001, level=15,
        element=element, character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=crit_rate, crit_damage=50.0, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=5, current_pp=5, current_ep=0,
    )


class TestDamageBaseConsumeHp:
    """damage_base=consume_hp のテスト"""

    def test_consume_hp_damage_calculation(self):
        """消費HPをベースとしたダメージ計算"""
        damage_service = DamageService()
        attacker = make_ally(hp=8500)
        attacker.last_consumed_hp = 1500
        defender = make_enemy(hp=10000, element=2)

        skill_data = type('obj', (object,), {
            'power': 150.0, 'hit_count': 1, 'element': 1,
            'ignore_defense': 0, 'ignore_shield': 0, 'hp_scaling_bonus': 0,
            'cannot_crit': True, 'bonus_crit_rate': 0.0,
            'skill_id': 120156, 'name': "test",
            'base_value_source': 'consume_hp',
        })()

        result = damage_service.calculate_damage(attacker, defender, skill_data)
        assert result.calc_detail['base_diff'] == 1500
        assert result.total_damage >= 2250

    def test_consume_hp_minimum_damage(self):
        """消費HP=0でも最低1ダメージ"""
        damage_service = DamageService()
        attacker = make_ally()
        attacker.last_consumed_hp = 0
        defender = make_enemy()

        skill_data = type('obj', (object,), {
            'power': 150.0, 'hit_count': 1, 'element': 1,
            'ignore_defense': 0, 'ignore_shield': 0, 'hp_scaling_bonus': 0,
            'cannot_crit': True, 'bonus_crit_rate': 0.0,
            'skill_id': 120156, 'name': "test",
            'base_value_source': 'consume_hp',
        })()

        result = damage_service.calculate_damage(attacker, defender, skill_data)
        assert result.calc_detail['base_diff'] == 1
        assert result.total_damage >= 1


class TestHpRatioDynamic:
    """hp_ratio_dynamic 動的減傷のテスト"""

    def _make_unit_with_dynamic_buff(self, hp, max_hp=10000, buff_value=50):
        unit = make_ally(hp=max_hp)
        unit.current_hp = hp
        buff = BuffState(
            buff_id="test_dmg_taken_down", name="dmg_taken_down",
            effect_type=SkillEffectType.RECEIVED_DAMAGE.value,
            value=buff_value, duration=-1, timing_type=2,
            is_debuff=False, is_stackable=True, value_tag=0,
        )
        buff.hp_ratio_dynamic = True
        unit.buffs.append(buff)
        return unit

    def test_dynamic_reduction_full_hp(self):
        """満血時は減衰0%"""
        ds = DamageService()
        unit = self._make_unit_with_dynamic_buff(hp=10000)
        mult = ds._get_damage_received_multiplier(unit, damage_element=0)
        assert mult == pytest.approx(1.0, abs=0.01)

    def test_dynamic_reduction_70pct_hp(self):
        """HP70%時は減衰25%（max50%の半分）"""
        ds = DamageService()
        unit = self._make_unit_with_dynamic_buff(hp=7000)
        mult = ds._get_damage_received_multiplier(unit, damage_element=0)
        assert mult == pytest.approx(0.75, abs=0.01)

    def test_dynamic_reduction_40pct_hp(self):
        """HP40%時は最大減衰50%"""
        ds = DamageService()
        unit = self._make_unit_with_dynamic_buff(hp=4000)
        mult = ds._get_damage_received_multiplier(unit, damage_element=0)
        assert mult == pytest.approx(0.50, abs=0.01)

    def test_dynamic_reduction_below_40pct_hp(self):
        """HP40%以下でも最大減衰50%を維持"""
        ds = DamageService()
        unit = self._make_unit_with_dynamic_buff(hp=2000)
        mult = ds._get_damage_received_multiplier(unit, damage_element=0)
        assert mult == pytest.approx(0.50, abs=0.01)

    def test_dynamic_reduction_with_physical_element(self):
        """damage_element=1(物理)の場合もhp_ratio_dynamicが正しく適用される
        回帰テスト: _aggregate_buff_value_signed_filteredがunit参数を伝達していなかったbug
        """
        ds = DamageService()
        unit = self._make_unit_with_dynamic_buff(hp=7000)
        mult = ds._get_damage_received_multiplier(unit, damage_element=1)
        assert mult == pytest.approx(0.75, abs=0.01)

    def test_dynamic_reduction_with_en_element(self):
        """damage_element=2(EN)の場合もhp_ratio_dynamicが正しく適用される"""
        ds = DamageService()
        unit = self._make_unit_with_dynamic_buff(hp=4000)
        mult = ds._get_damage_received_multiplier(unit, damage_element=2)
        assert mult == pytest.approx(0.50, abs=0.01)


class TestTargetHpRatioHigherThanSelf:
    """target_hp_ratio_higher_than_self 条件増傷のテスト"""

    def _make_attacker_with_buff(self, hp, max_hp=10000):
        attacker = make_ally(hp=max_hp)
        attacker.current_hp = hp
        buff = BuffState(
            buff_id="test_dmg_dealt_up", name="dmg_dealt_up",
            effect_type=SkillEffectType.DEALT_DAMAGE.value,
            value=10, duration=-1, timing_type=2,
            is_debuff=False, is_stackable=True, value_tag=0,
        )
        buff.target_hp_ratio_higher_than_self = True
        attacker.buffs.append(buff)
        return attacker

    def _make_defender(self, hp, max_hp=10000):
        defender = make_enemy(hp=max_hp)
        defender.current_hp = hp
        return defender

    def test_buff_applies_when_target_hp_higher(self):
        """対象HP割合が自身より高い場合は増傷適用"""
        ds = DamageService()
        attacker = self._make_attacker_with_buff(hp=5000)
        defender = self._make_defender(hp=8000)
        mult = ds._get_damage_dealt_multiplier(attacker, defender, damage_element=0)
        assert mult == pytest.approx(1.10, abs=0.01)

    def test_buff_skipped_when_target_hp_lower(self):
        """対象HP割合が自身より低い場合は増傷不適用"""
        ds = DamageService()
        attacker = self._make_attacker_with_buff(hp=8000)
        defender = self._make_defender(hp=5000)
        mult = ds._get_damage_dealt_multiplier(attacker, defender, damage_element=0)
        assert mult == pytest.approx(1.0, abs=0.01)

    def test_buff_skipped_when_target_hp_equal(self):
        """対象HP割合が自身と同じ場合は増傷不適用（> not >=）"""
        ds = DamageService()
        attacker = self._make_attacker_with_buff(hp=7000)
        defender = self._make_defender(hp=7000)
        mult = ds._get_damage_dealt_multiplier(attacker, defender, damage_element=0)
        assert mult == pytest.approx(1.0, abs=0.01)


class TestCheatDeathMultiHit:
    """cheat_death 多段耐久のテスト"""

    def _process_cheat_death(self, unit):
        """skill_service.py:3264-3279 のcheat_death処理をシミュレート"""
        cheat_death_buffs = [b for b in unit.buffs if b.effect_type in ("cheat_death", "CheatDeath")]
        if cheat_death_buffs:
            heal_pct = max(b.value for b in cheat_death_buffs)
            unit.current_hp = max(1, int(unit.max_hp * heal_pct / 100))
            multi_hit_buffs = [b for b in cheat_death_buffs if b.stack_count > 1]
            if multi_hit_buffs:
                for b in multi_hit_buffs:
                    b.stack_count -= 1
            else:
                unit.buffs = [b for b in unit.buffs if b.effect_type not in ("cheat_death", "CheatDeath")]

    def test_cheat_death_stack_count_decrement(self):
        """stack_count>1の時、致死ダメージでstack_countが減少"""
        buff = BuffState(
            buff_id="test_cheat_death", name="cheat_death",
            effect_type="cheat_death", value=0, duration=2,
            timing_type=2, is_debuff=False, stack_count=3,
        )
        unit = make_ally(hp=10000)
        unit.current_hp = 0
        unit.buffs.append(buff)

        self._process_cheat_death(unit)

        assert unit.current_hp == 1
        assert buff.stack_count == 2
        assert buff in unit.buffs

    def test_cheat_death_stack_count_removal(self):
        """stack_count=1の時、致死ダメージでbuffが削除"""
        buff = BuffState(
            buff_id="test_cheat_death", name="cheat_death",
            effect_type="cheat_death", value=0, duration=2,
            timing_type=2, is_debuff=False, stack_count=1,
        )
        unit = make_ally(hp=10000)
        unit.current_hp = 0
        unit.buffs.append(buff)

        self._process_cheat_death(unit)

        assert unit.current_hp == 1
        assert buff not in unit.buffs

    def test_cheat_death_hp1_when_value_zero(self):
        """value=0の場合、HP1で生存"""
        buff = BuffState(
            buff_id="test_cheat_death", name="cheat_death",
            effect_type="cheat_death", value=0, duration=2,
            timing_type=2, is_debuff=False, stack_count=5,
        )
        unit = make_ally(hp=10000)
        unit.current_hp = 0
        unit.buffs.append(buff)

        self._process_cheat_death(unit)

        assert unit.current_hp == 1

    def test_cheat_death_multi_hit_sequence(self):
        """5段cheat_death: 5回致死ダメージまで生存、6回目で倒下"""
        buff = BuffState(
            buff_id="test_cheat_death", name="cheat_death",
            effect_type="cheat_death", value=0, duration=2,
            timing_type=2, is_debuff=False, stack_count=5,
        )
        unit = make_ally(hp=10000)
        unit.buffs.append(buff)

        # 5回の致死ダメージを耐える
        for i in range(5):
            unit.current_hp = 0
            self._process_cheat_death(unit)
            assert unit.current_hp == 1, f"Hit {i+1}: should survive at HP1"

        # buff should be removed after 5th hit (stack_count went 5->4->3->2->1->removed)
        assert buff not in unit.buffs

        # 6回目の致死ダメージで倒下（cheat_death無し）
        unit.current_hp = 0
        cheat_death_buffs = [b for b in unit.buffs if b.effect_type in ("cheat_death", "CheatDeath")]
        assert not cheat_death_buffs  # No cheat_death buff remaining


class TestBuffStateFields:
    """BuffStateの新しいフィールドが正しく初期化されることをテスト"""

    def test_hp_ratio_dynamic_default_false(self):
        buff = BuffState(buff_id="t", name="t", effect_type="t", value=10, duration=-1, timing_type=2)
        assert buff.hp_ratio_dynamic == False

    def test_target_hp_ratio_higher_default_false(self):
        buff = BuffState(buff_id="t", name="t", effect_type="t", value=10, duration=-1, timing_type=2)
        assert buff.target_hp_ratio_higher_than_self == False

    def test_hp_ratio_dynamic_settable(self):
        buff = BuffState(buff_id="t", name="t", effect_type="t", value=10, duration=-1, timing_type=2)
        buff.hp_ratio_dynamic = True
        assert buff.hp_ratio_dynamic == True

    def test_target_hp_ratio_higher_settable(self):
        buff = BuffState(buff_id="t", name="t", effect_type="t", value=10, duration=-1, timing_type=2)
        buff.target_hp_ratio_higher_than_self = True
        assert buff.target_hp_ratio_higher_than_self == True
