#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
查询原始技能数据脚本
"""

import sys
import json
import argparse
from pathlib import Path

# 添加项目根目录到Python路径
sys.path.insert(0, str(Path(__file__).parent.parent))

# 导入编码工具
from src.utils.encoding_utils import setup_console_encoding, safe_print

setup_console_encoding()

def load_json(path):
    with open(path, 'r', encoding='utf-8') as f:
        return json.load(f)

def main():
    parser = argparse.ArgumentParser(description='Query raw skill data')
    parser.add_argument('--id', type=int, required=True, help='Character ID')
    parser.add_argument('--output', type=str, help='Output file path')
    args = parser.parse_args()
    
    char_id = args.id
    
    base_dir = Path(__file__).parent.parent
    char_skill_path = base_dir / 'split_data' / 'CharacterSkillMaster.json'
    skill_master_path = base_dir / 'split_data' / 'SkillMaster.json'
    
    char_skills = load_json(char_skill_path)
    skill_master = load_json(skill_master_path)
    
    # Find skill IDs
    target_skill_ids = []
    for entry in char_skills:
        if entry.get('CharacterMasterId') == char_id:
            target_skill_ids.append(entry.get('SkillMasterId'))
            
    if not target_skill_ids:
        safe_print(f"未找到角色 {char_id} 的技能信息")
        return

    safe_print(f"角色 {char_id} 的技能列表: {target_skill_ids}")
    
    # Extract skill data
    results = []
    skill_map = {s['Id']: s for s in skill_master}
    
    for sid in target_skill_ids:
        if sid in skill_map:
            results.append(skill_map[sid])
        else:
            safe_print(f"Warning: Skill {sid} not found in SkillMaster")

    # Output
    if args.output:
        with open(args.output, 'w', encoding='utf-8') as f:
            json.dump(results, f, ensure_ascii=False, indent=2)
        safe_print(f"Data written to {args.output}")
    else:
        print(json.dumps(results, ensure_ascii=False, indent=2))

if __name__ == "__main__":
    main()
