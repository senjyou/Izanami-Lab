def migrate_module_tiers(conn: sqlite3.Connection):
    """ """
    safe_print("\n   ...")
    
    data = load_json(DATA_DIR / "module_status.json")
    
    cursor = conn.cursor()
    count = 0
    
    for mod_id_str, tiers in data.items():
        module_id = int(mod_id_str)
        
        for tier_str, tier_data in tiers.items():
            cursor.execute("""
                INSERT OR REPLACE INTO module_tiers 
                (module_id, tier, 
                 hp_base, attack_base, defense_base,
                 hp_per_level, attack_per_level, defense_per_level,
                 hp_rate, attack_rate, defense_rate)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
            """, (
                module_id,
                tier_data['tier'],
                tier_data['hp_base'],
                tier_data['attack_base'],
                tier_data['defense_base'],
                tier_data['hp_per_level'],
                tier_data['attack_per_level'],
                tier_data['defense_per_level'],
                tier_data['hp_rate'],
                tier_data['attack_rate'],
                tier_data['defense_rate']
            ))
            count += 1
    
    conn.commit()
    safe_print(f"    {count}  ")


