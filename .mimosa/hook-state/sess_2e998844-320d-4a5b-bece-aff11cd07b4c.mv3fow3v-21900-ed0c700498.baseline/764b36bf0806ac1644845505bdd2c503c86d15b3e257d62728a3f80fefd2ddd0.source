#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
 
 JSON SQLite 
"""

import sys
import json
import sqlite3
from pathlib import Path
from typing import Dict, Any

#  
def safe_print(text: str):
    """ Unicode """
    try:
        print(text)
    except UnicodeEncodeError:
        print(text.encode('utf-8', errors='replace').decode('utf-8'))

#  
PROJECT_ROOT = Path(__file__).parent.parent
DATA_DIR = PROJECT_ROOT / "data"
SPLIT_DATA_DIR = PROJECT_ROOT / "split_data"
DB_DIR = PROJECT_ROOT / "db"
SQL_SCRIPT = PROJECT_ROOT / "scripts" / "db" / "init_character_stats_db.sql"
DB_FILE = DB_DIR / "character_stats.db"


def load_json(file_path: Path) -> Dict[str, Any]:
    """ JSON """
    print(f"[LOAD] {file_path.name}")
    with open(file_path, 'r', encoding='utf-8') as f:
        return json.load(f)


def initialize_database(conn: sqlite3.Connection):
    """ SQL """
    print("[INIT] Database structure...")
    
    with open(SQL_SCRIPT, 'r', encoding='utf-8') as f:
        sql_script = f.read()
    
    conn.executescript(sql_script)
    conn.commit()
    print("[OK] Database initialized")


def migrate_level_lerp(conn: sqlite3.Connection):
    """ """
    safe_print("\n   ...")
    
    data = load_json(DATA_DIR / "level_lerp.json")
    
    cursor = conn.cursor()
    count = 0
    
    for level_str, coefficient in data.items():
        level = int(level_str)
        cursor.execute(
            "INSERT OR REPLACE INTO level_lerp_coefficients (level, lerp_coefficient) VALUES (?, ?)",
            (level, coefficient)
        )
        count += 1
    
    conn.commit()
    safe_print(f"    {count}  ")


def migrate_equipment(conn: sqlite3.Connection):
    """ """
    safe_print("\n   ...")
    
    data = load_json(DATA_DIR / "equipment.json")
    
    cursor = conn.cursor()
    count = 0
    
    for eq_id_str, eq_data in data.items():
        cursor.execute("""
            INSERT OR REPLACE INTO equipment 
            (equipment_id, name, character_type, equipment_type, 
             hp_bonus, attack_bonus, defense_bonus, description)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            eq_data['equipment_id'],
            eq_data['name'],
            eq_data['character_type'],
            eq_data['equipment_type'],
            eq_data['hp_bonus'],
            eq_data['attack_bonus'],
            eq_data['defense_bonus'],
            eq_data['description']
        ))
        count += 1
    
    conn.commit()
    safe_print(f"    {count}  ")


