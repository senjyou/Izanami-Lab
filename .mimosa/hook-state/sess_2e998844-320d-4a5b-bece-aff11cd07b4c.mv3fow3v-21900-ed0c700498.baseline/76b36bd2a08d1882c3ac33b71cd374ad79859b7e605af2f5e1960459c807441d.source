"""Unit tests for stealth (ステルス) mechanism in TargetService.

Tests cover:
- _has_stealth: detect stealth buff on unit (alive/dead/no buff/expired duration)
- _consume_stealth: action-based (no consume) vs skill-based (consume duration)
- apply_stealth_redirection:
  * No stealth in candidates → no change
  * First-priority has stealth → moved to end
  * Chained triggers (multiple stealth units)
  * triggered set prevents infinite loop (single unit with duration>1)
  * consume=False (prescan) doesn't consume duration
  * Single candidate also triggers
  * Append (not remove) — stealth unit remains in list at lowest priority
- select_min_with_stealth / select_max_with_stealth
- Edge cases: dead unit with stealth, multiple stealth buffs on one unit
"""
import sys
import os
import unittest

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', '..'))

from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming
from src.combat_v2.services.target_service import TargetService


STEALTH = SkillEffectType.STEALTH.value


def _make_unit(unit_id, name, side, position, *, hp=50000, atk=10000,
               defense=4000, speed=500):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=2, character_type=1,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=0,
        current_ap=10, current_pp=10, current_ep=0,
        is_alive=True,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


def _make_stealth_buff(*, duration=1, duration_type='action', buff_id="stealth_1"):
    return BuffState(
        buff_id=buff_id,
        name="ステルス",
        effect_type=STEALTH,
        value=1.0,
        duration=duration,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id="",
        source_skill_id=0,
        is_debuff=False,
        original_duration_type=duration_type,
    )


# ═══════════════════════════════════════════════════════════════════════
# Part 1: _has_stealth
# ═══════════════════════════════════════════════════════════════════════

class TestHasStealth(unittest.TestCase):
    """_has_stealth: detect stealth buff on unit."""

    def setUp(self):
        self.ts = TargetService()

    def test_no_buffs_returns_false(self):
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        self.assertFalse(self.ts._has_stealth(u))

    def test_with_stealth_buff_returns_true(self):
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        u.buffs.append(_make_stealth_buff(duration=1))
        self.assertTrue(self.ts._has_stealth(u))

    def test_stealth_buff_duration_zero_returns_false(self):
        """Stealth buff with duration=0 (expired) → not active."""
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        u.buffs.append(_make_stealth_buff(duration=0))
        self.assertFalse(self.ts._has_stealth(u))

    def test_dead_unit_returns_false(self):
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        u.buffs.append(_make_stealth_buff(duration=1))
        u.is_alive = False
        self.assertFalse(self.ts._has_stealth(u))

    def test_none_unit_returns_false(self):
        self.assertFalse(self.ts._has_stealth(None))

    def test_other_buff_type_returns_false(self):
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        u.buffs.append(BuffState(
            buff_id="b1", name="ATK_UP", effect_type="atk_up",
            value=10.0, duration=-1, timing_type=2,
        ))
        self.assertFalse(self.ts._has_stealth(u))

    def test_multiple_buffs_with_one_stealth_returns_true(self):
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        u.buffs.append(BuffState(
            buff_id="b1", name="ATK_UP", effect_type="atk_up",
            value=10.0, duration=-1, timing_type=2,
        ))
        u.buffs.append(_make_stealth_buff(duration=1, buff_id="stealth_2"))
        u.buffs.append(BuffState(
            buff_id="b3", name="DEF_UP", effect_type="def_up",
            value=10.0, duration=-1, timing_type=2,
        ))
        self.assertTrue(self.ts._has_stealth(u))


# ═══════════════════════════════════════════════════════════════════════
# Part 2: _consume_stealth
# ═══════════════════════════════════════════════════════════════════════

class TestConsumeStealth(unittest.TestCase):
    """_consume_stealth: action-based vs skill-based consumption."""

    def setUp(self):
        self.ts = TargetService()

    def test_action_based_does_not_consume_duration(self):
        """action-based stealth: trigger does NOT decrement duration."""
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        buff = _make_stealth_buff(duration=2, duration_type='action')
        u.buffs.append(buff)

        result = self.ts._consume_stealth(u)

        self.assertTrue(result, "should return True (triggered)")
        self.assertEqual(buff.duration, 2, "action-based: duration unchanged")

    def test_skill_based_consumes_duration(self):
        """skill-based stealth: trigger decrements duration by 1."""
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        buff = _make_stealth_buff(duration=2, duration_type='skill')
        u.buffs.append(buff)

        result = self.ts._consume_stealth(u)

        self.assertTrue(result)
        self.assertEqual(buff.duration, 1, "skill-based: duration 2→1")

    def test_skill_based_removes_buff_when_duration_reaches_zero(self):
        """skill-based stealth: duration→0 removes buff from unit.buffs."""
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        buff = _make_stealth_buff(duration=1, duration_type='skill')
        u.buffs.append(buff)

        self.ts._consume_stealth(u)

        self.assertEqual(buff.duration, 0)
        stealth_buffs = [b for b in u.buffs if b.effect_type == STEALTH]
        self.assertEqual(len(stealth_buffs), 0,
                         "buff should be removed from unit.buffs when duration=0")

    def test_unknown_duration_type_treated_as_action(self):
        """Unknown duration_type → treated as action (no consume)."""
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        buff = _make_stealth_buff(duration=2, duration_type='unknown')
        u.buffs.append(buff)

        result = self.ts._consume_stealth(u)

        self.assertTrue(result)
        self.assertEqual(buff.duration, 2, "unknown duration_type: duration unchanged")

    def test_no_stealth_buff_returns_false(self):
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        result = self.ts._consume_stealth(u)
        self.assertFalse(result)

    def test_expired_stealth_returns_false(self):
        """Stealth buff with duration=0 → not consumed, returns False."""
        u = _make_unit("u1", "U1", Side.ALLY, Position.ALLY_LEFT_FRONT)
        buff = _make_stealth_buff(duration=0, duration_type='action')
        u.buffs.append(buff)

        result = self.ts._consume_stealth(u)

        self.assertFalse(result, "expired stealth (duration=0) should not be consumed")


# ═══════════════════════════════════════════════════════════════════════
# Part 3: apply_stealth_redirection - basic behavior
# ═══════════════════════════════════════════════════════════════════════

class TestApplyStealthRedirectionBasic(unittest.TestCase):
    """apply_stealth_redirection: basic single-stealth scenarios."""

    def setUp(self):
        self.ts = TargetService()

    def test_no_stealth_in_candidates_no_change(self):
        """No stealth buff in candidates → no change to list."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        candidates = [u1, u2]

        redirected = self.ts.apply_stealth_redirection(candidates, consume=True)

        self.assertEqual(len(redirected), 0)
        self.assertEqual(candidates[0].unit_id, u1.unit_id,
                         "no stealth → order unchanged")
        self.assertEqual(candidates[1].unit_id, u2.unit_id)

    def test_first_priority_stealth_moved_to_end(self):
        """First-priority (index 0) stealth unit is moved to end of list."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u1.buffs.append(_make_stealth_buff(duration=1))
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        candidates = [u1, u2]

        redirected = self.ts.apply_stealth_redirection(candidates, consume=True)

        self.assertEqual(len(redirected), 1, "one unit redirected")
        self.assertEqual(candidates[0].unit_id, u2.unit_id,
                         "stealth unit moved to end → u2 is now first")
        self.assertEqual(candidates[1].unit_id, u1.unit_id,
                         "stealth unit is now at end")
        # Stealth buff consumed (action-based → duration unchanged)
        stealth_buffs = [b for b in u1.buffs if b.effect_type == STEALTH]
        self.assertEqual(len(stealth_buffs), 1, "action-based: buff NOT removed")

    def test_single_candidate_with_stealth_triggers(self):
        """Single candidate with stealth → triggers (moves to end = stays at index 0)
        but stealth is still consumed."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        buff = _make_stealth_buff(duration=1, duration_type='skill')
        u1.buffs.append(buff)
        candidates = [u1]

        redirected = self.ts.apply_stealth_redirection(candidates, consume=True)

        self.assertEqual(len(redirected), 1, "single candidate still triggers")
        # Single candidate: pop+append → still at index 0
        self.assertEqual(candidates[0].unit_id, u1.unit_id)
        # Skill-based: duration consumed (1→0, buff removed)
        stealth_buffs = [b for b in u1.buffs if b.effect_type == STEALTH]
        self.assertEqual(len(stealth_buffs), 0, "skill-based single: buff consumed")

    def test_stealth_unit_remains_in_list_at_lowest_priority(self):
        """Stealth unit is APPENDED (not removed) — still in list at lowest priority."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u1.buffs.append(_make_stealth_buff(duration=1))
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        u3 = _make_unit("u3", "U3", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)
        candidates = [u1, u2, u3]

        self.ts.apply_stealth_redirection(candidates, consume=True)

        # u1 should still be in candidates (at the end), not removed
        self.assertEqual(len(candidates), 3, "stealth unit should NOT be removed")
        self.assertEqual(candidates[-1].unit_id, u1.unit_id,
                         "stealth unit at end (lowest priority)")

    def test_consume_false_does_not_consume_duration_skill_based(self):
        """consume=False (prescan) → skill-based stealth duration NOT decremented."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        buff = _make_stealth_buff(duration=2, duration_type='skill')
        u1.buffs.append(buff)
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        candidates = [u1, u2]

        self.ts.apply_stealth_redirection(candidates, consume=False)

        self.assertEqual(buff.duration, 2,
                         "consume=False: duration unchanged even for skill-based")
        # Order still changed (prescan simulates redirection)
        self.assertEqual(candidates[0].unit_id, u2.unit_id)


# ═══════════════════════════════════════════════════════════════════════
# Part 4: apply_stealth_redirection - chained triggers
# ═══════════════════════════════════════════════════════════════════════

class TestApplyStealthRedirectionChained(unittest.TestCase):
    """apply_stealth_redirection: chained triggers (multiple stealth units)."""

    def setUp(self):
        self.ts = TargetService()

    def test_multiple_stealth_units_chain_trigger(self):
        """3 stealth units + 1 normal: all 3 stealth trigger, normal becomes primary."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u1.buffs.append(_make_stealth_buff(duration=1, buff_id="s1"))
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        u2.buffs.append(_make_stealth_buff(duration=1, buff_id="s2"))
        u3 = _make_unit("u3", "U3", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)
        u3.buffs.append(_make_stealth_buff(duration=1, buff_id="s3"))
        u4 = _make_unit("u4", "U4", Side.ENEMY, Position.ENEMY_LEFT_BACK)
        candidates = [u1, u2, u3, u4]

        redirected = self.ts.apply_stealth_redirection(candidates, consume=True)

        self.assertEqual(len(redirected), 3, "all 3 stealth units should trigger")
        # u4 (no stealth) should be at index 0 (new primary)
        self.assertEqual(candidates[0].unit_id, u4.unit_id,
                         "non-stealth unit should become new primary")
        # All stealth units moved to end
        stealth_ids = {u1.unit_id, u2.unit_id, u3.unit_id}
        actual_ids = {c.unit_id for c in candidates[1:]}
        self.assertEqual(actual_ids, stealth_ids,
                         "all stealth units at end of list")

    def test_all_stealth_units_chain_trigger_in_order(self):
        """All candidates have stealth → all trigger, original order preserved at end."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u1.buffs.append(_make_stealth_buff(duration=1, buff_id="s1"))
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        u2.buffs.append(_make_stealth_buff(duration=1, buff_id="s2"))
        u3 = _make_unit("u3", "U3", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)
        u3.buffs.append(_make_stealth_buff(duration=1, buff_id="s3"))
        candidates = [u1, u2, u3]

        redirected = self.ts.apply_stealth_redirection(candidates, consume=True)

        self.assertEqual(len(redirected), 3, "all 3 stealth units triggered")
        # All 3 still in list (appended), order: u1, u2, u3 → u2, u3, u1
        # (u1 pop+append, u2 pop+append, u3 pop+append → original cyclic shift)
        self.assertEqual(len(candidates), 3)

    def test_triggered_set_prevents_infinite_loop_duration_gt_1(self):
        """Single stealth unit with duration>1 should not loop infinitely.
        triggered set ensures each unit triggers only once per call.
        """
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        # action-based, duration=5 (won't decrement, so _has_stealth stays True)
        u1.buffs.append(_make_stealth_buff(duration=5, duration_type='action'))
        candidates = [u1]

        # This should NOT infinite loop
        redirected = self.ts.apply_stealth_redirection(candidates, consume=True)

        self.assertEqual(len(redirected), 1, "triggered once, then stopped")
        # Single candidate: pop+append → still at index 0
        self.assertEqual(candidates[0].unit_id, u1.unit_id)
        # action-based: duration unchanged
        self.assertEqual(u1.buffs[0].duration, 5)


# ═══════════════════════════════════════════════════════════════════════
# Part 5: select_min_with_stealth / select_max_with_stealth
# ═══════════════════════════════════════════════════════════════════════

class TestSelectWithStealth(unittest.TestCase):
    """select_min_with_stealth / select_max_with_stealth."""

    def setUp(self):
        self.ts = TargetService()

    def test_select_min_with_stealth_redirects_lowest_key_unit(self):
        """select_min: if lowest-key unit has stealth, redirect to next."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u1.buffs.append(_make_stealth_buff(duration=1))
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        u3 = _make_unit("u3", "U3", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)

        # key_func: by unit_id alphabetically (u1<u2<u3)
        # u1 has stealth → should be redirected, u2 becomes primary
        result = self.ts.select_min_with_stealth(
            [u1, u2, u3], key_func=lambda u: u.unit_id, consume=True)

        self.assertEqual(result.unit_id, u2.unit_id,
                         "u1 stealth → u2 (next lowest) selected")

    def test_select_max_with_stealth_redirects_highest_key_unit(self):
        """select_max: if highest-key unit has stealth, redirect to next."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        u3 = _make_unit("u3", "U3", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)
        u3.buffs.append(_make_stealth_buff(duration=1))

        # key_func: by unit_id alphabetically, max → u3
        # u3 has stealth → should be redirected, u2 becomes primary
        result = self.ts.select_max_with_stealth(
            [u1, u2, u3], key_func=lambda u: u.unit_id, consume=True)

        self.assertEqual(result.unit_id, u2.unit_id,
                         "u3 stealth → u2 (next highest) selected")

    def test_select_min_with_stealth_all_stealth_cycles_back_to_first(self):
        """select_min: all stealth → all triggered, cyclic shift returns to original first.

        Trace: [u1, u2] both stealth
        - u1 pop+append → [u2, u1], triggered={id(u1)}
        - u2 pop+append → [u1, u2], triggered={id(u1), id(u2)}
        - u1 in triggered → break
        Final: [u1, u2], returns u1
        """
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u1.buffs.append(_make_stealth_buff(duration=1))
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        u2.buffs.append(_make_stealth_buff(duration=1))

        result = self.ts.select_min_with_stealth(
            [u1, u2], key_func=lambda u: u.unit_id, consume=True)

        # Cyclic shift: both triggered, but order cycles back to original
        self.assertIsNotNone(result)
        self.assertEqual(result.unit_id, u1.unit_id,
                         "all stealth → cyclic shift returns to original first")

    def test_select_min_with_stealth_empty_candidates_returns_none(self):
        """select_min: empty candidates → None."""
        result = self.ts.select_min_with_stealth(
            [], key_func=lambda u: u.unit_id, consume=True)
        self.assertIsNone(result)

    def test_select_max_with_stealth_empty_candidates_returns_none(self):
        """select_max: empty candidates → None."""
        result = self.ts.select_max_with_stealth(
            [], key_func=lambda u: u.unit_id, consume=True)
        self.assertIsNone(result)


# ═══════════════════════════════════════════════════════════════════════
# Part 6: Edge cases
# ═══════════════════════════════════════════════════════════════════════

class TestApplyStealthEdgeCases(unittest.TestCase):
    """Edge cases for stealth mechanism."""

    def setUp(self):
        self.ts = TargetService()

    def test_dead_unit_at_first_position_not_redirected(self):
        """Dead unit at first position: _has_stealth returns False for dead → no redirect.
        However, dead unit at first position is still there (not skipped by this method).
        Note: callers should filter dead candidates before calling.
        """
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u1.buffs.append(_make_stealth_buff(duration=1))
        u1.is_alive = False  # dead unit with stealth
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        candidates = [u1, u2]

        # _has_stealth returns False for dead → no redirect
        redirected = self.ts.apply_stealth_redirection(candidates, consume=True)

        self.assertEqual(len(redirected), 0, "dead unit's stealth should not trigger")
        self.assertEqual(candidates[0].unit_id, u1.unit_id,
                         "dead unit not redirected")

    def test_multiple_stealth_buffs_on_one_unit_first_only_consumed(self):
        """Multiple stealth buffs on one unit: only the first matching buff is consumed."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        buff1 = _make_stealth_buff(duration=1, duration_type='skill', buff_id="s1")
        buff2 = _make_stealth_buff(duration=2, duration_type='skill', buff_id="s2")
        u1.buffs.append(buff1)
        u1.buffs.append(buff2)
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        candidates = [u1, u2]

        self.ts.apply_stealth_redirection(candidates, consume=True)

        # Only buff1 should be consumed (duration 1→0, removed)
        # buff2 should remain with duration=2
        stealth_buffs = [b for b in u1.buffs if b.effect_type == STEALTH]
        self.assertEqual(len(stealth_buffs), 1, "only one stealth buff consumed")
        self.assertEqual(stealth_buffs[0].buff_id, "s2",
                         "first buff (s1) should be consumed, second (s2) remains")
        self.assertEqual(stealth_buffs[0].duration, 2)

    def test_consume_false_prescan_does_not_affect_subsequent_real_call(self):
        """prescan (consume=False) does NOT affect subsequent real call (consume=True).
        Skill-based stealth duration should be intact for the real call.
        """
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        buff = _make_stealth_buff(duration=1, duration_type='skill')
        u1.buffs.append(buff)
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)

        # Prescan: consume=False → duration unchanged
        self.ts.apply_stealth_redirection([u1, u2], consume=False)
        self.assertEqual(buff.duration, 1, "prescan should not consume duration")

        # Real call: consume=True → duration 1→0, buff removed
        self.ts.apply_stealth_redirection([u1, u2], consume=True)
        self.assertEqual(buff.duration, 0, "real call should consume duration")
        stealth_buffs = [b for b in u1.buffs if b.effect_type == STEALTH]
        self.assertEqual(len(stealth_buffs), 0, "buff removed after real call")

    def test_stealth_at_non_first_position_not_triggered(self):
        """Stealth unit at non-first position → NOT triggered (only first-priority triggers)."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        u2.buffs.append(_make_stealth_buff(duration=1, duration_type='skill'))
        u3 = _make_unit("u3", "U3", Side.ENEMY, Position.ENEMY_RIGHT_FRONT)
        candidates = [u1, u2, u3]

        redirected = self.ts.apply_stealth_redirection(candidates, consume=True)

        # u2 is at index 1 (not first) → stealth NOT triggered
        self.assertEqual(len(redirected), 0, "stealth at non-first position should not trigger")
        # u2's stealth buff should still be there (duration=1, not consumed)
        stealth_buffs = [b for b in u2.buffs if b.effect_type == STEALTH]
        self.assertEqual(len(stealth_buffs), 1, "non-first stealth buff not consumed")
        self.assertEqual(stealth_buffs[0].duration, 1)


# ═══════════════════════════════════════════════════════════════════════
# Part 7: Return value (redirected set)
# ═══════════════════════════════════════════════════════════════════════

class TestApplyStealthReturnValue(unittest.TestCase):
    """apply_stealth_redirection: return value is set of id(unit) triggered."""

    def setUp(self):
        self.ts = TargetService()

    def test_returned_set_uses_id_not_unit_id(self):
        """Returned set contains id(unit) (Python object id), not unit_id string."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u1.buffs.append(_make_stealth_buff(duration=1))
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)
        candidates = [u1, u2]

        redirected = self.ts.apply_stealth_redirection(candidates, consume=True)

        self.assertIn(id(u1), redirected,
                      "returned set should contain id(u1)")
        self.assertNotIn(id(u2), redirected,
                         "u2 not redirected")

    def test_empty_returned_set_when_no_stealth(self):
        """No stealth → empty set returned."""
        u1 = _make_unit("u1", "U1", Side.ENEMY, Position.ENEMY_LEFT_FRONT)
        u2 = _make_unit("u2", "U2", Side.ENEMY, Position.ENEMY_CENTER_FRONT)

        redirected = self.ts.apply_stealth_redirection([u1, u2], consume=True)

        self.assertEqual(len(redirected), 0)


if __name__ == '__main__':
    unittest.main()
