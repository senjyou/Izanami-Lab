    # ─── EX: 110012 薄暮の宵火 ───

    def test_ex_110012_damage_and_self_shield(self):
        """
        EX(110012) 敌横一列伤害 + 自身最大HP×50%盾
        验证:
        1. "後列優先" - 对敌方后排造成伤害（enemy_row + back priority）
        2. 自身获得shield buff
        3. shield_amount = caster.max_hp * shield_pct% (Lv10插值=59%)
        4. shield_base="max_hp", shield_decay_pct=25
        5. shield duration=-1 (永续，通过衰减消失)
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110012, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"], f"EX执行应成功: {result.get('error', '')}")

        # 1. 验证敌方后排受到伤害（後列優先：后排有敌人时优先打后排）
        self.assertLess(self.enemy_back.current_hp, self.enemy_back.max_hp,
                        "敌方后排中央应受到EX伤害（後列優先）")
        self.assertLess(self.enemy_right_back.current_hp, self.enemy_right_back.max_hp,
                        "敌方右后应受到EX伤害（後列優先）")

        # 2. 验证自身获得shield buff
        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertGreater(len(shield_buffs), 0, " caster应获得shield buff")

        shield = shield_buffs[0]
        # 3. shield_pct Lv10通过interpolation_mode=2插值: 50.0 + (10-1)/(11-1)*(60-50) = 59.0
        # shield_amount = 20000 * 59% = 11800
        expected_pct = 50.0 + (10 - 1) / (11 - 1) * (60.0 - 50.0)  # 59.0
        expected_shield = int(self.caster.max_hp * expected_pct / 100)
        self.assertEqual(shield.shield_amount, expected_shield,
                         f"shield_amount应为max_hp×{expected_pct}%={expected_shield}, 实际: {shield.shield_amount}")

        # 4. 衰减参数
        self.assertEqual(shield.shield_decay_pct, 25,
                         f"shield_decay_pct应为25, 实际: {shield.shield_decay_pct}")
        self.assertEqual(shield.initial_shield_value, expected_shield,
                         f"initial_shield_value应为{expected_shield}, 实际: {shield.initial_shield_value}")

        # 5. duration=-1（永续，靠衰减消失）
        self.assertEqual(shield.duration, -1,
                         f"shield duration应为-1(永续), 实际: {shield.duration}")

        # 6. caster.shield 应同步增加
        self.assertGreater(self.caster.shield, 0, "caster.shield应大于0")

    def test_ex_110012_shield_decay_per_action(self):
        """
        EX(110012) 每行动-25%最大值衰减（不包括施法当次行动）
        验证: 首次process_shield_decay跳过（当次行动），第二次才衰减
        Lv10 shield_pct插值=59% → shield=11800, 每行动-2950
        """
        # 先施放EX获得盾
        self.ss.execute_skill(
            caster=self.caster, skill_id=110012, battlefield=self.bf, skip_cost=True
        )
        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertGreater(len(shield_buffs), 0)
        initial_amount = shield_buffs[0].shield_amount
        expected_decay = int(initial_amount * 25 / 100)  # 11800 * 25% = 2950

        # 第1次：施法当次行动结束 → 跳过衰减（首次豁免）
        self.aus.process_shield_decay(self.caster)
        shield_buffs_after_first = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertTrue(shield_buffs_after_first, "首次豁免后盾应仍存在")
        self.assertEqual(
            shield_buffs_after_first[0].shield_amount, initial_amount,
            f"首次豁免后shield_amount应不变={initial_amount}, "
            f"实际: {shield_buffs_after_first[0].shield_amount}"
        )

        # 第2次：下次行动结束 → 正常衰减
        self.aus.process_shield_decay(self.caster)
        shield_buffs_after = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        if shield_buffs_after:  # 还未衰减到0
            self.assertEqual(
                shield_buffs_after[0].shield_amount,
                initial_amount - expected_decay,
                f"衰减后shield_amount应为{initial_amount - expected_decay}, "
                f"实际: {shield_buffs_after[0].shield_amount}"
            )

    def test_ex_110012_shield_expired_after_4_actions(self):
        """
        EX(110012) 施法当次行动豁免 + 4次衰减后盾应消失（4×25%=100%）
        共调用5次process_shield_decay: 第1次跳过，第2-5次衰减
        """
        self.ss.execute_skill(
            caster=self.caster, skill_id=110012, battlefield=self.bf, skip_cost=True
        )
        # 第1次跳过（当次行动），第2-5次共4次衰减
        for i in range(5):
            self.aus.process_shield_decay(self.caster)

        # 4次衰减后shield_amount应=0，buff应被清理
        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_buffs), 0,
                         f"4次衰减后shield buff应被清理, 实际剩余: {len(shield_buffs)}")
        self.assertEqual(self.caster.shield, 0, "4次衰减后caster.shield应为0")

    def test_ex_110012_lv15_shield_100_percent(self):
        """
        EX(110012) Lv15 shield应为max_hp×100%
        """
        self.caster.skill_levels[110012] = 15
        self.ss.execute_skill(
            caster=self.caster, skill_id=110012, battlefield=self.bf, skip_cost=True
        )
        shield_buffs = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertGreater(len(shield_buffs), 0)
        expected = int(self.caster.max_hp * 100.0 / 100)  # 20000
        self.assertEqual(shield_buffs[0].shield_amount, expected,
                         f"Lv15 shield应为max_hp×100%={expected}, 实际: {shield_buffs[0].shield_amount}")

    # ─── AS1: 120055 クールスラッシュ・トリプル ───

    def test_as1_120055_three_hit_damage(self):
        """
        AS1(120055) 3hit伤害
        验证: 单一damage effect带hit_count=3
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120055, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 应该有damage效果触发
        dmg_effects = [e for e in result.get("effects_applied", [])
                       if e.get("effect_type") == "damage"]
        self.assertGreater(len(dmg_effects), 0, "应有damage效果")

        # 敌方应受到伤害（后列优先）
        # 由于是enemy_single + 后列优先，可能命中 enemy_back 或后排单位
        any_damaged = any(e.current_hp < e.max_hp for e in self.bf.enemy_team)
        self.assertTrue(any_damaged, "至少一个敌方应受到伤害")

    def test_as1_120055_debuffs_duration_owner_caster(self):
        """
        AS1(120055) dmg_dealt_down 25% + dmg_taken_up 25%
        验证:
        1. 目标获得dmg_dealt_down debuff (value=-25)
        2. 目标获得dmg_taken_up debuff (value=25)
        3. 两个debuff的duration_owner=caster (timing_type=DURABLE_SOURCE_MANEUVER_END)
        4. stackable=true
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120055, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 找到受到伤害的敌方
        damaged_enemies = [e for e in self.bf.enemy_team if e.current_hp < e.max_hp]
        self.assertGreater(len(damaged_enemies), 0, "应有敌方受到伤害")
        target = damaged_enemies[0]

        # 验证dmg_dealt_down debuff (DEALT_DAMAGE, value负数表示减少)
        dealt_buffs = [d for d in target.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dealt_buffs), 0,
                           f"目标应有dmg_dealt_down debuff, 实际debuffs: {[d.effect_type for d in target.debuffs]}")
        dealt = dealt_buffs[0]
        self.assertEqual(dealt.is_stackable, True, "dmg_dealt_down应可叠加")
        self.assertEqual(dealt.timing_type, AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
                         "dmg_dealt_down timing应为DURABLE_SOURCE_MANEUVER_END (duration_owner=caster)")

        # 验证dmg_taken_up debuff (RECEIVED_DAMAGE, value正数表示增加)
        recv_buffs = [d for d in target.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(recv_buffs), 0,
                           f"目标应有dmg_taken_up debuff, 实际debuffs: {[d.effect_type for d in target.debuffs]}")
        recv = recv_buffs[0]
        self.assertEqual(recv.is_stackable, True, "dmg_taken_up应可叠加")
        self.assertEqual(recv.timing_type, AuraUpdateTiming.DURABLE_SOURCE_MANEUVER_END.value,
                         "dmg_taken_up timing应为DURABLE_SOURCE_MANEUVER_END (duration_owner=caster)")

    def test_as1_120055_debuffs_expire_on_caster_next_action(self):
        """
        AS1(120055) debuff在施法者下次行动结束时消失
        描述: 自身が次に行動を終えるまでの間
        duration=1 + duration_owner="caster" + just_applied保护:
        - 当次行动结束: just_applied=True → SKIP (保留, duration=1)
        - 下次行动结束: 1→0 (消失)
        """
        self.ss.execute_skill(
            caster=self.caster, skill_id=120055, battlefield=self.bf, skip_cost=True
        )
        damaged_enemies = [e for e in self.bf.enemy_team if e.current_hp < e.max_hp]
        target = damaged_enemies[0]
        self.assertGreater(len([d for d in target.debuffs if d.effect_type == DEALT_DAMAGE]), 0)

        # 当次施法者行动结束 → just_applied保护，不递减，debuff应保留
        self.aus.process_source_maneuver_end(self.caster, self.bf.get_all_units())
        dealt_buffs = [d for d in target.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dealt_buffs), 1,
                         f"当次行动结束后dmg_dealt_down应保留(just_applied保护), 实际剩余: {len(dealt_buffs)}")
        recv_buffs = [d for d in target.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(recv_buffs), 1,
                         f"当次行动结束后dmg_taken_up应保留(just_applied保护), 实际剩余: {len(recv_buffs)}")

        # 模拟battle_flow_controller: 行动结束后清除just_applied标记
        for u in self.bf.get_all_units():
            for b in u.buffs + u.debuffs:
                b.just_applied = False

        # 下次施法者行动结束 → duration 1→0，debuff应消失
        self.aus.process_source_maneuver_end(self.caster, self.bf.get_all_units())
        dealt_buffs = [d for d in target.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dealt_buffs), 0,
                         f"下次行动结束后dmg_dealt_down应消失, 实际剩余: {len(dealt_buffs)}")
        recv_buffs = [d for d in target.debuffs if d.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(recv_buffs), 0,
                         f"下次行动结束后dmg_taken_up应消失, 实际剩余: {len(recv_buffs)}")

    # ─── AS2: 120056 バックエイムファイア ───

    def test_as2_120056_damage_only_at_lv10(self):
        """
        AS2(120056) Lv10仅伤害，无shield block
        验证: Lv10时不应施加shield给友方
        """
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120056, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 应对敌方造成伤害
        any_damaged = any(e.current_hp < e.max_hp for e in self.bf.enemy_team)
        self.assertTrue(any_damaged, "应造成伤害")

        # Lv10不应有友方获得shield
        for ally in self.bf.friend_team:
            shield_buffs = [b for b in ally.buffs if b.effect_type == SHIELD]
            self.assertEqual(len(shield_buffs), 0,
                             f"Lv10时{ally.name}不应获得shield buff")

    def test_as2_120056_lv11_shield_on_nearest_ally(self):
        """
        AS2(120056) Lv11+ 自身最近友方获得ATK×value%盾，3行动
        验证:
        1. Lv11时友方获得shield buff
        2. shield_amount = caster.attack × 50% = 5000
        3. shield持续时间=3, duration_type=action
        4. 目标是自身最近友方（非自身）
        """
        self.caster.skill_levels[120056] = 11
        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120056, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # caster位于ALLY_CENTER_FRONT (0,1)
        # 友方: ally_water_back(1,1)距离1, ally_fire_front(0,0)距离1, ally_wind_back(1,2)距离2
        # 距离1的有两个: ally_water_back和ally_fire_front
        # get_nearest_ally返回第一个匹配的（min函数）
        # 验证至少一个友方获得shield
        allies_with_shield = [
            a for a in self.bf.friend_team
            if a.unit_id != self.caster.unit_id
            and any(b.effect_type == SHIELD for b in a.buffs)
        ]
        self.assertGreater(len(allies_with_shield), 0,
                           "Lv11+应至少有一个友方获得shield buff")

        # caster自身不应获得此shield
        caster_shields = [b for b in self.caster.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(caster_shields), 0,
                         " caster自身不应获得AS2的shield")

        # 验证shield数值和持续时间
        target = allies_with_shield[0]
        shield = [b for b in target.buffs if b.effect_type == SHIELD][0]
        expected_shield = int(self.caster.attack * 50.0 / 100)  # 5000
        self.assertEqual(shield.shield_amount, expected_shield,
                         f"shield_amount应为ATK×50%={expected_shield}, 实际: {shield.shield_amount}")
        self.assertEqual(shield.duration, 3,
                         f"shield duration应为3, 实际: {shield.duration}")

    # ─── PS1: 130063 スマートバリア ───

    def test_ps1_130063_triggers_on_hp_below_50(self):
        """
        PS1(130063) HP≤50%触发
        验证: caster HP从>50%降到≤50%时，PS1触发
        """
        # caster HP从100%降到40%
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.caster.prev_hp_percent = 100.0
        self.caster.current_pp = 10  # 确保有PP
        self.caster.skill_cooldowns.pop(130063, None)

        actions = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1_triggered = any(a.skill_id == 130063 for a in actions)
        self.assertTrue(ps1_triggered, "HP≤50%应触发PS1(130063)")

    def test_ps1_130063_does_not_trigger_above_50(self):
        """
        PS1(130063) HP>50%不应触发
        """
        self.caster.current_hp = int(self.caster.max_hp * 0.6)  # 60%
        self.caster.prev_hp_percent = 100.0
        self.caster.skill_cooldowns.pop(130063, None)

        actions = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1_triggered = any(a.skill_id == 130063 for a in actions)
        self.assertFalse(ps1_triggered, "HP>50%不应触发PS1(130063)")

    def test_ps1_130063_only_affects_water_allies(self):
        """
        PS1(130063) 仅水属性（element=2）友方获得dmg_taken_down
        验证:
        1. caster自身(element=2)获得buff
        2. ally_water_back(element=2)获得buff
        3. ally_fire_front(element=1)不获得buff
        4. ally_wind_back(element=3)不获得buff
        """
        # 触发PS1
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.caster.prev_hp_percent = 100.0
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130063, None)

        actions = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1_actions = [a for a in actions if a.skill_id == 130063]
        self.assertGreater(len(ps1_actions), 0, "PS1应触发")

        # 执行PS1
        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_hp_below"
        )

        # 验证水属性友方获得buff
        # caster (element=2)
        caster_buffs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(caster_buffs), 0,
                           f"caster(水属性)应获得dmg_taken_down, 实际buffs: {[b.effect_type for b in self.caster.buffs]}")
        self.assertEqual(caster_buffs[0].is_stackable, True, "dmg_taken_down应可叠加")
        # dmg_taken_down作为buff存储，value为正数（百分比减伤）
        # _aggregate_buff_value_signed中: buff_val - debuff_val, result = 1.0 - net
        # 所以buff(减伤) value为正 → net为正 → result < 1.0 → 减伤
        self.assertGreater(caster_buffs[0].value, 0, "dmg_taken_down value应为正(减伤百分比)")

        # ally_water_back (element=2)
        water_buffs = [b for b in self.ally_water_back.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(water_buffs), 0,
                           f"水属性友方应获得dmg_taken_down, 实际buffs: {[b.effect_type for b in self.ally_water_back.buffs]}")

        # ally_fire_front (element=1) 不应获得
        fire_buffs = [b for b in self.ally_fire_front.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(fire_buffs), 0,
                         f"火属性友方不应获得dmg_taken_down, 实际buffs: {[b.effect_type for b in self.ally_fire_front.buffs]}")

        # ally_wind_back (element=3) 不应获得
        wind_buffs = [b for b in self.ally_wind_back.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(wind_buffs), 0,
                         f"风属性友方不应获得dmg_taken_down, 实际buffs: {[b.effect_type for b in self.ally_wind_back.buffs]}")

    def test_ps1_130063_once_per_battle(self):
        """
        PS1(130063) 战斗中只发动1次
        验证: 第二次HP≤50%不再触发
        """
        self.caster.current_hp = int(self.caster.max_hp * 0.4)
        self.caster.prev_hp_percent = 100.0
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130063, None)

        # 第一次触发
        actions1 = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1_count1 = sum(1 for a in actions1 if a.skill_id == 130063)
        self.assertEqual(ps1_count1, 1, "第一次应触发PS1")

        # 执行PS1
        self.ss._execute_trigger_actions_inline(
            [a for a in actions1 if a.skill_id == 130063],
            self.bf, trigger_timing="on_hp_below"
        )

        # 模拟HP再次下降，第二次触发
        self.caster.current_hp = int(self.caster.max_hp * 0.2)
        self.caster.prev_hp_percent = 40.0  # 上次40%

        actions2 = self.ts.trigger_hp_below(self.bf, [self.caster])
        ps1_count2 = sum(1 for a in actions2 if a.skill_id == 130063)
        self.assertEqual(ps1_count2, 0, "第二次不应触发PS1（战斗中只1次）")

    # ─── PS2: 130064 セカンドライン・セーブ ───

    def test_ps2_130064_triggers_on_turn_start(self):
        """
        PS2(130064) on_turn_start触发
        验证: 回合开始时触发PS2
        """
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130064, None)

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130064]
        self.assertGreater(len(ps2_actions), 0, "回合开始应触发PS2(130064)")

    def test_ps2_130064_excludes_self(self):
        """
        PS2(130064) 友方全体不含自身获得减伤
        验证: caster自身不获得dmg_taken_down，其他友方获得
        """
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130064, None)

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130064]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # caster自身不应获得
        caster_buffs = [b for b in self.caster.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(caster_buffs), 0,
                         f"caster自身不应获得PS2减伤, 实际buffs: {[b.effect_type for b in self.caster.buffs]}")

        # 其他友方应获得
        for ally in [self.ally_water_back, self.ally_fire_front, self.ally_wind_back]:
            recv_buffs = [b for b in ally.buffs if b.effect_type == RECEIVED_DAMAGE]
            self.assertGreater(len(recv_buffs), 0,
                               f"{ally.name}应获得dmg_taken_down, "
                               f"实际buffs: {[b.effect_type for b in ally.buffs]}")
            buff = recv_buffs[0]
            self.assertEqual(buff.attack_limited, 2,
                             f"{ally.name}减伤应attack_limited=2(2次被攻击后消失)")
            self.assertEqual(buff.is_stackable, True,
                             f"{ally.name}减伤应可叠加")

    def test_ps2_130064_attack_limited_2_consumed_by_attacks(self):
        """
        PS2(130064) attack_limited=2: 被攻击2次后消失
        验证: attack_limited字段=2，且在skill_service执行攻击时递减
        注: attack_limited递减发生在skill_service.execute_skill内部（被攻击时），
           不在check_expiration中。本测试验证buff的attack_limited初始值。
        """
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130064, None)

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130064]
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        target = self.ally_water_back
        initial_buffs = [b for b in target.buffs if b.effect_type == RECEIVED_DAMAGE]
        self.assertEqual(len(initial_buffs), 1)
        # 验证attack_limited=2（2次被攻击后消失）
        self.assertEqual(initial_buffs[0].attack_limited, 2,
                         f"attack_limited应为2, 实际: {initial_buffs[0].attack_limited}")
        # 验证duration_type="hit" → timing=DURABLE_WHEN_USED（不在行动/回合结束时递减）
        from src.entities_v2.enums import AuraUpdateTiming
        self.assertEqual(initial_buffs[0].timing_type, AuraUpdateTiming.DURABLE_WHEN_USED.value,
                         f"timing应为DURABLE_WHEN_USED(hit类型), 实际: {initial_buffs[0].timing_type}")
        # 验证damage_element=physical（仅物理攻击减伤）
        self.assertEqual(initial_buffs[0].damage_element, 1,
                         f"damage_element应为1(物理), 实际: {initial_buffs[0].damage_element}")

    def test_ps2_130064_lv11_burn_on_furthest_enemy(self):
        """
        PS2(130064) Lv11+ 对最远敌人施加3行动炎上
        验证:
        1. Lv11时最远敌人获得burn debuff
        2. burn持续3行动
        3. burn必须施加在最远敌方（enemy_right_back），不是最近敌方
        4. Lv10时无burn
        """
        # 测试 Lv11+
        self.caster.skill_levels[130064] = 11
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130064, None)

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130064]
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # caster在ALLY_CENTER_FRONT(0,1)，最远敌人应在后排
        # enemy_front(0,1)距离0, enemy_back(1,1)距离1, enemy_left_front(0,0)距离1
        # enemy_right_back(1,2)距离2 - 最远
        # 验证最远敌人获得burn
        burn_targets = [e for e in self.bf.enemy_team
                        if any(d.effect_type == CONFLAGRATION for d in e.debuffs)]
        self.assertGreater(len(burn_targets), 0,
                           "Lv11+应有敌人获得burn debuff")

        burn_target = burn_targets[0]
        burn_debuffs = [d for d in burn_target.debuffs if d.effect_type == CONFLAGRATION]
        self.assertEqual(len(burn_debuffs), 1, "burn debuff应只有1个")
        self.assertEqual(burn_debuffs[0].duration, 3,
                         f"burn duration应为3, 实际: {burn_debuffs[0].duration}")

        # 核心断言：burn必须施加在最远敌方(enemy_right_back)，不是最近敌方(enemy_front)
        self.assertEqual(burn_target.unit_id, "enemy_right_back",
                         f"burn应施加在最远敌方(enemy_right_back)，实际施加在{burn_target.name}({burn_target.unit_id})")

        # 验证最近敌方未获得burn
        no_burn_enemies = [e for e in self.bf.enemy_team
                           if e.unit_id != "enemy_right_back"
                           and any(d.effect_type == CONFLAGRATION for d in e.debuffs)]
        self.assertEqual(len(no_burn_enemies), 0,
                         f"非最远敌方不应获得burn: {[e.name for e in no_burn_enemies]}")

    def test_ps2_130064_lv10_no_burn(self):
        """
        PS2(130064) Lv10 不应施加burn
        """
        self.caster.skill_levels[130064] = 10
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130064, None)

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130064]
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # Lv10不应有burn
        for enemy in self.bf.enemy_team:
            burn_debuffs = [d for d in enemy.debuffs if d.effect_type == CONFLAGRATION]
            self.assertEqual(len(burn_debuffs), 0,
                             f"Lv10时{enemy.name}不应有burn debuff")

    def test_ps2_130064_once_per_battle(self):
        """
        PS2(130064) 战斗中只发动1次
        """
        self.caster.current_pp = 10
        self.caster.skill_cooldowns.pop(130064, None)

        # 第一次回合开始
        actions1 = self.ts.trigger_turn_start(self.bf)
        ps1_count1 = sum(1 for a in actions1 if a.skill_id == 130064)
        self.assertEqual(ps1_count1, 1, "第一次应触发PS2")

        # 执行PS2
        self.ss._execute_trigger_actions_inline(
            [a for a in actions1 if a.skill_id == 130064],
            self.bf, trigger_timing="on_turn_start"
        )

        # 第二次回合开始
        actions2 = self.ts.trigger_turn_start(self.bf)
        ps1_count2 = sum(1 for a in actions2 if a.skill_id == 130064)
        self.assertEqual(ps1_count2, 0, "第二次不应触发PS2（战斗中只1次）")


