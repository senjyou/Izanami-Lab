"""Regression: 代助一避(130013)在敌方无伤害AS技能时误触发。

Bug: 技能预扫描(_pre_scanned_cover_candidates)扫描全部damage block的索敌目标，
     不检查block条件。220470 パーフェクトオーダー为mark双分支（lacks_mark_at_start
     攻勢→横列盾；has_mark_at_start 攻勢→敌单体伤害）。敌方无攻勢时执行盾分支，
     但被跳过的伤害块(block2)目标被预扫描为"被攻击友方"，导致 before_as_attacked
     提前触发（1253行：pre_scanned_cover_candidates非空）→ 代助一避误触发。
     实测游戏：敌方只给自己加盾，不应触发代助一避。
Fix: 新增强判定 _is_block_definitely_skipped（mark/等级确定性条件，未知类型保守）；
     预扫描跳过必然被跳过的block；无实际伤害时(纯效果或damage块全部跳过)改由
     未跳过block的非伤害敌方效果目标驱动提前触发（保持120159纯效果分支语义）。
"""
import sys
import os
import unittest

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import BuffState
from src.entities_v2.enums import Side, Position, SkillEffectType, AuraUpdateTiming

MARK = SkillEffectType.MARK.value
EVADE = SkillEffectType.EVADE.value
DAISUKE = 130013   # 代助一避（before_as_attacked + target_is_front_ally）
ORDER_AS = 220470  # パーフェクトオーダー（lacks攻勢→盾；has攻勢→伤害）
KOUSEI = "攻勢"


def _make_kousei_mark():
    return BuffState(
        buff_id="pre_kousei", name=KOUSEI, effect_type=MARK, value=0, duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id="pre", source_skill_id=0, is_debuff=False,
        is_memory_buff=True,
    )


class TestRegNoTriggerWithoutActiveDamage(unittest.TestCase):

    def setUp(self):
        bb = BattleBuilder()
        # 代助一避持有者（后排中央，正前方为 ally_front）
        bb.add_ally(unit_id="caster", position=Position.ALLY_CENTER_BACK,
                    hp=20000, atk=10000, defense=5000, speed=500,
                    skills=[DAISUKE], level=10)
        # 前方友方（代助一避保护对象）
        bb.add_ally(unit_id="ally_front", position=Position.ALLY_CENTER_FRONT,
                    hp=20000, atk=8000, defense=4000, speed=400,
                    skills=[], level=10)
        # 敌方（持有 220470）
        bb.add_enemy(unit_id="enemy_cf", position=Position.ENEMY_CENTER_FRONT,
                     hp=30000, atk=8000, defense=6000, speed=400,
                     skills=[ORDER_AS], level=10)
        ctx = bb.build()
        self.dl = ctx['services']['dl']
        self.ss = ctx['ss']
        self.bf = ctx['bf']
        self.caster = ctx['allies'][0]
        self.ally_front = ctx['allies'][1]
        self.enemy_cf = ctx['enemies'][0]
        # PP足够代助一避(130013 cost=2)
        self.caster.current_pp = 10
        self.enemy_cf.current_pp = 10

    def _run_enemy_as(self):
        """敌方使用220470，返回(结果, 日志行列表)"""
        with self.assertLogs("MGGBattleSim", level="INFO") as cm:
            result = self.ss.execute_skill(
                caster=self.enemy_cf, skill_id=ORDER_AS, battlefield=self.bf, skip_cost=True
            )
        return result, cm.output

    def test_shield_branch_does_not_trigger_daisuke(self):
        """无攻勢（盾分支）：敌方未攻击，代助一避不应触发"""
        self.assertFalse(any(
            b.effect_type == MARK and b.name == KOUSEI for b in self.enemy_cf.buffs
        ), "前提：敌方无攻勢")
        result, logs = self._run_enemy_as()
        self.assertTrue(result["success"])

        triggered = [l for l in logs if "PS[代助一避]" in l and "BEFORE_AS_ATTACKED" in l]
        self.assertEqual(len(triggered), 0,
                         "盾分支非攻击，代助一避不应触发。日志:\n" + "\n".join(
                             l for l in logs if "代助一避" in l or "TRIGGER" in l))
        # 前方友方不应获得闪避buff
        evade = [b for b in self.ally_front.buffs if b.effect_type == EVADE]
        self.assertEqual(len(evade), 0, "不应给前方友方附加Evade")

    def test_damage_branch_still_triggers_daisuke(self):
        """有攻勢（伤害分支）：敌方实际攻击，代助一避应正常触发"""
        self.enemy_cf.buffs.append(_make_kousei_mark())
        result, logs = self._run_enemy_as()
        self.assertTrue(result["success"])

        triggered = [l for l in logs if "PS[代助一避]" in l and "BEFORE_AS_ATTACKED" in l]
        self.assertGreater(len(triggered), 0,
                           "伤害分支应触发代助一避。日志:\n" + "\n".join(
                               l for l in logs if "代助一避" in l or "TRIGGER" in l))


if __name__ == '__main__':
    unittest.main(verbosity=2)
