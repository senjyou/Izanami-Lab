"""回归测试: 战术演习阶段增量超过 break20 后不再截断。

游戏内暗改: HP/ATK/DEF 从 break21 起继续按公式
    0.2*n + 0.005*(n-3)*(n-2)
提升，不再封顶在 break20（旧实现用 min(n, 20) 截断）。
SPD 本就不受该上限影响（0.05*n）。

验证基准: 敌方 772405 惨禍：オルガ＆ナージャ (基础 DEF=6791, ATK=8685, HP=550453)
- break20 倍率 = 6.53  → DEF = floor(6791*6.53) = 44345（与模拟器 log 一致）
- break21 倍率 = 6.91  → DEF = floor(6791*6.91) = 46925
实测反推: 142145 - 162876/(1.56*1.02*1.075) ≈ 46926，与公式续算一致，
证明机制为「沿用旧增量公式、取消 break20 截断」。
"""
import os
import sys
import unittest

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.battle_flow_controller import BattleConfig
from src.combat_v2.tactical_exercise_controller import TacticalExerciseController


def _make_enemy(hp=550453, atk=8685, defense=6791, speed=619):
    return UnitState(
        unit_id="enemy_olga", name="惨禍：オルガ＆ナージャ", side=Side.ENEMY,
        position=Position.ENEMY_CENTER_FRONT, character_id=500301, level=10,
        element=4, character_type=2,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.23, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=5,
        current_ap=4, current_pp=4, current_ep=0,
        skills=[], skill_levels={}, skill_cooldowns={},
    )


class TestStageIncrementBeyond20(unittest.TestCase):
    """break21+ 的 HP/ATK/DEF 不再封顶在 break20"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.enemy = _make_enemy()
        bf = BattlefieldState()
        bf.enemy_team = [self.enemy]
        bf.friend_team = []
        self.controller = TacticalExerciseController(
            bf, config=BattleConfig(max_turns=5), data_loader=self.dl
        )

    def _advance_to(self, stage):
        """推进到指定阶段（每次复活 +1）"""
        while self.controller._stage < stage:
            self.controller._resurrect_enemy(self.enemy, skip_narrative=True)

    def _final_def(self):
        return self.controller.damage_service._calculate_final_stat(self.enemy, "defense")

    def _final_atk(self):
        return self.controller.damage_service._calculate_final_stat(self.enemy, "attack")

    def test_break20_still_matches_old_formula(self):
        """break20 数值不变（向后兼容）"""
        self._advance_to(20)
        self.assertEqual(self._final_def(), 44345)
        self.assertEqual(self._final_atk(), 56713)

    def test_break21_def_not_clamped(self):
        """break21 DEF 继续按公式提升，而非停留在 44345"""
        self._advance_to(20)
        self.assertEqual(self._final_def(), 44345)
        self._advance_to(21)
        self.assertEqual(self._final_def(), 46925)
        # 若仍截断在 break20，这里会是 44345
        self.assertNotEqual(self._final_def(), 44345)

    def test_break21_atk_not_clamped(self):
        """break21 ATK 继续提升"""
        self._advance_to(21)
        self.assertEqual(self._final_atk(), 60013)

    def test_break21_max_hp_not_clamped(self):
        """break21 max_hp 继续提升（逐阶段 floor 累积的 permanent_flat 会带来少量偏差）"""
        self._advance_to(20)
        # break20 的 3594448 与实战 log 显示的 max HP 完全一致
        self.assertEqual(self.enemy.max_hp, 3594448)
        self._advance_to(21)
        # 未截断：由 break20 继续提升至 break21
        self.assertGreater(self.enemy.max_hp, 3594448)
        self.assertEqual(self.enemy.max_hp, 3803620)


if __name__ == "__main__":
    unittest.main()