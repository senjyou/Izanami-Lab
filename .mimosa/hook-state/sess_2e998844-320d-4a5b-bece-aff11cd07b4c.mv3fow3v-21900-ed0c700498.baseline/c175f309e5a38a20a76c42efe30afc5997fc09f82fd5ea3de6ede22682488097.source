"""Regression: prescan多目标(target_count>1)目标必须与实际damage一致——代助一避误触发（反复回归类）。

Bug: 220470 パーフェクトオーダー 攻勢分支为 damage enemy_single + flags.target_count=2。
     实际damage执行使用「主目标(range=1)+按距离最近补足」选目标（multi-target
     select），而prescan按display_target_range(=6)整批选目标，两者选出的目标
     集合不同。触发检查使用prescan目标：报告场景中实际被攻击的是 隣歩む想い+
     心色見つめるムードメーカー，prescan却包含 唯一無二の幼なじみ（代助一避持有者
     混沌の立役者 的正前方），导致 target_is_front_ally 误判 → 代助一避误触发
     （实测游戏：正前方未被攻击，不应触发）。

Fix: prescan对普通索敌(enemy_single等)+target_count>1的伤害块，改用与实际执行
     相同的「主目标(range=1)+_get_distance_key最近补足」规则
     （special postfilter类型/column维持原逻辑）。

覆盖（该bug类型此前多次回归，以下场景全部锁定）:
A. 单目标攻击非正前方友方 → 不触发
B. 多目标(target_count=2)不含正前方友方（报告场景）→ 不触发，且实际伤害目标
   必须为 [隣歩む想い, 心色見つめるムードメーカー]（=prescan一致性前提）
C. 多目标含正前方友方 → 触发
D. 单目标攻击正前方友方 → 触发（正例，防止修复过头）
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

DAISU_HITOMONO_YO = 130013   # 代助一避（before_as_attacked + target_is_front_ally）
PERFECT_ORDER = 220470       # パーフェクトオーダー（lacks攻勢→盾 / has攻勢→enemy_single×2伤害）
SINGLE_DMG_AS = 120070       # なにするかーーー！！（单目标伤害AS，用于单目标场景）

MARK = SkillEffectType.MARK.value
EVADE = SkillEffectType.EVADE.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
KOUSEI = "攻勢"


def _make_unit(unit_id, name, side, position, *, hp=100000, atk=10000,
               defense=4000, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ep=0):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=10, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=pp, current_ep=ep,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


def _add_kousei_mark(unit, caster_id):
    """给单位添加「攻勢」mark（使220470走伤害分支）。"""
    unit.buffs.append(BuffState(
        buff_id=f"kousei_{unit.unit_id}", name=KOUSEI,
        effect_type=MARK, value=1.0, duration=-1, timing_type=2,
        source_unit_id=caster_id, source_skill_id=PERFECT_ORDER,
        is_debuff=False, is_stackable=True, is_memory_buff=False,
    ))


class TestRegPrescanMultiTargetFrontAlly(unittest.TestCase):
    """prescan多目标场景下 代助一避 的触发/不触发（含报告场景镜像）。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    # ─────────── 报告场景镜像：5人队，正前方友方(RF)不在被攻击目标中 ───────────

    def _build_party_layout(self):
        """镜像报告站位: 混沌の立役者(RB, 代助一避持有者)，正前方=唯一無二(RF)。

        enemy CENTER_FRONT；主目标=隣歩む想い(LF，同行同距左侧优先)，
        target_count=2时第二目标=心色(LB，距主目标最近) —— 不含唯一無二(RF)。
        """
        magokoro = _make_unit("magokoro", "隣歩む想い", Side.ALLY,
                              Position.ALLY_LEFT_FRONT, hp=131211)
        yuuitsu = _make_unit("yuuitsu", "唯一無二の幼なじみ", Side.ALLY,
                             Position.ALLY_RIGHT_FRONT, hp=153569)
        kokoro = _make_unit("kokoro", "心色見つめるムードメーカー", Side.ALLY,
                            Position.ALLY_LEFT_BACK, hp=166979)
        bunny = _make_unit("bunny", "発情バニー", Side.ALLY,
                           Position.ALLY_CENTER_BACK, hp=149684)
        daisu_owner = _make_unit("daisu", "混沌の立役者", Side.ALLY,
                                 Position.ALLY_RIGHT_BACK, hp=149663, speed=600,
                                 skills=[DAISU_HITOMONO_YO],
                                 skill_levels={DAISU_HITOMONO_YO: 10})
        enemy = _make_unit("enemy", "鳴滝七彩", Side.ENEMY,
                           Position.ENEMY_CENTER_FRONT, hp=420063,
                           skills=[PERFECT_ORDER, SINGLE_DMG_AS],
                           skill_levels={PERFECT_ORDER: 10, SINGLE_DMG_AS: 15})
        bf = BattlefieldState()
        bf.friend_team = [magokoro, yuuitsu, kokoro, bunny, daisu_owner]
        bf.enemy_team = [enemy]
        return bf, magokoro, yuuitsu, kokoro, bunny, daisu_owner, enemy

    def _assert_not_triggered(self, daisu_owner, front_ally, logs):
        """代助一避未触发：owner无ReceivedDamage自身debuff、正前方友方无Evade、无触发日志"""
        self.assertFalse(
            any(b.effect_type == RECEIVED_DAMAGE for b in daisu_owner.debuffs),
            "代助一避不应触发（正前方未被攻击）")
        self.assertFalse(
            any(b.effect_type == EVADE for b in front_ally.buffs),
            "正前方友方不应获得Evade")
        triggered = [l for l in logs if "PS[代助一避]" in l and "BEFORE_AS_ATTACKED" in l]
        self.assertEqual(len(triggered), 0,
                         "不应有代助一避触发日志:\n" + "\n".join(
                             l for l in logs if "代助一避" in l or "TRIGGER" in l))

    def _assert_triggered(self, daisu_owner, logs):
        """代助一避已触发：owner获得自身ReceivedDamage debuff（Lv10效果）+ 触发日志"""
        self.assertTrue(
            any(b.effect_type == RECEIVED_DAMAGE for b in daisu_owner.debuffs),
            "代助一避应触发（正前方被攻击）")
        triggered = [l for l in logs if "PS[代助一避]" in l and "BEFORE_AS_ATTACKED" in l]
        self.assertGreater(len(triggered), 0,
                           "应有代助一避触发日志:\n" + "\n".join(
                               l for l in logs if "代助一避" in l or "TRIGGER" in l))

    def test_A_single_target_on_other_ally_no_trigger(self):
        """A: 单目标攻击 隣歩む想い（非正前方）→ 代助一避不触发"""
        bf, magokoro, yuuitsu, kokoro, bunny, daisu_owner, enemy = self._build_party_layout()
        ss, ts = self._make_services(bf)
        with self.assertLogs("MGGBattleSim", level="INFO") as cm:
            result = ss.execute_skill(enemy, SINGLE_DMG_AS, bf, skip_cost=True)
        self.assertTrue(result.get('success'))
        # 前提：实际攻击目标包含 隣歩む想い（单目标）
        self.assertTrue(any("隣歩む想い" in l for l in cm.output), "前提：应攻击隣歩む想い")
        self._assert_not_triggered(daisu_owner, yuuitsu, cm.output)

    def test_B_multi_target_without_front_ally_no_trigger(self):
        """B: 多目标(target_count=2)攻击 隣歩む想い+心色（不含正前方）→ 不触发（报告场景）"""
        bf, magokoro, yuuitsu, kokoro, bunny, daisu_owner, enemy = self._build_party_layout()
        _add_kousei_mark(enemy, "pre")
        ss, ts = self._make_services(bf)
        with self.assertLogs("MGGBattleSim", level="INFO") as cm:
            result = ss.execute_skill(enemy, PERFECT_ORDER, bf, skip_cost=True)
        self.assertTrue(result.get('success'))

        # 前提：实际伤害目标必须为 [隣歩む想い, 心色]（不含唯一無二）——prescan一致性基准
        mt = [l for l in cm.output if "multi-target select" in l]
        self.assertTrue(mt, "应有多目标选择日志")
        self.assertIn("隣歩む想い", mt[0])
        self.assertIn("心色見つめるムードメーカー", mt[0])
        self.assertNotIn("唯一無二の幼なじみ", mt[0],
                         "正前方友方不应在实际攻击目标中")

        self._assert_not_triggered(daisu_owner, yuuitsu, cm.output)

    # ─────────── 最小队形：正前方友方(RF)位于被攻击目标中 ───────────

    def _build_minimal_layout(self):
        """仅2友方：正前方友方=唯一無二(RF)，代助一避持有者=混沌(RB)。"""
        yuuitsu = _make_unit("yuuitsu", "唯一無二の幼なじみ", Side.ALLY,
                             Position.ALLY_RIGHT_FRONT, hp=153569)
        daisu_owner = _make_unit("daisu", "混沌の立役者", Side.ALLY,
                                 Position.ALLY_RIGHT_BACK, hp=149663, speed=600,
                                 skills=[DAISU_HITOMONO_YO],
                                 skill_levels={DAISU_HITOMONO_YO: 10})
        enemy = _make_unit("enemy", "鳴滝七彩", Side.ENEMY,
                           Position.ENEMY_CENTER_FRONT, hp=420063,
                           skills=[PERFECT_ORDER, SINGLE_DMG_AS],
                           skill_levels={PERFECT_ORDER: 10, SINGLE_DMG_AS: 15})
        bf = BattlefieldState()
        bf.friend_team = [yuuitsu, daisu_owner]
        bf.enemy_team = [enemy]
        return bf, yuuitsu, daisu_owner, enemy

    def test_C_multi_target_with_front_ally_triggers(self):
        """C: 多目标(target_count=2)攻击包含正前方友方 → 代助一避触发"""
        bf, yuuitsu, daisu_owner, enemy = self._build_minimal_layout()
        _add_kousei_mark(enemy, "pre")
        ss, ts = self._make_services(bf)
        with self.assertLogs("MGGBattleSim", level="INFO") as cm:
            result = ss.execute_skill(enemy, PERFECT_ORDER, bf, skip_cost=True)
        self.assertTrue(result.get('success'))
        self._assert_triggered(daisu_owner, cm.output)

    def test_D_single_target_on_front_ally_triggers(self):
        """D: 单目标攻击正前方友方 → 代助一避触发（正例保护）"""
        bf, yuuitsu, daisu_owner, enemy = self._build_minimal_layout()
        ss, ts = self._make_services(bf)
        with self.assertLogs("MGGBattleSim", level="INFO") as cm:
            result = ss.execute_skill(enemy, SINGLE_DMG_AS, bf, skip_cost=True)
        self.assertTrue(result.get('success'))
        self._assert_triggered(daisu_owner, cm.output)


if __name__ == '__main__':
    unittest.main(verbosity=2)
