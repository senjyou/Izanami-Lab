"""
角色142301 ポンコツいいんちょ 专项E2E测试
- EX: 110055 これは没収です！（敵単体HP割合最高+隣接2体 EN攻撃 + lifesteal 20%；Lv11+ dmg_dealt_down[stackable,1action]）
- AS1: 120121 風紀を守る一撃（execute_condition HP>=60%；consume_hp 25% current + damage_special[enemy_row, value_source=consume_hp, EN]；Lv11+ shield[ally_single, attack_limited=1]）
- AS2: 120122 容疑者を捕捉！（add_status[action_damage, 3actions] + mark[風紀] on enemy_column_lowest_mark_count）
- PS1: 130129 抵抗は無意味です！（on_skill_use_count[AS+EX 3回] + damage[trigger_attack_target, EN]；Lv11+ dmg_dealt_up[ally_all, 1action, stackable]）
- PS2: 130130 風紀委員長としての矜持（on_turn_start + ally_alive_count>1；remove_all_buffs + remove_all_debuffs + stealth[3 skill] + HOT[linked=Stealth] + dmg_taken_down[linked=Stealth, dynamic, stackable]）

覆盖维度：
1. EX HP割合最高索敵 + 隣接敵ダメージ + lifesteal + Lv11+ dmg_dealt_down
2. AS1 execute_condition HP>=60% + consume_hp + damage_special(enemy_row) + Lv11+ shield
3. AS2 enemy_column_lowest_mark_count 索敵 + action_damage debuff + 風紀mark
4. PS1 on_skill_use_count_modulo(AS+EX 3回) + trigger_attack_target + Lv11+ dmg_dealt_up(ally_all)
5. PS2 on_turn_start + remove_all_buffs/debuffs + stealth + HOT/dmg_taken_down(linked=Stealth) + ally_alive_count条件
6. stealth机制（项目规则11.11核心）：apply_stealth_redirection + select_min/max_with_stealth + 连锁 + 候选数不足 + prescan不消耗 + action/skill duration_type区分 + EX索敌跳过stealth单位
"""
import unittest
import sys
import os

os.chdir(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, 'src')

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import (
    Side, Position, SkillEffectType, Attribute, CharacterType
)
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService, TriggerAction
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

# 简写
# 注意：dmg_dealt_up/dmg_dealt_down 共用 DEALT_DAMAGE 枚举，区分方式：
#   up 在 buffs 列表，down 在 debuffs 列表
# dmg_taken_up/dmg_taken_down 共用 RECEIVED_DAMAGE
# mark 用 MARK 枚举
# stealth 用 STEALTH 枚举
# action_damage 用 ACTION_DAMAGE 枚举
MARK = SkillEffectType.MARK.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
RECEIVED_DAMAGE = SkillEffectType.RECEIVED_DAMAGE.value
STEALTH = SkillEffectType.STEALTH.value
ACTION_DAMAGE = SkillEffectType.ACTION_DAMAGE.value
HEAL_OVER_TIME = SkillEffectType.HEAL_OVER_TIME.value


class TestActor142301(unittest.TestCase):
    """角色142301 ポンコツいいんちょ 专项E2E测试"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def setUp(self):
        self.bf = BattlefieldState()

        # 施法者: 142301 ポンコツいいんちょ (土属性attr=4, EN型character_type=2, 后排position_type=2, EN攻撃role_type=2)
        # 默认Lv10，部分测试用Lv15验证Lv11+分支
        # caster 放后排中央（角色定位为后排）
        self.caster = UnitState(
            unit_id="ally_caster", name="ポンコツいいんちょ", side=Side.ALLY,
            position=Position.ALLY_CENTER_BACK, character_id=142301, level=10,
            element=4, character_type=2,
            max_hp=20000, current_hp=20000,
            attack=10000, defense=5000, speed=500,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=10, current_pp=10, current_ep=0,
            skills=[110055, 120121, 120122, 130129, 130130],
            skill_levels={110055: 10, 120121: 10, 120122: 10,
                          130129: 10, 130130: 10},
            skill_cooldowns={},
        )

        # 友方辅助单位（PS2 ally_alive_count>1 条件 + AS1 Lv11+ shield 目标 + PS1 Lv11+ dmg_dealt_up 目标）
        self.ally_helper = UnitState(
            unit_id="ally_helper", name="辅助单位", side=Side.ALLY,
            position=Position.ALLY_LEFT_FRONT, character_id=999100, level=10,
            element=1, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=8000, defense=4000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=2, initial_passive_point=2, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=0,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方前排中央（最近敌，HP割合最高候选）
        self.enemy_cf = UnitState(
            unit_id="enemy_cf", name="敵中前", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_FRONT, character_id=999001, level=10,
            element=1, character_type=1,
            max_hp=30000, current_hp=30000,
            attack=8000, defense=6000, speed=400,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=3,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方左前（邻接中前，enemy_row 测试用）
        self.enemy_lf = UnitState(
            unit_id="enemy_lf", name="敵左前", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_FRONT, character_id=999003, level=10,
            element=3, character_type=1,
            max_hp=15000, current_hp=15000,
            attack=7000, defense=5000, speed=380,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方右前（邻接中前，enemy_row 测试用）
        self.enemy_rf = UnitState(
            unit_id="enemy_rf", name="敵右前", side=Side.ENEMY,
            position=Position.ENEMY_RIGHT_FRONT, character_id=999004, level=10,
            element=4, character_type=1,
            max_hp=12000, current_hp=12000,
            attack=6500, defense=4500, speed=360,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=2,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        # 敌方中后（纵列测试用，与中前同列）
        self.enemy_cb = UnitState(
            unit_id="enemy_cb", name="敵中後", side=Side.ENEMY,
            position=Position.ENEMY_CENTER_BACK, character_id=999002, level=10,
            element=3, character_type=1,
            max_hp=20000, current_hp=20000,
            attack=6000, defense=4000, speed=350,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=4,
            skills=[], skill_levels={}, skill_cooldowns={},
        )

        self.bf.friend_team = [self.caster, self.ally_helper]
        self.bf.enemy_team = [self.enemy_cf, self.enemy_lf, self.enemy_rf, self.enemy_cb]

        # 服务链
        self.rs = ResourceService()
        self.ts = TriggerService()
        self.ts.set_data_loader(self.dl)
        self.aus = AuraService()
        self.dms = DamageService()
        self.tgs = TargetService()
        self.sts = StatusService()
        self.ss = SkillService(
            self.dl, self.rs,
            target_service=self.tgs,
            damage_service=self.dms,
            aura_service=self.aus,
            status_service=self.sts,
            trigger_service=self.ts,
        )
        self.ts.set_skill_service(self.ss)
        self.ss.set_battlefield(self.bf)

    def _reset_caster(self, hp=None, ap=10, pp=10, ep=0):
        """重置施法者状态。"""
        self.caster.current_hp = hp if hp is not None else self.caster.max_hp
        self.caster.buffs = []
        self.caster.debuffs = []
        self.caster.is_alive = True
        self.caster.skill_cooldowns = {}
        self.caster.current_ap = ap
        self.caster.current_pp = pp
        self.caster.current_ep = ep
        self.caster.crit_counter = 0
        self.caster.skill_use_count = {}

    def _reset_enemies(self):
        """重置敌方状态。"""
        for e in self.bf.enemy_team:
            e.current_hp = e.max_hp
            e.buffs = []
            e.debuffs = []
            e.is_alive = True
            e.current_ap = 4

    def _reset_ally_helper(self):
        """重置辅助单位状态。"""
        self.ally_helper.current_hp = self.ally_helper.max_hp
        self.ally_helper.buffs = []
        self.ally_helper.debuffs = []
        self.ally_helper.is_alive = True

    def _apply_mark(self, target, mark_name, count=1):
        """为指定目标附加 mark debuff。"""
        for _ in range(count):
            target.debuffs.append(BuffState(
                buff_id=f"mark_{mark_name}_{id(target)}_{_}",
                name=mark_name, effect_type=MARK, value=0,
                duration=-1, timing_type=2, is_debuff=True,
                unremovable=False,
            ))

    def _apply_stealth(self, target, duration=3, duration_type="skill"):
        """为指定目标附加ステルス buff（用于stealth机制测试）。

        duration_type:
          - "action": 触发不消耗duration，仅持有者行动结束递减
          - "skill": 被选为主目标时消耗1点duration
        """
        target.buffs.append(BuffState(
            buff_id=f"stealth_{id(target)}",
            name="ステルス", effect_type=STEALTH, value=1.0,
            duration=duration, timing_type=2, is_debuff=False,
            unremovable=False,
            original_duration_type=duration_type,
        ))

    # ─── EX: 110055 これは没収です！ ───

    def test_ex_main_target_highest_hp_ratio(self):
        """EX(110055) Block1: 主目标=HP割合最高的敌方。

        场景：4个敌方HP都满，HP割合都=100%。
       enemy_cf(max_hp=30000) 与 enemy_cb(max_hp=20000) 割合相同，
        但 enemy_cf 在前排距离 caster 最近 → 应选 enemy_cf 为主目标。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf = self.enemy_cf.current_hp
        hp_lf = self.enemy_lf.current_hp
        hp_rf = self.enemy_rf.current_hp
        hp_cb = self.enemy_cb.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110055, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 主目标(enemy_cf)应受到伤害
        self.assertLess(self.enemy_cf.current_hp, hp_cf, "enemy_cf(HP割合最高+最近)应受到主攻击伤害")

    def test_ex_adjacent_enemies_damaged(self):
        """EX(110055) Block1: 邻接主目标的2个敌方受到追加伤害。

        主目标=enemy_cf(中前)，邻接=enemy_lf(左前) + enemy_rf(右前)。
        enemy_cb(中后)不邻接中前，不应受伤。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf = self.enemy_cf.current_hp
        hp_lf = self.enemy_lf.current_hp
        hp_rf = self.enemy_rf.current_hp
        hp_cb = self.enemy_cb.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110055, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 邻接目标(左前+右前)受伤
        self.assertLess(self.enemy_lf.current_hp, hp_lf, "enemy_lf(邻接中前)应受到追加伤害")
        self.assertLess(self.enemy_rf.current_hp, hp_rf, "enemy_rf(邻接中前)应受到追加伤害")
        # 非邻接目标(中后)不受伤
        self.assertEqual(self.enemy_cb.current_hp, hp_cb, "enemy_cb(非邻接)不应受到伤害")

    def test_ex_lifesteal_heals_caster(self):
        """EX(110055) Block1: lifesteal 20% — caster HP回复（与造成伤害成正比）。"""
        self._reset_caster(hp=10000)  # 初始HP不满，验证吸血回复
        self._reset_enemies()

        hp_before = self.caster.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110055, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # caster HP应增加（lifesteal 20%）
        self.assertGreater(self.caster.current_hp, hp_before,
                           "lifesteal 20%应使caster HP增加")

    def test_ex_lv11_grants_dmg_dealt_down(self):
        """EX(110055) Block2 (Lv11+): 付与 dmg_dealt_down(stackable, 1 action)。

        Block2 的 dmg_dealt_down effect 配置 target_type=enemy_single_highest_hp_ratio，
        aura 施加时会重新运行 highest_hp_ratio 过滤器。Block1 主攻击伤害扣减了 enemy_cf 的 HP
        (30000→25181, ~84%)，而 enemy_cb 未受伤害保持 100% HP，因此 Block2 重新过滤后
        highest_hp_ratio = enemy_cb（敵中後），debuff 付与到 enemy_cb 而非原主目标 enemy_cf。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 15
        self.caster.skill_levels[110055] = 15

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110055, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # Block2 的 dmg_dealt_down 重新过滤 highest_hp_ratio，应落到 enemy_cb（未受伤，HP 100%）
        dmg_downs_cb = [d for d in self.enemy_cb.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_downs_cb), 0,
                           "Lv15+ Block2应付与 dmg_dealt_down debuff到 highest_hp_ratio 目标(enemy_cb)")
        self.assertEqual(dmg_downs_cb[0].duration, 1, "dmg_dealt_down duration应为1")
        self.assertTrue(dmg_downs_cb[0].is_stackable, "dmg_dealt_down应可叠加")
        # enemy_cf 因 Block1 伤害后 HP 割合下降，不应是 Block2 的 highest_hp_ratio 目标
        dmg_downs_cf = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_downs_cf), 0,
                         "enemy_cf 受伤后 HP 割合下降，不应是 Block2 aura 的 highest_hp_ratio 目标")

    def test_ex_lv10_no_dmg_dealt_down(self):
        """EX(110055) Lv10: 无 dmg_dealt_down（Block2 active_level_min=11 未满足）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self.caster.level = 10
        self.caster.skill_levels[110055] = 10

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110055, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        dmg_downs = [d for d in self.enemy_cf.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dmg_downs), 0, "Lv10不应有 dmg_dealt_down debuff")

    # ─── AS1: 120121 風紀を守る一撃 ───

    def test_as1_execute_condition_hp_below_60_skipped(self):
        """AS1(120121) execute_condition self_hp_above 60: HP<60%时技能不发动。

        返回 error="execute_condition not met"。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # 设置 HP=50%（<60%）
        self.caster.current_hp = int(self.caster.max_hp * 0.50)

        hp_before = self.caster.current_hp
        enemy_hp_before = self.enemy_cf.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120121, battlefield=self.bf, skip_cost=True
        )

        # 技能不发动：返回 error 或 success=False
        self.assertFalse(result.get("success", False),
                         "HP<60%时AS1不应发动")

        # caster HP 不变（未消耗）
        self.assertEqual(self.caster.current_hp, hp_before,
                         "HP<60%时AS1不发动，caster HP不应变化")
        # 敌方未受伤
        self.assertEqual(self.enemy_cf.current_hp, enemy_hp_before,
                         "HP<60%时AS1不发动，敌方不应受伤")

    def test_as1_consume_hp_and_damage_when_hp_above_60(self):
        """AS1(120121) Block1: HP>=60%时执行，consume_hp 25% current + damage_special(enemy_row)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        # HP=100%（>=60%）
        hp_before = self.caster.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120121, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 HP 被消耗25% current
        expected_consume = int(self.caster.max_hp * 0.25)
        actual_consume = hp_before - self.caster.current_hp
        self.assertEqual(actual_consume, expected_consume,
                         f"Block1应消耗25% current HP={expected_consume}，实际={actual_consume}")

        # 验证有 consume_hp effect
        consume_effects = [e for e in result["effects_applied"]
                           if e.get("effect_type") == "consume_hp"]
        self.assertGreater(len(consume_effects), 0, "应有 consume_hp effect")

    def test_as1_enemy_row_hits_3_targets(self):
        """AS1(120121) Block1: damage_special(enemy_row) 命中敌方前排3体。

        caster 在 ALLY_CENTER_BACK，enemy_row 选敌方前排3体(中前+左前+右前)。
        enemy_cb(中后)不在前排，不应受伤。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        hp_cf = self.enemy_cf.current_hp
        hp_lf = self.enemy_lf.current_hp
        hp_rf = self.enemy_rf.current_hp
        hp_cb = self.enemy_cb.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120121, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 前排3体受伤
        self.assertLess(self.enemy_cf.current_hp, hp_cf, "enemy_cf(前排)应受伤")
        self.assertLess(self.enemy_lf.current_hp, hp_lf, "enemy_lf(前排)应受伤")
        self.assertLess(self.enemy_rf.current_hp, hp_rf, "enemy_rf(前排)应受伤")
        # 中后不受伤
        self.assertEqual(self.enemy_cb.current_hp, hp_cb, "enemy_cb(后排)不应受伤")

    def test_as1_lv11_grants_shield_to_ally(self):
        """AS1(120121) Block2 (Lv11+): shield(ally_single, shield_base=consume_hp, attack_limited=1)。

        ally_single 通常选 caster 自身以外血量最低或最近的友方。本测试场景中 caster 之外
        仅有 ally_helper，因此 shield 应给到 ally_helper。shield buff 的 effect_type
        为 "Shield"（SkillEffectType.SHIELD.value，首字母大写）。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_helper()
        self.caster.level = 15
        self.caster.skill_levels[120121] = 15

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120121, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 验证 shield buff 给到了 ally_helper（ally_single 在 caster 之外选）
        shield_buffs = [b for b in self.ally_helper.buffs
                        if b.effect_type == "Shield"]
        self.assertGreater(len(shield_buffs), 0,
                           "Lv11+ Block2应付与 shield buff 到 ally_helper")
        self.assertEqual(getattr(shield_buffs[0], 'attack_limited', None), 1,
                         "shield应 attack_limited=1")

    def test_as1_lv10_no_shield(self):
        """AS1(120121) Lv10: 无 shield（Block2 active_level_min=11 未满足）。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        self._reset_ally_helper()
        self.caster.level = 10
        self.caster.skill_levels[120121] = 10

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120121, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 无 shield effect
        shield_effects = [e for e in result["effects_applied"]
                          if e.get("effect_type") == "shield"]
        self.assertEqual(len(shield_effects), 0, "Lv10不应有 shield effect")

    # ─── AS2: 120122 容疑者を捕捉！ ───

    def test_as2_applies_fuki_mark(self):
        """AS2(120122) Block1: 对目标列付与「風紀」mark(mark_name=風紀, stackable)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120122, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 至少有一个敌方获得風紀mark
        all_marks = []
        for e in self.bf.enemy_team:
            marks = [d for d in e.debuffs if d.effect_type == MARK
                     and d.name == "風紀"]
            all_marks.extend(marks)
        self.assertGreater(len(all_marks), 0, "应有至少1个風紀mark被付与")

    def test_as2_applies_action_damage_debuff(self):
        """AS2(120122) Block1: 对目标列付与 action_damage debuff(3 actions)。"""
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120122, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 至少有一个敌方获得 action_damage debuff
        all_action_damages = []
        for e in self.bf.enemy_team:
            ads = [d for d in e.debuffs if d.effect_type == ACTION_DAMAGE]
            all_action_damages.extend(ads)
        self.assertGreater(len(all_action_damages), 0, "应有至少1个 action_damage debuff")
        self.assertEqual(all_action_damages[0].duration, 3, "action_damage duration应为3")

    def test_as2_targets_lowest_mark_count_column(self):
        """AS2(120122) enemy_column_lowest_mark_count: 优先選擇風紀mark数最少的敌方所在列。

        场景：中前列(中前+中后) 已有風紀mark，左前列(左前)无mark。
        AS2应選左前列（mark数最少）。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 中前+中后预设風紀mark
        self._apply_mark(self.enemy_cf, "風紀", count=1)
        self._apply_mark(self.enemy_cb, "風紀", count=1)

        # 添加左后敌方（与左前同列），用于列索敌测试
        enemy_lb = UnitState(
            unit_id="enemy_lb", name="敵左後", side=Side.ENEMY,
            position=Position.ENEMY_LEFT_BACK, character_id=999005, level=10,
            element=2, character_type=1,
            max_hp=10000, current_hp=10000,
            attack=5000, defense=3000, speed=300,
            crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
            initial_active_point=4, initial_passive_point=4, max_extra_point=5,
            current_ap=4, current_pp=4, current_ep=1,
            skills=[], skill_levels={}, skill_cooldowns={},
        )
        self.bf.enemy_team.append(enemy_lb)

        hp_lf = self.enemy_lf.current_hp
        hp_lb = enemy_lb.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=120122, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # 左前列(左前+左后)无風紀mark → 应被选中获得mark和action_damage
        lf_marks = [d for d in self.enemy_lf.debuffs if d.effect_type == MARK
                    and d.name == "風紀"]
        lb_marks = [d for d in enemy_lb.debuffs if d.effect_type == MARK
                    and d.name == "風紀"]
        total_left_marks = len(lf_marks) + len(lb_marks)
        self.assertGreater(total_left_marks, 0,
                           "左前列(无風紀)应被AS2选中并获得風紀mark")

        # 清理临时敌方
        self.bf.enemy_team.remove(enemy_lb)

    # ─── PS1: 130129 抵抗は無意味です！ ───

    def test_ps1_triggers_on_3_skill_uses(self):
        """PS1(130129) on_skill_use_count: AS+EX使用3回後触発。

        通过手动设置 skill_use_count 模拟3次AS/EX使用。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 模拟3次AS/EX使用（120121=AS1, 110055=EX，skill_type=1/3）
        self.caster.skill_use_count = {120121: 2, 110055: 1}  # 共3次

        actions = self.ts.trigger_skill_use_count(
            actor=self.caster, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130129]
        self.assertGreater(len(ps1_actions), 0,
                           "AS+EX使用3回後PS1应被收集")

    def test_ps1_below_3_no_trigger(self):
        """PS1(130129) skill_use_count < 3 时不触発。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}

        # 仅2次使用（<3）
        self.caster.skill_use_count = {120121: 1, 110055: 1}  # 共2次

        actions = self.ts.trigger_skill_use_count(
            actor=self.caster, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130129]
        self.assertEqual(len(ps1_actions), 0,
                         "AS+EX使用2回(<3) → PS1不应被收集")

    def test_ps1_damage_uses_trigger_attack_target(self):
        """PS1(130129) Block1: damage(target_identifier=trigger_attack_target) 命中 primary_target。

        手动设置 _primary_target = enemy_lf，验证PS1伤害命中 enemy_lf 而非默认最近敌(enemy_cf)。
        """
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self.caster.skill_cooldowns = {}
        self.caster.skill_use_count = {120121: 3}  # 3次AS使用

        # 设置 _primary_target 为 enemy_lf（非最近敌）
        self.ss._primary_target = self.enemy_lf

        actions = self.ts.trigger_skill_use_count(
            actor=self.caster, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130129]
        self.assertGreater(len(ps1_actions), 0, "PS1应被收集")

        hp_lf_before = self.enemy_lf.current_hp
        hp_cf_before = self.enemy_cf.current_hp

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_skill_use_count"
        )

        # PS1伤害应命中 trigger_attack_target (enemy_lf)
        self.assertLess(self.enemy_lf.current_hp, hp_lf_before,
                        "PS1应命中 trigger_attack_target(enemy_lf)")
        # 清理 _primary_target
        self.ss._primary_target = None

    def test_ps1_lv11_grants_dmg_dealt_up_to_ally_all(self):
        """PS1(130129) Block2 (Lv11+): dmg_dealt_up(ally_all, 1 action, stackable)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self._reset_ally_helper()
        self.caster.level = 15
        self.caster.skill_levels[130129] = 15
        self.caster.skill_cooldowns = {}
        self.caster.skill_use_count = {120121: 3}

        self.ss._primary_target = self.enemy_cf

        actions = self.ts.trigger_skill_use_count(
            actor=self.caster, battlefield=self.bf
        )
        ps1_actions = [a for a in actions if a.skill_id == 130129]
        self.assertGreater(len(ps1_actions), 0, "PS1应被收集")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps1_actions, self.bf, trigger_timing="on_skill_use_count"
        )

        # 验证 ally_all 都获得 dmg_dealt_up buff
        # ally_all = caster 之外的所有友方（ally_helper 应获得）
        dmg_ups_helper = [b for b in self.ally_helper.buffs
                          if b.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dmg_ups_helper), 0,
                           "Lv11+ Block2应付与 ally_helper dmg_dealt_up buff")
        self.assertEqual(dmg_ups_helper[0].duration, 1, "dmg_dealt_up duration应为1")
        self.assertTrue(dmg_ups_helper[0].is_stackable, "dmg_dealt_up应可叠加")

        self.ss._primary_target = None

    # ─── PS2: 130130 風紀委員長としての矜持 ───

    def test_ps2_on_turn_start_triggers(self):
        """PS2(130130) on_turn_start: 回合开始时触発（ally_alive_count>1 满足）。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self._reset_ally_helper()
        self.caster.skill_cooldowns = {}
        self.bf.turn_number = 2

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130130]
        self.assertGreater(len(ps2_actions), 0, "PS2应在回合开始时被收集")

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证PS2已执行（caster 获得 stealth buff）
        stealth_buffs = [b for b in self.caster.buffs if b.effect_type == STEALTH]
        self.assertGreater(len(stealth_buffs), 0, "PS2执行后caster应有 stealth buff")

    def test_ps2_remove_all_buffs_and_debuffs(self):
        """PS2(130130) Block1: remove_all_buffs + remove_all_debuffs 解除自身全部 buff/debuff。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self._reset_ally_helper()
        self.caster.skill_cooldowns = {}
        self.bf.turn_number = 2

        # 预设一些 buff 和 debuff
        self.caster.buffs.append(BuffState(
            buff_id="test_buff", name="测试buff", effect_type="atk_up",
            value=10.0, duration=2, timing_type=2, is_debuff=False,
        ))
        self.caster.debuffs.append(BuffState(
            buff_id="test_debuff", name="测试debuff", effect_type="atk_down",
            value=10.0, duration=2, timing_type=2, is_debuff=True,
        ))
        self.assertEqual(len(self.caster.buffs), 1)
        self.assertEqual(len(self.caster.debuffs), 1)

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130130]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 原有 buff/debuff 应被清除（PS2付与的stealth/HOT/dmg_taken_down不算）
        old_buffs = [b for b in self.caster.buffs if b.buff_id == "test_buff"]
        old_debuffs = [d for d in self.caster.debuffs if d.buff_id == "test_debuff"]
        self.assertEqual(len(old_buffs), 0, "PS2应清除原有 buff")
        self.assertEqual(len(old_debuffs), 0, "PS2应清除原有 debuff")

    def test_ps2_stealth_applied_with_skill_duration(self):
        """PS2(130130) Block1: stealth(value=3, duration=3, duration_type=skill)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self._reset_ally_helper()
        self.caster.skill_cooldowns = {}
        self.bf.turn_number = 2

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130130]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        stealth_buffs = [b for b in self.caster.buffs if b.effect_type == STEALTH]
        self.assertEqual(len(stealth_buffs), 1, "应有1个 stealth buff")
        self.assertEqual(stealth_buffs[0].duration, 3, "stealth duration应为3")
        self.assertEqual(getattr(stealth_buffs[0], 'original_duration_type', ''),
                         'skill', "stealth original_duration_type应为 skill")
        self.assertFalse(stealth_buffs[0].is_debuff, "stealth应为 buff（is_debuff=False）")

    def test_ps2_hot_and_dmg_taken_down_linked_to_stealth(self):
        """PS2(130130) Block1: HOT + dmg_taken_down(linked_buff_id=Stealth, unremovable)。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        self._reset_ally_helper()
        self.caster.skill_cooldowns = {}
        self.bf.turn_number = 2

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130130]

        self.ss._pending_crit_triggers = []
        self.ss._execute_trigger_actions_inline(
            ps2_actions, self.bf, trigger_timing="on_turn_start"
        )

        # 验证 HOT buff
        hot_buffs = [b for b in self.caster.buffs if b.effect_type == HEAL_OVER_TIME]
        self.assertGreater(len(hot_buffs), 0, "应有 HOT buff")
        self.assertTrue(getattr(hot_buffs[0], 'unremovable', False),
                        "HOT应 unremovable=True")
        self.assertEqual(getattr(hot_buffs[0], 'linked_buff_id', None), 'Stealth',
                         "HOT应 linked_buff_id=Stealth")

        # 验证 dmg_taken_down buff
        dmg_taken_buffs = [b for b in self.caster.buffs
                           if b.effect_type == RECEIVED_DAMAGE]
        self.assertGreater(len(dmg_taken_buffs), 0, "应有 dmg_taken_down buff")
        self.assertTrue(getattr(dmg_taken_buffs[0], 'unremovable', False),
                        "dmg_taken_down应 unremovable=True")
        self.assertEqual(getattr(dmg_taken_buffs[0], 'linked_buff_id', None), 'Stealth',
                         "dmg_taken_down应 linked_buff_id=Stealth")
        # hp_ratio_dynamic_direct: value在施加时按HP比例冻结（满血时=原值）
        self.assertGreater(dmg_taken_buffs[0].value, 0,
                           "dmg_taken_down value应已按HP比例冻结（满血时应>0）")
        self.assertTrue(dmg_taken_buffs[0].is_stackable,
                        "dmg_taken_down应可叠加")

    def test_ps2_skipped_when_no_other_ally_alive(self):
        """PS2(130130) global_condition ally_alive_count>1: 自身以外无友方生存时不触発。"""
        self._reset_caster(hp=self.caster.max_hp, pp=10)
        self._reset_enemies()
        # 让 ally_helper 阵亡
        self.ally_helper.is_alive = False
        self.caster.skill_cooldowns = {}
        self.bf.turn_number = 2

        actions = self.ts.trigger_turn_start(self.bf)
        ps2_actions = [a for a in actions if a.skill_id == 130130]
        self.assertEqual(len(ps2_actions), 0,
                         "自身以外无友方生存 → PS2不应被收集")

        # 恢复
        self.ally_helper.is_alive = True

    # ═══════════════════════════════════════════════════════════
    # ─── stealth机制专项测试（项目规则11.11核心） ───
    # ═══════════════════════════════════════════════════════════

    def test_stealth_apply_redirection_moves_unit_to_end(self):
        """stealth: apply_stealth_redirection 将首位持ステルス单位移到末尾。"""
        # 构造候选列表：[stealth_unit, normal_unit1, normal_unit2]
        stealth_unit = self.enemy_cf
        normal_unit1 = self.enemy_lf
        normal_unit2 = self.enemy_rf
        self._apply_stealth(stealth_unit, duration=3, duration_type="skill")

        candidates = [stealth_unit, normal_unit1, normal_unit2]
        original_first = candidates[0]

        redirected = self.tgs.apply_stealth_redirection(candidates, consume=False)

        # stealth_unit 应被移到末尾
        self.assertEqual(len(redirected), 1, "应有1个单位被重定向")
        self.assertIn(id(stealth_unit), redirected, "stealth_unit应被重定向")
        self.assertNotEqual(candidates[0], original_first,
                            "首位不应再是 stealth_unit")
        self.assertEqual(candidates[-1], stealth_unit,
                         "stealth_unit应在末尾")
        # 候选数不变（移到末尾，非移除）
        self.assertEqual(len(candidates), 3, "候选数应保持3（移到末尾，非移除）")

    def test_stealth_unit_remains_in_candidates(self):
        """stealth: 被重定向的ステルス单位仍留在候选列表中（处于最低優先級）。"""
        stealth_unit = self.enemy_cf
        normal_unit = self.enemy_lf
        self._apply_stealth(stealth_unit, duration=3, duration_type="skill")

        candidates = [stealth_unit, normal_unit]
        self.tgs.apply_stealth_redirection(candidates, consume=False)

        # stealth_unit 仍在候选列表中
        self.assertIn(stealth_unit, candidates,
                      "stealth_unit应仍留在候选列表中（处于最低優先級）")
        self.assertEqual(candidates[-1], stealth_unit,
                         "stealth_unit应在末尾（最低優先級）")

    def test_stealth_chain_multiple_units(self):
        """stealth: 多个stealth单位连锁触发（依次移到末尾）。

        场景：[stealth_a, stealth_b, stealth_c, normal]
        → stealth_a 移到末尾 → [stealth_b, stealth_c, normal, stealth_a]
        → stealth_b 移到末尾 → [stealth_c, normal, stealth_a, stealth_b]
        → stealth_c 移到末尾 → [normal, stealth_a, stealth_b, stealth_c]
        最终首位是 normal。
        """
        stealth_a = self.enemy_cf
        stealth_b = self.enemy_lf
        stealth_c = self.enemy_rf
        normal = self.enemy_cb
        self._apply_stealth(stealth_a, duration=3, duration_type="skill")
        self._apply_stealth(stealth_b, duration=3, duration_type="skill")
        self._apply_stealth(stealth_c, duration=3, duration_type="skill")

        candidates = [stealth_a, stealth_b, stealth_c, normal]
        redirected = self.tgs.apply_stealth_redirection(candidates, consume=False)

        # 3个 stealth 单位都被重定向
        self.assertEqual(len(redirected), 3, "应有3个stealth单位被重定向")
        # 最终首位是 normal（非stealth）
        self.assertEqual(candidates[0], normal,
                         "连锁触发后首位应是 normal（非stealth）")
        # 3个 stealth 单位都在末尾
        self.assertIn(stealth_a, candidates[1:])
        self.assertIn(stealth_b, candidates[1:])
        self.assertIn(stealth_c, candidates[1:])

    def test_stealth_single_candidate_triggers(self):
        """stealth: 候选数不足（甚至只有1个）也触发。

        场景：仅1个候选且持ステルス → 触发重定向（移到末尾=原地不动）。
        """
        stealth_unit = self.enemy_cf
        self._apply_stealth(stealth_unit, duration=3, duration_type="skill")

        candidates = [stealth_unit]
        redirected = self.tgs.apply_stealth_redirection(candidates, consume=False)

        # 即使只有1个候选，stealth 仍触发
        self.assertEqual(len(redirected), 1, "候选数=1时stealth仍应触发")
        self.assertIn(id(stealth_unit), redirected)
        # 候选列表不变（移到末尾=原地不动）
        self.assertEqual(len(candidates), 1)
        self.assertEqual(candidates[0], stealth_unit)

    def test_stealth_prescan_no_consume(self):
        """stealth: prescan (consume=False) 不消耗 duration。"""
        stealth_unit = self.enemy_cf
        self._apply_stealth(stealth_unit, duration=3, duration_type="skill")
        duration_before = stealth_unit.buffs[0].duration

        candidates = [stealth_unit, self.enemy_lf]
        self.tgs.apply_stealth_redirection(candidates, consume=False)

        # duration 不变（prescan不消耗）
        duration_after = stealth_unit.buffs[0].duration
        self.assertEqual(duration_after, duration_before,
                         "prescan(consume=False)不应消耗duration")
        self.assertEqual(duration_after, 3, "duration仍应为3")

    def test_stealth_skill_type_consumes_duration(self):
        """stealth: duration_type=skill 时被选为主目标消耗1点duration。

        PS2(130130) 的 stealth duration_type=skill，触发时 duration-1。
        """
        stealth_unit = self.enemy_cf
        self._apply_stealth(stealth_unit, duration=3, duration_type="skill")
        duration_before = stealth_unit.buffs[0].duration

        candidates = [stealth_unit, self.enemy_lf]
        self.tgs.apply_stealth_redirection(candidates, consume=True)

        # duration 应减1（skill type 消耗）
        duration_after = stealth_unit.buffs[0].duration
        self.assertEqual(duration_after, duration_before - 1,
                         "skill type stealth触发应消耗1点duration")
        self.assertEqual(duration_after, 2, "duration应从3减到2")

    def test_stealth_action_type_no_consume(self):
        """stealth: duration_type=action 时触发不消耗 duration。

        action type 的 duration 仅由 AuraService 在持有者行动结束时递减。
        """
        stealth_unit = self.enemy_cf
        self._apply_stealth(stealth_unit, duration=2, duration_type="action")
        duration_before = stealth_unit.buffs[0].duration

        candidates = [stealth_unit, self.enemy_lf]
        self.tgs.apply_stealth_redirection(candidates, consume=True)

        # duration 不变（action type 不消耗）
        duration_after = stealth_unit.buffs[0].duration
        self.assertEqual(duration_after, duration_before,
                         "action type stealth触发不应消耗duration")
        self.assertEqual(duration_after, 2, "duration仍应为2")

    def test_stealth_skill_type_expires_when_duration_zero(self):
        """stealth: skill type duration 减到0时移除buff。"""
        stealth_unit = self.enemy_cf
        # duration=1，触发后应减到0并移除
        self._apply_stealth(stealth_unit, duration=1, duration_type="skill")

        candidates = [stealth_unit, self.enemy_lf]
        self.tgs.apply_stealth_redirection(candidates, consume=True)

        # duration 减到0 → buff 被移除
        stealth_buffs = [b for b in stealth_unit.buffs if b.effect_type == STEALTH]
        self.assertEqual(len(stealth_buffs), 0,
                         "skill type stealth duration=0时应被移除")

    def test_stealth_select_min_with_stealth(self):
        """stealth: select_min_with_stealth 升序排序后重定向，返回首位。"""
        # 构造3个候选，按某个key排序后 stealth_unit 应在首位（key最小）
        # 但因 stealth 重定向，应返回 normal_unit
        stealth_unit = self.enemy_cf
        normal_unit = self.enemy_lf
        another_normal = self.enemy_rf
        self._apply_stealth(stealth_unit, duration=3, duration_type="skill")

        # key_func: 按 max_hp 升序（stealth_unit max_hp=30000 应排首位）
        candidates = [stealth_unit, normal_unit, another_normal]
        result = self.tgs.select_min_with_stealth(
            candidates,
            key_func=lambda u: u.max_hp,
            consume=False
        )

        # stealth_unit (max_hp=30000) 本应排首位，但因 stealth 重定向，
        # 返回的应是 normal_unit (max_hp=15000) 或 another_normal (max_hp=12000)
        # 升序排序后 another_normal(12000) < normal_unit(15000) < stealth_unit(30000)
        # stealth_unit 被移到末尾 → 首位是 another_normal
        self.assertIsNotNone(result, "应返回非None结果")
        self.assertNotEqual(result, stealth_unit,
                            "stealth_unit不应被选为首位（被重定向到末尾）")

    def test_stealth_select_max_with_stealth(self):
        """stealth: select_max_with_stealth 降序排序后重定向，返回首位。"""
        stealth_unit = self.enemy_cf  # max_hp=30000
        normal_unit = self.enemy_lf  # max_hp=15000
        another_normal = self.enemy_rf  # max_hp=12000
        self._apply_stealth(stealth_unit, duration=3, duration_type="skill")

        # key_func: 按 max_hp 降序（stealth_unit max_hp=30000 应排首位）
        candidates = [stealth_unit, normal_unit, another_normal]
        result = self.tgs.select_max_with_stealth(
            candidates,
            key_func=lambda u: u.max_hp,
            consume=False
        )

        # 降序排序后 stealth_unit(30000) > normal_unit(15000) > another_normal(12000)
        # stealth_unit 被重定向 → 首位是 normal_unit(15000)
        self.assertIsNotNone(result, "应返回非None结果")
        self.assertNotEqual(result, stealth_unit,
                            "stealth_unit不应被选为首位（被重定向到末尾）")
        self.assertEqual(result, normal_unit,
                         "降序排序后stealth被重定向，首位应是 normal_unit")

    def test_stealth_ex_skips_stealth_enemy_as_primary(self):
        """stealth: EX(110055) enemy_single_highest_hp_ratio 索敌跳过持ステルス敌方。

        场景：enemy_cf(HP割合100%, max_hp=30000) 持ステルス，
        enemy_cb(HP割合100%, max_hp=20000) 无ステルス。
        EX 本应选 enemy_cf（HP割合最高+距离近），但因 stealth 重定向，
        应选 enemy_cb 或其他非stealth单位作为主目标。
        """
        self._reset_caster(hp=self.caster.max_hp)
        self._reset_enemies()
        # 给 enemy_cf 施加 stealth
        self._apply_stealth(self.enemy_cf, duration=3, duration_type="skill")

        hp_cf_before = self.enemy_cf.current_hp
        hp_cb_before = self.enemy_cb.current_hp

        result = self.ss.execute_skill(
            caster=self.caster, skill_id=110055, battlefield=self.bf, skip_cost=True
        )
        self.assertTrue(result["success"])

        # enemy_cf 持ステルス → 不应被选为主目标（HP未减少或减少较少）
        # 注意：enemy_cf 仍可能在 adjacent_enemies 中受伤（adjacent 不受 stealth 影响）
        # 主目标应是其他非stealth单位

        # 验证：至少有一个非stealth敌方受到主攻击伤害
        # enemy_cb(中后) 不邻接中前，不会因 adjacent_enemies 受伤
        # 如果 enemy_cf 被跳过，主目标可能是 enemy_cb(HP割合次高)
        # 但 enemy_cb 在后排，距离更远，需检查实际选择

        # 关键验证：stealth buff 应被消耗（skill type 被选为主目标时消耗1点）
        stealth_buffs = [b for b in self.enemy_cf.buffs if b.effect_type == STEALTH]
        if stealth_buffs:
            # stealth 仍在 → 说明 enemy_cf 未被选为主目标（stealth 触发后移到末尾）
            # 但 stealth 应已触发（消耗1点 duration）
            self.assertLessEqual(stealth_buffs[0].duration, 3,
                                 "stealth应已触发消耗（或未被选为主目标）")

    def test_stealth_no_stealth_no_redirection(self):
        """stealth: 候选无ステルス时 apply_stealth_redirection 不做任何操作。"""
        # 所有候选都无 stealth
        candidates = [self.enemy_cf, self.enemy_lf, self.enemy_rf]

        redirected = self.tgs.apply_stealth_redirection(candidates, consume=True)

        # 无重定向
        self.assertEqual(len(redirected), 0, "无stealth时不应有重定向")
        # 候选列表顺序不变
        self.assertEqual(candidates[0], self.enemy_cf)
        self.assertEqual(candidates[1], self.enemy_lf)
        self.assertEqual(candidates[2], self.enemy_rf)

    def test_stealth_already_triggered_unit_not_retrigger(self):
        """stealth: 同一单位在一次 apply_stealth_redirection 调用中只触发一次（防死循环）。

        场景：duration=2 的 stealth 单位在候选中。
        即使移到末尾后仍是首位（只有1个候选），也不会重复触发。
        """
        stealth_unit = self.enemy_cf
        self._apply_stealth(stealth_unit, duration=2, duration_type="skill")

        # 仅1个候选，stealth 触发后移到末尾=原地不动
        # 但 triggered 集合应阻止重复触发
        candidates = [stealth_unit]
        redirected = self.tgs.apply_stealth_redirection(candidates, consume=True)

        # 仅触发1次（triggered 集合阻止死循环）
        self.assertEqual(len(redirected), 1, "应仅触发1次（triggered集合防死循环）")
        # duration 仅减1（不是减多次）
        stealth_buffs = [b for b in stealth_unit.buffs if b.effect_type == STEALTH]
        self.assertEqual(stealth_buffs[0].duration, 1,
                         "duration应从2减到1（仅触发1次）")


if __name__ == "__main__":
    unittest.main(verbosity=2)
