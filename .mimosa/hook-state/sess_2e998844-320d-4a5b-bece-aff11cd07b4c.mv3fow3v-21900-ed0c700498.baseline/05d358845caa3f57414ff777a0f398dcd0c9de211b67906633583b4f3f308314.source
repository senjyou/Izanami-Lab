# -*- coding: utf-8 -*-
"""rdps归因实验：固值ATK buff（模拟30042/400258） vs DealtDamage buff（模拟30006/400054）

检查两种buff在单次主伤害归因中是否获得应有的贡献。
"""
import sys, os, logging
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
os.chdir(os.path.join(os.path.dirname(__file__), '..'))

logging.basicConfig(level=logging.WARNING)

from tests.helpers.battle_builder import BattleBuilder
from src.entities_v2.enums import Position
from src.entities_v2.unit_state import BuffState

bb = BattleBuilder()
bb.add_ally(unit_id="c1", position=Position.ALLY_CENTER_FRONT,
            hp=80000, atk=10000, defense=4000, speed=500, skills=[], crit_rate=5.0)
bb.add_enemy(unit_id="e1", position=Position.ENEMY_CENTER_FRONT,
             hp=500000, atk=5000, defense=5000, speed=400, skills=[])
ctx = bb.build()
bf, ss, ts = ctx['bf'], ctx['ss'], ctx['ts']

rdps = getattr(bf, 'rdps_tracker', None) or getattr(ss, 'rdps_tracker', None)
if rdps is None:
    # 从flow controller找
    from src.combat_v2.rdps_tracker import RDPSTracker
    rdps = RDPSTracker(damage_service=ss.damage_service if hasattr(ss, 'damage_service') else None)
    rdps.set_battlefield(bf)
    rdps.enable_tracking()
print("tracker found:", rdps is not None)

caster = bf.friend_team[0]
enemy = bf.enemy_team[0]

def make_buff(name, effect_type, value, value_tag, skill_id):
    b = BuffState(buff_id=f"test_{name}", name=name, effect_type=effect_type,
                  value=value, duration=-1, timing_type=2, value_tag=value_tag,
                  source_unit_id="", source_skill_id=skill_id, is_memory_buff=True)
    return b

# 场景1：固值ATK+1250（模拟400258）
buff_atk = make_buff("メモリ攻上", "StatusAttack", 1250, 1, 400258)
caster.buffs.append(buff_atk)
rdps.register_card_skill(30042, 400258)
rdps.register_card_skill(30042, 400259)

from src.combat_v2.services.damage_service import DamageService
ds = ss.damage_service if hasattr(ss, 'damage_service') else None
assert ds is not None, "battle builder未提供damage_service"

class _SK:
    power = 100.0
    hit_count = 1
    element = None
    ignore_defense = 0
    ignore_shield = 0
    name = "test_attack"

# 直接调用主伤害流程（execute_skill会走record_damage_with_attribution）
# 找一个无技能的基础攻击：用damage_service直接算并记录
res = ds.calculate_damage(attacker=caster, defender=enemy, skill_data=_SK())
print("\n=== 场景1: 固值ATK+1250 ===")
print(f"actual_damage={res.total_damage}, calc atk={res.calc_detail.get('atk')}")
rdps.record_damage_with_attribution(caster=caster, target=enemy,
                                    actual_damage=res.total_damage, dmg_result=res,
                                    damage_type="main", battlefield=bf, damage_service=ds)
r = rdps.build_result()
print(f"c1: direct={r.unit_stats['c1'].direct_damage:.0f} buff={r.unit_stats['c1'].buff_contribution:.0f}")
print(f"card30042: buff={r.memory_card_stats.get(30042).buff_contribution:.0f}" if 30042 in r.memory_card_stats else "card30042: 无记录!")

# 打印tracking日志关键行
for line in rdps.get_tracking_log():
    if any(k in line for k in ('baseline', 'bonus', 'zone:', 'buff_attr', '-> ', 'direct', 'weight', 'StatusAttack')):
        print(" ", line)
