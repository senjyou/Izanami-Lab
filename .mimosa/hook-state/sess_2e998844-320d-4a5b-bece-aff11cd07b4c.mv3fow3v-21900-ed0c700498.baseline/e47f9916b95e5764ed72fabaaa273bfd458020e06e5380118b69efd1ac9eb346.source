# -*- coding: utf-8 -*-
"""战术演习得分统计测试：Roll5期望公式 + 每1000万（1kw）一档区间分布 + 结果渲染"""
import itertools

import pytest

from gui.tabs.tactical_exercise import TacticalExerciseTab


def _zeros(n):
    return [0.0] * n


def _make_tab():
    # 不启动 Tk，仅调用纯统计/渲染方法
    return object.__new__(TacticalExerciseTab)


class TestRoll5Expectation:
    def test_brute_force_equivalence(self):
        """Roll5期望 = 经验分布5次独立抽样最大值的期望（与暴力枚举对照）"""
        tab = _make_tab()
        small = [10.0, 20.0, 30.0, 40.0, 50.0]
        stats = tab._compute_score_statistics(small, *[_zeros(5)] * 7)
        brute = sum(max(c) for c in itertools.product(small, repeat=5)) / 5 ** 5
        assert stats["roll5_mean"] == pytest.approx(brute)

    def test_roll5_not_below_mean(self):
        tab = _make_tab()
        scores = [100.0, 200.0, 300.0]
        stats = tab._compute_score_statistics(scores, *[_zeros(3)] * 7)
        assert stats["roll5_mean"] >= stats["mean_score"]

    def test_single_sample(self):
        tab = _make_tab()
        stats = tab._compute_score_statistics([50.0], *[_zeros(1)] * 7)
        assert stats["roll5_mean"] == pytest.approx(50.0)


class TestScoreDistribution:
    BUCKET = 10_000_000

    def test_distribution_buckets(self):
        """区间连续升序、档宽对齐1000万、计数守恒、0分与高分正确归档"""
        tab = _make_tab()
        scores = [0.0, 15_000_000.0, 123_456_789.0, 250_000_000.0]
        stats = tab._compute_score_statistics(scores, *[_zeros(4)] * 7)
        dist = stats["score_distribution"]
        assert stats["bucket_size"] == self.BUCKET
        assert sum(c for _, c in dist) == len(scores)
        assert all(lo % self.BUCKET == 0 for lo, _ in dist)
        los = [lo for lo, _ in dist]
        assert los == list(range(los[0], los[-1] + self.BUCKET, self.BUCKET))
        counts = dict(dist)
        assert counts[0] == 1
        assert counts[10_000_000] == 1
        assert counts[250_000_000] == 1
        assert counts[120_000_000] == 1


class TestScoreBucketFormat:
    def test_format_score_count(self):
        assert TacticalExerciseTab._format_score_count(10_000_000) == "1,000万"
        assert TacticalExerciseTab._format_score_count(100_000_000) == "1亿"
        assert TacticalExerciseTab._format_score_count(130_000_000) == "1.3亿"

    def test_format_score_bucket(self):
        assert TacticalExerciseTab._format_score_bucket(0, 10_000_000) == "0万~1,000万"
        assert TacticalExerciseTab._format_score_bucket(120_000_000, 10_000_000) == "1.2亿~1.3亿"


class TestMultiScoreDisplay:
    def test_display_contains_new_sections(self):
        tab = _make_tab()
        scores = [0.0, 15_000_000.0, 105_000_000.0, 135_000_000.0, 135_000_000.0]
        stats = tab._compute_score_statistics(scores, *[_zeros(5)] * 7)
        out = []
        tab._append_multi_score_display(out, stats, len(scores), None)
        text = "\n".join(out)
        assert "Roll5期望" in text
        assert "得分区间分布" in text
        assert "0万~1,000万" in text
        assert "1.3亿~1.4亿" in text
