# -*- coding: utf-8 -*-
"""AccountRegistry 单元测试：注册表、旧版迁移、账号包导入导出、路径安全。

全部基于 tmp_path 隔离，不触碰真实 %APPDATA%；文件构造一律走
atomic_write_text（与实现相同的原子写原语）。
"""
import json
import shutil
from pathlib import Path

import pytest

from src.utils.account_manager import (
    AccountError,
    AccountRegistry,
    atomic_write_text,
    sanitize_account_name,
)

BUNDLE_SCHEMA = "izanami-account"


def make_registry(tmp_path) -> AccountRegistry:
    return AccountRegistry(app_root=tmp_path / "Izanami Lab")


def write_json(path: Path, data) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    atomic_write_text(path, json.dumps(data, ensure_ascii=False))


def read_json(path: Path):
    return json.loads(path.read_text(encoding="utf-8"))


def make_legacy_sibling(tmp_path: Path, name: str) -> Path:
    sib = tmp_path / name
    write_json(sib / "global_config.json", {"lv": 406})
    write_json(sib / "char_config.json", {})
    write_json(sib / "presets" / "team.json", {"team": 1})
    write_json(sib / "ui_config.json", {"theme": "dark"})
    return sib


# ─────────────────── 活动目录解析 ───────────────────

def test_fallback_to_app_root_without_registry(tmp_path):
    reg = make_registry(tmp_path)
    assert reg.get_active_dir() == reg.app_root


def test_get_active_dir_after_migration(tmp_path):
    reg = make_registry(tmp_path)
    write_json(reg.app_root / "global_config.json", {})
    reg.ensure_root_migrated()
    assert reg.get_active_dir() == reg.accounts_root / "主号"


def test_corrupt_registry_quarantined_and_fallback(tmp_path):
    reg = make_registry(tmp_path)
    reg.app_root.mkdir(parents=True, exist_ok=True)
    atomic_write_text(reg.app_root / "accounts.json", "{not json")
    assert reg.get_active_dir() == reg.app_root
    assert len(list(reg.app_root.glob("accounts.json.corrupt-*"))) == 1
    # 隔离后注册表视同缺失，后续写入从空注册表开始
    assert reg.list_accounts() == []


# ─────────────────── 首次迁移 ───────────────────

def test_root_migration_moves_account_files_keeps_global(tmp_path):
    reg = make_registry(tmp_path)
    root = reg.app_root
    write_json(root / "global_config.json", {"lv": 406})
    write_json(root / "char_config.json", {})
    write_json(root / "presets" / "p1.json", {"a": 1})
    write_json(root / "ui_config.json", {"theme": "dark"})
    write_json(root / "update" / "cold_staging" / "log.txt", "x")

    pending = reg.ensure_root_migrated()
    assert pending == []
    acc_dir = reg.accounts_root / "主号"
    assert read_json(acc_dir / "global_config.json") == {"lv": 406}
    assert (acc_dir / "presets" / "p1.json").exists()
    # 全局项（ui_config / update）留在应用根
    assert (root / "ui_config.json").exists()
    assert (root / "update" / "cold_staging" / "log.txt").exists()
    assert not (root / "global_config.json").exists()
    assert reg.get_current_name() == "主号"


def test_root_migration_is_idempotent(tmp_path):
    reg = make_registry(tmp_path)
    write_json(reg.app_root / "global_config.json", {})
    reg.ensure_root_migrated()
    assert reg.ensure_root_migrated() == []
    assert [a["name"] for a in reg.list_accounts()] == ["主号"]


def test_root_migration_with_registry_returns_pending_siblings(tmp_path):
    reg = make_registry(tmp_path)
    write_json(reg.app_root / "global_config.json", {})
    reg.ensure_root_migrated()
    sib = make_legacy_sibling(tmp_path, "Izanami Lab【小号】")
    assert reg.ensure_root_migrated() == [sib]


def test_root_migration_failure_keeps_no_registry(tmp_path, monkeypatch):
    reg = make_registry(tmp_path)
    write_json(reg.app_root / "global_config.json", {})

    def boom(src, dst):
        raise RuntimeError("disk full")

    monkeypatch.setattr(shutil, "move", boom)
    with pytest.raises(RuntimeError):
        reg.ensure_root_migrated()
    # 注册表未写入 → 下次启动回退应用根并自动重试
    assert not (reg.app_root / "accounts.json").exists()
    assert AccountRegistry(reg.app_root).get_active_dir() == reg.app_root


# ─────────────────── 旧版文件夹扫描与导入 ───────────────────

def test_scan_legacy_folders(tmp_path):
    reg = make_registry(tmp_path)
    sib = make_legacy_sibling(tmp_path, "Izanami Lab【小号】")
    empty = tmp_path / "Izanami Lab【空】"
    empty.mkdir()
    assert sib in reg.scan_legacy_folders()
    assert empty not in reg.scan_legacy_folders()


def test_legacy_folder_display_name():
    assert AccountRegistry.legacy_folder_display_name(
        Path("Izanami Lab【340+】")) == "340+"
    assert AccountRegistry.legacy_folder_display_name(Path("Izanami Lab")) == "Izanami Lab"


def test_import_legacy_folder(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    sib = make_legacy_sibling(tmp_path, "Izanami Lab【小号】")

    name = reg.import_legacy_folder(sib)
    assert name == "小号"
    assert not sib.exists()
    acc_dir = reg.get_account_dir("小号")
    assert read_json(acc_dir / "global_config.json") == {"lv": 406}
    assert (acc_dir / "presets" / "team.json").exists()
    # 全局项不随账号迁移
    assert not (acc_dir / "ui_config.json").exists()


def test_import_legacy_failure_keeps_source(tmp_path, monkeypatch):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    sib = make_legacy_sibling(tmp_path, "Izanami Lab【小号】")

    def boom(src, dst):
        raise RuntimeError("disk full")

    monkeypatch.setattr(AccountRegistry, "_copy_tree", staticmethod(boom))
    with pytest.raises(AccountError):
        reg.import_legacy_folder(sib)
    # 源目录原样保留，账号未登记，半成品目录已清理
    assert read_json(sib / "global_config.json") == {"lv": 406}
    assert [a["name"] for a in reg.list_accounts()] == ["主号"]
    assert not (reg.accounts_root / "小号").exists()


def test_import_legacy_duplicate_name_suffix(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("小号")
    sib = make_legacy_sibling(tmp_path, "Izanami Lab【小号】")
    assert reg.import_legacy_folder(sib) == "小号(2)"


# ─────────────────── 增删改名 ───────────────────

def test_create_rename_delete(tmp_path):
    reg = make_registry(tmp_path)
    assert reg.create_account("主号") == "主号"
    name = reg.create_account("新号")
    assert name == "新号"
    acc_dir = reg.get_account_dir("新号")
    assert acc_dir.is_dir()
    for sub in ("presets", "tactical_presets", "crit_sequences"):
        assert (acc_dir / sub).is_dir()
    # 新建不自动切换当前账号
    assert reg.get_current_name() is None

    assert reg.rename_account("新号", "改名的号") == "改名的号"
    # 目录名不变，仅注册表显示名变化
    assert [a["dir"] for a in reg.list_accounts()] == ["主号", "新号"]

    reg.delete_account("改名的号")
    assert [a["name"] for a in reg.list_accounts()] == ["主号"]
    assert not acc_dir.exists()


def test_rename_follows_current(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    reg.create_account("小号")
    reg.set_current("小号")
    reg.rename_account("小号", "备用")
    assert reg.get_current_name() == "备用"


def test_set_note(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    reg.set_note("主号", "练度最全")
    assert reg.list_accounts()[0]["note"] == "练度最全"
    # 空白视为清除备注
    reg.set_note("主号", "   ")
    assert reg.list_accounts()[0]["note"] == ""
    with pytest.raises(AccountError):
        reg.set_note("不存在", "x")


def test_delete_current_forbidden(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    reg.create_account("小号")
    reg.set_current("小号")
    with pytest.raises(AccountError):
        reg.delete_account("小号")


def test_delete_last_forbidden(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    data = reg._read()
    data["current"] = None
    reg._write(data)
    with pytest.raises(AccountError):
        reg.delete_account("主号")


def test_create_duplicate_name_rejected(tmp_path):
    reg = make_registry(tmp_path)
    assert reg.create_account("小号") == "小号"
    with pytest.raises(AccountError):
        reg.create_account("小号")
    # 导入路径才做自动后缀（见 import 用例）


def test_sanitize_name():
    assert sanitize_account_name('a/b*c?d"e<f>g|h') == "a_b_c_d_e_f_g_h"
    assert sanitize_account_name("  名字. ") == "名字"
    assert sanitize_account_name("") == "account"
    assert sanitize_account_name("..") == "account"


def test_set_current_unknown_raises(tmp_path):
    reg = make_registry(tmp_path)
    with pytest.raises(AccountError):
        reg.set_current("不存在")


def test_invalid_dir_in_registry_rejected(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    reg.create_account("小号")
    data = reg._read()
    AccountRegistry._find(data, "小号")["dir"] = "../escape"
    reg._write(data)
    with pytest.raises(AccountError):
        reg.delete_account("小号")
    # dir 非法的账号不参与活动目录解析
    assert reg.get_active_dir() == reg.accounts_root / "主号"


def test_touch_current_updates_last_used(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    reg.set_current("主号")
    reg.touch_current()
    acc = reg.list_accounts()[0]
    assert acc["last_used"]


# ─────────────────── 账号包导入导出 ───────────────────

def test_export_import_roundtrip(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    acc_dir = reg.get_account_dir("主号")
    write_json(acc_dir / "global_config.json", {"lv": 406})
    write_json(acc_dir / "presets" / "a.json", {"x": 1})

    bundle = tmp_path / "out" / "主号.account.json"
    reg.export_account("主号", bundle)
    data = read_json(bundle)
    assert data["schema"] == BUNDLE_SCHEMA
    assert data["name"] == "主号"
    assert set(data["files"]) == {"global_config.json", "presets/a.json"}

    final = reg.import_account(bundle)
    assert final == "主号(2)"
    acc2 = reg.get_account_dir(final)
    assert read_json(acc2 / "global_config.json") == {"lv": 406}
    assert read_json(acc2 / "presets" / "a.json") == {"x": 1}


def test_import_bundle_rejects_traversal(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    bundle = tmp_path / "evil.account.json"
    atomic_write_text(bundle, json.dumps({
        "schema": BUNDLE_SCHEMA, "schema_version": 1, "name": "evil",
        "files": {"../evil.json": "{}"},
    }))
    with pytest.raises(AccountError):
        reg.import_account(bundle)
    assert not (tmp_path / "evil.json").exists()
    assert not (reg.accounts_root / "evil").exists()


def test_import_bundle_rejects_bad_schema(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("主号")
    bundle = tmp_path / "bad.account.json"
    write_json(bundle, {"schema": "other", "files": {}})
    with pytest.raises(AccountError):
        reg.import_account(bundle)


def test_import_bundle_duplicate_name_suffix(tmp_path):
    reg = make_registry(tmp_path)
    reg.create_account("小号")
    bundle = tmp_path / "b.account.json"
    write_json(bundle, {"schema": BUNDLE_SCHEMA, "schema_version": 1,
                        "name": "小号", "files": {"global_config.json": "{}"}})
    assert reg.import_account(bundle) == "小号(2)"
