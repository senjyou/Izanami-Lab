# -*- coding: utf-8 -*-
"""复现火沙耶主c vs 主c2 rdps归因差异（30006 vs 30042）

用batch_simulator相同逻辑构造队伍，各跑N场战斗，对比：
1. 两配置的平均总分
2. rdps中30042/30006的平均贡献
3. 单位级rdps明细（定位归因缺口）
"""
import sys, os, json, logging, random
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..', 'src'))
os.chdir(os.path.join(os.path.dirname(__file__), '..'))

logging.basicConfig(level=logging.WARNING)

from src.utils.batch_simulator import _create_unit_worker, _create_tactical_enemy_worker, _compute_max_ep_worker, _silence_worker_battle_logging
_silence_worker_battle_logging()
from src.data.data_loader import DataLoader
from src.data.stat_calculator import StatCalculator
from src.config.panel_config import PanelConfig
from src.config.player_config import SchoolLevels
from src.config.character_config import ModuleConfig
from src.entities.memory_card import MemoryCard, MemoryHighlight
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position
from src.combat_v2.tactical_exercise_controller import TacticalExerciseController
from src.combat_v2.battle_flow_controller import BattleConfig

ACCOUNT_DIR = r"C:\Users\ARIS\AppData\Roaming\Izanami Lab\accounts\主号"

FRIEND_POSITIONS = [100303, None, 132301, 145301, 112302, 111301]
GRID = [Position.ALLY_LEFT_FRONT, Position.ALLY_CENTER_FRONT, Position.ALLY_RIGHT_FRONT,
        Position.ALLY_LEFT_BACK, Position.ALLY_CENTER_BACK, Position.ALLY_RIGHT_BACK]

dl = DataLoader()
dl.load_all()
sc = StatCalculator(dl.load_level_lerp_data(), data_loader=dl)

# ── 全局配置（镜像 gui._build_panel_config_from_gui） ──
with open(os.path.join(ACCOUNT_DIR, "global_config.json"), "r", encoding="utf-8") as f:
    gv = json.load(f)
with open(os.path.join(ACCOUNT_DIR, "char_config.json"), "r", encoding="utf-8") as f:
    char_cfgs = json.load(f)

panel = PanelConfig(
    character_level=gv["character_level"],
    school_levels=SchoolLevels(**gv["school_levels"]),
    equipment_enabled=True,
    equipment_bonuses=gv["equipment"],
)

def get_module_type_ids(char_type):
    return [int(f"{char_type}1"), int(f"{char_type}2"), int(f"{char_type}3")]

for cid in [c for c in FRIEND_POSITIONS if c]:
    char = dl.get_character_by_id(cid)
    tid = get_module_type_ids(char.character_type)
    cfg = char_cfgs.get(str(cid), {"override": False})
    skills = dl.load_character_skills().get(cid, [])
    if cfg.get("override"):
        panel.rarities[cid] = cfg.get("rarity", 14)
        panel.affection_levels[cid] = cfg.get("affection", 40)
        panel.character_levels[cid] = cfg.get("level", gv["character_level"])
        per_stat_tiers = [cfg.get("mod_tier_hp", cfg.get("mod_tier", 10)),
                          cfg.get("mod_tier_atk", cfg.get("mod_tier", 10)),
                          cfg.get("mod_tier_def", cfg.get("mod_tier", 10))]
        per_stat_levels = [cfg.get("mod_level_hp", cfg.get("mod_level", 55)),
                           cfg.get("mod_level_atk", cfg.get("mod_level", 55)),
                           cfg.get("mod_level_def", cfg.get("mod_level", 55))]
        gear = cfg.get("gear", [])
        panel.modules[cid] = [
            ModuleConfig(module_id=mid, tier=per_stat_tiers[g], level=per_stat_levels[g],
                         gear_effects=[x for x in gear if x.get("group", 0) == g])
            for g, mid in enumerate(tid)
        ]
        saved = cfg.get("skill_levels", {})
        panel.skill_levels[cid] = {
            sid: saved.get(sid, saved.get(str(sid), cfg.get("skill_level", 15)))
            for sid in skills
        }
    else:
        panel.rarities[cid] = gv["default_rarity"]
        panel.affection_levels[cid] = gv["default_affection"]
        panel.modules[cid] = [
            ModuleConfig(module_id=mid, tier=gv["default_mod_tier_hp"], level=gv["default_mod_level_hp"],
                         gear_effects=[x for x in gv.get("default_gear", []) if x.get("group", 0) == g])
            for g, mid in enumerate(tid)
        ]
        panel.skill_levels[cid] = {sid: gv["default_skill_level"] for sid in skills}

player_config = panel.get_player_config()

enemy_data = dl.load_tactical_exercise_enemies().get(381305)
enemy_pos = Position.ENEMY_CENTER_FRONT

CARD_NAMES = {}

def build_cards(card_id):
    md = dl.get_memory(card_id)
    CARD_NAMES[card_id] = md.name
    hls = [MemoryHighlight(
        character_attribute=h.character_attribute, character_base_master_id=h.character_base_master_id,
        character_master_id=h.character_master_id, character_role=h.character_role,
        character_team_master_id=h.character_team_master_id, character_type=h.character_type,
        is_targeting_friendly_party=h.is_targeting_friendly_party,
        party_position=h.party_position, skill_master_id=h.skill_master_id)
        for h in md.highlights]
    return [MemoryCard(card_id=md.memory_id, name=md.name, description=md.description,
                       rarity=md.rarity, highlights=hls)]

OTHER_CARDS = [30031, 30025, 30013, 20041, 30007]

def make_cards(card_id):
    return build_cards(card_id) + sum([build_cards(c) for c in OTHER_CARDS], [])

def run_one(card_id, seed):
    random.seed(seed)
    bf = BattlefieldState()
    for i, cid in enumerate(FRIEND_POSITIONS):
        if cid is None:
            continue
        u = _create_unit_worker(dl, panel, player_config, sc, cid, Side.ALLY, GRID[i])
        bf.add_unit(u)
    enemy_unit = _create_tactical_enemy_worker(dl, enemy_data, enemy_pos)
    bf.add_unit(enemy_unit)
    bf.memory_cards = make_cards(card_id)

    bc = BattleConfig()
    bc.max_turns = 5
    bc.enable_rdps = True

    controller = TacticalExerciseController(bf, data_loader=dl, config=bc)
    result = controller.execute_battle()
    return result

N = 30
print(f"\n===== 对比模拟 {N} 场（max_turns=5, enemy=381305） =====")
for label, card_id in [("30006(少女们的邂逅)", 30006), ("30042(小小的约定)", 30042)]:
    scores, rdps_card, rdps_unit, tot_dmg, disc = [], {}, {}, [], []
    for s in range(N):
        r = run_one(card_id, 10000 + s)
        sd = r.get("score") or {}
        scores.append(sd.get("total_score", 0))
        rd = r.get("rdps")
        if rd:
            tot_dmg.append(rd.get("total_damage_to_enemies", 0))
            disc.append(rd.get("discrepancy", 0))
            for cid, cs in rd.get("memory_card_stats", {}).items():
                d = rdps_card.setdefault(int(cid), [0.0, 0])
                d[0] += cs["total_rdps"]; d[1] += 1
            for uid, us in rd.get("unit_stats", {}).items():
                d = rdps_unit.setdefault((uid, us["name"]), [0.0, 0])
                d[0] += us["total_rdps"]; d[1] += 1
    avg_score = sum(scores) / len(scores)
    print(f"\n[{label}] 平均分={avg_score:.0f}  平均总伤害={sum(tot_dmg)/len(tot_dmg):.0f}  平均discrepancy={sum(disc)/len(disc):.1f}")
    tot = sum(d[0] / max(1, d[1]) for d in rdps_card.values())
    for cid, d in sorted(rdps_card.items()):
        avg = d[0] / max(1, d[1])
        name = CARD_NAMES.get(cid, cid)
        mark = "  <<<" if cid in (30006, 30042) else ""
        print(f"  card {cid} {name}: avg_rdps={avg:.0f}  ({avg/tot*100 if tot else 0:.1f}% of memory total){mark}")
    print("  ---- 单位rdps ----")
    for (uid, name), d in sorted(rdps_unit.items(), key=lambda kv: -kv[1][0]):
        avg = d[0] / max(1, d[1])
        print(f"  {uid} {name}: avg_rdps={avg:.0f}")
