"""Regression: システマ・ヴラシェーニヤΩ(120129) メトカ标记时机bug。

Bug: Block2在当次行动中赋予目标「メトカ」标记后，Block4的dmg_dealt_down效果
     检查target_has_mark条件时使用了实时状态（而非技能执行前的快照），
     导致标记被误判为"已有"，减伤debuff每次都生效（常驻）。
Fix: effect级target_has_mark条件改为使用_marks_at_start_by_unit快照，
     仅当目标在技能执行前已持有メトカ时才施加减伤debuff。
     同时修复block级条件的live-state回退，以及在_execute_trigger_actions_inline中
     保存/恢复marks快照防止PS执行覆盖外层AS快照。
"""
import unittest, sys, os
sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import BuffState
from src.entities_v2.enums import Position, SkillEffectType

MARK = SkillEffectType.MARK.value
DEALT_DAMAGE = SkillEffectType.DEALT_DAMAGE.value
METOKA = "メトカ"


def _make_metoka_mark(source_id="pre"):
    """Create a pre-existing メトカ mark BuffState (as debuff)."""
    return BuffState(
        buff_id=f"{source_id}_mark_metoka",
        name=METOKA,
        effect_type=MARK,
        value=0,
        duration=-1,
        timing_type=2,
        source_unit_id=source_id,
        source_skill_id=0,
        is_debuff=True,
    )


class TestRegMetokaMarkTiming(unittest.TestCase):

    def _setup(self):
        bb = BattleBuilder()
        bb.add_ally(unit_id="nadya", hp=200000, atk=10000, skills=[120129], level=15,
                    speed=999, defense=50000)
        bb.add_enemy(unit_id="target", position=Position.ENEMY_CENTER_FRONT,
                     hp=200000, atk=5000, defense=50000, speed=500)
        ctx = bb.build()
        bf, ss = ctx['bf'], ctx['ss']
        caster = next(u for u in bf.friend_team if u.unit_id == "nadya")
        target = next(u for u in bf.enemy_team if u.unit_id == "target")
        return bf, ss, caster, target

    def test_no_metoka_before_no_dealt_damage_down(self):
        """目标在技能执行前没有メトカ标记 → 减伤debuff不应施加。"""
        bf, ss, caster, target = self._setup()
        # 确认目标在技能执行前没有メトカ
        self.assertFalse(any(d.name == METOKA for d in target.debuffs))

        ss.execute_skill(caster=caster, skill_id=120129, battlefield=bf, skip_cost=True)

        # 技能执行后目标应有メトカ（Block2施加）
        self.assertTrue(any(d.name == METOKA and d.effect_type == MARK for d in target.debuffs),
                        "Block2 should apply メトカ mark")
        # 但不应有DealtDamage减伤debuff（Block4条件不满足：执行前无メトカ）
        dealt_damage = [d for d in target.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dealt_damage), 0,
                         "dmg_dealt_down should NOT be applied when target had no メトカ before this action")

    def test_metoka_before_yes_dealt_damage_down(self):
        """目标在技能执行前已有メトカ标记 → 减伤debuff应该施加。"""
        bf, ss, caster, target = self._setup()
        # 技能执行前手动添加メトカ标记（模拟前次行动赋予）
        target.debuffs.append(_make_metoka_mark())
        self.assertTrue(any(d.name == METOKA for d in target.debuffs))

        ss.execute_skill(caster=caster, skill_id=120129, battlefield=bf, skip_cost=True)

        # 应有DealtDamage减伤debuff（Block4条件满足：执行前已有メトカ）
        dealt_damage = [d for d in target.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dealt_damage), 0,
                           "dmg_dealt_down should be applied when target had メトカ before this action")

    def test_metoka_not_counted_after_ps_corruption(self):
        """PS触发后外层AS的mark快照不应被覆盖。

        场景：敌方有アイギスランパード类PS会在伤害时触发（内层execute_skill），
        若PS覆盖了外层AS的_marks_at_start_by_unit，则Block4的快照检查可能出错。
        这里用一个简单的方式验证：连续两次施放技能，第一次不应减伤，
        第二次（目标已有メトカ）才减伤，确保快照机制在多次施放中正确工作。
        """
        bf, ss, caster, target = self._setup()

        # 第一次施放：目标无前置メトカ → 不应减伤
        ss.execute_skill(caster=caster, skill_id=120129, battlefield=bf, skip_cost=True)
        dealt_after_first = [d for d in target.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertEqual(len(dealt_after_first), 0,
                         "First cast: no dmg_dealt_down (no prior メトカ)")

        # 清理第一次施加的メトカ和可能残留的debuff，只保留メトカ
        target.debuffs = [d for d in target.debuffs if d.name == METOKA and d.effect_type == MARK]
        self.assertTrue(any(d.name == METOKA for d in target.debuffs),
                        "メトカ should persist from first cast")

        # 第二次施放：目标已有メトカ（来自第一次） → 应该减伤
        ss.execute_skill(caster=caster, skill_id=120129, battlefield=bf, skip_cost=True)
        dealt_after_second = [d for d in target.debuffs if d.effect_type == DEALT_DAMAGE]
        self.assertGreater(len(dealt_after_second), 0,
                           "Second cast: dmg_dealt_down applied (prior メトカ exists)")


if __name__ == '__main__':
    unittest.main()
