"""Regression: hp_ratio_damage must consume target's shield attack_limited.

Bug: 当敌方使用「少しお行儀悪いですが……」(210114) 等 hp_ratio_damage 类技能
     攻击持有次数盾（attack_limited > 0）的目标时，盾虽然吸收了伤害（shield值减少），
     但 attack_limited 未被消耗。

     根因：execute_skill 末尾的 attack_limited 清理逻辑（skill_service.py）
     只匹配 effect_type=="damage"，遗漏了 "hp_ratio_damage" 和 "damage_special"。
     这两种伤害效果同样会被盾吸收，应让盾的 attack_limited -1。

     实战中表现为：次数盾多抗了一次伤害。
     - 姜小花用「少しお行儀悪いですが……」(hp_ratio_damage) 打唯一無二の幼なじみ
       的次数盾(attack_limited=2)，盾吸收但 attack_limited 仍=2（应=1）
     - 之后两次 damage_link 转送伤害又各消耗 1 次（2→1→0）
     - 总共抗了3次伤害，但盾配置 attack_limited=2 应只抗2次

Fix: attack_limited 清理逻辑同时匹配 "damage"、"hp_ratio_damage"、"damage_special"
     三种 effect_type。

Requirements verified:
1. hp_ratio_damage 吸收盾时消耗 attack_limited (-1 per skill)
2. hp_ratio_damage + 后续 damage_link 转送正确让次数盾归零消失
3. damage_special 同样消耗 attack_limited
"""
import unittest
import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from src.data.data_loader import DataLoader
from src.entities_v2.unit_state import UnitState, BuffState, DamageLinkEntry
from src.entities_v2.battlefield_state import BattlefieldState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.combat_v2.services.resource_service import ResourceService
from src.combat_v2.services.trigger_service import TriggerService
from src.combat_v2.services.aura_service import AuraService
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.services.target_service import TargetService
from src.combat_v2.services.status_service import StatusService
from src.combat_v2.services.skill_service import SkillService

SHIELD = SkillEffectType.SHIELD.value
ATTACK_SKILL = 120041  # 四連突: single-target damage skill
SUKOSHI_OGIYOKU = 210114  # 少しお行儀悪いですが…… (敌方版EX，hp_ratio_damage)


def _make_unit(unit_id, name, side, position, *, hp=200000, atk=50000,
               defense=3000, speed=500, element=2, character_type=1,
               skills=None, skill_levels=None, pp=10, ep=10):
    return UnitState(
        unit_id=unit_id, name=name, side=side, position=position,
        character_id=0, level=15, element=element,
        character_type=character_type,
        max_hp=hp, current_hp=hp,
        attack=atk, defense=defense, speed=speed,
        crit_rate=0.0, crit_damage=0.5, advantage_damage=0.0,
        initial_active_point=4, initial_passive_point=4, max_extra_point=10,
        current_ap=10, current_pp=pp, current_ep=ep,
        skills=skills or [], skill_levels=skill_levels or {},
        skill_cooldowns={},
    )


class TestRegHpRatioDamageConsumesShieldAttackLimited(unittest.TestCase):
    """hp_ratio_damage吸收盾时必须消耗attack_limited。"""

    @classmethod
    def setUpClass(cls):
        cls.dl = DataLoader()
        cls.dl.load_all()

    def _make_services(self, bf):
        rs = ResourceService()
        ts = TriggerService()
        ts.set_data_loader(self.dl)
        aus = AuraService()
        dms = DamageService()
        tgs = TargetService()
        sts = StatusService()
        ss = SkillService(
            self.dl, rs,
            target_service=tgs, damage_service=dms,
            aura_service=aus, trigger_service=ts, status_service=sts,
        )
        ts.set_skill_service(ss)
        ts.set_damage_service(dms)
        ss.set_battlefield(bf)
        return ss, ts

    def _make_attack_limited_shield(self, unit, source_id, attack_limited=2,
                                    shield_amount=99999):
        """Manually add an attack_limited shield buff (like ドリルミルキィパンチ Lv11+)."""
        buff = BuffState(
            buff_id=f"test_shield_{unit.unit_id}",
            name="テスト盾", effect_type=SHIELD, value=0.0,
            duration=-1, timing_type=0,
            source_unit_id=source_id,
            source_skill_id=110030,
            is_debuff=False, is_stackable=True, is_memory_buff=False,
            attack_limited=attack_limited,
            shield_amount=shield_amount,
        )
        unit.buffs.append(buff)
        unit.shield = shield_amount
        return buff

    def _make_damage_link(self, source_unit, partner_unit, value=2.0,
                          is_sharing=True, direction="outgoing"):
        """Manually add a DamageLinkEntry (like 少しお行儀悪いですが…… Block4)."""
        entry = DamageLinkEntry(
            link_id=f"test_link_{source_unit.unit_id}_{partner_unit.unit_id}",
            partner_unit_id=partner_unit.unit_id,
            value=value,
            source_skill_id=210114,
            source_unit_id=source_unit.unit_id,
            direction=direction,
            is_unremovable=True,
            is_sharing=is_sharing,
            duration=-1,
            duration_type="",
            just_applied=False,
        )
        source_unit.damage_links.append(entry)
        return entry

    def test_hp_ratio_damage_consumes_shield_attack_limited(self):
        """hp_ratio_damage吸收盾时必须消耗attack_limited (2→1)。

        场景模拟210114「少しお行儀悪いですが……」的hp_ratio_damage：
        - enemy_caster 使用 210114 攻击 ally_target
        - ally_target 持有次数盾 (attack_limited=2)
        - hp_ratio_damage 被盾完全吸收
        - 验证: ally_target 的盾 attack_limited 应从 2 减为 1
        """
        # ally_target: 持有次数盾
        ally_target = _make_unit("ally_target", "目標", Side.ALLY,
                                 Position.ALLY_CENTER_FRONT, hp=200000, atk=10000)
        # enemy_caster: 使用 210114 (hp_ratio_damage) 攻击 ally_target
        enemy_caster = _make_unit("enemy_caster", "攻撃者", Side.ENEMY,
                                  Position.ENEMY_CENTER_FRONT, hp=500000, atk=50000,
                                  skills=[SUKOSHI_OGIYOKU],
                                  skill_levels={SUKOSHI_OGIYOKU: 15})

        # 给ally_target添加次数盾 (attack_limited=2)
        self._make_attack_limited_shield(ally_target, ally_target.unit_id,
                                         attack_limited=2, shield_amount=99999)

        bf = BattlefieldState()
        bf.friend_team = [ally_target]
        bf.enemy_team = [enemy_caster]
        ss, _ = self._make_services(bf)

        hp_before = ally_target.current_hp
        # 执行 210114 (hp_ratio_damage)
        ss.execute_skill(enemy_caster, SUKOSHI_OGIYOKU, bf, skip_cost=True)

        # 验证: 盾吸收了伤害 (HP未变)
        self.assertEqual(ally_target.current_hp, hp_before,
                         "HP应未变 (盾吸收了hp_ratio_damage)")

        # 验证: 盾的attack_limited应从2减为1
        shield_buffs = [b for b in ally_target.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_buffs), 1,
                         "盾应仍存在 (attack_limited 2→1, 仅消耗1次)")
        self.assertEqual(shield_buffs[0].attack_limited, 1,
                         "hp_ratio_damage应让盾的attack_limited从2减为1")

    def test_hp_ratio_damage_then_damage_link_lets_shield_expire(self):
        """hp_ratio_damage + 一次damage_link转送应让次数盾(attack_limited=2)归零消失。

        场景模拟实战bug:
        - T1: 姜小花用「少しお行儀悪いですが……」(hp_ratio_damage) 打唯一無二
              → 盾消耗1次 (2→1)
        - T2: 友军攻击姜小花，damage_link转送给唯一無二
              → 盾消耗1次 (1→0)，盾消失
        - T3: 友军再次攻击姜小花，damage_link转送给唯一無二
              → 盾应已消失，伤害直接扣HP
        """
        # ally_target: 持有次数盾 (attack_limited=2)，被hp_ratio_damage攻击
        ally_target = _make_unit("ally_target", "目標", Side.ALLY,
                                 Position.ALLY_CENTER_FRONT, hp=500000, atk=10000)
        # enemy_linker: 持有outgoing damage_link到ally_target (is_sharing=true)
        enemy_linker = _make_unit("enemy_linker", "リンク元", Side.ENEMY,
                                  Position.ENEMY_RIGHT_FRONT, hp=500000, atk=10000)
        # enemy_caster: 用 210114 (hp_ratio_damage) 攻击 ally_target (第1回合)
        enemy_caster = _make_unit("enemy_caster", "EX攻撃者", Side.ENEMY,
                                  Position.ENEMY_CENTER_FRONT, hp=500000, atk=50000,
                                  skills=[SUKOSHI_OGIYOKU],
                                  skill_levels={SUKOSHI_OGIYOKU: 15})
        # ally_attacker: 攻击 enemy_linker，触发damage_link转送给 ally_target (第2、3回合)
        ally_attacker = _make_unit("ally_attacker", "味方攻撃者", Side.ALLY,
                                   Position.ALLY_LEFT_FRONT, hp=200000, atk=50000,
                                   skills=[ATTACK_SKILL],
                                   skill_levels={ATTACK_SKILL: 15})

        # 给ally_target添加次数盾 (attack_limited=2)
        self._make_attack_limited_shield(ally_target, ally_target.unit_id,
                                         attack_limited=2, shield_amount=99999)
        # 给enemy_linker添加outgoing damage_link (partner=ally_target, is_sharing=true)
        self._make_damage_link(enemy_linker, ally_target, value=2.0,
                               is_sharing=True, direction="outgoing")

        bf = BattlefieldState()
        bf.friend_team = [ally_target, ally_attacker]
        bf.enemy_team = [enemy_caster, enemy_linker]
        ss, _ = self._make_services(bf)

        # T1: enemy_caster 用 210114 (hp_ratio_damage) 攻击 ally_target
        ss.execute_skill(enemy_caster, SUKOSHI_OGIYOKU, bf, skip_cost=True)
        shield_after_t1 = [b for b in ally_target.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_after_t1), 1, "T1后盾应仍存在 (2→1)")
        self.assertEqual(shield_after_t1[0].attack_limited, 1,
                         "T1后 attack_limited 应=1 (hp_ratio_damage消耗1次)")

        # T2: ally_attacker 攻击 enemy_linker，damage_link转送给 ally_target
        hp_before_t2 = ally_target.current_hp
        ss.execute_skill(ally_attacker, ATTACK_SKILL, bf, skip_cost=True)
        shield_after_t2 = [b for b in ally_target.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_after_t2), 0,
                         "T2后盾应消失 (attack_limited 1→0)")
        # 验证盾消失了 (ally_target HP未变因为盾吸收了链接伤害)
        self.assertEqual(ally_target.current_hp, hp_before_t2,
                         "T2链接伤害应被盾完全吸收 (HP不变)")

        # T3: ally_attacker 再次攻击 enemy_linker，damage_link转送给 ally_target
        # 盾已消失，链接伤害应直接扣HP
        hp_before_t3 = ally_target.current_hp
        ss.execute_skill(ally_attacker, ATTACK_SKILL, bf, skip_cost=True)
        shield_after_t3 = [b for b in ally_target.buffs if b.effect_type == SHIELD]
        self.assertEqual(len(shield_after_t3), 0,
                         "T3后盾应仍消失 (没有盾)")
        # 验证: 链接伤害直接扣HP (没有盾吸收)
        self.assertLess(ally_target.current_hp, hp_before_t3,
                        "T3链接伤害应直接扣HP (盾已消失，不再吸收)")


if __name__ == '__main__':
    unittest.main()
