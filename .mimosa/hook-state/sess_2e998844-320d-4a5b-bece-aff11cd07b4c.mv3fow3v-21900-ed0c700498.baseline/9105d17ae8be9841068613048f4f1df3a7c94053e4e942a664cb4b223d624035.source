# -*- coding: utf-8 -*-
"""
回归测试：附魔/追加/子单位伤害的rdps基线分解归因

修复前：_record_enchant_damage 100%归因于buff提供者，ATK快照增益、
dealt/received乘区增益、暴击率使能收益全部泄漏给提供者（回忆卡30042
的ATK+1250前衛通过隣歩む想い的子单位/附魔伤害被系统性低估）。

修复后：
- baseline（排除我方来源buff重算）→ 提供者（或回忆卡）enchant_contribution/direct
- bonus按 base/dealt/received 乘区 log-ratio 归因到具体我方buff施加者
- 暴击收益（固定1.5x）按Δp/p_final归因暴率buff，其余归提供者direct
- 守恒：各份额之和 == actual_damage
"""
import sys
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent.parent.parent))

from src.entities_v2.unit_state import BuffState
from src.entities_v2.enums import Side, Position, SkillEffectType
from src.entities_v2.battlefield_state import BattlefieldState
from src.combat_v2.services.damage_service import DamageService
from src.combat_v2.rdps_tracker import RDPSTracker

from tests.test_rdps_tracker import make_unit, make_buff


def make_enchant_buff(buff_id, source_unit_id, snap, snap_baseline, effect_type="EnchantDamage"):
    """创建附魔/追加/子单位伤害buff（含基线快照）"""
    return BuffState(
        buff_id=buff_id, name="ExtraDmg", effect_type=effect_type,
        value=100, duration=-1, timing_type=2,
        source_unit_id=source_unit_id,
        caster_attack=snap, caster_attack_baseline=snap_baseline,
    )


class TestEnchantBaselineDecomposition(unittest.TestCase):
    """附魔/追加/子单位伤害基线分解归因"""

    def setUp(self):
        self.ds = DamageService()
        self.bf = BattlefieldState()
        self.tracker = RDPSTracker(damage_service=self.ds)
        self.tracker.set_battlefield(self.bf)
        # a1=持有者(攻击者), a2=提供者, a3=ATK buff施加者, e1=敌方
        self.holder = make_unit("a1", "Holder", attack=1000, crit_rate=0.5)
        self.provider = make_unit("a2", "Provider", attack=1000)
        self.giver = make_unit("a3", "Giver", attack=500)
        self.target = make_unit("e1", "Enemy", side=Side.ENEMY, attack=800,
                                defense=500, max_hp=50000)
        self.bf.friend_team = [self.holder, self.provider, self.giver]
        self.bf.enemy_team = [self.target]

    def test_enchant_atk_buff_decomposed(self):
        """附魔伤害：提供者的ATK buff增益归buff施加者，基线归提供者

        提供者a2 atk=1000 + a3施加的+100固值ATK → 实时ATK=1100
        附魔 base = max(0, 1100 + min(0, 1100-500)) = 1100, power=100%
        baseline: src_b=1000, holder_b=1000, def_b=500 → base_b=1000
        bonus=100 → base乘区 → a3
        """
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             100, source_unit_id="a3", value_tag=1)
        self.provider.buffs.append(atk_buff)
        ench_buff = make_enchant_buff("m1", "a2", snap=1100, snap_baseline=1000)

        calc = {
            "source_atk": 1100, "b_atk": 1000, "c_def": 500, "base_diff": 1100,
            "power_pct": 100, "crit_factor": 1.0,
            "b_dealt_mult": 1.0, "c_received_mult": 1.0, "attr_factor": 1.0,
            "guard_mult": 1.0, "damage_element": 1,
        }
        self.tracker.record_damage_with_attribution(
            self.holder, self.target, 1100, None, "enchant",
            enchant_source_id="a2", battlefield=self.bf, damage_service=self.ds,
            enchant_buff=ench_buff, calc_detail=calc)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)
        # 基线1100中1000归提供者，bonus 100归ATK buff施加者a3
        self.assertAlmostEqual(result.unit_stats["a2"].enchant_contribution, 1000, delta=1,
                               msg=f"提供者应得基线1000, 实际={result.unit_stats['a2'].enchant_contribution}")
        self.assertAlmostEqual(result.unit_stats["a3"].buff_contribution, 100, delta=1,
                               msg=f"ATK buff施加者应得bonus 100, 实际={result.unit_stats['a3'].buff_contribution}")

    def test_add_dmg_snapshot_decomposed(self):
        """追加伤害：快照ATK含我方buff部分被分解（基线快照排除后归ATK施加者）"""
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             100, source_unit_id="a3", value_tag=1)
        self.provider.buffs.append(atk_buff)
        add_buff = make_enchant_buff("m1", "a2", snap=1100, snap_baseline=1000,
                                     effect_type="AddDamage")

        calc = {
            "source_atk": 1100, "c_def": 500, "base_diff": 1100,
            "power_pct": 100, "crit_factor": 1.0,
            "a_dealt_mult": 1.0, "b_received_mult": 1.0, "attr_factor": 1.0,
            "damage_element": 1, "guard_mult": 1.0,
        }
        self.tracker.record_damage_with_attribution(
            self.holder, self.target, 1100, None, "add_dmg",
            enchant_source_id="a2", battlefield=self.bf, damage_service=self.ds,
            enchant_buff=add_buff, calc_detail=calc)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)
        self.assertAlmostEqual(result.unit_stats["a2"].enchant_contribution, 1000, delta=1)
        self.assertAlmostEqual(result.unit_stats["a3"].buff_contribution, 100, delta=1)

    def test_sub_unit_snapshot_decomposed(self):
        """子单位伤害：快照+源单位实时ATK的基线分解"""
        atk_buff = make_buff("b1", "ATK Up", SkillEffectType.STATUS_ATTACK.value,
                             100, source_unit_id="a3", value_tag=1)
        self.provider.buffs.append(atk_buff)
        sub_buff = make_enchant_buff("m1", "a2", snap=1100, snap_baseline=1000,
                                     effect_type="SubUnit")

        calc = {
            "snapshot_atk": 1100, "a_atk": 1100, "b_def": 500, "base_diff": 1100,
            "power_pct": 100, "crit_factor": 1.0,
            "a_dealt_mult": 1.0, "b_received_mult": 1.0, "advantage": 1.0,
            "guard_mult": 1.0, "damage_element": 1,
        }
        self.tracker.record_damage_with_attribution(
            self.holder, self.target, 1100, None, "sub_unit",
            enchant_source_id="a2", battlefield=self.bf, damage_service=self.ds,
            enchant_buff=sub_buff, calc_detail=calc)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)
        self.assertAlmostEqual(result.unit_stats["a2"].enchant_contribution, 1000, delta=1)
        self.assertAlmostEqual(result.unit_stats["a3"].buff_contribution, 100, delta=1)

    def test_enchant_crit_rate_share(self):
        """附魔暴击收益：暴率使能份额归暴率buff，固有部分归提供者

        持有者a1 crit_rate=0.5 + 暴率buff+20% → p_final=0.7
        附魔暴击固定1.5x: actual=1500, D_nc=1000, baseline=1000(无ATK buff), bonus=0
        payoff=500 → rate_share=500×0.2/0.7≈142.86 → a4; inherent≈357.14 → a2
        """
        crit_giver = make_unit("a4", "CritGiver", attack=500)
        self.bf.friend_team.append(crit_giver)
        rate_buff = make_buff("b1", "CritRate Up", SkillEffectType.STATUS_CRITICAL_CHANCE.value,
                              20, source_unit_id="a4")
        self.holder.buffs.append(rate_buff)
        ench_buff = make_enchant_buff("m1", "a2", snap=1000, snap_baseline=1000)

        calc = {
            "source_atk": 1000, "b_atk": 1000, "c_def": 500, "base_diff": 1000,
            "power_pct": 100, "crit_factor": 1.5,
            "b_dealt_mult": 1.0, "c_received_mult": 1.0, "attr_factor": 1.0,
            "guard_mult": 1.0, "damage_element": 1,
        }
        self.tracker.record_damage_with_attribution(
            self.holder, self.target, 1500, None, "enchant",
            enchant_source_id="a2", battlefield=self.bf, damage_service=self.ds,
            enchant_buff=ench_buff, calc_detail=calc)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)
        # 提供者: baseline 1000 + inherent 500×0.5/0.7 ≈ 1357.14
        self.assertAlmostEqual(result.unit_stats["a2"].enchant_contribution,
                               1000 + 500 * 0.5 / 0.7, delta=1)
        # 暴率buff施加者: 500×0.2/0.7 ≈ 142.86
        self.assertAlmostEqual(result.unit_stats["a4"].buff_contribution,
                               500 * 0.2 / 0.7, delta=1)

    def test_no_calc_detail_falls_back_to_provider(self):
        """无calc_detail时退化为100%归提供者（向后兼容）"""
        ench_buff = make_enchant_buff("m1", "a2", snap=1000, snap_baseline=1000)
        self.tracker.record_damage_with_attribution(
            self.holder, self.target, 777, None, "enchant",
            enchant_source_id="a2", battlefield=self.bf, damage_service=self.ds,
            enchant_buff=ench_buff, calc_detail=None)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)
        self.assertAlmostEqual(result.unit_stats["a2"].enchant_contribution, 777, delta=1)

    def test_dealt_buff_decomposed(self):
        """附魔伤害的dealt乘区增益归持有者的DealtDamage buff施加者"""
        dealt_giver = make_unit("a5", "DealtGiver", attack=500)
        self.bf.friend_team.append(dealt_giver)
        dealt_buff = make_buff("b1", "Dealt Up", SkillEffectType.DEALT_DAMAGE.value,
                               30, source_unit_id="a5")
        self.holder.buffs.append(dealt_buff)
        ench_buff = make_enchant_buff("m1", "a2", snap=1000, snap_baseline=1000)

        calc = {
            "source_atk": 1000, "b_atk": 1000, "c_def": 500, "base_diff": 1000,
            "power_pct": 100, "crit_factor": 1.0,
            "b_dealt_mult": 1.3, "c_received_mult": 1.0, "attr_factor": 1.0,
            "guard_mult": 1.0, "damage_element": 1,
        }
        self.tracker.record_damage_with_attribution(
            self.holder, self.target, 1300, None, "enchant",
            enchant_source_id="a2", battlefield=self.bf, damage_service=self.ds,
            enchant_buff=ench_buff, calc_detail=calc)
        result = self.tracker.build_result(units=self.bf.get_all_units())

        self.assertEqual(result.discrepancy, 0)
        # baseline=1000 → a2; bonus=300 → dealt乘区 → a5
        self.assertAlmostEqual(result.unit_stats["a2"].enchant_contribution, 1000, delta=1)
        self.assertAlmostEqual(result.unit_stats["a5"].buff_contribution, 300, delta=1)


if __name__ == "__main__":
    unittest.main()
