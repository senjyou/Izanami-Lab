"""Regression: 子单位伤害叙事的显示值应为盾吸收后的HP部分。

Bug: 子单位伤害实际已正确经盾吸收（日志 extra=6713 shield=5138 hp:126254->124679，
     即5138被盾吸收、1575打在血条上），但叙事行把【总伤】作为伤害数显示：
       [子单位伤害] 「願い星」→ 鳴滝七彩: 6713 点物理伤害 (护盾吸收:5138)
     与主伤害行的约定不一致（主行显示HP部分: "0 点物理伤害 [盾吸収:16966]"），
     也被读成"6713全额打在血条上、盾未正常吸收"（实测期望显示1575）。
Fix: _log_narrative_damage的sub_unit分支显示 actual_damage - shield_absorbed
     （盾吸收后的HP部分），与主伤害行"[N点伤害 + 盾吸収:M]"约定一致（N+M=总额）。
"""
import sys
import os
import unittest
from types import SimpleNamespace

sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))

from helpers.battle_builder import BattleBuilder
from src.entities_v2.unit_state import BuffState
from src.entities_v2.enums import SkillEffectType, AuraUpdateTiming, Position
from src.combat_v2.battle_flow_controller import BattleFlowController, BattleConfig
from src.combat_v2.battle_narrative import BattleNarrativeWriter
from src.combat_v2.scoring_tracker import ScoringTracker

DEALT = SkillEffectType.DEALT_DAMAGE.value
RECEIVED = SkillEffectType.RECEIVED_DAMAGE.value
SUB_UNIT = SkillEffectType.SUB_UNIT.value
EN = 2


def make_sub_unit_buff(name="願い星", value=5.0, caster_attack=104086,
                        source_unit_id="src", hp=10000):
    return BuffState(
        buff_id=f"sub_{name}", name=name,
        effect_type=SUB_UNIT, value=value, duration=-1,
        timing_type=AuraUpdateTiming.DURABLE_TARGET_MANEUVER_END.value,
        source_unit_id=source_unit_id, source_skill_id=110084,
        caster_attack=caster_attack, is_debuff=False, is_stackable=True,
        sub_unit_hp=hp, sub_unit_max_hp=hp,
        sub_unit_link_group="", just_applied=False,
    )


def make_dealt_buff(value, damage_element):
    return BuffState(
        buff_id=f"dealt_{damage_element}", name="dealt_up",
        effect_type=DEALT, value=value, duration=-1, timing_type=2,
        damage_element=damage_element, is_debuff=False,
    )


def make_received_debuff(value, damage_element=0):
    return BuffState(
        buff_id=f"rcvd_{damage_element}", name="taken_up",
        effect_type=RECEIVED, value=value, duration=-1, timing_type=2,
        damage_element=damage_element, is_debuff=True,
    )


ADD_DAMAGE = SkillEffectType.ADD_DAMAGE.value
ENCHANT_DAMAGE = SkillEffectType.ENCHANT_DAMAGE.value


def make_add_damage_buff(value=100.0, caster_attack=10000, source_unit_id="ext"):
    return BuffState(
        buff_id="add_buff", name="add_dmg",
        effect_type=ADD_DAMAGE, value=value, duration=-1, timing_type=2,
        caster_attack=caster_attack, source_unit_id=source_unit_id,
        source_skill_id=99999, hit_limited=0, is_debuff=False,
    )


def make_enchant_buff(value=50.0, caster_attack=10000, source_unit_id="ext"):
    return BuffState(
        buff_id="ench_buff", name="enchant",
        effect_type=ENCHANT_DAMAGE, value=value, duration=-1, timing_type=2,
        caster_attack=caster_attack, source_unit_id=source_unit_id,
        source_skill_id=99999, hit_limited=0, is_debuff=False,
    )


def make_main_effect(value=100.0, hit_count=1, ignore_shield=0):
    return SimpleNamespace(
        effect_type="damage", target_type="enemy_single", target_identifier=None,
        value=value, hit_count=hit_count, ignore_defense=0, ignore_shield=ignore_shield,
        flags={}, condition=None,
    )


def _init_ss_for_direct_apply(ss, bf):
    """初始化_apply_damage所需的全部内部状态（同 tests/unit/test_enchant_damage.py）。"""
    ss._recursion_guard = True
    ss._before_attack_triggers_fired = True
    ss._current_skill_id = 99999
    ss._current_block_id = 1
    ss._current_skill_priority = 1
    ss._block_damage_targets = {}
    ss._block_damage_total = {}
    ss._last_damage_hp_before = {}
    ss._damaged_targets = []
    ss._current_attack_targets = []
    ss._pre_scanned_cover_candidates = None
    ss._pre_scanned_non_damage_enemy_targets = []
    ss._primary_target = None
    ss._trigger_attacker = None
    ss._target_char_type_filter = None
    ss._target_element_filter = None
    ss._original_primary_target = None
    ss._last_primary_target = None
    ss._most_recent_damage = 0
    ss._skill_all_attacked_targets = []
    ss._hp_consumed = 0
    ss._per_hit_hp_losses = {}
    ss._block_evaded_targets = set()
    ss._skill_evaded_targets = set()
    ss._debuff_immune_blocked_targets = set()
    ss._on_crit_blocks = []
    ss._on_crit_applied = False
    ss._on_crit_block_executed = {}
    ss._on_crit_target = None
    ss._on_crit_immediate_blocks = []
    ss._on_crit_immediate_applied = set()
    ss._on_crit_effects = []
    ss._deferred_on_crit_targets = []
    ss._pending_crit_triggers = []
    ss._per_target_enchant_cache = None
    ss._current_main_damage_power = None
    ss._marks_at_start = {}
    ss._marks_at_start_by_unit = {}
    ss._ps_received_targets = []
    ss._current_skill_is_ps = False
    ss._last_heal_targets = []
    ss._newly_created_sub_unit_ids = set()
    ss._pending_deaths = set()


class TestRegSubUnitShieldDisplay(unittest.TestCase):
    """子单位伤害叙事显示：盾吸收后HP部分 + (护盾吸收:M)，N+M=总额。"""

    def _run(self, enemy_shield):
        """构造 射源EN+持有者物理+子单位5%×外源ATK104086，返回(机制数值, 叙事行)"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="holder", position=Position.ALLY_LEFT_FRONT,
                    atk=10000, hp=100000, defense=0, skills=[])
        bb.add_ally(unit_id="source", position=Position.ALLY_CENTER_FRONT,
                    atk=162022, hp=100000, defense=0, skills=[])
        bb.add_enemy(unit_id="enemy", hp=5000000, defense=42531)
        ctx = bb.build()
        bf = ctx['bf']
        holder, source, enemy = ctx['allies'][0], ctx['allies'][1], ctx['enemies'][0]
        holder.character_type = 1      # 持有者物理型
        source.character_type = EN     # 赋予源EN型（子单位伤害类型=EN）
        holder.crit_rate = 0.0
        holder.skill_levels = {}
        enemy.current_hp = 126254      # 镜像报告时点

        holder.buffs.append(make_sub_unit_buff(source_unit_id=source.unit_id))
        holder.buffs.append(make_dealt_buff(20.0, EN))    # EN限定+20% → dealt 1.2
        enemy.debuffs.append(make_received_debuff(7.5))   # 通用易伤+7.5% → rcvd 1.075
        enemy.shield = enemy_shield

        ss = ctx['ss']
        _init_ss_for_direct_apply(ss, bf)
        tracker = ScoringTracker()
        bf.scoring_tracker = tracker
        hp_before = enemy.current_hp
        shield_before = enemy.shield
        # 主伤害完全穿盾（ignore_shield=100）：隔离子单位的盾吸收，吸收量确定
        ss._apply_damage(holder, make_main_effect(ignore_shield=100), bf)

        # 从缓存取子单位结果并驱动真实叙事分支
        cache_entries = [dict(e) for e in ss._per_target_enchant_cache["enchant_targets"]
                         if e.get("sub_unit_name")]
        self.assertEqual(len(cache_entries), 1, "应有1条子单位结果")
        narr = BattleNarrativeWriter(data_loader=ctx['services']['dl'])
        controller = BattleFlowController(bf, BattleConfig(),
                                          data_loader=ctx['services']['dl'], narrative=narr)
        controller._build_display_names()
        controller._log_narrative_damage(holder, holder.name, "物理", {"targets": cache_entries})
        sub_lines = [l for l in narr._lines if "[子单位伤害]" in l]
        self.assertEqual(len(sub_lines), 1, "应有1条子单位伤害叙事:\n" + "\n".join(narr._lines))
        return {
            "hp_loss": hp_before - enemy.current_hp,
            "shield_used": shield_before - enemy.shield,
            "line": sub_lines[0],
            "entry": cache_entries[0],
            "tracker_dealt": tracker._unit_stats[holder.unit_id].damage_dealt,
            "dealt_total": holder.damage_dealt_total,
            "received_total": enemy.damage_taken_total,
            "score_to_enemies": tracker._total_damage_to_enemies,
        }

    def test_display_shows_hp_portion_when_shield_absorbs(self):
        """盾吸收5000：叙事应显示HP部分1713 + (护盾吸收:5000)，总额6713"""
        r = self._run(enemy_shield=5000)
        entry = r["entry"]
        # 机制核对：子单位总额6713；主伤害穿盾1点到HP，盾全部由子单位消耗
        self.assertEqual(entry["actual_damage"], 6713,
                         f"子单位总额应为6713（实际{entry['actual_damage']}）")
        self.assertEqual(r["shield_used"], 5000, "盾应被子单位完全消耗（5000）")
        self.assertEqual(r["hp_loss"], 1714, "HP应承受 主1点 + 子单位剩余1713")
        # 叙事核对：显示HP部分（非总额）
        self.assertIn("1713 点物理伤害", r["line"],
                      f"应显示盾吸收后的HP部分1713（实际行: {r['line']}）")
        self.assertIn("(护盾吸收:5000)", r["line"], f"应注明吸收量（实际行: {r['line']}）")
        self.assertNotIn("6713 点物理伤害", r["line"],
                         "不应把总额6713作为伤害数显示（会被读成全打在血条上）")
        # 计分/统计口径：仅计扣HP部分（1 + 1713 = 1714），盾吸收5000不计入
        self.assertEqual(r["tracker_dealt"], 1 + 1713,
                         f"计分追踪应只记扣HP部分1714（实际{r['tracker_dealt']}）")
        self.assertEqual(r["score_to_enemies"], 1 + 1713,
                         f"对敌方伤害得分应为1714（实际{r['score_to_enemies']}）")
        self.assertEqual(r["dealt_total"], 1 + 1713,
                         f"damage_dealt_total应为1714（实际{r['dealt_total']}）")
        self.assertEqual(r["received_total"], 1 + 1713,
                         f"damage_taken_total应为1714（实际{r['received_total']}）")

    def test_display_shows_full_when_no_shield(self):
        """无盾：叙事显示全额（HP部分=总额），无护盾吸收标注"""
        r = self._run(enemy_shield=0)
        entry = r["entry"]
        self.assertEqual(entry["actual_damage"], 6713)
        self.assertEqual(entry["shield_absorbed"], 0)
        self.assertIn("6713 点物理伤害", r["line"], f"实际行: {r['line']}")
        self.assertNotIn("护盾吸收", r["line"], f"无盾不应有吸收标注: {r['line']}")

    # ─────────── 追加伤害 / 附魔伤害的盾吸收（与子单位一致） ───────────

    def _run_secondary(self, extra_buff, enemy_shield):
        """holder物理 atk10000 / enemy def5000+盾；主伤害穿盾1点，次级伤害走盾吸收并驱动叙事。"""
        bb = BattleBuilder()
        bb.add_ally(unit_id="holder", position=Position.ALLY_LEFT_FRONT,
                    atk=3000, hp=100000, defense=0, skills=[])
        bb.add_enemy(unit_id="enemy", hp=5000000, defense=5000)
        ctx = bb.build()
        bf = ctx['bf']
        holder, enemy = ctx['allies'][0], ctx['enemies'][0]
        holder.crit_rate = 0.0
        holder.skill_levels = {}
        enemy.current_hp = 126254
        holder.buffs.append(extra_buff)
        enemy.shield = enemy_shield

        ss = ctx['ss']
        _init_ss_for_direct_apply(ss, bf)
        tracker = ScoringTracker()
        bf.scoring_tracker = tracker
        hp_before = enemy.current_hp
        shield_before = enemy.shield
        # 主伤害完全穿盾：隔离次级伤害的盾吸收
        ss._apply_damage(holder, make_main_effect(ignore_shield=100), bf)

        entries = [dict(e) for e in ss._per_target_enchant_cache["enchant_targets"]]
        self.assertEqual(len(entries), 1, f"应有1条次级伤害结果: {entries}")
        narr = BattleNarrativeWriter(data_loader=ctx['services']['dl'])
        controller = BattleFlowController(bf, BattleConfig(),
                                          data_loader=ctx['services']['dl'], narrative=narr)
        controller._build_display_names()
        controller._log_narrative_damage(holder, holder.name, "物理", {"targets": entries})
        sec_lines = [l for l in narr._lines
                     if "[追加伤害]" in l or "[附魔伤害]" in l or "[子单位伤害]" in l]
        self.assertEqual(len(sec_lines), 1, "应有1条次级伤害叙事:\n" + "\n".join(narr._lines))
        return {
            "hp_loss": hp_before - enemy.current_hp,
            "shield_used": shield_before - enemy.shield,
            "line": sec_lines[0],
            "entry": entries[0],
            "tracker_dealt": tracker._unit_stats[holder.unit_id].damage_dealt,
            "dealt_total": holder.damage_dealt_total,
            "received_total": enemy.damage_taken_total,
            "score_to_enemies": tracker._total_damage_to_enemies,
        }

    def test_add_damage_absorbed_by_shield(self):
        """追加伤害经盾吸收：总额10000 → 盾6000 + HP4000；叙事显示HP部分4000"""
        r = self._run_secondary(make_add_damage_buff(value=100.0, caster_attack=10000),
                                enemy_shield=6000)
        self.assertEqual(r["entry"]["actual_damage"], 10000,
                         f"追加总额应为10000（实际{r['entry']['actual_damage']}）")
        self.assertEqual(r["entry"]["shield_absorbed"], 6000, "追加伤害应被盾吸收6000")
        self.assertEqual(r["shield_used"], 6000)
        self.assertEqual(r["hp_loss"], 1 + 4000, "HP应承受 主1点 + 追加剩余4000")
        self.assertIn("4000 点物理伤害", r["line"], f"应显示HP部分4000（实际: {r['line']}）")
        self.assertIn("(护盾吸收:6000)", r["line"], f"应注明吸收量（实际: {r['line']}）")
        self.assertNotIn("10000 点物理伤害", r["line"], "不应显示总额10000")
        # 计分/统计口径：仅计扣HP部分（1 + 4000 = 4001），盾吸收6000不计入
        self.assertEqual(r["tracker_dealt"], 1 + 4000,
                         f"计分追踪应只记扣HP部分4001（实际{r['tracker_dealt']}）")
        self.assertEqual(r["score_to_enemies"], 1 + 4000)
        self.assertEqual(r["dealt_total"], 1 + 4000)
        self.assertEqual(r["received_total"], 1 + 4000)

    def test_enchant_damage_absorbed_by_shield(self):
        """附魔伤害经盾吸收：总额4000 → 盾3000 + HP1000；叙事显示HP部分1000

        公式: max(0, source_atk + min(0, b_atk - c_def)) * power%
            = max(0, 10000 + min(0, 3000-5000)) * 50% = 8000 * 50% = 4000
        """
        r = self._run_secondary(make_enchant_buff(value=50.0, caster_attack=10000),
                                enemy_shield=3000)
        self.assertEqual(r["entry"]["actual_damage"], 4000,
                         f"附魔总额应为4000（实际{r['entry']['actual_damage']}）")
        self.assertEqual(r["entry"]["shield_absorbed"], 3000, "附魔伤害应被盾吸收3000")
        self.assertEqual(r["shield_used"], 3000)
        self.assertEqual(r["hp_loss"], 1 + 1000, "HP应承受 主1点 + 附魔剩余1000")
        self.assertIn("1000 点物理伤害", r["line"], f"应显示HP部分1000（实际: {r['line']}）")
        self.assertIn("(护盾吸收:3000)", r["line"], f"应注明吸收量（实际: {r['line']}）")
        self.assertNotIn("4000 点物理伤害", r["line"], "不应显示总额4000")
        # 计分/统计口径：仅计扣HP部分（1 + 1000 = 1001），盾吸收3000不计入
        self.assertEqual(r["tracker_dealt"], 1 + 1000,
                         f"计分追踪应只记扣HP部分1001（实际{r['tracker_dealt']}）")
        self.assertEqual(r["score_to_enemies"], 1 + 1000)
        self.assertEqual(r["dealt_total"], 1 + 1000)
        self.assertEqual(r["received_total"], 1 + 1000)


if __name__ == '__main__':
    unittest.main(verbosity=2)
